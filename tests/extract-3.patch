+    render(
+      <TransactionTable
+        transactions={sampleStatement.transactions}
+        currency="GBP"
+      />,
+    );
+
+    expect(screen.getByText("FPS WEEKLY WAGE ACME REF0001")).toBeInTheDocument();
+    expect(screen.getByText("DIRECT DEBIT UTILITIES")).toBeInTheDocument();
