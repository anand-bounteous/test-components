+"""Phase 1 — candidate-set model contracts."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    CANDIDATE_TYPES,
+    CONFIDENCE_BANDS,
+    BankTransaction,
+    CandidateSet,
+    CandidateTransaction,
+    DetectedPattern,
+    RawBankTransaction,
+    ScoreBreakdown,
+    candidate_transaction_from,
+)
+
+
+def _make_set(**kw) -> CandidateSet:
+    base = dict(
+        candidate_set_id="cs_001",
+        candidate_type="probable_salary",
+        transactions=(
+            CandidateTransaction(
+                transaction_id="t01",
+                date="2024-01-31",
+                description="BACS ACME LTD PAYROLL",
+                amount=2450.32,
+            ),
+        ),
+        score_breakdown=ScoreBreakdown(final_score=0.87),
+        detected_pattern=DetectedPattern(frequency="monthly"),
+        confidence=0.87,
+        confidence_band="high",
+    )
+    base.update(kw)
+    return CandidateSet(**base)
+
+
+def test_constants_expose_full_taxonomy():
+    assert "probable_salary" in CANDIDATE_TYPES
+    assert "high" in CONFIDENCE_BANDS
+    assert CONFIDENCE_BANDS == ("very_high", "high", "medium_high", "medium", "low", "very_low")
+
+
+def test_valid_candidate_set_constructs_cleanly():
+    cs = _make_set()
+    assert cs.candidate_type == "probable_salary"
+
+
+def test_candidate_type_not_validated_at_model_level():
+    cs = _make_set(candidate_type="not_a_real_type")
+    assert cs.candidate_type == "not_a_real_type"
+
+
+def test_invalid_confidence_band_rejected():
+    with pytest.raises(ValueError):
+        _make_set(confidence_band="amazing")
+
+
+def test_candidate_transaction_from_normalised():
+    raw = RawBankTransaction(
+        id="t01",
+        date="2024-01-31",
+        description="BACS ACME LTD PAYROLL 1234",
+        debit_amount=Decimal("0"),
+        credit_amount=Decimal("2450.32"),
+    )
+    nt = BankTransaction(
+        raw=raw,
+        normalised_description="BACS ACME LTD PAYROLL 1234",
+        description_tokens=("BACS", "ACME", "LTD", "PAYROLL", "1234"),
+        skeleton="BACS ACME LTD PAYROLL",
+    )
+    out = candidate_transaction_from(nt)
+    assert out.transaction_id == "t01"
+    assert out.amount == 2450.32
+    assert out.date == "2024-01-31"
