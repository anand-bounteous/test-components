+from __future__ import annotations
+
+import uuid
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any, Iterator
+
+from nw_agcore_document_data_extractor.pipeline._models.AuditStep import AuditStep, StageStatus
+
+
+@dataclass
+class _AuditHandle:
+    stage_name: str
+    tool: str
+    inputs: list[str] = field(default_factory=list)
+    outputs: list[str] = field(default_factory=list)
+    status: StageStatus = "ok"
+    message: str | None = None
+    usage: dict[str, Any] = field(default_factory=dict)
+
+
+class AuditRecorder:
+    def __init__(self) -> None:
+        self.steps: list[AuditStep] = []
+        self._order = 0
+
+    def add(self, step: AuditStep) -> None:
+        self.steps.append(step)
+
+    @contextmanager
+    def time(
+        self,
+        stage_name: str,
+        tool: str,
+        *,
+        params: dict[str, Any] | None = None,
+        inputs: list[str] | None = None,
+    ) -> Iterator[_AuditHandle]:
+        import time
+
+        self._order += 1
+        started = datetime.now(timezone.utc)
+        t0 = time.perf_counter()
+        handle = _AuditHandle(stage_name=stage_name, tool=tool, inputs=list(inputs or []))
+        try:
+            yield handle
+            status: StageStatus = handle.status or "ok"
+            message = handle.message
+        except Exception as exc:
+            status = "error"
+            message = f"{type(exc).__name__}: {exc}"
+            self.add(
+                AuditStep(
+                    stage_name=stage_name,
+                    tool=tool,
+                    order=self._order,
+                    started_at=started,
+                    duration_ms=(time.perf_counter() - t0) * 1000,
+                    params=params or {},
+                    inputs=handle.inputs,
+                    outputs=handle.outputs,
+                    status=status,
+                    message=message,
+                    usage=handle.usage,
+                )
+            )
+            raise
+        self.add(
+            AuditStep(
+                stage_name=stage_name,
+                tool=tool,
+                order=self._order,
+                started_at=started,
+                duration_ms=(time.perf_counter() - t0) * 1000,
+                params=params or {},
+                inputs=handle.inputs,
+                outputs=handle.outputs,
+                status=status,
+                message=message,
+                usage=handle.usage,
+            )
+        )
