+"""Input validation service — FR-001, FR-002."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+from importlib import resources
+from pathlib import Path
+from typing import Any, Literal
+
+from nw_core.validation import ValidationWarning
+
+from .._models import RawBankTransaction
+from .._models.requests import BankTransactionRequest
+
+EMPTY_DESCRIPTION_PLACEHOLDER = "__EMPTY__"
+
+_VALID_COUNTRY_REGIONS = frozenset(
+    {
+        "EnglandAndWales",
+        "Scotland",
+        "NorthernIreland",
+        "UnknownDefaultEnglandAndWales",
+    }
+)
+_VALID_VALIDATION_MODES = frozenset({"lenient", "strict"})
+
+TransactionsAbsence = Literal["missing", "null"]
+
+
+class ValidationError(ValueError):
+    """Raised in strict mode when an input row fails validation."""
+
+
+@dataclass(frozen=True)
+class ValidationResult:
+    transactions: tuple[RawBankTransaction, ...]
+    warnings: tuple[ValidationWarning, ...]
+
+
+@dataclass(frozen=True)
+class PayloadValidationResult:
+    transactions: tuple[RawBankTransaction, ...]
+    warnings: tuple[ValidationWarning, ...]
+    early_exit: bool = False
+
+
+def _load_input_schema() -> dict:
+    schema_file = (
+        resources.files("nw_agcore_bank_transactions.pipeline.validation")
+        / "schemas"
+        / "input.schema.json"
+    )
+    return json.loads(schema_file.read_text())
+
+
+def validate_payload_fields(
+    payload: BankTransactionRequest,
+    *,
+    strict: bool = False,
+) -> tuple[ValidationWarning, ...]:
+    """Semantic checks for a typed payload (jsonschema validation is test-only)."""
+    warnings: list[ValidationWarning] = []
+
+    if not payload.analysis_id:
+        msg = "analysis_id must be a non-empty string"
+        if strict:
+            raise ValidationError(msg)
+        warnings.append(ValidationWarning(code="schema_violation", transaction_id="", detail=msg))
+
+    if payload.country_region is not None and payload.country_region not in _VALID_COUNTRY_REGIONS:
+        msg = f"country_region {payload.country_region!r} is not a supported value"
+        if strict:
+            raise ValidationError(msg)
+        warnings.append(ValidationWarning(code="schema_violation", transaction_id="", detail=msg))
+
+    if payload.validation_mode not in _VALID_VALIDATION_MODES:
+        msg = f"validation_mode {payload.validation_mode!r} must be 'lenient' or 'strict'"
+        if strict:
+            raise ValidationError(msg)
+        warnings.append(ValidationWarning(code="schema_violation", transaction_id="", detail=msg))
+
+    return tuple(warnings)
+
+
+def validate_schema(payload: dict, *, strict: bool = True) -> tuple[ValidationWarning, ...]:
+    """Validate a raw fixture/API dict against ``input.schema.json`` (tests only)."""
+    validator = input_validator()
+    errors = sorted(validator.iter_errors(payload), key=lambda e: list(e.path))
+    if not errors:
+        return ()
+    if strict:
+        first = errors[0]
+        raise ValidationError(f"schema validation failed at {list(first.path)}: {first.message}")
+    return tuple(
+        ValidationWarning(
+            code="schema_violation",
+            transaction_id=_path_to_txn_id(payload, e),
+            detail=f"{list(e.path)}: {e.message}",
+        )
+        for e in errors
+    )
+
+
+def _path_to_txn_id(payload: dict, error) -> str:
+    path = list(error.path)
+    if len(path) >= 2 and path[0] == "transactions":
+        idx = path[1]
+        try:
+            return payload["transactions"][idx].get("id", "")
+        except (IndexError, KeyError, TypeError):
+            return ""
+    return ""
+
+
+_INPUT_SCHEMA: dict | None = None
+_INPUT_VALIDATOR = None
+
+
+def input_schema() -> dict:
+    global _INPUT_SCHEMA
+    if _INPUT_SCHEMA is None:
+        _INPUT_SCHEMA = _load_input_schema()
+    return _INPUT_SCHEMA
+
+
+def input_validator():
+    """Return a jsonschema validator for raw dict fixtures (tests only)."""
+    global _INPUT_VALIDATOR
+    if _INPUT_VALIDATOR is None:
+        from jsonschema import Draft202012Validator
+
+        _INPUT_VALIDATOR = Draft202012Validator(input_schema())
+    return _INPUT_VALIDATOR
+
+
+# Alternate transaction-date forms accepted after ISO YYYY-MM-DD.
+# Deliberately excludes ambiguous numeric slash/dash orders (DD/MM/YYYY, MM-DD-YYYY).
+_DATE_FORMATS: tuple[str, ...] = (
+    "%Y/%m/%d",  # 2024/07/10
+    "%Y_%m_%d",  # 2024_07_10
+    "%d %b %Y",  # 10 Jul 2024
+    "%b %d %Y",  # Jul 10 2024
+)
+
+
+def _parse_date(raw: Any) -> date:
+    if not isinstance(raw, str):
+        raise ValidationError(f"date must be a string, got {type(raw).__name__}")
+    text = raw.strip()
+    try:
+        return date.fromisoformat(text)
+    except (TypeError, ValueError):
+        pass
+    for fmt in _DATE_FORMATS:
+        try:
+            return datetime.strptime(text, fmt).date()
+        except ValueError:
+            continue
+    raise ValidationError(
+        f"date {raw!r} is not a recognised date "
+        f"(YYYY-MM-DD, YYYY/MM/DD, YYYY_MM_DD, 'DD Mon YYYY', or 'Mon DD YYYY')"
+    )
+
+
+def _to_decimal(raw: Any, field_name: str) -> Decimal:
+    if isinstance(raw, Decimal):
+        return raw
+    try:
+        return Decimal(str(raw))
+    except (InvalidOperation, TypeError, ValueError) as exc:
+        raise ValidationError(f"{field_name} {raw!r} is not numeric") from exc
+
+
+def _to_optional_int(raw: Any, field_name: str) -> int | None:
+    if raw is None:
+        return None
+    if isinstance(raw, bool):
+        raise ValidationError(f"{field_name} must be an integer, got bool")
+    try:
+        return int(raw)
+    except (TypeError, ValueError) as exc:
+        raise ValidationError(f"{field_name} {raw!r} is not an integer") from exc
+
+
+def _to_bool(raw: Any, field_name: str) -> bool:
+    if isinstance(raw, bool):
+        return raw
+    raise ValidationError(f"{field_name} must be a boolean, got {type(raw).__name__}")
+
+
+def _normalise_description(raw: Any) -> str:
+    if raw is None:
+        return EMPTY_DESCRIPTION_PLACEHOLDER
+    if not isinstance(raw, str):
+        raw = str(raw)
+    stripped = raw.strip()
+    return stripped if stripped else EMPTY_DESCRIPTION_PLACEHOLDER
+
+
+def _validate_amounts(
+    debit_amount: Decimal,
+    credit_amount: Decimal,
+    *,
+    is_brought_forward: bool,
+    is_final_balance: bool,
+) -> None:
+    if debit_amount < 0 or credit_amount < 0:
+        raise ValidationError("debit_amount and credit_amount must be non-negative")
+    if debit_amount > 0 and credit_amount > 0:
+        raise ValidationError("debit_amount and credit_amount cannot both be positive")
+    if is_brought_forward or is_final_balance:
+        if debit_amount != 0 or credit_amount != 0:
+            raise ValidationError(
+                "balance marker rows (is_brought_forward / is_final_balance) "
+                "must have debit_amount=0 and credit_amount=0"
+            )
+        return
+    if debit_amount == 0 and credit_amount == 0:
+        raise ValidationError(
+            "debit_amount and credit_amount cannot both be zero unless the row is a balance marker"
+        )
+
+
+def validate_and_normalise_rows(
+    rows: Iterable[RawBankTransaction],
+    *,
+    mode: str = "lenient",
+) -> ValidationResult:
+    if mode not in {"lenient", "strict"}:
+        raise ValueError(f"mode must be 'lenient' or 'strict', got {mode!r}")
+    strict = mode == "strict"
+
+    accepted: list[RawBankTransaction] = []
+    warnings: list[ValidationWarning] = []
+    seen_ids: set[str] = set()
+
+    for raw in rows:
+        tid = raw.id
+        try:
+            txn = _validate_single(raw)
+        except ValidationError as exc:
+            if strict:
+                raise
+            warnings.append(
+                ValidationWarning(code="row_invalid", transaction_id=tid, detail=str(exc))
+            )
+            continue
+
+        if txn.id in seen_ids:
+            warning = ValidationWarning(
+                code="duplicate_id",
+                transaction_id=txn.id,
+                detail=f"duplicate id {txn.id!r} — keeping the first occurrence",
+            )
+            if strict:
+                raise ValidationError(warning.detail)
+            warnings.append(warning)
+            continue
+        seen_ids.add(txn.id)
+
+        if txn.is_balance_marker:
+            warning = ValidationWarning(
+                code="balance_row_skipped",
+                transaction_id=txn.id,
+                detail=(
+                    f"balance marker row skipped "
+                    f"(is_brought_forward={txn.is_brought_forward}, "
+                    f"is_final_balance={txn.is_final_balance})"
+                ),
+            )
+            if strict:
+                raise ValidationError(warning.detail)
+            warnings.append(warning)
+            continue
+
+        if txn.is_debit:
+            warning = ValidationWarning(
+                code="non_credit_row_skipped",
+                transaction_id=txn.id,
+                detail=(f"input contract is credit-only (FR-002); skipping debit row {txn.id!r}"),
+            )
+            if strict:
+                raise ValidationError(warning.detail)
+            warnings.append(warning)
+            continue
+
+        if not txn.is_credit:
+            warning = ValidationWarning(
+                code="row_invalid",
+                transaction_id=txn.id,
+                detail=f"row {txn.id!r} is not a credit transaction",
+            )
+            if strict:
+                raise ValidationError(warning.detail)
+            warnings.append(warning)
+            continue
+
+        accepted.append(txn)
+
+    return ValidationResult(transactions=tuple(accepted), warnings=tuple(warnings))
+
+
+def _validate_single(raw: RawBankTransaction) -> RawBankTransaction:
+    tid = raw.id
+    if not tid or not isinstance(tid, str):
+        raise ValidationError(
+            f"transaction id is required and must be a non-empty string, got {tid!r}"
+        )
+    debit_amount = _to_decimal(raw.debit_amount, "debit_amount")
+    credit_amount = _to_decimal(raw.credit_amount, "credit_amount")
+    is_brought_forward = _to_bool(raw.is_brought_forward, "is_brought_forward")
+    is_final_balance = _to_bool(raw.is_final_balance, "is_final_balance")
+    _validate_amounts(
+        debit_amount,
+        credit_amount,
+        is_brought_forward=is_brought_forward,
+        is_final_balance=is_final_balance,
+    )
+    parsed_date = _parse_date(raw.date)
+    description = _normalise_description(raw.description)
+    return RawBankTransaction(
+        id=tid,
+        date=parsed_date.isoformat(),
+        description=description,
+        debit_amount=debit_amount,
+        credit_amount=credit_amount,
+        balance=_decimal_optional(raw.balance),
+        reference=raw.reference,
+        page=_to_optional_int(raw.page, "page"),
+        line=_to_optional_int(raw.line, "line"),
+        is_brought_forward=is_brought_forward,
+        is_final_balance=is_final_balance,
+    )
+
+
+def _decimal_optional(raw: Any) -> Decimal | None:
+    if raw is None:
+        return None
+    return _to_decimal(raw, "balance")
+
+
+def load_payload(path: Path) -> dict:
+    return json.loads(Path(path).read_text())
+
+
+class BankTransactionValidationService:
+    def validate_payload(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        mode: str = "lenient",
+        transactions_absence: TransactionsAbsence | None = None,
+    ) -> PayloadValidationResult:
+        warnings: list[ValidationWarning] = list(validate_payload_fields(payload, strict=False))
+
+        if transactions_absence == "missing":
+            detail = "'transactions' key is missing from the payload"
+            warnings.append(
+                ValidationWarning(
+                    code="no_transactions",
+                    transaction_id="",
+                    detail=detail,
+                )
+            )
+            return PayloadValidationResult(
+                transactions=(),
+                warnings=tuple(warnings),
+                early_exit=True,
+            )
+
+        if transactions_absence == "null":
+            detail = "'transactions' is null — expected a list of transaction objects"
+            warnings.append(
+                ValidationWarning(
+                    code="no_transactions",
+                    transaction_id="",
+                    detail=detail,
+                )
+            )
+            return PayloadValidationResult(
+                transactions=(),
+                warnings=tuple(warnings),
+                early_exit=True,
+            )
+
+        validated = validate_and_normalise_rows(payload.transactions, mode=mode)
+        warnings.extend(validated.warnings)
+        return PayloadValidationResult(
+            transactions=validated.transactions,
+            warnings=tuple(warnings),
+            early_exit=False,
+        )
+
+
+def default_service() -> BankTransactionValidationService:
+    return BankTransactionValidationService()
