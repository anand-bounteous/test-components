+"""Standalone feature scenario runner — no pytest dependency."""
+
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import logging
+import sys
+import traceback
+
+import yaml
+from nw_core.logging import configure_logging, setup_trace
+
+from tests.feature.support.DetectKwargs import detect_kwargs_from_expected
+from tests.feature.support.TestLogging import (
+    get_feature_logger,
+    log_candidate_dump,
+    log_test_detail,
+    log_test_summary,
+)
+from tests.feature.support.DetectScenario import detect_scenario
+from tests.feature.support.ScenarioDiscovery import ScenarioRef, discover_scenarios, list_modules
+from tests.feature.ScenariosTest import _validate_expected_block
+
+setup_trace()
+logger = get_feature_logger(__name__)
+
+_STATUS_PASS = "PASS"
+_STATUS_FAIL = "FAIL"
+_STATUS_ERROR = "ERROR"
+
+
+def _load_refs(
+    modules: list[str],
+    globs: list[str],
+    required_tags: list[str],
+) -> list[ScenarioRef]:
+    module_filter = modules or None
+    refs = discover_scenarios(modules=module_filter)
+    result: list[ScenarioRef] = []
+    for ref in refs:
+        if globs and not any(fnmatch.fnmatch(ref.scenario_id, g) for g in globs):
+            continue
+        if required_tags:
+            try:
+                tags = set(
+                    (yaml.safe_load(ref.path.read_text(encoding="utf-8")) or {}).get(
+                        "scenario_tags", []
+                    )
+                )
+            except Exception:
+                tags = set()
+            if not all(t in tags for t in required_tags):
+                continue
+        result.append(ref)
+    return result
+
+
+def _run_fixture(ref: ScenarioRef, debug: bool) -> tuple[str, str, str]:
+    path = ref.path
+    raw: dict = {}
+    desc = ""
+    try:
+        raw = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+        desc = (raw.get("scenario_description") or "").strip().replace("\n", " ")
+        expected = raw.get("expected", {})
+        result = detect_scenario(
+            ref.module,
+            raw,
+            include_audit=True,
+            **detect_kwargs_from_expected(expected),
+        )
+        scenario_id = raw.get("analysis_id", path.stem)
+        try:
+            _validate_expected_block(path.stem, expected, result)
+        finally:
+            log_test_summary(logger, scenario_id, result)
+            if debug:
+                log_test_detail(logger, raw, expected, result)
+            log_candidate_dump(logger, ref.parametrize_id, result)
+        print(f"  PASS  {ref.parametrize_id}")
+        return _STATUS_PASS, desc, ""
+    except AssertionError as exc:
+        detail = str(exc).split("\n")[0]
+        print(f"  FAIL  {ref.parametrize_id}  —  {detail}")
+        if debug:
+            traceback.print_exc()
+        return _STATUS_FAIL, desc, detail
+    except Exception as exc:
+        detail = f"{type(exc).__name__}: {exc}"
+        print(f"  ERROR {ref.parametrize_id}  —  {detail}")
+        traceback.print_exc()
+        return _STATUS_ERROR, desc, detail
+
+
+def _print_summary(results: list[tuple[ScenarioRef, str, str, str]]) -> None:
+    passed = [(ref, d) for ref, s, d, _ in results if s == _STATUS_PASS]
+    failed = [(ref, d, x) for ref, s, d, x in results if s == _STATUS_FAIL]
+    errored = [(ref, d, x) for ref, s, d, x in results if s == _STATUS_ERROR]
+
+    w = max((len(ref.parametrize_id) for ref, *_ in results), default=40)
+
+    def _row(param_id: str, desc: str, detail: str = "") -> str:
+        desc_short = (desc[:80] + "…") if len(desc) > 80 else desc
+        base = f"  {param_id:<{w}}  {desc_short}"
+        return base if not detail else f"{base}\n  {'':>{w}}  ↳ {detail}"
+
+    if passed:
+        print(f"\n── PASSED ({len(passed)}) {'─' * 40}")
+        for ref, desc in passed:
+            print(_row(ref.parametrize_id, desc))
+
+    if failed:
+        print(f"\n── FAILED ({len(failed)}) {'─' * 40}")
+        for ref, desc, detail in failed:
+            print(_row(ref.parametrize_id, desc, detail))
+
+    if errored:
+        print(f"\n── ERRORS ({len(errored)}) {'─' * 40}")
+        for ref, desc, detail in errored:
+            print(_row(ref.parametrize_id, desc, detail))
+
+    total = len(results)
+    print(f"\n{'═' * 60}")
+    parts = [f"{len(passed)} passed"]
+    if failed:
+        parts.append(f"{len(failed)} failed")
+    if errored:
+        parts.append(f"{len(errored)} error(s)")
+    parts.append(f"{total} total")
+    print(f"  {',  '.join(parts)}")
+    print(f"{'═' * 60}")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(
+        prog="python -m tests.feature.Runner",
+        description=(
+            "Run feature scenario YAML fixtures without pytest.\n\n"
+            "Fixtures live under agent-local tests/feature/scenarios/ and "
+            "tests/feature/scenarios/combination/.\n"
+            "Omit --module to run all modules."
+        ),
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    parser.add_argument(
+        "fixtures",
+        nargs="*",
+        metavar="GLOB",
+        help="Fixture stems or globs (e.g. Reaworld_600_* or Rent_001_*).",
+    )
+    parser.add_argument(
+        "--module",
+        action="append",
+        default=[],
+        dest="modules",
+        metavar="NAME",
+        help=f"Module name (repeat for OR). Available: {', '.join(list_modules())}",
+    )
+    parser.add_argument(
+        "--tag",
+        action="append",
+        default=[],
+        dest="tags",
+        metavar="TAG",
+        help="Filter by scenario_tag (repeat for AND semantics).",
+    )
+    parser.add_argument(
+        "--debug",
+        action="store_true",
+        default=False,
+        help="Enable DEBUG logging (full audit trace per fixture).",
+    )
+    parser.add_argument(
+        "--list",
+        action="store_true",
+        default=False,
+        dest="list_fixtures",
+        help="List all discovered fixtures, then exit.",
+    )
+    args = parser.parse_args(argv)
+
+    configure_logging(level=logging.DEBUG if args.debug else logging.INFO)
+    refs = _load_refs(args.modules, args.fixtures, args.tags)
+
+    if args.list_fixtures:
+        if not refs:
+            print("No feature scenario fixtures found.")
+            return 1
+        print(f"Feature scenario fixtures ({len(refs)} total):")
+        for ref in refs:
+            try:
+                data = yaml.safe_load(ref.path.read_text(encoding="utf-8")) or {}
+                desc = data.get("scenario_description", "(no description)")
+                tags = data.get("scenario_tags", [])
+            except Exception:
+                desc = "(unreadable)"
+                tags = []
+            print(f"  {ref.parametrize_id:50s}  {', '.join(tags) or '(no tags)':30s}  {desc}")
+        return 0
+
+    if not refs:
+        print("No fixtures matched the given filters.")
+        print(f"Available modules: {', '.join(list_modules())}")
+        return 1
+
+    print(f"Running {len(refs)} fixture(s)…")
+    results: list[tuple[ScenarioRef, str, str, str]] = []
+    for ref in refs:
+        status, desc, detail = _run_fixture(ref, debug=args.debug)
+        results.append((ref, status, desc, detail))
+
+    _print_summary(results)
+    failed_count = sum(1 for _, s, _, _ in results if s in (_STATUS_FAIL, _STATUS_ERROR))
+    return 0 if failed_count == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
