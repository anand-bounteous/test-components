+"""Post-scoring enrichment — region inference and gap-period candidates."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import replace
+
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.validation import ValidationWarning
+
+from .._models import (
+    BankTransaction,
+    CandidateSet,
+    CandidateTransaction,
+    GapPeriodCandidate,
+    candidate_transaction_from,
+)
+from .._services.recurrence import PaydayModel, fit_best_recurrence_model
+
+_ALL_REGIONS = ("EnglandAndWales", "Scotland", "NorthernIreland")
+_REGION_INFERENCE_MIN_DELTA = 0.05
+
+
+def infer_regions(
+    scored: list[CandidateSet],
+    normalised: Sequence[BankTransaction],
+    cal: WorkingDayCalendar,
+    warnings: list[ValidationWarning],
+) -> tuple[tuple[str, ...], list[CandidateSet], list[ValidationWarning]]:
+    """Infer UK calendar region(s) when ``country_region`` was not supplied."""
+    out_candidates: list[CandidateSet] = []
+    per_candidate_regions: list[set[str]] = []
+
+    for cand in scored:
+        cluster_ids = {t.transaction_id for t in cand.transactions}
+        cluster = [t for t in normalised if t.id in cluster_ids]
+        if len(cluster) < 2:
+            out_candidates.append(cand)
+            per_candidate_regions.append(set())
+            continue
+
+        freq = cand.detected_pattern.get("frequency", "unknown")
+        if freq not in ("monthly", "unknown"):
+            out_candidates.append(cand)
+            per_candidate_regions.append(set())
+            continue
+
+        region_scores: dict[str, float] = {}
+        for region in _ALL_REGIONS:
+            fit = fit_best_recurrence_model(cluster, calendar=cal, region=region)
+            if fit.model not in (
+                PaydayModel.WEEKLY_SAME_WEEKDAY,
+                PaydayModel.FORTNIGHTLY_SAME_WEEKDAY,
+                PaydayModel.FOUR_WEEKLY,
+                PaydayModel.IRREGULAR_SALARY_LIKE,
+            ):
+                region_scores[region] = fit.fit_score
+            else:
+                region_scores[region] = 0.0
+
+        if not region_scores or max(region_scores.values()) == 0.0:
+            out_candidates.append(cand)
+            per_candidate_regions.append(set())
+            continue
+
+        best_score = max(region_scores.values())
+        candidate_regions = {
+            r for r, s in region_scores.items() if best_score - s <= _REGION_INFERENCE_MIN_DELTA
+        }
+
+        new_meta = dict(cand.metadata)
+        new_meta["inferred_regions"] = sorted(candidate_regions)
+        new_meta["region_fit_scores"] = {r: round(s, 4) for r, s in region_scores.items()}
+        out_candidates.append(replace(cand, metadata=new_meta))
+        per_candidate_regions.append(candidate_regions)
+
+    union_regions: set[str] = set()
+    for r_set in per_candidate_regions:
+        union_regions |= r_set
+
+    non_empty = [r for r in per_candidate_regions if r]
+    conflict = False
+    if len(non_empty) >= 2:
+        all_intersection = set.intersection(*non_empty)
+        if not all_intersection:
+            conflict = True
+
+    updated_warnings = list(warnings)
+    if conflict:
+        updated_warnings.append(
+            ValidationWarning(
+                code="ambiguous_region",
+                transaction_id="",
+                detail=(
+                    "Calendar region could not be determined uniquely — different "
+                    "candidate sets best match different UK regions. "
+                    f"Regions seen: {sorted(union_regions)}."
+                ),
+            )
+        )
+
+    return tuple(sorted(union_regions)), out_candidates, updated_warnings
+
+
+def apply_gap_periods(
+    scored: list[CandidateSet],
+    warnings: list[ValidationWarning],
+) -> tuple[list[CandidateSet], list[ValidationWarning]]:
+    """Emit missing-period warnings and build gap-period candidates."""
+    scored_with_gaps: list[CandidateSet] = []
+
+    for cand in scored:
+        gs = cand.metadata.get("gap_summary", {})
+        missing = gs.get("missing_months", [])
+        orphan_credits = cand.metadata.get("orphan_credits", [])
+
+        if len(missing) >= 1:
+            expected = gs.get("expected_periods", "?")
+            matched = gs.get("matched_periods", "?")
+            missing_label = ", ".join(missing[:10]) + ("…" if len(missing) > 10 else "")
+            warnings.append(
+                ValidationWarning(
+                    code="missing_salary_periods",
+                    transaction_id="",
+                    detail=(
+                        f"Candidate {cand.candidate_set_id!r}: "
+                        f"{expected} expected, {matched} matched. "
+                        f"Missing: {missing_label}."
+                    ),
+                )
+            )
+
+        gap_candidates: list[GapPeriodCandidate] = []
+        if missing and orphan_credits:
+            missing_set = set(missing)
+            by_period: dict[str, list[CandidateTransaction]] = {}
+            for nt in orphan_credits:
+                period = f"{nt.date.year}-{nt.date.month:02d}"
+                if period in missing_set:
+                    ct = candidate_transaction_from(
+                        nt,
+                        confidence=0.35,
+                        confidence_band="very_low",
+                        reasoning=(
+                            f"Partial description match; date and amount align with "
+                            f"expected salary period {period}. "
+                            f"Employer token overlap is incomplete — user review recommended.",
+                        ),
+                    )
+                    by_period.setdefault(period, []).append(ct)
+            gap_candidates = [
+                GapPeriodCandidate(period=p, plausible_transactions=tuple(txs))
+                for p, txs in sorted(by_period.items())
+            ]
+
+        if gap_candidates or cand.gap_period_candidates:
+            cand = replace(
+                cand,
+                gap_period_candidates=tuple(gap_candidates) or cand.gap_period_candidates,
+            )
+        scored_with_gaps.append(cand)
+
+    return scored_with_gaps, warnings
+
+
+__all__ = [
+    "apply_gap_periods",
+    "infer_regions",
+]
