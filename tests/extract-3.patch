+"""REST route for bonus/expense split."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import BonusExpenseSplitRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import (
+    bank_transactions_from_wire,
+    candidate_sets_from_wire,
+)
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..BonusExpenseSplitTools import run_bonus_expense_split
+
+
+class BonusExpenseSplitRoute(BaseToolRoute):
+    tool_name = "run_bonus_expense_split"
+    path = "/scoring/bonus-expense-split"
+    tags = ("scoring",)
+    summary = "Split bonus and expense credits from mixed salary candidates."
+    openapi_filename = "run_bonus_expense_split.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def bonus_expense_split(body: BonusExpenseSplitRequest):
+            try:
+                build_context(body)
+                audit = build_audit(body)
+                result = run_bonus_expense_split(
+                    candidate_sets_from_wire(body.pool),
+                    bank_transactions_from_wire(body.normalised),
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
