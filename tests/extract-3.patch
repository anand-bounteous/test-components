+from typing import Any
+
+from nw_app_template_api.config.settings import AppSettings
+from nw_aglib_toolkit.agent import AgentClient, InProcessAgentClient, RestAgentClient
+
+
+class EchoClientFactory:
+    @staticmethod
+    def create(settings: AppSettings) -> AgentClient:
+        mode = settings.echo_agent_mode.lower()
+        if mode == "embedded":
+            from nw_app_template_api.clients.echo_agent import EchoAgent
+
+            return InProcessAgentClient(EchoAgent())
+        return RestAgentClient(settings.echo_agent_rest_url)
+
+
+async def call_echo(settings: AppSettings, payload: dict[str, Any]) -> dict[str, Any]:
+    client = EchoClientFactory.create(settings)
+    return await client.invoke(payload)
