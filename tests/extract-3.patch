+"""Resolve anchor transaction ids from hints audit or enriched features."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+
+from .._models import BankTransaction, TransactionFeatures
+from .models import AppliedHints
+
+
+def use_anchor_enriched_features(config: AppConfig) -> bool:
+    """When true, anchor presence/bonus reads ``TransactionFeatures.is_anchor``."""
+    processing = config.data.get("processing", {})
+    if not isinstance(processing, dict):
+        return True
+    return bool(processing.get("use_anchor_enriched_features", True))
+
+
+def anchor_transaction_ids(
+    applied_hints: AppliedHints | None,
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    use_feature_flags: bool,
+) -> frozenset[str]:
+    if use_feature_flags:
+        return frozenset(
+            txn_id for txn_id, features in features_by_id.items() if features.is_anchor
+        )
+    if not applied_hints:
+        return frozenset()
+    return frozenset(anchor.transaction_id for anchor in applied_hints.anchors)
+
+
+def ambiguous_anchor_transaction_ids(
+    applied_hints: AppliedHints | None,
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    use_feature_flags: bool,
+) -> frozenset[str]:
+    if use_feature_flags:
+        return frozenset(
+            txn_id for txn_id, features in features_by_id.items() if features.ambiguous_anchor
+        )
+    if not applied_hints:
+        return frozenset()
+    return frozenset(anchor.transaction_id for anchor in applied_hints.anchors if anchor.ambiguous)
+
+
+def count_anchors_in_cluster(
+    cluster_txn_ids: set[str],
+    applied_hints: AppliedHints | None,
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    use_feature_flags: bool,
+) -> int:
+    anchor_ids = anchor_transaction_ids(
+        applied_hints,
+        features_by_id,
+        use_feature_flags=use_feature_flags,
+    )
+    return sum(1 for txn_id in cluster_txn_ids if txn_id in anchor_ids)
+
+
+def group_has_anchor(
+    group: Sequence[BankTransaction],
+    applied_hints: AppliedHints | None,
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    use_feature_flags: bool,
+) -> bool:
+    anchor_ids = anchor_transaction_ids(
+        applied_hints,
+        features_by_id,
+        use_feature_flags=use_feature_flags,
+    )
+    return any(txn.id in anchor_ids for txn in group)
