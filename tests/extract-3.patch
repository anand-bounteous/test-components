+"""Percent-based amount range matching for property sale hints."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+
+def amount_bounds(hint_amount: Decimal, tolerance_pct: float) -> tuple[Decimal, Decimal]:
+    if hint_amount <= 0:
+        raise ValueError("hint amount must be positive")
+    tolerance = Decimal(str(tolerance_pct))
+    one = Decimal("1")
+    lower = hint_amount * (one - tolerance)
+    upper = hint_amount * (one + tolerance)
+    return lower, upper
+
+
+def amount_in_range(amount: Decimal, hint_amount: Decimal, tolerance_pct: float) -> bool:
+    lower, upper = amount_bounds(hint_amount, tolerance_pct)
+    return lower <= amount <= upper
+
+
+def aggregate_in_range(total: Decimal, hint_amount: Decimal, tolerance_pct: float) -> bool:
+    return amount_in_range(total, hint_amount, tolerance_pct)
+
+
+def coverage_pct(total: Decimal, hint_amount: Decimal) -> float:
+    if hint_amount <= 0:
+        return 0.0
+    return float(min(total, hint_amount) / hint_amount)
