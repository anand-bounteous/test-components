+        return payload
+
+    metadata = get_tool_metadata(sample)
+
+    assert metadata is not None
+    assert metadata.name == "sample_tool"
+    assert metadata.description == "Sample tool description."
+    assert metadata.category == "test"
+    assert metadata.tags == ("unit",)
+
+
+def test_tool_annotation_captures_signature_metadata():
+    @tool(name="typed_tool", description="Typed tool.")
+    def typed_tool(payload: dict, *, mode: str = "lenient") -> dict:
+        """Typed tool summary."""
+        return payload
+
+    metadata = get_tool_metadata(typed_tool)
+
+    assert metadata is not None
+    assert metadata.return_type == "dict"
+    assert len(metadata.parameters) == 2
+    assert metadata.parameters[0].name == "payload"
+    assert metadata.parameters[0].required is True
+    assert metadata.parameters[1].name == "mode"
+    assert metadata.parameters[1].required is False
