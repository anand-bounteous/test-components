+import { describe, expect, it } from "vitest";
+
+import {
+  extractionPageToViewer,
+  pixelBBoxToNormalized,
+  regionToAnnotation,
+} from "../../src/adapters/extractionToAnnotations";
+import { sampleExtractionPage } from "../../src/fixtures/sampleExtraction";
+
+describe("extractionToAnnotations", () => {
+  it("converts pixel bbox to normalized coordinates", () => {
+    const bbox = pixelBBoxToNormalized({ x: 100, y: 200, w: 50, h: 25 }, 1000, 2000);
+    expect(bbox).toEqual({ x1: 0.1, y1: 0.1, x2: 0.15, y2: 0.1125 });
+  });
+
+  it("maps region type and source tool to annotation", () => {
+    const annotation = regionToAnnotation(sampleExtractionPage.regions[0], sampleExtractionPage);
+    expect(annotation.kind).toBe("text");
+    expect(annotation.source).toBe("pymupdf");
+  });
+
+  it("builds statement page and annotations for viewer", () => {
+    const { statementPage, annotations } = extractionPageToViewer(sampleExtractionPage);
+    expect(statementPage.pageIndex).toBe(0);
+    expect(annotations).toHaveLength(2);
+  });
+});
