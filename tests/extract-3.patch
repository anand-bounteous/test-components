+++ agents-components/libs/ui/bank-statement/tests/unit/geometry.test.ts	2026-07-10 10:20:21
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  bboxToPixels,
+  doctrGeometryToBBox,
+  pointInBBox,
+  polygonToPixelPoints,
+} from "../../src/utils/geometry";
+
+describe("geometry", () => {
+  it("converts normalized bbox to pixels", () => {
+    const result = bboxToPixels({ x1: 0.1, y1: 0.2, x2: 0.5, y2: 0.8 }, 1000, 500);
+    expect(result.x).toBe(100);
+    expect(result.y).toBe(100);
+    expect(result.width).toBe(400);
+    expect(result.height).toBeCloseTo(300);
+  });
+
+  it("handles zero-size bbox", () => {
+    expect(bboxToPixels({ x1: 0.5, y1: 0.5, x2: 0.5, y2: 0.5 }, 800, 600)).toEqual({
+      x: 400,
+      y: 300,
+      width: 0,
+      height: 0,
+    });
+  });
+
+  it("checks point inside bbox", () => {
+    const bbox = { x1: 0.1, y1: 0.1, x2: 0.9, y2: 0.9 };
+    expect(pointInBBox(0.5, 0.5, bbox)).toBe(true);
+    expect(pointInBBox(0.05, 0.5, bbox)).toBe(false);
+  });
+
+  it("converts doctr straight geometry to bbox", () => {
+    expect(
+      doctrGeometryToBBox([
+        [0.1, 0.2],
+        [0.8, 0.7],
+      ]),
+    ).toEqual({ x1: 0.1, y1: 0.2, x2: 0.8, y2: 0.7 });
+  });
+
+  it("converts doctr polygon geometry to bbox", () => {
+    expect(
+      doctrGeometryToBBox([
+        [0.2, 0.1],
+        [0.9, 0.15],
+        [0.85, 0.6],
+        [0.15, 0.55],
+      ]),
+    ).toEqual({ x1: 0.15, y1: 0.1, x2: 0.9, y2: 0.6 });
+  });
+
+  it("converts polygon points to pixel string", () => {
+    expect(
+      polygonToPixelPoints(
+        [
+          [0, 0],
+          [1, 0],
+          [1, 1],
+        ],
+        100,
+        200,
+      ),
+    ).toBe("0,0 100,0 100,200");
+  });
+});
