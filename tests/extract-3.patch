+"""Public tool functions for similarity-graph clustering."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    BankTransaction,
+    CandidateSet,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import AppliedHints
+from nw_agcore_bank_transactions.pipeline.graph_clustering.GraphClusteringService import (
+    GraphClusteringService,
+    dedup_candidate_pool,
+)
+from nw_agcore_bank_transactions.pipeline.graph_clustering.models import (
+    DedupCandidatePoolToolResult,
+    GraphClusteringToolResult,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "DedupCandidatePoolTools",
+    "DedupCandidatePoolToolResult",
+    "GraphClusteringTools",
+    "GraphClusteringToolResult",
+    "run_dedup_candidate_pool",
+    "run_graph_clustering",
+]
+
+_default_graph_tool = None
+_default_dedup_tool = None
+
+
+def _graph_tool() -> GraphClusteringTools:
+    global _default_graph_tool
+    if _default_graph_tool is None:
+        _default_graph_tool = GraphClusteringTools()
+    return _default_graph_tool
+
+
+def _dedup_tool() -> DedupCandidatePoolTools:
+    global _default_dedup_tool
+    if _default_dedup_tool is None:
+        _default_dedup_tool = DedupCandidatePoolTools()
+    return _default_dedup_tool
+
+
+class GraphClusteringTools(BaseTool[GraphClusteringToolResult]):
+    phase_name = "graph_clustering"
+
+    @LogFn
+    def _execute(
+        self,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        *,
+        applied_hints: AppliedHints | None = None,
+        config: AppConfig,
+    ) -> GraphClusteringToolResult:
+        materialised = list(normalised)
+        detector = GraphClusteringService(config=config)
+        candidates = detector.emit_candidates(
+            materialised,
+            features_by_id,
+            applied_hints=applied_hints,
+        )
+        return GraphClusteringToolResult(candidates=candidates)
+
+    def build_input_summary(
+        self,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(normalised, (list, tuple)):
+            return {"credits": len(normalised)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: GraphClusteringToolResult,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {"candidates": len(result.candidates)}
+
+    def trace_output(self, result: GraphClusteringToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for c in result.candidates:
+            self._logger.trace(
+                "graph.candidate  id=%s  txns=%d  txn_ids=%s",
+                c.candidate_set_id,
+                len(c.transactions),
+                [t.transaction_id for t in c.transactions],
+            )
+
+
+class DedupCandidatePoolTools(BaseTool[DedupCandidatePoolToolResult]):
+    phase_name = "dedup"
+
+    @LogFn
+    def _execute(
+        self,
+        skeleton_candidates: Sequence[CandidateSet],
+        graph_candidates: Sequence[CandidateSet],
+        *,
+        overlap_threshold: float = 0.90,
+    ) -> DedupCandidatePoolToolResult:
+        candidates = dedup_candidate_pool(
+            skeleton_candidates,
+            graph_candidates,
+            overlap_threshold=overlap_threshold,
+        )
+        return DedupCandidatePoolToolResult(candidates=candidates)
+
+    def build_input_summary(
+        self,
+        skeleton_candidates: Sequence[CandidateSet],
+        graph_candidates: Sequence[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "skeleton": len(skeleton_candidates),
+            "graph": len(graph_candidates),
+            "total": len(skeleton_candidates) + len(graph_candidates),
+            "overlap_threshold": kwargs.get("overlap_threshold", 0.90),
+        }
+
+    def build_output_summary(
+        self,
+        result: DedupCandidatePoolToolResult,
+        skeleton_candidates: Sequence[CandidateSet],
+        graph_candidates: Sequence[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        before = len(skeleton_candidates) + len(graph_candidates)
+        return {
+            "pool": len(result.candidates),
+            "removed": before - len(result.candidates),
+        }
+
+    def trace_output(self, result: DedupCandidatePoolToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for c in result.candidates:
+            self._logger.trace(
+                "dedup.pool  id=%s  txns=%d",
+                c.candidate_set_id,
+                len(c.transactions),
+            )
+
+
+@tool(
+    name="run_graph_clustering",
+    description="Run graph-clustering candidate generation with standard tool logging.",
+    category="banking.clustering",
+    tags=["banking", "clustering"],
+)
+def run_graph_clustering(
+    normalised: Iterable[BankTransaction],
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    applied_hints: AppliedHints | None = None,
+    config: AppConfig,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> GraphClusteringToolResult:
+    """Generate graph-clustering salary candidate sets.
+
+    Args:
+        normalised: Normalised credit transactions to cluster.
+        features_by_id: Feature map keyed by transaction id.
+        applied_hints: Hints applied in earlier phases.
+        config: Application configuration for clustering rules.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with clustering warnings.
+
+    Returns:
+        GraphClusteringToolResult with graph-derived candidate sets.
+    """
+    return _graph_tool().run(
+        normalised,
+        features_by_id,
+        audit=audit,
+        warnings=warnings,
+        applied_hints=applied_hints,
+        config=config,
+    )
+
+
+@tool(
+    name="run_dedup_candidate_pool",
+    description="Merge skeleton and graph candidates by transaction-id overlap.",
+    category="banking.clustering",
+    tags=["banking", "clustering"],
+)
+def run_dedup_candidate_pool(
+    skeleton_candidates: Sequence[CandidateSet],
+    graph_candidates: Sequence[CandidateSet],
+    *,
+    overlap_threshold: float = 0.90,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> DedupCandidatePoolToolResult:
+    """Merge skeleton and graph candidates by transaction-id overlap.
+
+    Args:
+        skeleton_candidates: Candidate sets from skeleton grouping.
+        graph_candidates: Candidate sets from graph clustering.
+        overlap_threshold: Minimum overlap ratio to treat sets as duplicates.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with dedup warnings.
+
+    Returns:
+        DedupCandidatePoolToolResult with merged candidate pool.
+    """
+    return _dedup_tool().run(
+        skeleton_candidates,
+        graph_candidates,
+        audit=audit,
+        warnings=warnings,
+        overlap_threshold=overlap_threshold,
+    )
