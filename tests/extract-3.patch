+import os
+from pathlib import Path
+
+import typer
+from nw_agbus_salary_extractor.app.Bootstrap import build_runtime
+from nw_aglib_toolkit.channels.grpc.AgentChannelServer import run_agent_channels
+
+app_cli = typer.Typer()
+
+
+def _component_root() -> Path:
+    return Path(__file__).resolve().parents[3]
+
+
+@app_cli.command()
+def run(env: str = typer.Option("dev", "--env", help="Environment: dev|qa|uat|prod")) -> None:
+    os.environ["NW_ENV"] = env
+    root = _component_root()
+    runtime, settings, _manifest = build_runtime(root)
+
+    if runtime.app is not None and runtime.grpc_servicers:
+        typer.echo(
+            f"Starting REST on {settings.host}:{settings.port} "
+            f"and gRPC on {settings.host}:{settings.grpc_port}"
+        )
+    elif runtime.app is not None:
+        typer.echo(f"Starting REST on {settings.host}:{settings.port}")
+    elif runtime.grpc_servicers:
+        typer.echo(f"Starting gRPC on {settings.host}:{settings.grpc_port}")
+    elif runtime.tool_registry:
+        typer.echo(f"Tools: {runtime.tool_registry.list_schemas()}")
+        return
+    else:
+        typer.echo("No channels enabled in deployment.yaml")
+        return
+
+    run_agent_channels(runtime, settings)
+
+
+if __name__ == "__main__":
+    app_cli()
