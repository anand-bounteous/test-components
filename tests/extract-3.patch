+"""Phase 1 — input validation and credit-only enforcement (FR-001, FR-002)."""
+
+from __future__ import annotations
+
+import json
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.validation import (
+    EMPTY_DESCRIPTION_PLACEHOLDER,
+    ValidationError,
+    input_validator,
+    validate_and_normalise_rows,
+    validate_schema,
+)
+
+
+def _good_row(**overrides) -> RawBankTransaction:
+    base = {
+        "id": "t01",
+        "date": "2024-01-31",
+        "description": "BACS ACME LTD PAYROLL",
+        "debit_amount": Decimal("0"),
+        "credit_amount": Decimal("2450.00"),
+    }
+    base.update(overrides)
+    return RawBankTransaction(**base)
+
+
+def test_validates_a_clean_credit_row():
+    result = validate_and_normalise_rows([_good_row()])
+    assert len(result.transactions) == 1
+    assert result.transactions[0].id == "t01"
+    assert result.transactions[0].is_credit
+    assert result.warnings == ()
+
+
+def test_rejects_unparseable_date_in_strict_mode():
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([_good_row(date="31/01/2024")], mode="strict")
+
+
+def test_warns_on_unparseable_date_in_lenient_mode():
+    result = validate_and_normalise_rows([_good_row(date="31/01/2024")])
+    assert result.transactions == ()
+    codes = [w.code for w in result.warnings]
+    assert codes == ["row_invalid"]
+
+
+def test_rejects_non_numeric_credit_amount_strict():
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([_good_row(credit_amount="not-a-number")], mode="strict")
+
+
+def test_replaces_empty_description_with_placeholder():
+    row = _good_row(description="   ")
+    result = validate_and_normalise_rows([row])
+    assert result.transactions[0].description == EMPTY_DESCRIPTION_PLACEHOLDER
+
+
+def test_duplicate_ids_keep_first_emit_warning():
+    a = _good_row(id="t01")
+    b = _good_row(id="t01", date="2024-02-29", credit_amount=2450.00)
+    result = validate_and_normalise_rows([a, b])
+    assert [t.id for t in result.transactions] == ["t01"]
+    assert any(w.code == "duplicate_id" for w in result.warnings)
+
+
+def test_duplicate_id_raises_in_strict_mode():
+    a = _good_row(id="t01")
+    b = _good_row(id="t01", date="2024-02-29")
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([a, b], mode="strict")
+
+
+def test_credit_only_skips_debit_in_lenient_with_warning():
+    debit = _good_row(id="t02", debit_amount=47.20, credit_amount=0)
+    credit = _good_row(id="t03")
+    result = validate_and_normalise_rows([credit, debit])
+    assert [t.id for t in result.transactions] == ["t03"]
+    codes = [w.code for w in result.warnings]
+    assert codes == ["non_credit_row_skipped"]
+    assert result.warnings[0].transaction_id == "t02"
+
+
+def test_credit_only_raises_in_strict_mode():
+    debit = _good_row(id="t02", debit_amount=47.20, credit_amount=0)
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([debit], mode="strict")
+
+
+def test_credit_only_does_not_drop_credits_around_a_debit():
+    rows = [_good_row(id=f"good{i}", date=f"2024-0{i + 1}-01") for i in range(3)]
+    rows.insert(2, _good_row(id="bad", debit_amount=1, credit_amount=0))
+    result = validate_and_normalise_rows(rows)
+    assert [t.id for t in result.transactions] == ["good0", "good1", "good2"]
+
+
+def test_input_validator_is_a_singleton():
+    assert input_validator() is input_validator()
+
+
+def test_schema_accepts_a_real_fixture_strict(scenarios_root: Path):
+    payload = json.loads((scenarios_root / "ideal" / "01_stable_monthly_bacs.json").read_text())
+    assert validate_schema(payload, strict=True) == ()
+
+
+def test_schema_rejects_missing_required_field_strict():
+    payload = {"analysis_id": "x"}
+    with pytest.raises(ValidationError):
+        validate_schema(payload, strict=True)
+
+
+def test_schema_lenient_returns_warnings_instead_of_raising():
+    payload = {"analysis_id": "x"}
+    warnings = validate_schema(payload, strict=False)
+    assert warnings
+    assert all(w.code == "schema_violation" for w in warnings)
+
+
+def test_rejects_both_debit_and_credit_positive():
+    bad = _good_row(debit_amount=10, credit_amount=10)
+    result = validate_and_normalise_rows([bad])
+    assert result.transactions == ()
+    assert result.warnings[0].code == "row_invalid"
+
+
+def test_zero_amount_without_balance_marker_is_invalid():
+    row = _good_row(debit_amount=0, credit_amount=0)
+    result = validate_and_normalise_rows([row])
+    assert result.transactions == ()
+    assert result.warnings[0].code == "row_invalid"
+
+
+def test_missing_id_is_invalid_in_lenient_mode():
+    row = _good_row(id="")
+    result = validate_and_normalise_rows([row])
+    assert result.transactions == ()
+    assert result.warnings[0].code == "row_invalid"
+
+
+def test_balance_marker_rows_are_skipped():
+    row = _good_row(
+        id="bf",
+        debit_amount=0,
+        credit_amount=0,
+        is_brought_forward=True,
+        description="BROUGHT FORWARD",
+    )
+    result = validate_and_normalise_rows([row])
+    assert result.transactions == ()
+    assert result.warnings[0].code == "balance_row_skipped"
+
+
+def test_balance_marker_requires_zero_amounts():
+    row = _good_row(is_final_balance=True, credit_amount=100)
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([row], mode="strict")
+
+
+def test_optional_balance_is_coerced_to_decimal():
+    row = _good_row(balance=10500.21)
+    result = validate_and_normalise_rows([row])
+    assert result.transactions[0].balance is not None
+    assert str(result.transactions[0].balance) == "10500.21"
+
+
+def test_invalid_balance_raises_in_strict():
+    row = _good_row(balance="not-a-number")
+    with pytest.raises(ValidationError):
+        validate_and_normalise_rows([row], mode="strict")
+
+
+def test_page_and_line_are_optional_integers():
+    row = _good_row(page=2, line=14)
+    result = validate_and_normalise_rows([row])
+    txn = result.transactions[0]
+    assert txn.page == 2
+    assert txn.line == 14
+
+
+def test_load_payload_round_trips(tmp_path):
+    from nw_agcore_bank_transactions.pipeline.validation import load_payload
+
+    target = tmp_path / "payload.json"
+    target.write_text(json.dumps({"x": 1}))
+    assert load_payload(target) == {"x": 1}
+
+
+def test_schema_warning_links_to_transaction_id(scenarios_root: Path):
+    payload = json.loads((scenarios_root / "ideal" / "01_stable_monthly_bacs.json").read_text())
+    payload["transactions"][0]["credit_amount"] = "not-numeric"
+    warnings = validate_schema(payload, strict=False)
+    assert warnings
+    assert any(w.transaction_id == "t01" for w in warnings)
+
+
+def test_validation_mode_rejects_unknown_value():
+    with pytest.raises(ValueError):
+        validate_and_normalise_rows([_good_row()], mode="banana")
