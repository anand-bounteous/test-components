+from __future__ import annotations
+
+from pathlib import Path
+
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import DocumentPage, PdfKind, RasterPage
+from nw_agcore_document_data_extractor.pipeline._models.Region import Region
+from nw_agcore_document_data_extractor.pipeline._models.TableModel import TableModel
+
+
+def full_text_from_regions(regions: list[Region]) -> str:
+    return "\n".join(r.text for r in regions if r.text.strip())
+
+
+def build_document_pages(
+    raster_pages: list[RasterPage],
+    *,
+    pdf_kind: PdfKind = "vector",
+    image_ref_prefix: str = "raster/pages",
+    regions_by_page: dict[int, list[Region]] | None = None,
+    tables_by_page: dict[int, list[TableModel]] | None = None,
+    table_regions_by_page: dict[int, list[Region]] | None = None,
+) -> list[DocumentPage]:
+    regions_by_page = regions_by_page or {}
+    tables_by_page = tables_by_page or {}
+    table_regions_by_page = table_regions_by_page or {}
+    pages: list[DocumentPage] = []
+    for raster in raster_pages:
+        idx = raster.page_index
+        text_regions = list(regions_by_page.get(idx, []))
+        table_regions = list(table_regions_by_page.get(idx, []))
+        all_regions = text_regions + table_regions
+        rel_image = f"{image_ref_prefix}/page-{idx:03d}.png"
+        pages.append(DocumentPage(
+            page_index=idx,
+            width=raster.width,
+            height=raster.height,
+            dpi=raster.dpi,
+            pdf_kind=pdf_kind,
+            regions=all_regions,
+            tables=list(tables_by_page.get(idx, [])),
+            full_text=full_text_from_regions(text_regions),
+            page_image_ref=rel_image,
+        ))
+    return pages
+
+
