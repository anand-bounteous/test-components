+from __future__ import annotations
+
+import json
+import shutil
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+from nw_agcore_document_data_extractor.pipeline._models.AuditStep import SolutionTimings
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import DocumentPage
+from nw_agcore_document_data_extractor.pipeline._models.results.ExtractorResult import ExtractorResult
+
+
+def new_run_id() -> str:
+    return uuid.uuid4().hex[:12]
+
+
+def write_extractor_outputs(
+    *,
+    run_dir: Path,
+    solution_name: str,
+    artifact_stage: str,
+    result: ExtractorResult,
+    subprocess_request: dict | None = None,
+    subprocess_result: dict | None = None,
+) -> None:
+    solution_dir = run_dir / solution_name
+    artifacts_dir = solution_dir / "artifacts" / artifact_stage
+    artifacts_dir.mkdir(parents=True, exist_ok=True)
+    result.artifacts_dir = str(solution_dir / "artifacts")
+
+    for page in result.pages:
+        page_slice = {
+            "regions": [r.model_dump(mode="json") for r in page.regions],
+            "tables": [t.model_dump(mode="json") for t in page.tables],
+            "full_text": page.full_text,
+        }
+        (artifacts_dir / f"page-{page.page_index:03d}.json").write_text(
+            json.dumps(page_slice, indent=2, default=str) + "\n",
+            encoding="utf-8",
+        )
+
+    if subprocess_request is not None:
+        (artifacts_dir / "request.json").write_text(
+            json.dumps(subprocess_request, indent=2, default=str) + "\n",
+            encoding="utf-8",
+        )
+    if subprocess_result is not None:
+        (artifacts_dir / "result.json").write_text(
+            json.dumps(subprocess_result, indent=2, default=str) + "\n",
+            encoding="utf-8",
+        )
+
+    (solution_dir / "result.json").write_text(
+        result.model_dump_json(indent=2, by_alias=True) + "\n",
+        encoding="utf-8",
+    )
+    audit_payload = {
+        "extractor_name": solution_name,
+        "solution_name": solution_name,
+        "audit": [s.model_dump(mode="json") for s in result.audit],
+        "timings": result.timings.model_dump(mode="json"),
+    }
+    (solution_dir / "audit.json").write_text(
+        json.dumps(audit_payload, indent=2, default=str) + "\n",
+        encoding="utf-8",
+    )
+
+
+def copy_document(pdf_path: Path, run_dir: Path) -> Path:
+    doc_dir = run_dir / "document"
+    doc_dir.mkdir(parents=True, exist_ok=True)
+    dest = doc_dir / pdf_path.name
+    shutil.copy2(pdf_path, dest)
+    return dest
+
+
+def timings_from_audit(result: ExtractorResult) -> SolutionTimings:
+    by_stage = {step.stage_name: step.duration_ms for step in result.audit}
+    total = sum(by_stage.values())
+    result.timings = SolutionTimings(total_ms=total, by_stage=by_stage)
+    return result.timings
+
+
+def overall_confidence_from_pages(pages: list[DocumentPage]) -> float:
+    confidences: list[float] = []
+    for page in pages:
+        for region in page.regions:
+            if region.confidence is not None:
+                confidences.append(region.confidence)
+        for table in page.tables:
+            for cell in table.cells:
+                if cell.confidence is not None:
+                    confidences.append(cell.confidence)
+    if not confidences:
+        return 1.0
+    return sum(confidences) / len(confidences)
+
+
+def write_run_manifest(path: Path, manifest: dict) -> None:
+    path.write_text(json.dumps(manifest, indent=2, default=str) + "\n", encoding="utf-8")
+
+
+def utc_now() -> datetime:
+    return datetime.now(timezone.utc)
