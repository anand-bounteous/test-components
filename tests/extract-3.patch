+"""Unit tests for anchor flag projection onto transaction features."""
+
+from __future__ import annotations
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction, TransactionFeatures
+from nw_agcore_bank_transactions.pipeline.hints.AnchorFlags import attach_anchor_flags, features_from_transactions
+
+
+def _txn(tid: str, *, is_anchor: bool = False) -> BankTransaction:
+    raw = RawBankTransaction(id=tid, date="2024-01-15", description="ACME PAY", credit_amount="2500")
+    features = TransactionFeatures(
+        transaction_id=tid,
+        payment_channel="bacs_or_direct_credit",
+        payment_channel_confidence=0.8,
+        is_anchor=is_anchor,
+    )
+    return BankTransaction(raw=raw, normalised_description="ACME PAY", description_tokens=("ACME", "PAY"), skeleton="ACME PAY", features=features)
+
+
+@pytest.mark.unit
+def test_attach_anchor_flags_marks_matching_transactions():
+    txns = (_txn("t1"), _txn("t2"))
+    result = attach_anchor_flags(txns, {"t1": "hint-1"})
+    assert result[0].features is not None
+    assert result[0].features.is_anchor is True
+    assert result[0].features.anchor_hint_id == "hint-1"
+    assert result[1].features is not None
+    assert result[1].features.is_anchor is False
+
+
+@pytest.mark.unit
+def test_attach_anchor_flags_sets_ambiguous_flag():
+    txns = (_txn("t1"),)
+    result = attach_anchor_flags(txns, {"t1": "hint-1"}, ambiguous_ids={"t1"})
+    assert result[0].features.ambiguous_anchor is True
+
+
+@pytest.mark.unit
+def test_features_from_transactions_collects_non_none():
+    txns = (_txn("t1"), _txn("t2"))
+    features = features_from_transactions(txns)
+    assert len(features) == 2
+    assert features[0].transaction_id == "t1"
