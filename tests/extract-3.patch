+#!/usr/bin/env python3
+"""Validate business feature YAML scenario conventions."""
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+import yaml
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+MODULE_DIRS = {
+    "employment": REPO_ROOT / "tests/feature/scenarios/employment",
+    "rent": REPO_ROOT / "tests/feature/scenarios/rent",
+    "gift": REPO_ROOT / "tests/feature/scenarios/gift",
+    "property_sale": REPO_ROOT / "tests/feature/scenarios/property_sale",
+    "combination": REPO_ROOT / "tests/feature/scenarios/combination",
+}
+STRESS_DIR = REPO_ROOT / "tests/feature/scenarios_stress"
+
+
+def _normalize(value: str) -> str:
+    return re.sub(r"[^a-z0-9]", "", value.lower())
+
+
+def _split_camel(segment: str) -> list[str]:
+    spaced = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", segment)
+    return [part for part in spaced.split("_") if part]
+
+
+def expected_analysis_id(stem: str) -> str:
+    parts: list[str] = []
+    for segment in stem.split("_"):
+        parts.extend(_split_camel(segment))
+    return "_".join(part.lower() for part in parts)
+
+
+def validate_file(path: Path, *, module: str) -> list[str]:
+    errors: list[str] = []
+    data = yaml.safe_load(path.read_text()) or {}
+    stem = path.stem
+
+    if module == "combination":
+        modules = data.get("modules") or []
+        expected_by_module = data.get("expected_by_module") or {}
+        if not expected_by_module:
+            errors.append(f"{path.name}: missing expected_by_module")
+        else:
+            for mod in modules:
+                block = expected_by_module.get(mod)
+                if not block:
+                    errors.append(f"{path.name}: expected_by_module missing key {mod!r}")
+    else:
+        expected = data.get("expected")
+        if expected is None:
+            errors.append(f"{path.name}: missing expected block")
+        elif expected == {}:
+            errors.append(f"{path.name}: empty expected block")
+
+    analysis_id = str(data.get("analysis_id", "")).strip()
+    if not analysis_id:
+        errors.append(f"{path.name}: missing analysis_id")
+    else:
+        target = expected_analysis_id(stem)
+        if _normalize(analysis_id) != _normalize(target):
+            errors.append(
+                f"{path.name}: analysis_id {analysis_id!r} != expected {target!r}"
+            )
+
+    return errors
+
+
+def main() -> int:
+    errors: list[str] = []
+    for module, root in MODULE_DIRS.items():
+        if not root.is_dir():
+            continue
+        for path in sorted(root.glob("*.yaml")):
+            errors.extend(validate_file(path, module=module))
+
+    if STRESS_DIR.is_dir():
+        for path in sorted(STRESS_DIR.rglob("*.yaml")):
+            errors.extend(validate_file(path, module="employment"))
+
+    if errors:
+        print("Feature YAML validation failed:")
+        for err in errors:
+            print(f"  - {err}")
+        return 1
+
+    print("Feature YAML validation passed.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
