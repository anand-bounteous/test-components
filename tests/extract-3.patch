+"""Parse fixture/API dicts into ``BankTransactionRequest`` for tests and tooling."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import RawBankTransaction
+from nw_agcore_bank_transactions.pipeline._models.requests import (
+    BankTransactionRequest,
+    TransactionsRange,
+)
+
+from tests.feature.support.HintIo import hint_inputs_from_dict
+
+
+def input_transaction_from_mapping(row: Mapping[str, Any]) -> RawBankTransaction:
+    return RawBankTransaction(
+        id=str(row.get("id", "")),
+        date=str(row.get("date", "")),
+        description=str(row.get("description", "")),
+        debit_amount=row.get("debit_amount", 0),
+        credit_amount=row.get("credit_amount", 0),
+        balance=row.get("balance"),
+        reference=row.get("reference"),
+        page=row.get("page"),
+        line=row.get("line"),
+        is_brought_forward=bool(row.get("is_brought_forward", False)),
+        is_final_balance=bool(row.get("is_final_balance", False)),
+    )
+
+
+def parse_payload(data: Mapping[str, Any]) -> BankTransactionRequest:
+    """Build a production payload from a fixture mapping (ignores test-only keys)."""
+    if "transactions" not in data or data.get("transactions") is None:
+        txns: tuple[RawBankTransaction, ...] = ()
+    else:
+        raw_txns = data["transactions"]
+        if not isinstance(raw_txns, Sequence):
+            raise TypeError("transactions must be a sequence")
+        txns = tuple(input_transaction_from_mapping(row) for row in raw_txns)
+
+    tr = data.get("transactions_range")
+    transactions_range = None
+    if tr is not None:
+        transactions_range = TransactionsRange(
+            start=tr.get("start") or tr.get("from"),
+            end=tr.get("end") or tr.get("to"),
+        )
+
+    country_region = str(data["country_region"]) if "country_region" in data else None
+
+    return BankTransactionRequest(
+        analysis_id=str(data.get("analysis_id", "salary_analysis")),
+        transactions=txns,
+        jurisdiction=str(data.get("jurisdiction", "GB")),
+        country_region=country_region,
+        source_bank=data.get("source_bank"),
+        validation_mode=str(data.get("validation_mode", "lenient")),
+        hint_inputs=hint_inputs_from_dict(data),
+        transactions_range=transactions_range,
+    )
+
+
+__all__ = ["input_transaction_from_mapping", "parse_payload"]
