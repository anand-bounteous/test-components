+"""Property sale hint-amount scoring profile."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    CandidateSet,
+    CandidateTransaction,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import employer_hint_bonus
+from nw_agcore_bank_transactions.pipeline.hints.matchers import PropertySaleHintMatcher
+from nw_agcore_bank_transactions.pipeline.hints.matchers.AmountRangeMatcher import (
+    amount_in_range,
+    coverage_pct,
+)
+from nw_agcore_bank_transactions.pipeline.hints.matchers.KeywordsMatcher import sale_keyword_score
+from nw_agcore_bank_transactions.pipeline.hints.models import (
+    AppliedHints,
+    EmployerHints,
+    PropertySaleHints,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+from nw_agcore_bank_transactions.pipeline.scoring.ScoringService import confidence_band
+
+
+def _classify_sale_type(
+    confidence: float,
+    *,
+    aggregate_coverage: float,
+    thresholds: Mapping[str, Any],
+) -> str:
+    probable = float(thresholds.get("probable_property_sale", 0.55))
+    possible = float(thresholds.get("possible_property_sale", 0.40))
+    if confidence >= probable and aggregate_coverage >= 0.90:
+        return "probable_property_sale"
+    if confidence >= possible:
+        return "possible_property_sale"
+    return "large_credit_not_property_sale"
+
+
+def score_property_sale_groups(
+    groups: Sequence[HintGroupCandidate],
+    *,
+    hint_inputs: PropertySaleHints,
+    applied_hints: AppliedHints,
+    features_by_id: Mapping[str, TransactionFeatures],
+    weights: Mapping[str, float],
+    thresholds: Mapping[str, Any],
+    sale_hint_cfg: Mapping[str, Any],
+    positive_keywords: Sequence[str],
+    negative_keywords: Sequence[str],
+    hint_matcher: PropertySaleHintMatcher,
+) -> list[CandidateSet]:
+    if hint_inputs.amount is None:
+        return []
+
+    sale_applied = applied_hints.property_sale
+    tolerance = hint_matcher.effective_tolerance(hint_inputs)
+    hint_amount = hint_inputs.amount
+    hint_cfg = load_hint_config()
+
+    scored: list[CandidateSet] = []
+    for group in groups:
+        cluster = list(group.transactions)
+        if not cluster:
+            continue
+
+        total = group.aggregate_sum
+        amount_cov = coverage_pct(total, hint_amount)
+        in_range_count = sum(
+            1 for t in cluster if amount_in_range(t.amount, hint_amount, tolerance)
+        )
+        per_txn_fit = in_range_count / len(cluster)
+
+        keyword_score = max(
+            sale_keyword_score(t.normalised_description, positive_keywords, negative_keywords)
+            for t in cluster
+        )
+
+        buyer_bonus = 0.0
+        if hint_inputs.buyer_name:
+            tokens = frozenset(tok for t in cluster for tok in t.description_tokens)
+            buyer_bonus = employer_hint_bonus(
+                tokens,
+                EmployerHints(current_employer=hint_inputs.buyer_name),
+                hint_cfg,
+            )
+
+        property_match_level = (
+            sale_applied.property_match_level if sale_applied is not None else "none"
+        )
+        property_bonus = 0.10 if property_match_level != "none" else 0.0
+
+        channel_scores = []
+        for t in cluster:
+            feat = features_by_id.get(t.id)
+            if feat is not None:
+                channel_scores.append(float(feat.payment_channel_confidence))
+        channel_score = sum(channel_scores) / len(channel_scores) if channel_scores else 0.5
+
+        if len(cluster) == 1:
+            timeline_fit = 1.0
+        else:
+            dates = sorted(t.date for t in cluster)
+            span_days = (dates[-1] - dates[0]).days
+            half_span_days = max(1, (group.window_end - group.window_start).days // 2 or 1)
+            timeline_fit = max(0.0, 1.0 - span_days / (2 * half_span_days))
+
+        weighted = (
+            weights.get("amount_coverage_score", 0.50) * amount_cov
+            + weights.get("per_txn_amount_fit_score", 0.10) * per_txn_fit
+            + weights.get("description_keyword_score", 0.15) * keyword_score
+            + weights.get("buyer_hint_bonus", 0.10) * buyer_bonus
+            + weights.get("property_hint_bonus", 0.10) * property_bonus
+            + weights.get("payment_channel_score", 0.05) * channel_score
+            + weights.get("timeline_fit_score", 0.10) * timeline_fit
+        )
+        final_score = round(min(1.0, max(0.0, weighted)), 6)
+
+        if sale_applied is not None:
+            if sale_applied.buyer_match_level == "exact" and final_score >= float(
+                sale_hint_cfg.get("buyer_match_min_base_score", 0.45)
+            ):
+                final_score = max(
+                    final_score,
+                    float(sale_hint_cfg.get("buyer_exact_match_floor", 0.92)),
+                )
+            elif sale_applied.buyer_match_level == "partial" and final_score >= float(
+                sale_hint_cfg.get("buyer_match_min_base_score", 0.45)
+            ):
+                final_score = max(
+                    final_score,
+                    float(sale_hint_cfg.get("buyer_partial_match_floor", 0.85)),
+                )
+
+        candidate_type = _classify_sale_type(
+            final_score,
+            aggregate_coverage=amount_cov,
+            thresholds=thresholds,
+        )
+        band = confidence_band(final_score)
+
+        buyer_match_level = sale_applied.buyer_match_level if sale_applied is not None else "none"
+        score_breakdown = {
+            "amount_coverage_score": round(amount_cov, 6),
+            "per_txn_amount_fit_score": round(per_txn_fit, 6),
+            "description_keyword_score": keyword_score,
+            "buyer_hint_bonus": buyer_bonus,
+            "property_hint_bonus": property_bonus,
+            "payment_channel_score": round(channel_score, 6),
+            "timeline_fit_score": round(timeline_fit, 6),
+            "final_score": final_score,
+        }
+        detected_pattern = {
+            "reference_date": group.reference_date.isoformat() if group.reference_date else None,
+            "timeline_window_start": group.window_start.isoformat(),
+            "timeline_window_end": group.window_end.isoformat(),
+            "aggregate_amount": float(total),
+            "hint_amount": float(hint_amount),
+            "partial_payment_count": len(cluster),
+        }
+        scored.append(
+            CandidateSet(
+                candidate_set_id=group.candidate_set_id,
+                candidate_type=candidate_type,
+                transactions=tuple(
+                    CandidateTransaction(
+                        date=t.date.isoformat(),
+                        description=t.normalised_description,
+                        amount=float(t.amount),
+                        transaction_id=t.id,
+                        confidence=final_score,
+                        confidence_band=band,
+                    )
+                    for t in cluster
+                ),
+                score_breakdown=score_breakdown,
+                detected_pattern=detected_pattern,
+                reasoning=group.reasoning,
+                confidence=final_score,
+                confidence_band=band,
+                metadata={
+                    "buyer_match_level": buyer_match_level,
+                    "property_match_level": property_match_level,
+                },
+            )
+        )
+    return scored
