+"""Shared logging helpers for feature tests."""
+
+from __future__ import annotations
+
+import json
+import logging
+from dataclasses import asdict
+from typing import Any
+
+TRACE = 5
+
+
+def get_feature_logger(name: str) -> logging.Logger:
+    return logging.getLogger(name)
+
+
+def format_candidate_block(cand, label: str, parametrize_id: str) -> list[str]:
+    type_flag = (
+        " \033[92m*** FINAL_PAY_CANDIDATE ***\033[0m"
+        if cand.candidate_type == "final_pay_candidate"
+        else ""
+    )
+    block = [
+        f"--- {label}  {parametrize_id}  "
+        f"{cand.candidate_type}  conf={cand.confidence:.3f} ({cand.confidence_band})  "
+        f"{len(cand.transactions)} transactions ---{type_flag}"
+    ]
+    for t in cand.transactions:
+        conf_tag = f"[{t.confidence_band}]" if getattr(t, "confidence_band", None) else ""
+        reasoning = getattr(t, "reasoning", None) or []
+        reason_tag = f"  # {reasoning[0]}" if reasoning else ""
+        block.append(
+            f"  {t.date}  {t.description:<28} {t.amount:>10.2f}  "
+            f"[{t.transaction_id}] {conf_tag}{reason_tag}"
+        )
+    gap_periods = getattr(cand, "gap_period_candidates", None) or []
+    if gap_periods:
+        block.append("  --- GAP PERIOD CANDIDATES ---")
+        for gap in gap_periods:
+            block.append(f"  Period {gap.period}  ({len(gap.plausible_transactions)} plausible)")
+            for pt in gap.plausible_transactions:
+                reason_tag = f"  # {pt.reasoning[0]}" if pt.reasoning else ""
+                block.append(
+                    f"    {pt.date}  {pt.description:<28} {pt.amount:>10.2f}  "
+                    f"[{pt.transaction_id}] [{pt.confidence_band}]{reason_tag}"
+                )
+    return block
+
+
+def log_candidate_dump(logger: logging.Logger, parametrize_id: str, result) -> None:
+    """INFO dump of candidate sets (and near-misses). Call on pass and fail."""
+    if result.candidate_sets:
+        total = len(result.candidate_sets)
+        all_lines: list[str] = []
+        for idx, cand in enumerate(result.candidate_sets, 1):
+            all_lines += format_candidate_block(
+                cand, f"CANDIDATE SET {idx}/{total}", parametrize_id
+            )
+        near_misses = getattr(result, "rejected_or_near_miss_sets", []) or []
+        if near_misses:
+            all_lines.append(f"--- NEAR MISSES ({len(near_misses)}) ---")
+            for nm in near_misses:
+                reason = nm.metadata.get("near_miss_reason", "below_threshold")
+                all_lines.append(
+                    f"  {nm.candidate_set_id}  {nm.candidate_type}  "
+                    f"conf={nm.confidence:.3f}  reason={reason}"
+                )
+        logger.info("\n".join(all_lines))
+    else:
+        logger.info(
+            "--- FINAL MATCHED TRANSACTIONS  %s  (no candidate found) ---",
+            parametrize_id,
+        )
+
+
+def log_test_summary(logger: logging.Logger, scenario_id: str, result) -> None:
+    """Log a structured INFO summary: scenario id, candidates, warnings."""
+    candidates = result.candidate_sets
+    near_misses = result.rejected_or_near_miss_sets
+    warning_codes = [w.code for w in result.warnings]
+
+    top = candidates[0] if candidates else None
+    top_summary = (
+        f"{top.candidate_type}  conf={top.confidence:.3f}  band={top.confidence_band}"
+        f"  txns={len(top.transactions)}"
+        if top
+        else "none"
+    )
+    all_summary = (
+        " | ".join(
+            f"{c.candidate_type}(conf={c.confidence:.3f} band={c.confidence_band} txns={len(c.transactions)})"
+            for c in candidates
+        )
+        or "none"
+    )
+
+    logger.info(
+        "\n"
+        "  ┌─ DetectionResult ───────────────────────────────────────────────\n"
+        "  │  analysis_id   : %s\n"
+        "  │  jurisdiction  : %s / %s\n"
+        "  │  input         : %d rows  →  %d credits  [%s … %s]\n"
+        "  │  candidates    : %d  [%s]\n"
+        "  │  top candidate : %s\n"
+        "  │  near_misses   : %d\n"
+        "  │  warnings      : %s\n"
+        "  └─────────────────────────────────────────────────────────────",
+        result.analysis_id,
+        getattr(result, "jurisdiction", "GB"),
+        getattr(result, "country_region", "EnglandAndWales"),
+        result.input_summary.transaction_count,
+        result.input_summary.credit_count,
+        result.input_summary.date_range_start or "—",
+        result.input_summary.date_range_end or "—",
+        len(candidates),
+        all_summary,
+        top_summary,
+        len(near_misses),
+        warning_codes or [],
+    )
+
+
+def _payload_analysis_id(payload: dict | Any) -> str:
+    if isinstance(payload, dict):
+        return str(payload.get("analysis_id", "<unknown>"))
+    analysis_id = getattr(payload, "analysis_id", None)
+    return str(analysis_id) if analysis_id else "<unknown>"
+
+
+def log_test_detail(
+    logger: logging.Logger,
+    payload: dict | Any,
+    expected: dict,
+    result,
+) -> None:
+    """Log at DEBUG and TRACE."""
+    if not logger.isEnabledFor(logging.DEBUG):
+        return
+
+    scenario_id = _payload_analysis_id(payload)
+
+    candidates = result.candidate_sets
+    if candidates:
+        logger.debug("--- CANDIDATE SETS  scenario=%s  count=%d ---", scenario_id, len(candidates))
+        for i, c in enumerate(candidates):
+            logger.debug(
+                "  [%d] id=%s\n"
+                "       type            : %s\n"
+                "       confidence      : %.4f  band=%s\n"
+                "       transactions    : %s\n"
+                "       reasoning       : %s\n"
+                "       risks           : %s\n"
+                "       score_breakdown : %s\n"
+                "       detected_pattern: %s\n"
+                "       metadata        : %s",
+                i,
+                c.candidate_set_id,
+                c.candidate_type,
+                c.confidence,
+                c.confidence_band,
+                [
+                    {
+                        "id": t.transaction_id,
+                        "date": t.date,
+                        "amount": t.amount,
+                        "desc": t.description,
+                    }
+                    for t in c.transactions
+                ],
+                list(c.reasoning),
+                list(c.risks),
+                _score_summary(c.score_breakdown),
+                _pattern_summary(c.detected_pattern),
+                c.metadata,
+            )
+    else:
+        logger.debug("--- CANDIDATE SETS  scenario=%s  count=0 ---", scenario_id)
+
+    warnings = result.warnings
+    if warnings:
+        logger.debug("--- WARNINGS  scenario=%s  count=%d ---", scenario_id, len(warnings))
+        for w in warnings:
+            logger.debug(
+                "  code=%-40s  txn_id=%-20s  detail=%s",
+                w.code,
+                w.transaction_id or "—",
+                w.detail or "—",
+            )
+    else:
+        logger.debug("--- WARNINGS  scenario=%s  count=0 ---", scenario_id)
+
+    for c in result.rejected_or_near_miss_sets:
+        logger.debug(
+            "--- NEAR MISS  id=%s  type=%s  conf=%.3f  reason=%s ---",
+            c.candidate_set_id,
+            c.candidate_type,
+            c.confidence,
+            c.metadata.get("near_miss_reason"),
+        )
+
+    if result.audit is not None:
+        audit = result.audit
+        timings = {k: f"{v:.1f}ms" for k, v in audit.timings_ms.items()}
+        logger.debug("--- AUDIT  steps=%d  timings=%s ---", len(audit.pipeline_steps), timings)
+        for step in audit.pipeline_steps:
+            logger.debug(
+                "  step=%s  duration=%.1fms  in=%s  out=%s",
+                step.name,
+                step.duration_ms,
+                step.input_summary,
+                step.output_summary,
+            )
+
+    if logger.isEnabledFor(TRACE):
+        logger.log(
+            TRACE,
+            "--- DetectionResult (complete)  scenario=%s ---\n%s",
+            scenario_id,
+            _result_to_json(result),
+        )
+
+
+def _score_summary(sb) -> dict[str, Any]:
+    if isinstance(sb, dict):
+        return {k: round(v, 4) if isinstance(v, float) else v for k, v in sb.items()}
+    try:
+        return {k: round(v, 4) if isinstance(v, float) else v for k, v in asdict(sb).items()}
+    except Exception:
+        return {}
+
+
+def _pattern_summary(dp) -> dict[str, Any]:
+    if isinstance(dp, dict):
+        return {k: v for k, v in dp.items() if v and v != "unknown"}
+    try:
+        return {k: v for k, v in asdict(dp).items() if v and v != "unknown"}
+    except Exception:
+        return {}
+
+
+def _result_to_json(result) -> str:
+    try:
+        return json.dumps(asdict(result), indent=2, default=str)
+    except Exception as exc:
+        return f"<serialisation error: {exc}>"
