+"""Rent hint application audit."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import overlap_match_level
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+
+from ..matchers.PartyPropertyMatcher import max_match_level, property_match_level
+from ..matchers.RentMatcher import RentHintMatcher, _tokenise_hint_text, amount_matches
+from ..models import AppliedRentHints, RentHints
+
+
+def apply_rent_hints(
+    transactions: Sequence[BankTransaction],
+    hint_inputs: RentHints,
+    matcher: RentHintMatcher,
+) -> AppliedRentHints:
+    tolerance = matcher.effective_tolerance_pct(hint_inputs)
+    amount_matched = False
+    if hint_inputs.amount is not None:
+        amount_matched = any(
+            amount_matches(t.amount, hint_inputs.amount, tolerance) for t in transactions
+        )
+
+    rentee_level = "none"
+    if hint_inputs.rentee_name:
+        for txn in transactions:
+            rentee_level = max_match_level(
+                rentee_level,
+                overlap_match_level(
+                    frozenset(txn.description_tokens),
+                    hint_inputs.rentee_name,
+                    load_hint_config(),
+                ),
+            )
+
+    property_level = "none"
+    postcode_matched = False
+    for txn in transactions:
+        tokens = frozenset(txn.description_tokens)
+        property_level = max_match_level(
+            property_level,
+            property_match_level(
+                tokens,
+                hint_inputs.property_ref,
+                hint_inputs.location,
+            ),
+        )
+        if hint_inputs.postcode:
+            postcode_tokens = _tokenise_hint_text(hint_inputs.postcode)
+            if postcode_tokens & tokens:
+                postcode_matched = True
+
+    property_matches: list[dict[str, str]] = []
+    for prop in hint_inputs.properties:
+        property_matches.append(matcher.match_property(transactions, prop))
+
+    unmatched: list[str] = []
+    if hint_inputs.amount is not None and not amount_matched:
+        unmatched.append("amount")
+    if hint_inputs.rentee_name and rentee_level == "none":
+        unmatched.append("rentee_name")
+    if (hint_inputs.property_ref or hint_inputs.location) and property_level == "none":
+        unmatched.append("property_ref")
+    if hint_inputs.postcode and not postcode_matched:
+        unmatched.append("postcode")
+
+    return AppliedRentHints(
+        amount_matched=amount_matched,
+        rentee_match_level=rentee_level,
+        property_match_level=property_level,
+        postcode_matched=postcode_matched,
+        unmatched_hint_fields=tuple(unmatched),
+        property_matches=tuple(property_matches),
+    )
