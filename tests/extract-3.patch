+"""nw-agcore-document-data-extractor — PDF text, font, and table extraction pipeline."""
+
+from __future__ import annotations
+
+from nw_agcore_document_data_extractor.pipeline._models.requests.DocumentExtractionRequest import DocumentExtractionRequest
+from nw_agcore_document_data_extractor.pipeline._models.results.DocumentExtractionResult import DocumentExtractionResult
+
+_LAZY_EXPORTS: dict[str, tuple[str, str]] = {
+    "run_extract_document": (
+        "nw_agcore_document_data_extractor.pipeline",
+        "run_extract_document",
+    ),
+    "extract_document_data": (
+        "nw_agcore_document_data_extractor.channels.tools.DocumentDataExtractionTools",
+        "extract_document_data",
+    ),
+}
+
+__all__ = [
+    "DocumentExtractionRequest",
+    "DocumentExtractionResult",
+    "extract_document_data",
+    "run_extract_document",
+]
+
+
+def __getattr__(name: str):
+    if name not in _LAZY_EXPORTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    module_path, attr = _LAZY_EXPORTS[name]
+    import importlib
+
+    module = importlib.import_module(module_path)
+    value = getattr(module, attr)
+    globals()[name] = value
+    return value
