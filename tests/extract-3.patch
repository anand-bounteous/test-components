+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import RasterPage
+from nw_agcore_document_data_extractor.pipeline.rasterization.RasterizationService import RasterizationService
+
+
+def run_rasterize_pdf(pdf_path: str, out_dir: str, *, dpi: int = 300) -> list[RasterPage]:
+    return RasterizationService().rasterize(pdf_path, out_dir, dpi=dpi)
