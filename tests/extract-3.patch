+"""Employer-name hint matching helpers."""
+
+from __future__ import annotations
+
+from ..normalization import default_service
+from .models.EmployerHints import EmployerHints
+from .models.HintConfig import HintConfig
+
+
+def tokenise_employer_name(name: str, config: HintConfig) -> frozenset[str]:
+    normalised = default_service().normalise_text(name)
+    return frozenset(
+        t
+        for t in normalised.split()
+        if t not in config.employer_hint_stop_tokens and len(t) >= config.min_employer_token_length
+    )
+
+
+def partial_token_match(hint_tok: str, cand_tok: str, config: HintConfig) -> bool:
+    if not hint_tok or not cand_tok:
+        return False
+    if cand_tok.startswith(hint_tok) or hint_tok.startswith(cand_tok):
+        return True
+    shorter = hint_tok if len(hint_tok) <= len(cand_tok) else cand_tok
+    longer = cand_tok if shorter is hint_tok else hint_tok
+    return len(shorter) >= config.min_partial_match_chars and shorter in longer
+
+
+def overlap_bonus(
+    candidate_tokens: frozenset[str],
+    hint_name: str | None,
+    max_bonus: float,
+    config: HintConfig,
+) -> float:
+    if not hint_name:
+        return 0.0
+    hint_tokens = tokenise_employer_name(hint_name, config)
+    if not hint_tokens:
+        return 0.0
+
+    exact_hits = len(hint_tokens & candidate_tokens)
+    unmatched_hints = hint_tokens - candidate_tokens
+    partial_hits = sum(
+        1
+        for ht in unmatched_hints
+        if any(partial_token_match(ht, ct, config) for ct in candidate_tokens)
+    )
+
+    effective_overlap = exact_hits + partial_hits * config.employer_bonus.partial_hit_weight
+    overlap_ratio = effective_overlap / len(hint_tokens)
+    return round(min(max_bonus, overlap_ratio * max_bonus), 6)
+
+
+def overlap_match_level(
+    candidate_tokens: frozenset[str],
+    hint_name: str | None,
+    config: HintConfig,
+) -> str:
+    if not hint_name:
+        return "none"
+    hint_tokens = tokenise_employer_name(hint_name, config)
+    if not hint_tokens:
+        return "none"
+
+    exact_hits = len(hint_tokens & candidate_tokens)
+    if exact_hits == len(hint_tokens):
+        return "exact"
+
+    unmatched = hint_tokens - candidate_tokens
+    partial_hits = sum(
+        1 for ht in unmatched if any(partial_token_match(ht, ct, config) for ct in candidate_tokens)
+    )
+    if exact_hits + partial_hits > 0:
+        return "partial"
+    return "none"
+
+
+def employer_match_level(
+    candidate_employer_tokens: frozenset[str],
+    employer_hints: EmployerHints | None,
+    config: HintConfig,
+) -> str:
+    if employer_hints is None:
+        return "none"
+    current_level = overlap_match_level(
+        candidate_employer_tokens,
+        employer_hints.current_employer,
+        config,
+    )
+    if current_level == "exact":
+        return "exact"
+    prev_level = overlap_match_level(
+        candidate_employer_tokens,
+        employer_hints.previous_employer,
+        config,
+    )
+    if prev_level == "exact":
+        return "exact"
+    if current_level == "partial" or prev_level == "partial":
+        return "partial"
+    return "none"
+
+
+def employer_hint_bonus(
+    candidate_employer_tokens: frozenset[str],
+    employer_hints: EmployerHints | None,
+    config: HintConfig,
+    *,
+    max_current_bonus: float | None = None,
+    max_previous_bonus: float | None = None,
+) -> float:
+    if employer_hints is None:
+        return 0.0
+    bonus = config.employer_bonus
+    current_b = overlap_bonus(
+        candidate_employer_tokens,
+        employer_hints.current_employer,
+        max_current_bonus if max_current_bonus is not None else bonus.max_current_bonus,
+        config,
+    )
+    prev_b = overlap_bonus(
+        candidate_employer_tokens,
+        employer_hints.previous_employer,
+        max_previous_bonus if max_previous_bonus is not None else bonus.max_previous_bonus,
+        config,
+    )
+    return max(current_b, prev_b)
