+"""Phase 4 — approx-salary band modifier (FR-017)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import SalaryHints
+from nw_agcore_bank_transactions.pipeline.hints import (
+    band_modifier,
+    compute_salary_band,
+)
+
+
+def test_no_hints_returns_none_band():
+    assert compute_salary_band(None) is None
+
+
+def test_empty_hints_returns_none_band():
+    assert compute_salary_band(SalaryHints()) is None
+
+
+def test_band_uses_monthly_when_provided():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    assert band.effective_monthly == Decimal("2500")
+    assert band.lower == Decimal("2000.0")
+    assert band.upper == Decimal("3000.0")
+
+
+def test_band_derived_from_yearly_when_only_yearly_provided():
+    band = compute_salary_band(SalaryHints(approx_yearly=Decimal("30000"), tolerance_pct=0.20))
+    assert band.effective_monthly == Decimal("2500")
+    assert band.lower == Decimal("2000.0")
+    assert band.upper == Decimal("3000.0")
+
+
+def test_band_uses_monthly_over_yearly_when_both_provided():
+    band = compute_salary_band(
+        SalaryHints(
+            approx_monthly=Decimal("3000"), approx_yearly=Decimal("60000"), tolerance_pct=0.10
+        )
+    )
+    assert band.effective_monthly == Decimal("3000")
+
+
+def test_modifier_none_band_is_one():
+    assert band_modifier(Decimal("2500"), None) == 1.0
+
+
+def test_modifier_inside_band_is_one():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    assert band_modifier(Decimal("2450"), band) == 1.0
+    assert band_modifier(Decimal("2500"), band) == 1.0
+    assert band_modifier(Decimal("2900"), band) == 1.0
+
+
+def test_modifier_at_band_edge_is_one():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    assert band_modifier(band.lower, band) == 1.0
+    assert band_modifier(band.upper, band) == 1.0
+
+
+def test_modifier_decays_linearly_outside_band():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    # 1500 is £500 below the £2000 lower edge → 500 / 2500 = 0.2 → mod = 0.9
+    assert band_modifier(Decimal("1500"), band) == pytest.approx(0.9)
+    # 500 is £1500 below → 1500 / 2500 = 0.6 → mod = 0.7
+    assert band_modifier(Decimal("500"), band) == pytest.approx(0.7)
+
+
+def test_modifier_clamped_at_half():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    # 0 is £2000 below lower edge → 2000 / 2500 = 0.8 → 1 - 0.4 = 0.6 (still above floor)
+    assert band_modifier(Decimal("0"), band) == pytest.approx(0.6)
+    # Beyond one effective_monthly below → floor at 0.5.
+    assert band_modifier(Decimal("-5000"), band) == 0.5
+
+
+def test_modifier_symmetric_above_band():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    # 3500 is £500 above upper edge → mod = 0.9
+    assert band_modifier(Decimal("3500"), band) == pytest.approx(0.9)
+
+
+def test_modifier_never_below_floor_for_huge_overshoot():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20))
+    assert band_modifier(Decimal("100000"), band) == 0.5
+
+
+def test_band_with_zero_tolerance_collapses_to_a_single_point():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.0))
+    assert band.lower == band.upper == Decimal("2500.0")
+    assert band_modifier(Decimal("2500"), band) == 1.0
+    # Anything else falls outside immediately.
+    assert band_modifier(Decimal("2499"), band) < 1.0
+
+
+def test_band_with_tolerance_one_means_full_range_zero_floor():
+    band = compute_salary_band(SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=1.0))
+    assert band.lower == Decimal("0.0")
+    assert band.upper == Decimal("5000.0")
+    # Inside this huge band everything is 1.0.
+    assert band_modifier(Decimal("2500"), band) == 1.0
