+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import RasterPage
+from nw_agcore_document_data_extractor.pipeline._models.Region import BBox, Region, RegionType
+from nw_agcore_document_data_extractor.pipeline._models.TableModel import TableCell, TableModel
+
+_WORKER = Path(__file__).with_name("Img2TableWorker.py")
+
+
+@dataclass
+class Img2TableOutput:
+    tables_by_page: dict[int, list[TableModel]]
+    regions_by_page: dict[int, list[Region]]
+    raw_result: dict
+    request_payload: dict
+
+
+class TableExtractionService:
+    def extract(
+        self,
+        pages: list[RasterPage],
+        *,
+        ocr_backend: str = "doctr",
+    ) -> Img2TableOutput:
+        payload = {
+            "pages": [
+                {
+                    "page_index": p.page_index,
+                    "image_path": p.png_path,
+                    "width": p.width,
+                    "height": p.height,
+                    "dpi": p.dpi,
+                }
+                for p in pages
+            ],
+            "params": {
+                "ocr_backend": ocr_backend,
+                "implicit_rows": True,
+                "borderless_tables": True,
+                "min_confidence": 50,
+            },
+        }
+        proc = subprocess.run(
+            [sys.executable, str(_WORKER)],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        if proc.returncode != 0:
+            raise RuntimeError(
+                f"Img2TableWorker failed (exit {proc.returncode}):\n{proc.stderr.strip()}"
+            )
+        result = json.loads(proc.stdout)
+        tables_by_page: dict[int, list[TableModel]] = {}
+        regions_by_page: dict[int, list[Region]] = {}
+        for page_data in result["pages"]:
+            idx = page_data["page_index"]
+            tables: list[TableModel] = []
+            regions: list[Region] = []
+            for r in page_data.get("regions", []):
+                regions.append(Region(
+                    id=r.get("id") or uuid.uuid4().hex[:10],
+                    type=RegionType(r["type"]),
+                    bbox=BBox(**r["bbox"]),
+                    text=r.get("text", ""),
+                    confidence=r.get("confidence", 1.0),
+                    source_tool=r.get("source_tool", "img2table"),
+                    attributes=r.get("attributes", {}),
+                ))
+            for t in page_data.get("tables", []):
+                cells: list[TableCell] = []
+                for c in t["cells"]:
+                    cell_bbox = BBox(**c["bbox"]) if c.get("bbox") else None
+                    cells.append(TableCell(
+                        row=c["row"],
+                        col=c["col"],
+                        text=c["text"],
+                        bbox=cell_bbox,
+                        multiline=c.get("multiline", False),
+                    ))
+                tables.append(TableModel(
+                    region_id=t.get("region_id", ""),
+                    n_rows=t["n_rows"],
+                    n_cols=t["n_cols"],
+                    border_mode=t.get("border_mode", "mixed"),
+                    orientation=t.get("orientation", "horizontal"),
+                    cells=cells,
+                ))
+            tables_by_page[idx] = tables
+            regions_by_page[idx] = regions
+        return Img2TableOutput(
+            tables_by_page=tables_by_page,
+            regions_by_page=regions_by_page,
+            raw_result=result,
+            request_payload=payload,
+        )
