+<#
+.SYNOPSIS
+  Windows/PowerShell port of scripts/generate_grpc.sh.
+  Generates shared + per-business-agent gRPC stubs and rewrites their imports
+  to the monorepo namespaces. Run after any .proto change (and once before the
+  first `pnpm dev:*:rest`, since agents fail to import without these stubs).
+
+.EXAMPLE
+  pwsh -File scripts/generate_grpc.ps1
+#>
+$ErrorActionPreference = "Stop"
+
+$Root       = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+$ProtoRoot  = Join-Path $Root "libs/common/core/src/nw_core/channels/grpc/proto"
+$SharedOut  = Join-Path $Root "libs/common/core/src/nw_core/channels/grpc/generated"
+
+# Prefer the uv-managed venv python; fall back to whatever `python` is on PATH.
+$VenvPython = Join-Path $Root ".venv/Scripts/python.exe"
+if (-not (Test-Path $VenvPython)) {
+    $VenvPython = "python"
+    Write-Warning ".venv python not found; falling back to '$VenvPython' on PATH."
+}
+
+function Touch-Pkg([string]$Dir) {
+    New-Item -ItemType Directory -Force -Path $Dir | Out-Null
+    $init = Join-Path $Dir "__init__.py"
+    if (-not (Test-Path $init)) { '"""Generated gRPC package."""' | Set-Content -Encoding utf8 $init }
+}
+
+# --- import-fix helpers (Python inline, mirrors the .sh sed/regex rewrites) ---
+$FixSharedPy = @'
+import sys
+from pathlib import Path
+p = Path(sys.argv[1])
+t = p.read_text(encoding="utf-8")
+t = t.replace("from nw.bank_transactions.v1 import",
+              "from nw_core.channels.grpc.generated.nw.bank_transactions.v1 import")
+p.write_text(t, encoding="utf-8")
+'@
+
+$FixAgentPy = @'
+import re, sys
+from pathlib import Path
+p = Path(sys.argv[1]); prefix = sys.argv[2]
+t = p.read_text(encoding="utf-8")
+t = t.replace("from nw.bank_transactions.v1 import",
+              "from nw_core.channels.grpc.generated.nw.bank_transactions.v1 import")
+t = re.sub(r"from nw\.([a-z_]+)\.v1 import",
+           lambda m: f"from {prefix}.nw.{m.group(1)}.v1 import", t)
+p.write_text(t, encoding="utf-8")
+'@
+
+function Generate-Shared {
+    Touch-Pkg (Join-Path $SharedOut "nw")
+    Touch-Pkg (Join-Path $SharedOut "nw/bank_transactions")
+    Touch-Pkg (Join-Path $SharedOut "nw/bank_transactions/v1")
+
+    & $VenvPython -m grpc_tools.protoc `
+        -I $ProtoRoot `
+        --python_out=$SharedOut `
+        --grpc_python_out=$SharedOut `
+        (Join-Path $ProtoRoot "nw/bank_transactions/v1/common.proto") `
+        (Join-Path $ProtoRoot "nw/bank_transactions/v1/hints.proto") `
+        (Join-Path $ProtoRoot "nw/bank_transactions/v1/results.proto")
+
+    Get-ChildItem -Path (Join-Path $SharedOut "nw/bank_transactions/v1") -Filter "*_pb2*.py" |
+        ForEach-Object { & $VenvPython -c $FixSharedPy $_.FullName }
+}
+
+function Generate-Agent([string]$AgentDir, [string]$Pkg, [string]$ProtoRel) {
+    $agentProtoRoot = Join-Path $Root "agents/business/$AgentDir/src/$Pkg/channels/grpc/proto"
+    $outDir         = Join-Path $Root "agents/business/$AgentDir/src/$Pkg/channels/grpc/generated"
+    $modulePrefix   = "$Pkg.channels.grpc.generated"
+    $protoPath      = Join-Path $agentProtoRoot $ProtoRel
+
+    if (Test-Path $outDir) { Remove-Item -Recurse -Force $outDir }
+    Touch-Pkg (Join-Path $outDir "nw")
+
+    # touch intermediate package dirs (skip the leading "nw" segment)
+    $parent = Join-Path $outDir "nw"
+    $segments = (Split-Path $ProtoRel -Parent) -split "[\\/]"
+    foreach ($part in $segments[1..($segments.Length - 1)]) {
+        $parent = Join-Path $parent $part
+        Touch-Pkg $parent
+    }
+    Touch-Pkg (Split-Path (Join-Path $outDir $ProtoRel) -Parent)
+
+    & $VenvPython -m grpc_tools.protoc `
+        -I $ProtoRoot `
+        -I $agentProtoRoot `
+        --python_out=$outDir `
+        --grpc_python_out=$outDir `
+        $protoPath
+
+    Get-ChildItem -Path $outDir -Recurse -Filter "*_pb2*.py" |
+        ForEach-Object { & $VenvPython -c $FixAgentPy $_.FullName $modulePrefix }
+}
+
+Generate-Shared
+Generate-Agent "gift-extractor"          "nw_agbus_gift_extractor"          "nw/gift/v1/gift_extractor.proto"
+Generate-Agent "salary-extractor"        "nw_agbus_salary_extractor"        "nw/salary/v1/salary_extractor.proto"
+Generate-Agent "rent-extractor"          "nw_agbus_rent_extractor"          "nw/rent/v1/rent_extractor.proto"
+Generate-Agent "property-sale-extractor" "nw_agbus_property_sale_extractor" "nw/property_sale/v1/property_sale_extractor.proto"
+
+Write-Host "gRPC stubs generated under nw_core/channels/grpc/generated and business agent channels/grpc/generated"
