+"""Employment-transition linking — Design §15."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Sequence
+from dataclasses import replace
+from datetime import date as _date
+from datetime import timedelta
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.validation import ValidationWarning
+
+from .._models import CandidateSet, ConfidenceDetail, GapPeriodCandidate
+
+logger = logging.getLogger(__name__)
+
+_TRANSITION_MERGE_CONFIDENCE_THRESHOLD = 0.55
+
+_TRANSITION_MERGEABLE_TYPES: frozenset[str] = frozenset(
+    {
+        "probable_salary",
+        "final_pay_candidate",
+        "possible_salary",
+    }
+)
+
+
+def _confidence_band(score: float) -> str:
+    if score >= 0.85:
+        return "high"
+    if score >= 0.70:
+        return "medium_high"
+    if score >= 0.55:
+        return "medium"
+    if score >= 0.40:
+        return "low"
+    return "very_low"
+
+
+def _days(n: int) -> timedelta:
+    return timedelta(days=n)
+
+
+def same_employer(a: CandidateSet, b: CandidateSet) -> bool:
+    a_tokens = set(a.detected_pattern.get("possible_employer_tokens") or ())
+    b_tokens = set(b.detected_pattern.get("possible_employer_tokens") or ())
+    if not a_tokens or not b_tokens:
+        return False
+    return bool(a_tokens & b_tokens)
+
+
+def merge_transition_pair(
+    cand_a: CandidateSet,
+    cand_b: CandidateSet,
+    gap_days: int,
+    *,
+    cand_b_original_type: str = "probable_salary",
+) -> CandidateSet:
+    """Merge two consecutive salary streams spanning an employment transition."""
+    all_txns = tuple(
+        sorted(
+            list(cand_a.transactions) + list(cand_b.transactions),
+            key=lambda t: t.date,
+        )
+    )
+    tokens_a = set(cand_a.detected_pattern.get("possible_employer_tokens") or ())
+    tokens_b = set(cand_b.detected_pattern.get("possible_employer_tokens") or ())
+    combined_tokens = tuple(sorted(tokens_a | tokens_b))
+
+    gap_desc = f"{gap_days} day gap" if gap_days > 0 else "back-to-back (same month)"
+
+    merged_pattern = {
+        **dict(cand_a.detected_pattern),
+        "possible_employer_tokens": list(combined_tokens),
+        "coverage": f"{len(all_txns)}_credits",
+    }
+
+    last_a = max(_date.fromisoformat(t.date) for t in cand_a.transactions)
+    first_b = min(_date.fromisoformat(t.date) for t in cand_b.transactions)
+
+    if cand_b_original_type == "final_pay_candidate":
+        type_note = (
+            f"new-employer stream ({cand_b.candidate_set_id!r}) was initially "
+            "classified as final_pay_candidate — amount outlier at start suggests "
+            "joining bonus or prorated first-month pay; merged as consecutive salary"
+        )
+    elif cand_b_original_type == "possible_salary":
+        type_note = (
+            f"new-employer stream ({cand_b.candidate_set_id!r}) was initially "
+            "classified as possible_salary; merged as consecutive salary"
+        )
+    else:
+        type_note = "both streams classified as probable_salary"
+
+    merged_conf = round(min(cand_a.confidence, cand_b.confidence), 4)
+
+    merge_detail = ConfidenceDetail(
+        step="employment_transition_merge",
+        confidence_step=merged_conf,
+        confidence_step_max_value=1.0,
+        reasoning=(
+            f"Absorbed from {cand_b.candidate_set_id!r} (type={cand_b_original_type}, "
+            f"conf={cand_b.confidence:.4f}) into {cand_a.candidate_set_id!r} "
+            f"(conf={cand_a.confidence:.4f}) via employment-transition merge; "
+            f"{gap_desc}. {type_note}. "
+            f"Merged confidence = min({cand_a.confidence}, {cand_b.confidence}) = {merged_conf}."
+        ),
+    )
+    cand_b_ids = {t.transaction_id for t in cand_b.transactions}
+    stamped_txns = tuple(
+        replace(t, confidence_details=t.confidence_details + (merge_detail,))
+        if t.transaction_id in cand_b_ids
+        else t
+        for t in all_txns
+    )
+
+    return replace(
+        cand_a,
+        candidate_set_id=f"{cand_a.candidate_set_id}_transition",
+        candidate_type="probable_salary",
+        transactions=stamped_txns,
+        detected_pattern=merged_pattern,
+        reasoning=cand_a.reasoning
+        + (
+            f"Employment-transition merge: {cand_a.candidate_set_id!r} "
+            f"(ends {last_a.year}-{last_a.month:02d}) → "
+            f"{cand_b.candidate_set_id!r} "
+            f"(starts {first_b.year}-{first_b.month:02d}); {gap_desc}. "
+            f"Merge reason: {type_note}. "
+            f"Combined employer tokens: {sorted(combined_tokens)}. "
+            f"Confidence = min({cand_a.confidence}, {cand_b.confidence}) = {merged_conf}.",
+        ),
+        confidence=merged_conf,
+        confidence_band=_confidence_band(merged_conf),
+        metadata={
+            **cand_a.metadata,
+            "employment_transition": {
+                "from_candidate_set_id": cand_a.candidate_set_id,
+                "to_candidate_set_id": cand_b.candidate_set_id,
+                "gap_days": gap_days,
+                "transition_months": [
+                    f"{last_a.year}-{last_a.month:02d}",
+                    f"{first_b.year}-{first_b.month:02d}",
+                ],
+            },
+        },
+    )
+
+
+def link_employment_transitions(
+    candidates: Sequence[CandidateSet],
+    config: AppConfig,
+) -> tuple[list[CandidateSet], list[ValidationWarning]]:
+    """Tag and merge candidate pairs that look like employment transitions."""
+    del config  # reserved for future threshold overrides
+    extra_warnings: list[ValidationWarning] = []
+    if len(candidates) < 2:
+        return list(candidates), extra_warnings
+
+    indexed: list[tuple[_date, _date, CandidateSet]] = []
+    for cand in candidates:
+        dates = sorted(_date.fromisoformat(t.date) for t in cand.transactions)
+        if not dates:
+            continue
+        indexed.append((dates[0], dates[-1], cand))
+
+    emitted_transition_pairs: set[tuple[str, str]] = set()
+    merged_ids: set[str] = set()
+    merged_replacements: dict[str, CandidateSet] = {}
+
+    out: list[CandidateSet] = []
+    for cand_idx, (first_a, last_a, cand_a) in enumerate(indexed):
+        new_meta = dict(cand_a.metadata)
+        same_month_overlap = False
+
+        for other_idx, (first_b, last_b, cand_b) in enumerate(indexed):
+            if other_idx == cand_idx:
+                continue
+            if first_b < first_a:
+                continue
+            gap = (first_b - last_a).days
+            if gap < 0 or gap > 62:
+                logger.debug(
+                    "transition.evaluate  a=%s b=%s  gap=%d  → SKIP reason=gap_out_of_range(0..62)",
+                    cand_a.candidate_set_id,
+                    cand_b.candidate_set_id,
+                    gap,
+                )
+                continue
+            if same_employer(cand_a, cand_b):
+                logger.debug(
+                    "transition.evaluate  a=%s b=%s  gap=%d  → SKIP reason=same_employer",
+                    cand_a.candidate_set_id,
+                    cand_b.candidate_set_id,
+                    gap,
+                )
+                continue
+            if cand_a.candidate_type != "probable_salary":
+                logger.debug(
+                    "transition.evaluate  a=%s type=%s  → SKIP reason=cand_a_not_probable_salary",
+                    cand_a.candidate_set_id,
+                    cand_a.candidate_type,
+                )
+                continue
+
+            pair_key = (cand_a.candidate_set_id, cand_b.candidate_set_id)
+            gap_desc = f"{gap} day gap" if gap > 0 else "back-to-back (same month)"
+
+            if last_a.year == first_b.year and last_a.month == first_b.month:
+                same_month_overlap = True
+
+            logger.debug(
+                "transition.evaluate  a=%s type=%s conf=%.3f span=%s..%s  "
+                "b=%s type=%s conf=%.3f span=%s..%s  gap=%d same_month_overlap=%s",
+                cand_a.candidate_set_id,
+                cand_a.candidate_type,
+                cand_a.confidence,
+                first_a,
+                last_a,
+                cand_b.candidate_set_id,
+                cand_b.candidate_type,
+                cand_b.confidence,
+                first_b,
+                last_b,
+                gap,
+                same_month_overlap,
+            )
+
+            if cand_b.candidate_type in _TRANSITION_MERGEABLE_TYPES:
+                if pair_key not in emitted_transition_pairs:
+                    emitted_transition_pairs.add(pair_key)
+                    extra_warnings.append(
+                        ValidationWarning(
+                            code="employment_transition_detected",
+                            transaction_id="",
+                            detail=(
+                                f"Employment transition detected between "
+                                f"{cand_a.candidate_set_id!r} "
+                                f"(ends {last_a.year}-{last_a.month:02d}) and "
+                                f"{cand_b.candidate_set_id!r} "
+                                f"(starts {first_b.year}-{first_b.month:02d}); "
+                                f"{gap_desc}."
+                            ),
+                        )
+                    )
+
+                    both_confident = (
+                        cand_a.confidence >= _TRANSITION_MERGE_CONFIDENCE_THRESHOLD
+                        and cand_b.confidence >= _TRANSITION_MERGE_CONFIDENCE_THRESHOLD
+                    )
+                    if both_confident:
+                        logger.debug(
+                            "transition.evaluate  a=%s b=%s  → MERGE ELIGIBLE "
+                            "(a_conf=%.3f b_conf=%.3f both>=%.2f b_type=%s)",
+                            cand_a.candidate_set_id,
+                            cand_b.candidate_set_id,
+                            cand_a.confidence,
+                            cand_b.confidence,
+                            _TRANSITION_MERGE_CONFIDENCE_THRESHOLD,
+                            cand_b.candidate_type,
+                        )
+                        merged = merge_transition_pair(
+                            cand_a,
+                            cand_b,
+                            gap,
+                            cand_b_original_type=cand_b.candidate_type,
+                        )
+                        logger.debug(
+                            "transition.merge  merged_id=%s  conf=%.3f  txns=%d  "
+                            "b_original_type=%s",
+                            merged.candidate_set_id,
+                            merged.confidence,
+                            len(merged.transactions),
+                            cand_b.candidate_type,
+                        )
+                        merged_replacements[cand_a.candidate_set_id] = merged
+                        merged_ids.add(cand_b.candidate_set_id)
+                        break
+
+                    elif cand_b.confidence < _TRANSITION_MERGE_CONFIDENCE_THRESHOLD:
+                        logger.debug(
+                            "transition.evaluate  a=%s b=%s b_conf=%.3f  "
+                            "→ SKIP merge (b_conf below threshold %.2f); "
+                            "attaching as gap_period_candidates",
+                            cand_a.candidate_set_id,
+                            cand_b.candidate_set_id,
+                            cand_b.confidence,
+                            _TRANSITION_MERGE_CONFIDENCE_THRESHOLD,
+                        )
+                        existing_gaps = list(cand_a.gap_period_candidates)
+                        for t in cand_b.transactions:
+                            period = f"{t.date[:7]}"
+                            existing_gaps.append(
+                                GapPeriodCandidate(
+                                    period=period,
+                                    plausible_transactions=(
+                                        replace(
+                                            t,
+                                            confidence=cand_b.confidence,
+                                            confidence_band=cand_b.confidence_band,
+                                            reasoning=(
+                                                f"Low-confidence stream "
+                                                f"({cand_b.candidate_set_id!r}, "
+                                                f"conf={cand_b.confidence:.2f}) — "
+                                                f"possible continuation after job change.",
+                                            ),
+                                        ),
+                                    ),
+                                )
+                            )
+                            merged_ids.add(cand_b.candidate_set_id)
+                        new_meta.setdefault("possible_employment_transition", []).append(
+                            {
+                                "to_candidate_set_id": cand_b.candidate_set_id,
+                                "confidence": cand_b.confidence,
+                                "note": "low_confidence_stream",
+                                "gap_days": gap,
+                            }
+                        )
+                        if existing_gaps:
+                            cand_a = replace(
+                                cand_a,
+                                gap_period_candidates=tuple(existing_gaps),
+                            )
+
+            else:
+                logger.debug(
+                    "transition.evaluate  a=%s b=%s b_type=%s  "
+                    "→ SKIP merge (b_type not in _TRANSITION_MERGEABLE_TYPES); "
+                    "metadata-only annotation",
+                    cand_a.candidate_set_id,
+                    cand_b.candidate_set_id,
+                    cand_b.candidate_type,
+                )
+                new_meta.setdefault("possible_employment_transition", []).append(
+                    {
+                        "to_candidate_set_id": cand_b.candidate_set_id,
+                        "transition_months": [
+                            f"{last_a.year}-{last_a.month:02d}",
+                            f"{first_b.year}-{first_b.month:02d}",
+                        ],
+                        "gap_days": gap,
+                    }
+                )
+
+        if same_month_overlap:
+            new_meta["same_month_overlap"] = True
+
+        if cand_a.candidate_type == "final_pay_candidate":
+            for _first_b, last_b, cand_b in indexed:
+                if cand_b is cand_a or cand_b.candidate_type != "probable_salary":
+                    continue
+                if same_employer(cand_a, cand_b):
+                    if first_a <= last_b + _days(31):
+                        new_meta.setdefault("attached_to_salary_candidate", cand_b.candidate_set_id)
+                        break
+
+        if cand_a.candidate_set_id in merged_replacements:
+            out.append(merged_replacements[cand_a.candidate_set_id])
+        elif cand_a.candidate_set_id not in merged_ids:
+            out.append(replace(cand_a, metadata=new_meta))
+
+    return out, extra_warnings
+
+
+def override_split_subcandidate_types(
+    candidates: Sequence[CandidateSet],
+) -> list[CandidateSet]:
+    """Override bonus/expense sub-candidate types after generic classification."""
+    out: list[CandidateSet] = []
+    for cand in candidates:
+        suffix = cand.candidate_set_id.rsplit("_", 2)
+        if len(suffix) >= 3 and suffix[-2] == "bonus":
+            out.append(replace(cand, candidate_type="bonus_or_extra_pay_candidate"))
+            continue
+        if len(suffix) >= 3 and suffix[-2] == "expense":
+            out.append(replace(cand, candidate_type="expense_reimbursement_candidate"))
+            continue
+        out.append(cand)
+    return out
+
+
+__all__ = [
+    "link_employment_transitions",
+    "merge_transition_pair",
+    "override_split_subcandidate_types",
+    "same_employer",
+]
