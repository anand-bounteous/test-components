+from enum import StrEnum
+from pathlib import Path
+
+from pydantic import Field
+from pydantic_settings import BaseSettings, SettingsConfigDict
+
+
+class EnvName(StrEnum):
+    DEV = "dev"
+    QA = "qa"
+    UAT = "uat"
+    PROD = "prod"
+    TEST = "test"
+
+
+class BaseComponentSettings(BaseSettings):
+    """Base settings loaded from config/env.{NW_ENV}."""
+
+    model_config = SettingsConfigDict(extra="ignore")
+
+    nw_env: str = Field(default="dev", alias="NW_ENV")
+    log_level: str = Field(default="INFO", alias="LOG_LEVEL")
+    host: str = Field(default="127.0.0.1", alias="HOST")
+    port: int = Field(default=8000, alias="PORT")
+    grpc_port: int = Field(default=50051, alias="GRPC_PORT")
+
+
+class AppComponentSettings(BaseComponentSettings):
+    """HTTP client defaults for application components."""
+
+    http_timeout: int = Field(default=30, alias="HTTP_TIMEOUT")
+    retry_count: int = Field(default=3, alias="RETRY_COUNT")
+
+
+def _parse_env_file(path: Path) -> dict[str, str]:
+    values: dict[str, str] = {}
+    if not path.exists():
+        return values
+    for line in path.read_text().splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, _, val = line.partition("=")
+        values[key.strip()] = val.strip()
+    return values
+
+
+def load_settings[T: BaseComponentSettings](
+    component_root: Path,
+    settings_cls: type[T] = BaseComponentSettings,
+    env: str | None = None,
+) -> T:
+    """Load settings from config/env.{NW_ENV} with optional .env.local override."""
+    import os
+
+    nw_env = env or os.environ.get("NW_ENV", "dev")
+    merged: dict[str, str] = {}
+    env_file = component_root / "config" / f"env.{nw_env}"
+    merged.update(_parse_env_file(env_file))
+    local_file = component_root / ".env.local"
+    merged.update(_parse_env_file(local_file))
+    merged["NW_ENV"] = nw_env
+    return settings_cls(**merged)
+
+
+def component_root_from_module(module_file: str) -> Path:
+    """Resolve component root (contains config/) from a module __file__ inside src/."""
+    path = Path(module_file).resolve()
+    # Walk up until we find config/ or hit repo boundary
+    for parent in [path.parent, *path.parents]:
+        if (parent / "config").is_dir() and (parent / "pyproject.toml").exists():
+            return parent
+    raise RuntimeError(f"Cannot resolve component root from {module_file}")
