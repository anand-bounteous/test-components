+#!/usr/bin/env python3
+"""Configure business agent packages after scaffold copy."""
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1] / "agents" / "business"
+
+AGENTS = [
+    {
+        "dir": "salary-extractor",
+        "pkg": "nw_agbus_salary_extractor",
+        "dist": "nw-agbus-salary-extractor",
+        "route": "SalaryDetectRoute",
+        "service": "SalaryTransactionExtractorService",
+        "extractor": "SalaryTransactionExtractor",
+        "request": "BankTransactionRequest",
+        "result": "BankTransactionResult",
+        "port": 8020,
+    },
+    {
+        "dir": "rent-extractor",
+        "pkg": "nw_agbus_rent_extractor",
+        "dist": "nw-agbus-rent-extractor",
+        "route": "RentDetectRoute",
+        "service": "RentTransactionExtractorService",
+        "extractor": "RentTransactionExtractor",
+        "request": "BankTransactionRequest",
+        "result": "BankTransactionResult",
+        "port": 8021,
+    },
+    {
+        "dir": "gift-extractor",
+        "pkg": "nw_agbus_gift_extractor",
+        "dist": "nw-agbus-gift-extractor",
+        "route": "GiftDetectRoute",
+        "service": "GiftTransactionExtractorService",
+        "extractor": "GiftTransactionExtractor",
+        "request": "BankTransactionRequest",
+        "result": "BankTransactionResult",
+        "port": 8022,
+    },
+    {
+        "dir": "property-sale-extractor",
+        "pkg": "nw_agbus_property_sale_extractor",
+        "dist": "nw-agbus-property-sale-extractor",
+        "route": "PropertySaleDetectRoute",
+        "service": "PropertySaleTransactionExtractorService",
+        "extractor": "PropertySaleTransactionExtractor",
+        "request": "BankTransactionRequest",
+        "result": "BankTransactionResult",
+        "port": 8023,
+    },
+]
+
+
+def fix_tools_imports(src: Path, pkg: str) -> None:
+    tools_dir = src / "channels" / "tools"
+    if not tools_dir.exists():
+        return
+    for tools_file in tools_dir.glob("*Tools.py"):
+        text = tools_file.read_text(encoding="utf-8")
+        text = text.replace("from .models import", f"from {pkg}.services.models import")
+        for svc in (
+            "SalaryTransactionExtractorService",
+            "RentTransactionExtractorService",
+            "GiftTransactionExtractorService",
+            "PropertySaleTransactionExtractorService",
+        ):
+            text = text.replace(f"from .{svc} import", f"from {pkg}.services.{svc} import")
+        tools_file.write_text(text, encoding="utf-8")
+
+
+def fix_route_imports(src: Path, pkg: str) -> None:
+    tools_dir = src / "channels" / "tools"
+    if not tools_dir.exists():
+        return
+    tool_module = next(tools_dir.glob("*Tools.py")).stem
+    for rf in (src / "channels" / "rest").glob("*Route.py"):
+        text = rf.read_text(encoding="utf-8")
+        for old in (
+            "from ..SalaryTransactionExtractorTools import",
+            "from ..RentTransactionExtractorTools import",
+            "from ..GiftTransactionExtractorTools import",
+            "from ..PropertySaleTransactionExtractorTools import",
+        ):
+            if old in text:
+                fn = old.split(" import")[1]
+                text = text.replace(
+                    old,
+                    f"from {pkg}.channels.tools.{tool_module} import {fn}",
+                )
+        rf.write_text(text, encoding="utf-8")
+
+
+def write_pyproject(base: Path, cfg: dict) -> None:
+    pkg = cfg["pkg"]
+    dist = cfg["dist"]
+    (base / "pyproject.toml").write_text(
+        f"""[project]
+name = "{dist}"
+version = "0.1.0"
+requires-python = ">=3.12"
+dependencies = [
+    "nw-aglib-toolkit",
+    "nw-agcore-bank-transactions",
+    "uvicorn[standard]>=0.32.0",
+]
+
+[project.scripts]
+{dist} = "{pkg}.app.main:app_cli"
+
+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+[tool.hatch.build.targets.wheel]
+packages = ["src/{pkg}"]
+
+[tool.hatch.build.targets.wheel.force-include]
+"src/{pkg}/services" = "{pkg}/services"
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+pythonpath = ["src"]
+
+[tool.uv.sources]
+nw-aglib-toolkit = {{ workspace = true }}
+nw-agcore-bank-transactions = {{ workspace = true }}
+""",
+        encoding="utf-8",
+    )
+
+
+def write_deployment(base: Path, cfg: dict) -> None:
+    (base / "config" / "deployment.yaml").write_text(
+        f"""unit: {cfg["dist"]}
+mode: composite
+
+channels:
+  rest:
+    enabled: true
+    prefix: ""
+  tools:
+    enabled: true
+  grpc:
+    enabled: false
+  mq:
+    enabled: false
+
+embedded_core:
+  bank_transactions:
+    use: in_process
+    channels:
+      rest: suppress
+      tools: suppress
+""",
+        encoding="utf-8",
+    )
+
+
+def write_orchestrator(src: Path, cfg: dict) -> None:
+    pkg = cfg["pkg"]
+    (src / "core" / "orchestrator.py").write_text(
+        f'''"""In-process orchestrator for {cfg["dist"]}."""
+from __future__ import annotations
+
+from typing import Any
+
+from {pkg}.services.{cfg["service"]} import {cfg["service"]}
+from {pkg}.services.models import {cfg["request"]}, {cfg["result"]}
+
+
+class Orchestrator:
+    def __init__(self) -> None:
+        self._extractor = {cfg["service"]}()
+
+    def detect(self, payload: {cfg["request"]}, **kwargs: Any) -> {cfg["result"]}:
+        return self._extractor.detect(payload, **kwargs)
+''',
+        encoding="utf-8",
+    )
+
+
+def write_channels(src: Path, cfg: dict) -> None:
+    pkg = cfg["pkg"]
+    route = cfg["route"]
+    (src / "channels" / "tools" / "__init__.py").write_text(
+        '"""Tool definitions exposed via the tools channel."""\\n',
+        encoding="utf-8",
+    )
+    (src / "channels" / "tools" / "ToolRegistry.py").write_text(
+        f'''"""Tools channel registration for {cfg["dist"]}."""
+
+TOOLS_PACKAGE = "{pkg}.channels.tools"
+
+
+def register_tools_channel():
+    from nw_aglib_toolkit.channels.ChannelRegistryHelpers import register_tools_from_package
+    from nw_aglib_toolkit.channels.tools.ToolsChannelModule import ToolsChannelModule
+
+    return ToolsChannelModule(register_tools_from_package(TOOLS_PACKAGE))
+''',
+        encoding="utf-8",
+    )
+    (src / "channels" / "rest" / "RestRegistry.py").write_text(
+        f'''"""REST channel registration for {cfg["dist"]}."""
+
+from nw_core.channels.ChannelModules import RestChannelModule
+
+from .router import router
+
+
+def register_rest_channel() -> RestChannelModule:
+    return RestChannelModule(router)
+''',
+        encoding="utf-8",
+    )
+    (src / "channels" / "registry.py").write_text(
+        f"""from nw_aglib_toolkit.channels.ChannelRegistryHelpers import build_agent_channel_registry
+
+from {pkg}.channels.grpc.GrpcRegistry import grpc_servicer_registration
+from {pkg}.channels.rest.RestRegistry import router
+from {pkg}.channels.tools.ToolRegistry import TOOLS_PACKAGE
+
+
+def register_channels():
+    return build_agent_channel_registry(
+        rest_router=router,
+        tools_package=TOOLS_PACKAGE,
+        grpc_servicer=grpc_servicer_registration(),
+    )
+""",
+        encoding="utf-8",
+    )
+    (src / "channels" / "rest" / "router.py").write_text(
+        f'''"""REST router for {cfg["dist"]}."""
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from {pkg}.channels.rest.{route} import {route}
+
+
+def create_router() -> APIRouter:
+    router = APIRouter(prefix="/api/v1")
+    {route}().register(router)
+    return router
+
+
+router = create_router()
+''',
+        encoding="utf-8",
+    )
+
+
+def write_app(src: Path, cfg: dict) -> None:
+    pkg = cfg["pkg"]
+    (src / "app" / "bootstrap.py").write_text(
+        f"""from pathlib import Path
+
+from {pkg}.channels.registry import register_channels
+from nw_core.config.ComponentSettings import BaseComponentSettings, load_settings
+from nw_aglib_toolkit.channels.AgentDeployment import AgentChannelBootstrap, AgentDeploymentManifest
+
+
+def build_runtime(component_root: Path):
+    settings = load_settings(component_root, BaseComponentSettings)
+    manifest = AgentDeploymentManifest.load(component_root / "config" / "deployment.yaml")
+    registry = register_channels()
+    runtime = AgentChannelBootstrap.build(manifest, registry, title="{cfg["dist"]}")
+    return runtime, settings, manifest
+""",
+        encoding="utf-8",
+    )
+    (src / "app" / "main.py").write_text(
+        f"""import os
+from pathlib import Path
+
+import typer
+from {pkg}.app.bootstrap import build_runtime
+from nw_aglib_toolkit.channels.grpc.AgentChannelServer import run_agent_channels
+
+app_cli = typer.Typer()
+
+
+def _component_root() -> Path:
+    return Path(__file__).resolve().parents[3]
+
+
+@app_cli.command()
+def run(env: str = typer.Option("dev", "--env", help="Environment: dev|qa|uat|prod")) -> None:
+    os.environ["NW_ENV"] = env
+    root = _component_root()
+    runtime, settings, _manifest = build_runtime(root)
+
+    if runtime.app is not None and runtime.grpc_servicers:
+        typer.echo(
+            f"Starting REST on {{settings.host}}:{{settings.port}} "
+            f"and gRPC on {{settings.host}}:{{settings.grpc_port}}"
+        )
+    elif runtime.app is not None:
+        typer.echo(f"Starting REST on {{settings.host}}:{{settings.port}}")
+    elif runtime.grpc_servicers:
+        typer.echo(f"Starting gRPC on {{settings.host}}:{{settings.grpc_port}}")
+    elif runtime.tool_registry:
+        typer.echo(f"Tools: {{runtime.tool_registry.list_schemas()}}")
+        return
+    else:
+        typer.echo("No channels enabled in deployment.yaml")
+        return
+
+    run_agent_channels(runtime, settings)
+
+
+if __name__ == "__main__":
+    app_cli()
+""",
+        encoding="utf-8",
+    )
+
+
+def write_agent(src: Path, cfg: dict) -> None:
+    pkg = cfg["pkg"]
+    (src / "core" / "agent.py").write_text(
+        f'''from typing import Any
+
+from nw_aglib_toolkit.agent import BaseAgent
+from {pkg}.core.orchestrator import Orchestrator
+from {pkg}.services.models import {cfg["request"]}
+
+
+class BusinessAgent(BaseAgent):
+    name = "{cfg["dist"]}"
+
+    def __init__(self) -> None:
+        self._orchestrator = Orchestrator()
+
+    async def invoke(self, payload: dict[str, Any]) -> dict[str, Any]:
+        request = {cfg["request"]}.model_validate(payload)
+        result = self._orchestrator.detect(request)
+        return result.model_dump()
+''',
+        encoding="utf-8",
+    )
+
+
+def update_env_port(base: Path, port: int) -> None:
+    env_dev = base / "config" / "env.dev"
+    if not env_dev.exists():
+        return
+    lines = []
+    for line in env_dev.read_text(encoding="utf-8").splitlines():
+        lines.append(f"PORT={port}" if line.startswith("PORT=") else line)
+    env_dev.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def main() -> None:
+    for cfg in AGENTS:
+        base = ROOT / cfg["dir"]
+        src = base / "src" / cfg["pkg"]
+        fix_tools_imports(src, cfg["pkg"])
+        fix_route_imports(src, cfg["pkg"])
+        write_pyproject(base, cfg)
+        write_deployment(base, cfg)
+        write_orchestrator(src, cfg)
+        write_channels(src, cfg)
+        write_app(src, cfg)
+        write_agent(src, cfg)
+        update_env_port(base, cfg["port"])
+        print("configured", cfg["dir"])
+
+
+if __name__ == "__main__":
+    main()
