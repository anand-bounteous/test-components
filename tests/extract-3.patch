+"""Shared helpers for assembling agent channel registries."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any
+
+from nw_aglib_toolkit.channels.tools.ToolDiscovery import build_registry_from_package
+from nw_aglib_toolkit.channels.tools.ChannelToolRegistry import ChannelToolRegistry
+from nw_aglib_toolkit.channels.tools.ToolsChannelModule import ToolsChannelModule
+from nw_core.channels.ChannelModules import (
+    ChannelRegistry,
+    GrpcChannelModule,
+    MqChannelModule,
+    RestChannelModule,
+)
+
+
+def register_tools_from_package(
+    package_name: str,
+) -> Callable[[ChannelToolRegistry], None]:
+    """Return a register callback that discovers @tool defs from *package_name*."""
+
+    def register_tools(registry: ChannelToolRegistry) -> None:
+        pipeline_reg = build_registry_from_package(package_name)
+        registry.register_from_pipeline_registry(pipeline_reg)
+
+    return register_tools
+
+
+def build_agent_channel_registry(
+    *,
+    rest_router: Any | None = None,
+    rest_prefix: str = "",
+    tools_package: str | None = None,
+    grpc_servicer: Any | None = None,
+    mq_handler: Any | None = None,
+    mq_adapter: Any | None = None,
+) -> ChannelRegistry:
+    """Build a standard agent channel registry from optional module inputs."""
+    registry = ChannelRegistry()
+
+    if rest_router is not None:
+        registry.add(RestChannelModule(rest_router, prefix=rest_prefix))
+
+    if tools_package is not None:
+        registry.add(ToolsChannelModule(register_tools_from_package(tools_package)))
+
+    if grpc_servicer is not None:
+        registry.add(GrpcChannelModule(grpc_servicer))
+
+    if mq_handler is not None and mq_adapter is not None:
+        registry.add(MqChannelModule(mq_handler, mq_adapter))
+
+    return registry
