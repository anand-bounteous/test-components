+syntax = "proto3";
+
+package nw.property_sale.v1;
+
+import "google/protobuf/struct.proto";
+import "nw/bank_transactions/v1/common.proto";
+import "nw/bank_transactions/v1/hints.proto";
+import "nw/bank_transactions/v1/results.proto";
+
+message DetectPropertySaleCandidatesRequest {
+  google.protobuf.Struct config_overrides = 1;
+  optional string source_bank = 2;
+  optional string region = 3;
+  bool include_audit = 4;
+  string analysis_id = 5;
+  string jurisdiction = 6;
+  optional string country_region = 7;
+  string validation_mode = 8;
+  repeated nw.bank_transactions.v1.RawTransaction transactions = 9;
+  nw.bank_transactions.v1.HintInputs hint_inputs = 10;
+  optional int32 max_candidates = 11;
+  optional int32 max_near_misses = 12;
+  optional double return_threshold = 13;
+}
+
+message DetectPropertySaleCandidatesResponse {
+  bool ok = 1;
+  nw.bank_transactions.v1.BankTransactionResult result = 2;
+  nw.bank_transactions.v1.ToolErrorResponse error = 3;
+}
+
+service PropertySaleExtractor {
+  rpc DetectPropertySaleCandidates(DetectPropertySaleCandidatesRequest) returns (DetectPropertySaleCandidatesResponse);
+}
