+
+@pytest.mark.unit
+def test_register_tools_from_package_delegates_to_discovery(monkeypatch):
+    captured: dict[str, str] = {}
+
+    class FakePipelineRegistry:
+        def list(self):
+            return []
+
+    def fake_build(package_name: str):
+        captured["package"] = package_name
+        return FakePipelineRegistry()
+
+    monkeypatch.setattr(registry_helpers, "build_registry_from_package", fake_build)
+
+    registry = ChannelToolRegistry()
+    register = register_tools_from_package("example.package.tools")
+    register(registry)
+    assert captured["package"] == "example.package.tools"
+
+
