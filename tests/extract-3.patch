+"""REST route for the end-to-end rent detector tool."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from nw_agbus_rent_extractor.channels.tools.RentTransactionExtractorTools import (
+    detect_rent_candidates,
+)
+from nw_agbus_rent_extractor.services.RentRequestParsing import (
+    rent_request_from_mapping,
+)
+from nw_agbus_rent_extractor.channels.rest.ApiModels import DetectRentRequest
+from nw_agbus_rent_extractor.channels.rest.ApiResponseModels import DetectRentSuccessResponse
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_context,
+    error_response,
+    success_response,
+)
+
+
+class RentDetectRoute(BaseToolRoute):
+    tool_name = "detect_rent_candidates"
+    path = "/rent/detect"
+    tags = ("rent",)
+    summary = "Run the full rental-income detection pipeline."
+    openapi_filename = "detect_rent_candidates.openapi.yaml"
+    success_response_model = DetectRentSuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
+        def detect_rent(body: DetectRentRequest):
+            try:
+                ctx = build_context(body)
+                payload = rent_request_from_mapping(body.model_dump())
+                result = detect_rent_candidates(
+                    payload,
+                    config=ctx.config,
+                    calendar=ctx.calendar,
+                    mode=payload.validation_mode,
+                    max_candidates=body.max_candidates,
+                    max_near_misses=body.max_near_misses,
+                    return_threshold=body.return_threshold,
+                    include_audit=body.include_audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
