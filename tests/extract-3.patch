@@ -0,0 +1,235 @@
+"""Helpers for chaining pipeline REST calls in feature tests."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from fastapi.testclient import TestClient
+
+
+def assert_tool_success(response) -> dict[str, Any]:
+    assert response.status_code == 200, response.text
+    body = response.json()
+    assert body.get("ok") is True, body
+    return body["result"]
+
+
+class PipelineRestRunner:
+    """Run pipeline stages via REST and retain intermediate results."""
+
+    def __init__(self, client: TestClient, payload: dict[str, Any]) -> None:
+        self.client = client
+        self.payload = payload
+        self.validated: list[dict[str, Any]] = []
+        self.normalised: list[dict[str, Any]] = []
+        self.features_by_id: dict[str, dict[str, Any]] = {}
+        self.skeleton_candidates: list[dict[str, Any]] = []
+        self.graph_candidates: list[dict[str, Any]] = []
+        self.pool: list[dict[str, Any]] = []
+        self.scored: list[dict[str, Any]] = []
+
+    def run_validate(self) -> dict[str, Any]:
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/validation/validate",
+                json={"payload": self.payload, "mode": "lenient"},
+            )
+        )
+        assert result.get("early_exit") is False
+        self.validated = [self._wire_row(t) for t in result["transactions"]]
+        return result
+
+    def run_normalize(self) -> dict[str, Any]:
+        if not self.validated:
+            self.run_validate()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/normalization/normalize",
+                json={"transactions": self.validated},
+            )
+        )
+        self.normalised = list(result["transactions"])
+        return result
+
+    def run_features(self) -> dict[str, Any]:
+        if not self.normalised:
+            self.run_normalize()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/features/extract",
+                json={"transactions": self.normalised},
+            )
+        )
+        self.normalised = list(result["transactions"])
+        self.features_by_id = {
+            t["features"]["transaction_id"]: t["features"]
+            for t in self.normalised
+            if t.get("features")
+        }
+        return result
+
+    def run_hints(self) -> dict[str, Any]:
+        if not self.features_by_id:
+            self.run_features()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/hints/apply",
+                json={
+                    "transactions": self.normalised,
+                    "hint_inputs": {
+                        "payslip_hints": self.payload.get("payslip_hints", []),
+                        "salary_hints": self.payload.get("salary_hints"),
+                        "employer_hints": self.payload.get("employer_hints"),
+                    },
+                },
+            )
+        )
+        self.normalised = list(result["transactions"])
+        self.features_by_id = {
+            t["features"]["transaction_id"]: t["features"]
+            for t in self.normalised
+            if t.get("features")
+        }
+        return result
+
+    def run_skeleton(self) -> dict[str, Any]:
+        if not self.features_by_id:
+            self.run_hints()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/skeleton/emit",
+                json={
+                    "normalised": self.normalised,
+                    "features_by_id": self.features_by_id,
+                },
+            )
+        )
+        self.skeleton_candidates = list(result["candidates"])
+        return result
+
+    def run_graph(self) -> dict[str, Any]:
+        if not self.features_by_id:
+            self.run_hints()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/clustering/graph",
+                json={
+                    "normalised": self.normalised,
+                    "features_by_id": self.features_by_id,
+                },
+            )
+        )
+        self.graph_candidates = list(result["candidates"])
+        return result
+
+    def run_dedup(self) -> dict[str, Any]:
+        if not self.skeleton_candidates:
+            self.run_skeleton()
+        if not self.graph_candidates:
+            self.run_graph()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/clustering/dedup",
+                json={
+                    "skeleton_candidates": self.skeleton_candidates,
+                    "graph_candidates": self.graph_candidates,
+                },
+            )
+        )
+        self.pool = list(result["candidates"])
+        return result
+
+    def run_bonus_expense_split(self) -> dict[str, Any]:
+        if not self.pool:
+            self.run_dedup()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/scoring/bonus-expense-split",
+                json={"pool": self.pool, "normalised": self.normalised},
+            )
+        )
+        self.pool = list(result["candidates"])
+        return result
+
+    def run_amount_date_fallback(self) -> dict[str, Any]:
+        if not self.pool:
+            self.run_bonus_expense_split()
+        accounted = {self._candidate_txn_id(t) for c in self.pool for t in c["transactions"]}
+        unaccounted = [t for t in self.normalised if self._normalised_id(t) not in accounted]
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/scoring/amount-date-fallback",
+                json={
+                    "unaccounted": unaccounted,
+                    "features_by_id": self.features_by_id,
+                },
+            )
+        )
+        if result["candidates"]:
+            self.pool = self.pool + list(result["candidates"])
+        return result
+
+    def run_score(self) -> dict[str, Any]:
+        if not self.pool:
+            self.run_amount_date_fallback()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/scoring/score",
+                json={
+                    "pool": self.pool,
+                    "normalised": self.normalised,
+                    "features_by_id": self.features_by_id,
+                    "infer_regions": True,
+                },
+            )
+        )
+        self.scored = list(result["scored"])
+        return result
+
+    def run_employment_transition(self) -> dict[str, Any]:
+        if not self.scored:
+            self.run_score()
+        result = assert_tool_success(
+            self.client.post(
+                "/api/v1/scoring/employment-transition",
+                json={"scored": self.scored},
+            )
+        )
+        self.scored = list(result["scored"])
+        return result
+
+    def run_rank(self) -> dict[str, Any]:
+        if not self.scored:
+            self.run_employment_transition()
+        return assert_tool_success(
+            self.client.post(
+                "/api/v1/ranking/rank",
+                json={"scored": self.scored},
+            )
+        )
+
+    @staticmethod
+    def _normalised_id(txn: dict[str, Any]) -> str:
+        if txn.get("id") is not None:
+            return str(txn["id"])
+        return str((txn.get("raw") or {}).get("id", ""))
+
+    @staticmethod
+    def _candidate_txn_id(txn: dict[str, Any]) -> str:
+        return str(txn.get("transaction_id") or txn.get("id", ""))
+
+    @staticmethod
+    def _wire_row(txn: dict[str, Any]) -> dict[str, Any]:
+        return {
+            "id": txn["id"],
+            "date": txn["date"],
+            "description": txn["description"],
+            "debit_amount": txn.get("debit_amount", 0),
+            "credit_amount": txn.get("credit_amount", 0),
+            "balance": txn.get("balance"),
+            "reference": txn.get("reference"),
+            "page": txn.get("page"),
+            "line": txn.get("line"),
+            "is_brought_forward": txn.get("is_brought_forward", False),
+            "is_final_balance": txn.get("is_final_balance", False),
+        }
