+"""Phase 2 — UK working-day calendar."""
+
+from __future__ import annotations
+
+import logging
+from datetime import date
+
+import pytest
+from nw_core.calendar import (
+    CalendarOverrides,
+    WorkingDayCalendar,
+)
+
+
+@pytest.fixture
+def cal() -> WorkingDayCalendar:
+    return WorkingDayCalendar()
+
+
+# --- Weekends ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "d,expected",
+    [
+        (date(2024, 5, 25), False),  # Sat
+        (date(2024, 5, 26), False),  # Sun
+        (date(2024, 5, 24), True),  # Fri (working)
+        (date(2024, 5, 28), True),  # Tue (working — Mon 27 is Spring BH)
+    ],
+)
+def test_is_working_day_weekends(cal, d, expected):
+    assert cal.is_working_day(d, "EnglandAndWales") == expected
+
+
+# --- England & Wales bank holidays --------------------------------------
+
+
+@pytest.mark.parametrize(
+    "d",
+    [
+        date(2024, 1, 1),  # New Year's Day
+        date(2024, 3, 29),  # Good Friday
+        date(2024, 4, 1),  # Easter Monday
+        date(2024, 5, 6),  # Early May BH
+        date(2024, 5, 27),  # Spring BH
+        date(2024, 8, 26),  # Summer BH
+        date(2024, 12, 25),  # Christmas Day
+        date(2024, 12, 26),  # Boxing Day
+        date(2025, 1, 1),  # 2025 NY
+        date(2025, 4, 18),  # 2025 Good Friday
+        date(2025, 4, 21),  # 2025 Easter Monday
+        date(2025, 5, 5),  # 2025 Early May BH
+        date(2025, 5, 26),  # 2025 Spring BH
+        date(2025, 8, 25),  # 2025 Summer BH
+        date(2025, 12, 25),  # 2025 Christmas
+        date(2025, 12, 26),  # 2025 Boxing Day
+    ],
+)
+def test_england_wales_known_holidays_are_not_working_days(cal, d):
+    assert not cal.is_working_day(d, "EnglandAndWales")
+
+
+# --- Scotland-specific ---------------------------------------------------
+
+
+def test_scotland_has_2nd_january():
+    cal = WorkingDayCalendar()
+    assert not cal.is_working_day(date(2024, 1, 2), "Scotland")
+    assert cal.is_working_day(date(2024, 1, 2), "EnglandAndWales")
+
+
+def test_scotland_st_andrews_day_in_2024_is_a_holiday():
+    cal = WorkingDayCalendar()
+    # 30 Nov 2024 is a Saturday so working-day status is independent;
+    # check the date appears in the holiday list at least.
+    assert date(2024, 11, 30) in cal.list_holidays("Scotland", 2024)
+
+
+# --- Northern Ireland-specific -------------------------------------------
+
+
+def test_northern_ireland_st_patricks_day():
+    cal = WorkingDayCalendar()
+    # 17 Mar 2024 is a Sunday, so the holiday observance day rolls.
+    # holidays lib reports 17 Mar (the canonical date) — still a non-working day in our calendar.
+    assert not cal.is_working_day(date(2024, 3, 18), "NorthernIreland")  # observed Monday
+
+
+def test_northern_ireland_battle_of_the_boyne_2024_is_a_holiday():
+    cal = WorkingDayCalendar()
+    assert date(2024, 7, 12) in cal.list_holidays("NorthernIreland", 2024)
+
+
+# --- Christmas / New Year substitute days --------------------------------
+
+
+def test_christmas_2022_substitute_27_dec_in_england():
+    """25 Dec 2022 was Sunday, 26 Dec was Boxing Day Monday; substitute day
+    falls on Tuesday 27 Dec."""
+    cal = WorkingDayCalendar()
+    assert date(2022, 12, 27) in cal.list_holidays("EnglandAndWales", 2022)
+
+
+def test_new_year_substitute_when_jan_1_is_weekend():
+    cal = WorkingDayCalendar()
+    # 1 Jan 2023 is a Sunday → substitute Mon 2 Jan 2023.
+    holidays_2023 = cal.list_holidays("EnglandAndWales", 2023)
+    assert date(2023, 1, 2) in holidays_2023
+
+
+# --- February month-end --------------------------------------------------
+
+
+def test_last_working_day_of_feb_2024_leap_year():
+    cal = WorkingDayCalendar()
+    # 29 Feb 2024 is a Thursday → that is the last working day.
+    assert cal.last_working_day_of_month(2024, 2, "EnglandAndWales") == date(2024, 2, 29)
+
+
+def test_last_working_day_of_feb_2025():
+    cal = WorkingDayCalendar()
+    # 28 Feb 2025 is a Friday → working day.
+    assert cal.last_working_day_of_month(2025, 2, "EnglandAndWales") == date(2025, 2, 28)
+
+
+# --- previous / next / nearest working day -------------------------------
+
+
+def test_previous_working_day_skips_bank_holiday():
+    cal = WorkingDayCalendar()
+    # 26 Dec 2024 is Boxing Day (Thursday). Previous working day: Tue 24 Dec
+    # because 25 Dec is Christmas Day (Wed).
+    assert cal.previous_working_day(date(2024, 12, 26), "EnglandAndWales") == date(2024, 12, 24)
+
+
+def test_next_working_day_skips_to_after_new_year():
+    cal = WorkingDayCalendar()
+    # 31 Dec 2023 is a Sunday; 1 Jan 2024 is a Mon bank holiday;
+    # 2 Jan 2024 is the next working day.
+    assert cal.next_working_day(date(2023, 12, 31), "EnglandAndWales") == date(2024, 1, 2)
+
+
+def test_nearest_working_day_for_a_weekend():
+    cal = WorkingDayCalendar()
+    # 25 May 2024 was Saturday. Nearest working day → Friday 24 May.
+    assert cal.nearest_working_day(date(2024, 5, 25), "EnglandAndWales") == date(2024, 5, 24)
+
+
+def test_nearest_working_day_returns_input_when_already_working():
+    cal = WorkingDayCalendar()
+    d = date(2024, 5, 28)  # Tue (after Spring BH Mon 27)
+    assert cal.nearest_working_day(d, "EnglandAndWales") == d
+
+
+# --- first working day of month ------------------------------------------
+
+
+def test_first_working_day_of_jan_2024_is_2nd():
+    cal = WorkingDayCalendar()
+    assert cal.first_working_day_of_month(2024, 1, "EnglandAndWales") == date(2024, 1, 2)
+
+
+def test_first_working_day_in_a_month_starting_on_weekend():
+    cal = WorkingDayCalendar()
+    # 1 Jun 2024 = Saturday → first working day = Mon 3 Jun.
+    assert cal.first_working_day_of_month(2024, 6, "EnglandAndWales") == date(2024, 6, 3)
+
+
+# --- Unknown region fallback --------------------------------------------
+
+
+def test_unknown_region_alias_falls_back_to_eng_with_warning(caplog):
+    cal = WorkingDayCalendar()
+    caplog.set_level(logging.WARNING)
+    out = cal.is_working_day(date(2024, 12, 25), "UnknownDefaultEnglandAndWales")
+    assert out is False
+    assert any("defaulting to" in rec.message.lower() for rec in caplog.records)
+
+
+def test_unknown_region_warning_emitted_only_once(caplog):
+    cal = WorkingDayCalendar()
+    caplog.set_level(logging.WARNING)
+    cal.is_working_day(date(2024, 12, 25), "Atlantis")
+    cal.is_working_day(date(2024, 12, 26), "Atlantis")
+    warnings = [r for r in caplog.records if "defaulting to" in r.message.lower()]
+    assert len(warnings) == 1
+
+
+# --- Overrides ------------------------------------------------------------
+
+
+def test_yaml_override_adds_extra_holiday():
+    extra = date(2024, 6, 15)
+    overrides = CalendarOverrides(add={"EnglandAndWales": {extra}})
+    cal = WorkingDayCalendar(overrides=overrides)
+    assert not cal.is_working_day(extra, "EnglandAndWales")
+
+
+def test_yaml_override_removes_holiday():
+    overrides = CalendarOverrides(remove={"EnglandAndWales": {date(2024, 5, 6)}})
+    cal = WorkingDayCalendar(overrides=overrides)
+    assert cal.is_working_day(date(2024, 5, 6), "EnglandAndWales")
+
+
+def test_calendar_overrides_from_config():
+    block = {
+        "EnglandAndWales": {"add": ["2024-06-15"], "remove": ["2024-05-06"]},
+        "Scotland": {"add": [], "remove": []},
+    }
+    overrides = CalendarOverrides.from_config(block)
+    assert date(2024, 6, 15) in overrides.add["EnglandAndWales"]
+    assert date(2024, 5, 6) in overrides.remove["EnglandAndWales"]
+
+
+def test_calendar_overrides_handles_none_payload():
+    overrides = CalendarOverrides.from_config(None)
+    assert overrides.add == {}
+    assert overrides.remove == {}
+
+
+def test_working_day_calendar_from_app_config_uses_overrides():
+    from nw_aglib_toolkit.pipeline.config import AppConfig
+    from nw_core.calendar import working_day_calendar_from_app_config
+
+    config = AppConfig(
+        data={
+            "regions": {
+                "EnglandAndWales": {"add": ["2024-06-15"], "remove": []},
+            }
+        }
+    )
+    cal = working_day_calendar_from_app_config(config)
+    assert not cal.is_working_day(date(2024, 6, 15), "EnglandAndWales")
