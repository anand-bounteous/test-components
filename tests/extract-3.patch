+"""REST route for the end-to-end gift detector tool."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from nw_agbus_gift_extractor.channels.tools.GiftTransactionExtractorTools import (
+    detect_gift_candidates,
+)
+from nw_agbus_gift_extractor.services.GiftRequestParsing import (
+    gift_request_from_mapping,
+)
+from nw_agbus_gift_extractor.channels.rest.ApiModels import DetectGiftRequest
+from nw_agbus_gift_extractor.channels.rest.ApiResponseModels import DetectGiftSuccessResponse
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_context,
+    error_response,
+    success_response,
+)
+
+
+class GiftDetectRoute(BaseToolRoute):
+    tool_name = "detect_gift_candidates"
+    path = "/gift/detect"
+    tags = ("gift",)
+    summary = "Run the full monetary gift detection pipeline."
+    openapi_filename = "detect_gift_candidates.openapi.yaml"
+    success_response_model = DetectGiftSuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
+        def detect_gift(body: DetectGiftRequest):
+            try:
+                ctx = build_context(body)
+                payload = gift_request_from_mapping(body.model_dump())
+                result = detect_gift_candidates(
+                    payload,
+                    config=ctx.config,
+                    calendar=ctx.calendar,
+                    mode=payload.validation_mode,
+                    max_candidates=body.max_candidates,
+                    max_near_misses=body.max_near_misses,
+                    return_threshold=body.return_threshold,
+                    include_audit=body.include_audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
