+"""REST routes for graph clustering and dedup candidate pool."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import (
+    DedupCandidatePoolRequest,
+    GraphClusteringRequest,
+)
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import (
+    bank_transactions_from_wire,
+    candidate_sets_from_wire,
+    features_by_id_from_wire,
+)
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..GraphClusteringTools import run_dedup_candidate_pool, run_graph_clustering
+
+
+class GraphClusteringRoute(BaseToolRoute):
+    tool_name = "run_graph_clustering"
+    path = "/clustering/graph"
+    tags = ("clustering",)
+    summary = "Generate graph-clustering salary candidate sets."
+    openapi_filename = "run_graph_clustering.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def graph_cluster(body: GraphClusteringRequest):
+            try:
+                ctx = build_context(body)
+                audit = build_audit(body)
+                result = run_graph_clustering(
+                    bank_transactions_from_wire(body.normalised),
+                    features_by_id_from_wire(body.features_by_id),
+                    config=ctx.config,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
+
+
+class DedupCandidatePoolRoute(BaseToolRoute):
+    tool_name = "run_dedup_candidate_pool"
+    path = "/clustering/dedup"
+    tags = ("clustering",)
+    summary = "Merge skeleton and graph candidates by transaction overlap."
+    openapi_filename = "run_dedup_candidate_pool.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def dedup_pool(body: DedupCandidatePoolRequest):
+            try:
+                build_context(body)
+                audit = build_audit(body)
+                result = run_dedup_candidate_pool(
+                    candidate_sets_from_wire(body.skeleton_candidates),
+                    candidate_sets_from_wire(body.graph_candidates),
+                    overlap_threshold=body.overlap_threshold,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
