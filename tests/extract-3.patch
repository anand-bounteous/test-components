+"""Phase 1 — hint model parsing (FR-016, FR-017)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    PayslipHint,
+    SalaryHints,
+)
+
+from tests.feature.support.HintIo import hint_inputs_from_dict
+
+# --- PayslipHint ----------------------------------------------------------
+
+
+def test_payslip_hint_accepts_yyyy_mm_and_coerces_amount():
+    h = PayslipHint(month="2024-04", amount=2453.67)
+    assert h.month == "2024-04"
+    assert h.amount == Decimal("2453.67")
+
+
+def test_payslip_hint_assigns_default_hint_id():
+    h = PayslipHint(month="2024-04", amount=Decimal("2453.67"))
+    assert h.hint_id == "hint_2024-04_2453.67"
+
+
+def test_payslip_hint_keeps_explicit_hint_id():
+    h = PayslipHint(month="2024-04", amount=Decimal("2453.67"), hint_id="payslip_april")
+    assert h.hint_id == "payslip_april"
+
+
+@pytest.mark.parametrize("bad", ["2024/04", "2024-13", "april-2024", "2024-1", ""])
+def test_payslip_hint_rejects_bad_month_format(bad):
+    with pytest.raises(ValueError):
+        PayslipHint(month=bad, amount=Decimal("100"))
+
+
+def test_payslip_hint_rejects_non_decimal_amount():
+    with pytest.raises(ValueError):
+        PayslipHint(month="2024-04", amount="not-a-number")
+
+
+def test_payslip_hint_is_hashable_and_immutable():
+    h = PayslipHint(month="2024-04", amount=Decimal("2453.67"))
+    {h}  # hashable
+    with pytest.raises(Exception):
+        h.month = "2024-05"  # frozen
+
+
+# --- SalaryHints ----------------------------------------------------------
+
+
+def test_salary_hints_default_tolerance_is_20pct():
+    h = SalaryHints(approx_monthly=Decimal("2500"))
+    assert h.tolerance_pct == 0.20
+
+
+def test_salary_hints_effective_monthly_uses_monthly_when_provided():
+    h = SalaryHints(approx_monthly=Decimal("2500"), approx_yearly=Decimal("60000"))
+    assert h.effective_monthly == Decimal("2500")
+
+
+def test_salary_hints_effective_monthly_derives_from_yearly_when_only_yearly():
+    h = SalaryHints(approx_yearly=Decimal("30000"))
+    assert h.effective_monthly == Decimal("2500")
+
+
+def test_salary_hints_is_empty_when_no_fields_provided():
+    h = SalaryHints()
+    assert h.is_empty() is True
+    assert h.effective_monthly is None
+
+
+def test_salary_hints_rejects_tolerance_out_of_range():
+    with pytest.raises(ValueError):
+        SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=1.5)
+    with pytest.raises(ValueError):
+        SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=-0.1)
+
+
+# --- hint_inputs_from_dict --------------------------------------------------
+
+
+def test_hint_inputs_empty_payload_returns_empty_inputs():
+    h = hint_inputs_from_dict(None)
+    assert h.payslip_hints == ()
+    assert h.salary_hints is None
+
+
+def test_hint_inputs_parses_full_payload():
+    payload = {
+        "payslip_hints": [
+            {"month": "2024-04", "amount": 2453.67, "hint_id": "h_april"},
+            {"month": "2024-05", "amount": 2453.67},
+        ],
+        "salary_hints": {"approx_monthly": 2500.00, "tolerance_pct": 0.15},
+    }
+    h = hint_inputs_from_dict(payload)
+    assert len(h.payslip_hints) == 2
+    assert h.payslip_hints[0].hint_id == "h_april"
+    assert h.payslip_hints[1].hint_id == "hint_2024-05_2453.67"
+    assert h.salary_hints.tolerance_pct == 0.15
+    assert h.salary_hints.approx_monthly == Decimal("2500.00")
+
+
+def test_hint_inputs_parses_yearly_only_salary_hint():
+    payload = {"salary_hints": {"approx_yearly": 36000}}
+    h = hint_inputs_from_dict(payload)
+    assert h.salary_hints.effective_monthly == Decimal("3000")
