+"""BaseTool logging and audit integration."""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import (
+    run_normalize_bank_transactions,
+)
+from nw_aglib_toolkit.audit import AuditBuilder
+from nw_aglib_toolkit.channels.tools import BaseTool, BaseToolModel
+from nw_core.logging import TRACE, LogFn
+
+
+@dataclass(frozen=True)
+class _EchoToolResult(BaseToolModel):
+    value: int = 0
+
+
+class _EchoTool(BaseTool[_EchoToolResult]):
+    phase_name = "echo"
+
+    @LogFn
+    def _execute(self, value: int) -> _EchoToolResult:
+        return _EchoToolResult(value=value * 2)
+
+    def build_input_summary(self, value: int, **kwargs) -> dict:
+        return {"in": value}
+
+    def build_output_summary(self, result: _EchoToolResult, value: int, **kwargs) -> dict:
+        return {"out": result.value}
+
+
+def test_base_tool_run_without_audit_does_not_merge():
+    audit = AuditBuilder(enabled=True, analysis_id="test")
+    tool = _EchoTool()
+    result = tool.run(3)
+
+    assert result.value == 6
+    assert result.audit is None
+    assert audit.snapshot() is not None
+    assert audit.snapshot().pipeline_steps == ()
+
+
+def test_base_tool_run_merges_audit_and_warnings_into_pipeline():
+    audit = AuditBuilder(enabled=True, analysis_id="test")
+    warnings: list = []
+    tool = _EchoTool()
+    result = tool.run(4, audit=audit, warnings=warnings)
+
+    assert result.value == 8
+    assert result.audit is not None
+    assert result.audit.phase_name == "echo"
+    snapshot = audit.snapshot()
+    assert snapshot is not None
+    assert len(snapshot.pipeline_steps) == 1
+    assert snapshot.pipeline_steps[0].name == "echo"
+
+
+def test_normalization_tool_run_with_audit(caplog):
+    audit = AuditBuilder(enabled=True, analysis_id="test")
+    warnings: list = []
+    rows = (
+        RawBankTransaction(
