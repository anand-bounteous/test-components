+import type { CSSProperties } from "react";
+import { panelStyles } from "../../styles/shared";
+
+export type PageNavigatorProps = {
+  currentPageIndex: number;
+  totalPages: number;
+  onPageChange: (pageIndex: number) => void;
+};
+
+export function PageNavigator({
+  currentPageIndex,
+  totalPages,
+  onPageChange,
+}: PageNavigatorProps) {
+  const canGoPrev = currentPageIndex > 0;
+  const canGoNext = currentPageIndex < totalPages - 1;
+
+  const handleJump = (value: string) => {
+    const parsed = Number.parseInt(value, 10);
+    if (Number.isNaN(parsed)) return;
+    const next = parsed - 1;
+    if (next >= 0 && next < totalPages) {
+      onPageChange(next);
+    }
+  };
+
+  if (totalPages === 0) {
+    return (
+      <div style={styles.container} data-testid="page-navigator">
+        <span style={styles.label}>No pages</span>
+      </div>
+    );
+  }
+
+  return (
+    <div style={styles.container} data-testid="page-navigator">
+      <button
+        type="button"
+        style={{
+          ...panelStyles.button,
+          ...(canGoPrev ? {} : panelStyles.buttonDisabled),
+        }}
+        disabled={!canGoPrev}
+        onClick={() => onPageChange(currentPageIndex - 1)}
+        aria-label="Previous page"
+      >
+        Prev
+      </button>
+      <span style={styles.label} data-testid="page-indicator">
+        Page {currentPageIndex + 1} of {totalPages}
+      </span>
+      <label style={styles.jumpLabel}>
+        Go to
+        <input
+          type="number"
+          min={1}
+          max={totalPages}
+          defaultValue={currentPageIndex + 1}
+          key={currentPageIndex}
+          style={styles.jumpInput}
+          onBlur={(e) => handleJump(e.target.value)}
+          onKeyDown={(e) => {
+            if (e.key === "Enter") {
+              handleJump((e.target as HTMLInputElement).value);
+            }
+          }}
+          aria-label="Jump to page"
+        />
+      </label>
+      <button
+        type="button"
+        style={{
+          ...panelStyles.button,
+          ...(canGoNext ? {} : panelStyles.buttonDisabled),
+        }}
+        disabled={!canGoNext}
+        onClick={() => onPageChange(currentPageIndex + 1)}
+        aria-label="Next page"
+      >
+        Next
+      </button>
+    </div>
+  );
+}
