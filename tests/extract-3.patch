+"""Framework-neutral @tool decorator for agent-callable functions."""
+
+from __future__ import annotations
+
+import json
+import logging
+from collections.abc import Callable
+from functools import wraps
+from typing import Any
+
+from nw_aglib_toolkit.channels.tools.ToolMetadata import ToolMetadata
+from nw_aglib_toolkit.channels.tools.ToolSchema import build_tool_parameter_metadata
+from nw_core.logging import TRACE, get_logger
+from nw_core.logging.LogFnAnnotation import linearize_for_log
+
+TOOL_METADATA_ATTR = "__tool_metadata__"
+
+
+def tool(
+    *,
+    name: str | None = None,
+    description: str | None = None,
+    category: str | None = None,
+    tags: list[str] | tuple[str, ...] | None = None,
+    enabled: bool = True,
+    version: str = "1.0.0",
+    **extra: Any,
+) -> Callable:
+    """Framework-neutral annotation for agent-callable tools.
+
+    Parameter names, type annotations, required/default flags, and return type
+    are captured automatically from the wrapped callable's signature.
+    """
+
+    def decorator(func: Callable) -> Callable:
+        resolved_name = name or func.__name__
+        resolved_description = description or _description_from_docstring(func)
+        parameters, return_type = build_tool_parameter_metadata(func)
+        tool_logger = get_logger(func.__module__)
+
+        metadata = ToolMetadata(
+            name=resolved_name,
+            description=resolved_description,
+            category=category,
+            tags=tuple(tags or ()),
+            enabled=enabled,
+            version=version,
+            parameters=parameters,
+            return_type=return_type,
+            extra=extra,
+        )
+
+        setattr(func, TOOL_METADATA_ATTR, metadata)
+
+        @wraps(func)
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            _trace_tool_request(tool_logger, resolved_name, args, kwargs)
+            return func(*args, **kwargs)
+
+        setattr(wrapper, TOOL_METADATA_ATTR, metadata)
+        return wrapper
+
+    return decorator
+
+
+def get_tool_metadata(func: Callable) -> ToolMetadata | None:
+    return getattr(func, TOOL_METADATA_ATTR, None)
+
+
+def is_tool(func: Callable) -> bool:
+    return get_tool_metadata(func) is not None
+
+
+def _trace_tool_request(
+    logger: logging.Logger,
+    tool_name: str,
+    args: tuple[Any, ...],
+    kwargs: dict[str, Any],
+) -> None:
+    if not logger.isEnabledFor(TRACE):
+        return
+    payload = {
+        "tool": tool_name,
+        "args": linearize_for_log(args),
+        "kwargs": linearize_for_log(kwargs),
+    }
+    logger.trace(
+        "tool.request %s",
+        json.dumps(payload, ensure_ascii=True, separators=(",", ":")),
+    )
+
+
+def _description_from_docstring(func: Callable) -> str:
+    doc = getattr(func, "__doc__", None)
+    if doc and doc.strip():
+        return doc.strip().split("\n\n", 1)[0].strip()
+
+    return f"Tool function `{func.__name__}`."
