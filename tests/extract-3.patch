+"""Unit tests for AuditBuilder."""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+from nw_aglib_toolkit.audit import AuditBuilder, AuditRecord
+
+
+@pytest.mark.unit
+def test_audit_builder_disabled_returns_no_snapshot() -> None:
+    ab = AuditBuilder(enabled=False)
+    ab.start_step("anything")
+    ab.record_step("anything")
+    assert ab.snapshot() is None
+
+
+@pytest.mark.unit
+def test_audit_builder_disabled_no_op_on_features() -> None:
+    ab = AuditBuilder(enabled=False)
+    ab.record_features(())
+    ab.record_candidates(())
+    assert ab.snapshot() is None
+
+
+@pytest.mark.unit
+def test_audit_builder_enabled_returns_snapshot() -> None:
+    ab = AuditBuilder(enabled=True, analysis_id="aid_1")
+    ab.start_step("step1")
+    time.sleep(0.001)
+    ab.record_step(
+        "step1",
+        input_summary={"a": 1},
+        output_summary={"b": 2},
+    )
+    snap = ab.snapshot()
+    assert isinstance(snap, AuditRecord)
+    assert snap.analysis_id == "aid_1"
+    assert snap.pipeline_steps[0].name == "step1"
+    assert snap.pipeline_steps[0].duration_ms > 0
+
+
+@pytest.mark.unit
+def test_audit_builder_config_versions_round_trip() -> None:
+    versions = {"version": "v1", "schema": "1.0"}
+    ab = AuditBuilder(enabled=True, config_versions=versions)
+    snap = ab.snapshot()
+    assert snap is not None
+    assert snap.config_versions == versions
+
+
+@pytest.mark.unit
+def test_audit_builder_effective_kwargs_round_trip() -> None:
+    kw = {"include_audit": True, "max_candidates": 3}
+    ab = AuditBuilder(enabled=True, effective_kwargs=kw)
+    snap = ab.snapshot()
+    assert snap is not None
+    assert snap.effective_kwargs == kw
+
+
+@pytest.mark.unit
+def test_audit_step_timings_dict_populated() -> None:
+    ab = AuditBuilder(enabled=True)
+    ab.start_step("s1")
+    ab.record_step("s1", input_summary={}, output_summary={})
+    snap = ab.snapshot()
+    assert snap is not None
+    assert "s1" in snap.timings_ms
+
+
+@pytest.mark.unit
+def test_audit_unstarted_step_records_zero_duration() -> None:
+    ab = AuditBuilder(enabled=True)
+    ab.record_step("never_started", input_summary={}, output_summary={})
+    snap = ab.snapshot()
+    assert snap is not None
+    assert snap.pipeline_steps[0].duration_ms < 1.0
