+#!/usr/bin/env python3
+"""Export merged REST OpenAPI contracts for business agents and bank-transactions core."""
+from __future__ import annotations
+
+from importlib import import_module
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+
+BUSINESS_AGENTS = [
+    {
+        "dir": "gift-extractor",
+        "module": "nw_agbus_gift_extractor.channels.rest.GiftDetectRoute",
+        "class_name": "GiftDetectRoute",
+    },
+    {
+        "dir": "salary-extractor",
+        "module": "nw_agbus_salary_extractor.channels.rest.SalaryDetectRoute",
+        "class_name": "SalaryDetectRoute",
+    },
+    {
+        "dir": "rent-extractor",
+        "module": "nw_agbus_rent_extractor.channels.rest.RentDetectRoute",
+        "class_name": "RentDetectRoute",
+    },
+    {
+        "dir": "property-sale-extractor",
+        "module": "nw_agbus_property_sale_extractor.channels.rest.PropertySaleDetectRoute",
+        "class_name": "PropertySaleDetectRoute",
+    },
+]
+
+
+def write_yaml(path: Path, document: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        yaml.safe_dump(
+            document,
+            sort_keys=False,
+            default_flow_style=False,
+            allow_unicode=True,
+        ),
+        encoding="utf-8",
+    )
+
+
+def load_route(module_path: str, class_name: str):
+    module = import_module(module_path)
+    return getattr(module, class_name)()
+
+
+def export_route(route) -> None:
+    document = route.openapi_document()
+    if document is None:
+        raise FileNotFoundError(f"No OpenAPI document for {route.__class__.__name__}")
+    write_yaml(route.openapi_path, document)
+
+
+def export_business_agents() -> None:
+    for cfg in BUSINESS_AGENTS:
+        route = load_route(cfg["module"], cfg["class_name"])
+        export_route(route)
+        print("exported", cfg["dir"], "->", route.openapi_path)
+
+
+def export_bank_transactions_core() -> None:
+    from nw_agcore_bank_transactions.channels.rest.routes import all_core_tool_routes
+
+    for route in all_core_tool_routes():
+        export_route(route)
+        print("exported core ->", route.openapi_path)
+
+
+def main() -> None:
+    export_business_agents()
+    export_bank_transactions_core()
+
+
+if __name__ == "__main__":
+    main()
