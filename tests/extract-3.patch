+"""Gift hint matching facade for grouping and scoring."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date, timedelta
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import (
+    overlap_match_level,
+    tokenise_employer_name,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models.GiftHints import GiftHints
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+
+from .AmountMinimumMatcher import meets_minimum
+from .KeywordsMatcher import gift_keyword_score
+
+
+def has_gift_keyword(description: str, positive: Sequence[str], negative: Sequence[str]) -> bool:
+    return gift_keyword_score(description, positive, negative) > 0.0
+
+
+class GiftHintMatcher:
+    def __init__(
+        self,
+        *,
+        positive_keywords: Sequence[str] = (),
+        negative_keywords: Sequence[str] = (),
+        default_tolerance_days: int = 5,
+    ) -> None:
+        self._positive = tuple(positive_keywords)
+        self._negative = tuple(negative_keywords)
+        self._default_tolerance_days = default_tolerance_days
+
+    @property
+    def positive_keywords(self) -> tuple[str, ...]:
+        return self._positive
+
+    @property
+    def negative_keywords(self) -> tuple[str, ...]:
+        return self._negative
+
+    def effective_tolerance_days(self, hint_inputs: GiftHints) -> int:
+        if hint_inputs.tolerance_days is not None:
+            return int(hint_inputs.tolerance_days)
+        return self._default_tolerance_days
+
+    def validate_amount_present(self, hint_inputs: GiftHints) -> None:
+        if hint_inputs.amount is None:
+            raise ValueError("gift_hints.amount is required")
+
+    def txn_matches_amount(self, txn: BankTransaction, hint_inputs: GiftHints) -> bool:
+        if hint_inputs.amount is None:
+            return False
+        return meets_minimum(txn.amount, hint_inputs.amount)
+
+    def donor_match_level(self, txn: BankTransaction, hint_inputs: GiftHints) -> str:
+        if not hint_inputs.donor_name:
+            return "none"
+        tokens = frozenset(txn.description_tokens)
+        return overlap_match_level(tokens, hint_inputs.donor_name, load_hint_config())
+
+    def txn_soft_match(self, txn: BankTransaction, hint_inputs: GiftHints) -> bool:
+        if self.txn_matches_amount(txn, hint_inputs):
+            return True
+        if has_gift_keyword(
+            txn.normalised_description,
+            self._positive,
+            self._negative,
+        ):
+            return True
+        if self.donor_match_level(txn, hint_inputs) != "none":
+            return True
+        return False
+
+    def resolve_expected_date(
+        self,
+        transactions: Sequence[BankTransaction],
+        hint_inputs: GiftHints,
+    ) -> date | None:
+        if hint_inputs.expected_date:
+            return date.fromisoformat(hint_inputs.expected_date)
+        return None
+
+    def resolve_date_window(
+        self,
+        expected: date | None,
+        hint_inputs: GiftHints,
+        transactions: Sequence[BankTransaction],
+    ) -> tuple[date, date]:
+        if expected is not None:
+            tolerance = self.effective_tolerance_days(hint_inputs)
+            return expected - timedelta(days=tolerance), expected + timedelta(days=tolerance)
+        if transactions:
+            sorted_dates = sorted(t.date for t in transactions)
+            return sorted_dates[0], sorted_dates[-1]
+        today = date.today()
+        return today, today
+
+    def cluster_key(self, txn: BankTransaction) -> str:
+        tokens = sorted(tokenise_employer_name(txn.normalised_description, load_hint_config()))
+        if tokens:
+            return " ".join(tokens[:4])
+        return txn.normalised_description[:40].upper()
