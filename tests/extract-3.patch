+"""Parse hint dicts from fixtures into ``HintInputs`` (tests and tooling only)."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from nw_agcore_bank_transactions.pipeline.hints.models import (
+    EmployerHints,
+    HintInputs,
+    PayslipHint,
+    SalaryHints,
+)
+
+if TYPE_CHECKING:
+    from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import HintConfig
+
+
+def _payslip_from_mapping(entry: dict, config: HintConfig) -> PayslipHint:
+    hint = PayslipHint(
+        month=entry["month"],
+        amount=entry["amount"],
+        hint_id=entry.get("hint_id", ""),
+    )
+    hint.validate_month(config.month_pattern)
+    return hint
+
+
+def hint_inputs_from_dict(
+    payload: dict | None,
+    *,
+    config: HintConfig | None = None,
+) -> HintInputs:
+    if not payload:
+        return HintInputs()
+    from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import (
+        load_hint_config,
+    )
+
+    cfg = config or load_hint_config()
+    ps = tuple(_payslip_from_mapping(p, cfg) for p in payload.get("payslip_hints", []))
+    sh_dict = payload.get("salary_hints")
+    sh = (
+        SalaryHints(
+            approx_monthly=sh_dict.get("approx_monthly"),
+            approx_yearly=sh_dict.get("approx_yearly"),
+            tolerance_pct=sh_dict.get("tolerance_pct", cfg.default_tolerance_pct),
+        )
+        if sh_dict is not None
+        else None
+    )
+    eh_dict = payload.get("employer_hints")
+    eh = (
+        EmployerHints(
+            current_employer=eh_dict["current_employer"],
+            previous_employer=eh_dict.get("previous_employer"),
+        )
+        if eh_dict is not None and eh_dict.get("current_employer")
+        else None
+    )
+    return HintInputs(payslip_hints=ps, salary_hints=sh, employer_hints=eh)
+
+
+__all__ = ["hint_inputs_from_dict"]
