+
+afterEach(() => {
+  cleanup();
+});
+
+describe("AnnotatedPageViewer", () => {
+  it("renders annotation overlays for the current page", async () => {
+    const page = sampleStatement.pages[0]!;
+    const annotations = sampleStatement.annotations.filter(
+      (annotation) => annotation.pageIndex === 0,
+    );
+
+    render(
+      <AnnotatedPageViewer
+        page={page}
+        annotations={annotations}
+        hiddenKinds={new Set()}
+      />,
+    );
+
+    await waitFor(() => {
+      expect(screen.getByTestId("annotation-overlay")).toBeInTheDocument();
+    });
+
+    const rects = document.querySelectorAll("[data-annotation-id]");
+    expect(rects.length).toBeGreaterThan(0);
+  });
+
+  it("calls onAnnotationSelect when an annotation is clicked", async () => {
+    const onSelect = vi.fn();
+    const page = sampleStatement.pages[0]!;
+    const annotations = sampleStatement.annotations.filter(
+      (annotation) => annotation.pageIndex === 0,
+    );
+
+    render(
+      <AnnotatedPageViewer
+        page={page}
+        annotations={annotations}
+        hiddenKinds={new Set()}
+        onAnnotationSelect={onSelect}
+      />,
+    );
+
+    await waitFor(() => {
+      expect(document.querySelector("[data-annotation-id='logo-0']")).toBeTruthy();
+    });
+
+    const logoAnnotation = document.querySelector(
+      "[data-annotation-id='logo-0']",
+    ) as SVGElement;
+    fireEvent.click(logoAnnotation);
+    expect(onSelect).toHaveBeenCalledWith("logo-0");
+  });
+
+  it("hides annotations when kind is in hiddenKinds", async () => {
+    const page = sampleStatement.pages[0]!;
+    const annotations = sampleStatement.annotations.filter(
+      (annotation) => annotation.pageIndex === 0,
+    );
+
+    render(
+      <AnnotatedPageViewer
+        page={page}
+        annotations={annotations}
+        hiddenKinds={new Set(["logo"])}
+      />,
+    );
+
+    await waitFor(() => {
+      expect(screen.getByTestId("annotation-overlay")).toBeInTheDocument();
+    });
+
+    expect(document.querySelector("[data-annotation-id='logo-0']")).toBeNull();
+    expect(document.querySelector("[data-annotation-id='table-0']")).toBeTruthy();
+  });
+});
