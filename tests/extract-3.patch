+"""Single transaction within a salary candidate set."""
+
+from __future__ import annotations
+
+import uuid
+from dataclasses import dataclass, field
+
+from .BankTransaction import BankTransaction
+from .ConfidenceDetail import ConfidenceDetail
+
+
+@dataclass(frozen=True)
+class CandidateTransaction:
+    date: str
+    description: str
+    amount: float
+    transaction_id: str = field(default_factory=lambda: str(uuid.uuid4()))
+    confidence: float = 0.0
+    confidence_band: str = "very_low"
+    reasoning: tuple[str, ...] = ()
+    confidence_details: tuple[ConfidenceDetail, ...] = ()
+
+
+def candidate_transaction_from(
+    nt: BankTransaction,
+    *,
+    confidence: float = 0.0,
+    confidence_band: str = "very_low",
+    reasoning: tuple[str, ...] = (),
+    confidence_details: tuple[ConfidenceDetail, ...] = (),
+) -> CandidateTransaction:
+    return CandidateTransaction(
+        transaction_id=nt.id,
+        date=nt.date.isoformat(),
+        description=nt.raw_description,
+        amount=float(nt.amount),
+        confidence=confidence,
+        confidence_band=confidence_band,
+        reasoning=reasoning,
+        confidence_details=confidence_details,
+    )
