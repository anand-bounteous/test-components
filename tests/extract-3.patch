+"""Hard-reject candidate sets that match application negative keywords."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Mapping, Sequence
+from dataclasses import replace
+from typing import Any, TypeVar
+
+from .._models import TransactionFeatures
+
+logger = logging.getLogger(__name__)
+
+NEAR_MISS_REASON = "negative_keyword_match"
+
+CandidateT = TypeVar("CandidateT")
+
+
+def collect_matched_negative_keywords(
+    candidate: Any,
+    features_by_id: Mapping[str, TransactionFeatures],
+) -> tuple[str, ...]:
+    """Return sorted union of negative tokens across transactions in the set."""
+    matched: set[str] = set()
+    for txn in candidate.transactions:
+        feat = features_by_id.get(txn.transaction_id)
+        if feat is not None and feat.negative_tokens:
+            matched.update(feat.negative_tokens)
+    return tuple(sorted(matched))
+
+
+def tag_negative_keyword_rejection[CandidateT](
+    candidate: CandidateT,
+    matched_keywords: Sequence[str],
+) -> CandidateT:
+    """Return a copy tagged as rejected due to negative keyword match."""
+    keywords = tuple(matched_keywords)
+    meta = dict(candidate.metadata)
+    meta["near_miss_reason"] = NEAR_MISS_REASON
+    meta["matched_negative_keywords"] = list(keywords)
+    prefix = f"Skipped: negative keyword match ({', '.join(keywords)})."
+    existing = tuple(candidate.reasoning or ())
+    return replace(candidate, metadata=meta, reasoning=(prefix,) + existing)
+
+
+def partition_by_negative_keywords[CandidateT](
+    scored: Sequence[CandidateT],
+    features_by_id: Mapping[str, TransactionFeatures],
+) -> tuple[list[CandidateT], list[CandidateT]]:
+    """Split scored candidates into kept vs negative-keyword rejected."""
+    kept: list[CandidateT] = []
+    rejected: list[CandidateT] = []
+    for candidate in scored:
+        matched = collect_matched_negative_keywords(candidate, features_by_id)
+        if matched:
+            tagged = tag_negative_keyword_rejection(candidate, matched)
+            rejected.append(tagged)
+            if logger.isEnabledFor(5):
+                logger.trace(
+                    "negative_keyword_rejection candidate_set_id=%s keywords=%s",
+                    candidate.candidate_set_id,
+                    list(matched),
+                )
+        else:
+            kept.append(candidate)
+    return kept, rejected
+
+
+__all__ = [
+    "NEAR_MISS_REASON",
+    "collect_matched_negative_keywords",
+    "partition_by_negative_keywords",
+    "tag_negative_keyword_rejection",
+]
