+"""Phase 5 — plausibility scoring for skeleton groups."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    PayslipHint,
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    extract_bank_transactions_features,
+)
+from nw_agcore_bank_transactions.pipeline.hints import (
+    ambiguous_anchor_ids,
+    anchor_txn_ids,
+    apply_hints,
+)
+from nw_agcore_bank_transactions.pipeline.hints.AnchorFlags import attach_anchor_flags
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping import (
+    PlausibilityScore,
+    SkeletonGroupingService,
+)
+from nw_aglib_toolkit.pipeline.config import load_config
+from nw_core.calendar import WorkingDayCalendar
+
+from tests.feature.support.HintIo import hint_inputs_from_dict
+
+
+def _txn(tid, date_str, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=date_str,
+            description="BACS ACME LTD PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _features_by_id(txns):
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    txns = extract_bank_transactions_features(txns, app_config=cfg, calendar=cal)
+    feats = [t.features for t in txns if t.features is not None]
+    return {f.transaction_id: f for f in feats}
+
+
+@pytest.fixture
+def detector():
+    return SkeletonGroupingService(config=load_config())
+
+
+# --- Date plausibility ---------------------------------------------------
+
+
+def test_stable_monthly_group_has_high_date_plausibility(detector):
+    txns = [
+        _txn("a", "2024-01-31", "2450"),
+        _txn("b", "2024-02-29", "2450"),
+        _txn("c", "2024-03-28", "2450"),
+        _txn("d", "2024-04-30", "2450"),
+        _txn("e", "2024-05-31", "2450"),
+        _txn("f", "2024-06-28", "2450"),
+    ]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert score.date_plausibility >= 0.9
+
+
+def test_random_date_group_has_low_date_plausibility(detector):
+    """Six credits scattered with arbitrary gaps — no monthly cadence.
+
+    Coverage will be 1.0 (every spanned month has at least one credit) but
+    gap_regularity drops to 0 because no adjacent pair lands in the 26–32
+    day window. The formula caps this at 0.5 — meaningfully lower than the
+    ≥ 0.9 we expect for a stable monthly group.
+    """
+    txns = [
+        _txn("a", "2024-01-05", "2450"),
+        _txn("b", "2024-01-09", "2450"),
+        _txn("c", "2024-02-02", "2450"),
+        _txn("d", "2024-02-19", "2450"),
+        _txn("e", "2024-03-04", "2450"),
+        _txn("f", "2024-03-08", "2450"),
+    ]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert score.date_plausibility <= 0.5
+
+
+def test_single_member_group_has_zero_date_plausibility(detector):
+    txns = [_txn("a", "2024-01-31", "2450")]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert score.date_plausibility == 0.0
+
+
+# --- Amount plausibility -------------------------------------------------
+
+
+def test_stable_amount_group_has_high_amount_plausibility(detector):
+    txns = [
+        _txn("a", "2024-01-31", "2450"),
+        _txn("b", "2024-02-29", "2450"),
+        _txn("c", "2024-03-28", "2450"),
+    ]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert score.amount_plausibility >= 0.9
+
+
+def test_scattered_amount_group_has_low_amount_plausibility(detector):
+    txns = [
+        _txn("a", "2024-01-31", "500"),
+        _txn("b", "2024-02-29", "3500"),
+        _txn("c", "2024-03-28", "1200"),
+    ]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert score.amount_plausibility < 0.5
+
+
+def test_amount_plausibility_falls_when_band_modifier_kicks_in(detector):
+    txns = [
+        _txn("a", "2024-01-31", "500"),
+        _txn("b", "2024-02-29", "500"),
+        _txn("c", "2024-03-28", "500"),
+    ]
+    # Approx-salary hint says £2500; £500 is 80% below band.
+    hints_in = hint_inputs_from_dict(
+        {"salary_hints": {"approx_monthly": 2500.0, "tolerance_pct": 0.20}}
+    )
+    applied = apply_hints(
+        txns,
+        payslip_hints=hints_in.payslip_hints,
+        salary_hints=hints_in.salary_hints,
+    )
+    no_band = detector.score_group_plausibility(txns, _features_by_id(txns))
+    with_band = detector.score_group_plausibility(
+        txns,
+        _features_by_id(txns),
+        band=detector._band_from_applied_hints(applied),
+    )
+    assert with_band.amount_plausibility < no_band.amount_plausibility
+
+
+# --- Anchor presence ----------------------------------------------------
+
+
+def test_anchor_in_group_lifts_plausibility_floor_to_medium(detector):
+    """A confirmed payslip anchor must keep the group at ≥ medium even
+    when the surrounding signal is noisy."""
+    txns = [
+        _txn("a", "2024-01-05", "2450"),
+        _txn("b", "2024-01-19", "2450"),
+        _txn("c", "2024-04-30", "2453.67"),  # the anchor
+    ]
+    txns = extract_bank_transactions_features(
+        txns,
+        app_config=load_config(),
+        calendar=WorkingDayCalendar(),
+    )
+    applied = apply_hints(
+        txns,
+        payslip_hints=[PayslipHint(month="2024-04", amount=Decimal("2453.67"))],
+    )
+    enriched = attach_anchor_flags(
+        txns,
+        anchor_txn_ids(applied),
+        ambiguous_ids=ambiguous_anchor_ids(applied),
+    )
+    features_by_id = {
+        t.features.transaction_id: t.features for t in enriched if t.features is not None
+    }
+    score = detector.score_group_plausibility(
+        txns,
+        features_by_id,
+        applied_hints=applied,
+    )
+    assert score.anchor_presence == 1.0
+    assert score.final >= 0.55, "anchor must lift the floor to medium"
+
+
+def test_no_anchor_in_group_anchor_presence_is_zero(detector):
+    txns = [_txn("a", "2024-01-31", "2450"), _txn("b", "2024-02-29", "2450")]
+    applied = apply_hints(
+        txns,
+        payslip_hints=[PayslipHint(month="2024-04", amount=Decimal("2453.67"))],
+    )
+    score = detector.score_group_plausibility(txns, _features_by_id(txns), applied_hints=applied)
+    assert score.anchor_presence == 0.0
+
+
+# --- Negative-signal share -----------------------------------------------
+
+
+def test_negative_signal_share_lowers_plausibility(detector):
+    """A group of own-account transfers carries the OWN ACCOUNT negative
+    signal and the (1 - share) factor pulls the final score down."""
+    pos_txns = [
+        normalize_bank_transaction(
+            RawBankTransaction(
+                id=f"p{i}",
+                date=f"2024-{i:02d}-28",
+                description="BACS ACME LTD PAYROLL",
+                debit_amount=Decimal("0"),
+                credit_amount=Decimal("2450"),
+            )
+        )
+        for i in range(1, 7)
+    ]
+    neg_txns = [
+        normalize_bank_transaction(
+            RawBankTransaction(
+                id=f"n{i}",
+                date=f"2024-{i:02d}-28",
+                description="TRANSFER FROM OWN SAVINGS ACCOUNT",
+                debit_amount=Decimal("0"),
+                credit_amount=Decimal("2450"),
+            )
+        )
+        for i in range(1, 7)
+    ]
+    pos_score = detector.score_group_plausibility(pos_txns, _features_by_id(pos_txns))
+    neg_score = detector.score_group_plausibility(neg_txns, _features_by_id(neg_txns))
+    assert neg_score.negative_signal_share == 1.0
+    assert pos_score.negative_signal_share == 0.0
+    assert pos_score.final > neg_score.final
+
+
+# --- PlausibilityScore record shape -------------------------------------
+
+
+def test_score_record_returns_per_axis_breakdown(detector):
+    txns = [_txn("a", "2024-01-31", "2450"), _txn("b", "2024-02-29", "2450")]
+    score = detector.score_group_plausibility(txns, _features_by_id(txns))
+    assert isinstance(score, PlausibilityScore)
+    assert 0.0 <= score.final <= 1.0
+    assert 0.0 <= score.date_plausibility <= 1.0
+    assert 0.0 <= score.amount_plausibility <= 1.0
