+"""Candidate pool deduplication tool result."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from nw_aglib_toolkit.channels.tools.models.BaseToolModel import BaseToolModel
+
+from ..._models import CandidateSet
+
+
+@dataclass(frozen=True)
