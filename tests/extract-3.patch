+"""Unit tests for date proximity scoring."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.hints.matchers.DateProximityMatcher import (
+    date_delta_days,
+    date_proximity_score,
+    neutral_date_score,
+)
+
+
+@pytest.mark.unit
+def test_date_delta_days_absolute():
+    assert date_delta_days(date(2024, 1, 1), date(2024, 1, 8)) == 7
+
+
+@pytest.mark.unit
+def test_date_proximity_score_within_tolerance():
+    assert date_proximity_score(3, tolerance_days=7) > neutral_date_score()
+    assert date_proximity_score(10, tolerance_days=7) < date_proximity_score(3, tolerance_days=7)
+
+
+@pytest.mark.unit
+def test_neutral_date_score_is_between_zero_and_one():
+    score = neutral_date_score()
+    assert 0.0 <= score <= 1.0
