+"""Feature extraction tool configuration."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+from importlib import resources
+
+import yaml
+
+from .SchemaValidationSettings import SchemaValidationSettings
+
+_FEATURE_EXTRACTION_SCHEMA_PACKAGE = "nw_agcore_bank_transactions.pipeline.feature_extraction"
+
+
+class FeatureExtractionConfigError(ValueError):
+    """Raised when feature_extraction_config.yaml cannot be loaded or parsed."""
+
+
+@dataclass(frozen=True)
+class FeatureExtractionConfig:
+    schema_validation: SchemaValidationSettings
+    hint_strength_keys: tuple[str, ...]
+    channel_token_baseline: frozenset[str]
+    hint_token_baseline: frozenset[str]
+    legal_suffix_tokens: frozenset[str]
+    canonical_channels: frozenset[str]
+
+    @property
+    def salary_hint_strength_keys(self) -> tuple[str, ...]:
+        """Backward-compatible alias."""
+        return self.hint_strength_keys
+
+
+def _default_config_path() -> str:
+    return str(
+        resources.files(_FEATURE_EXTRACTION_SCHEMA_PACKAGE)
+        / "config"
+        / "feature_extraction_config.yaml"
+    )
+
+
+def _require_string_list(raw: Mapping[str, object], key: str) -> list[str]:
+    value = raw.get(key)
+    if not isinstance(value, list) or not value:
+        raise FeatureExtractionConfigError(f"{key} must be a non-empty list")
+    out: list[str] = []
+    for item in value:
+        if not isinstance(item, str) or not item.strip():
+            raise FeatureExtractionConfigError(f"{key} entries must be non-empty strings")
+        out.append(item.strip())
+    return out
+
+
+def load_feature_extraction_config(
+    config_path: str | None = None,
+) -> FeatureExtractionConfig:
+    path = config_path or _default_config_path()
+    try:
+        raw = yaml.safe_load(open(path, encoding="utf-8"))
+    except OSError as exc:
+        raise FeatureExtractionConfigError(
+            f"unable to read feature extraction config: {path}"
+        ) from exc
+    except yaml.YAMLError as exc:
+        raise FeatureExtractionConfigError(
+            f"invalid YAML in feature extraction config: {path}"
+        ) from exc
+
+    if not isinstance(raw, Mapping):
+        raise FeatureExtractionConfigError("feature extraction config root must be a mapping")
+
+    schema_validation_raw = raw.get("schema_validation", {})
+    if not isinstance(schema_validation_raw, Mapping):
+        raise FeatureExtractionConfigError("schema_validation must be a mapping")
+    enabled = schema_validation_raw.get("enabled", True)
+    strict = schema_validation_raw.get("strict", True)
+    if not isinstance(enabled, bool):
+        raise FeatureExtractionConfigError("schema_validation.enabled must be a boolean")
+    if not isinstance(strict, bool):
+        raise FeatureExtractionConfigError("schema_validation.strict must be a boolean")
+
+    strength_keys = raw.get("hint_strength_keys") or raw.get("salary_hint_strength_keys")
+    if not isinstance(strength_keys, list) or not strength_keys:
+        raise FeatureExtractionConfigError("hint_strength_keys must be a non-empty list")
+
+    return FeatureExtractionConfig(
+        schema_validation=SchemaValidationSettings(enabled=enabled, strict=strict),
+        hint_strength_keys=tuple(str(item).strip() for item in strength_keys if str(item).strip()),
+        channel_token_baseline=frozenset(_require_string_list(raw, "channel_token_baseline")),
+        hint_token_baseline=frozenset(_require_string_list(raw, "hint_token_baseline")),
+        legal_suffix_tokens=frozenset(_require_string_list(raw, "legal_suffix_tokens")),
+        canonical_channels=frozenset(_require_string_list(raw, "canonical_channels")),
+    )
