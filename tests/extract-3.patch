+"""Bank transaction feature extraction service — Design §6.3."""
+
+from __future__ import annotations
+
+from calendar import monthrange
+from collections.abc import Iterable
+from dataclasses import replace
+from datetime import date, timedelta
+from typing import Any
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.validation.schema import (
+    SchemaCheckConfig,
+    SchemaCheckService,
+    SchemaValidationError,
+)
+
+from .._models import BankTransaction, TransactionFeatures
+from .DescriptionFeatureExtractor import DescriptionFeatureExtractor
+from .models import (
+    DescriptionSignalConfig,
+    FeatureExtractionBatchResult,
+    FeatureExtractionConfig,
+    FeatureExtractionResult,
+    load_feature_extraction_config,
+)
+from .PaymentChannelDetector import PaymentChannelDetector
+
+_FEATURE_EXTRACTION_SCHEMA_PACKAGE = "nw_agcore_bank_transactions.pipeline.feature_extraction"
+_FEATURE_EXTRACTION_SCHEMA_FILE = "schemas/feature_extraction.schema.json"
+_BANK_TRANSACTION_SUBSCHEMA = "bank_transaction"
+
+
+class BankTransactionFeatureExtractionService:
+    """Per-transaction feature extraction for normalised bank transactions."""
+
+    def __init__(
+        self,
+        app_config: AppConfig,
+        calendar: WorkingDayCalendar,
+        *,
+        region: str = "EnglandAndWales",
+        config: FeatureExtractionConfig | None = None,
+        description_signals: DescriptionSignalConfig | None = None,
+        schema_checker: SchemaCheckService | None = None,
+        channel_detector: PaymentChannelDetector | None = None,
+        description_extractor: DescriptionFeatureExtractor | None = None,
+    ) -> None:
+        self._app_config = app_config
+        self._calendar = calendar
+        self._region = region
+        self._config = config or load_feature_extraction_config()
+        if description_signals is None:
+            description_signals = DescriptionSignalConfig.from_tiered_mapping(
+                app_config.salary_hints_keywords(),
+                app_config.negative_signals(),
+            )
+        self._description_signals = description_signals
+        self._schema_checker = schema_checker or SchemaCheckService.from_resource(
+            _FEATURE_EXTRACTION_SCHEMA_PACKAGE,
+            _FEATURE_EXTRACTION_SCHEMA_FILE,
+            config=SchemaCheckConfig(
+                enabled=self._config.schema_validation.enabled,
+                strict=self._config.schema_validation.strict,
+            ),
+        )
+        self._channel_detector = channel_detector or PaymentChannelDetector(
+            app_config=app_config,
+            feature_config=self._config,
+        )
+        self._description_extractor = description_extractor or DescriptionFeatureExtractor(
+            app_config=app_config,
+            feature_config=self._config,
+            description_signals=self._description_signals,
+        )
+
+    @property
+    def config(self) -> FeatureExtractionConfig:
+        return self._config
+
+    @property
+    def schema_checker(self) -> SchemaCheckService:
+        return self._schema_checker
+
+    def extract_bank_transaction(
+        self,
+        transaction: BankTransaction,
+    ) -> FeatureExtractionResult:
+        payload, txn_id = self._payload_and_id(transaction)
+        check = self._schema_checker.check(
+            payload,
+            subschema=_BANK_TRANSACTION_SUBSCHEMA,
+            transaction_id=txn_id,
+        )
+        if not check.valid:
+            return FeatureExtractionResult(
+                transaction=transaction,
+                warnings=check.warnings,
+            )
+        return FeatureExtractionResult(
+            transaction=self._extract_resolved(transaction),
+            warnings=check.warnings,
+        )
+
+    def extract_bank_transactions(
+        self,
+        transactions: Iterable[BankTransaction],
+    ) -> FeatureExtractionBatchResult:
+        materialised = list(transactions)
+        warnings: list = []
+        resolved: list[BankTransaction] = []
+
+        for transaction in materialised:
+            payload, txn_id = self._payload_and_id(transaction)
+            check = self._schema_checker.check(
+                payload,
+                subschema=_BANK_TRANSACTION_SUBSCHEMA,
+                transaction_id=txn_id,
+            )
+            if not check.valid:
+                warnings.extend(check.warnings)
+                continue
+            resolved.append(self._extract_resolved(transaction))
+            warnings.extend(check.warnings)
+
+        return FeatureExtractionBatchResult(
+            transactions=tuple(resolved),
+            warnings=tuple(warnings),
+        )
+
+    def _extract_resolved(self, txn: BankTransaction) -> BankTransaction:
+        channel = self._channel_detector.detect(txn.description_tokens)
+        desc = self._description_extractor.extract(txn.description_tokens)
+        d = txn.date
+
+        is_lwd = d == self._calendar.last_working_day_of_month(d.year, d.month, self._region)
+        is_fwd = d == self._calendar.first_working_day_of_month(d.year, d.month, self._region)
+        last_day = monthrange(d.year, d.month)[1]
+        is_month_end = d.day == last_day
+        is_bh_adjacent = self._is_bank_holiday_adjacent(d)
+
+        features = TransactionFeatures(
+            transaction_id=txn.id,
+            payment_channel=channel.channel,
+            payment_channel_confidence=channel.confidence,
+            payment_channel_matched_tokens=channel.matched_tokens,
+            salary_hint_tokens=desc.salary_hint_tokens,
+            negative_tokens=desc.negative_tokens,
+            possible_employer_tokens=desc.possible_employer_tokens,
+            day_of_month=d.day,
+            weekday=d.weekday(),
+            is_month_end=is_month_end,
+            is_last_working_day=is_lwd,
+            is_first_working_day=is_fwd,
+            is_bank_holiday_adjacent=is_bh_adjacent,
+            is_anchor=False,
+            anchor_hint_id=None,
+            ambiguous_anchor=False,
+        )
+        return replace(txn, features=features)
+
+    def _is_bank_holiday_adjacent(self, d: date) -> bool:
+        for delta in (-1, 1):
+            neighbour = d + timedelta(days=delta)
+            if (
+                not self._calendar.is_working_day(neighbour, self._region)
+                and neighbour.weekday() < 5
+            ):
+                return True
+        return False
+
+    @staticmethod
+    def _payload_and_id(transaction: BankTransaction) -> tuple[dict[str, Any], str]:
+        return (
+            {
+                "id": transaction.id,
+                "date": transaction.date.isoformat(),
+                "amount": float(transaction.amount),
+                "description_tokens": list(transaction.description_tokens),
+                "normalised_description": transaction.normalised_description,
+                "skeleton": transaction.skeleton,
+            },
+            transaction.id,
+        )
+
+
+def default_service(
+    app_config: AppConfig,
+    calendar: WorkingDayCalendar,
+    *,
+    region: str = "EnglandAndWales",
+    description_signals: DescriptionSignalConfig | None = None,
+) -> BankTransactionFeatureExtractionService:
+    return BankTransactionFeatureExtractionService(
+        app_config,
+        calendar,
+        region=region,
+        description_signals=description_signals,
+    )
+
+
+FeatureExtractionValidationError = SchemaValidationError
+
+__all__ = [
+    "BankTransactionFeatureExtractionService",
+    "FeatureExtractionValidationError",
+    "default_service",
+]
