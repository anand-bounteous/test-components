+"""Validate merged config dicts against ``config.schema.json`` (tests only)."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from jsonschema import Draft202012Validator
+from nw_aglib_toolkit.pipeline.config import ConfigLoadError
+
+_SCHEMA_PATH = (
+    Path(__file__).resolve().parents[3]
+    / "agents/core/bank-transactions/tests/schemas/config.schema.json"
+)
+_VALIDATOR: Draft202012Validator | None = None
+
+
+def config_schema_path() -> Path:
+    return _SCHEMA_PATH
+
+
+def config_validator() -> Draft202012Validator:
+    global _VALIDATOR
+    if _VALIDATOR is None:
+        schema = json.loads(_SCHEMA_PATH.read_text())
+        Draft202012Validator.check_schema(schema)
+        _VALIDATOR = Draft202012Validator(schema)
+    return _VALIDATOR
+
+
+def validate_merged_config(data: dict) -> None:
+    errors = sorted(config_validator().iter_errors(data), key=lambda e: list(e.path))
+    if not errors:
+        return
+    first = errors[0]
+    raise ConfigLoadError(
+        f"merged config failed schema validation at {list(first.path)}: {first.message}"
+    )
+
+
+__all__ = ["config_schema_path", "config_validator", "validate_merged_config"]
