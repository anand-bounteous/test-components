+"""Convert rent requests for shared validation and map warnings."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import RawBankTransaction
+from nw_agcore_bank_transactions.pipeline._models.requests import (
+    BankTransactionRequest,
+    TransactionsRange,
+)
+from nw_agcore_bank_transactions.pipeline._models.results import ValidationWarning
+from nw_agcore_bank_transactions.pipeline.hints.HintInputsParsing import (
+    hint_inputs_from_mapping,
+    normalize_hint_inputs_payload,
+)
+from nw_core.validation import ValidationWarning as CoreValidationWarning
+
+
+def _raw_transaction_from_mapping(row: Mapping[str, Any]) -> RawBankTransaction:
+    return RawBankTransaction(
+        id=str(row.get("id", "")),
+        date=str(row.get("date", "")),
+        description=str(row.get("description", "")),
+        debit_amount=row.get("debit_amount", 0),
+        credit_amount=row.get("credit_amount", 0),
+        balance=row.get("balance"),
+        reference=row.get("reference"),
+        page=row.get("page"),
+        line=row.get("line"),
+        is_brought_forward=bool(row.get("is_brought_forward", False)),
+        is_final_balance=bool(row.get("is_final_balance", False)),
+    )
+
+
+def to_validation_payload(request: BankTransactionRequest) -> BankTransactionRequest:
+    return BankTransactionRequest(
+        analysis_id=request.analysis_id,
+        transactions=request.transactions,
+        jurisdiction=request.jurisdiction,
+        country_region=request.country_region,
+        source_bank=request.source_bank,
+        validation_mode=request.validation_mode,
+        hint_inputs=request.hint_inputs,
+        transactions_range=request.transactions_range,
+    )
+
+
+def rent_warning_from_salary(warning: CoreValidationWarning) -> ValidationWarning:
+    return ValidationWarning(
+        code=warning.code,
+        transaction_id=warning.transaction_id or None,
+        detail=warning.detail,
+    )
+
+
+def rent_request_from_mapping(data: Mapping[str, Any]) -> BankTransactionRequest:
+    raw_rows = data.get("transactions") or []
+    transactions = tuple(_raw_transaction_from_mapping(row) for row in raw_rows)
+    tr = data.get("transactions_range")
+    transactions_range = None
+    if tr is not None:
+        transactions_range = TransactionsRange(
+            start=tr.get("start") or tr.get("from"),
+            end=tr.get("end") or tr.get("to"),
+        )
+    return BankTransactionRequest(
+        analysis_id=str(data.get("analysis_id", "rent_analysis")),
+        transactions=transactions,
+        jurisdiction=str(data.get("jurisdiction", "GB")),
+        country_region=str(data["country_region"]) if "country_region" in data else None,
+        source_bank=data.get("source_bank"),
+        validation_mode=str(data.get("validation_mode", "lenient")),
+        hint_inputs=hint_inputs_from_mapping(normalize_hint_inputs_payload(data)),
+        transactions_range=transactions_range,
+    )
