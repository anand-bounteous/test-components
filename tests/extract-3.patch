+"""Candidate ranking and near-miss tagging."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass, replace
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+
+from .._models import CandidateSet
+
+
+@dataclass(frozen=True)
+class RankingConfig:
+    return_threshold: float
+    max_candidates: int
+    max_near_misses: int
+
+
+def resolve_ranking_config(
+    config: AppConfig,
+    *,
+    return_threshold: float | None = None,
+    max_candidates: int | None = None,
+    max_near_misses: int | None = None,
+) -> RankingConfig:
+    cg = config.candidate_generation()
+    effective_return_threshold = (
+        float(return_threshold)
+        if return_threshold is not None
+        else float(config.get("thresholds", "return_threshold", default=0.40))
+    )
+    effective_max_candidates = (
+        int(max_candidates)
+        if max_candidates is not None
+        else int(cg.get("max_candidates_to_return", 10))
+    )
+    effective_max_near_misses = (
+        int(max_near_misses) if max_near_misses is not None else int(cg.get("max_near_misses", 10))
+    )
+    return RankingConfig(
+        return_threshold=effective_return_threshold,
+        max_candidates=effective_max_candidates,
+        max_near_misses=effective_max_near_misses,
+    )
+
+
+def tag_near_miss(candidate: CandidateSet, reason: str) -> CandidateSet:
+    """Return a copy with ``metadata.near_miss_reason`` set."""
+    new_meta = dict(candidate.metadata)
+    new_meta["near_miss_reason"] = reason
+    return replace(candidate, metadata=new_meta)
+
+
+def rank_candidates(
+    scored: Sequence[CandidateSet],
+    ranking: RankingConfig,
+) -> tuple[list[CandidateSet], list[CandidateSet], RankingConfig]:
+    """Sort, threshold, cap, and split into returned candidates and near-misses."""
+    ordered = sorted(scored, key=lambda c: (-c.confidence, c.candidate_set_id))
+
+    above = [c for c in ordered if c.confidence >= ranking.return_threshold]
+    below = [c for c in ordered if c.confidence < ranking.return_threshold]
+
+    returned = above[: ranking.max_candidates]
+    cap_overflow = above[ranking.max_candidates :]
+    remaining_near_miss_slots = max(0, ranking.max_near_misses - len(cap_overflow))
+    below_kept = below[:remaining_near_miss_slots]
+
+    near_misses_combined = [tag_near_miss(c, "cap_overflow") for c in cap_overflow]
+    near_misses_combined.extend(tag_near_miss(c, "below_threshold") for c in below_kept)
+    near_misses_combined = near_misses_combined[: ranking.max_near_misses]
+
+    return returned, near_misses_combined, ranking
+
+
+__all__ = [
+    "RankingConfig",
+    "rank_candidates",
+    "resolve_ranking_config",
+    "tag_near_miss",
+]
