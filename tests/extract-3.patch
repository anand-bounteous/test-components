+export const SOLUTION_NAMES = [
+  "native_pymupdf",
+  "native_pdfplumber",
+  "doctr_baseline",
+  "img2table_doctr",
+] as const;
+
+export type SolutionName = (typeof SOLUTION_NAMES)[number];
+
+export type RunSummary = {
+  runId: string;
+  status: string;
+  startedAt: string | null;
+  completed: string[];
+};
+
+export type RunManifest = {
+  run_id: string;
+  status: string;
+  started_at?: string;
+  finished_at?: string;
+  completed?: string[];
+  document?: {
+    filename?: string;
+    n_pages?: number;
+    pdf_kind?: string;
+  };
+  solution_status?: Record<
+    string,
+    {
+      state?: string;
+      result_status?: string;
+      duration_ms?: number;
+      overall_confidence?: number;
+      error?: string | null;
+    }
+  >;
+};
+
+export type BackendPage = {
+  page_index: number;
+  width: number;
+  height: number;
+  dpi: number;
+  regions: Array<{
+    id: string;
+    type: string;
+    bbox: {
+      x: number;
+      y: number;
+      w: number;
+      h: number;
+      page_index: number;
+      coord_space: string;
+    };
+    text: string;
+    confidence: number;
+    source_tool: string;
+    attributes?: Record<string, unknown>;
+  }>;
+  tables: Array<{
+    region_id?: string;
+    n_rows: number;
+    n_cols: number;
+    border_mode: string;
+    cells: Array<{
+      row: number;
+      col: number;
+      text: string;
+      bbox?: BackendPage["regions"][number]["bbox"];
+      multiline?: boolean;
+    }>;
+  }>;
+  full_text?: string;
+  page_image_ref?: string;
+};
+
+export type ExtractorResultJson = {
+  solution_name?: string;
+  extractor_name?: string;
+  status: string;
+  pages: BackendPage[];
+};
+
+export type AuditJson = {
+  extractor_name: string;
+  audit: unknown[];
+  timings?: {
+    total_ms?: number;
+    by_stage?: Record<string, number>;
+  };
+};
