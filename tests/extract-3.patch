+"""Hint application tool configuration."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from importlib import resources
+
+import yaml
+
+from .SchemaValidationSettings import SchemaValidationSettings
+
+_HINTS_PACKAGE = "nw_agcore_bank_transactions.pipeline.hints"
+
+
+class HintConfigError(ValueError):
+    """Raised when hint_config.yaml cannot be loaded or parsed."""
+
+
+@dataclass(frozen=True)
+class EmployerBonusSettings:
+    max_current_bonus: float
+    max_previous_bonus: float
+    partial_hit_weight: float
+
+
+@dataclass(frozen=True)
+class BandModifierSettings:
+    floor: float
+
+
+@dataclass(frozen=True)
+class HintConfig:
+    schema_validation: SchemaValidationSettings
+    default_tolerance_pct: float
+    month_pattern: re.Pattern[str]
+    employer_hint_stop_tokens: frozenset[str]
+    min_partial_match_chars: int
+    min_employer_token_length: int
+    employer_bonus: EmployerBonusSettings
+    band_modifier: BandModifierSettings
+
+
+def _default_config_path() -> str:
+    return str(resources.files(_HINTS_PACKAGE) / "config" / "hint_config.yaml")
+
+
+def _require_mapping(raw: Mapping[str, object], key: str) -> Mapping[str, object]:
+    value = raw.get(key)
+    if not isinstance(value, Mapping):
+        raise HintConfigError(f"{key} must be a mapping")
+    return value
+
+
+def _require_string_list(raw: Mapping[str, object], key: str) -> list[str]:
+    value = raw.get(key)
+    if not isinstance(value, list) or not value:
+        raise HintConfigError(f"{key} must be a non-empty list")
+    out: list[str] = []
+    for item in value:
+        if not isinstance(item, str) or not item.strip():
+            raise HintConfigError(f"{key} entries must be non-empty strings")
+        out.append(item.strip())
+    return out
+
+
+def _require_positive_int(raw: Mapping[str, object], key: str) -> int:
+    value = raw.get(key)
+    if not isinstance(value, int) or value < 1:
+        raise HintConfigError(f"{key} must be a positive integer")
+    return value
+
+
+def _require_float(raw: Mapping[str, object], key: str) -> float:
+    value = raw.get(key)
+    if not isinstance(value, (int, float)):
+        raise HintConfigError(f"{key} must be a number")
+    return float(value)
+
+
+def load_hint_config(config_path: str | None = None) -> HintConfig:
+    path = config_path or _default_config_path()
+    try:
+        raw = yaml.safe_load(open(path, encoding="utf-8"))
+    except OSError as exc:
+        raise HintConfigError(f"unable to read hint config: {path}") from exc
+    except yaml.YAMLError as exc:
+        raise HintConfigError(f"invalid YAML in hint config: {path}") from exc
+
+    if not isinstance(raw, Mapping):
+        raise HintConfigError("hint config root must be a mapping")
+
+    schema_validation_raw = raw.get("schema_validation", {})
+    if not isinstance(schema_validation_raw, Mapping):
+        raise HintConfigError("schema_validation must be a mapping")
+    enabled = schema_validation_raw.get("enabled", True)
+    strict = schema_validation_raw.get("strict", True)
+    if not isinstance(enabled, bool):
+        raise HintConfigError("schema_validation.enabled must be a boolean")
+    if not isinstance(strict, bool):
+        raise HintConfigError("schema_validation.strict must be a boolean")
+
+    default_tolerance_pct = _require_float(raw, "default_tolerance_pct")
+    if not 0.0 <= default_tolerance_pct <= 1.0:
+        raise HintConfigError("default_tolerance_pct must be in [0, 1]")
+
+    month_pattern_raw = raw.get("month_pattern")
+    if not isinstance(month_pattern_raw, str) or not month_pattern_raw.strip():
+        raise HintConfigError("month_pattern must be a non-empty string")
+    try:
+        month_pattern = re.compile(month_pattern_raw)
+    except re.error as exc:
+        raise HintConfigError("month_pattern is not a valid regex") from exc
+
+    employer_bonus_raw = _require_mapping(raw, "employer_bonus")
+    band_modifier_raw = _require_mapping(raw, "band_modifier")
+
+    return HintConfig(
+        schema_validation=SchemaValidationSettings(enabled=enabled, strict=strict),
+        default_tolerance_pct=default_tolerance_pct,
+        month_pattern=month_pattern,
+        employer_hint_stop_tokens=frozenset(_require_string_list(raw, "employer_hint_stop_tokens")),
+        min_partial_match_chars=_require_positive_int(raw, "min_partial_match_chars"),
+        min_employer_token_length=_require_positive_int(raw, "min_employer_token_length"),
+        employer_bonus=EmployerBonusSettings(
+            max_current_bonus=_require_float(employer_bonus_raw, "max_current_bonus"),
+            max_previous_bonus=_require_float(employer_bonus_raw, "max_previous_bonus"),
+            partial_hit_weight=_require_float(employer_bonus_raw, "partial_hit_weight"),
+        ),
+        band_modifier=BandModifierSettings(
+            floor=_require_float(band_modifier_raw, "floor"),
+        ),
+    )
