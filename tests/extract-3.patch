+    instance_registry = ToolRegistry()
+    from nw_aglib_toolkit.channels.tools.ToolDiscovery import instantiate_and_register_tools
+
+    instantiate_and_register_tools(instance_registry, [SampleTools])
+
+    names = registry.names() + instance_registry.names()
+    assert "module_echo" in names
+    assert "sample_echo" in names
