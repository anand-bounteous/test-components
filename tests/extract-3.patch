+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { AnnotationToolbar } from "../../src/components/AnnotationToolbar";
+import { sampleStatement } from "../../src/fixtures/sampleStatement";
+
+afterEach(() => {
+  cleanup();
+});
+
+describe("AnnotationToolbar", () => {
+  it("toggles kind visibility", () => {
+    const onHiddenKindsChange = vi.fn();
+    render(
+      <AnnotationToolbar
+        annotations={sampleStatement.annotations}
+        hiddenKinds={new Set()}
+        onHiddenKindsChange={onHiddenKindsChange}
+        onAnnotationsChange={vi.fn()}
+      />,
+    );
+
+    fireEvent.click(screen.getByLabelText("Tables"));
+    expect(onHiddenKindsChange).toHaveBeenCalled();
+    const nextKinds = onHiddenKindsChange.mock.calls[0]![0] as Set<string>;
+    expect(nextKinds.has("table")).toBe(true);
+  });
+
+  it("removes selected annotation", () => {
+    const onAnnotationsChange = vi.fn();
+    render(
+      <AnnotationToolbar
+        annotations={sampleStatement.annotations}
+        hiddenKinds={new Set()}
+        onHiddenKindsChange={vi.fn()}
+        onAnnotationsChange={onAnnotationsChange}
+        selectedAnnotationId="logo-0"
+      />,
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: "Remove selected" }));
+    expect(onAnnotationsChange).toHaveBeenCalled();
+    const next = onAnnotationsChange.mock.calls[0]![0];
+    const hidden = next.find((annotation: { id: string }) => annotation.id === "logo-0");
+    expect(hidden?.hidden).toBe(true);
+  });
+
+  it("restores all removed annotations", () => {
+    const hiddenAnnotations = sampleStatement.annotations.map((annotation) =>
+      annotation.id === "logo-0" ? { ...annotation, hidden: true } : annotation,
+    );
+    const onAnnotationsChange = vi.fn();
+    const onHiddenKindsChange = vi.fn();
+
+    render(
+      <AnnotationToolbar
+        annotations={hiddenAnnotations}
+        hiddenKinds={new Set(["table"])}
+        onHiddenKindsChange={onHiddenKindsChange}
+        onAnnotationsChange={onAnnotationsChange}
+      />,
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: "Restore removed" }));
+    expect(onAnnotationsChange).toHaveBeenCalled();
+    expect(onHiddenKindsChange).toHaveBeenCalledWith(new Set());
+  });
+});
