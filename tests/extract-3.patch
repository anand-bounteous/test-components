+@dataclass(frozen=True)
+class PayslipHint:
+    """A single payslip anchor — FR-016."""
+
+    month: str
+    amount: Decimal
+    hint_id: str = ""
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.month, str):
+            raise ValueError(f"month must be YYYY-MM, got {self.month!r}")
+        object.__setattr__(self, "amount", coerce_decimal(self.amount, "amount"))
+        if not self.hint_id:
+            object.__setattr__(self, "hint_id", f"hint_{self.month}_{self.amount}")
+        from .HintConfig import load_hint_config
+
+        self.validate_month(load_hint_config().month_pattern)
+
+    def validate_month(self, month_pattern: re.Pattern[str]) -> None:
+        if not month_pattern.match(self.month):
+            raise ValueError(f"month must be YYYY-MM, got {self.month!r}")
