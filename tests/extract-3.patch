+"""Domain keyword scoring helpers."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+
+
+def gift_keyword_score(description: str, positive: Sequence[str], negative: Sequence[str]) -> float:
+    upper = description.upper()
+    for phrase in negative:
+        if phrase in upper:
+            return 0.0
+    hits = sum(1 for kw in positive if kw in upper)
+    if hits == 0:
+        return 0.0
+    return min(1.0, hits / 2.0)
+
+
+def rent_keyword_score(description: str, positive: Iterable[str], negative: Iterable[str]) -> float:
+    upper = description.upper()
+    for phrase in negative:
+        if phrase in upper:
+            return 0.0
+    hits = sum(1 for kw in positive if kw in upper)
+    if hits == 0:
+        return 0.0
+    return min(1.0, hits / 2.0)
+
+
+def sale_keyword_score(description: str, positive: Sequence[str], negative: Sequence[str]) -> float:
+    upper = description.upper()
+    for phrase in negative:
+        if phrase in upper:
+            return 0.0
+    hits = sum(1 for kw in positive if kw in upper)
+    if hits == 0:
+        return 0.0
+    return min(1.0, hits / 2.0)
