--- components-empty-1/pyproject.toml	1970-01-01 05:30:00
+++ agents-components/pyproject.toml	2026-07-10 10:20:21
@@ -0,0 +1,94 @@
+[project]
+name = "nwrepo"
+version = "0.1.0"
+description = "Agentic Tools Monorepo"
+requires-python = ">=3.12"
+dependencies = []
+
+[dependency-groups]
+agents = [
+    "nw-aglib-toolkit",
+    "nw-agcore-bank-transactions",
+    "nw-agcore-document-data-extractor",
+    "nw-agbus-salary-extractor",
+    "nw-agbus-rent-extractor",
+    "nw-agbus-gift-extractor",
+    "nw-agbus-property-sale-extractor",
+]
+dev = [
+    "nw-common-tests",
+    "nw-core",
+    { include-group = "agents" },
+    "ruff>=0.8.0",
+    "pytest>=8.0.0",
+    "faker>=24.0.0",
+    "pytest-asyncio>=0.24.0",
+    "httpx>=0.27.0",
+    "websockets>=13.0",
+]
+
+# Root is a uv workspace hub only — not a real distributable.
+# Prefer: `./scripts/bootstrap.sh` or `uv sync --all-packages`
+# If you run `pip install -e .`, setuptools must not auto-discover monorepo dirs.
+[build-system]
+requires = ["setuptools>=61"]
+build-backend = "setuptools.build_meta"
+
+[tool.setuptools]
+packages = []
+
+[tool.uv]
+package = false
+# python-doctr pulls opencv-python; img2table needs opencv-contrib-python (niBlackThreshold).
+# Both install the same cv2 module — exclude the non-contrib wheel.
+override-dependencies = ["opencv-python; sys_platform == 'never'"]
+
+[tool.uv.workspace]
+members = [
+    "libs/common/core",
+    "libs/agents/toolkit",
+    "tests",
+    "agents/core/bank-transactions",
+    "agents/core/document-data-extractor",
+    "agents/business/salary-extractor",
+    "agents/business/rent-extractor",
+    "agents/business/gift-extractor",
+    "agents/business/property-sale-extractor",
+    "apps/_template/api",
+]
+
+[tool.pytest.ini_options]
+markers = [
+    "unit: isolated unit tests",
+    "feature: end-to-end scenario fixture tests (one YAML file = one test case)",
+    "smoke: fast confidence checks (subset of feature/e2e)",
+    "regression: broader regression coverage",
+    "e2e: end-to-end integration tests requiring running services",
+    "benchmark: long-running regression gates",
+    "realworld: real-world YAML scenario tests",
+]
+testpaths = []
+asyncio_mode = "auto"
+addopts = "--import-mode=importlib"
+pythonpath = ["."]
+
+[tool.ruff]
+line-length = 100
+target-version = "py312"
+
+[tool.ruff.lint]
+select = ["E", "F", "I", "UP"]
+
+[tool.ruff.lint.per-file-ignores]
+"**/tests/**" = ["E501"]
+
+[tool.uv.sources]
+nw-common-tests = { workspace = true }
+nw-core = { workspace = true }
+nw-aglib-toolkit = { workspace = true }
+nw-agcore-bank-transactions = { workspace = true }
+nw-agcore-document-data-extractor = { workspace = true }
+nw-agbus-salary-extractor = { workspace = true }
+nw-agbus-rent-extractor = { workspace = true }
+nw-agbus-gift-extractor = { workspace = true }
+nw-agbus-property-sale-extractor = { workspace = true }
