+"""Public tool entry point for gift detection."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+from nw_agbus_gift_extractor.services import (
+    BankTransactionRequest,
+    BankTransactionResult,
+)
+from nw_agbus_gift_extractor.services.GiftTransactionExtractorService import (
+    GiftTransactionExtractorService,
+)
+from nw_aglib_toolkit.channels.tools import tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.logging import AddCallContext, LogFn, setup_trace
+
+setup_trace()
+
+logger = logging.getLogger(__name__)
+
+_default_tool: GiftTransactionExtractorTools | None = None
+
+
+def _tool() -> GiftTransactionExtractorTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = GiftTransactionExtractorTools()
+    return _default_tool
+
+
+class GiftTransactionExtractorTools:
+    phase_name = "gift_extractor"
+
+    def __init__(self, logger_: logging.Logger | None = None) -> None:
+        self._logger = logger_ or logger
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def run(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+    ) -> BankTransactionResult:
+        service = GiftTransactionExtractorService(config=config, calendar=calendar)
+        return service.detect(
+            payload,
+            mode=mode,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            include_audit=include_audit,
+        )
+
+    def build_input_summary(
+        self,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "analysis_id": payload.analysis_id,
+            "row_count": len(payload.transactions),
+            "validation_mode": kwargs.get("mode") or payload.validation_mode,
+            "hint_amount": (
+                str(payload.hint_inputs.gift_hints.amount)
+                if payload.hint_inputs.gift_hints and payload.hint_inputs.gift_hints.amount
+                else None
+            ),
+        }
+
+    def build_output_summary(
+        self,
+        result: BankTransactionResult,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "candidates": len(result.candidate_sets),
+            "near_misses": len(result.rejected_or_near_miss_sets),
+            "warnings": len(result.warnings),
+        }
+
+
+@tool(
+    name="detect_gift_candidates",
+    description="Detect incoming monetary gift credits from a recipient bank statement.",
+    category="banking.gift",
+    tags=["banking", "gift", "transactions"],
+)
+def detect_gift_candidates(
+    payload: BankTransactionRequest,
+    *,
+    config: AppConfig | None = None,
+    calendar: WorkingDayCalendar | None = None,
+    mode: str | None = None,
+    max_candidates: int | None = None,
+    max_near_misses: int | None = None,
+    return_threshold: float | None = None,
+    include_audit: bool = False,
+) -> BankTransactionResult:
+    """Detect incoming monetary gift credits from a recipient bank statement."""
+    return _tool().run(
+        payload,
+        config=config,
+        calendar=calendar,
+        mode=mode,
+        max_candidates=max_candidates,
+        max_near_misses=max_near_misses,
+        return_threshold=return_threshold,
+        include_audit=include_audit,
+    )
+
+
+__all__ = [
+    "GiftTransactionExtractorTools",
+    "detect_gift_candidates",
+]
