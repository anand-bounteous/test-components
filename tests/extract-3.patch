+import { useMemo } from "react";
+import type { AnnotationKind, PageAnnotation } from "../../types";
+import { kindLabels } from "../../styles/annotationColors";
+import { panelStyles } from "../../styles/shared";
+
+export type AnnotationToolbarProps = {
+  annotations: PageAnnotation[];
+  hiddenKinds: Set<AnnotationKind>;
+  onHiddenKindsChange: (kinds: Set<AnnotationKind>) => void;
+  onAnnotationsChange: (annotations: PageAnnotation[]) => void;
+  selectedAnnotationId?: string | null;
+};
+
+const ALL_KINDS: AnnotationKind[] = [
+  "table",
+  "cell",
+  "text",
+  "image",
+  "logo",
+  "layout",
+  "signature",
+];
+
+export function AnnotationToolbar({
+  annotations,
+  hiddenKinds,
+  onHiddenKindsChange,
+  onAnnotationsChange,
+  selectedAnnotationId,
+}: AnnotationToolbarProps) {
+  const presentKinds = useMemo(() => {
+    const kinds = new Set<AnnotationKind>();
+    for (const annotation of annotations) {
+      if (!annotation.hidden) {
+        kinds.add(annotation.kind);
+      }
+    }
+    return ALL_KINDS.filter((kind) => kinds.has(kind));
+  }, [annotations]);
+
+  const toggleKind = (kind: AnnotationKind) => {
+    const next = new Set(hiddenKinds);
+    if (next.has(kind)) {
+      next.delete(kind);
+    } else {
+      next.add(kind);
+    }
+    onHiddenKindsChange(next);
+  };
+
+  const hideAllKinds = () => {
+    onHiddenKindsChange(new Set(ALL_KINDS));
+  };
+
+  const showAllKinds = () => {
+    onHiddenKindsChange(new Set());
+  };
+
+  const removeSelected = () => {
+    if (!selectedAnnotationId) return;
+    onAnnotationsChange(
+      annotations.map((annotation) =>
+        annotation.id === selectedAnnotationId
+          ? { ...annotation, hidden: true }
+          : annotation,
+      ),
+    );
+  };
+
+  const restoreAll = () => {
+    onAnnotationsChange(
+      annotations.map((annotation) => ({ ...annotation, hidden: false })),
+    );
+    onHiddenKindsChange(new Set());
+  };
+
+  return (
+    <div style={panelStyles.toolbar} data-testid="annotation-toolbar">
+      <span style={{ fontSize: "13px", fontWeight: 600 }}>Annotations</span>
+      {presentKinds.map((kind) => (
+        <label key={kind} style={panelStyles.checkboxLabel}>
+          <input
+            type="checkbox"
+            checked={!hiddenKinds.has(kind)}
+            onChange={() => toggleKind(kind)}
+          />
+          {kindLabels[kind]}
+        </label>
+      ))}
+      <button type="button" style={panelStyles.button} onClick={showAllKinds}>
+        Show all
+      </button>
+      <button type="button" style={panelStyles.button} onClick={hideAllKinds}>
+        Hide all
+      </button>
+      <button
+        type="button"
+        style={panelStyles.button}
+        onClick={removeSelected}
+        disabled={!selectedAnnotationId}
+      >
+        Remove selected
+      </button>
+      <button type="button" style={panelStyles.button} onClick={restoreAll}>
+        Restore removed
+      </button>
+    </div>
+  );
+}
