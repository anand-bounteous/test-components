+"""SchemaCheckService — shared JSON-schema validation."""
+
+from __future__ import annotations
+
+import pytest
+from nw_core.validation import ValidationWarning
+from nw_core.validation.schema import (
+    SchemaCheckConfig,
+    SchemaCheckService,
+    SchemaValidationError,
+)
+
+
+def _schema() -> dict:
+    return {
+        "$defs": {
+            "item": {
+                "type": "object",
+                "required": ["id", "value"],
+                "additionalProperties": False,
+                "properties": {
+                    "id": {"type": "string", "minLength": 1},
+                    "value": {"type": "number"},
+                },
+            }
+        }
+    }
+
+
+def test_disabled_validation_skips_checks():
+    svc = SchemaCheckService(_schema(), config=SchemaCheckConfig(enabled=False, strict=True))
+    result = svc.check({"id": ""}, subschema="item")
+    assert result.valid
+    assert result.warnings == ()
+
+
+def test_strict_mode_raises_on_first_error():
+    svc = SchemaCheckService(_schema(), config=SchemaCheckConfig(enabled=True, strict=True))
+    with pytest.raises(SchemaValidationError, match="schema validation failed"):
+        svc.check({"id": "t1"}, subschema="item")
+
+
+def test_lenient_mode_returns_warnings():
+    svc = SchemaCheckService(_schema(), config=SchemaCheckConfig(enabled=True, strict=False))
+    result = svc.check({"id": "t1"}, subschema="item")
+    assert not result.valid
+    assert len(result.warnings) == 1
+    assert isinstance(result.warnings[0], ValidationWarning)
+    assert result.warnings[0].code == "schema_violation"
+    assert result.warnings[0].transaction_id == "t1"
+
+
+def test_from_resource_loads_normalization_schema():
+    svc = SchemaCheckService.from_resource(
+        "nw_agcore_bank_transactions.pipeline.normalization",
+        "schemas/normalization.schema.json",
+    )
+    result = svc.check(
+        {
+            "id": "t01",
+            "date": "2024-01-31",
+            "description": "ACME PAYROLL",
+            "debit_amount": 0,
+            "credit_amount": 100.0,
+        },
+        subschema="bank_transaction",
+        transaction_id="t01",
+    )
+    assert result.valid
