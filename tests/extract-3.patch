+"""Amount cluster statistics used by skeleton grouping and classification."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    cluster_stats,
+    round_two_dp,
+)
+
+
+def test_round_two_dp_half_up():
+    assert round_two_dp(Decimal("2450.325")) == Decimal("2450.33")
+
+
+def test_round_two_dp_no_change_when_already_two_dp():
+    assert round_two_dp(Decimal("2450.32")) == Decimal("2450.32")
+
+
+def test_cluster_stats_for_perfectly_stable_amounts():
+    amounts = [Decimal("2450.00")] * 6
+    s = cluster_stats(amounts)
+    assert s.count == 6
+    assert s.coefficient_of_variation == 0.0
+    assert s.median_amount == Decimal("2450.00")
+
+
+def test_cluster_stats_for_variable_amounts():
+    amounts = [Decimal("2400"), Decimal("2500"), Decimal("2450"), Decimal("2550")]
+    s = cluster_stats(amounts)
+    assert s.count == 4
+    assert s.coefficient_of_variation > 0.0
+
+
+def test_cluster_stats_rejects_empty_input():
+    with pytest.raises(ValueError, match="cluster_stats requires at least one amount"):
+        cluster_stats([])
+
+
+def test_cluster_stats_with_a_single_amount():
+    s = cluster_stats([Decimal("2450.00")])
+    assert s.count == 1
+    assert s.coefficient_of_variation == 0.0
+
+
+def test_cluster_stats_uses_absolute_values():
+    s = cluster_stats([Decimal("2450"), Decimal("-2450")])
+    assert s.coefficient_of_variation == 0.0
