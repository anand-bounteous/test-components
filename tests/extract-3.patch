+"""Bank transaction text normalisation service — Design §6.1, §8.1, §10.5."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Iterable, Mapping
+from dataclasses import is_dataclass
+from decimal import Decimal
+from typing import Any
+
+from nw_core.validation import ValidationWarning
+from nw_core.validation.schema import (
+    SchemaCheckConfig,
+    SchemaCheckService,
+    SchemaValidationError,
+)
+
+from .._models import BankTransaction, RawBankTransaction
+from .models import (
+    NormalizationBatchResult,
+    NormalizationConfig,
+    NormalizationResult,
+    load_normalization_config,
+)
+
+_NORMALIZATION_SCHEMA_PACKAGE = "nw_agcore_bank_transactions.pipeline.normalization"
+_NORMALIZATION_SCHEMA_FILE = "schemas/normalization.schema.json"
+_BANK_TRANSACTION_SUBSCHEMA = "bank_transaction"
+
+
+class BankTransactionNormalizationService:
+    """Deterministic bank-transaction description normalisation."""
+
+    def __init__(
+        self,
+        config: NormalizationConfig | None = None,
+        *,
+        schema_checker: SchemaCheckService | None = None,
+    ) -> None:
+        self._config = config or load_normalization_config()
+        self._schema_checker = schema_checker or SchemaCheckService.from_resource(
+            _NORMALIZATION_SCHEMA_PACKAGE,
+            _NORMALIZATION_SCHEMA_FILE,
+            config=SchemaCheckConfig(
+                enabled=self._config.schema_validation.enabled,
+                strict=self._config.schema_validation.strict,
+            ),
+        )
+
+    @property
+    def config(self) -> NormalizationConfig:
+        return self._config
+
+    @property
+    def schema_checker(self) -> SchemaCheckService:
+        return self._schema_checker
+
+    def normalise_text(self, raw: str) -> str:
+        if not raw:
+            return ""
+        decomposed = unicodedata.normalize("NFKD", raw)
+        ascii_only = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+        upper = ascii_only.upper()
+        for long, short in self._config.legal_suffix_map:
+            upper = re.sub(rf"\b{long}\b", short, upper)
+        patterns = self._config.text_patterns
+        cleaned = patterns.punct.sub(" ", upper)
+        return patterns.whitespace.sub(" ", cleaned).strip()
+
+    def tokenise(self, normalised: str) -> tuple[str, ...]:
+        if not normalised:
+            return ()
+        return tuple(t for t in normalised.split(" ") if t)
+
+    def skeleton_of(self, raw: str | None) -> str:
+        empty = self._config.empty_skeleton_placeholder
+        if raw is None:
+            return empty
+        base = self.normalise_text(raw)
+        if not base:
+            return empty
+        patterns = self._config.text_patterns
+        tokens = []
+        for tok in self.tokenise(base):
+            if patterns.long_digit_token.match(tok):
+                continue
+            if tok in self._config.generic_stop_tokens:
+                continue
+            trimmed = patterns.trailing_digits.sub("", tok)
+            if not trimmed:
+                continue
+            if trimmed in self._config.generic_stop_tokens:
+                continue
+            tokens.append(trimmed)
+        if not tokens:
+            return empty
+        return " ".join(tokens)
+
+    def normalize_bank_transaction(
+        self,
+        raw: RawBankTransaction | Mapping[str, Any],
+    ) -> NormalizationResult:
+        row, warnings = self._resolve_raw_transaction(raw)
+        return NormalizationResult(
+            transaction=self._normalize_resolved(row),
+            warnings=warnings,
+        )
+
+    def normalize_bank_transactions(
+        self,
+        rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+    ) -> NormalizationBatchResult:
+        materialised = list(rows)
+        warnings: list[ValidationWarning] = []
+        resolved: list[RawBankTransaction] = []
+
+        for row in materialised:
+            payload, txn_id = self._payload_and_id(row)
+            check = self._schema_checker.check(
+                payload,
+                subschema=_BANK_TRANSACTION_SUBSCHEMA,
+                transaction_id=txn_id,
+            )
+            if not check.valid:
+                warnings.extend(check.warnings)
+                continue
+            if isinstance(row, RawBankTransaction):
+                resolved.append(row)
+            else:
+                resolved.append(self._coerce_raw_transaction(payload))
+
+        return NormalizationBatchResult(
+            transactions=tuple(self._normalize_resolved(row) for row in resolved),
+            warnings=tuple(warnings),
+        )
+
+    def _resolve_raw_transaction(
+        self,
+        raw: RawBankTransaction | Mapping[str, Any],
+    ) -> tuple[RawBankTransaction, tuple[ValidationWarning, ...]]:
+        payload, txn_id = self._payload_and_id(raw)
+        check = self._schema_checker.check(
+            payload,
+            subschema=_BANK_TRANSACTION_SUBSCHEMA,
+            transaction_id=txn_id,
+        )
+        if isinstance(raw, RawBankTransaction):
+            row = raw
+        else:
+            row = self._coerce_raw_transaction(payload)
+        return row, check.warnings
+
+    def _normalize_resolved(self, row: RawBankTransaction) -> BankTransaction:
+        normalised_desc = self.normalise_text(row.description)
+        tokens = self.tokenise(normalised_desc)
+        skeleton = self.skeleton_of(row.description)
+        return BankTransaction(
+            raw=row,
+            normalised_description=normalised_desc,
+            description_tokens=tokens,
+            skeleton=skeleton,
+        )
+
+    @staticmethod
+    def _payload_and_id(raw: RawBankTransaction | Mapping[str, Any]) -> tuple[dict[str, Any], str]:
+        if isinstance(raw, RawBankTransaction):
+            return BankTransactionNormalizationService._raw_transaction_payload(raw), raw.id
+        if is_dataclass(raw):
+            raise TypeError("expected RawBankTransaction or mapping, got dataclass instance")
+        payload = dict(raw)
+        return payload, str(payload.get("id", ""))
+
+    @staticmethod
+    def _raw_transaction_payload(raw: RawBankTransaction) -> dict[str, Any]:
+        payload = {
+            "id": raw.id,
+            "date": raw.date,
+            "description": raw.description,
+            "debit_amount": float(raw.debit_amount),
+            "credit_amount": float(raw.credit_amount),
+            "balance": None if raw.balance is None else float(raw.balance),
+            "reference": raw.reference,
+            "page": raw.page,
+            "line": raw.line,
+            "is_brought_forward": raw.is_brought_forward,
+            "is_final_balance": raw.is_final_balance,
+        }
+        return payload
+
+    @staticmethod
+    def _coerce_raw_transaction(payload: Mapping[str, Any]) -> RawBankTransaction:
+        debit = payload["debit_amount"]
+        credit = payload["credit_amount"]
+        balance = payload.get("balance")
+        return RawBankTransaction(
+            id=str(payload["id"]),
+            date=str(payload["date"]),
+            description=str(payload["description"]),
+            debit_amount=debit if isinstance(debit, Decimal) else Decimal(str(debit)),
+            credit_amount=credit if isinstance(credit, Decimal) else Decimal(str(credit)),
+            balance=(
+                None
+                if balance is None
+                else balance
+                if isinstance(balance, Decimal)
+                else Decimal(str(balance))
+            ),
+            reference=payload.get("reference"),
+            page=payload.get("page"),
+            line=payload.get("line"),
+            is_brought_forward=bool(payload.get("is_brought_forward", False)),
+            is_final_balance=bool(payload.get("is_final_balance", False)),
+        )
+
+
+_DEFAULT_SERVICE: BankTransactionNormalizationService | None = None
+
+
+def default_service() -> BankTransactionNormalizationService:
+    global _DEFAULT_SERVICE
+    if _DEFAULT_SERVICE is None:
+        _DEFAULT_SERVICE = BankTransactionNormalizationService()
+    return _DEFAULT_SERVICE
+
+
+# Backward-compatible alias for callers/tests expecting the old exception name.
+NormalizationValidationError = SchemaValidationError
+
+__all__ = [
+    "BankTransactionNormalizationService",
+    "NormalizationValidationError",
+    "default_service",
+]
