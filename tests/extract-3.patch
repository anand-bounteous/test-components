+import type {
+  ExtractionAuditSummary,
+  ExtractionPageResult,
+} from "@nw/ui-bank-statement";
+import type {
+  AuditJson,
+  ExtractorResultJson,
+  RunManifest,
+  RunSummary,
+  SolutionName,
+} from "./types";
+import { SOLUTION_NAMES } from "./types";
+
+function fileUrl(runId: string, relativePath: string): string {
+  const encoded = relativePath
+    .split("/")
+    .map((segment) => encodeURIComponent(segment))
+    .join("/");
+  return `/api/runs/${runId}/files/${encoded}`;
+}
+
+export async function fetchRunSummaries(): Promise<RunSummary[]> {
+  const response = await fetch("/api/runs");
+  if (!response.ok) {
+    throw new Error(`Failed to list runs (${response.status})`);
+  }
+  const payload = (await response.json()) as { runs: RunSummary[] };
+  return payload.runs;
+}
+
+export async function fetchRunManifest(runId: string): Promise<RunManifest> {
+  const response = await fetch(`/api/runs/${runId}`);
+  if (!response.ok) {
+    throw new Error(`Run ${runId} not found`);
+  }
+  return (await response.json()) as RunManifest;
+}
+
+function pageFromResult(
+  result: ExtractorResultJson,
+  runId: string,
+  pageIndex = 0,
+): ExtractionPageResult {
+  const page = result.pages[pageIndex];
+  if (!page) {
+    throw new Error(`Page ${pageIndex} missing in extractor result`);
+  }
+
+  const imageRef = page.page_image_ref ?? `raster/pages/page-${pageIndex.toString().padStart(3, "0")}.png`;
+
+  return {
+    pageIndex: page.page_index,
+    width: page.width,
+    height: page.height,
+    dpi: page.dpi,
+    pageImageUrl: fileUrl(runId, imageRef),
+    fullText: page.full_text ?? "",
+    regions: page.regions.map((region) => ({
+      id: region.id,
+      type: region.type,
+      bbox: region.bbox,
+      text: region.text,
+      confidence: region.confidence,
+      source_tool: region.source_tool,
+      attributes: region.attributes,
+    })),
+    tables: page.tables.map((table) => ({
+      region_id: table.region_id,
+      n_rows: table.n_rows,
+      n_cols: table.n_cols,
+      border_mode: table.border_mode,
+      cells: table.cells.map((cell) => ({
+        row: cell.row,
+        col: cell.col,
+        text: cell.text,
+        bbox: cell.bbox,
+        multiline: cell.multiline,
+      })),
+    })),
+  };
+}
+
+function auditFromJson(audit: AuditJson): ExtractionAuditSummary {
+  return {
+    extractorName: audit.extractor_name,
+    totalMs: audit.timings?.total_ms ?? 0,
+    stepCount: audit.audit?.length ?? 0,
+  };
+}
+
+export type BenchmarkRunViewModel = {
+  runId: string;
+  manifest: RunManifest;
+  extractions: Partial<Record<SolutionName, ExtractionPageResult>>;
+  audits: Partial<Record<SolutionName, ExtractionAuditSummary>>;
+};
+
+export async function loadBenchmarkRun(
+  runId: string,
+): Promise<BenchmarkRunViewModel> {
+  const manifest = await fetchRunManifest(runId);
+  const extractions: Partial<Record<SolutionName, ExtractionPageResult>> = {};
+  const audits: Partial<Record<SolutionName, ExtractionAuditSummary>> = {};
+
+  await Promise.all(
+    SOLUTION_NAMES.map(async (solution) => {
+      const [resultRes, auditRes] = await Promise.all([
+        fetch(fileUrl(runId, `${solution}/result.json`)),
+        fetch(fileUrl(runId, `${solution}/audit.json`)),
+      ]);
+
+      if (!resultRes.ok || !auditRes.ok) {
+        return;
+      }
+
+      const result = (await resultRes.json()) as ExtractorResultJson;
+      const audit = (await auditRes.json()) as AuditJson;
+      extractions[solution] = pageFromResult(result, runId);
+      audits[solution] = auditFromJson(audit);
+    }),
+  );
+
+  return { runId, manifest, extractions, audits };
+}
