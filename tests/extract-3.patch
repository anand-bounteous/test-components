+"""Bank transaction hint application service — Design §6.4, FR-016, FR-017."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from decimal import Decimal
+
+from nw_core.validation import ValidationWarning
+
+from .._models import BankTransaction
+from .applicators.GiftApplicator import apply_gift_hints
+from .applicators.PropertySaleApplicator import apply_property_sale_hints
+from .applicators.RentApplicator import apply_rent_hints
+from .applicators.SalaryApplicator import (
+    apply_payslip_hints as _apply_payslip_hints,
+)
+from .applicators.SalaryApplicator import (
+    apply_salary_band,
+    band_modifier,
+    compute_salary_band,
+)
+from .EmployerHintMatcher import (
+    employer_hint_bonus,
+    employer_match_level,
+)
+from .matchers.GiftMatcher import GiftHintMatcher
+from .matchers.PropertySaleMatcher import PropertySaleHintMatcher
+from .matchers.RentMatcher import RentHintMatcher
+from .models import (
+    AppliedHints,
+    HintConfig,
+    HintInputs,
+    SalaryBand,
+    load_hint_config,
+)
+from .models.HintApplicationResult import HintApplicationResult
+
+
+def anchor_txn_ids(applied: AppliedHints) -> dict[str, str]:
+    return {anchor.transaction_id: anchor.hint_id for anchor in applied.anchors}
+
+
+def ambiguous_anchor_ids(applied: AppliedHints) -> set[str]:
+    return {a.transaction_id for a in applied.anchors if a.ambiguous}
+
+
+class BankTransactionHintService:
+    """Apply optional hints to normalised bank transactions."""
+
+    def __init__(
+        self,
+        config: HintConfig | None = None,
+        *,
+        gift_matcher: GiftHintMatcher | None = None,
+        rent_matcher: RentHintMatcher | None = None,
+        property_sale_matcher: PropertySaleHintMatcher | None = None,
+    ) -> None:
+        self._config = config or load_hint_config()
+        self._gift_matcher = gift_matcher or GiftHintMatcher()
+        self._rent_matcher = rent_matcher or RentHintMatcher()
+        self._property_sale_matcher = property_sale_matcher or PropertySaleHintMatcher()
+
+    @property
+    def config(self) -> HintConfig:
+        return self._config
+
+    def apply_hints(
+        self,
+        credits: Iterable[BankTransaction],
+        hint_inputs: HintInputs | None,
+    ) -> HintApplicationResult:
+        parsed = hint_inputs or HintInputs()
+        credit_list = list(credits)
+        applied = self._apply_parsed(credit_list, parsed)
+        warnings = self._unmatched_warnings(applied)
+        return HintApplicationResult(
+            applied_hints=applied,
+            hint_inputs=parsed,
+            warnings=warnings,
+        )
+
+    def _apply_parsed(
+        self,
+        credits: list[BankTransaction],
+        hint_inputs: HintInputs,
+    ) -> AppliedHints:
+        applied = AppliedHints()
+        if hint_inputs.payslip_hints:
+            applied = _apply_payslip_hints(credits, hint_inputs.payslip_hints)
+        if hint_inputs.salary_hints is not None and not hint_inputs.salary_hints.is_empty():
+            applied = apply_salary_band(applied, hint_inputs.salary_hints)
+
+        gift = None
+        rent = None
+        property_sale = None
+
+        if hint_inputs.gift_hints is not None:
+            gift = apply_gift_hints(credits, hint_inputs.gift_hints, self._gift_matcher)
+        if hint_inputs.rent_hints is not None:
+            rent = apply_rent_hints(credits, hint_inputs.rent_hints, self._rent_matcher)
+        if hint_inputs.property_sale_hints is not None:
+            property_sale = apply_property_sale_hints(
+                credits,
+                hint_inputs.property_sale_hints,
+                self._property_sale_matcher,
+            )
+
+        if gift is not None or rent is not None or property_sale is not None:
+            applied = AppliedHints(
+                anchors=applied.anchors,
+                unmatched_hint_ids=applied.unmatched_hint_ids,
+                effective_monthly=applied.effective_monthly,
+                band_lower=applied.band_lower,
+                band_upper=applied.band_upper,
+                gift=gift,
+                rent=rent,
+                property_sale=property_sale,
+            )
+        return applied
+
+    @staticmethod
+    def _unmatched_warnings(applied: AppliedHints) -> tuple[ValidationWarning, ...]:
+        return tuple(
+            ValidationWarning(
+                code="hint_unmatched",
+                transaction_id="",
+                detail=f"payslip hint {hint_id!r} did not match any credit",
+            )
+            for hint_id in applied.unmatched_hint_ids
+        )
+
+    def employer_hint_bonus(
+        self,
+        candidate_employer_tokens: frozenset[str],
+        employer_hints,
+    ) -> float:
+        return employer_hint_bonus(candidate_employer_tokens, employer_hints, self._config)
+
+    def employer_match_level(
+        self, candidate_employer_tokens: frozenset[str], employer_hints
+    ) -> str:
+        return employer_match_level(candidate_employer_tokens, employer_hints, self._config)
+
+    def band_modifier(self, cluster_median: Decimal, band: SalaryBand | None) -> float:
+        return band_modifier(cluster_median, band, floor=self._config.band_modifier.floor)
+
+
+_DEFAULT_SERVICE: BankTransactionHintService | None = None
+
+
+def default_service() -> BankTransactionHintService:
+    global _DEFAULT_SERVICE
+    if _DEFAULT_SERVICE is None:
+        _DEFAULT_SERVICE = BankTransactionHintService()
+    return _DEFAULT_SERVICE
+
+
+def apply_payslip_hints(
+    credits: Iterable[BankTransaction],
+    hints,
+) -> AppliedHints:
+    return _apply_payslip_hints(credits, hints)
+
+
+def apply_hints(
+    credits: Iterable[BankTransaction],
+    *,
+    payslip_hints=(),
+    salary_hints=None,
+) -> AppliedHints:
+    return (
+        default_service()
+        .apply_hints(
+            credits,
+            HintInputs(payslip_hints=tuple(payslip_hints), salary_hints=salary_hints),
+        )
+        .applied_hints
+    )
+
+
+HintValidationError = ValueError
+
+__all__ = [
+    "BankTransactionHintService",
+    "HintValidationError",
+    "ambiguous_anchor_ids",
+    "anchor_txn_ids",
+    "apply_hints",
+    "apply_payslip_hints",
+    "band_modifier",
+    "compute_salary_band",
+    "default_service",
+]
