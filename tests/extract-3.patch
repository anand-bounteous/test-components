+"""AuditBuilder — pipeline observability."""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Protocol
+
+if TYPE_CHECKING:
+    from nw_agcore_bank_transactions.pipeline._models import (
+        ConfidenceDetail,
+        SalaryCandidateSet,
+        TransactionFeatures,
+    )
+else:
+    ConfidenceDetail = Any
+    SalaryCandidateSet = Any
+    TransactionFeatures = Any
+
+from .models.AuditRecord import AuditRecord
+from .models.CandidateAuditDetail import CandidateAuditDetail
+from .models.PipelineStepRecord import PipelineStepRecord
+
+
+class _AuditableCandidate(Protocol):
+    candidate_set_id: str
+    candidate_type: str
+    confidence: float
+    confidence_band: str
+    reasoning: tuple[str, ...]
+    risks: tuple[str, ...]
+    metadata: Mapping[str, Any]
+
+    @property
+    def transactions(self) -> Iterable[Any]: ...
+
+
+@dataclass
+class AuditBuilder:
+    enabled: bool = False
+    analysis_id: str = ""
+    config_versions: dict[str, str] = field(default_factory=dict)
+    effective_kwargs: dict[str, Any] = field(default_factory=dict)
+    _steps: list[PipelineStepRecord] = field(default_factory=list)
+    _features: tuple[TransactionFeatures, ...] = ()
+    _candidate_details: list[CandidateAuditDetail] = field(default_factory=list)
+    _timings: dict[str, float] = field(default_factory=dict)
+    _step_starts: dict[str, float] = field(default_factory=dict)
+
+    def start_step(self, name: str) -> None:
+        if not self.enabled:
+            return
+        self._step_starts[name] = time.perf_counter()
+
+    def record_step(
+        self,
+        name: str,
+        *,
+        input_summary: dict[str, Any] | None = None,
+        output_summary: dict[str, Any] | None = None,
+        extra: dict[str, Any] | None = None,
+    ) -> PipelineStepRecord | None:
+        if not self.enabled:
+            return None
+        start = self._step_starts.pop(name, time.perf_counter())
+        duration_ms = round((time.perf_counter() - start) * 1000.0, 3)
+        return self._append_step(
+            name,
+            duration_ms=duration_ms,
+            input_summary=input_summary,
+            output_summary=output_summary,
+            extra=extra,
+        )
+
+    def apply_tool_audit(self, data: Any) -> PipelineStepRecord | None:
+        """Merge audit payload returned by a ``BaseTool`` run."""
+        if not self.enabled:
+            return None
+        return self._append_step(
+            data.phase_name,
+            duration_ms=data.duration_ms,
+            input_summary=data.input_summary,
+            output_summary=data.output_summary,
+            extra=data.extra,
+        )
+
+    def _append_step(
+        self,
+        name: str,
+        *,
+        duration_ms: float,
+        input_summary: dict[str, Any] | None = None,
+        output_summary: dict[str, Any] | None = None,
+        extra: dict[str, Any] | None = None,
+    ) -> PipelineStepRecord:
+        self._timings[name] = duration_ms
+        record = PipelineStepRecord(
+            name=name,
+            duration_ms=duration_ms,
+            input_summary=dict(input_summary or {}),
+            output_summary=dict(output_summary or {}),
+            extra=dict(extra or {}),
+        )
+        self._steps.append(record)
+        return record
+
+    def record_features(self, features: tuple[TransactionFeatures, ...]) -> None:
+        if not self.enabled:
+            return
+        self._features = features
+
+    def record_candidates(self, candidates: tuple[SalaryCandidateSet, ...]) -> None:
+        if not self.enabled:
+            return
+        for c in candidates:
+            self._candidate_details.append(_candidate_detail_from(c))
+
+    def record_application_candidates(
+        self,
+        candidates: Iterable[_AuditableCandidate],
+        *,
+        score_breakdown_builder,
+    ) -> None:
+        if not self.enabled:
+            return
+        for candidate in candidates:
+            self._candidate_details.append(
+                _application_candidate_detail_from(candidate, score_breakdown_builder)
+            )
+
+    def snapshot(self) -> AuditRecord | None:
+        if not self.enabled:
+            return None
+        return AuditRecord(
+            analysis_id=self.analysis_id,
+            timings_ms=dict(self._timings),
+            pipeline_steps=tuple(self._steps),
+            per_transaction_features=self._features,
+            candidate_details=tuple(self._candidate_details),
+            config_versions=dict(self.config_versions),
+            effective_kwargs=dict(self.effective_kwargs),
+        )
+
+
+def _confidence_steps_from_details(
+    details: tuple[ConfidenceDetail, ...] | Iterable[ConfidenceDetail],
+) -> tuple[dict[str, Any], ...]:
+    out: list[dict[str, Any]] = []
+    for detail in details:
+        out.append(
+            {
+                "step": detail.step,
+                "confidence_step": float(detail.confidence_step),
+                "confidence_step_max_value": float(detail.confidence_step_max_value),
+                "reasoning": detail.reasoning,
+                "data": dict(detail.data),
+            }
+        )
+    return tuple(out)
+
+
+def _candidate_detail_from(candidate: SalaryCandidateSet) -> CandidateAuditDetail:
+    breakdown = candidate.score_breakdown
+    details = candidate.confidence_details
+    if not details and candidate.transactions:
+        details = candidate.transactions[0].confidence_details
+    if isinstance(breakdown, dict):
+        score_payload = {k: float(v) for k, v in breakdown.items() if isinstance(v, (int, float))}
+    else:
+        score_payload = {
+            "date_pattern_score": float(breakdown.date_pattern_score),
+            "description_similarity_score": float(breakdown.description_similarity_score),
+            "amount_consistency_score": float(breakdown.amount_consistency_score),
+            "payment_channel_score": float(breakdown.payment_channel_score),
+            "coverage_score": float(breakdown.coverage_score),
+            "context_bonus": float(breakdown.context_bonus),
+            "anchor_bonus": float(breakdown.anchor_bonus),
+            "salary_band_modifier": float(breakdown.salary_band_modifier),
+            "negative_signal_penalty": float(breakdown.negative_signal_penalty),
+            "final_score": float(breakdown.final_score),
+        }
+    return CandidateAuditDetail(
+        candidate_set_id=candidate.candidate_set_id,
+        candidate_type=candidate.candidate_type,
+        confidence=float(candidate.confidence),
+        confidence_band=candidate.confidence_band,
+        transaction_ids=tuple(t.transaction_id for t in candidate.transactions),
+        score_breakdown=score_payload,
+        confidence_steps=_confidence_steps_from_details(details),
+        reasoning=tuple(candidate.reasoning),
+        risks=tuple(candidate.risks),
+        metadata=dict(candidate.metadata),
+    )
+
+
+def _application_candidate_detail_from(
+    candidate: _AuditableCandidate,
+    score_breakdown_builder,
+) -> CandidateAuditDetail:
+    details = getattr(candidate, "confidence_details", ()) or ()
+    if not details and candidate.transactions:
+        first = next(iter(candidate.transactions))
+        details = getattr(first, "confidence_details", ()) or ()
+    return CandidateAuditDetail(
+        candidate_set_id=candidate.candidate_set_id,
+        candidate_type=candidate.candidate_type,
+        confidence=float(candidate.confidence),
+        confidence_band=candidate.confidence_band,
+        transaction_ids=tuple(t.transaction_id for t in candidate.transactions),
+        score_breakdown=score_breakdown_builder(candidate),
+        confidence_steps=_confidence_steps_from_details(details),
+        reasoning=tuple(candidate.reasoning),
+        risks=tuple(candidate.risks),
+        metadata=dict(candidate.metadata),
+    )
+
+
+__all__ = ["AuditBuilder"]
