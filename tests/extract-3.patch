+"""Unit tests for repo-wide pytest hooks."""
+
+from __future__ import annotations
+
+import logging
+from unittest.mock import MagicMock
+
+import pytest
+from nw_core.logging import LogContextFilter, PYTEST_LOG_FORMAT, TRACE
+from nw_common_tests.PytestHooks import pytest_configure, pytest_sessionstart
+
+
+@pytest.mark.unit
+def test_pytest_configure_adds_trace_terminal_color():
+    from _pytest.logging import ColoredLevelFormatter
+
+    original = dict(ColoredLevelFormatter.LOGLEVEL_COLOROPTS)
+    try:
+        ColoredLevelFormatter.LOGLEVEL_COLOROPTS = {
+            key: value for key, value in original.items() if key != TRACE
+        }
+        pytest_configure(MagicMock())
+        assert TRACE in ColoredLevelFormatter.LOGLEVEL_COLOROPTS
+        assert ColoredLevelFormatter.LOGLEVEL_COLOROPTS[TRACE] == {"cyan"}
+    finally:
+        ColoredLevelFormatter.LOGLEVEL_COLOROPTS = original
+
+
+@pytest.mark.unit
+def test_pytest_sessionstart_noop_without_logging_plugin():
+    session = MagicMock()
+    session.config.pluginmanager.get_plugin.return_value = None
+
+    pytest_sessionstart(session)
+
+
+@pytest.mark.unit
+def test_pytest_sessionstart_adds_log_context_filter_and_formatters():
+    cli_handler = logging.StreamHandler()
+    file_handler = logging.StreamHandler()
+
+    plugin = MagicMock()
+    plugin.log_cli_handler = cli_handler
+    plugin.log_file_handler = file_handler
+    plugin._create_formatter = MagicMock(return_value=logging.Formatter())
+
+    session = MagicMock()
+    session.config.pluginmanager.get_plugin.return_value = plugin
+    session.config.option.log_auto_indent = False
+
+    pytest_sessionstart(session)
+
+    assert any(isinstance(item, LogContextFilter) for item in cli_handler.filters)
+    assert any(isinstance(item, LogContextFilter) for item in file_handler.filters)
+    plugin._create_formatter.assert_any_call(PYTEST_LOG_FORMAT, None, False)
+
+
+@pytest.mark.unit
+def test_pytest_sessionstart_skips_duplicate_log_context_filter():
+    existing = LogContextFilter()
+    cli_handler = logging.StreamHandler()
+    cli_handler.addFilter(existing)
+    file_handler = logging.StreamHandler()
+
+    plugin = MagicMock()
+    plugin.log_cli_handler = cli_handler
+    plugin.log_file_handler = file_handler
+    plugin._create_formatter = MagicMock(return_value=logging.Formatter())
+
+    session = MagicMock()
+    session.config.pluginmanager.get_plugin.return_value = plugin
+    session.config.option.log_auto_indent = False
+
+    pytest_sessionstart(session)
+
+    assert cli_handler.filters == [existing]
+    assert len(file_handler.filters) == 1
+    assert isinstance(file_handler.filters[0], LogContextFilter)
