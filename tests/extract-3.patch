+"""Unit tests for employment transition linking."""
+
+from __future__ import annotations
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import CandidateSet, CandidateTransaction
+from nw_agcore_bank_transactions.pipeline.employment_transition.EmploymentTransitionService import (
+    merge_transition_pair,
+    same_employer,
+)
+
+
+def _cand(cid: str, employer_tokens: tuple[str, ...], conf: float = 0.7) -> CandidateSet:
+    return CandidateSet(
+        candidate_set_id=cid,
+        candidate_type="probable_salary",
+        transactions=(CandidateTransaction(transaction_id="t1", date="2024-01-15", description="PAY", amount=2500.0),),
+        score_breakdown={},
+        detected_pattern={"possible_employer_tokens": employer_tokens},
+        confidence=conf,
+        confidence_band="medium_high" if conf >= 0.7 else "medium",
+    )
+
+
+@pytest.mark.unit
+def test_same_employer_detects_token_overlap():
+    a = _cand("a", ("ACME",))
+    b = _cand("b", ("ACME", "PAYROLL"))
+    c = _cand("c", ("BETA",))
+    assert same_employer(a, b) is True
+    assert same_employer(a, c) is False
+
+
+@pytest.mark.unit
+def test_merge_transition_pair_uses_min_confidence():
+    a = _cand("a", ("ACME",), conf=0.8)
+    b = _cand("b", ("BETA",), conf=0.6)
+    merged = merge_transition_pair(a, b, gap_days=14)
+    assert merged.confidence == 0.6
+    assert len(merged.transactions) == 2
