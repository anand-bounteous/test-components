+from pathlib import Path
+
+from nw_agcore_document_data_extractor.channels.Registry import register_channels
+from nw_aglib_toolkit.channels.AgentDeployment import AgentChannelBootstrap, AgentDeploymentManifest
+from nw_core.config.ComponentSettings import BaseComponentSettings, load_settings
+
+
+def build_runtime(component_root: Path):
+    settings = load_settings(component_root, BaseComponentSettings)
+    manifest = AgentDeploymentManifest.load(component_root / "config" / "deployment.yaml")
