+"""JSON wire-format helpers for REST request and response bodies."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import fields
+from typing import Any, TypeVar
+
+from nw_agcore_bank_transactions.channels.rest.RequestParsing import raw_transaction_from_mapping
+from nw_agcore_bank_transactions.pipeline._models import (
+    BankTransaction,
+    BankTransactionMetadata,
+    CandidateSet,
+    CandidateTransaction,
+    ConfidenceDetail,
+    DetectedPattern,
+    GapPeriodCandidate,
+    ScoreBreakdown,
+    TransactionFeatures,
+)
+from nw_core.logging.LogFnAnnotation import linearize_for_log
+
+T = TypeVar("T")
+
+
+def to_api_json(value: Any) -> Any:
+    """Convert domain objects to JSON-serialisable structures."""
+    return linearize_for_log(value)
+
+
+def _tuple_of[T](cls: type[T], items: Iterable[Any] | None, builder) -> tuple[T, ...]:
+    if not items:
+        return ()
+    return tuple(builder(item) for item in items)
+
+
+def bank_transaction_from_wire(data: Mapping[str, Any]) -> BankTransaction:
+    raw_data = data.get("raw", data)
+    raw = raw_transaction_from_mapping(raw_data)
+    metadata = BankTransactionMetadata()
+    features = None
+    if data.get("features") is not None:
+        features = transaction_features_from_wire(data["features"])
+    return BankTransaction(
+        raw=raw,
+        normalised_description=str(data.get("normalised_description", raw.description)),
+        description_tokens=tuple(data.get("description_tokens") or ()),
+        skeleton=str(data.get("skeleton", "")),
+        metadata=metadata,
+        features=features,
+    )
+
+
+def transaction_features_from_wire(data: Mapping[str, Any]) -> TransactionFeatures:
+    return TransactionFeatures(
+        transaction_id=str(data["transaction_id"]),
+        payment_channel=str(data.get("payment_channel", "unknown_credit")),
+        payment_channel_confidence=float(data.get("payment_channel_confidence", 0.0)),
+        payment_channel_matched_tokens=tuple(data.get("payment_channel_matched_tokens") or ()),
+        salary_hint_tokens=tuple(data.get("salary_hint_tokens") or ()),
+        negative_tokens=tuple(data.get("negative_tokens") or ()),
+        possible_employer_tokens=tuple(data.get("possible_employer_tokens") or ()),
+        day_of_month=int(data.get("day_of_month", 0)),
+        weekday=int(data.get("weekday", 0)),
+        is_month_end=bool(data.get("is_month_end", False)),
+        is_last_working_day=bool(data.get("is_last_working_day", False)),
+        is_first_working_day=bool(data.get("is_first_working_day", False)),
+        is_bank_holiday_adjacent=bool(data.get("is_bank_holiday_adjacent", False)),
+        is_anchor=bool(data.get("is_anchor", False)),
+        anchor_hint_id=data.get("anchor_hint_id"),
+        ambiguous_anchor=bool(data.get("ambiguous_anchor", False)),
+    )
+
+
+def confidence_detail_from_wire(data: Mapping[str, Any]) -> ConfidenceDetail:
+    return ConfidenceDetail(
+        step=str(data["step"]),
+        confidence_step=float(data["confidence_step"]),
+        confidence_step_max_value=float(data["confidence_step_max_value"]),
+        reasoning=str(data.get("reasoning", "")),
+    )
+
+
+def candidate_transaction_from_wire(data: Mapping[str, Any]) -> CandidateTransaction:
+    return CandidateTransaction(
+        date=str(data["date"]),
+        description=str(data.get("description", "")),
+        amount=float(data.get("amount", 0.0)),
+        transaction_id=str(data.get("transaction_id", "")),
+        confidence=float(data.get("confidence", 0.0)),
+        confidence_band=str(data.get("confidence_band", "very_low")),
+        reasoning=tuple(data.get("reasoning") or ()),
+        confidence_details=_tuple_of(
+            ConfidenceDetail,
+            data.get("confidence_details"),
+            confidence_detail_from_wire,
+        ),
+    )
+
+
+def score_breakdown_from_wire(data: Mapping[str, Any] | None) -> ScoreBreakdown:
+    data = data or {}
+    return ScoreBreakdown(
+        **{field.name: float(data.get(field.name, 0.0)) for field in fields(ScoreBreakdown)}
+    )
+
+
+def detected_pattern_from_wire(data: Mapping[str, Any] | None) -> DetectedPattern:
+    data = data or {}
+    return DetectedPattern(
+        frequency=str(data.get("frequency", "unknown")),
+        payday_model=str(data.get("payday_model", "unknown")),
+        payment_channel=str(data.get("payment_channel", "unknown_credit")),
+        amount_model=str(data.get("amount_model", "unknown")),
+        possible_employer_tokens=tuple(data.get("possible_employer_tokens") or ()),
+        coverage=str(data.get("coverage", "")),
+    )
+
+
+def gap_period_candidate_from_wire(data: Mapping[str, Any]) -> GapPeriodCandidate:
+    return GapPeriodCandidate(
+        period=str(data["period"]),
+        plausible_transactions=_tuple_of(
+            CandidateTransaction,
+            data.get("plausible_transactions"),
+            candidate_transaction_from_wire,
+        ),
+    )
+
+
+def salary_candidate_set_from_wire(data: Mapping[str, Any]) -> CandidateSet:
+    return CandidateSet(
+        candidate_set_id=str(data["candidate_set_id"]),
+        candidate_type=str(data["candidate_type"]),
+        transactions=_tuple_of(
+            CandidateTransaction,
+            data.get("transactions"),
+            candidate_transaction_from_wire,
+        ),
+        score_breakdown=score_breakdown_from_wire(data.get("score_breakdown")),
+        detected_pattern=detected_pattern_from_wire(data.get("detected_pattern")),
+        reasoning=tuple(data.get("reasoning") or ()),
+        risks=tuple(data.get("risks") or ()),
+        confidence=float(data.get("confidence", 0.0)),
+        confidence_band=str(data.get("confidence_band", "very_low")),
+        confidence_details=_tuple_of(
+            ConfidenceDetail,
+            data.get("confidence_details"),
+            confidence_detail_from_wire,
+        ),
+        gap_period_candidates=_tuple_of(
+            GapPeriodCandidate,
+            data.get("gap_period_candidates"),
+            gap_period_candidate_from_wire,
+        ),
+        metadata=dict(data.get("metadata") or {}),
+    )
+
+
+def bank_transactions_from_wire(items: Sequence[Mapping[str, Any]]) -> tuple[BankTransaction, ...]:
+    return tuple(bank_transaction_from_wire(item) for item in items)
+
+
+def candidate_sets_from_wire(items: Sequence[Mapping[str, Any]]) -> tuple[CandidateSet, ...]:
+    return tuple(salary_candidate_set_from_wire(item) for item in items)
+
+
+def features_by_id_from_wire(
+    data: Mapping[str, Mapping[str, Any]],
+) -> dict[str, TransactionFeatures]:
+    return {key: transaction_features_from_wire(value) for key, value in data.items()}
+
+
+def dataclass_to_dict(value: Any) -> dict[str, Any]:
+    linearized = linearize_for_log(value)
+    if isinstance(linearized, dict):
+        return linearized
+    return {"value": linearized}
