+"""Bank transaction normalisation tool entry points."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import (
+    BankTransactionNormalizationService,
+    NormalizationValidationError,
+    SchemaValidationSettings,
+    load_normalization_config,
+    normalize_bank_transaction,
+    normalize_bank_transactions,
+)
+from nw_core.validation.schema import SchemaCheckConfig, SchemaCheckService
+
+
+def _raw(**kw) -> RawBankTransaction:
+    base = dict(
+        id="t01",
+        date="2024-01-31",
+        description="BACS CREDIT ACME LTD PAYROLL 123456",
+        debit_amount=Decimal("0"),
+        credit_amount=Decimal("2450.32"),
+    )
+    base.update(kw)
+    return RawBankTransaction(**base)
+
+
+def test_normalize_bank_transaction_accepts_dict_payload():
+    result = normalize_bank_transaction(
+        {
+            "id": "t01",
+            "date": "2024-01-31",
+            "description": "BACS CREDIT ACME LTD PAYROLL 123456",
+            "debit_amount": 0,
+            "credit_amount": 2450.32,
+        }
+    )
+    assert result.skeleton == "BACS ACME LTD PAYROLL"
+
+
+def test_normalize_bank_transactions_validates_batch_schema():
+    rows = (
+        _raw(id="t01"),
+        _raw(id="t02", date="2024-02-29"),
+    )
+    result = normalize_bank_transactions(rows)
+    assert len(result) == 2
+
+
+def test_normalize_bank_transaction_rejects_invalid_payload():
+    with pytest.raises(NormalizationValidationError):
+        normalize_bank_transaction(
+            {
+                "id": "t01",
+                "date": "bad-date",
+                "description": "x",
+                "debit_amount": 0,
+                "credit_amount": 1,
+            }
+        )
+
+
+def test_normalize_bank_transactions_rejects_invalid_batch():
+    with pytest.raises(NormalizationValidationError):
+        normalize_bank_transactions(
+            [
+                {
+                    "id": "t01",
+                    "date": "bad-date",
+                    "description": "x",
+                    "debit_amount": 0,
+                    "credit_amount": 1,
+                }
+            ]
+        )
+
+
+def test_lenient_schema_validation_skips_invalid_rows():
+    base = load_normalization_config()
+    config = replace(
+        base,
+        schema_validation=SchemaValidationSettings(enabled=True, strict=False),
+    )
+    checker = SchemaCheckService.from_resource(
+        "nw_agcore_bank_transactions.pipeline.normalization",
+        "schemas/normalization.schema.json",
+        config=SchemaCheckConfig(enabled=True, strict=False),
+    )
+    svc = BankTransactionNormalizationService(config=config, schema_checker=checker)
+    result = svc.normalize_bank_transactions(
+        [
+            _raw(id="good"),
+            {"id": "bad", "date": "2024-01-31", "description": "x"},
+        ]
+    )
+    assert len(result.transactions) == 1
+    assert result.transactions[0].id == "good"
+    assert len(result.warnings) >= 1
+    assert result.warnings[0].transaction_id == "bad"
