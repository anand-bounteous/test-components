@@ -0,0 +1,75 @@
+"""Shared pytest hooks for the NW monorepo (registered via root ``pytest_plugins``).
+
+1. Register TRACE (5) at import time so ``--log-cli-level=TRACE`` works.
+2. Colour TRACE in pytest's terminal output.
+3. Apply :data:`PYTEST_LOG_FORMAT` and :class:`LogContextFilter` to pytest's
+   live-log and file-log handlers so pipeline logs include call/analysis ids.
+4. Force ``NW_ENV=test`` for packages that do not define their own env fixture.
+"""
+
+from __future__ import annotations
+
+import nw_core.logging  # noqa: F401 — registers logging.TRACE = 5
+import pytest
+from nw_core.logging import (
+    PYTEST_LOG_FORMAT,
+    TRACE,
+    LogContextFilter,
+    install_log_context_filter,
+    setup_trace,
+)
+
+from nw_common_tests.Env import force_test_env
+
+setup_trace()
+
+
+@pytest.fixture(autouse=True)
+def _force_test_env():
+    force_test_env()
+
+
+def pytest_configure(config) -> None:
+    try:
+        from _pytest.logging import ColoredLevelFormatter
+
+        if TRACE not in ColoredLevelFormatter.LOGLEVEL_COLOROPTS:
+            ColoredLevelFormatter.LOGLEVEL_COLOROPTS = {
+                **ColoredLevelFormatter.LOGLEVEL_COLOROPTS,
+                TRACE: {"cyan"},
+            }
+    except Exception:
+        pass
+
+
+def pytest_sessionstart(session) -> None:
+    plugin = session.config.pluginmanager.get_plugin("logging-plugin")
+    if plugin is None:
+        return
+
+    install_log_context_filter()
+    log_context_filter = LogContextFilter()
+    for handler in (plugin.log_cli_handler, plugin.log_file_handler):
+        if not any(isinstance(item, LogContextFilter) for item in handler.filters):
+            handler.addFilter(log_context_filter)
+
+    log_date_format = None
+    if plugin.log_cli_handler.formatter is not None:
+        log_date_format = plugin.log_cli_handler.formatter.datefmt
+
+    formatter = plugin._create_formatter(
+        PYTEST_LOG_FORMAT,
+        log_date_format,
+        getattr(session.config.option, "log_auto_indent", False),
+    )
+    plugin.log_cli_handler.setFormatter(formatter)
+
+    if plugin.log_file_handler.formatter is not None:
+        log_date_format = plugin.log_file_handler.formatter.datefmt
+    plugin.log_file_handler.setFormatter(
+        plugin._create_formatter(
+            PYTEST_LOG_FORMAT,
+            log_date_format,
+            getattr(session.config.option, "log_auto_indent", False),
+        )
+    )
