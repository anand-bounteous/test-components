+def test_deployment_manifest_loads_channels(tmp_path: Path):
+    yaml_path = tmp_path / "deployment.yaml"
+    yaml_path.write_text(
+        """unit: test-unit
+mode: standalone
+channels:
+  rest:
+    enabled: true
+    prefix: /api
+""",
+        encoding="utf-8",
+    )
+    manifest = DeploymentManifest.load(yaml_path)
+    assert manifest.unit == "test-unit"
+    assert manifest.channel_enabled("rest") is True
+    assert manifest.channel_prefix("rest") == "/api"
+
+
+@pytest.mark.feature
+def test_channel_bootstrap_builds_rest_app():
+    manifest = DeploymentManifest(
+        unit="test",
+        channels={"rest": {"enabled": True, "prefix": ""}},
+    )
+    registry = ChannelRegistry()
+    registry.add(RestChannelModule(APIRouter()))
+    runtime = ChannelBootstrap.build(manifest, registry, title="Test")
+    assert runtime.app is not None
