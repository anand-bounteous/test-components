+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any
+
+from nw_aglib_toolkit.agent import BaseAgent
+
+
+class ToolDefinition:
+    def __init__(
+        self,
+        name: str,
+        description: str,
+        handler: Callable[..., Any],
+        parameters: dict[str, Any] | None = None,
+    ) -> None:
+        self.name = name
+        self.description = description
+        self.handler = handler
+        self.parameters = parameters or {"type": "object", "properties": {}}
+
+    def to_schema(self) -> dict[str, Any]:
+        return {
+            "type": "function",
+            "function": {
+                "name": self.name,
+                "description": self.description,
+                "parameters": self.parameters,
+            },
+        }
+
+
+ToolDecorator = Callable[[Callable[..., Any]], Callable[..., Any]]
+
+
+def tool(
+    name: str | None = None,
+    description: str = "",
+) -> ToolDecorator:
+    """Decorator to mark a function as an exposable tool."""
+
+    def decorator(fn: Callable[..., Any]) -> Callable[..., Any]:
+        fn._tool_name = name or fn.__name__  # type: ignore[attr-defined]
+        fn._tool_description = description or (fn.__doc__ or "")  # type: ignore[attr-defined]
+        return fn
+
+    return decorator
+
+
+class ChannelToolRegistry:
+    """Registry of callable tools for agent exposure."""
+
+    def __init__(self) -> None:
+        self._tools: dict[str, ToolDefinition] = {}
+
+    def register(
+        self,
+        name: str,
+        handler: Callable[..., Any],
+        *,
+        description: str = "",
+        parameters: dict[str, Any] | None = None,
+    ) -> None:
+        self._tools[name] = ToolDefinition(name, description, handler, parameters)
+
+    def register_from_agent(self, agent: BaseAgent, methods: list[str] | None = None) -> None:
+        for attr_name in methods or ["invoke"]:
+            handler = getattr(agent, attr_name, None)
+            if handler is None:
+                continue
+            self.register(
+                f"{agent.name}_{attr_name}",
+                handler,
+                description=f"{agent.name} {attr_name}",
+            )
+
+    def merge(self, other: ChannelToolRegistry) -> None:
+        self._tools.update(other._tools)
+
+    def register_from_pipeline_registry(
+        self,
+        pipeline_registry: Any,
+    ) -> None:
+        """Bridge pipeline @tool registry into exposure ToolRegistry."""
+        for registered in pipeline_registry.list():
+            metadata = registered.metadata
+            parameters = _metadata_to_json_schema(metadata)
+            self.register(
+                registered.name,
+                registered.callable_ref,
+                description=metadata.description,
+                parameters=parameters,
+            )
+
+    def list_schemas(self) -> list[dict[str, Any]]:
+        return [t.to_schema() for t in self._tools.values()]
+
+    async def call(self, name: str, payload: dict[str, Any]) -> Any:
+        if name not in self._tools:
+            raise KeyError(f"Tool not found: {name}")
+        handler = self._tools[name].handler
+        result = handler(**payload) if payload else handler()
+        if hasattr(result, "__await__"):
+            return await result
+        return result
+
+
+def _metadata_to_json_schema(metadata: Any) -> dict[str, Any]:
+    properties: dict[str, Any] = {}
+    required: list[str] = []
+    for param in metadata.parameters:
+        prop: dict[str, Any] = {}
+        if param.annotation:
+            prop["type"] = _annotation_to_json_type(param.annotation)
+        if param.description:
+            prop["description"] = param.description
+        if param.default is not None:
+            prop["default"] = param.default
+        properties[param.name] = prop
+        if param.required:
+            required.append(param.name)
+    schema: dict[str, Any] = {"type": "object", "properties": properties}
+    if required:
+        schema["required"] = required
+    return schema
+
+
+def _annotation_to_json_type(annotation: str) -> str:
+    lowered = annotation.lower()
+    if "int" in lowered:
+        return "integer"
+    if "float" in lowered or "decimal" in lowered:
+        return "number"
+    if "bool" in lowered:
+        return "boolean"
+    if "list" in lowered or "sequence" in lowered:
+        return "array"
+    if "dict" in lowered or "mapping" in lowered:
+        return "object"
+    return "string"
