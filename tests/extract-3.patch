+"""Property sale hint application audit."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import (
+    overlap_match_level,
+    tokenise_employer_name,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+
+from ..matchers.AmountRangeMatcher import amount_bounds, amount_in_range, coverage_pct
+from ..matchers.PartyPropertyMatcher import max_match_level, property_match_level
+from ..matchers.PropertySaleMatcher import PropertySaleHintMatcher
+from ..models import AppliedPropertySaleHints, PropertySaleHints
+
+
+def apply_property_sale_hints(
+    transactions: Sequence[BankTransaction],
+    hint_inputs: PropertySaleHints,
+    matcher: PropertySaleHintMatcher,
+    *,
+    reference_date: date | None = None,
+    window_start: date | None = None,
+    window_end: date | None = None,
+    aggregate_sum: Decimal | None = None,
+    cluster: Sequence[BankTransaction] | None = None,
+) -> AppliedPropertySaleHints:
+    matcher.validate_amount_present(hint_inputs)
+    tolerance = matcher.effective_tolerance(hint_inputs)
+    assert hint_inputs.amount is not None
+    lower, upper = amount_bounds(hint_inputs.amount, tolerance)
+
+    buyer_level = "none"
+    property_level = "none"
+    postcode_matched = False
+    rows = cluster if cluster is not None else transactions
+    for txn in rows:
+        tokens = frozenset(txn.description_tokens)
+        if hint_inputs.buyer_name:
+            buyer_level = max_match_level(
+                buyer_level,
+                overlap_match_level(tokens, hint_inputs.buyer_name, load_hint_config()),
+            )
+        property_level = max_match_level(
+            property_level,
+            property_match_level(tokens, hint_inputs.property_ref, hint_inputs.location),
+        )
+        if hint_inputs.postcode:
+            postcode_tokens = tokenise_employer_name(hint_inputs.postcode, load_hint_config())
+            if postcode_tokens & tokens:
+                postcode_matched = True
+
+    total = (
+        aggregate_sum if aggregate_sum is not None else sum((t.amount for t in rows), Decimal("0"))
+    )
+    amount_matched = amount_in_range(total, hint_inputs.amount, tolerance) if rows else False
+
+    unmatched: list[str] = []
+    if not amount_matched:
+        unmatched.append("amount")
+    if hint_inputs.buyer_name and buyer_level == "none":
+        unmatched.append("buyer_name")
+    if (hint_inputs.property_ref or hint_inputs.location) and property_level == "none":
+        unmatched.append("property_ref")
+    if hint_inputs.postcode and not postcode_matched:
+        unmatched.append("postcode")
+
+    ref_str = reference_date.isoformat() if reference_date else ""
+    return AppliedPropertySaleHints(
+        amount_matched=amount_matched,
+        amount_range_lower=lower,
+        amount_range_upper=upper,
+        aggregate_sum=total,
+        aggregate_coverage_pct=coverage_pct(total, hint_inputs.amount),
+        buyer_match_level=buyer_level,
+        property_match_level=property_level,
+        postcode_matched=postcode_matched,
+        reference_date=ref_str,
+        timeline_window_start=window_start.isoformat() if window_start else "",
+        timeline_window_end=window_end.isoformat() if window_end else "",
+        unmatched_hint_fields=tuple(unmatched),
+    )
