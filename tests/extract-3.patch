+"""Unit tests for gift debit guard filtering."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agbus_gift_extractor.services.GiftCreditGuards import (
+    credit_blocked_by_debit,
+    debit_rows,
+    filter_groups_by_debit_guards,
+)
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+
+
+def _credit(txn_id: str, txn_date: str, amount: str) -> BankTransaction:
+    raw = RawBankTransaction(
+        id=txn_id,
+        date=txn_date,
+        description="GIFT",
+        credit_amount=amount,
+    )
+    return BankTransaction(
+        raw=raw,
+        normalised_description="GIFT",
+        description_tokens=("GIFT",),
+        skeleton="GIFT",
+    )
+
+
+@pytest.mark.unit
+def test_debit_rows_collects_positive_debits_only():
+    rows = debit_rows(
+        (
+            RawBankTransaction(id="c1", date="2024-01-01", description="GIFT", credit_amount="100"),
+            RawBankTransaction(id="d1", date="2024-01-02", description="RETURN", debit_amount="100"),
+        )
+    )
+    assert len(rows) == 1
+    assert rows[0].amount == Decimal("100")
+
+
+@pytest.mark.unit
+def test_credit_blocked_by_same_day_symmetry():
+    credit = _credit("g1", "2024-08-20", "8000")
+    debits = debit_rows(
+        (
+            RawBankTransaction(
+                id="d1",
+                date="2024-08-20",
+                description="CAR FINANCE",
+                debit_amount="8000",
+            ),
+        )
+    )
+    assert credit_blocked_by_debit(credit, debits, reversal_window_days=7)
+
+
+@pytest.mark.unit
+def test_filter_groups_drops_reversed_credit():
+    group = HintGroupCandidate(
+        candidate_set_id="gift_000",
+        transactions=(_credit("g1", "2024-03-12", "5000"),),
+        window_start=date(2024, 3, 7),
+        window_end=date(2024, 3, 17),
+        aggregate_sum=Decimal("5000"),
+    )
+    filtered = filter_groups_by_debit_guards(
+        [group],
+        all_transactions=(
+            RawBankTransaction(
+                id="g1",
+                date="2024-03-12",
+                description="BACS CREDIT",
+                credit_amount="5000",
+            ),
+            RawBankTransaction(
+                id="d1",
+                date="2024-03-14",
+                description="RETURN BACS",
+                debit_amount="5000",
+            ),
+        ),
+        reversal_window_days=7,
+    )
+    assert filtered == []
