+      "date": "2024-06-15",
+      "description": "COMPLETION FUNDS CHAPS",
+      "credit_amount": "248500.00",
+      "debit_amount": 0
+    }
+  ]
+}
+```
+
+JSON Schema: `schemas/property_sale_input.schema.json`.
