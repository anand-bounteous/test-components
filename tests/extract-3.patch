+"""Unified ranked candidate set for all bank-transaction detectors."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from .CandidateTransaction import CandidateTransaction
+from .CandidateTypes import CONFIDENCE_BANDS
+from .ConfidenceDetail import ConfidenceDetail
+from .GapPeriodCandidate import GapPeriodCandidate
+from .ModelDict import to_model_dict
+
+
+@dataclass(frozen=True)
+class CandidateSet:
+    candidate_set_id: str
+    candidate_type: str
+    transactions: tuple[CandidateTransaction, ...]
+    score_breakdown: dict[str, Any]
+    detected_pattern: dict[str, Any]
+    reasoning: tuple[str, ...] = ()
+    risks: tuple[str, ...] = ()
+    confidence: float = 0.0
+    confidence_band: str = "very_low"
+    confidence_details: tuple[ConfidenceDetail, ...] = ()
+    gap_period_candidates: tuple[GapPeriodCandidate, ...] = ()
+    missing_months: tuple[str, ...] = ()
+    metadata: dict[str, Any] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "score_breakdown", to_model_dict(self.score_breakdown))
+        object.__setattr__(self, "detected_pattern", to_model_dict(self.detected_pattern))
+        if self.confidence_band not in CONFIDENCE_BANDS:
+            raise ValueError(f"confidence_band {self.confidence_band!r} not in {CONFIDENCE_BANDS}")
+
+
+SalaryCandidateSet = CandidateSet
+RentCandidateSet = CandidateSet
+GiftCandidateSet = CandidateSet
+PropertySaleCandidateSet = CandidateSet
+
+__all__ = [
+    "CandidateSet",
+    "GiftCandidateSet",
+    "PropertySaleCandidateSet",
+    "RentCandidateSet",
+    "SalaryCandidateSet",
+]
