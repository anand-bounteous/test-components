+"""Registry for @tool-annotated callables."""
+
+from __future__ import annotations
+
+import inspect
+from collections.abc import Callable
+from dataclasses import replace
+from types import ModuleType
+from typing import Any
+
+from nw_aglib_toolkit.channels.tools.ToolAnnotations import get_tool_metadata
+from nw_aglib_toolkit.channels.tools.ToolMetadata import ToolMetadata
+
+
+class ToolRegistrationError(Exception):
+    pass
+
+
+class RegisteredTool:
+    def __init__(
+        self,
+        *,
+        name: str,
+        callable_ref: Callable,
+        metadata: ToolMetadata,
+        owner_instance: Any | None = None,
+    ) -> None:
+        self.name = name
+        self.callable_ref = callable_ref
+        self.metadata = metadata
+        self.owner_instance = owner_instance
+
+    def __call__(self, *args: Any, **kwargs: Any) -> Any:
+        return self.callable_ref(*args, **kwargs)
+
+    @property
+    def signature(self) -> inspect.Signature:
+        return inspect.signature(self.callable_ref)
+
+
+class PipelineToolRegistry:
+    def __init__(self) -> None:
+        self._tools: dict[str, RegisteredTool] = {}
+
+    def register_function(
+        self,
+        func: Callable,
+        *,
+        class_name: str | None = None,
+        module_name: str | None = None,
+        owner_instance: Any | None = None,
+    ) -> RegisteredTool:
+        metadata = get_tool_metadata(func)
+
+        if metadata is None:
+            raise ToolRegistrationError(f"Function `{func.__name__}` is not annotated with @tool.")
+
+        if not metadata.enabled:
+            raise ToolRegistrationError(
+                f"Tool `{metadata.name}` is disabled and cannot be registered."
+            )
+
+        enriched_metadata = replace(
+            metadata,
+            class_name=class_name or metadata.class_name,
+            module_name=module_name or metadata.module_name,
+        )
+
+        if enriched_metadata.name in self._tools:
+            raise ToolRegistrationError(
+                f"Duplicate tool name detected: `{enriched_metadata.name}`."
+            )
+
+        registered_tool = RegisteredTool(
+            name=enriched_metadata.name,
+            callable_ref=func,
+            metadata=enriched_metadata,
+            owner_instance=owner_instance,
+        )
+
+        self._tools[enriched_metadata.name] = registered_tool
+        return registered_tool
+
+    def register_instance(self, instance: Any) -> list[RegisteredTool]:
+        registered: list[RegisteredTool] = []
+        class_name = instance.__class__.__name__
+        module_name = instance.__class__.__module__
+
+        for method_name, method in inspect.getmembers(instance, predicate=callable):
+            if method_name.startswith("_"):
+                continue
+
+            metadata = get_tool_metadata(method)
+            if metadata is None:
+                continue
+
+            if not metadata.enabled:
+                continue
+
+            registered.append(
+                self.register_function(
+                    method,
+                    class_name=class_name,
+                    module_name=module_name,
+                    owner_instance=instance,
+                )
+            )
+
+        return registered
+
+    def register_module(self, module: ModuleType) -> list[RegisteredTool]:
+        """Register module-level @tool functions from a *Tools.py module."""
+        registered: list[RegisteredTool] = []
+        module_name = module.__name__
+
+        for attr_name, obj in vars(module).items():
+            if attr_name.startswith("_"):
+                continue
+            if not callable(obj):
+                continue
+            if inspect.isclass(obj):
+                continue
+
+            metadata = get_tool_metadata(obj)
+            if metadata is None:
+                continue
+
+            if not metadata.enabled:
+                continue
+
+            registered.append(
+                self.register_function(
+                    obj,
+                    module_name=module_name,
+                )
+            )
+
+        return registered
+
+    def get(self, name: str) -> RegisteredTool:
+        return self._tools[name]
+
+    def list(self) -> list[RegisteredTool]:
+        return list(self._tools.values())
+
+    def names(self) -> list[str]:
+        return list(self._tools.keys())
+
+    def as_dict(self) -> dict[str, RegisteredTool]:
+        return dict(self._tools)
+
+
+# Back-compat alias used by adapter tests and legacy imports
+ToolRegistry = PipelineToolRegistry
