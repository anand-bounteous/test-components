+
+import pytest
+from nw_core.config.ComponentSettings import BaseComponentSettings, load_settings
+
+
+@pytest.mark.unit
+def test_load_settings_from_env_file(tmp_path: Path):
+    config_dir = tmp_path / "config"
+    config_dir.mkdir()
+    (config_dir / "env.test").write_text("NW_ENV=test\nLOG_LEVEL=DEBUG\n", encoding="utf-8")
+    os.environ["NW_ENV"] = "test"
+    settings = load_settings(tmp_path, BaseComponentSettings)
