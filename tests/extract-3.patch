+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Protocol, runtime_checkable
+
+if TYPE_CHECKING:
+    from fastapi import APIRouter, FastAPI
+
+    from nw_core.channels.ChannelDeployment import DeploymentManifest
+
+
+@runtime_checkable
+class ChannelModule(Protocol):
+    """Protocol for a channel type (REST, gRPC, MQ)."""
+
+    name: str
+
+    def is_enabled(self, manifest: DeploymentManifest) -> bool: ...
+
+    def mount(self, runtime: ChannelRuntime) -> None: ...
+
+
+class ChannelRuntime:
+    """Shared runtime context passed to channel modules during bootstrap."""
+
+    def __init__(self) -> None:
+        self.app: FastAPI | None = None
+        self.mq_adapter: Any | None = None
+        self.grpc_servicers: list[Any] = []
+        self.metadata: dict[str, Any] = {}
+
+
+class ChannelRegistry:
+    """Registry of channel modules for a component."""
+
+    def __init__(self) -> None:
+        self._modules: list[ChannelModule] = []
+
+    def add(self, module: ChannelModule) -> None:
+        self._modules.append(module)
+
+    @property
+    def modules(self) -> list[ChannelModule]:
+        return list(self._modules)
+
+
+class RestChannelModule:
+    """Wraps a FastAPI APIRouter as a REST channel."""
+
+    name = "rest"
+
+    def __init__(self, router: APIRouter, *, prefix: str = "") -> None:
+        self.router = router
+        self.default_prefix = prefix
+
+    def is_enabled(self, manifest: DeploymentManifest) -> bool:
+        return manifest.channels.get("rest", {}).get("enabled", False)
+
+    def mount(self, runtime: ChannelRuntime) -> None:
+        if runtime.app is None:
+            raise RuntimeError("REST channel requires FastAPI app in runtime")
+        from nw_core.channels.rest.RestFactory import mount_router
+
+        prefix = self.default_prefix or runtime.metadata.get("rest_prefix", self.default_prefix)
+        mount_router(runtime.app, self.router, prefix)
+
+
+class GrpcChannelModule:
+    """Registers a gRPC servicer stub."""
+
+    name = "grpc"
+
+    def __init__(self, servicer: Any) -> None:
+        self.servicer = servicer
+
+    def is_enabled(self, manifest: DeploymentManifest) -> bool:
+        return manifest.channels.get("grpc", {}).get("enabled", False)
+
+    def mount(self, runtime: ChannelRuntime) -> None:
+        runtime.grpc_servicers.append(self.servicer)
+
+
+class MqChannelModule:
+    """Binds MQ handler to adapter."""
+
+    name = "mq"
+
+    def __init__(self, handler: Any, adapter: Any) -> None:
+        self.handler = handler
+        self.adapter = adapter
+
+    def is_enabled(self, manifest: DeploymentManifest) -> bool:
+        return manifest.channels.get("mq", {}).get("enabled", False)
+
+    def mount(self, runtime: ChannelRuntime) -> None:
+        runtime.mq_adapter = self.adapter
+        if hasattr(self.adapter, "subscribe"):
+            self.adapter.subscribe(self.handler)
