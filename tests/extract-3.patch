+"""gRPC server bootstrap for component runtimes."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+import grpc
+
+
+@dataclass(frozen=True)
+class GrpcServicerRegistration:
+    """Pair a generated servicer instance with its registrar function."""
+
+    servicer: Any
+    add_to_server: Callable[[Any, grpc.aio.Server], None]
+
+
+async def serve_grpc(
+    registrations: list[GrpcServicerRegistration],
+    *,
+    host: str,
+    port: int,
+) -> None:
+    if not registrations:
+        return
+    server = grpc.aio.server()
+    for registration in registrations:
+        registration.add_to_server(registration.servicer, server)
+    server.add_insecure_port(f"{host}:{port}")
+    await server.start()
+    try:
+        await server.wait_for_termination()
+    finally:
+        await server.stop(grace=5)
+
+
+def run_grpc_server(
+    registrations: list[GrpcServicerRegistration],
+    *,
+    host: str,
+    port: int,
+) -> None:
+    asyncio.run(serve_grpc(registrations, host=host, port=port))
