@@ -0,0 +1,118 @@
+"""LogFn decorator behaviour."""
+
+from __future__ import annotations
+
+import json
+import logging
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_core.logging import TRACE, LogFn, linearize_for_log
+
+
+def test_LogFn_uses_wrapped_function_source_location(caplog) -> None:
+    logger = logging.getLogger("test.LogFn.location")
+
+    @LogFn(logger=logger)
+    def sample_tool(value: int) -> int:
+        return value + 1
+
+    with caplog.at_level(logging.INFO, logger="test.LogFn.location"):
+        assert sample_tool(2) == 3
+
+    info_records = [r for r in caplog.records if r.levelno == logging.INFO]
+    assert info_records
+    inner = sample_tool.__wrapped__
+    assert info_records[0].pathname == inner.__code__.co_filename
+    assert "call" in info_records[0].message
+    assert "args=" not in info_records[0].message
+
+
+def test_LogFn_trace_logs_linearized_args_and_kwargs(caplog) -> None:
+    logger = logging.getLogger("test.LogFn.trace")
+
+    class _Service:
+        pass
+
+    class _Tool:
+        @LogFn(logger=logger)
+        def _execute(self, rows, *, service=None):
+            return {"count": len(rows)}
+
+    tool = _Tool()
+    rows = (
+        RawBankTransaction(
+            id="t01",
+            date="2024-01-31",
+            description="ACME PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal("100.00"),
+        ),
+    )
+
+    with caplog.at_level(TRACE, logger="test.LogFn.trace"):
+        tool._execute(rows, service=_Service())
+
+    call_record = next(r for r in caplog.records if r.levelno == TRACE and "call" in r.message)
+    assert "<_Tool object at" not in call_record.message
+    assert "args=" in call_record.message
+    assert "kwargs=" in call_record.message
+
+    args_json = call_record.message.split("args=", 1)[1].split(" kwargs=", 1)[0]
