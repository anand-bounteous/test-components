+            tool_name="detect_gift_candidates",
+            parse_request=gift_request_from_proto,
+            detect=detect_gift_candidates,
+            response_factory=gift_extractor_pb2.DetectGiftCandidatesResponse,
+            result_message_factory=empty_gift_result_message,
+        )
