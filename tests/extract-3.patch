+"""Phase 13 — pattern induction module."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline.graph_clustering import (
+    InducedPattern,
+    induce_pattern,
+    longest_common_prefix,
+    longest_common_substring_pair,
+    longest_common_suffix,
+    matches_pattern,
+)
+
+# --- longest_common_prefix --------------------------------------------
+
+
+def test_lcp_basic():
+    assert longest_common_prefix(["foo", "foobar", "foobaz"]) == "foo"
+
+
+def test_lcp_no_common_prefix():
+    assert longest_common_prefix(["foo", "bar"]) == ""
+
+
+def test_lcp_empty_input():
+    assert longest_common_prefix([]) == ""
+
+
+def test_lcp_single_string():
+    assert longest_common_prefix(["foo"]) == "foo"
+
+
+def test_lcp_empty_string_in_list():
+    assert longest_common_prefix(["foo", ""]) == ""
+
+
+# --- longest_common_suffix --------------------------------------------
+
+
+def test_lcs_suffix_basic():
+    assert longest_common_suffix(["foobar", "razzar", "qarbar"]) == "ar"
+
+
+def test_lcs_suffix_empty_input():
+    assert longest_common_suffix([]) == ""
+
+
+def test_lcs_suffix_no_common():
+    assert longest_common_suffix(["foo", "bar"]) == ""
+
+
+# --- longest_common_substring_pair ------------------------------------
+
+
+def test_lcs_pair_finds_anywhere():
+    assert longest_common_substring_pair("xACMEy", "fooACMEbar") == "ACME"
+
+
+def test_lcs_pair_empty_inputs():
+    assert longest_common_substring_pair("", "abc") == ""
+    assert longest_common_substring_pair("abc", "") == ""
+
+
+def test_lcs_pair_no_common():
+    assert longest_common_substring_pair("abc", "xyz") == ""
+
+
+# --- induce_pattern: the user's specific ACH example -----------------
+
+
+def test_induce_ach_indian_payroll_example():
+    descs = [
+        "ACH C-SAL-ABCCorpINDL-ADISALJAN26-b4036e11cf45",
+        "ACH C-SAL-ABCCorpINDL-ADISALFEB26-d0cdd68ddafa",
+        "ACH C-SAL-ABCCorpINDL-ADISALMAR26-9f2c1ba87e30",
+        "ACH C-SAL-ABCCorpINDL-ADISALAPR26-1aebcd234567",
+        "ACH C-SAL-ABCCorpINDL-ADISALMAY26-fedcba987612",
+        "ACH C-SAL-ABCCorpINDL-ADISALJUN26-aaabbbcccddd",
+    ]
+    pattern = induce_pattern(descs)
+    assert pattern is not None
+    assert pattern.prefix.startswith("ACH C-SAL-ABCCorpINDL-ADISAL")
+    assert len(pattern.prefix) >= 27  # solid stable prefix
+    assert pattern.support_ratio == 1.0
+    assert pattern.signature.endswith("*")
+    assert len(pattern.variable_centres) == 6
+
+
+# --- induce_pattern: SWIFT multi-segment -----------------------------
+
+
+def test_induce_swift_multi_segment_with_year_suffix():
+    descs = [
+        "*GBP-FT-ACMECORP-NDB02EMP1023-Jan2026",
+        "*GBP-FT-ACMECORP-NDB02EMP1023-Feb2026",
+        "*GBP-FT-ACMECORP-NDB02EMP1023-Mar2026",
+        "*GBP-FT-ACMECORP-NDB02EMP1023-Apr2026",
+    ]
+    pattern = induce_pattern(descs)
+    assert pattern is not None
+    assert "GBP-FT-ACMECORP-NDB02EMP1023-" in pattern.prefix
+    # Common suffix recoverable too — "2026".
+    assert pattern.suffix == "2026"
+    # Variable centres are the 3-letter months.
+    for centre in pattern.variable_centres:
+        assert centre in {"Jan", "Feb", "Mar", "Apr"}
+
+
+# --- induce_pattern: rejection paths --------------------------------
+
+
+def test_induce_returns_none_when_prefix_too_short():
+    descs = ["abc1", "abc2", "abc3"]
+    assert induce_pattern(descs, min_stable_chars=10) is None
+
+
+def test_induce_returns_none_on_completely_different_strings():
+    descs = ["foo123", "bar456", "baz789"]
+    assert induce_pattern(descs) is None
+
+
+def test_induce_returns_none_for_empty_input():
+    assert induce_pattern([]) is None
+
+
+def test_induce_handles_partial_support():
+    """3 of 5 strings share a prefix; with min_support=0.6 the pattern
+    still emerges (3/5 = 0.6 matches)."""
+    descs = [
+        "PAYROLL-ACME-001",
+        "PAYROLL-ACME-002",
+        "PAYROLL-ACME-003",
+        "RANDOM-NOISE-A",
+        "OTHERSTREAM-B",
+    ]
+    pattern = induce_pattern(descs, min_support=0.6, min_stable_chars=8)
+    assert pattern is not None
+    assert "PAYROLL-ACME" in pattern.prefix
+
+
+def test_induce_skips_when_support_below_threshold():
+    descs = [
+        "PAYROLL-ACME-001",
+        "PAYROLL-ACME-002",
+        "RANDOM-NOISE-A",
+        "OTHERSTREAM-B",
+        "MORE-NOISE-C",
+    ]
+    # 2 of 5 = 0.4 — below 0.6 threshold.
+    assert induce_pattern(descs, min_support=0.6, min_stable_chars=8) is None
+
+
+# --- matches_pattern ---------------------------------------------------
+
+
+def test_matches_pattern_exact_prefix_and_suffix():
+    pattern = InducedPattern(
+        prefix="ACH C-SAL-",
+        suffix="2026",
+        variable_centres=("x",),
+        signature="ACH C-SAL-*2026",
+        support_ratio=1.0,
+    )
+    assert matches_pattern("ACH C-SAL-foobar2026", pattern) is True
+    assert matches_pattern("BACS PAYROLL ACME", pattern) is False
+
+
+def test_matches_pattern_suffix_optional():
+    pattern = InducedPattern(
+        prefix="ACME-",
+        suffix="",
+        variable_centres=("x",),
+        signature="ACME-*",
+        support_ratio=1.0,
+    )
+    assert matches_pattern("ACME-anything-goes", pattern) is True
+
+
+def test_matches_pattern_empty_description():
+    pattern = InducedPattern(
+        prefix="ACME-", suffix="", variable_centres=(), signature="ACME-*", support_ratio=1.0
+    )
+    assert matches_pattern("", pattern) is False
+
+
+# --- Signature shape ----------------------------------------------------
+
+
+def test_signature_includes_asterisk():
+    descs = ["PAYROLL-FOO-001", "PAYROLL-FOO-002", "PAYROLL-FOO-003"]
+    pattern = induce_pattern(descs)
+    assert pattern is not None
+    assert "*" in pattern.signature
