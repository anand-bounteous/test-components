+"""REST route for full PDF document extraction pipeline."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_document_data_extractor.channels.rest.ApiModels import ExtractRequest
+from nw_agcore_document_data_extractor.channels.rest.ApiResponseModels import ExtractionSuccessResponse
+from nw_agcore_document_data_extractor.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_document_data_extractor.channels.rest.RouteHelpers import error_response, success_response
+from nw_agcore_document_data_extractor.channels.tools.DocumentDataExtractionTools import extract_document_data
+from nw_agcore_document_data_extractor.pipeline._models.requests.DocumentExtractionRequest import DocumentExtractionRequest
+
+
+class ExtractRoute(BaseToolRoute):
+    tool_name = "extract_document_data"
+    path = "/document/extract"
+    tags = ("document",)
+    summary = "Run the full PDF extraction pipeline (text, OCR, tables)."
+    openapi_filename = "extract_document_data.openapi.yaml"
+    success_response_model = ExtractionSuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
+        def extract_document(body: ExtractRequest):
+            try:
+                payload = DocumentExtractionRequest(
+                    pdf_path=body.pdf_path,
+                    dpi=body.dpi,
+                    pdf_kind=body.pdf_kind,
+                    stages=body.stages,
+                    artifacts_dir=body.artifacts_dir,
+                )
+                result = extract_document_data(payload)
+                return success_response(result)
+            except Exception as exc:
