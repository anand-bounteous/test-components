+"""REST route for hint application."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import HintsRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import bank_transactions_from_wire
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RequestParsing import hint_inputs_from_mapping
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..BankTransactionHintTools import run_apply_bank_transaction_hints
+
+
+class HintsRoute(BaseToolRoute):
+    tool_name = "run_apply_bank_transaction_hints"
+    path = "/hints/apply"
+    tags = ("hints",)
+    summary = "Apply optional salary and employer hints to normalised transactions."
+    openapi_filename = "run_apply_bank_transaction_hints.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def apply_hints(body: HintsRequest):
+            try:
+                build_context(body)
+                transactions = bank_transactions_from_wire(body.transactions)
+                hint_inputs = hint_inputs_from_mapping(body.hint_inputs or {})
+                audit = build_audit(body)
+                result = run_apply_bank_transaction_hints(
+                    transactions,
+                    hint_inputs=hint_inputs,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
