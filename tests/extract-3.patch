+"""End-to-end rental-income detection service."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Sequence
+
+from nw_agcore_bank_transactions.channels.tools.scoring.ScoringTools import (
+    run_score_recurrence_pool,
+)
+from nw_agcore_bank_transactions.pipeline._models import CandidateSet
+from nw_agcore_bank_transactions.pipeline._models.requests import BankTransactionRequest
+from nw_agcore_bank_transactions.pipeline._models.results import (
+    BankTransactionResult,
+    InputSummary,
+    ResultMetadata,
+    ValidationWarning,
+)
+from nw_agcore_bank_transactions.pipeline.amount_date_fallback import run_amount_date_fallback
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    run_extract_bank_transaction_features,
+)
+from nw_agcore_bank_transactions.pipeline.graph_clustering import (
+    run_dedup_candidate_pool,
+    run_graph_clustering,
+)
+from nw_agcore_bank_transactions.pipeline.hints import run_apply_bank_transaction_hints
+from nw_agcore_bank_transactions.pipeline.hints.AnchorFlags import features_from_transactions
+from nw_agcore_bank_transactions.pipeline.hints.applicators.RentApplicator import apply_rent_hints
+from nw_agcore_bank_transactions.pipeline.hints.matchers import RentHintMatcher
+from nw_agcore_bank_transactions.pipeline.hints.models import AppliedHints, RentHints
+from nw_agcore_bank_transactions.pipeline.normalization import run_normalize_bank_transactions
+from nw_agcore_bank_transactions.pipeline.ranking import run_rank_candidates
+from nw_agcore_bank_transactions.pipeline.scoring import partition_by_negative_keywords
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping import run_emit_skeleton_candidates
+from nw_agcore_bank_transactions.pipeline.validation import (
+    TransactionsAbsence,
+    run_validate_bank_transaction_payload,
+)
+from nw_aglib_toolkit.audit import AuditBuilder
+from nw_aglib_toolkit.pipeline.config import AppConfig, load_config
+from nw_core.calendar import WorkingDayCalendar, working_day_calendar_from_app_config
+from nw_core.logging import AddCallContext, LogFn, set_log_analysis_id
+from nw_core.validation import ValidationWarning as CoreValidationWarning
+
+from .config.RentConfig import RentConfig, load_rent_config, load_rent_keywords
+from .RentRequestParsing import rent_warning_from_salary, to_validation_payload
+
+logger = logging.getLogger(__name__)
+
+
+def _recover_distinct_rent_streams(
+    pool: Sequence[CandidateSet],
+    skeleton_candidates: Sequence[CandidateSet],
+    *,
+    overlap_threshold: float = 0.90,
+) -> list[CandidateSet]:
+    """Keep separate skeleton streams when graph dedup merged multi-property rent."""
+    if len(skeleton_candidates) <= 1:
+        return list(pool)
+
+    def _overlap_ratio(a: set[str], b: set[str]) -> float:
+        if not a or not b:
+            return 0.0
+        return len(a & b) / min(len(a), len(b))
+
+    recovered: list[CandidateSet] = []
+    for candidate in pool:
+        cand_ids = {t.transaction_id for t in candidate.transactions}
+        matching = [
+            skeleton
+            for skeleton in skeleton_candidates
+            if _overlap_ratio(cand_ids, {t.transaction_id for t in skeleton.transactions})
+            >= overlap_threshold
+        ]
+        amounts = {int(s.transactions[0].amount) for s in matching if s.transactions}
+        if len(matching) >= 2 and len(amounts) >= 2:
+            recovered.extend(matching)
+            continue
+        recovered.append(candidate)
+    return recovered
+
+
+def _calendar_region(payload: BankTransactionRequest, cfg: AppConfig) -> str:
+    return payload.country_region or cfg.default_region()
+
+
+def _rent_matcher(rent_config: RentConfig) -> RentHintMatcher:
+    keywords = load_rent_keywords()
+    rh = rent_config.rent_hints()
+    return RentHintMatcher(
+        positive_keywords=keywords["positive"],
+        negative_keywords=keywords["negative"],
+        default_amount_tolerance_pct=float(rh.get("default_amount_tolerance_pct", 0.0)),
+    )
+
+
+class RentTransactionExtractorService:
+    def __init__(
+        self,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+        rent_config: RentConfig | None = None,
+    ) -> None:
+        self._rent_config = rent_config or load_rent_config()
+        overrides = self._rent_config.config_overrides_for_core()
+        self._config = config or load_config(overrides=overrides)
+        self._calendar = calendar or working_day_calendar_from_app_config(self._config)
+        self._description_signals = self._rent_config.description_signals()
+        self._hint_matcher = _rent_matcher(self._rent_config)
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def detect(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+        transactions_absence: TransactionsAbsence | None = None,
+    ) -> BankTransactionResult:
+        cfg = self._config
+        cal = self._calendar
+        validation_mode = mode or payload.validation_mode
+        analysis_id = payload.analysis_id
+        set_log_analysis_id(analysis_id)
+
+        audit = AuditBuilder(
+            enabled=bool(include_audit),
+            analysis_id=analysis_id,
+            config_versions=dict(cfg.versions()),
+            effective_kwargs={
+                "validation_mode": validation_mode,
+                "max_candidates": max_candidates,
+                "max_near_misses": max_near_misses,
+                "return_threshold": return_threshold,
+                "include_audit": include_audit,
+            },
+        )
+
+        pipeline_warnings: list[CoreValidationWarning] = []
+        validate_result = run_validate_bank_transaction_payload(
+            to_validation_payload(payload),
+            mode=validation_mode,
+            transactions_absence=transactions_absence,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        warnings = [rent_warning_from_salary(w) for w in pipeline_warnings]
+
+        if validate_result.early_exit:
+            return _early_exit(analysis_id, warnings, audit, include_audit, payload)
+
+        norm_result = run_normalize_bank_transactions(
+            validate_result.transactions,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        normalised = norm_result.transactions
+
+        extract_result = run_extract_bank_transaction_features(
+            normalised,
+            app_config=cfg,
+            calendar=cal,
+            region=_calendar_region(payload, cfg),
+            description_signals=self._description_signals,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        normalised = extract_result.transactions
+        features_by_id = {
+            t.features.transaction_id: t.features for t in normalised if t.features is not None
+        }
+        audit.record_features(features_from_transactions(normalised))
+
+        run_apply_bank_transaction_hints(
+            normalised,
+            hint_inputs=payload.hint_inputs,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+
+        rent_hint_inputs = payload.hint_inputs.rent_hints or RentHints()
+        applied_rent = apply_rent_hints(normalised, rent_hint_inputs, self._hint_matcher)
+        applied_hints = AppliedHints(rent=applied_rent)
+
+        skeleton_result = run_emit_skeleton_candidates(
+            normalised,
+            features_by_id,
+            config=cfg,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        graph_result = run_graph_clustering(
+            normalised,
+            features_by_id,
+            config=cfg,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        overlap = float(
+            self._rent_config.candidate_generation().get("dedup_txn_id_overlap_pct", 0.90)
+        )
+        dedup_result = run_dedup_candidate_pool(
+            skeleton_result.candidates,
+            graph_result.candidates,
+            overlap_threshold=overlap,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        pool = _recover_distinct_rent_streams(
+            dedup_result.candidates,
+            skeleton_result.candidates,
+            overlap_threshold=overlap,
+        )
+
+        accounted_ids = {t.transaction_id for c in pool for t in c.transactions}
+        unaccounted = [t for t in normalised if t.id not in accounted_ids]
+        if unaccounted:
+            fallback_result = run_amount_date_fallback(
+                unaccounted,
+                cal,
+                features_by_id,
+                config=cfg,
+                region=_calendar_region(payload, cfg),
+                audit=audit,
+                warnings=pipeline_warnings,
+            )
+            pool.extend(fallback_result.candidates)
+
+        keywords = load_rent_keywords()
+        scoring_result = run_score_recurrence_pool(
+            pool,
+            profile="rent",
+            normalised=normalised,
+            features_by_id=features_by_id,
+            calendar=cal,
+            config=cfg,
+            applied_hints=applied_hints,
+            rent_hints=rent_hint_inputs,
+            rent_weights=self._rent_config.weights(),
+            rent_thresholds=self._rent_config.thresholds(),
+            rent_candidate_generation=self._rent_config.candidate_generation(),
+            rent_positive_keywords=keywords["positive"],
+            rent_negative_keywords=keywords["negative"],
+            rent_hint_matcher=self._hint_matcher,
+            rent_hint_cfg=self._rent_config.rent_hints(),
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        scored = list(scoring_result.scored)
+
+        kept, neg_rejected = partition_by_negative_keywords(scored, features_by_id)
+
+        ranking_result = run_rank_candidates(
+            kept,
+            cfg,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        returned = list(ranking_result.returned)
+        near_misses = neg_rejected + list(ranking_result.near_misses)
+        near_misses = near_misses[: ranking_result.max_near_misses]
+
+        summary = _build_summary(payload, normalised)
+        result = BankTransactionResult(
+            analysis_id=analysis_id,
+            jurisdiction=payload.jurisdiction,
+            country_region=_calendar_region(payload, cfg),
+            input_summary=summary,
+            candidate_sets=tuple(returned),
+            rejected_or_near_miss_sets=tuple(near_misses),
+            warnings=tuple(warnings),
+            applied_hints=applied_hints,
+            metadata=ResultMetadata(
+                config_versions=dict(cfg.versions()),
+                return_threshold=ranking_result.return_threshold,
+                max_candidates=ranking_result.max_candidates,
+                max_near_misses=ranking_result.max_near_misses,
+                validation_mode=validation_mode,
+                include_audit=bool(include_audit),
+            ),
+        )
+        snapshot = audit.snapshot()
+        if snapshot is not None:
+            from dataclasses import replace as _replace
+
+            result = _replace(result, audit=snapshot)
+        return result
+
+
+def _build_summary(payload: BankTransactionRequest, normalised) -> InputSummary:
+    if normalised:
+        sorted_dates = sorted(n.date for n in normalised)
+        start = sorted_dates[0].isoformat()
+        end = sorted_dates[-1].isoformat()
+    else:
+        start = end = ""
+    return InputSummary(
+        transaction_count=len(payload.transactions),
+        credit_count=len(normalised),
+        date_range_start=start,
+        date_range_end=end,
+    )
+
+
+def _early_exit(
+    analysis_id: str,
+    warnings: list[ValidationWarning],
+    audit,
+    include_audit: bool,
+    payload: BankTransactionRequest,
+) -> BankTransactionResult:
+    return BankTransactionResult(
+        analysis_id=analysis_id,
+        jurisdiction=payload.jurisdiction,
+        country_region=payload.country_region or "EnglandAndWales",
+        input_summary=InputSummary(0, 0),
+        warnings=tuple(warnings),
+        audit=audit.snapshot() if include_audit else None,
+    )
+
+
+__all__ = ["RentTransactionExtractorService"]
