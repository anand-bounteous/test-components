+#!/usr/bin/env bash
+# One-time orchestration: scaffold bank-transactions packages from reference project.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+REF="/Users/Ravi.Kumar/workspace/NW/reference/sof-components/salary-transactions-extractor"
+BT="$REF/src/tools/bank_transactions"
+
+echo "==> Scaffolding core bank-transactions agent"
+CORE="$ROOT/agents/core/bank-transactions"
+rm -rf "$CORE"
+cp -R "$ROOT/agents/core/_template" "$CORE"
+
+# Rename package src
+mv "$CORE/src/nw_agent_core_template" "$CORE/src/nw_agcore_bank_transactions"
+
+# Copy pipeline (reference core only)
+mkdir -p "$CORE/src/nw_agcore_bank_transactions/pipeline"
+cp -R "$BT/core/"* "$CORE/src/nw_agcore_bank_transactions/pipeline/"
+
+# Copy shared REST infrastructure + core routes only
+mkdir -p "$CORE/src/nw_agcore_bank_transactions/exposure/rest/routes/openapi"
+cp "$BT/routes/BaseToolRoute.py" "$CORE/src/nw_agcore_bank_transactions/exposure/rest/"
+cp -R "$BT/routes/openapi/"* "$CORE/src/nw_agcore_bank_transactions/exposure/rest/routes/openapi/" 2>/dev/null || true
+
+# Copy per-phase route modules into exposure/rest/routes/
+for phase_dir in "$CORE/src/nw_agcore_bank_transactions/pipeline/"*/; do
+  if [ -d "${phase_dir}routes" ]; then
+    cp "${phase_dir}routes/"*.py "$CORE/src/nw_agcore_bank_transactions/exposure/rest/routes/" 2>/dev/null || true
+    if [ -d "${phase_dir}routes/openapi" ]; then
+      cp -R "${phase_dir}routes/openapi/"* "$CORE/src/nw_agcore_bank_transactions/exposure/rest/routes/openapi/" 2>/dev/null || true
+    fi
+  fi
+done
+
+# Copy graph_clustering Dedup route explicitly
+if [ -f "$BT/core/graph_clustering/routes/DedupCandidatePoolRoute.py" ]; then
+  cp "$BT/core/graph_clustering/routes/DedupCandidatePoolRoute.py" "$CORE/src/nw_agcore_bank_transactions/exposure/rest/routes/"
+fi
+
+echo "==> Scaffolding business agents"
+scaffold_business() {
+  local name="$1"
+  local ref_app="$2"
+  local pkg="$3"
+  local dir="$ROOT/agents/business/$name"
+  rm -rf "$dir"
+  cp -R "$ROOT/agents/business/_template" "$dir"
+  mv "$dir/src/nw_business_agent_template" "$dir/src/$pkg"
+  mkdir -p "$dir/src/$pkg/services"
+  cp -R "$BT/applications/$ref_app/"* "$dir/src/$pkg/services/"
+  mkdir -p "$dir/src/$pkg/tools"
+  cp "$BT/applications/$ref_app/"*Tools.py "$dir/src/$pkg/tools/" 2>/dev/null || true
+  if [ -d "$BT/applications/$ref_app/routes" ]; then
+    mkdir -p "$dir/src/$pkg/exposure/rest"
+    cp -R "$BT/applications/$ref_app/routes/"* "$dir/src/$pkg/exposure/rest/"
+  fi
+}
+
+scaffold_business "salary-extractor" "salary_extractor" "nw_agbus_salary_extractor"
+scaffold_business "rent-extractor" "rent_extractor" "nw_agbus_rent_extractor"
+scaffold_business "gift-extractor" "gift_extractor" "nw_agbus_gift_extractor"
+scaffold_business "property-sale-extractor" "property_sale_extractor" "nw_agbus_property_sale_extractor"
+
+echo "==> Running import remapper"
+python3 "$ROOT/scripts/migrate_imports.py" \
+  "$CORE/src" \
+  "$ROOT/agents/business/salary-extractor/src" \
+  "$ROOT/agents/business/rent-extractor/src" \
+  "$ROOT/agents/business/gift-extractor/src" \
+  "$ROOT/agents/business/property-sale-extractor/src"
+
+echo "==> Copy shared fixtures"
+mkdir -p "$ROOT/agents/core/bank-transactions/tests/fixtures/scenarios"
+cp -R "$REF/tests/fixtures/scenarios/"* "$ROOT/agents/core/bank-transactions/tests/fixtures/scenarios/" 2>/dev/null || true
+
+echo "Done scaffolding. Run uv sync and configure pyproject/deployment files."
