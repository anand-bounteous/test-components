+"""Public tool functions for bank-transaction normalisation."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.normalization.BankTransactionNormalizationService import (
+    BankTransactionNormalizationService,
+    NormalizationValidationError,
+    default_service,
+)
+from nw_agcore_bank_transactions.pipeline.normalization.models.NormalizationToolResult import (
+    NormalizationToolResult,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "BankTransactionNormalizationTools",
+    "NormalizationToolResult",
+    "NormalizationValidationError",
+    "normalize_bank_transaction",
+    "normalize_bank_transactions",
+    "run_normalize_bank_transactions",
+]
+
+
+_default_tool = None
+
+
+def _tool() -> BankTransactionNormalizationTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = BankTransactionNormalizationTools()
+    return _default_tool
+
+
+class BankTransactionNormalizationTools(BaseTool[NormalizationToolResult]):
+    phase_name = "normalise"
+
+    @LogFn
+    def _execute(
+        self,
+        rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+        *,
+        service: BankTransactionNormalizationService | None = None,
+    ) -> NormalizationToolResult:
+        materialised = list(rows)
+        svc = service or default_service()
+        batch = svc.normalize_bank_transactions(materialised)
+        return NormalizationToolResult(
+            transactions=batch.transactions,
+            warnings=batch.warnings,
+        )
+
+    def build_input_summary(
+        self,
+        rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(rows, (list, tuple)):
+            return {"credit_count": len(rows)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: NormalizationToolResult,
+        rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "normalised_count": len(result.transactions),
+            "warnings": len(result.warnings),
+        }
+
+    def trace_output(self, result: NormalizationToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for txn in result.transactions:
+            self._logger.trace(
+                "normalise.row  id=%s  date=%s  amount=%.2f  tokens=%s  desc=%r",
+                txn.id,
+                txn.date,
+                txn.amount,
+                list(txn.description_tokens)[:6],
+                txn.normalised_description,
+            )
+
+
+@tool(
+    name="run_normalize_bank_transactions",
+    description="Run normalisation with standard tool logging and optional audit payload.",
+    category="banking.normalization",
+    tags=["banking", "normalization"],
+)
+def run_normalize_bank_transactions(
+    rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+    *,
+    service: BankTransactionNormalizationService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> NormalizationToolResult:
+    """Normalise raw bank transactions into canonical credit rows.
+
+    Args:
+        rows: Raw or mapping-shaped bank transactions to normalise.
+        service: Optional normalisation service override.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with normalisation warnings.
+
+    Returns:
+        NormalizationToolResult with canonical transactions and warnings.
+    """
+    return _tool().run(rows, audit=audit, warnings=warnings, service=service)
+
+
+def normalize_bank_transaction(
+    raw: RawBankTransaction | Mapping[str, Any],
+    *,
+    service: BankTransactionNormalizationService | None = None,
+) -> BankTransaction:
+    """Project a bank transaction into the canonical model used downstream."""
+    svc = service or default_service()
+    return svc.normalize_bank_transaction(raw).transaction
+
+
+def normalize_bank_transactions(
+    rows: Iterable[RawBankTransaction | Mapping[str, Any]],
+    *,
+    service: BankTransactionNormalizationService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> tuple[BankTransaction, ...]:
+    """Normalise an iterable of bank transactions."""
+    return run_normalize_bank_transactions(
+        rows,
+        service=service,
+        audit=audit,
+        warnings=warnings,
+    ).transactions
