+"""Unit tests for gift hint matcher."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.matchers import GiftHintMatcher, meets_minimum
+from nw_agcore_bank_transactions.pipeline.hints.models import GiftHints
+
+
+def _txn(amount: str, description: str = "GIFT FROM MUM") -> BankTransaction:
+    raw = RawBankTransaction(
+        id="t1",
+        date="2024-01-15",
+        description=description,
+        credit_amount=amount,
+    )
+    return BankTransaction(
+        raw=raw,
+        normalised_description=description.upper(),
+        description_tokens=tuple(description.upper().split()),
+        skeleton="",
+    )
+
+
+@pytest.mark.unit
+def test_meets_minimum():
+    assert meets_minimum(Decimal("500"), Decimal("500"))
+    assert meets_minimum(Decimal("600"), Decimal("500"))
+    assert not meets_minimum(Decimal("400"), Decimal("500"))
+
+
+@pytest.mark.unit
+def test_gift_matcher_validate_amount_required():
+    matcher = GiftHintMatcher(positive_keywords=("GIFT",), negative_keywords=())
+    with pytest.raises(ValueError, match="gift_hints.amount"):
+        matcher.validate_amount_present(GiftHints())
+
+
+@pytest.mark.unit
+def test_gift_matcher_txn_soft_match_by_amount():
+    matcher = GiftHintMatcher(positive_keywords=("GIFT",), negative_keywords=())
+    hints = GiftHints(amount=Decimal("500"))
+    txn = _txn("500")
+    assert matcher.txn_soft_match(txn, hints)
+
+
+@pytest.mark.unit
+def test_gift_matcher_effective_tolerance_defaults():
+    matcher = GiftHintMatcher(default_tolerance_days=7)
+    hints = GiftHints(amount=Decimal("100"))
+    assert matcher.effective_tolerance_days(hints) == 7
+    hints_with_tol = GiftHints(amount=Decimal("100"), tolerance_days=3)
+    assert matcher.effective_tolerance_days(hints_with_tol) == 3
