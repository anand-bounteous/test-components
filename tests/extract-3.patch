+"""Phase 6 — previous / next / nearest working-day-of-N payday models."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._services.recurrence import (
+    PaydayModel,
+    fit_best_recurrence_model,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_core.calendar import WorkingDayCalendar
+
+
+@pytest.fixture(scope="module")
+def cal():
+    return WorkingDayCalendar()
+
+
+def _txn(tid, d):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=d.isoformat(),
+            description="BACS ACME LTD PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal("2500"),
+        )
+    )
+
+
+# --- Previous-working-day-of-N -------------------------------------------
+
+
+def test_previous_working_day_of_25(cal):
+    """Predictor:
+    - 25 Feb 2024 Sun → Fri 23
+    - 25 May 2024 Sat → Fri 24
+    - 25 Aug 2024 Sun → Mon 26 BH → Fri 23
+    - 25 Dec 2024 Wed BH → Mon 23 / Tue 24 — Tue 24 Dec is the previous
+      working day (Wed 25 = Christmas)."""
+    dates = [
+        date(2024, 1, 25),
+        date(2024, 2, 23),
+        date(2024, 3, 25),
+        date(2024, 4, 25),
+        date(2024, 5, 24),
+        date(2024, 6, 25),
+        date(2024, 7, 25),
+        date(2024, 8, 23),
+        date(2024, 9, 25),
+        date(2024, 10, 25),
+        date(2024, 11, 25),
+        date(2024, 12, 24),
+    ]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model in {
+        PaydayModel.PREVIOUS_WORKING_DAY_OF_N,
+        PaydayModel.NEAREST_WORKING_DAY_OF_N,
+    }
+    assert fit.parameter_n == 25
+    assert fit.fit_score == pytest.approx(1.0)
+
+
+# --- Next-working-day-of-N -----------------------------------------------
+
+
+def test_next_working_day_of_10(cal):
+    """N=10 chosen so FIRST_WORKING_DAY (which only applies to N=1) doesn't
+    compete on specificity. Months where 10 lands on a weekend get
+    bumped forward to the Monday."""
+    target_n = 10
+    # nearest_wd vs next_wd diverge for the Sat→Mon cases:
+    # 10 Feb 2024 (Sat) → next_wd = Mon 12 Feb  (nearest_wd would pick Fri 9)
+    # 10 Mar 2024 (Sun) → next_wd = Mon 11 Mar  (nearest_wd also Mar 11)
+    # 10 Aug 2024 (Sat) → next_wd = Mon 12 Aug  (nearest_wd would pick Fri 9)
+    # 10 Nov 2024 (Sun) → next_wd = Mon 11 Nov  (nearest_wd also Nov 11)
+    next_wd_2024 = [
+        date(2024, 1, 10),
+        date(2024, 2, 12),
+        date(2024, 3, 11),
+        date(2024, 4, 10),
+        date(2024, 5, 10),
+        date(2024, 6, 10),
+        date(2024, 7, 10),
+        date(2024, 8, 12),
+        date(2024, 9, 10),
+        date(2024, 10, 10),
+        date(2024, 11, 11),
+        date(2024, 12, 10),
+    ]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(next_wd_2024)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.NEXT_WORKING_DAY_OF_N
+    assert fit.parameter_n == target_n
+    assert fit.fit_score == pytest.approx(1.0)
+
+
+# --- Nearest-working-day-of-N --------------------------------------------
+
+
+def test_nearest_working_day_of_25_distinguishes_from_previous(cal):
+    """Full 12-month series of previous_working_day(25) anchors. This
+    confirms the working-day-of-N family resolves to N=25 with a clean fit.
+    """
+    # For 2024, nearest_wd(25) coincides with previous_wd(25) on Saturdays
+    # because the calendar picks prev when prev is closer. So this series
+    # fits both NEAREST_WORKING_DAY_OF_N and PREVIOUS_WORKING_DAY_OF_N
+    # perfectly — accept either model as long as N=25.
+    dates = [
+        date(2024, 1, 25),
+        date(2024, 2, 23),  # 25 Feb 2024 Sun → prev wd Fri 23
+        date(2024, 3, 25),
+        date(2024, 4, 25),
+        date(2024, 5, 24),  # 25 May 2024 Sat → prev wd Fri 24
+        date(2024, 6, 25),
+        date(2024, 7, 25),
+        date(2024, 8, 23),  # 25 Aug 2024 Sun, 26 Mon BH → Fri 23
+        date(2024, 9, 25),
+        date(2024, 10, 25),
+        date(2024, 11, 25),
+        date(2024, 12, 24),  # 25 Dec Wed BH → Tue 24
+    ]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.parameter_n == 25
+    assert fit.model in {
+        PaydayModel.PREVIOUS_WORKING_DAY_OF_N,
+        PaydayModel.NEAREST_WORKING_DAY_OF_N,
+    }
+    assert fit.fit_score >= 0.85
