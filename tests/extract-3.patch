+"""Discover and register @tool-annotated classes and module functions."""
+
+from __future__ import annotations
+
+import importlib
+import inspect
+import pkgutil
+from collections.abc import Iterator
+from pathlib import Path
+from types import ModuleType
+from typing import Any
+
+from nw_aglib_toolkit.channels.tools.ToolRegistry import PipelineToolRegistry, RegisteredTool
+
+
+def discover_tool_classes_from_package(package_name: str) -> list[type]:
+    """Discover classes whose class name ends with `Tools` under a package."""
+    discovered_classes: list[type] = []
+
+    for module_name in _iter_tool_module_names(package_name):
+        module = importlib.import_module(module_name)
+        discovered_classes.extend(_discover_tool_classes_from_module(module))
+
+    return discovered_classes
+
+
+def discover_tool_modules_from_package(package_name: str) -> list[ModuleType]:
+    """Import modules that may expose module-level @tool functions."""
+    return [
+        importlib.import_module(module_name)
+        for module_name in _iter_tool_module_names(package_name)
+    ]
+
+
+def _iter_tool_module_names(package_name: str) -> Iterator[str]:
+    """Yield tool module names via pkgutil and filesystem scan."""
+    package = importlib.import_module(package_name)
+    seen: set[str] = set()
+
+    if hasattr(package, "__path__"):
+        for module_info in pkgutil.walk_packages(
+            package.__path__,
+            prefix=f"{package.__name__}.",
+        ):
+            if _is_tool_module_name(module_info.name):
+                seen.add(module_info.name)
+                yield module_info.name
+
+        for path_entry in package.__path__:
+            root = Path(path_entry)
+            for fp in root.rglob("*Tools.py"):
+                if fp.name.startswith("_"):
+                    continue
+                rel = fp.relative_to(root).with_suffix("")
+                module_name = f"{package.__name__}.{'.'.join(rel.parts)}"
+                if module_name not in seen and _is_tool_module_name(module_name):
+                    seen.add(module_name)
+                    yield module_name
+        return
+
+    if _is_tool_module_name(package.__name__):
+        yield package.__name__
+
+
+def _is_tool_module_name(module_name: str) -> bool:
+    basename = module_name.rsplit(".", 1)[-1]
+    return basename.endswith("Tools") or basename.endswith("_tools")
+
+
+def _discover_tool_classes_from_module(module: ModuleType) -> list[type]:
+    classes: list[type] = []
+
+    for _, obj in inspect.getmembers(module, inspect.isclass):
+        if obj.__module__ != module.__name__:
+            continue
+
+        if obj.__name__.endswith("Tools"):
+            classes.append(obj)
+
+    return classes
+
+
+def instantiate_and_register_tools(
+    registry: PipelineToolRegistry,
+    tool_classes: list[type],
+    *,
+    dependency_provider: Any | None = None,
+) -> list[Any]:
+    """Instantiate discovered tool classes and register annotated methods."""
+    instances: list[Any] = []
+
+    for cls in tool_classes:
+        if dependency_provider is not None:
+            instance = dependency_provider.create_instance(cls)
+        else:
+            instance = cls()
+
+        registry.register_instance(instance)
+        instances.append(instance)
+
+    return instances
+
+
+def register_module_tools(
+    registry: PipelineToolRegistry,
+    modules: list[ModuleType],
+) -> list[RegisteredTool]:
+    registered: list[RegisteredTool] = []
+    for module in modules:
+        registered.extend(registry.register_module(module))
+    return registered
+
+
+def build_registry_from_package(
+    package_name: str,
+    *,
+    dependency_provider: Any | None = None,
+) -> PipelineToolRegistry:
+    registry = PipelineToolRegistry()
+    modules = discover_tool_modules_from_package(package_name)
+    register_module_tools(registry, modules)
+
+    classes = discover_tool_classes_from_package(package_name)
+    instantiate_and_register_tools(
+        registry,
+        classes,
+        dependency_provider=dependency_provider,
+    )
+
+    return registry
