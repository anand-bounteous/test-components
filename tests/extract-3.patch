+"""Unit tests for rent hint matcher."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.hints.matchers.RentMatcher import RentHintMatcher, amount_matches
+
+
+@pytest.mark.unit
+def test_amount_matches_within_tolerance():
+    assert amount_matches(Decimal("1000"), Decimal("1000"), tolerance_pct=0.05)
+    assert amount_matches(Decimal("1040"), Decimal("1000"), tolerance_pct=0.05)
+    assert not amount_matches(Decimal("1100"), Decimal("1000"), tolerance_pct=0.05)
+
+
+@pytest.mark.unit
+def test_rent_matcher_instantiates_with_keywords():
+    matcher = RentHintMatcher(positive_keywords=("RENT",), negative_keywords=())
+    assert matcher is not None
