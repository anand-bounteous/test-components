+
+class ExtractRequest(ToolCallOptions):
+    pdf_path: str
+    dpi: int = 300
+    pdf_kind: PdfKind = "unknown"
+    stages: list[str] = ["rasterize", "text", "ocr", "tables"]
+    artifacts_dir: Optional[str] = None
+
+
+class RasterizeRequest(ToolCallOptions):
+    pdf_path: str
+    dpi: int = 300
+    out_dir: Optional[str] = None
+
+
+class OcrRequest(ToolCallOptions):
+    pages: list[dict[str, Any]]
+
+
+class TablesRequest(ToolCallOptions):
+    pages: list[dict[str, Any]]
