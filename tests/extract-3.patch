+"""REST route for bank-transaction payload validation."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import ValidationRequest
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RequestParsing import bank_transaction_request_from_mapping
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..BankTransactionValidationTools import run_validate_bank_transaction_payload
+
+
+class ValidationRoute(BaseToolRoute):
+    tool_name = "run_validate_bank_transaction_payload"
+    path = "/validation/validate"
+    tags = ("validation",)
+    summary = "Validate and normalise a salary-extractor payload."
+    openapi_filename = "run_validate_bank_transaction_payload.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def validate_payload(body: ValidationRequest):
+            try:
+                build_context(body)
+                payload = bank_transaction_request_from_mapping(body.payload)
+                audit = build_audit(body)
+                result = run_validate_bank_transaction_payload(
+                    payload,
+                    mode=body.mode,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
