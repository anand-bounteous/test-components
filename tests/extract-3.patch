+"""Feature scenario fixture runner."""
+
+from __future__ import annotations
+
+import json
+import random
+from pathlib import Path
+
+import pytest
+import yaml
+from nw_agcore_bank_transactions.pipeline._models import CONFIDENCE_BANDS
+
+from tests.feature.support.DetectKwargs import detect_kwargs_from_expected
+from tests.feature.support.TestLogging import (
+    get_feature_logger,
+    log_candidate_dump,
+    log_test_detail,
+    log_test_summary,
+)
+from tests.feature.support.DetectScenario import detect_scenario
+from tests.feature.support.ScenarioDiscovery import ScenarioRef
+
+ROOT = Path(__file__).resolve().parents[2]
+EVIDENCE_DIR = ROOT / ".plan" / "reviews" / "feature-outputs"
+
+logger = get_feature_logger(__name__)
+
+_BAND_RANK = {band: index for index, band in enumerate(CONFIDENCE_BANDS)}
+
+
+def _band_at_least(actual: str, minimum: str) -> bool:
+    return _BAND_RANK.get(actual, len(CONFIDENCE_BANDS)) <= _BAND_RANK.get(
+        minimum, len(CONFIDENCE_BANDS)
+    )
+
+
+def _validate_expected_block(path_stem: str, expected: dict, result) -> None:
+    if not expected:
+        return
+
+    candidates = list(result.candidate_sets)
+    near_misses = list(getattr(result, "rejected_or_near_miss_sets", []) or [])
+    every = candidates + near_misses
+
+    if "candidate_count_min" in expected:
+        assert len(candidates) >= expected["candidate_count_min"], (
+            f"{path_stem}: expected ≥ {expected['candidate_count_min']} candidates, "
+            f"got {len(candidates)}"
+        )
+    if "candidate_count_max" in expected:
+        assert len(candidates) <= expected["candidate_count_max"], (
+            f"{path_stem}: expected ≤ {expected['candidate_count_max']} candidates, "
+            f"got {len(candidates)}"
+        )
+    if "candidate_count_exact" in expected:
+        assert len(candidates) == expected["candidate_count_exact"], (
+            f"{path_stem}: expected exactly {expected['candidate_count_exact']} candidates, "
+            f"got {len(candidates)}"
+        )
+    if expected.get("must_have_no_candidates") is True:
+        assert len(candidates) == 0, (
+            f"{path_stem}: expected zero candidates (negative case), "
+            f"got {len(candidates)}: {[c.candidate_type for c in candidates]}"
+        )
+
+    if "top_candidate_type" in expected:
+        assert candidates, f"{path_stem}: expected a candidate but none emitted"
+        assert candidates[0].candidate_type == expected["top_candidate_type"], (
+            f"{path_stem}: top type {candidates[0].candidate_type!r} ≠ "
+            f"expected {expected['top_candidate_type']!r}"
+        )
+    if "top_confidence_band" in expected:
+        assert candidates, f"{path_stem}: expected a candidate but none emitted"
+        assert candidates[0].confidence_band == expected["top_confidence_band"], (
+            f"{path_stem}: top band {candidates[0].confidence_band!r} ≠ "
+            f"expected {expected['top_confidence_band']!r}"
+        )
+    if "min_confidence_band" in expected:
+        assert candidates, f"{path_stem}: expected a candidate but none emitted"
+        minimum = expected["min_confidence_band"]
+        actual = candidates[0].confidence_band
+        assert _band_at_least(actual, minimum), (
+            f"{path_stem}: top band {actual!r} below minimum {minimum!r}"
+        )
+    if expected.get("min_transaction_confidence") is not None:
+        assert candidates, f"{path_stem}: expected a candidate but none emitted"
+        floor = float(expected["min_transaction_confidence"])
+        for txn in candidates[0].transactions:
+            assert txn.confidence >= floor, (
+                f"{path_stem}: transaction {txn.transaction_id!r} confidence "
+                f"{txn.confidence:.3f} below floor {floor:.3f}"
+            )
+    if expected.get("must_not_classify_as_probable_salary") is True:
+        assert all(c.candidate_type != "probable_salary" for c in every), (
+            f"{path_stem}: at least one candidate is probable_salary but fixture forbids it"
+        )
+    forbidden_types = expected.get("must_not_candidate_types") or []
+    if forbidden_types:
+        seen_types = {c.candidate_type for c in every}
+        for forbidden in forbidden_types:
+            assert forbidden not in seen_types, (
+                f"{path_stem}: forbidden candidate type {forbidden!r} present in {sorted(seen_types)}"
+            )
+
+    must_contain = expected.get("must_contain_transaction_ids", [])
+    if must_contain:
+        if expected.get("must_contain_transaction_ids_ordered", False):
+            assert candidates, (
+                f"{path_stem}: must_contain_transaction_ids_ordered requires at least one candidate"
+            )
+            top_ids = [t.transaction_id for t in candidates[0].transactions]
+            it = iter(top_ids)
+            for tid in must_contain:
+                assert any(seen_id == tid for seen_id in it), (
+                    f"{path_stem}: transaction id {tid!r} not found in order "
+                    f"within top candidate (top ids: {top_ids})"
+                )
+        else:
+            seen = {t.transaction_id for c in every for t in c.transactions}
+            for tid in must_contain:
+                assert tid in seen, f"{path_stem}: expected txn id {tid!r} in some candidate"
+
+    required_warnings = expected.get("expected_warnings") or expected.get(
+        "must_have_warning_codes", []
+    )
+    if required_warnings:
+        warning_codes = {w.code for w in result.warnings}
+        for code in required_warnings:
+            assert code in warning_codes, (
+                f"{path_stem}: expected warning code {code!r}, got {sorted(warning_codes)}"
+            )
+
+    if "near_miss_count_min" in expected:
+        assert len(near_misses) >= expected["near_miss_count_min"], (
+            f"{path_stem}: expected ≥ {expected['near_miss_count_min']} near-miss sets, "
+            f"got {len(near_misses)}"
+        )
+    if "near_miss_count_exact" in expected:
+        assert len(near_misses) == expected["near_miss_count_exact"], (
+            f"{path_stem}: expected exactly {expected['near_miss_count_exact']} near-miss sets, "
+            f"got {len(near_misses)}"
+        )
+    required_near_miss_reasons = expected.get("near_miss_reasons_include", [])
+    if required_near_miss_reasons:
+        actual_reasons = {c.metadata.get("near_miss_reason") for c in near_misses}
+        for reason in required_near_miss_reasons:
+            assert reason in actual_reasons, (
+                f"{path_stem}: expected near_miss_reason {reason!r} in some rejected set, "
+                f"got {sorted(r for r in actual_reasons if r)}"
+            )
+    required_matched_keywords = expected.get("matched_negative_keywords_include", [])
+    if required_matched_keywords:
+        all_matched = {
+            kw for c in near_misses for kw in (c.metadata.get("matched_negative_keywords") or [])
+        }
+        for keyword in required_matched_keywords:
+            assert keyword in all_matched, (
+                f"{path_stem}: expected matched negative keyword {keyword!r} "
+                f"in some near-miss set, got {sorted(all_matched)}"
+            )
+    near_miss_tx_ids = expected.get("near_miss_must_contain_transaction_ids", [])
+    if near_miss_tx_ids:
+        seen_nm = {t.transaction_id for c in near_misses for t in c.transactions}
+        for tid in near_miss_tx_ids:
+            assert tid in seen_nm, f"{path_stem}: expected txn id {tid!r} in some near-miss set"
+
+    expected_phases = expected.get("expected_pipeline_phases", [])
+    if expected_phases:
+        assert result.audit is not None, (
+            f"{path_stem}: expected_pipeline_phases requires include_audit=True"
+        )
+        actual_phases = {s.name for s in result.audit.pipeline_steps}
+        for phase in expected_phases:
+            assert phase in actual_phases, (
+                f"{path_stem}: expected pipeline phase {phase!r}, got {sorted(actual_phases)}"
+            )
+
+    expected_inferred = expected.get("expected_inferred_regions", [])
+    if expected_inferred:
+        actual_inferred = set(getattr(result, "inferred_country_regions", []) or [])
+        for region in expected_inferred:
+            assert region in actual_inferred, (
+                f"{path_stem}: expected inferred region {region!r} in "
+                f"result.inferred_country_regions, got {sorted(actual_inferred)}"
+            )
+
+    expected_missing = expected.get("expected_missing_months", [])
+    if expected_missing:
+        all_gap_summaries = [
+            c.metadata.get("gap_summary", {}) for c in list(result.candidate_sets) + near_misses
+        ]
+        all_missing = {m for gs in all_gap_summaries for m in gs.get("missing_months", [])}
+        for month in expected_missing:
+            assert month in all_missing, (
+                f"{path_stem}: expected missing month {month!r} in gap_summary, "
+                f"got {sorted(all_missing)}"
+            )
+
+
+@pytest.mark.feature
+def test_scenario_fixture(scenario_ref: ScenarioRef) -> None:
+    """Run a single YAML scenario end-to-end for its module detector."""
+    path = scenario_ref.path
+    raw = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+    if scenario_ref.module == "employment" and isinstance(raw.get("transactions"), list):
+        txns = list(raw["transactions"])
+        random.shuffle(txns)
+        raw = {**raw, "transactions": txns}
+
+    if scenario_ref.module == "combination":
+        results = detect_scenario(
+            scenario_ref.module,
+            raw,
+            include_audit=True,
+        )
+        expected_by_module = raw.get("expected_by_module") or {}
+        for mod, expected in expected_by_module.items():
+            if mod in results:
+                _validate_expected_block(f"{path.stem}:{mod}", expected, results[mod])
+        evidence_dir = EVIDENCE_DIR / scenario_ref.module
+        evidence_dir.mkdir(parents=True, exist_ok=True)
+        evidence = {
+            "module": scenario_ref.module,
+            "scenario": path.stem,
+            "modules": list(raw.get("modules") or []),
+            "results": {
+                mod: {
+                    "analysis_id": getattr(res, "analysis_id", None),
+                    "candidate_count": len(res.candidate_sets),
+                }
+                for mod, res in results.items()
+            },
+        }
+        (evidence_dir / f"{path.stem}.json").write_text(
+            json.dumps(evidence, indent=2, default=str) + "\n"
+        )
+        return
+
+    expected = raw.get("expected", {})
+    result = detect_scenario(
+        scenario_ref.module,
+        raw,
+        include_audit=True,
+        **detect_kwargs_from_expected(expected),
+    )
+
+    evidence_dir = EVIDENCE_DIR / scenario_ref.module
+    evidence_dir.mkdir(parents=True, exist_ok=True)
+    evidence = {
+        "module": scenario_ref.module,
+        "analysis_id": getattr(result, "analysis_id", raw.get("analysis_id")),
+        "scenario": path.stem,
+        "input_summary": {
+            "transaction_count": getattr(result.input_summary, "transaction_count", None),
+            "credit_count": getattr(result.input_summary, "credit_count", None),
+            "date_range_start": getattr(result.input_summary, "date_range_start", None),
+            "date_range_end": getattr(result.input_summary, "date_range_end", None),
+        },
+        "candidates": [
+            {
+                "candidate_set_id": c.candidate_set_id,
+                "candidate_type": c.candidate_type,
+                "confidence": c.confidence,
+                "confidence_band": c.confidence_band,
+                "transaction_ids": [t.transaction_id for t in c.transactions],
+                "reasoning": list(getattr(c, "reasoning", []) or []),
+                "risks": list(getattr(c, "risks", []) or []),
+            }
+            for c in result.candidate_sets
+        ],
+        "near_misses": [
+            {
+                "candidate_set_id": c.candidate_set_id,
+                "candidate_type": c.candidate_type,
+                "confidence": c.confidence,
+                "near_miss_reason": c.metadata.get("near_miss_reason"),
+            }
+            for c in getattr(result, "rejected_or_near_miss_sets", []) or []
+        ],
+        "warnings": [{"code": w.code, "detail": w.detail} for w in result.warnings],
+        "inferred_country_regions": list(getattr(result, "inferred_country_regions", []) or []),
+    }
+    (evidence_dir / f"{path.stem}.json").write_text(
+        json.dumps(evidence, indent=2, default=str) + "\n"
+    )
+
+    scenario_id = raw.get("analysis_id", path.stem)
+    try:
+        _validate_expected_block(path.stem, expected, result)
+    finally:
+        log_test_summary(logger, scenario_id, result)
+        log_test_detail(logger, raw, expected, result)
+        log_candidate_dump(logger, scenario_ref.parametrize_id, result)
