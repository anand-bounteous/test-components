+"""Convert typed model fragments to plain dicts for unified CandidateSet wire shapes."""
+
+from __future__ import annotations
+
+from dataclasses import asdict, is_dataclass
+from typing import Any
+
+
+def to_model_dict(value: Any) -> dict[str, Any]:
+    if isinstance(value, dict):
+        return dict(value)
+    if is_dataclass(value):
+        return asdict(value)
+    raise TypeError(f"expected dict or dataclass, got {type(value)!r}")
+
+
+__all__ = ["to_model_dict"]
