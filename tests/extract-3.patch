+"""Public tool functions for hint-amount candidate grouping."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import Any, Literal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.HintAmountGroupingService import (
+    HintAmountGroupingService,
+)
+from nw_agcore_bank_transactions.pipeline.hint_grouping.HintGroupingModels import HintGroupingToolResult
+from nw_agcore_bank_transactions.pipeline.hint_grouping.strategies import (
+    GiftGroupingStrategy,
+    PropertySaleGroupingStrategy,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_core.logging import LogFn
+
+HintGroupingProfile = Literal["gift", "property_sale"]
+
+__all__ = [
+    "HintGroupingTools",
+    "HintGroupingToolResult",
+    "run_generate_hint_candidates",
+]
+
+
+def _strategy_for_profile(profile: HintGroupingProfile, hint_matcher: Any):
+    if profile == "gift":
+        return GiftGroupingStrategy(hint_matcher)
+    if profile == "property_sale":
+        return PropertySaleGroupingStrategy(hint_matcher)
+    raise ValueError(f"unknown hint grouping profile: {profile!r}")
+
+
+class HintGroupingTools(BaseTool[HintGroupingToolResult]):
+    phase_name = "hint_grouping"
+
+    @LogFn
+    def _execute(
+        self,
+        transactions: Sequence[BankTransaction],
+        *,
+        profile: HintGroupingProfile,
+        hint_inputs: Any,
+        hint_matcher: Any = None,
+    ) -> HintGroupingToolResult:
+        strategy = _strategy_for_profile(profile, hint_matcher)
+        service = HintAmountGroupingService(strategy)
+        groups = service.generate_candidates(transactions, hint_inputs)
+        return HintGroupingToolResult(groups=tuple(groups))
+
+
+_default_tool = HintGroupingTools()
+
+
+@tool(
+    name="run_generate_hint_candidates",
+    description="Generate hint-amount candidate groups for gift or property sale.",
+    category="banking.hint_grouping",
+    tags=["banking", "hint_grouping"],
+)
+def run_generate_hint_candidates(
+    transactions: Sequence[BankTransaction],
+    *,
+    profile: HintGroupingProfile,
+    hint_inputs: Any,
+    hint_matcher: Any = None,
+    audit=None,
+    warnings=None,
+) -> HintGroupingToolResult:
+    """Generate grouped candidates from hint amount and timeline constraints."""
+    return _default_tool.run(
+        transactions,
+        audit=audit,
+        warnings=warnings,
