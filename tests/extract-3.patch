+"""Feature tests for RestAgentClient REST round-trip."""
+
+from __future__ import annotations
+
+import importlib
+from unittest.mock import patch
+
+import pytest
+from fastapi import FastAPI
+from httpx import ASGITransport, AsyncClient
+from nw_aglib_toolkit.agent import RestAgentClient
+
+
+def _build_invoke_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.post("/invoke")
+    async def invoke(payload: dict) -> dict:
+        return {"received": payload, "status": "ok"}
+
+    return app
+
+
+@pytest.mark.feature
+async def test_rest_agent_client_round_trip():
+    app = _build_invoke_app()
+    transport = ASGITransport(app=app)
+
+    async with AsyncClient(transport=transport, base_url="http://testserver") as http_client:
+
+        class PatchedAsyncClient:
+            def __init__(self, *args, **kwargs):
+                self._client = http_client
+
+            async def __aenter__(self):
+                return self._client
+
+            async def __aexit__(self, *args):
+                return None
+
+            def post(self, *args, **kwargs):
+                return self._client.post(*args, **kwargs)
+
+        agent_client_mod = importlib.import_module("nw_aglib_toolkit.agent.AgentClient")
+        with patch.object(agent_client_mod.httpx, "AsyncClient", PatchedAsyncClient):
+            client = RestAgentClient("http://testserver")
+            result = await client.invoke({"message": "hello"})
+
+    assert result == {"received": {"message": "hello"}, "status": "ok"}
