+"""Phase 3 — description feature extraction (salary hints, negative signals,
+employer-token extraction)."""
+
+from __future__ import annotations
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    DescriptionFeatureExtractor,
+    load_feature_extraction_config,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models import DescriptionSignalConfig
+from nw_agcore_bank_transactions.pipeline.normalization import default_service
+from nw_aglib_toolkit.pipeline.config import load_config
+
+tokenise = default_service().tokenise
+
+
+@pytest.fixture(scope="module")
+def extractor():
+    app_config = load_config()
+    return DescriptionFeatureExtractor(
+        app_config=app_config,
+        feature_config=load_feature_extraction_config(),
+        description_signals=DescriptionSignalConfig.from_tiered_mapping(
+            app_config.salary_hints_keywords(),
+            app_config.negative_signals(),
+        ),
+    )
+
+
+def _tokens(text: str) -> tuple[str, ...]:
+    return tokenise(text.upper())
+
+
+# --- Salary hints --------------------------------------------------------
+
+
+@pytest.mark.parametrize("hint", ["PAYROLL", "SALARY", "WAGES", "WAGE"])
+def test_strong_salary_hints_detected(extractor, hint):
+    result = extractor.extract(_tokens(f"BACS ACME LTD {hint}"))
+    assert hint in result.salary_hint_tokens
+    assert result.salary_hint_strengths[hint] == "strong"
+
+
+def test_multi_word_strong_hint_staff_pay(extractor):
+    result = extractor.extract(_tokens("BACS ACME STAFF PAY"))
+    assert "STAFF PAY" in result.salary_hint_tokens
+    assert result.salary_hint_strengths["STAFF PAY"] == "strong"
+
+
+def test_multi_word_strong_hint_monthly_pay(extractor):
+    result = extractor.extract(_tokens("BACS ACME MONTHLY PAY"))
+    assert "MONTHLY PAY" in result.salary_hint_tokens
+    assert result.salary_hint_strengths["MONTHLY PAY"] == "strong"
+
+
+def test_medium_hint_employee(extractor):
+    result = extractor.extract(_tokens("BACS ACME EMPLOYEE"))
+    assert "EMPLOYEE" in result.salary_hint_tokens
+    assert result.salary_hint_strengths["EMPLOYEE"] == "medium"
+
+
+def test_weak_hint_credit(extractor):
+    result = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL"))
+    # CREDIT is weak; PAYROLL is strong — both detected.
+    assert "CREDIT" in result.salary_hint_tokens
+    assert result.salary_hint_strengths["CREDIT"] == "weak"
+    assert "PAYROLL" in result.salary_hint_tokens
+
+
+def test_no_salary_hints_in_a_plain_description(extractor):
+    result = extractor.extract(_tokens("ACME LTD"))
+    assert result.salary_hint_tokens == ()
+
+
+# --- Negative signals — every category from FR-009 ----------------------
+
+
+@pytest.mark.parametrize(
+    "phrase,expected_phrase",
+    [
+        ("BACS HMRC TAX REFUND", "HMRC"),
+        ("BACS DWP UNIVERSAL CREDIT", "DWP"),
+        ("BACS UNIVERSAL CREDIT", "UNIVERSAL CREDIT"),
+        ("BACS CHILD BENEFIT", "CHILD BENEFIT"),
+        ("BACS PIP RECEIPT", "PIP"),
+        ("BACS COLD WEATHER PAYMENT", "COLD WEATHER PAYMENT"),
+        ("BACS HMRC REFUND", "HMRC"),
+        ("BACS TAX REFUND PAYMENT", "TAX REFUND"),
+        ("BACS DIVIDEND ACME", "DIVIDEND"),
+        ("BACS INTEREST PAYMENT", "INTEREST"),
+        ("BACS COUPON ACME", "COUPON"),
+        ("BACS PENSION ACME", "PENSION"),
+        ("BACS RETIREMENT FUND", "RETIREMENT"),
+        ("BACS REFUND ACME", "REFUND"),
+        ("BACS REVERSAL ACME", "REVERSAL"),
+        ("BACS CASHBACK ACME", "CASHBACK"),
+        ("BACS CHARGEBACK ACME", "CHARGEBACK"),
+        ("BACS OWN ACCOUNT TRANSFER", "OWN ACCOUNT"),
+        ("BACS SAVINGS TRANSFER", "SAVINGS"),
+        ("BACS TRANSFER FROM SAVINGS", "TRANSFER FROM SAVINGS"),
+        ("BACS LOAN DISBURSEMENT", "LOAN"),
+        ("BACS INSURANCE CLAIM", "INSURANCE"),
+        ("BACS COMPENSATION ACME", "COMPENSATION"),
+        ("FPI RENT FROM SMITH", "RENT"),
+        ("BACS MARKETPLACE PAYOUT", "MARKETPLACE"),
+        ("BACS CRYPTO EXCHANGE", "CRYPTO"),
+    ],
+)
+def test_negative_signals_detected(extractor, phrase, expected_phrase):
+    result = extractor.extract(_tokens(phrase))
+    assert expected_phrase in result.negative_tokens, (
+        f"{expected_phrase!r} not detected in {phrase!r}; got {result.negative_tokens}"
+    )
+
+
+def test_negative_categories_are_reported(extractor):
+    result = extractor.extract(_tokens("BACS DWP UNIVERSAL CREDIT"))
+    assert "government_benefits" in result.negative_categories
+
+
+def test_no_negative_signals_in_plain_salary(extractor):
+    result = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL"))
+    assert result.negative_tokens == ()
+
+
+# --- Employer-token extraction (Design §8.3 examples) -------------------
+
+
+def test_employer_tokens_stable_across_reference_number_variation(extractor):
+    a = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL 123456"))
+    b = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL 789101"))
+    assert a.possible_employer_tokens == b.possible_employer_tokens
+
+
+def test_employer_tokens_dont_include_legal_suffix(extractor):
+    result = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL"))
+    assert "LTD" not in result.possible_employer_tokens
+
+
+def test_employer_tokens_dont_include_channel_words(extractor):
+    result = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL"))
+    for noise in ("BACS", "CREDIT", "PAYROLL", "PAYMENT"):
+        assert noise not in result.possible_employer_tokens
+
+
+def test_employer_tokens_picked_from_design_8_3_examples(extractor):
+    r1 = extractor.extract(_tokens("BACS CREDIT ACME LTD PAYROLL 123456"))
+    r2 = extractor.extract(_tokens("PAYROLL ACME GROUP 789101"))
+    r3 = extractor.extract(_tokens("XYZ SERVICES WAGES"))
+    assert "ACME" in r1.possible_employer_tokens
+    assert "ACME" in r2.possible_employer_tokens
+    # GROUP is on the legal-suffix-like stop list — excluded from employer
+    # tokens (and matches a generic "GROUP" word too). Verify that XYZ /
+    # SERVICES survive.
+    assert "XYZ" in r3.possible_employer_tokens
+    assert "SERVICES" in r3.possible_employer_tokens
+
+
+def test_no_employer_token_when_description_is_only_channel_words(extractor):
+    result = extractor.extract(_tokens("BACS DIRECT CREDIT"))
+    assert result.possible_employer_tokens == ()
+
+
+def test_pure_digit_tokens_are_not_employers(extractor):
+    result = extractor.extract(_tokens("BACS ACME 12345 LTD"))
+    assert "12345" not in result.possible_employer_tokens
+
+
+def test_empty_tokens_returns_empty_result(extractor):
+    result = extractor.extract(())
+    assert result.salary_hint_tokens == ()
+    assert result.negative_tokens == ()
+    assert result.possible_employer_tokens == ()
