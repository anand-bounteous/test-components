+    tool_name = "run_validate_bank_transaction_payload"
+    path = "/validation/validate"
+    tags = ("validation",)
+    summary = "Validate and normalise a salary-extractor payload."
+    openapi_filename = "run_validate_bank_transaction_payload.openapi.yaml"
+    success_response_model = ValidationSuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
