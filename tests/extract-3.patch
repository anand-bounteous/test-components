+from fastapi import APIRouter
+from nw_app_template_api.clients.echo import call_echo
+from nw_app_template_api.config.settings import AppSettings
+
+
+def create_router(settings: AppSettings) -> APIRouter:
+    router = APIRouter(tags=["app"])
+
+    @router.post("/echo")
+    async def echo(payload: dict) -> dict:
+        return await call_echo(settings, payload)
+
+    return router
