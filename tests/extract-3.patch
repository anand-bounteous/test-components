+"""Gift hint-amount scoring profile."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    CandidateSet,
+    CandidateTransaction,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+from nw_agcore_bank_transactions.pipeline.hints.applicators.GiftApplicator import apply_gift_hints
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import employer_hint_bonus
+from nw_agcore_bank_transactions.pipeline.hints.matchers import GiftHintMatcher
+from nw_agcore_bank_transactions.pipeline.hints.matchers.AmountMinimumMatcher import (
+    aggregate_exact,
+    exact_amount,
+)
+from nw_agcore_bank_transactions.pipeline.hints.matchers.DateProximityMatcher import (
+    cluster_min_date_delta,
+    date_proximity_score,
+    neutral_date_score,
+)
+from nw_agcore_bank_transactions.pipeline.hints.matchers.KeywordsMatcher import gift_keyword_score
+from nw_agcore_bank_transactions.pipeline.hints.models import EmployerHints, GiftHints
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+from nw_agcore_bank_transactions.pipeline.scoring.ScoringService import confidence_band
+
+
+def _classify_gift_type(
+    confidence: float,
+    *,
+    meets_minimum: bool,
+    has_gift_signal: bool,
+    thresholds: Mapping[str, Any],
+) -> str:
+    probable = float(thresholds.get("probable_gift", 0.55))
+    possible = float(thresholds.get("possible_gift", 0.40))
+    if confidence >= probable and meets_minimum and has_gift_signal:
+        return "probable_gift"
+    if confidence >= possible:
+        return "possible_gift"
+    return "large_credit_not_gift"
+
+
+def score_gift_groups(
+    groups: Sequence[HintGroupCandidate],
+    *,
+    hint_inputs: GiftHints,
+    features_by_id: Mapping[str, TransactionFeatures],
+    weights: Mapping[str, float],
+    thresholds: Mapping[str, Any],
+    gift_hint_cfg: Mapping[str, Any],
+    positive_keywords: Sequence[str],
+    negative_keywords: Sequence[str],
+    hint_matcher: GiftHintMatcher,
+) -> list[CandidateSet]:
+    if hint_inputs.amount is None:
+        return []
+
+    hint_amount = hint_inputs.amount
+    hint_cfg = load_hint_config()
+    tolerance_days = hint_matcher.effective_tolerance_days(hint_inputs)
+
+    scored: list[CandidateSet] = []
+    for group in groups:
+        cluster = list(group.transactions)
+        if not cluster:
+            continue
+
+        applied = apply_gift_hints(
+            cluster,
+            hint_inputs,
+            hint_matcher,
+            expected_date=group.expected_date,
+            aggregate_sum=group.aggregate_sum,
+            cluster=cluster,
+        )
+
+        total = group.aggregate_sum
+        amount_min_score = 1.0 if applied.aggregate_meets_minimum else 0.0
+
+        exact_bonus_flag = 0.0
+        overpayment_mod = 1.0
+        if len(cluster) == 1 and exact_amount(cluster[0].amount, hint_amount):
+            exact_bonus_flag = 1.0
+        elif aggregate_exact(total, hint_amount):
+            exact_bonus_flag = 1.0
+        elif applied.aggregate_meets_minimum and total > hint_amount:
+            overpayment_mod = float(gift_hint_cfg.get("overpayment_modifier", 0.95))
+
+        keyword_score = max(
+            gift_keyword_score(t.normalised_description, positive_keywords, negative_keywords)
+            for t in cluster
+        )
+
+        donor_bonus = 0.0
+        if hint_inputs.donor_name:
+            tokens = frozenset(tok for t in cluster for tok in t.description_tokens)
+            donor_bonus = employer_hint_bonus(
+                tokens,
+                EmployerHints(current_employer=hint_inputs.donor_name),
+                hint_cfg,
+            )
+
+        if group.expected_date is not None:
+            delta = cluster_min_date_delta(cluster, group.expected_date)
+            date_score = date_proximity_score(delta, tolerance_days)
+        else:
+            date_score = neutral_date_score()
+
+        channel_scores = []
+        for t in cluster:
+            feat = features_by_id.get(t.id)
+            if feat is not None:
+                channel_scores.append(float(feat.payment_channel_confidence))
+        channel_score = sum(channel_scores) / len(channel_scores) if channel_scores else 0.5
+
+        weighted = (
+            weights.get("amount_minimum_score", 0.35) * amount_min_score
+            + weights.get("exact_amount_bonus_weight", 0.15) * exact_bonus_flag
+            + weights.get("gift_keyword_score", 0.20) * keyword_score
+            + weights.get("donor_hint_bonus", 0.15) * donor_bonus
+            + weights.get("date_proximity_score", 0.10) * date_score
+            + weights.get("payment_channel_score", 0.05) * channel_score
+        )
+        final_score = round(min(1.0, max(0.0, weighted * overpayment_mod)), 6)
+
+        if (
+            exact_bonus_flag > 0
+            and keyword_score > 0
+            and final_score >= float(gift_hint_cfg.get("exact_gift_match_min_base_score", 0.45))
+        ):
+            within_date = (
+                group.expected_date is None
+                or cluster_min_date_delta(cluster, group.expected_date) <= tolerance_days
+            )
+            if within_date:
+                final_score = max(
+                    final_score,
+                    float(gift_hint_cfg.get("exact_gift_match_floor", 0.85)),
+                )
+
+        if applied.donor_match_level == "exact" and final_score >= float(
+            gift_hint_cfg.get("donor_match_min_base_score", 0.45)
+        ):
+            final_score = max(
+                final_score, float(gift_hint_cfg.get("donor_exact_match_floor", 0.92))
+            )
+        elif applied.donor_match_level == "partial" and final_score >= float(
+            gift_hint_cfg.get("donor_match_min_base_score", 0.45)
+        ):
+            final_score = max(
+                final_score, float(gift_hint_cfg.get("donor_partial_match_floor", 0.85))
+            )
+
+        has_gift_signal = keyword_score > 0.0 or applied.donor_match_level != "none"
+        candidate_type = _classify_gift_type(
+            final_score,
+            meets_minimum=applied.aggregate_meets_minimum,
+            has_gift_signal=has_gift_signal,
+            thresholds=thresholds,
+        )
+        band = confidence_band(final_score)
+
+        score_breakdown = {
+            "amount_minimum_score": round(amount_min_score, 6),
+            "exact_amount_bonus": round(
+                exact_bonus_flag * float(gift_hint_cfg.get("exact_amount_bonus", 0.15)),
+                6,
+            ),
+            "gift_keyword_score": keyword_score,
+            "donor_hint_bonus": donor_bonus,
+            "date_proximity_score": round(date_score, 6),
+            "payment_channel_score": round(channel_score, 6),
+            "overpayment_modifier": overpayment_mod,
+            "final_score": final_score,
+        }
+        min_delta = applied.date_delta_days if applied.date_delta_days is not None else 0
+        detected_pattern = {
+            "expected_date": applied.expected_date,
+            "min_date_delta_days": min_delta,
+            "aggregate_amount": float(total),
+            "hint_amount": float(hint_amount),
+            "transaction_count": len(cluster),
+            "exact_amount_match": applied.exact_amount_match,
+        }
+        scored.append(
+            CandidateSet(
+                candidate_set_id=group.candidate_set_id,
+                candidate_type=candidate_type,
+                transactions=tuple(
+                    CandidateTransaction(
+                        date=t.date.isoformat(),
+                        description=t.normalised_description,
+                        amount=float(t.amount),
+                        transaction_id=t.id,
+                        confidence=final_score,
+                        confidence_band=band,
+                    )
+                    for t in cluster
+                ),
+                score_breakdown=score_breakdown,
+                detected_pattern=detected_pattern,
+                reasoning=group.reasoning,
+                confidence=final_score,
+                confidence_band=band,
+                metadata={
+                    "donor_match_level": applied.donor_match_level,
+                    "cluster_key": group.cluster_key,
+                },
+            )
+        )
+    return scored
