+def run_benchmark_suite(
+    pdf_path: str | Path,
+    *,
+    output_root: str | Path,
+    run_id: str | None = None,
+    dpi: int = 300,
+) -> BenchmarkRunManifest:
+    pdf_path = Path(pdf_path)
+    output_root = Path(output_root)
+    run_id = run_id or new_run_id()
+    run_dir = output_root / run_id
+    run_dir.mkdir(parents=True, exist_ok=True)
+
+    started_at = utc_now()
+    pdf_kind = _detect_pdf_kind(pdf_path)
+    doc_dest = copy_document(pdf_path, run_dir)
+
+    audit = AuditRecorder()
+    with audit.time("rasterize", "pymupdf", inputs=[str(doc_dest)]):
+        raster_pages = _raster_pages_for_run(doc_dest, run_dir, dpi=dpi)
+
+    manifest = BenchmarkRunManifest(
+        run_id=run_id,
+        document=BenchmarkDocumentInfo(
+            document_id=f"upload:{pdf_path.name}",
+            filename=pdf_path.name,
+            pdf_kind=pdf_kind,  # type: ignore[arg-type]
+            n_pages=len(raster_pages),
+            pdf_path=f"document/{pdf_path.name}",
+        ),
+        solution_names=list(SOLUTION_NAMES),
+        started_at=started_at,
+        run_dir=str(run_dir),
+    )
+
+    runners = [
+        ("native_pdfplumber", run_native_pdfplumber),
+        ("native_pymupdf", run_native_pymupdf),
+        ("img2table_doctr", run_img2table_doctr),
+        ("doctr_baseline", run_doctr_baseline),
+    ]
+
+    for name, runner in runners:
+        sol_started = utc_now()
+        t0 = time.perf_counter()
+        try:
+            result = runner(
+                doc_dest,
+                run_dir=run_dir,
+                raster_pages=raster_pages,
+                pdf_kind=pdf_kind,
+                dpi=dpi,
+            )
+            duration_ms = (time.perf_counter() - t0) * 1000
+            manifest.solution_status[name] = SolutionStatusEntry(
+                state="done",
+                queued_at=started_at,
+                started_at=sol_started,
+                updated_at=utc_now(),
+                result_status=result.status,
+                overall_confidence=result.overall_confidence,
+                duration_ms=duration_ms,
+                n_pages_done=len(result.pages),
+                n_pages_expected=len(raster_pages),
+            )
+            manifest.completed.append(name)
+        except Exception as exc:
+            duration_ms = (time.perf_counter() - t0) * 1000
+            manifest.solution_status[name] = SolutionStatusEntry(
+                state="error",
+                queued_at=started_at,
+                started_at=sol_started,
+                updated_at=utc_now(),
+                result_status="error",
+                duration_ms=duration_ms,
+                error=f"{type(exc).__name__}: {exc}",
+                n_pages_expected=len(raster_pages),
+            )
+
+    manifest.status = "done" if len(manifest.completed) == len(SOLUTION_NAMES) else "error"
+    manifest.updated_at = utc_now()
+    manifest.finished_at = manifest.updated_at
+    write_run_manifest(run_dir / "run.json", manifest.to_run_json())
+    return manifest
