+  const [runs, setRuns] = useState<RunSummary[]>([]);
+  const [selectedRunId, setSelectedRunId] = useState("");
+  const [viewModel, setViewModel] = useState<BenchmarkRunViewModel | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const refreshRuns = useCallback(async () => {
+    const summaries = await fetchRunSummaries();
+    setRuns(summaries);
+    if (!selectedRunId && summaries.length > 0) {
+      setSelectedRunId(summaries[0].runId);
+    }
+  }, [selectedRunId]);
+
+  useEffect(() => {
+    refreshRuns().catch((err: unknown) => {
+      setError(err instanceof Error ? err.message : "Failed to list runs");
+    });
+  }, [refreshRuns]);
+
+  const loadRun = useCallback(async (runId: string) => {
+    if (!runId) {
+      setViewModel(null);
+      return;
+    }
+
+    setLoading(true);
+    setError(null);
+    try {
+      const model = await loadBenchmarkRun(runId);
+      setViewModel(model);
+    } catch (err: unknown) {
+      setViewModel(null);
+      setError(err instanceof Error ? err.message : "Failed to load run");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (selectedRunId) {
+      loadRun(selectedRunId);
+    }
+  }, [selectedRunId, loadRun]);
+
+  const manifestSummary = useMemo(() => {
+    if (!viewModel) return null;
+    const doc = viewModel.manifest.document;
+    const completed = viewModel.manifest.completed ?? [];
+    return {
+      status: viewModel.manifest.status,
+      filename: doc?.filename ?? "unknown",
+      pages: doc?.n_pages ?? 0,
+      completed: completed.length,
+    };
+  }, [viewModel]);
+
+  const extractions = viewModel?.extractions ?? {};
+  const audits = viewModel?.audits ?? {};
+  const hasExtractions = Object.keys(extractions).length > 0;
+
+  return (
+    <div className="app-shell">
+      <header className="app-header">
+        <h1>Document Data Extractor — Benchmark Review</h1>
+        <div className="controls">
+          <label htmlFor="run-select">
+            Run
+            <select
+              id="run-select"
+              value={selectedRunId}
+              onChange={(event) => setSelectedRunId(event.target.value)}
+              disabled={loading || runs.length === 0}
+            >
+              {runs.length === 0 ? (
+                <option value="">No runs found</option>
+              ) : (
+                runs.map((run) => (
+                  <option key={run.runId} value={run.runId}>
+                    {run.runId} · {run.status} · {run.completed.length}/4
+                  </option>
+                ))
+              )}
+            </select>
+          </label>
+          <button type="button" onClick={() => refreshRuns()} disabled={loading}>
+            Refresh runs
+          </button>
+          <button
+            type="button"
+            onClick={() => loadRun(selectedRunId)}
+            disabled={!selectedRunId || loading}
+          >
+            Reload
+          </button>
+        </div>
+      </header>
+
+      <main className="app-main">
+        {error && <div className="status-banner error">{error}</div>}
+        {loading && <div className="status-banner loading">Loading run…</div>}
+
+        {manifestSummary && !loading && (
+          <div className="status-banner">
+            <strong>{viewModel?.runId}</strong>
+            <div className="run-meta">
+              <span>Status: {manifestSummary.status}</span>
+              <span>Document: {manifestSummary.filename}</span>
+              <span>Pages: {manifestSummary.pages}</span>
+              <span>Completed: {manifestSummary.completed}/4</span>
+            </div>
+          </div>
+        )}
+
+        {!loading && !error && selectedRunId && !hasExtractions && (
+          <div className="empty-state">
+            Run <code>{selectedRunId}</code> has no extractor results yet. Run{" "}
+            <code>npm run test:document-data-extractor:feature</code> to generate output.
+          </div>
+        )}
+
+        {hasExtractions && !loading && (
+          <ExtractorBenchmarkPage extractions={extractions} audits={audits} />
+        )}
+      </main>
+    </div>
+  );
+}
