+"""Phase 6 — fixed day-of-month payday model."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._services.recurrence import (
+    PaydayModel,
+    fit_best_recurrence_model,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_core.calendar import WorkingDayCalendar
+
+
+@pytest.fixture(scope="module")
+def cal():
+    return WorkingDayCalendar()
+
+
+def _txn(tid, d):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=d.isoformat(),
+            description="FPI ACME LTD SALARY",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal("2500"),
+        )
+    )
+
+
+def test_fixed_15th_perfect(cal):
+    dates = [date(2024, m, 15) for m in range(1, 13)]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    # Fixed-day series where the 15th is always a working day looks both
+    # like FIXED_DAY_N and nearest_working_day_of_15 with zero deviation —
+    # the tie-break favours the more specific model (nearest/prev/next
+    # share specificity 9 with FIXED at 5). Whichever wins, the parameter
+    # must be 15.
+    assert fit.parameter_n == 15
+    assert fit.fit_score == pytest.approx(1.0)
+    assert fit.matched_count == 12
+
+
+def test_fixed_day_clamps_to_month_end_for_short_months(cal):
+    """When N exceeds days-in-month (e.g. 31st in Feb), the predictor
+    clamps to month-end. The fit still scores high.
+
+    A series that always hits the *last calendar day* of each month
+    matches FIXED_DAY_N (with N=31 clamped) AND LAST_CALENDAR_DAY equally
+    well; specificity tie-break makes LAST_CALENDAR_DAY win. Both
+    answers are correct for this dataset.
+    """
+    txns = [
+        _txn("t01", date(2024, 1, 31)),
+        _txn("t02", date(2024, 2, 29)),  # Feb 31 → 29 (leap year)
+        _txn("t03", date(2024, 3, 31)),
+        _txn("t04", date(2024, 4, 30)),  # April 31 → 30
+        _txn("t05", date(2024, 5, 31)),
+    ]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model in {PaydayModel.LAST_CALENDAR_DAY, PaydayModel.FIXED_DAY_N}
+    assert fit.fit_score >= 0.85
+
+
+def test_fixed_day_loses_to_nearest_working_when_credits_shift(cal):
+    """When credits actively *avoid* weekends/holidays, nearest_working
+    is the right model."""
+    txns = [
+        _txn("t01", date(2024, 1, 25)),
+        _txn("t02", date(2024, 2, 23)),  # 25 Feb 2024 = Sun → prev wd Fri
+        _txn("t03", date(2024, 3, 25)),
+        _txn("t04", date(2024, 4, 25)),
+        _txn("t05", date(2024, 5, 24)),  # 25 May Sat → prev wd Fri
+        _txn("t06", date(2024, 6, 25)),
+    ]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    # Either NEAREST or PREVIOUS_WORKING_DAY_OF_N is acceptable — both
+    # predict the actual dates exactly.
+    assert fit.model in {
+        PaydayModel.NEAREST_WORKING_DAY_OF_N,
+        PaydayModel.PREVIOUS_WORKING_DAY_OF_N,
+    }
+    assert fit.parameter_n == 25
+
+
+def test_fixed_day_emits_n_via_mode_of_day_of_month(cal):
+    """When the dates split between two days-of-month, the mode wins."""
+    txns = [
+        _txn("t01", date(2024, 1, 15)),
+        _txn("t02", date(2024, 2, 15)),
+        _txn("t03", date(2024, 3, 15)),
+        _txn("t04", date(2024, 4, 20)),  # outlier; mode is still 15
+        _txn("t05", date(2024, 5, 15)),
+    ]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.parameter_n == 15
