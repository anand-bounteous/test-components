+"""Filter gift credit groups using debit rows from the full statement."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+
+
+@dataclass(frozen=True)
+class _DebitRow:
+    txn_date: date
+    amount: Decimal
+
+
+def _coerce_decimal(value: Decimal | int | float | str) -> Decimal:
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def debit_rows(transactions: Sequence[RawBankTransaction]) -> tuple[_DebitRow, ...]:
+    rows: list[_DebitRow] = []
+    for txn in transactions:
+        debit = _coerce_decimal(txn.debit_amount)
+        if debit > 0:
+            rows.append(_DebitRow(date.fromisoformat(txn.date), debit))
+    return tuple(rows)
+
+
+def credit_blocked_by_debit(
+    credit: BankTransaction,
+    debits: Sequence[_DebitRow],
+    *,
+    reversal_window_days: int,
+) -> bool:
+    amount = credit.amount
+    credit_date = credit.date
+    for debit in debits:
+        if debit.amount != amount:
+            continue
+        if debit.txn_date == credit_date:
+            return True
+        if (
+            debit.txn_date > credit_date
+            and (debit.txn_date - credit_date).days <= reversal_window_days
+        ):
+            return True
+    return False
+
+
+def filter_groups_by_debit_guards(
+    groups: Sequence[HintGroupCandidate],
+    *,
+    all_transactions: Sequence[RawBankTransaction],
+    reversal_window_days: int,
+) -> list[HintGroupCandidate]:
+    debits = debit_rows(all_transactions)
+    if not debits:
+        return list(groups)
+
+    kept: list[HintGroupCandidate] = []
+    for group in groups:
+        if any(
+            credit_blocked_by_debit(
+                credit,
+                debits,
+                reversal_window_days=reversal_window_days,
+            )
+            for credit in group.transactions
+        ):
+            continue
+        kept.append(group)
+    return kept
+
+
+__all__ = [
+    "credit_blocked_by_debit",
+    "debit_rows",
+    "filter_groups_by_debit_guards",
+]
