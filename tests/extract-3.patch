+"""Test fixture wrapper — raw YAML metadata plus typed detect payload."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import yaml
+from nw_agcore_bank_transactions.pipeline._models.requests import BankTransactionRequest
+
+from tests.feature.support.DetectFromFixture import transactions_absence_from_raw
+from tests.feature.support.PayloadIo import parse_payload
+
+
+@dataclass(frozen=True)
+class FixtureScenario:
+    """Fixture dict for logging/filtering plus production ``BankTransactionRequest``."""
+
+    raw: dict[str, Any]
+    payload: BankTransactionRequest
+
+    @property
+    def scenario_description(self) -> str:
+        return str(self.raw.get("scenario_description", ""))
+
+    @property
+    def scenario_tags(self) -> tuple[str, ...]:
+        return tuple(str(t) for t in (self.raw.get("scenario_tags") or []))
+
+    @property
+    def explicit_country_region(self) -> bool:
+        return "country_region" in self.raw
+
+    @property
+    def transactions_state(self) -> str:
+        absence = transactions_absence_from_raw(self.raw)
+        if absence == "missing":
+            return "missing"
+        if absence == "null":
+            return "null"
+        return "present"
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any]) -> FixtureScenario:
+        raw = dict(data)
+        return cls(raw=raw, payload=parse_payload(raw))
+
+    @classmethod
+    def from_path(cls, path: Path) -> FixtureScenario:
+        return cls.from_mapping(yaml.safe_load(path.read_text()) or {})
+
+    def __iter__(self) -> Iterator[Any]:
+        yield self.raw
+        yield self.payload
+
+
+__all__ = ["FixtureScenario"]
