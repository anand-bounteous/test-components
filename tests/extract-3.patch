+"""Project payslip anchor matches onto embedded transaction features."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import replace
+
+from .._models import BankTransaction, TransactionFeatures
+
+
+def attach_anchor_flags(
+    transactions: Iterable[BankTransaction],
+    anchor_txn_ids: dict[str, str],
+    *,
+    ambiguous_ids: set[str] | None = None,
+) -> tuple[BankTransaction, ...]:
+    """Return transactions with anchor flags set on embedded features."""
+    ambiguous_ids = ambiguous_ids or set()
+    updated: list[BankTransaction] = []
+    for txn in transactions:
+        features = txn.features
+        if features is None:
+            updated.append(txn)
+            continue
+        if features.transaction_id in anchor_txn_ids:
+            updated.append(
+                replace(
+                    txn,
+                    features=replace(
+                        features,
+                        is_anchor=True,
+                        anchor_hint_id=anchor_txn_ids[features.transaction_id],
+                        ambiguous_anchor=features.transaction_id in ambiguous_ids,
+                    ),
+                )
+            )
+        else:
+            updated.append(txn)
+    return tuple(updated)
+
+
+def features_from_transactions(
+    transactions: Iterable[BankTransaction],
+) -> tuple[TransactionFeatures, ...]:
+    """Collect feature records from enhanced transactions."""
+    return tuple(t.features for t in transactions if t.features is not None)
