+"""REST route for skeleton grouping."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import SkeletonGroupingRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import (
+    bank_transactions_from_wire,
+    features_by_id_from_wire,
+)
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..SkeletonGroupingTools import run_emit_skeleton_candidates
+
+
+class SkeletonGroupingRoute(BaseToolRoute):
+    tool_name = "run_emit_skeleton_candidates"
+    path = "/skeleton/emit"
+    tags = ("skeleton",)
+    summary = "Generate skeleton salary candidate sets."
+    openapi_filename = "run_emit_skeleton_candidates.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def emit_skeleton(body: SkeletonGroupingRequest):
+            try:
+                ctx = build_context(body)
+                audit = build_audit(body)
+                result = run_emit_skeleton_candidates(
+                    bank_transactions_from_wire(body.normalised),
+                    features_by_id_from_wire(body.features_by_id),
+                    config=ctx.config,
+                    threshold=body.threshold,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
