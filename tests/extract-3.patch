+"""Enhanced bank transaction — normalised caller record plus optional features."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import date
+from decimal import Decimal
+
+from .BankTransactionMetadata import BankTransactionMetadata
+from .RawBankTransaction import RawBankTransaction, _amount_as_decimal
+from .TransactionFeatures import TransactionFeatures
+
+
+@dataclass(frozen=True)
+class BankTransaction:
+    """Enhanced view of a :class:`RawBankTransaction` for pipeline processing.
+
+    Carries parsed/normalised description fields plus optional
+    :class:`TransactionFeatures`. ``raw`` is immutable (frozen
+    :class:`RawBankTransaction`); this wrapper is also frozen so neither the
+    reference nor the underlying row state can change after construction.
+    """
+
+    raw: RawBankTransaction
+    normalised_description: str
+    description_tokens: tuple[str, ...]
+    skeleton: str
+    metadata: BankTransactionMetadata = field(default_factory=BankTransactionMetadata)
+    features: TransactionFeatures | None = None
+
+    @property
+    def id(self) -> str:
+        return self.raw.id
+
+    @property
+    def date(self) -> date:
+        return date.fromisoformat(self.raw.date)
+
+    @property
+    def amount(self) -> Decimal:
+        """Credit amount for salary pipeline rows."""
+        return _amount_as_decimal(self.raw.credit_amount) or Decimal(0)
+
+    @property
+    def raw_description(self) -> str:
+        return self.raw.description
