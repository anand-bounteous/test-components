+"""Helpers for invoking detectors from fixture files."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+
+def detect_kwargs_from_expected(expected: Mapping[str, Any] | None) -> dict[str, Any]:
+    """Read optional detector kwargs stored under ``expected.detect_kwargs``."""
+    if not expected:
+        return {}
+    raw = expected.get("detect_kwargs") or {}
+    if not isinstance(raw, Mapping):
+        return {}
+    kw: dict[str, Any] = {}
+    if "max_candidates" in raw:
+        kw["max_candidates"] = int(raw["max_candidates"])
+    if "max_near_misses" in raw:
+        kw["max_near_misses"] = int(raw["max_near_misses"])
+    if "return_threshold" in raw:
+        kw["return_threshold"] = float(raw["return_threshold"])
+    if "mode" in raw:
+        kw["mode"] = str(raw["mode"])
+    return kw
