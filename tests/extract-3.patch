+"""Unit tests for bonus/expense split service."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import CandidateSet, CandidateTransaction
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.bonus_expense_split.BonusExpenseSplitService import BonusExpenseSplitService
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+
+
+def _norm_txn(tid: str, desc: str, amount: str = "2500"):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date="2024-01-15",
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _cand(*txn_ids: str) -> CandidateSet:
+    return CandidateSet(
+        candidate_set_id="c1",
+        candidate_type="unknown_recurring_credit",
+        transactions=tuple(
+            CandidateTransaction(transaction_id=tid, date="2024-01-15", description="PAY", amount=2500.0)
+            for tid in txn_ids
+        ),
+        score_breakdown={},
+        detected_pattern={},
+        confidence=0.6,
+        confidence_band="medium",
+    )
+
+
+@pytest.mark.unit
+def test_split_creates_main_and_bonus_subcandidates():
+    normalised = (
+        _norm_txn("t1", "ACME PAYROLL"),
+        _norm_txn("t2", "ACME PAYROLL"),
+        _norm_txn("t3", "BONUS PAYMENT"),
+    )
+    pool = (_cand("t1", "t2", "t3"),)
+    result = BonusExpenseSplitService().split_bonus_and_expense_credits(pool, normalised)
+    assert len(result) == 2
+    ids = {c.candidate_set_id for c in result}
+    assert any("_main" in cid for cid in ids)
+    assert any("_bonus_" in cid for cid in ids)
+
+
+@pytest.mark.unit
+def test_no_split_when_only_flagged_rows():
+    normalised = (_norm_txn("t1", "BONUS PAYMENT"),)
+    pool = (_cand("t1"),)
+    result = BonusExpenseSplitService().split_bonus_and_expense_credits(pool, normalised)
+    assert len(result) == 1
+    assert result[0].candidate_set_id == "c1"
