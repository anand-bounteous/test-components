+from fastapi import APIRouter, WebSocket
+from nw_agent_core_template.core.agent import TemplateAgent
+
+ws_router = APIRouter()
+_agent = TemplateAgent()
+
+
+@ws_router.websocket("/invoke/ws")
+async def invoke_ws(websocket: WebSocket) -> None:
+    await websocket.accept()
+    data = await websocket.receive_json()
+    await websocket.send_json({"status": "processing"})
+    result = await _agent.invoke(data)
+    await websocket.send_json({"status": "complete", "result": result})
