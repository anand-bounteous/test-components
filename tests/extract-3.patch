+"""Normalization tool configuration."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from importlib import resources
+
+import yaml
+
+from .NormalizationTextPatterns import NormalizationTextPatterns
+from .SchemaValidationSettings import SchemaValidationSettings
+
+_NORMALIZATION_PACKAGE = "nw_agcore_bank_transactions.pipeline.normalization"
+
+
+class NormalizationConfigError(ValueError):
+    """Raised when normalization_config.yaml cannot be loaded or parsed."""
+
+
+@dataclass(frozen=True)
+class NormalizationConfig:
+    generic_stop_tokens: frozenset[str]
+    legal_suffix_map: tuple[tuple[str, str], ...]
+    empty_skeleton_placeholder: str
+    default_currency: str
+    default_direction: str
+    schema_validation: SchemaValidationSettings
+    text_patterns: NormalizationTextPatterns
+
+
+def _default_config_path() -> str:
+    return str(resources.files(_NORMALIZATION_PACKAGE) / "config" / "normalization_config.yaml")
+
+
+def _require_regex(raw: Mapping[str, object], key: str) -> re.Pattern[str]:
+    value = raw.get(key)
+    if not isinstance(value, str) or not value.strip():
+        raise NormalizationConfigError(f"text_patterns.{key} must be a non-empty string")
+    try:
+        return re.compile(value)
+    except re.error as exc:
+        raise NormalizationConfigError(f"text_patterns.{key} is not a valid regex") from exc
+
+
+def load_normalization_config(
+    config_path: str | None = None,
+) -> NormalizationConfig:
+    path = config_path or _default_config_path()
+    try:
+        raw = yaml.safe_load(open(path, encoding="utf-8"))
+    except OSError as exc:
+        raise NormalizationConfigError(f"unable to read normalization config: {path}") from exc
+    except yaml.YAMLError as exc:
+        raise NormalizationConfigError(f"invalid YAML in normalization config: {path}") from exc
+
+    if not isinstance(raw, Mapping):
+        raise NormalizationConfigError("normalization config root must be a mapping")
+
+    stop_tokens = raw.get("generic_stop_tokens")
+    if not isinstance(stop_tokens, list) or not stop_tokens:
+        raise NormalizationConfigError("generic_stop_tokens must be a non-empty list")
+
+    suffix_map_raw = raw.get("legal_suffix_map")
+    if not isinstance(suffix_map_raw, list) or not suffix_map_raw:
+        raise NormalizationConfigError("legal_suffix_map must be a non-empty list")
+
+    legal_suffix_map: list[tuple[str, str]] = []
+    for entry in suffix_map_raw:
+        if not isinstance(entry, Mapping):
+            raise NormalizationConfigError("legal_suffix_map entries must be mappings")
+        long = entry.get("long")
+        short = entry.get("short")
+        if not isinstance(long, str) or not isinstance(short, str) or not long or not short:
+            raise NormalizationConfigError("legal_suffix_map entries require non-empty long/short")
+        legal_suffix_map.append((long, short))
+
+    empty_placeholder = raw.get("empty_skeleton_placeholder")
+    default_currency = raw.get("default_currency")
+    default_direction = raw.get("default_direction")
+    for key, value in (
+        ("empty_skeleton_placeholder", empty_placeholder),
+        ("default_currency", default_currency),
+        ("default_direction", default_direction),
+    ):
+        if not isinstance(value, str) or not value:
+            raise NormalizationConfigError(f"{key} must be a non-empty string")
+
+    schema_validation_raw = raw.get("schema_validation", {})
+    if not isinstance(schema_validation_raw, Mapping):
+        raise NormalizationConfigError("schema_validation must be a mapping")
+    enabled = schema_validation_raw.get("enabled", True)
+    strict = schema_validation_raw.get("strict", True)
+    if not isinstance(enabled, bool):
+        raise NormalizationConfigError("schema_validation.enabled must be a boolean")
+    if not isinstance(strict, bool):
+        raise NormalizationConfigError("schema_validation.strict must be a boolean")
+
+    text_patterns_raw = raw.get("text_patterns")
+    if not isinstance(text_patterns_raw, Mapping):
+        raise NormalizationConfigError("text_patterns must be a mapping")
+
+    return NormalizationConfig(
+        generic_stop_tokens=frozenset(str(token) for token in stop_tokens),
+        legal_suffix_map=tuple(legal_suffix_map),
+        empty_skeleton_placeholder=empty_placeholder,
+        default_currency=default_currency,
+        default_direction=default_direction,
+        schema_validation=SchemaValidationSettings(enabled=enabled, strict=strict),
+        text_patterns=NormalizationTextPatterns(
+            punct=_require_regex(text_patterns_raw, "punct"),
+            whitespace=_require_regex(text_patterns_raw, "whitespace"),
+            long_digit_token=_require_regex(text_patterns_raw, "long_digit_token"),
+            trailing_digits=_require_regex(text_patterns_raw, "trailing_digits"),
+        ),
+    )
