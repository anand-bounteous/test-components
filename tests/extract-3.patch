+import os
+from pathlib import Path
+
+import typer
+import uvicorn
+from nw_app_template_api.app.bootstrap import build_runtime
+
+app_cli = typer.Typer()
+
+
+def _component_root() -> Path:
+    return Path(__file__).resolve().parents[3]
+
+
+@app_cli.command()
+def run(env: str = typer.Option("dev", "--env", help="Environment: dev|qa|uat|prod")) -> None:
+    os.environ["NW_ENV"] = env
+    root = _component_root()
+    runtime, settings, _manifest = build_runtime(root)
+
+    if runtime.app is not None:
+        typer.echo(f"Starting REST on {settings.host}:{settings.port}")
+        uvicorn.run(runtime.app, host=settings.host, port=settings.port)
+    else:
+        typer.echo("No exposures enabled in deployment.yaml")
+
+
+if __name__ == "__main__":
+    app_cli()
