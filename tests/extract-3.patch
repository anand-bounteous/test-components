+"""Application-specific description keyword signals for feature extraction."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class DescriptionSignalConfig:
+    """Positive and negative description tokens supplied by the calling application."""
+
+    positive_by_strength: dict[str, tuple[str, ...]]
+    negative_by_category: dict[str, tuple[str, ...]]
+
+    @classmethod
+    def from_tiered_mapping(
+        cls,
+        positive: Mapping[str, Iterable[str]],
+        negative: Mapping[str, Iterable[str]],
+    ) -> DescriptionSignalConfig:
+        return cls(
+            positive_by_strength={
+                str(k): tuple(str(t).strip().upper() for t in v if str(t).strip())
+                for k, v in positive.items()
+            },
+            negative_by_category={
+                str(k): tuple(str(t).strip().upper() for t in v if str(t).strip())
+                for k, v in negative.items()
+            },
+        )
+
+    @classmethod
+    def from_flat_keywords(
+        cls,
+        positive: Iterable[str],
+        negative: Iterable[str],
+    ) -> DescriptionSignalConfig:
+        pos = tuple(str(t).strip().upper() for t in positive if str(t).strip())
+        neg = tuple(str(t).strip().upper() for t in negative if str(t).strip())
+        return cls(
+            positive_by_strength={"strong": pos, "medium": (), "weak": ()},
+            negative_by_category={"application_negative": neg} if neg else {},
+        )
+
+
+__all__ = ["DescriptionSignalConfig"]
