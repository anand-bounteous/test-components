+"""REST route for the end-to-end salary detector tool."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from nw_agbus_salary_extractor.channels.tools.SalaryTransactionExtractorTools import (
+    detect_salary_candidates,
+)
+from nw_agbus_salary_extractor.channels.rest.ApiModels import DetectSalaryRequest
+from nw_agbus_salary_extractor.channels.rest.ApiResponseModels import DetectSalarySuccessResponse
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agbus_salary_extractor.services.SalaryRequestParsing import salary_request_from_mapping
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_context,
+    error_response,
+    success_response,
+)
+
+
+class SalaryDetectRoute(BaseToolRoute):
+    tool_name = "detect_salary_candidates"
+    path = "/salary/detect"
+    tags = ("salary",)
+    summary = "Run the full salary-transaction detection pipeline."
+    openapi_filename = "detect_salary_candidates.openapi.yaml"
+    success_response_model = DetectSalarySuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
+        def detect_salary(body: DetectSalaryRequest):
+            try:
+                ctx = build_context(body)
+                payload = salary_request_from_mapping(body.model_dump())
+                result = detect_salary_candidates(
+                    payload,
+                    config=ctx.config,
+                    calendar=ctx.calendar,
+                    mode=payload.validation_mode,
+                    max_candidates=body.max_candidates,
+                    max_near_misses=body.max_near_misses,
+                    return_threshold=body.return_threshold,
+                    include_audit=body.include_audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
