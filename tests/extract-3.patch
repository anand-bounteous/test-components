+@pytest.mark.feature
+@pytest.mark.smoke
+def test_detect_gift_candidates_grpc_servicer_empty_transactions():
+    servicer = GiftExtractorServicer()
+    request = gift_extractor_pb2.DetectGiftCandidatesRequest(
+        analysis_id="grpc_smoke",
+        jurisdiction="GB",
+        validation_mode="lenient",
+        hint_inputs=hints_pb2.HintInputs(
+            gift_hints=hints_pb2.GiftHintInputs(amount="100"),
+        ),
+    )
+
+    response = asyncio.run(servicer.DetectGiftCandidates(request, None))
+
+    assert response.ok is True
+    assert response.result.analysis_id == "grpc_smoke"
+    assert len(response.result.candidate_sets) == 0
