+import type { DoctrGeometry, NormalizedBBox, PixelBBox } from "../types";
+
+export function bboxToPixels(
+  bbox: NormalizedBBox,
+  displayWidth: number,
+  displayHeight: number,
+): PixelBBox {
+  return {
+    x: bbox.x1 * displayWidth,
+    y: bbox.y1 * displayHeight,
+    width: (bbox.x2 - bbox.x1) * displayWidth,
+    height: (bbox.y2 - bbox.y1) * displayHeight,
+  };
+}
+
+export function pointInBBox(
+  x: number,
+  y: number,
+  bbox: NormalizedBBox,
+): boolean {
+  return x >= bbox.x1 && x <= bbox.x2 && y >= bbox.y1 && y <= bbox.y2;
+}
+
+export function doctrGeometryToBBox(geometry: DoctrGeometry): NormalizedBBox {
+  if (geometry.length === 2) {
+    const [[x1, y1], [x2, y2]] = geometry as [[number, number], [number, number]];
+    return {
+      x1: Math.min(x1, x2),
+      y1: Math.min(y1, y2),
+      x2: Math.max(x1, x2),
+      y2: Math.max(y1, y2),
+    };
+  }
+
+  const xs = geometry.map(([x]) => x);
+  const ys = geometry.map(([, y]) => y);
+  return {
+    x1: Math.min(...xs),
+    y1: Math.min(...ys),
+    x2: Math.max(...xs),
+    y2: Math.max(...ys),
+  };
+}
+
+export function polygonToPixelPoints(
+  points: Array<[number, number]>,
+  displayWidth: number,
+  displayHeight: number,
+): string {
+  return points
+    .map(([x, y]) => `${x * displayWidth},${y * displayHeight}`)
+    .join(" ");
+}
