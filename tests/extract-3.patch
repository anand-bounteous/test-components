+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { CSSProperties } from "react";
+import type { AnnotationKind, PageAnnotation, StatementPage } from "../../types";
+import { annotationColors } from "../../styles/annotationColors";
+import { bboxToPixels, polygonToPixelPoints } from "../../utils/geometry";
+
+export type AnnotatedPageViewerProps = {
+  page: StatementPage;
+  annotations: PageAnnotation[];
+  hiddenKinds: Set<AnnotationKind>;
+  selectedAnnotationId?: string | null;
+  onAnnotationSelect?: (annotationId: string) => void;
+};
+
+export function AnnotatedPageViewer({
+  page,
+  annotations,
+  hiddenKinds,
+  selectedAnnotationId,
+  onAnnotationSelect,
+}: AnnotatedPageViewerProps) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const [displaySize, setDisplaySize] = useState({
+    width: page.width,
+    height: page.height,
+  });
+
+  const updateSize = useCallback(() => {
+    const container = containerRef.current;
+    if (!container) return;
+    const img = container.querySelector("img");
+    if (!img) return;
+    const width = img.clientWidth || img.naturalWidth || page.width;
+    const height = img.clientHeight || img.naturalHeight || page.height;
+    if (width > 0 && height > 0) {
+      setDisplaySize({ width, height });
+    }
+  }, [page.width, page.height]);
+
+  useEffect(() => {
+    setDisplaySize({ width: page.width, height: page.height });
+  }, [page.pageIndex, page.width, page.height]);
+
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    const observer = new ResizeObserver(() => updateSize());
+    observer.observe(container);
+    return () => observer.disconnect();
+  }, [updateSize]);
+
+  const visibleAnnotations = annotations.filter(
+    (annotation) =>
+      annotation.pageIndex === page.pageIndex &&
+      !annotation.hidden &&
+      !hiddenKinds.has(annotation.kind),
+  );
+
+  return (
+    <div style={styles.wrapper} data-testid="annotated-page-viewer">
+      <div ref={containerRef} style={styles.imageContainer}>
+        <img
+          src={page.imageUrl}
+          alt={`Statement page ${page.pageIndex + 1}`}
+          style={styles.image}
+          onLoad={updateSize}
+        />
+        {displaySize.width > 0 && displaySize.height > 0 && (
+          <svg
+            style={{
+              ...styles.overlay,
+              width: displaySize.width,
+              height: displaySize.height,
+            }}
+            data-testid="annotation-overlay"
+          >
+            {visibleAnnotations.map((annotation) => {
+              const colors = annotationColors[annotation.kind];
+              const isSelected = annotation.id === selectedAnnotationId;
+              const strokeWidth = isSelected ? 3 : 1.5;
+
+              if (annotation.polygon && annotation.polygon.length >= 3) {
+                return (
+                  <g key={annotation.id}>
+                    <polygon
+                      points={polygonToPixelPoints(
+                        annotation.polygon,
+                        displaySize.width,
+                        displaySize.height,
+                      )}
+                      fill={colors.fill}
+                      stroke={isSelected ? "#2563eb" : colors.stroke}
+                      strokeWidth={strokeWidth}
+                      style={{ cursor: "pointer" }}
+                      data-annotation-id={annotation.id}
+                      onClick={() => onAnnotationSelect?.(annotation.id)}
+                    >
+                      <title>{annotation.label ?? annotation.kind}</title>
+                    </polygon>
+                  </g>
+                );
+              }
+
+              const pixelBBox = bboxToPixels(
+                annotation.bbox,
+                displaySize.width,
+                displaySize.height,
+              );
+
+              return (
+                <g key={annotation.id}>
+                  <rect
+                    x={pixelBBox.x}
+                    y={pixelBBox.y}
+                    width={pixelBBox.width}
+                    height={pixelBBox.height}
+                    fill={colors.fill}
+                    stroke={isSelected ? "#2563eb" : colors.stroke}
+                    strokeWidth={strokeWidth}
+                    style={{ cursor: "pointer" }}
+                    data-annotation-id={annotation.id}
+                    onClick={() => onAnnotationSelect?.(annotation.id)}
+                  >
+                    <title>{annotation.label ?? annotation.kind}</title>
+                  </rect>
+                </g>
+              );
+            })}
+          </svg>
+        )}
+      </div>
+    </div>
+  );
+}
+
+const styles: Record<string, CSSProperties> = {
+  wrapper: {
+    flex: 1,
+    overflow: "auto",
+    padding: "12px",
+    backgroundColor: "#f3f4f6",
+    display: "flex",
+    justifyContent: "center",
+    alignItems: "flex-start",
+    minHeight: 0,
+  },
+  imageContainer: {
+    position: "relative",
+    display: "inline-block",
+    lineHeight: 0,
+  },
+  image: {
+    display: "block",
+    maxWidth: "100%",
+    height: "auto",
+  },
+  overlay: {
+    position: "absolute",
+    top: 0,
+    left: 0,
+    pointerEvents: "auto",
+  },
+};
