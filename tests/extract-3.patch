+"""REST route for candidate scoring."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import ScoringRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import (
+    bank_transactions_from_wire,
+    candidate_sets_from_wire,
+    features_by_id_from_wire,
+)
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RequestParsing import hint_inputs_from_mapping
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..ScoringTools import run_score_candidate_pool
+
+
+class ScoringRoute(BaseToolRoute):
+    tool_name = "run_score_candidate_pool"
+    path = "/scoring/score"
+    tags = ("scoring",)
+    summary = "Score salary candidate sets with confidence breakdowns."
+    openapi_filename = "run_score_candidate_pool.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def score_candidates(body: ScoringRequest):
+            try:
+                ctx = build_context(body)
+                hints = hint_inputs_from_mapping(body.hint_inputs or {})
+                audit = build_audit(body)
+                result = run_score_candidate_pool(
+                    candidate_sets_from_wire(body.pool),
+                    normalised=bank_transactions_from_wire(body.normalised),
+                    features_by_id=features_by_id_from_wire(body.features_by_id),
+                    calendar=ctx.calendar,
+                    config=ctx.config,
+                    salary_hints=hints.salary_hints,
+                    employer_hints=hints.employer_hints,
+                    infer_regions=body.infer_regions,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
