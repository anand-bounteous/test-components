+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import type { IncomingMessage, ServerResponse } from "node:http";
+import type { Plugin, Connect } from "vite";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+const RUNS_ROOT = path.resolve(
+  __dirname,
+  "../../../../../../.plan/reviews/feature-outputs/document-data-extractor/runs",
+);
+
+const MIME: Record<string, string> = {
+  ".json": "application/json",
+  ".png": "image/png",
+  ".pdf": "application/pdf",
+  ".txt": "text/plain",
+};
+
+function sendJson(res: ServerResponse, status: number, payload: unknown) {
+  res.statusCode = status;
+  res.setHeader("Content-Type", "application/json");
+  res.end(JSON.stringify(payload));
+}
+
+function listRuns() {
+  if (!fs.existsSync(RUNS_ROOT)) {
+    return [];
+  }
+
+  return fs
+    .readdirSync(RUNS_ROOT, { withFileTypes: true })
+    .filter((entry) => entry.isDirectory())
+    .map((entry) => {
+      const runDir = path.join(RUNS_ROOT, entry.name);
+      const manifestPath = path.join(runDir, "run.json");
+      if (!fs.existsSync(manifestPath)) {
+        return {
+          runId: entry.name,
+          status: "unknown",
+          startedAt: null,
+          completed: [],
+        };
+      }
+
+      const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf-8")) as {
+        status?: string;
+        started_at?: string;
+        completed?: string[];
+      };
+
+      return {
+        runId: entry.name,
+        status: manifest.status ?? "unknown",
+        startedAt: manifest.started_at ?? null,
+        completed: manifest.completed ?? [],
+      };
+    })
+    .sort((a, b) => {
+      const aPath = path.join(RUNS_ROOT, a.runId);
+      const bPath = path.join(RUNS_ROOT, b.runId);
+      return fs.statSync(bPath).mtimeMs - fs.statSync(aPath).mtimeMs;
+    });
+}
+
+function resolveRunFile(runId: string, relativePath: string): string | null {
+  if (!/^[a-f0-9]{12}$/.test(runId)) {
+    return null;
+  }
+
+  const normalized = path.normalize(relativePath).replace(/^(\.\.(\/|\\|$))+/, "");
+  if (normalized.startsWith("..")) {
+    return null;
+  }
+
+  const abs = path.resolve(RUNS_ROOT, runId, normalized);
+  if (!abs.startsWith(path.resolve(RUNS_ROOT, runId))) {
+    return null;
+  }
+
+  return fs.existsSync(abs) ? abs : null;
+}
+
+function handleRunsApi(
+  req: IncomingMessage,
+  res: ServerResponse,
+  next: Connect.NextFunction,
+) {
+  const url = req.url ?? "";
+  if (!url.startsWith("/api/runs")) {
+    next();
+    return;
+  }
+
+  if (req.method !== "GET") {
+    sendJson(res, 405, { error: "Method not allowed" });
+    return;
+  }
+
+  const pathname = url.split("?")[0] ?? "";
+
+  if (pathname === "/api/runs") {
+    sendJson(res, 200, { runs: listRuns(), runsRoot: RUNS_ROOT });
+    return;
+  }
+
+  const fileMatch = pathname.match(/^\/api\/runs\/([a-f0-9]{12})\/files\/(.+)$/);
+  if (fileMatch) {
+    const [, runId, relPath] = fileMatch;
+    const filePath = resolveRunFile(runId, decodeURIComponent(relPath));
+    if (!filePath) {
+      sendJson(res, 404, { error: "File not found" });
+      return;
+    }
+
+    const ext = path.extname(filePath).toLowerCase();
+    res.statusCode = 200;
+    res.setHeader("Content-Type", MIME[ext] ?? "application/octet-stream");
+    fs.createReadStream(filePath).pipe(res);
+    return;
+  }
+
+  const manifestMatch = pathname.match(/^\/api\/runs\/([a-f0-9]{12})$/);
+  if (manifestMatch) {
+    const runId = manifestMatch[1];
+    const manifestPath = resolveRunFile(runId, "run.json");
+    if (!manifestPath) {
+      sendJson(res, 404, { error: "Run not found" });
+      return;
+    }
+    res.statusCode = 200;
+    res.setHeader("Content-Type", "application/json");
+    fs.createReadStream(manifestPath).pipe(res);
+    return;
+  }
+
+  sendJson(res, 404, { error: "Not found" });
+}
+
+export function runsApiPlugin(): Plugin {
+  return {
+    name: "document-data-extractor-runs-api",
+    configureServer(server) {
+      server.middlewares.use(handleRunsApi);
+    },
+    configurePreviewServer(server) {
+      server.middlewares.use(handleRunsApi);
+    },
+  };
+}
+
+export { RUNS_ROOT };
