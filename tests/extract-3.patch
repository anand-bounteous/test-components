+"""Per-call log context annotation for detector entry points.
+
+``AddCallContext`` generates a unique call id for log correlation and
+resets it when the wrapped function returns. Pair with
+:func:`set_log_analysis_id` once the payload ``analysis_id`` is known.
+"""
+
+from __future__ import annotations
+
+import functools
+import uuid
+from collections.abc import Callable
+from contextvars import Token
+from typing import ParamSpec, TypeVar
+
+from .Logging import _analysis_id, _unique_id, install_log_context_filter
+
+P = ParamSpec("P")
+R = TypeVar("R")
+
+
+def AddCallContext[**P, R](
+    func: Callable[P, R] | None = None,
+) -> Callable[[Callable[P, R]], Callable[P, R]] | Callable[P, R]:
+    """Decorator — generate a per-call ``unique_id`` for log correlation."""
+
+    def decorator(wrapped: Callable[P, R]) -> Callable[P, R]:
+        @functools.wraps(wrapped)
+        def wrapper(*args: P.args, **kwargs: P.kwargs) -> R:
+            install_log_context_filter()
+            unique_id = uuid.uuid4().hex[:12]
+            token_unique: Token[str | None] = _unique_id.set(unique_id)
+            token_analysis: Token[str | None] = _analysis_id.set(None)
+            try:
+                return wrapped(*args, **kwargs)
+            finally:
+                _unique_id.reset(token_unique)
+                _analysis_id.reset(token_analysis)
+
+        return wrapper
+
+    if func is not None:
+        return decorator(func)
+    return decorator
