+"""Unit tests for rent stream recovery after graph dedup."""
+
+from __future__ import annotations
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import (
+    CandidateSet,
+    CandidateTransaction,
+    DetectedPattern,
+    ScoreBreakdown,
+)
+from nw_agbus_rent_extractor.services.RentTransactionExtractorService import _recover_distinct_rent_streams
+
+
+def _candidate(cid: str, txn_ids: tuple[str, ...], amount: float) -> CandidateSet:
+    return CandidateSet(
+        candidate_set_id=cid,
+        candidate_type="possible_rent",
+        transactions=tuple(
+            CandidateTransaction(
+                transaction_id=tid,
+                date="2024-01-01",
+                description="RENT",
+                amount=amount,
+            )
+            for tid in txn_ids
+        ),
+        score_breakdown=ScoreBreakdown(final_score=0.5),
+        detected_pattern=DetectedPattern(frequency="monthly"),
+        confidence=0.5,
+        confidence_band="medium",
+    )
+
+
+@pytest.mark.unit
+def test_recover_returns_pool_when_single_skeleton_stream():
+    pool = [_candidate("merged", ("t1", "t2"), 1100.0)]
+    skeletons = [_candidate("sk1", ("t1",), 1100.0)]
+    result = _recover_distinct_rent_streams(pool, skeletons)
+    assert result == pool
+
+
+@pytest.mark.unit
+def test_recover_splits_multi_property_streams():
+    sk_a = _candidate("sk_a", ("t1", "t2"), 1100.0)
+    sk_b = _candidate("sk_b", ("t3", "t4"), 900.0)
+    merged = _candidate("merged", ("t1", "t2", "t3", "t4"), 1100.0)
+    result = _recover_distinct_rent_streams([merged], [sk_a, sk_b])
+    assert len(result) == 2
+    assert {c.candidate_set_id for c in result} == {"sk_a", "sk_b"}
