+"""Public tool entry point for property-sale detection."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+from nw_agbus_property_sale_extractor.services import (
+    BankTransactionRequest,
+    BankTransactionResult,
+)
+from nw_agbus_property_sale_extractor.services.PropertySaleTransactionExtractorService import (
+    PropertySaleTransactionExtractorService,
+)
+from nw_aglib_toolkit.channels.tools import tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.logging import AddCallContext, LogFn, setup_trace
+
+setup_trace()
+
+logger = logging.getLogger(__name__)
+
+_default_tool: PropertySaleTransactionExtractorTools | None = None
+
+
+def _tool() -> PropertySaleTransactionExtractorTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = PropertySaleTransactionExtractorTools()
+    return _default_tool
+
+
+class PropertySaleTransactionExtractorTools:
+    phase_name = "property_sale_extractor"
+
+    def __init__(self, logger_: logging.Logger | None = None) -> None:
+        self._logger = logger_ or logger
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def run(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+    ) -> BankTransactionResult:
+        service = PropertySaleTransactionExtractorService(config=config, calendar=calendar)
+        return service.detect(
+            payload,
+            mode=mode,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            include_audit=include_audit,
+        )
+
+    def build_input_summary(
+        self,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "analysis_id": payload.analysis_id,
+            "row_count": len(payload.transactions),
+            "validation_mode": kwargs.get("mode") or payload.validation_mode,
+            "hint_amount": (
+                str(payload.hint_inputs.property_sale_hints.amount)
+                if payload.hint_inputs.property_sale_hints
+                and payload.hint_inputs.property_sale_hints.amount
+                else None
+            ),
+        }
+
+    def build_output_summary(
+        self,
+        result: BankTransactionResult,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "candidates": len(result.candidate_sets),
+            "near_misses": len(result.rejected_or_near_miss_sets),
+            "warnings": len(result.warnings),
+        }
+
+
+@tool(
+    name="detect_property_sale_candidates",
+    description="Detect property sale proceeds credits from a seller bank statement.",
+    category="banking.property_sale",
+    tags=["banking", "property_sale", "transactions"],
+)
+def detect_property_sale_candidates(
+    payload: BankTransactionRequest,
+    *,
+    config: AppConfig | None = None,
+    calendar: WorkingDayCalendar | None = None,
+    mode: str | None = None,
+    max_candidates: int | None = None,
+    max_near_misses: int | None = None,
+    return_threshold: float | None = None,
+    include_audit: bool = False,
+) -> BankTransactionResult:
+    """Detect property sale proceeds credits from a seller bank statement."""
+    return _tool().run(
+        payload,
+        config=config,
+        calendar=calendar,
+        mode=mode,
+        max_candidates=max_candidates,
+        max_near_misses=max_near_misses,
+        return_threshold=return_threshold,
+        include_audit=include_audit,
+    )
+
+
+__all__ = [
+    "PropertySaleTransactionExtractorTools",
+    "detect_property_sale_candidates",
+]
