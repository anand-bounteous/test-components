+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -lt 1 ]]; then
+  echo "Usage: $0 <app-name>" >&2
+  exit 1
+fi
+
+NAME="$1"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+SRC="$ROOT/apps/_template"
+DEST="$ROOT/apps/$NAME"
+
+if [[ -e "$DEST" ]]; then
+  echo "Destination already exists: $DEST" >&2
+  exit 1
+fi
+
+API_PKG="nw-app-${NAME}-api"
+API_IMPORT="nw_app_${NAME//-/_}_api"
+WEB_PKG="@nw/app-${NAME}-web"
+
+cp -R "$SRC" "$DEST"
+
+find "$DEST" -type f -print0 | while IFS= read -r -d '' file; do
+  sed -i '' \
+    -e "s/nw-app-template-api/$API_PKG/g" \
+    -e "s/nw_app_template_api/$API_IMPORT/g" \
+    -e "s/@nw\/app-template-web/$WEB_PKG/g" \
+    -e "s/App Template/${NAME} App/g" \
+    -e "s/app-template/$NAME/g" \
+    "$file" 2>/dev/null || \
+  sed -i \
+    -e "s/nw-app-template-api/$API_PKG/g" \
+    -e "s/nw_app_template_api/$API_IMPORT/g" \
+    -e "s/@nw\/app-template-web/$WEB_PKG/g" \
+    -e "s/App Template/${NAME} App/g" \
+    "$file"
+done
+
+mv "$DEST/api/src/nw_app_template_api" "$DEST/api/src/$API_IMPORT" 2>/dev/null || true
+
+echo "Created application at $DEST"
+echo "  API package: $API_PKG (import: $API_IMPORT)"
+echo "  Web package: $WEB_PKG"
+echo "Add \"apps/$NAME/api\" to pyproject.toml [tool.uv.workspace] members if needed."
