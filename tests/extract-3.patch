+"""Salary recurrence scoring profile (delegates to score_candidate)."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import replace
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    BankTransaction,
+    CandidateSet,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline._models.requests import TransactionsRange
+from nw_agcore_bank_transactions.pipeline.hints.models import AppliedHints, SalaryHints
+from nw_agcore_bank_transactions.pipeline.scoring.ScoringService import score_candidate
+
+
+def score_recurrence_pool(
+    pool: Iterable[CandidateSet],
+    *,
+    normalised: Sequence[BankTransaction],
+    features_by_id: Mapping[str, TransactionFeatures],
+    calendar: WorkingDayCalendar,
+    config: AppConfig,
+    applied_hints: AppliedHints | None = None,
+    salary_hints: SalaryHints | None = None,
+    employer_hints=None,
+    transactions_range: TransactionsRange | None = None,
+) -> list[CandidateSet]:
+    features = dict(features_by_id)
+    scored: list[CandidateSet] = []
+    for cand in pool:
+        cluster_ids = {t.transaction_id for t in cand.transactions}
+        cluster = [t for t in normalised if t.id in cluster_ids]
+        scored_candidate = score_candidate(
+            cand,
+            cluster,
+            features,
+            calendar=calendar,
+            config=config,
+            applied_hints=applied_hints,
+            salary_hints=salary_hints,
+            employer_hints=employer_hints,
+            transactions_range=transactions_range,
+        )
+        pre_score_edge_details = {
+            t.transaction_id: t.confidence_details for t in scored_candidate.transactions
+        }
+        scored_candidate = replace(
+            scored_candidate,
+            transactions=tuple(
+                replace(
+                    t,
+                    confidence=scored_candidate.confidence,
+                    confidence_band=scored_candidate.confidence_band,
+                    confidence_details=(
+                        pre_score_edge_details.get(t.transaction_id, ())
+                        + scored_candidate.confidence_details
+                    ),
+                )
+                for t in scored_candidate.transactions
+            ),
+        )
+        scored.append(scored_candidate)
+    return scored
