+"""One scoring phase contribution — Design §4.5."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+
+@dataclass(frozen=True)
+class ConfidenceDetail:
+    """One scoring phase's contribution to the final confidence value.
+
+    ``confidence_step`` is the signed delta actually applied (negative for
+    penalties).  ``confidence_step_max_value`` is the ceiling/floor for that
+    phase — the maximum it *could* have contributed in either direction.
+    """
+
+    step: str
+    confidence_step: float
+    confidence_step_max_value: float
+    reasoning: str
+    data: Mapping[str, Any] = field(default_factory=dict)
