+"use client";
+
+import { useMemo, useState } from "react";
+import type { CSSProperties } from "react";
+import type {
+  ExtractionAuditSummary,
+  ExtractionPageResult,
+  ExtractionTable,
+} from "../../types";
+import { extractionPageToViewer } from "../../adapters/extractionToAnnotations";
+import { AnnotatedPageViewer } from "../AnnotatedPageViewer";
+import type { AnnotationKind } from "../../types";
+
+export type ExtractionPageViewProps = {
+  extractorName: string;
+  page: ExtractionPageResult;
+  audit?: ExtractionAuditSummary;
+  className?: string;
+};
+
+export function ExtractionPageView({
+  extractorName,
+  page,
+  audit,
+  className,
+}: ExtractionPageViewProps) {
+  const [hiddenKinds, setHiddenKinds] = useState<Set<AnnotationKind>>(() => new Set());
+  const { statementPage, annotations } = useMemo(
+    () => extractionPageToViewer(page),
+    [page],
+  );
+
+  const toggleKind = (kind: AnnotationKind) => {
+    setHiddenKinds((prev) => {
+      const next = new Set(prev);
+      if (next.has(kind)) next.delete(kind);
+      else next.add(kind);
+      return next;
+    });
+  };
+
+  return (
+    <section
+      style={styles.card}
+      className={className}
+      data-testid={`extraction-page-${extractorName}`}
+    >
+      <header style={styles.header}>
+        <h3 style={styles.title}>{extractorName}</h3>
+        {audit && (
+          <span style={styles.meta}>
+            {audit.stepCount} steps · {audit.totalMs.toFixed(0)} ms
+          </span>
+        )}
+      </header>
+      <div style={styles.layout}>
+        <div style={styles.left}>
+          <AnnotatedPageViewer
+            page={statementPage}
+            annotations={annotations}
+            hiddenKinds={hiddenKinds}
+          />
+        </div>
+        <div style={styles.right}>
+          <RegionList regions={page.regions} onToggleKind={toggleKind} hiddenKinds={hiddenKinds} />
+          <ExtractionTablePanel tables={page.tables} />
+          <FullTextPanel fullText={page.fullText} />
+        </div>
+      </div>
+    </section>
+  );
+}
+
+function RegionList({
+  regions,
+  onToggleKind,
+  hiddenKinds,
+}: {
+  regions: ExtractionPageResult["regions"];
+  onToggleKind: (kind: AnnotationKind) => void;
+  hiddenKinds: Set<AnnotationKind>;
+}) {
+  return (
+    <details open style={styles.panel}>
+      <summary style={styles.summary}>Regions ({regions.length})</summary>
+      <div style={styles.kindToggles}>
+        {(["text", "table", "image", "layout"] as AnnotationKind[]).map((kind) => (
+          <button
+            key={kind}
+            type="button"
+            style={styles.kindButton}
+            onClick={() => onToggleKind(kind)}
+          >
+            {hiddenKinds.has(kind) ? "Show" : "Hide"} {kind}
+          </button>
+        ))}
+      </div>
+      <div style={styles.scrollList}>
+        {regions.slice(0, 40).map((region) => (
+          <div key={region.id} style={styles.regionRow}>
+            <div style={styles.regionMeta}>
+              <strong>{region.type}</strong> · {region.source_tool} ·{" "}
+              {region.confidence.toFixed(2)}
+            </div>
+            <div style={styles.regionText}>{region.text || "(empty)"}</div>
+          </div>
+        ))}
+        {regions.length > 40 && (
+          <div style={styles.more}>… {regions.length - 40} more regions</div>
+        )}
+      </div>
+    </details>
+  );
+}
+
+function ExtractionTablePanel({ tables }: { tables: ExtractionTable[] }) {
+  if (!tables.length) {
+    return (
+      <details style={styles.panel}>
+        <summary style={styles.summary}>Tables (0)</summary>
+        <p style={styles.empty}>No tables detected.</p>
+      </details>
+    );
+  }
+
+  return (
+    <>
+      {tables.map((table, index) => (
+        <details key={table.region_id ?? index} open={index === 0} style={styles.panel}>
+          <summary style={styles.summary}>
+            Table {index + 1} · {table.n_rows}×{table.n_cols} · {table.border_mode}
+          </summary>
+          <div style={styles.tableWrap}>
+            <table style={styles.table}>
+              <tbody>
+                {Array.from({ length: table.n_rows }, (_, row) => (
+                  <tr key={row}>
+                    {Array.from({ length: table.n_cols }, (_, col) => {
+                      const cell = table.cells.find(
+                        (c) => c.row === row && c.col === col,
+                      );
+                      return <td key={col} style={styles.td}>{cell?.text ?? ""}</td>;
+                    })}
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </details>
+      ))}
+    </>
+  );
+}
+
+function FullTextPanel({ fullText }: { fullText: string }) {
+  return (
+    <details style={styles.panel}>
+      <summary style={styles.summary}>Full text ({fullText.length} chars)</summary>
+      <pre style={styles.pre}>{fullText || "(empty)"}</pre>
+    </details>
+  );
+}
+
+const styles: Record<string, CSSProperties> = {
+  card: {
+    border: "1px solid #d0d7de",
+    borderRadius: 8,
+    background: "#fff",
+    overflow: "hidden",
+  },
+  header: {
+    display: "flex",
+    justifyContent: "space-between",
+    alignItems: "center",
+    padding: "12px 16px",
+    borderBottom: "1px solid #d0d7de",
+    background: "#f6f8fa",
+  },
+  title: { margin: 0, fontSize: 16 },
+  meta: { color: "#57606a", fontSize: 13 },
+  layout: {
+    display: "grid",
+    gridTemplateColumns: "1.1fr 0.9fr",
+    gap: 12,
+    padding: 12,
+    minHeight: 420,
+  },
+  left: { minWidth: 0 },
+  right: { display: "flex", flexDirection: "column", gap: 8, minWidth: 0 },
+  panel: { border: "1px solid #d8dee4", borderRadius: 6, padding: 8 },
+  summary: { cursor: "pointer", fontWeight: 600, marginBottom: 8 },
+  kindToggles: { display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 8 },
+  kindButton: {
+    fontSize: 12,
+    padding: "4px 8px",
+    borderRadius: 4,
+    border: "1px solid #d0d7de",
+    background: "#fff",
+    cursor: "pointer",
+  },
+  scrollList: { maxHeight: 180, overflow: "auto", fontSize: 12 },
+  regionRow: { padding: "6px 0", borderBottom: "1px solid #eee" },
+  regionMeta: { color: "#57606a", marginBottom: 2 },
+  regionText: { whiteSpace: "pre-wrap" },
+  more: { color: "#57606a", paddingTop: 8 },
+  tableWrap: { overflow: "auto", maxHeight: 220 },
+  table: { borderCollapse: "collapse", width: "100%", fontSize: 12 },
+  td: { border: "1px solid #d0d7de", padding: 4, verticalAlign: "top" },
+  pre: {
+    margin: 0,
+    maxHeight: 160,
+    overflow: "auto",
+    fontSize: 12,
+    whiteSpace: "pre-wrap",
+    background: "#f6f8fa",
+    padding: 8,
+    borderRadius: 4,
+  },
+  empty: { margin: 0, color: "#57606a", fontSize: 13 },
+};
