+"""Rent hint matching facade for grouping and scoring."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import (
+    overlap_match_level,
+    tokenise_employer_name,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+from nw_agcore_bank_transactions.pipeline.hints.models.RentHints import RentHints
+from nw_agcore_bank_transactions.pipeline.hints.models.RentPropertyHint import RentPropertyHint
+
+from .PartyPropertyMatcher import max_match_level, property_match_level
+
+
+def _tokenise_hint_text(text: str) -> frozenset[str]:
+    hint_cfg = load_hint_config()
+    return tokenise_employer_name(text, hint_cfg)
+
+
+def amount_matches(
+    amount: Decimal,
+    hint_amount: Decimal | None,
+    tolerance_pct: float,
+) -> bool:
+    if hint_amount is None:
+        return False
+    if tolerance_pct == 0.0:
+        return int(amount) == int(hint_amount)
+    if hint_amount == 0:
+        return amount == 0
+    return abs(float(amount - hint_amount)) / float(hint_amount) <= tolerance_pct
+
+
+class RentHintMatcher:
+    def __init__(
+        self,
+        *,
+        positive_keywords: Iterable[str] = (),
+        negative_keywords: Iterable[str] = (),
+        default_amount_tolerance_pct: float = 0.0,
+    ) -> None:
+        self._positive = tuple(positive_keywords)
+        self._negative = tuple(negative_keywords)
+        self._default_amount_tolerance_pct = default_amount_tolerance_pct
+
+    @property
+    def positive_keywords(self) -> tuple[str, ...]:
+        return self._positive
+
+    @property
+    def negative_keywords(self) -> tuple[str, ...]:
+        return self._negative
+
+    def effective_tolerance_pct(self, hint_inputs: RentHints) -> float:
+        if hint_inputs.tolerance_pct is not None:
+            return float(hint_inputs.tolerance_pct)
+        return self._default_amount_tolerance_pct
+
+    def match_property(
+        self,
+        transactions: Sequence[BankTransaction],
+        prop: RentPropertyHint,
+    ) -> dict[str, str]:
+        rentee_level = "none"
+        property_level = "none"
+        amount_matched = "false"
+        tolerance = prop.tolerance_pct if prop.tolerance_pct is not None else 0.0
+        for txn in transactions:
+            if prop.amount is not None and amount_matches(txn.amount, prop.amount, tolerance):
+                amount_matched = "true"
+            if prop.rentee_name:
+                rentee_level = max_match_level(
+                    rentee_level,
+                    overlap_match_level(
+                        frozenset(txn.description_tokens),
+                        prop.rentee_name,
+                        load_hint_config(),
+                    ),
+                )
+            property_level = max_match_level(
+                property_level,
+                property_match_level(
+                    frozenset(txn.description_tokens),
+                    prop.property_ref,
+                    prop.location,
+                    prop.postcode,
+                ),
+            )
+        return {
+            "property_id": prop.property_id,
+            "amount_matched": amount_matched,
+            "rentee_match_level": rentee_level,
+            "property_match_level": property_level,
+        }
