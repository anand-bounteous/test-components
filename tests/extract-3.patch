+"""Unit tests for salary request parsing."""
+
+from __future__ import annotations
+
+import pytest
+from nw_agbus_salary_extractor.services.SalaryRequestParsing import salary_request_from_mapping
+
+
+@pytest.mark.unit
+def test_salary_request_from_mapping_parses_transactions_and_hints():
+    payload = salary_request_from_mapping(
+        {
+            "analysis_id": "salary_unit",
+            "validation_mode": "lenient",
+            "transactions": [
+                {
+                    "id": "t1",
+                    "date": "2024-01-31",
+                    "description": "BACS ACME PAYROLL",
+                    "credit_amount": "2500.00",
+                    "debit_amount": 0,
+                }
+            ],
+            "salary_hints": {"approx_salary": 2500},
+        }
+    )
+    assert payload.analysis_id == "salary_unit"
+    assert len(payload.transactions) == 1
+    assert payload.transactions[0].id == "t1"
+    assert payload.hint_inputs.salary_hints is not None
+
+
