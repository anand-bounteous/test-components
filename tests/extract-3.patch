+"""Unit tests for amount range matcher helpers."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.hints.matchers.AmountRangeMatcher import (
+    amount_bounds,
+    amount_in_range,
+    coverage_pct,
+)
+
+
+@pytest.mark.unit
+def test_amount_bounds_symmetric_tolerance():
+    lower, upper = amount_bounds(Decimal("1000"), 0.10)
+    assert lower == Decimal("900")
+    assert upper == Decimal("1100")
+
+
+@pytest.mark.unit
+def test_amount_in_range_inclusive():
+    assert amount_in_range(Decimal("1050"), Decimal("1000"), 0.10)
+    assert not amount_in_range(Decimal("1200"), Decimal("1000"), 0.10)
+
+
+@pytest.mark.unit
+def test_amount_bounds_rejects_non_positive():
+    with pytest.raises(ValueError, match="positive"):
+        amount_bounds(Decimal("0"), 0.10)
+
+
+@pytest.mark.unit
+def test_coverage_pct_caps_at_one():
+    assert coverage_pct(Decimal("1500"), Decimal("1000")) == 1.0
+    assert coverage_pct(Decimal("500"), Decimal("1000")) == 0.5
