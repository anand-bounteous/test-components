+#!/usr/bin/env python3
+"""Migrate exposure -> channels and extract nw_core from nw_aglib_toolkit."""
+
+from __future__ import annotations
+
+import argparse
+import re
+import shutil
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TOOLKIT_SRC = ROOT / "libs/agents/toolkit/src/nw_aglib_toolkit"
+NW_CORE_SRC = ROOT / "libs/common/core/src/nw_core"
+SKIP_DIRS = {".git", ".venv", "node_modules", "__pycache__", ".cursor", "dist", ".next"}
+
+TEXT_REPLACEMENTS: list[tuple[str, str]] = [
+    # Package imports
+    (r"\bnw_aglib_toolkit\.exposure\b", "nw_core.channels"),
+    (r"\bnw_aglib_toolkit\.config\b", "nw_core.config"),
+    (r"\bnw_aglib_toolkit\.logging\b", "nw_core.logging"),
+    (r"\bnw_aglib_toolkit\.schema_check\b", "nw_core.validation.schema"),
+    (r"\bnw_aglib_toolkit\.calendar\b", "nw_core.calendar"),
+    (r"\bnw_aglib_toolkit\.models\.ValidationWarning\b", "nw_core.validation.ValidationWarning"),
+    (r"\bnw_apps_common\.clients\.agent\b", "nw_aglib_toolkit.agent.AgentClient"),
+    (r"\bnw_apps_common\.config\.settings\b", "nw_core.config.ComponentSettings"),
+    (r"\bnw_core\.schema_check\b", "nw_core.validation.schema"),
+    (r"\bnw_core\.models\.ValidationWarning\b", "nw_core.validation.ValidationWarning"),
+    (r"\bnw_core\.channels\.deployment\.DeploymentManifest\b", "nw_aglib_toolkit.channels.AgentDeployment.AgentDeploymentManifest"),
+    (r"\bnw_core\.channels\.deployment\.EmbeddedCoreComposer\b", "nw_aglib_toolkit.channels.AgentDeployment.AgentEmbeddedCoreComposer"),
+    (r"\bnw_core\.channels\.deployment\.ChannelBootstrap\b", "nw_aglib_toolkit.channels.AgentDeployment.AgentChannelBootstrap"),
+    (r"\bnw_aglib_toolkit\.tools\b", "nw_aglib_toolkit.channels.tools"),
+    (r"\bnw_aglib_toolkit\.agent\.base\b", "nw_aglib_toolkit.agent"),
+    (r"\bnw_aglib_toolkit\.agent\b", "nw_aglib_toolkit.agent"),
+    # Class / type renames
+    (r"\bExposureModule\b", "ChannelModule"),
+    (r"\bExposureRegistry\b", "ChannelRegistry"),
+    (r"\bExposureRuntime\b", "ChannelRuntime"),
+    (r"\bExposureBootstrap\b", "ChannelBootstrap"),
+    (r"\bRestExposureModule\b", "RestChannelModule"),
+    (r"\bToolsExposureModule\b", "ToolsChannelModule"),
+    (r"\bGrpcExposureModule\b", "GrpcChannelModule"),
+    (r"\bMqExposureModule\b", "MqChannelModule"),
+    (r"\bEmbeddedCoreExpose\b", "EmbeddedCoreChannels"),
+    (r"\bregister_exposures\b", "register_channels"),
+    (r"\bexposure_enabled\b", "channel_enabled"),
+    (r"\bexposure_prefix\b", "channel_prefix"),
+    # Agent package paths
+    (r"\.exposure\.rest\b", ".channels.rest"),
+    (r"\.exposure\.tools\b", ".channels.tools"),
+    (r"\.exposure\.grpc\b", ".channels.grpc"),
+    (r"\.exposure\.mq\b", ".channels.mq"),
+    (r"\.exposure\.registry\b", ".channels.registry"),
+    (r"\.exposure\b", ".channels"),
+    (r"/exposure/", "/channels/"),
+    (r"from nw_agcore_bank_transactions\.exposure\b", "from nw_agcore_bank_transactions.channels"),
+    (r"from nw_agbus_([a-z_]+)\.exposure\b", r"from nw_agbus_\1.channels"),
+    (r"from nw_agent_([a-z_]+)\.exposure\b", r"from nw_agent_\1.channels"),
+    (r"from nw_business_agent_template\.exposure\b", "from nw_business_agent_template.channels"),
+    (r"from nw_app_template_api\.exposure\b", "from nw_app_template_api.channels"),
+    # Legacy exposure ToolRegistry -> ChannelToolRegistry (only in channel context)
+    (r"from nw_core\.channels\.tools import ToolRegistry\b", "from nw_aglib_toolkit.channels.tools.ChannelToolRegistry import ChannelToolRegistry"),
+    (r"from nw_aglib_toolkit\.channels\.tools import ToolRegistry\b", "from nw_aglib_toolkit.channels.tools.ChannelToolRegistry import ChannelToolRegistry"),
+]
+
+YAML_REPLACEMENTS: list[tuple[str, str]] = [
+    (r"^exposures:", "channels:"),
+    (r"(\s+)expose:", r"\1channels:"),
+]
+
+COPY_TO_NW_CORE = [
+    "config",
+    "logging",
+    "schema_check",
+    "calendar",
+]
+
+COPY_EXPOSURE_TO_NW_CORE_CHANNELS = [
+    "rest",
+    "grpc",
+    "mq",
+]
+
+
+def apply_replacements(text: str, replacements: list[tuple[str, str]]) -> str:
+    for pattern, repl in replacements:
+        text = re.sub(pattern, repl, text)
+    return text
+
+
+def copy_tree(src: Path, dst: Path) -> None:
+    if dst.exists():
+        shutil.rmtree(dst)
+    shutil.copytree(src, dst)
+
+
+def setup_nw_core() -> None:
+    NW_CORE_SRC.mkdir(parents=True, exist_ok=True)
+
+    for name in COPY_TO_NW_CORE:
+        copy_tree(TOOLKIT_SRC / name, NW_CORE_SRC / name)
+
+    models_dst = NW_CORE_SRC / "models"
+    models_dst.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(TOOLKIT_SRC / "models/ValidationWarning.py", models_dst / "ValidationWarning.py")
+    (models_dst / "__init__.py").write_text(
+        'from nw_core.validation import ValidationWarning\n\n__all__ = ["ValidationWarning"]\n',
+        encoding="utf-8",
+    )
+
+    channels_dst = NW_CORE_SRC / "channels"
+    channels_dst.mkdir(parents=True, exist_ok=True)
+    for name in COPY_EXPOSURE_TO_NW_CORE_CHANNELS:
+        copy_tree(TOOLKIT_SRC / "exposure" / name, channels_dst / name)
+
+    # base.py without ToolsExposureModule
+    base_src = (TOOLKIT_SRC / "exposure/base.py").read_text(encoding="utf-8")
+    base_src = re.sub(
+        r"\nclass ToolsExposureModule:.*?runtime\.mq_adapter = self\.adapter\n",
+        "\n",
+        base_src,
+        flags=re.DOTALL,
+    )
+    base_src = re.sub(
+        r"from nw_aglib_toolkit\.exposure\.tools import ToolRegistry\n",
+        "",
+        base_src,
+    )
+    base_src = base_src.replace("ToolRegistry | None", "Any | None")
+    (channels_dst / "base.py").write_text(base_src, encoding="utf-8")
+
+    # deployment.py without ToolRegistry
+    dep_src = (TOOLKIT_SRC / "exposure/deployment.py").read_text(encoding="utf-8")
+    dep_src = re.sub(r"from nw_aglib_toolkit\.exposure\.tools import ToolRegistry\n", "", dep_src)
+    dep_src = re.sub(
+        r"\s+runtime\.tool_registry = ToolRegistry\(\)\n",
+        "\n",
+        dep_src,
+    )
+    dep_src = dep_src.replace("exposures:", "channels:").replace("exposures", "channels")
+    dep_src = dep_src.replace("expose_raw", "channels_raw").replace('"expose"', '"channels"')
+    dep_src = dep_src.replace("expose=", "channels=").replace(".expose.", ".channels.")
+    dep_src = dep_src.replace("EmbeddedCoreExpose", "EmbeddedCoreChannels")
+    dep_src = dep_src.replace("exposure_enabled", "channel_enabled")
+    dep_src = dep_src.replace("exposure_prefix", "channel_prefix")
+    dep_src = dep_src.replace("ExposureBootstrap", "ChannelBootstrap")
+    dep_src = dep_src.replace("ExposureRegistry", "ChannelRegistry")
+    dep_src = dep_src.replace("ExposureRuntime", "ChannelRuntime")
+    (channels_dst / "deployment.py").write_text(dep_src, encoding="utf-8")
+
+    init_py = '''from nw_core.channels.ChannelModules import (
+    ChannelModule,
+    ChannelRegistry,
+    ChannelRuntime,
+    GrpcChannelModule,
+    MqChannelModule,
+    RestChannelModule,
+)
+from nw_core.channels.ChannelDeployment import (
+    ChannelBootstrap,
+    DeploymentManifest,
+    EmbeddedCoreChannels,
+    EmbeddedCoreComposer,
+)
+
+__all__ = [
+    "ChannelModule",
+    "ChannelRegistry",
+    "ChannelRuntime",
+    "RestChannelModule",
+    "GrpcChannelModule",
+    "MqChannelModule",
+    "DeploymentManifest",
+    "ChannelBootstrap",
+    "EmbeddedCoreComposer",
+    "EmbeddedCoreChannels",
+]
+'''
+    (channels_dst / "__init__.py").write_text(init_py, encoding="utf-8")
+
+
+def setup_aglib_channels() -> None:
+    tools_src = TOOLKIT_SRC / "tools"
+    tools_dst = TOOLKIT_SRC / "channels/tools"
+    if tools_dst.exists():
+        shutil.rmtree(tools_dst)
+    copy_tree(tools_src, tools_dst)
+
+    exposure_tools = (TOOLKIT_SRC / "exposure/tools.py").read_text(encoding="utf-8")
+    exposure_tools = exposure_tools.replace("class ToolRegistry:", "class ChannelToolRegistry:")
+    exposure_tools = exposure_tools.replace("other: ToolRegistry", "other: ChannelToolRegistry")
+    exposure_tools = exposure_tools.replace(
+        "from nw_aglib_toolkit.agent.base import BaseAgent",
+        "from nw_aglib_toolkit.agent import BaseAgent",
+    )
+    (tools_dst / "exposure_registry.py").write_text(exposure_tools, encoding="utf-8")
+
+    module_py = '''"""Tools channel module for agent tool registration."""
+from __future__ import annotations
+
+from typing import Any
+
+from nw_core.channels.ChannelDeployment import DeploymentManifest
+
+from nw_aglib_toolkit.channels.tools.ChannelToolRegistry import ChannelToolRegistry
+
+
+class ToolsChannelModule:
+    """Registers agent tools into the channel tool registry."""
+
+    name = "tools"
+
+    def __init__(self, register_fn: Any) -> None:
+        self._register_fn = register_fn
+
+    def is_enabled(self, manifest: DeploymentManifest) -> bool:
+        return manifest.channels.get("tools", {}).get("enabled", False)
+
+    def mount(self, runtime: Any) -> None:
+        if runtime.tool_registry is None:
+            runtime.tool_registry = ChannelToolRegistry()
+        self._register_fn(runtime.tool_registry)
+'''
+    (TOOLKIT_SRC / "channels/tools/module.py").write_text(module_py, encoding="utf-8")
+
+    agent_base = (TOOLKIT_SRC / "agent/base.py").read_text(encoding="utf-8")
+    (TOOLKIT_SRC / "agent.py").write_text(agent_base, encoding="utf-8")
+
+
+def rename_exposure_dirs() -> None:
+    for path in sorted(ROOT.rglob("exposure")):
+        if not path.is_dir():
+            continue
+        if any(part in SKIP_DIRS for part in path.parts):
+            continue
+        if "nw_aglib_toolkit/exposure" in str(path):
+            continue
+        target = path.with_name("channels")
+        if target.exists():
+            continue
+        path.rename(target)
+        print(f"Renamed {path} -> {target}")
+
+
+def rewrite_files(dry_run: bool = False) -> int:
+    changed = 0
+    extensions = {".py", ".yaml", ".yml", ".md", ".toml"}
+    for path in ROOT.rglob("*"):
+        if not path.is_file() or path.suffix not in extensions:
+            continue
+        if any(part in SKIP_DIRS for part in path.parts):
+            continue
+        if path.name == "migrate_channels.py":
+            continue
+        try:
+            original = path.read_text(encoding="utf-8")
+        except UnicodeDecodeError:
+            continue
+        updated = apply_replacements(original, TEXT_REPLACEMENTS)
+        if path.suffix in {".yaml", ".yml"}:
+            for pattern, repl in YAML_REPLACEMENTS:
+                updated = re.sub(pattern, repl, updated, flags=re.MULTILINE)
+        if updated != original:
+            changed += 1
+            if not dry_run:
+                path.write_text(updated, encoding="utf-8")
+            print(path)
+    return changed
+
+
+def cleanup_old_toolkit_paths() -> None:
+    for rel in [
+        "exposure",
+        "tools",
+        "agent",
+        "config",
+        "logging",
+        "schema_check",
+        "calendar",
+        "models",
+        "pipeline_tools",
+        "custom_tool",
+        "agents",
+    ]:
+        path = TOOLKIT_SRC / rel
+        if path.exists():
+            if path.is_dir():
+                shutil.rmtree(path)
+            else:
+                path.unlink()
+
+
+def fix_nw_core_internal_imports() -> None:
+    for path in NW_CORE_SRC.rglob("*.py"):
+        text = path.read_text(encoding="utf-8")
+        text = text.replace("nw_aglib_toolkit.", "nw_core.")
+        text = text.replace("from ..config import AppConfig", "")
+        text = text.replace("from ...config import AppConfig", "")
+        # Fix calendar factory - remove AppConfig coupling
+        if path.name == "__init__.py" and "calendar" in str(path):
+            text = '''"""UK working-day calendar."""
+
+from typing import Any
+
+from nw_core.calendar.models.CalendarOverrides import CalendarOverrides
+from nw_core.calendar.WorkingDayCalendar import WorkingDayCalendar
+
+
+def working_day_calendar_from_regions(regions: dict[str, Any] | None = None) -> WorkingDayCalendar:
+    """Build a calendar using holiday overrides from a regions config mapping."""
+    return WorkingDayCalendar(
+        overrides=CalendarOverrides.from_config(regions),
+    )
+
+
+__all__ = [
+    "CalendarOverrides",
+    "WorkingDayCalendar",
+    "working_day_calendar_from_regions",
+]
+'''
+        path.write_text(text, encoding="utf-8")
+
+
+def fix_aglib_tools_init() -> None:
+    init_path = TOOLKIT_SRC / "channels/tools/__init__.py"
+    if init_path.exists():
+        text = init_path.read_text(encoding="utf-8")
+        text = text.replace("nw_aglib_toolkit.tools", "nw_aglib_toolkit.channels.tools")
+        init_path.write_text(text, encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--skip-setup", action="store_true", help="Only rewrite imports")
+    args = parser.parse_args()
+
+    if not args.skip_setup and not args.dry_run:
+        setup_nw_core()
+        setup_aglib_channels()
+        rename_exposure_dirs()
+        fix_nw_core_internal_imports()
+        fix_aglib_tools_init()
+        cleanup_old_toolkit_paths()
+
+    changed = rewrite_files(dry_run=args.dry_run)
+    print(f"Updated {changed} file(s)")
+
+
+if __name__ == "__main__":
+    main()
