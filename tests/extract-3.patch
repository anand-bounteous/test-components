+from nw_agcore_bank_transactions.pipeline.ranking import run_rank_candidates
+from nw_agcore_bank_transactions.pipeline.scoring import partition_by_negative_keywords
+from nw_agcore_bank_transactions.pipeline.validation import (
+    TransactionsAbsence,
+    run_validate_bank_transaction_payload,
+)
+from nw_aglib_toolkit.audit import AuditBuilder
+from nw_aglib_toolkit.pipeline.config import AppConfig, load_config
+from nw_core.calendar import WorkingDayCalendar, working_day_calendar_from_app_config
+from nw_core.logging import AddCallContext, LogFn, set_log_analysis_id
+from nw_core.validation import ValidationWarning as CoreValidationWarning
+
+from .config.PropertySaleConfig import (
+    PropertySaleConfig,
+    load_property_sale_config,
+    load_property_sale_keywords,
+)
+from .PropertySaleRequestParsing import sale_warning_from_salary, to_validation_payload
+
+logger = logging.getLogger(__name__)
+
+
+def _calendar_region(payload: BankTransactionRequest, cfg: AppConfig) -> str:
+    return payload.country_region or cfg.default_region()
+
+
+def _sale_matcher(sale_config: PropertySaleConfig) -> PropertySaleHintMatcher:
+    keywords = load_property_sale_keywords()
+    cfg = sale_config.sale_hints()
+    return PropertySaleHintMatcher(
+        positive_keywords=keywords["positive"],
+        negative_keywords=keywords["negative"],
+        default_tolerance_pct=float(cfg.get("default_tolerance_pct", 0.10)),
+        default_timeline_hint=str(cfg.get("default_timeline_hint", "15d")),
+    )
+
+
+class PropertySaleTransactionExtractorService:
+    def __init__(
+        self,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+        sale_config: PropertySaleConfig | None = None,
+    ) -> None:
+        self._sale_config = sale_config or load_property_sale_config()
+        overrides = self._sale_config.config_overrides_for_core()
+        self._config = config or load_config(overrides=overrides)
+        self._calendar = calendar or working_day_calendar_from_app_config(self._config)
+        self._description_signals = self._sale_config.description_signals()
+        self._hint_matcher = _sale_matcher(self._sale_config)
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def detect(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+        transactions_absence: TransactionsAbsence | None = None,
+    ) -> BankTransactionResult:
+        cfg = self._config
+        cal = self._calendar
+        validation_mode = mode or payload.validation_mode
+        analysis_id = payload.analysis_id
+        set_log_analysis_id(analysis_id)
+
+        audit = AuditBuilder(
+            enabled=bool(include_audit),
+            analysis_id=analysis_id,
+            config_versions=dict(cfg.versions()),
+            effective_kwargs={
+                "validation_mode": validation_mode,
+                "max_candidates": max_candidates,
+                "max_near_misses": max_near_misses,
+                "return_threshold": return_threshold,
+                "include_audit": include_audit,
+            },
+        )
+
+        pipeline_warnings: list[CoreValidationWarning] = []
+        warnings: list[ValidationWarning] = []
+
+        sale_hint_inputs = payload.hint_inputs.property_sale_hints
+        if sale_hint_inputs is None:
+            warnings.append(
+                ValidationWarning(
+                    code="MISSING_SALE_AMOUNT",
+                    detail="sale_hints.amount is required",
+                )
+            )
+            return _early_exit(analysis_id, warnings, audit, include_audit, payload)
+
+        try:
+            self._hint_matcher.validate_amount_present(sale_hint_inputs)
+        except ValueError as exc:
+            warnings.append(
+                ValidationWarning(
+                    code="MISSING_SALE_AMOUNT",
+                    detail=str(exc),
+                )
+            )
+            return _early_exit(analysis_id, warnings, audit, include_audit, payload)
+
+        validate_result = run_validate_bank_transaction_payload(
+            to_validation_payload(payload),
+            mode=validation_mode,
+            transactions_absence=transactions_absence,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        warnings.extend(sale_warning_from_salary(w) for w in pipeline_warnings)
+
+        if validate_result.early_exit:
+            return _early_exit(analysis_id, warnings, audit, include_audit, payload)
+
+        norm_result = run_normalize_bank_transactions(
+            validate_result.transactions,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        normalised = norm_result.transactions
+
+        extract_result = run_extract_bank_transaction_features(
+            normalised,
+            app_config=cfg,
+            calendar=cal,
+            region=_calendar_region(payload, cfg),
+            description_signals=self._description_signals,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        normalised = extract_result.transactions
+        features_by_id = {
+            t.features.transaction_id: t.features for t in normalised if t.features is not None
+        }
+        audit.record_features(features_from_transactions(normalised))
+
+        run_apply_bank_transaction_hints(
+            normalised,
+            hint_inputs=payload.hint_inputs,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+
+        grouping_result = run_generate_hint_candidates(
+            normalised,
+            profile="property_sale",
+            hint_inputs=sale_hint_inputs,
+            hint_matcher=self._hint_matcher,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        groups = list(grouping_result.groups)
+
+        reference = self._hint_matcher.resolve_reference_date(normalised, sale_hint_inputs)
+        window_start, window_end = self._hint_matcher.resolve_window(reference, sale_hint_inputs)
+        cluster = groups[0].transactions if groups else ()
+        aggregate_sum = groups[0].aggregate_sum if groups else None
+        applied_sale = apply_property_sale_hints(
+            normalised,
+            sale_hint_inputs,
+            self._hint_matcher,
+            reference_date=reference,
+            window_start=window_start,
+            window_end=window_end,
+            aggregate_sum=aggregate_sum,
+            cluster=cluster,
+        )
+        applied_hints = AppliedHints(property_sale=applied_sale)
+
+        keywords = load_property_sale_keywords()
+        scoring_result = run_score_hint_groups(
+            groups,
+            profile="property_sale",
+            hint_inputs=sale_hint_inputs,
+            applied_hints=applied_hints,
+            features_by_id=features_by_id,
+            weights=self._sale_config.weights(),
+            thresholds=self._sale_config.thresholds(),
+            hint_cfg=self._sale_config.sale_hints(),
+            positive_keywords=keywords["positive"],
+            negative_keywords=keywords["negative"],
+            hint_matcher=self._hint_matcher,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        scored = list(scoring_result.scored)
+
+        kept, neg_rejected = partition_by_negative_keywords(scored, features_by_id)
+
+        ranking_result = run_rank_candidates(
+            kept,
+            cfg,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            audit=audit,
+            warnings=pipeline_warnings,
+        )
+        returned = list(ranking_result.returned)
+        near_misses = neg_rejected + list(ranking_result.near_misses)
+        near_misses = near_misses[: ranking_result.max_near_misses]
+
+        summary = _build_summary(payload, normalised)
+        result = BankTransactionResult(
+            analysis_id=analysis_id,
+            jurisdiction=payload.jurisdiction,
+            country_region=_calendar_region(payload, cfg),
+            input_summary=summary,
+            candidate_sets=tuple(returned),
+            rejected_or_near_miss_sets=tuple(near_misses),
+            warnings=tuple(warnings),
+            applied_hints=applied_hints,
+            metadata=ResultMetadata(
+                config_versions=dict(cfg.versions()),
+                return_threshold=ranking_result.return_threshold,
+                max_candidates=ranking_result.max_candidates,
+                max_near_misses=ranking_result.max_near_misses,
+                validation_mode=validation_mode,
+                include_audit=bool(include_audit),
+            ),
+        )
+        snapshot = audit.snapshot()
+        if snapshot is not None:
+            result = replace(result, audit=snapshot)
+        return result
+
+
+def _build_summary(
+    payload: BankTransactionRequest,
+    normalised,
+) -> InputSummary:
+    if normalised:
+        sorted_dates = sorted(n.date for n in normalised)
+        start = sorted_dates[0].isoformat()
+        end = sorted_dates[-1].isoformat()
+    else:
+        start = end = ""
+    return InputSummary(
+        transaction_count=len(payload.transactions),
+        credit_count=len(normalised),
+        date_range_start=start,
+        date_range_end=end,
+    )
+
+
+def _early_exit(
+    analysis_id: str,
+    warnings: list[ValidationWarning],
+    audit,
+    include_audit: bool,
+    payload: BankTransactionRequest,
+) -> BankTransactionResult:
+    return BankTransactionResult(
+        analysis_id=analysis_id,
+        jurisdiction=payload.jurisdiction,
+        country_region=payload.country_region or "EnglandAndWales",
+        input_summary=InputSummary(0, 0),
+        warnings=tuple(warnings),
+        audit=audit.snapshot() if include_audit else None,
+    )
+
