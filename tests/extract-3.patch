+"""Shared REST route contract for tool endpoints."""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from pathlib import Path
+from typing import Any
+
+from fastapi import APIRouter, FastAPI
+from nw_aglib_toolkit.channels.rest.ApiResponseModels import ToolErrorResponse
+from pydantic import BaseModel
+
+
+class BaseToolRoute(ABC):
+    """Register one @tool entry point as a stateless REST endpoint."""
+
+    tool_name: str
+    path: str
+    tags: tuple[str, ...]
+    summary: str
+    openapi_filename: str
+    success_response_model: type[BaseModel] | None = None
+    shared_openapi_components_path: Path | None = None
+
+    @abstractmethod
+    def register(self, router: APIRouter) -> None:
+        raise NotImplementedError
+
+    @classmethod
+    def error_responses(cls) -> dict[int, dict[str, Any]]:
+        return {
+            422: {"model": ToolErrorResponse},
+            500: {"model": ToolErrorResponse},
+        }
+
+    def route_decorator_kwargs(self) -> dict[str, Any]:
+        kwargs: dict[str, Any] = {
+            "tags": list(self.tags),
+            "summary": self.summary,
+            "responses": self.error_responses(),
+        }
+        if self.success_response_model is not None:
+            kwargs["response_model"] = self.success_response_model
+        return kwargs
+
+    @property
+    def openapi_path(self) -> Path:
+        import inspect
+
+        module_file = Path(inspect.getfile(self.__class__)).resolve()
+        return module_file.parent / "openapi" / self.openapi_filename
+
+    def openapi_document(self) -> dict[str, Any] | None:
+        path = self.openapi_path
+        if not path.is_file():
+            return None
+        import yaml
+
+        document = yaml.safe_load(path.read_text(encoding="utf-8"))
+        shared_path = self.shared_openapi_components_path
+        if shared_path is not None and shared_path.is_file():
+            shared = yaml.safe_load(shared_path.read_text(encoding="utf-8")) or {}
+            shared_schemas = (shared.get("components") or {}).get("schemas") or {}
+            document.setdefault("components", {}).setdefault("schemas", {})
+            document["components"]["schemas"] = {
+                **shared_schemas,
+                **document["components"]["schemas"],
+            }
+        return document
+
+    @classmethod
+    def attach_to_app(cls, app: FastAPI, routes: list[BaseToolRoute]) -> None:
+        router = APIRouter(prefix="/api/v1")
+        for route in routes:
+            route.register(router)
+        app.include_router(router)
