+"""REST route for candidate ranking."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+from nw_agcore_bank_transactions.channels.rest.ApiModels import RankingRequest
+from nw_agcore_bank_transactions.channels.rest.ApiResponseModels import RankingSuccessResponse
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import candidate_sets_from_wire
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+from nw_agcore_bank_transactions.channels.tools.ranking.RankingTools import run_rank_candidates
+
+
+class RankingRoute(BaseToolRoute):
+    tool_name = "run_rank_candidates"
+    path = "/ranking/rank"
+    tags = ("ranking",)
+    summary = "Rank scored candidates into returned and near-miss sets."
+    openapi_filename = "run_rank_candidates.openapi.yaml"
+    success_response_model = RankingSuccessResponse
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, **self.route_decorator_kwargs())
+        def rank_candidates(body: RankingRequest):
+            try:
+                ctx = build_context(body)
+                audit = build_audit(body)
+                result = run_rank_candidates(
+                    candidate_sets_from_wire(body.scored),
+                    ctx.config,
+                    max_candidates=body.max_candidates,
+                    max_near_misses=body.max_near_misses,
+                    return_threshold=body.return_threshold,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
