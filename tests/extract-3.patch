+"""Async startup for REST and gRPC agent channels."""
+
+from __future__ import annotations
+
+import asyncio
+from typing import TYPE_CHECKING
+
+from nw_core.channels.grpc.GrpcServer import GrpcServicerRegistration, serve_grpc
+from uvicorn import Config, Server
+
+if TYPE_CHECKING:
+    from nw_aglib_toolkit.channels.AgentChannelRuntime import AgentChannelRuntime
+    from nw_core.config.ComponentSettings import BaseComponentSettings
+
+
+async def serve_agent_channels(
+    runtime: AgentChannelRuntime,
+    settings: BaseComponentSettings,
+) -> None:
+    tasks: list[asyncio.Task[None]] = []
+
+    if runtime.app is not None:
+        config = Config(
+            runtime.app,
+            host=settings.host,
+            port=settings.port,
+            log_level=settings.log_level.lower(),
+        )
+        server = Server(config)
+        tasks.append(asyncio.create_task(server.serve()))
+
+    registrations = [
+        servicer
+        for servicer in runtime.grpc_servicers
+        if isinstance(servicer, GrpcServicerRegistration)
+    ]
+    if registrations:
+        tasks.append(
+            asyncio.create_task(
+                serve_grpc(
+                    registrations,
+                    host=settings.host,
+                    port=settings.grpc_port,
+                )
+            )
+        )
+
+    if not tasks:
+        raise RuntimeError("No channels enabled in deployment.yaml")
+
+    await asyncio.gather(*tasks)
+
+
+def run_agent_channels(runtime: AgentChannelRuntime, settings: BaseComponentSettings) -> None:
+    asyncio.run(serve_agent_channels(runtime, settings))
