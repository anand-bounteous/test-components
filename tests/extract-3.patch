+"""Load property-sale detector YAML configuration."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from importlib import resources
+from pathlib import Path
+from typing import Any
+
+import yaml
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models.DescriptionSignalConfig import (
+    DescriptionSignalConfig,
+)
+
+_CONFIG_PACKAGE = "nw_agbus_property_sale_extractor.services.config"
+
+
+@dataclass(frozen=True)
+class PropertySaleConfig:
+    data: dict[str, Any] = field(default_factory=dict)
+
+    def weights(self) -> dict[str, float]:
+        return {k: float(v) for k, v in self.data.get("weights", {}).items()}
+
+    def thresholds(self) -> dict[str, Any]:
+        return dict(self.data.get("thresholds", {}))
+
+    def ranking(self) -> dict[str, Any]:
+        return dict(self.data.get("ranking", {}))
+
+    def config_overrides_for_core(self) -> dict[str, Any]:
+        """Merge property-sale tuning into AppConfig overrides for ranking phases."""
+        ranking = self.ranking()
+        return {
+            "candidate_generation": {
+                "max_candidates_to_return": ranking.get("max_candidates_to_return", 1),
+                "max_near_misses": ranking.get("max_near_misses", 5),
+            },
+            "weights": self.weights(),
+            "thresholds": self.thresholds(),
+        }
+
+    def sale_hints(self) -> dict[str, Any]:
+        return dict(self.data.get("sale_hints", {}))
+
+    def description_signals(self) -> DescriptionSignalConfig:
+        return property_sale_description_signals()
+
+
+def load_property_sale_keywords(config_path: Path | None = None) -> dict[str, tuple[str, ...]]:
+    if config_path is None:
+        raw = (
+            resources.files(_CONFIG_PACKAGE)
+            .joinpath("property_sale_keywords.yaml")
+            .read_text(encoding="utf-8")
+        )
+    else:
+        raw = config_path.read_text(encoding="utf-8")
+    data = yaml.safe_load(raw) or {}
+    return {
+        "positive": tuple(data.get("positive_keywords") or ()),
+        "negative": tuple(data.get("negative_keywords") or ()),
+    }
+
+
+def property_sale_description_signals() -> DescriptionSignalConfig:
+    keywords = load_property_sale_keywords()
+    return DescriptionSignalConfig.from_flat_keywords(
+        keywords["positive"],
+        keywords["negative"],
+    )
+
+
+def load_property_sale_config(config_path: Path | None = None) -> PropertySaleConfig:
+    if config_path is None:
+        raw = (
+            resources.files(_CONFIG_PACKAGE)
+            .joinpath("property_sale_detector.yaml")
+            .read_text(encoding="utf-8")
+        )
+    else:
+        raw = config_path.read_text(encoding="utf-8")
+    return PropertySaleConfig(data=yaml.safe_load(raw) or {})
