+"""Skeleton-grouping candidate generation tools."""
+
+from .models import SkeletonGroupingToolResult
+from .SkeletonGroupingService import PlausibilityScore, SkeletonGroupingService
+
+_TOOL_EXPORTS = {
+    "SkeletonGroupingTools": (
+        "nw_agcore_bank_transactions.channels.tools.skeleton_grouping.SkeletonGroupingTools",
+        "SkeletonGroupingTools",
+    ),
+    "run_emit_skeleton_candidates": (
+        "nw_agcore_bank_transactions.channels.tools.skeleton_grouping.SkeletonGroupingTools",
+        "run_emit_skeleton_candidates",
+    ),
+}
+
+__all__ = [
+    "PlausibilityScore",
+    "SkeletonGroupingService",
+    "SkeletonGroupingTools",
+    "SkeletonGroupingToolResult",
+    "run_emit_skeleton_candidates",
+]
+
+
+def __getattr__(name: str):
+    if name not in _TOOL_EXPORTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    module_path, attr = _TOOL_EXPORTS[name]
+    import importlib
+
+    module = importlib.import_module(module_path)
+    value = getattr(module, attr)
+    globals()[name] = value
+    return value
