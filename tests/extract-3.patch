@@ -0,0 +1,133 @@
+"""Custom TRACE log level + helpers — Phase 14.
+
+Python's stdlib ``logging`` defines DEBUG = 10 but no level below. The
+salary detector emits *very* verbose diagnostics (per-transaction
+features, per-edge scores) that we want to keep available but off by
+default — TRACE = 5 is the right level for that.
+
+Usage:
+
+```python
+from nw_core.logging import configure_logging, get_logger, setup_trace
+
+setup_trace()                          # register TRACE level once
+configure_logging(level=logging.DEBUG) # root handler incl. thread name
+logger = get_logger(__name__)
+logger.trace("very detailed event %s", payload)
+```
+"""
+
+from __future__ import annotations
+
+import logging
+from contextvars import ContextVar
+from typing import Any
+
+TRACE = 5
+_LEVEL_NAME = "TRACE"
+
+# Placeholder when no detector call context is active.
+_LOG_CONTEXT_EMPTY = "-"
+
+# Per-call context — set by :func:`AddCallContext` on ``detect_salary_candidates``.
+_unique_id: ContextVar[str | None] = ContextVar("log_unique_id", default=None)
+_analysis_id: ContextVar[str | None] = ContextVar("log_analysis_id", default=None)
+
+# Shared formats — thread name plus optional detector call / analysis identifiers.
+LOG_FORMAT = (
+    "%(asctime)s %(levelname)-8s [%(threadName)s] "
+    "[call=%(unique_id)s] [analysis=%(analysis_id)s] %(name)s — %(message)s"
+)
+LOG_DATEFMT = "%H:%M:%S"
+# Pytest live-log layout (level, thread, location, message).
+PYTEST_LOG_FORMAT = (
+    "%(levelname)-8s [%(unique_id)s] [%(analysis_id)s] [%(threadName)s] "
+    "%(name)s:%(filename)s:%(lineno)d %(message)s"
+)
+
+# Register at import time so both logging.getLevelName("TRACE") and
+# getattr(logging, "TRACE") work — pytest uses getattr() to resolve
+# --log-cli-level=TRACE before any pytest_configure hook runs.
+logging.addLevelName(TRACE, _LEVEL_NAME)
+logging.TRACE = TRACE  # type: ignore[attr-defined]
+
+_registered = False
+_context_filter_installed = False
+
+
+class LogContextFilter(logging.Filter):
+    """Inject ``unique_id`` and ``analysis_id`` onto every log record."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        record.unique_id = _unique_id.get() or _LOG_CONTEXT_EMPTY
+        record.analysis_id = _analysis_id.get() or _LOG_CONTEXT_EMPTY
+        return True
+
+
+def install_log_context_filter() -> None:
+    """Attach :class:`LogContextFilter` to root handlers (idempotent)."""
+    global _context_filter_installed
+    if _context_filter_installed:
+        return
+    log_filter = LogContextFilter()
+    root = logging.getLogger()
+    if not any(isinstance(item, LogContextFilter) for item in root.filters):
+        root.addFilter(log_filter)
+    for handler in root.handlers:
+        if not any(isinstance(item, LogContextFilter) for item in handler.filters):
+            handler.addFilter(log_filter)
+    _context_filter_installed = True
+
+
+def set_log_analysis_id(analysis_id: str) -> None:
+    """Set the payload ``analysis_id`` for the current detector call context."""
+    _analysis_id.set(analysis_id)
+
+
+def setup_trace() -> None:
+    """Idempotent — registers TRACE = 5 and attaches a ``trace()`` method
+    to ``logging.Logger`` so callers can write ``logger.trace(...)``."""
+    global _registered
+    if _registered:
+        return
+    logging.addLevelName(TRACE, _LEVEL_NAME)
+
+    def _trace(self: logging.Logger, message: str, *args: Any, **kwargs: Any) -> None:
+        if self.isEnabledFor(TRACE):
+            self._log(TRACE, message, args, **kwargs)
+
+    # Attach as an instance method on the Logger class.
+    logging.Logger.trace = _trace  # type: ignore[attr-defined]
+    _registered = True
+
+
+def configure_logging(level: int = logging.INFO, *, force: bool = False) -> None:
+    """Configure root logging with :data:`LOG_FORMAT` (includes thread name)."""
+    setup_trace()
+    logging.basicConfig(
+        level=level,
+        format=LOG_FORMAT,
+        datefmt=LOG_DATEFMT,
+        force=force,
+    )
+    install_log_context_filter()
+
+
+def get_logger(name: str) -> logging.Logger:
+    """Return a logger after ensuring TRACE is registered."""
+    setup_trace()
+    return logging.getLogger(name)
+
+
+__all__ = [
+    "LOG_DATEFMT",
+    "LOG_FORMAT",
+    "LogContextFilter",
+    "PYTEST_LOG_FORMAT",
+    "TRACE",
+    "configure_logging",
+    "get_logger",
+    "install_log_context_filter",
+    "set_log_analysis_id",
+    "setup_trace",
+]
