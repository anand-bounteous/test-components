+"""Phase 6 — amount-regime classifier."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    AmountModel,
+    classify_amount_pattern,
+)
+from nw_aglib_toolkit.pipeline.config import load_config
+
+
+def _txn(tid, d, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=d.isoformat() if hasattr(d, "isoformat") else d,
+            description="BACS ACME LTD PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _series(amounts):
+    return [
+        _txn(f"t{i}", date(2024, 1, 1) + timedelta(days=30 * i), a) for i, a in enumerate(amounts)
+    ]
+
+
+# --- Stable --------------------------------------------------------------
+
+
+def test_perfectly_stable_is_stable():
+    txns = _series(["2450.00"] * 6)
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.STABLE
+    assert fit.score == 1.0
+    assert fit.coefficient_of_variation == 0.0
+
+
+def test_stable_within_two_percent_is_stable():
+    txns = _series(["2450", "2450", "2440", "2455", "2450", "2447"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.STABLE
+
+
+def test_stable_within_ten_percent_is_minor_variation():
+    """Six credits with one mid-cluster spread that triggers
+    minor-variation classification without forming a clean step pattern."""
+    txns = _series(["2400", "2400", "2600", "2300", "2400", "2400"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.STABLE_WITH_MINOR_VARIATION
+
+
+# --- Step change ---------------------------------------------------------
+
+
+def test_april_step_change_detected():
+    """Three months at £2400, then nine months at £2640 (10 % jump)."""
+    txns = _series(["2400", "2400", "2400"] + ["2640"] * 9)
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.STABLE_WITH_STEP_CHANGE
+    assert len(fit.segments) == 2
+    assert fit.segments[0].median == Decimal("2400.00")
+    assert fit.segments[1].median == Decimal("2640.00")
+
+
+def test_step_change_min_delta_threshold():
+    """A 1 % delta should NOT count as a step change."""
+    txns = _series(["2400", "2400", "2400", "2420", "2420", "2420"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model != AmountModel.STABLE_WITH_STEP_CHANGE
+
+
+# --- Outliers ------------------------------------------------------------
+
+
+def test_one_outlier_at_end_classified_as_final_pay():
+    txns = _series(["2450"] * 5 + ["5800"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.ONE_OFF_FINAL_PAY_OUTLIER
+    # outlier is the last entry
+    assert fit.outlier_ids == ("t5",)
+
+
+def test_one_outlier_in_middle_classified_as_bonus():
+    txns = _series(["2450", "2450", "2450", "5800", "2450", "2450"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.BONUS_OR_EXTRA_PAY_OUTLIER
+    assert fit.outlier_ids == ("t3",)
+
+
+# --- Variable / too variable --------------------------------------------
+
+
+def test_commission_heavy_classified_as_variable_but_recurring():
+    """CV between 10 % and 20 %; no clean step or outlier."""
+    txns = _series(["1800", "2400", "1950", "3120", "2210", "1860", "2700"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model in {
+        AmountModel.VARIABLE_BUT_RECURRING,
+        AmountModel.TOO_VARIABLE,  # acceptable depending on CV
+    }
+
+
+def test_too_variable():
+    txns = _series(["500", "5000", "1200", "6800", "300", "4500"])
+    fit = classify_amount_pattern(txns)
+    assert fit.model == AmountModel.TOO_VARIABLE
+
+
+# --- Empty input ---------------------------------------------------------
+
+
+def test_empty_cluster_returns_too_variable():
+    fit = classify_amount_pattern([])
+    assert fit.model == AmountModel.TOO_VARIABLE
+    assert fit.score == 0.0
+
+
+# --- Config wiring -------------------------------------------------------
+
+
+def test_classifier_respects_config_tolerances():
+    """A 5 % spread is normally MINOR variation; pin the threshold at 0 %
+    and confirm it now classifies as something noisier."""
+    txns = _series(["2400", "2400", "2520", "2520", "2480", "2440"])
+    cfg = load_config(
+        overrides={
+            "amount": {
+                "stable_pct_tolerance": 0.0,
+                "moderate_pct_tolerance": 0.005,
+                "step_change_min_pct": 0.99,  # disable step-change for this test
+                "variable_max_cv": 0.20,
+            }
+        }
+    )
+    fit = classify_amount_pattern(txns, config=cfg)
+    assert fit.model in {
+        AmountModel.VARIABLE_BUT_RECURRING,
+        AmountModel.TOO_VARIABLE,
+    }
