@@ -0,0 +1,442 @@
+"""End-to-end salary-transaction detection service.
+
+Composes every pipeline phase into ``SalaryTransactionExtractor.detect`` that
+takes a typed ``BankTransactionRequest`` and returns a ``BankTransactionResult``.
+
+Pipeline (see ``application-design.md`` §1.4):
+
+1–2. Schema + row-level validation.
+3.   Normalisation.
+4.   Per-transaction feature extraction.
+5.   Hint application — payslip anchor + approx-salary band.
+6.   Skeleton-grouping candidate generation.
+7.   Similarity-graph clustering candidate generation.
+8.   Pool dedup by transaction-id overlap.
+9.   Bonus / expense splitting.
+10.  Amount + date-only fallback (unaccounted credits).
+11.  Scoring + candidate-type classification + reasoning (+ region / gaps).
+12.  Employment-transition linking (Design §15).
+13.  Ranking + near-miss capping.
+14.  Audit snapshot (optional).
+"""
+
+from __future__ import annotations
+
+import logging
+
+from nw_agcore_bank_transactions.channels.tools.hints.BankTransactionHintTools import (
+    run_apply_bank_transaction_hints,
+)
+from nw_agcore_bank_transactions.pipeline._models.requests import BankTransactionRequest
+from nw_agcore_bank_transactions.pipeline._models.results import (
+    BankTransactionResult,
+    InputSummary,
+    ResultMetadata,
+    ValidationWarning,
+)
+from nw_agcore_bank_transactions.pipeline.amount_date_fallback import run_amount_date_fallback
+from nw_agcore_bank_transactions.pipeline.bonus_expense_split import run_bonus_expense_split
+from nw_agcore_bank_transactions.pipeline.employment_transition import (
+    run_link_employment_transitions,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    run_extract_bank_transaction_features,
+)
+from nw_agcore_bank_transactions.pipeline.graph_clustering import (
+    run_dedup_candidate_pool,
+    run_graph_clustering,
+)
+from nw_agcore_bank_transactions.pipeline.hints.AnchorFlags import features_from_transactions
+from nw_agcore_bank_transactions.pipeline.normalization import run_normalize_bank_transactions
+from nw_agcore_bank_transactions.pipeline.ranking import run_rank_candidates
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    NEAR_MISS_REASON,
+    partition_by_negative_keywords,
+    run_score_candidate_pool,
+)
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping import run_emit_skeleton_candidates
+from nw_agcore_bank_transactions.pipeline.validation import (
+    TransactionsAbsence,
+    run_validate_bank_transaction_payload,
+)
+from nw_aglib_toolkit.audit import AuditBuilder
+from nw_aglib_toolkit.pipeline.config import AppConfig, load_config
+from nw_core.calendar import WorkingDayCalendar, working_day_calendar_from_app_config
+from nw_core.logging import AddCallContext, LogFn, set_log_analysis_id
+
+from .config.SalaryConfig import (
+    salary_config_overrides_for_app_config,
+    salary_description_signals,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def _calendar_region(payload: BankTransactionRequest, cfg: AppConfig) -> str:
+    return payload.country_region or cfg.default_region()
+
+
+def _result_country_region(
+    payload: BankTransactionRequest,
+    cfg: AppConfig,
+    inferred_country_regions: tuple[str, ...],
+) -> str:
+    if payload.country_region is not None:
+        return payload.country_region
+    if inferred_country_regions:
+        return inferred_country_regions[0]
+    return cfg.default_region()
+
+
+class SalaryTransactionExtractorService:
+    """Stateful detector with shared config and calendar."""
+
+    def __init__(
+        self,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+    ) -> None:
+        self._config = config or load_config(
+            overrides=salary_config_overrides_for_app_config(),
+        )
+        self._calendar = calendar or working_day_calendar_from_app_config(self._config)
+        self._description_signals = salary_description_signals()
+
+    @property
+    def config(self) -> AppConfig:
+        return self._config
+
+    @property
+    def calendar(self) -> WorkingDayCalendar:
+        return self._calendar
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def detect(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+        transactions_absence: TransactionsAbsence | None = None,
+    ) -> BankTransactionResult:
+        """Run the full pipeline and return the final result."""
+        cfg = self._config
+        cal = self._calendar
+
+        validation_mode = mode or payload.validation_mode
+
+        versions = cfg.versions()
+        analysis_id = payload.analysis_id
+        set_log_analysis_id(analysis_id)
+        logger.info(
+            "salary_detector.start analysis_id=%s rows=%d mode=%s versions=%s include_audit=%s",
+            analysis_id,
+            len(payload.transactions),
+            validation_mode,
+            versions,
+            include_audit,
+        )
+
+        audit = AuditBuilder(
+            enabled=bool(include_audit),
+            analysis_id=analysis_id,
+            config_versions=dict(versions),
+            effective_kwargs={
+                "validation_mode": validation_mode,
+                "max_candidates": max_candidates,
+                "max_near_misses": max_near_misses,
+                "return_threshold": return_threshold,
+                "include_audit": include_audit,
+            },
+        )
+
+        warnings: list[ValidationWarning] = []
+
+        validate_result = run_validate_bank_transaction_payload(
+            payload,
+            mode=validation_mode,
+            transactions_absence=transactions_absence,
+            audit=audit,
+            warnings=warnings,
+        )
+        if validate_result.early_exit:
+            return _early_exit(
+                analysis_id,
+                warnings,
+                audit,
+                include_audit,
+                jurisdiction=payload.jurisdiction,
+                country_region=_calendar_region(payload, cfg),
+            )
+        validated_transactions = validate_result.transactions
+
+        norm_result = run_normalize_bank_transactions(
+            validated_transactions,
+            audit=audit,
+            warnings=warnings,
+        )
+        normalised = norm_result.transactions
+
+        extract_result = run_extract_bank_transaction_features(
+            normalised,
+            app_config=cfg,
+            calendar=cal,
+            region=_calendar_region(payload, cfg),
+            description_signals=self._description_signals,
+            audit=audit,
+            warnings=warnings,
+        )
+        normalised = extract_result.transactions
+        features = features_from_transactions(normalised)
+        features_by_id = {f.transaction_id: f for f in features}
+        audit.record_features(features)
+
+        hint_result = run_apply_bank_transaction_hints(
+            normalised,
+            hint_inputs=payload.hint_inputs,
+            audit=audit,
+            warnings=warnings,
+        )
+        applied_hints = hint_result.applied_hints
+        hint_inputs = hint_result.hint_inputs
+        normalised = hint_result.transactions
+        features_by_id = {
+            t.features.transaction_id: t.features for t in normalised if t.features is not None
+        }
+
+        skeleton_result = run_emit_skeleton_candidates(
+            normalised,
+            features_by_id,
+            applied_hints=applied_hints,
+            config=cfg,
+            audit=audit,
+            warnings=warnings,
+        )
+        skeleton_candidates = skeleton_result.candidates
+
+        graph_result = run_graph_clustering(
+            normalised,
+            features_by_id,
+            applied_hints=applied_hints,
+            config=cfg,
+            audit=audit,
+            warnings=warnings,
+        )
+        graph_candidates = graph_result.candidates
+
+        cg = cfg.candidate_generation()
+        overlap_threshold = float(cg.get("dedup_txn_id_overlap_pct", 0.90))
+        dedup_result = run_dedup_candidate_pool(
+            skeleton_candidates,
+            graph_candidates,
+            overlap_threshold=overlap_threshold,
+            audit=audit,
+            warnings=warnings,
+        )
+        pool = dedup_result.candidates
+
+        split_result = run_bonus_expense_split(
+            pool,
+            normalised,
+            audit=audit,
+            warnings=warnings,
+        )
+        pool = split_result.candidates
+
+        accounted_ids = {t.transaction_id for c in pool for t in c.transactions}
+        unaccounted = [t for t in normalised if t.id not in accounted_ids]
+        if unaccounted:
+            fallback_result = run_amount_date_fallback(
+                unaccounted,
+                cal,
+                features_by_id,
+                applied_hints=applied_hints,
+                config=cfg,
+                region=_calendar_region(payload, cfg),
+                audit=audit,
+                warnings=warnings,
+            )
+            fallback_candidates = fallback_result.candidates
+            if fallback_candidates:
+                pool = pool + fallback_candidates
+                if not skeleton_candidates and not graph_candidates:
+                    warnings.append(
+                        ValidationWarning(
+                            code="no_signal_detected",
+                            transaction_id="",
+                            detail=(
+                                "No description signal recovered; relying on "
+                                "amount + cadence alone."
+                            ),
+                        )
+                    )
+            elif not skeleton_candidates and not graph_candidates and unaccounted:
+                warnings.append(
+                    ValidationWarning(
+                        code="no_signal_detected",
+                        transaction_id="",
+                        detail=("No salary signal found in description, amount, or cadence."),
+                    )
+                )
+        if logger.isEnabledFor(5) and unaccounted:
+            for t in unaccounted:
+                logger.trace(
+                    "fallback.unaccounted  id=%s  date=%s  amount=%.2f  desc=%r",
+                    t.id,
+                    t.date,
+                    t.amount,
+                    t.normalised_description,
+                )
+
+        score_result = run_score_candidate_pool(
+            pool,
+            normalised=normalised,
+            features_by_id=features_by_id,
+            calendar=cal,
+            config=cfg,
+            applied_hints=applied_hints,
+            salary_hints=hint_inputs.salary_hints,
+            employer_hints=hint_inputs.employer_hints,
+            transactions_range=payload.transactions_range,
+            infer_regions=payload.country_region is None,
+            audit=audit,
+            warnings=warnings,
+        )
+        scored = list(score_result.scored)
+        inferred_country_regions = score_result.inferred_regions
+
+        transition_result = run_link_employment_transitions(
+            scored,
+            cfg,
+            audit=audit,
+            warnings=warnings,
+        )
+        scored = list(transition_result.scored)
+
+        kept, neg_rejected = partition_by_negative_keywords(scored, features_by_id)
+
+        ranking_result = run_rank_candidates(
+            kept,
+            cfg,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            audit=audit,
+            warnings=warnings,
+        )
+        returned = list(ranking_result.returned)
+        near_misses_combined = neg_rejected + list(ranking_result.near_misses)
+        near_misses_combined = near_misses_combined[: ranking_result.max_near_misses]
+        effective_return_threshold = ranking_result.return_threshold
+        effective_max_candidates = ranking_result.max_candidates
+        effective_max_near_misses = ranking_result.max_near_misses
+
+        summary = _build_summary(payload, normalised)
+
+        logger.info(
+            "salary_detector.finish analysis_id=%s credits=%d candidates=%d "
+            "near_misses=%d (cap_overflow=%d below_threshold=%d "
+            "negative_keyword_match=%d) warnings=%d",
+            analysis_id,
+            summary.credit_count,
+            len(returned),
+            len(near_misses_combined),
+            sum(
+                1
+                for c in near_misses_combined
+                if c.metadata.get("near_miss_reason") == "cap_overflow"
+            ),
+            sum(
+                1
+                for c in near_misses_combined
+                if c.metadata.get("near_miss_reason") == "below_threshold"
+            ),
+            sum(
+                1
+                for c in near_misses_combined
+                if c.metadata.get("near_miss_reason") == NEAR_MISS_REASON
+            ),
+            len(warnings),
+        )
+
+        audit.record_candidates(tuple(returned) + tuple(near_misses_combined))
+
+        result = BankTransactionResult(
+            analysis_id=analysis_id,
+            jurisdiction=payload.jurisdiction,
+            country_region=_result_country_region(payload, cfg, inferred_country_regions),
+            input_summary=summary,
+            candidate_sets=tuple(returned),
+            rejected_or_near_miss_sets=tuple(near_misses_combined),
+            warnings=tuple(warnings),
+            applied_hints=applied_hints,
+            inferred_country_regions=inferred_country_regions,
+            metadata=ResultMetadata(
+                config_versions=dict(versions),
+                return_threshold=effective_return_threshold,
+                max_candidates=effective_max_candidates,
+                max_near_misses=effective_max_near_misses,
+                validation_mode=validation_mode,
+                include_audit=bool(include_audit),
+            ),
+        )
+
+        snapshot = audit.snapshot()
+        if snapshot is not None:
+            from dataclasses import replace as _replace
+
+            result = _replace(result, audit=snapshot)
+        return result
+
+
+def _build_summary(payload: BankTransactionRequest, normalised) -> InputSummary:
+    txn_count = len(payload.transactions)
+    credit_count = len(normalised)
+    if normalised:
+        sorted_dates = sorted(n.date for n in normalised)
+        start = sorted_dates[0].isoformat()
+        end = sorted_dates[-1].isoformat()
+    else:
+        start = ""
+        end = ""
+    return InputSummary(
+        transaction_count=txn_count,
+        credit_count=credit_count,
+        date_range_start=start,
+        date_range_end=end,
+    )
+
+
+def _early_exit(
+    analysis_id: str,
+    warnings: list,
+    audit,
+    include_audit,
+    jurisdiction: str = "GB",
+    country_region: str = "EnglandAndWales",
+) -> BankTransactionResult:
+    """Return an empty result when the pipeline cannot proceed."""
+    return BankTransactionResult(
+        analysis_id=analysis_id,
+        jurisdiction=jurisdiction,
+        country_region=country_region,
+        input_summary=InputSummary(
+            transaction_count=0,
+            credit_count=0,
+            date_range_start="",
+            date_range_end="",
+        ),
+        candidate_sets=(),
+        rejected_or_near_miss_sets=(),
+        warnings=tuple(warnings),
+        applied_hints=None,
+        audit=audit.snapshot() if include_audit else None,
+    )
+
+
+__all__ = ["SalaryTransactionExtractorService"]
