+"""JSON-schema validation service — shared by tools and pipeline phases."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from importlib import resources
+from typing import Any
+
+from jsonschema import Draft202012Validator
+
+from nw_core.validation.ValidationWarning import ValidationWarning
+
+from .models.SchemaCheckConfig import SchemaCheckConfig
+from .models.SchemaCheckResult import SchemaCheckResult
+from .SchemaError import SchemaValidationError
+
+
+class SchemaCheckService:
+    """Validate payloads against a JSON Schema document or named subschema."""
+
+    def __init__(
+        self,
+        schema: Mapping[str, Any],
+        *,
+        config: SchemaCheckConfig | None = None,
+        warning_code: str = "schema_violation",
+    ) -> None:
+        self._schema = dict(schema)
+        self._config = config or SchemaCheckConfig()
+        self._warning_code = warning_code
+        self._validators: dict[str, Draft202012Validator] = {}
+
+    @classmethod
+    def from_resource(
+        cls,
+        package: str,
+        resource_name: str,
+        *,
+        config: SchemaCheckConfig | None = None,
+        warning_code: str = "schema_violation",
+    ) -> SchemaCheckService:
+        schema_file = resources.files(package) / resource_name
+        schema = json.loads(schema_file.read_text(encoding="utf-8"))
+        return cls(schema, config=config, warning_code=warning_code)
+
+    @property
+    def config(self) -> SchemaCheckConfig:
+        return self._config
+
+    def check(
+        self,
+        instance: Any,
+        *,
+        subschema: str | Mapping[str, Any] | None = None,
+        transaction_id: str = "",
+        detail_prefix: str = "",
+    ) -> SchemaCheckResult:
+        """Validate *instance* and return warnings or raise in strict mode."""
+        if not self._config.enabled:
+            return SchemaCheckResult()
+
+        validator = self._validator_for(subschema)
+        errors = sorted(validator.iter_errors(instance), key=lambda e: list(e.path))
+        if not errors:
+            return SchemaCheckResult()
+
+        if self._config.strict:
+            first = errors[0]
+            path = list(first.path)
+            raise SchemaValidationError(f"schema validation failed at {path}: {first.message}")
+
+        warnings = tuple(
+            ValidationWarning(
+                code=self._warning_code,
+                transaction_id=transaction_id or _transaction_id_for(instance, error),
+                detail=f"{detail_prefix}{list(error.path)}: {error.message}",
+            )
+            for error in errors
+        )
+        return SchemaCheckResult(warnings=warnings, valid=False)
+
+    def _validator_for(
+        self,
+        subschema: str | Mapping[str, Any] | None,
+    ) -> Draft202012Validator:
+        if subschema is None:
+            cache_key = "__root__"
+            resolved = self._schema
+        elif isinstance(subschema, str):
+            cache_key = f"$defs:{subschema}"
+            defs = self._schema.get("$defs")
+            if not isinstance(defs, Mapping) or subschema not in defs:
+                raise KeyError(f"subschema not found in $defs: {subschema!r}")
+            resolved = defs[subschema]
+        else:
+            cache_key = json.dumps(subschema, sort_keys=True, default=str)
+            resolved = dict(subschema)
+
+        cached = self._validators.get(cache_key)
+        if cached is not None:
+            return cached
+
+        validator = Draft202012Validator(resolved)
+        self._validators[cache_key] = validator
+        return validator
+
+
+def _transaction_id_for(instance: Any, error) -> str:
+    path = list(error.path)
+    if path and isinstance(instance, list):
+        idx = path[0]
+        if isinstance(idx, int) and 0 <= idx < len(instance):
+            row = instance[idx]
+            if isinstance(row, Mapping):
+                txn_id = row.get("id")
+                if isinstance(txn_id, str):
+                    return txn_id
+    if isinstance(instance, Mapping):
+        txn_id = instance.get("id")
+        if isinstance(txn_id, str):
+            return txn_id
+    return ""
