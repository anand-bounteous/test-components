+"""Phase 7 — clustering (graph build, connected components, split/merge)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    extract_bank_transactions_features,
+)
+from nw_agcore_bank_transactions.pipeline.graph_clustering import (
+    GraphClusteringService,
+    dedup_candidate_pool,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_aglib_toolkit.pipeline.config import load_config
+from nw_core.calendar import WorkingDayCalendar
+
+
+def _txn(tid, datestr, desc, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=datestr,
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+@pytest.fixture(scope="module")
+def detector_and_features():
+    cfg = load_config()
+    detector = GraphClusteringService(config=cfg)
+    cal = WorkingDayCalendar()
+
+    def extract(txns):
+        return extract_bank_transactions_features(txns, app_config=cfg, calendar=cal)
+
+    return detector, extract
+
+
+def _build(detector, extract, txns):
+    txns = extract(txns)
+    by_id = {t.id: t.features for t in txns if t.features is not None}
+    return detector, by_id
+
+
+# --- Graph build --------------------------------------------------------
+
+
+def test_graph_build_finds_strong_edges_for_repeating_salary(detector_and_features):
+    detector, extract = detector_and_features
+    txns = [
+        _txn("a1", "2024-01-31", "BACS ACME LTD PAYROLL 1001", "2450"),
+        _txn("a2", "2024-02-29", "BACS ACME LTD PAYROLL 1002", "2450"),
+        _txn("a3", "2024-03-28", "BACS ACME LTD PAYROLL 1003", "2450"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    edges = detector.build_graph(txns, by_id)
+    assert len(edges) == 3  # all pairs
+
+
+def test_graph_build_skips_below_threshold(detector_and_features):
+    detector, extract = detector_and_features
+    # Two unrelated credits — different descriptions, different amounts,
+    # different channels — produce no edge.
+    txns = [
+        _txn("a", "2024-01-15", "BACS ACME LTD PAYROLL", "2450"),
+        _txn("b", "2024-04-22", "FPI XYZ SERVICES REFUND", "120"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    edges = detector.build_graph(txns, by_id)
+    assert edges == {}
+
+
+# --- Clustering ---------------------------------------------------------
+
+
+def test_two_employers_split_into_two_clusters(detector_and_features):
+    detector, extract = detector_and_features
+    # Six credits split across ACME and GLOBEX — no shared employer tokens.
+    txns = [
+        _txn("a1", "2024-01-31", "BACS ACME LTD PAYROLL 1", "2450"),
+        _txn("a2", "2024-02-29", "BACS ACME LTD PAYROLL 2", "2450"),
+        _txn("a3", "2024-03-28", "BACS ACME LTD PAYROLL 3", "2450"),
+        _txn("b1", "2024-01-31", "BACS GLOBEX LTD WAGES 1", "2800"),
+        _txn("b2", "2024-02-29", "BACS GLOBEX LTD WAGES 2", "2800"),
+        _txn("b3", "2024-03-28", "BACS GLOBEX LTD WAGES 3", "2800"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    candidates = detector.emit_candidates(txns, by_id)
+    assert len(candidates) == 2
+    txn_ids_per_candidate = [sorted({t.transaction_id for t in c.transactions}) for c in candidates]
+    # ACME cluster + GLOBEX cluster — each contains exactly its three rows.
+    acme = next(ids for ids in txn_ids_per_candidate if ids[0].startswith("a"))
+    globex = next(ids for ids in txn_ids_per_candidate if ids[0].startswith("b"))
+    assert acme == ["a1", "a2", "a3"]
+    assert globex == ["b1", "b2", "b3"]
+
+
+def test_payroll_provider_change_merges_in_graph_with_continuity(detector_and_features):
+    """Description changes mid-year (ADP → SAGE) but amount + cadence
+    continuity is strong. The graph should still cluster them together
+    because the amount/date edges remain strong."""
+    detector, extract = detector_and_features
+    txns = [
+        _txn("p1", "2024-01-31", "BACS ADP PAYROLL ACME 1", "2450"),
+        _txn("p2", "2024-02-29", "BACS ADP PAYROLL ACME 2", "2450"),
+        _txn("p3", "2024-03-28", "BACS ADP PAYROLL ACME 3", "2450"),
+        _txn("p4", "2024-04-30", "BACS SAGE PAYROLL ACME 4", "2450"),
+        _txn("p5", "2024-05-31", "BACS SAGE PAYROLL ACME 5", "2450"),
+        _txn("p6", "2024-06-28", "BACS SAGE PAYROLL ACME 6", "2450"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    candidates = detector.emit_candidates(txns, by_id)
+    assert len(candidates) == 1
+    assert len(candidates[0].transactions) == 6
+
+
+def test_clustering_excludes_single_credit_clusters(detector_and_features):
+    detector, extract = detector_and_features
+    txns = [
+        _txn("a1", "2024-01-31", "BACS ACME LTD PAYROLL 1", "2450"),
+        _txn("a2", "2024-02-29", "BACS ACME LTD PAYROLL 2", "2450"),
+        _txn("loner", "2024-06-12", "FPI ONE OFF GIFT", "500"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    candidates = detector.emit_candidates(txns, by_id)
+    # Loner has no edges — its singleton cluster is not emitted.
+    assert all(len(c.transactions) >= 2 for c in candidates)
+    txn_ids = {t.transaction_id for c in candidates for t in c.transactions}
+    assert "loner" not in txn_ids
+
+
+# --- Dedup with skeleton ------------------------------------------------
+
+
+def test_dedup_collapses_full_overlap_into_one(detector_and_features):
+    """When skeleton and graph produce the same set, dedup keeps one."""
+    detector, extract = detector_and_features
+    txns = [
+        _txn("t1", "2024-01-31", "BACS ACME LTD PAYROLL 1001", "2450"),
+        _txn("t2", "2024-02-29", "BACS ACME LTD PAYROLL 1002", "2450"),
+        _txn("t3", "2024-03-28", "BACS ACME LTD PAYROLL 1003", "2450"),
+    ]
+    _, by_id = _build(detector, extract, txns)
+    graph_candidates = detector.emit_candidates(txns, by_id)
+
+    from nw_agcore_bank_transactions.pipeline.skeleton_grouping import SkeletonGroupingService
+
+    skeleton_candidates = SkeletonGroupingService(config=load_config()).emit_plausible_sets(
+        txns, by_id
+    )
+    merged = dedup_candidate_pool(skeleton_candidates, graph_candidates)
+    assert len(merged) == 1
+    # The merged record's metadata names both sources.
+    sources = set(merged[0].metadata.get("merged_sources", []))
+    assert "graph_clustering" in sources
+    assert "skeleton_grouping" in sources
+
+
+def test_dedup_keeps_disjoint_candidates_separate(detector_and_features):
+    """Disjoint candidates (different transactions altogether) are kept."""
+    detector, extract = detector_and_features
+    txns_a = [
+        _txn("a1", "2024-01-31", "BACS ACME LTD PAYROLL 1", "2450"),
+        _txn("a2", "2024-02-29", "BACS ACME LTD PAYROLL 2", "2450"),
+    ]
+    txns_b = [
+        _txn("b1", "2024-01-15", "BACS GLOBEX LTD WAGES 1", "2800"),
+        _txn("b2", "2024-02-15", "BACS GLOBEX LTD WAGES 2", "2800"),
+    ]
+    all_txns = txns_a + txns_b
+    _, by_id = _build(detector, extract, all_txns)
+    graph_candidates = detector.emit_candidates(all_txns, by_id)
+
+    from nw_agcore_bank_transactions.pipeline.skeleton_grouping import SkeletonGroupingService
+
+    skeleton_candidates = SkeletonGroupingService(config=load_config()).emit_plausible_sets(
+        all_txns, by_id
+    )
+    merged = dedup_candidate_pool(skeleton_candidates, graph_candidates)
+    assert len(merged) == 2
+    # Each candidate has 2 transactions; together they cover all 4.
+    all_ids = {t.transaction_id for c in merged for t in c.transactions}
+    assert all_ids == {"a1", "a2", "b1", "b2"}
+
+
+def test_dedup_with_only_skeleton_input_passes_through():
+    from nw_agcore_bank_transactions.pipeline.skeleton_grouping import SkeletonGroupingService
+
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    txns = [
+        _txn("a1", "2024-01-31", "BACS ACME LTD PAYROLL 1", "2450"),
+        _txn("a2", "2024-02-29", "BACS ACME LTD PAYROLL 2", "2450"),
+    ]
+    txns = extract_bank_transactions_features(txns, app_config=cfg, calendar=cal)
+    feats = [t.features for t in txns if t.features is not None]
+    by_id = {f.transaction_id: f for f in feats}
+    skeleton_candidates = SkeletonGroupingService(config=cfg).emit_plausible_sets(txns, by_id)
+    merged = dedup_candidate_pool(skeleton_candidates, ())
+    assert len(merged) == len(skeleton_candidates)
+
+
+def test_dedup_empty_input_returns_empty():
+    assert dedup_candidate_pool((), ()) == ()
