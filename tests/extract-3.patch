+"""Run the appropriate detector for a scenario module."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from nw_agbus_gift_extractor.services.GiftRequestParsing import gift_request_from_mapping
+from nw_agbus_gift_extractor.services.GiftTransactionExtractorService import (
+    GiftTransactionExtractorService,
+)
+from nw_agbus_property_sale_extractor.services.PropertySaleRequestParsing import (
+    property_sale_request_from_mapping,
+)
+from nw_agbus_property_sale_extractor.services.PropertySaleTransactionExtractorService import (
+    PropertySaleTransactionExtractorService,
+)
+from nw_agbus_rent_extractor.services.RentRequestParsing import rent_request_from_mapping
+from nw_agbus_rent_extractor.services.RentTransactionExtractorService import (
+    RentTransactionExtractorService,
+)
+
+from tests.feature.support.DetectKwargs import detect_kwargs_from_expected
+from tests.feature.support.DetectFromFixture import detect_from_fixture
+
+_MODULE_HINT_KEYS = {
+    "employment": ("salary_hints", "employer_hints", "payslip_hints"),
+    "rent": ("rent_hints",),
+    "gift": ("gift_hints",),
+    "property_sale": ("sale_hints",),
+}
+
+
+def _payload_for_module(raw: Mapping[str, Any], module: str) -> dict[str, Any]:
+    """Build a detector-specific request dict from a combination or single-module fixture."""
+    body = dict(raw)
+    hints_by_module = raw.get("hints_by_module") or {}
+    if module in hints_by_module:
+        hint_block = hints_by_module[module]
+        if module == "rent":
+            body["rent_hints"] = hint_block
+        elif module == "gift":
+            body["gift_hints"] = hint_block
+        elif module == "property_sale":
+            body["sale_hints"] = hint_block
+        elif module == "employment":
+            for key in ("salary_hints", "employer_hints", "payslip_hints"):
+                if key in hint_block:
+                    body[key] = hint_block[key]
+    for other_mod, keys in _MODULE_HINT_KEYS.items():
+        if other_mod != module:
+            for key in keys:
+                body.pop(key, None)
+    return body
+
+
+def detect_scenario(
+    module: str,
+    raw: Mapping[str, Any],
+    *,
+    include_audit: bool = False,
+    **kwargs: Any,
+) -> Any:
+    """Dispatch to the detector matching ``scenarios/{module}/``."""
+    if module == "combination":
+        modules = list(raw.get("modules") or [])
+        expected_by_module = raw.get("expected_by_module") or {}
+        return {
+            mod: detect_scenario(
+                mod,
+                _payload_for_module(raw, mod),
+                include_audit=include_audit,
+                **detect_kwargs_from_expected(expected_by_module.get(mod)),
+            )
+            for mod in modules
+        }
+
+    payload = _payload_for_module(raw, module)
+
+    if module == "employment":
+        return detect_from_fixture(payload, include_audit=include_audit, **kwargs)
+    if module == "rent":
+        return RentTransactionExtractorService().detect(
+            rent_request_from_mapping(payload),
+            include_audit=include_audit,
+            **kwargs,
+        )
+    if module == "property_sale":
+        return PropertySaleTransactionExtractorService().detect(
+            property_sale_request_from_mapping(payload),
+            include_audit=include_audit,
+            **kwargs,
+        )
+    if module == "gift":
+        return GiftTransactionExtractorService().detect(
+            gift_request_from_mapping(payload),
+            include_audit=include_audit,
+            **kwargs,
+        )
+    raise ValueError(
+        f"Unknown scenario module {module!r}; expected employment, rent, property_sale, gift, or combination"
+    )
+
+
+__all__ = ["detect_scenario", "_payload_for_module"]
