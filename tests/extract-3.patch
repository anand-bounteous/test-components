+"""Phase 7 — edge formula for the similarity graph (Design §10.2)."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.graph_clustering import (
+    amount_similarity,
+    compute_edge_score,
+    counterparty_similarity,
+    date_compatibility,
+    description_similarity,
+    payment_channel_compatibility,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+
+
+def _txn(tid, datestr, desc, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=datestr,
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _features(tid, channel="bacs_or_direct_credit", employer=(), negative=()):
+    return TransactionFeatures(
+        transaction_id=tid,
+        payment_channel=channel,
+        payment_channel_confidence=0.7,
+        payment_channel_matched_tokens=("BACS",),
+        possible_employer_tokens=employer,
+        negative_tokens=negative,
+    )
+
+
+# --- description_similarity ---------------------------------------------
+
+
+def test_description_similarity_identical_tokens_is_one():
+    assert description_similarity(("BACS", "ACME"), ("BACS", "ACME")) == 1.0
+
+
+def test_description_similarity_no_overlap_is_zero():
+    assert description_similarity(("BACS", "ACME"), ("FPI", "XYZ")) == 0.0
+
+
+def test_description_similarity_partial_overlap_is_in_range():
+    sim = description_similarity(("BACS", "ACME", "PAYROLL"), ("BACS", "ACME", "SALARY"))
+    assert 0.0 < sim < 1.0
+
+
+def test_description_similarity_empty_inputs_is_zero():
+    assert description_similarity((), ()) == 0.0
+
+
+# --- date_compatibility -------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "a,b,expected_high",
+    [
+        (date(2024, 1, 31), date(2024, 2, 29), True),  # monthly
+        (date(2024, 1, 5), date(2024, 1, 12), True),  # weekly
+        (date(2024, 1, 5), date(2024, 1, 19), True),  # fortnightly
+        (date(2024, 1, 31), date(2024, 4, 30), False),  # 90 days apart
+    ],
+)
+def test_date_compatibility_recognises_periods(a, b, expected_high):
+    score = date_compatibility(a, b)
+    if expected_high:
+        assert score == 1.0
+    else:
+        assert score < 0.5
+
+
+def test_date_compatibility_same_day_is_zero():
+    assert date_compatibility(date(2024, 1, 31), date(2024, 1, 31)) == 0.0
+
+
+def test_date_compatibility_same_month_gets_partial_credit():
+    # 1-day gap inside the same month falls outside every period window;
+    # the same-month rule grants partial credit.
+    score = date_compatibility(date(2024, 1, 1), date(2024, 1, 2))
+    assert 0.0 < score < 1.0
+
+
+# --- amount_similarity --------------------------------------------------
+
+
+def test_amount_similarity_within_tolerance_is_one():
+    assert amount_similarity(Decimal("2450"), Decimal("2455")) == 1.0
+
+
+def test_amount_similarity_decays_outside_tolerance():
+    score = amount_similarity(Decimal("2450"), Decimal("3000"))
+    assert 0.0 < score < 1.0
+
+
+def test_amount_similarity_very_different_decays_low():
+    """Linear decay never quite reaches zero on a single comparison —
+    the function is `max(0, 1 - (relative - tolerance))`, so a 98 %
+    relative spread leaves a small residual. The contract is "low",
+    not "exactly zero"."""
+    score = amount_similarity(Decimal("100"), Decimal("5000"))
+    assert score < 0.20
+
+
+def test_amount_similarity_both_zero_is_one():
+    assert amount_similarity(Decimal("0"), Decimal("0")) == 1.0
+
+
+# --- payment_channel_compatibility --------------------------------------
+
+
+def test_channel_compatibility_same_channel_is_one():
+    assert payment_channel_compatibility("bacs_or_direct_credit", "bacs_or_direct_credit") == 1.0
+
+
+def test_channel_compatibility_unknown_one_side_is_half():
+    assert payment_channel_compatibility("bacs_or_direct_credit", "unknown_credit") == 0.5
+
+
+def test_channel_compatibility_distinct_channels_is_low():
+    assert payment_channel_compatibility("bacs_or_direct_credit", "internal_transfer") == 0.2
+
+
+# --- counterparty_similarity --------------------------------------------
+
+
+def test_counterparty_exact_match_is_one():
+    assert counterparty_similarity("Acme Ltd", "ACME LTD") == 1.0
+
+
+def test_counterparty_one_missing_returns_partial():
+    assert counterparty_similarity("Acme Ltd", None) == 0.4
+
+
+def test_counterparty_both_missing_returns_half():
+    assert counterparty_similarity(None, None) == 0.5
+
+
+def test_counterparty_distinct_names_is_low():
+    assert counterparty_similarity("Acme Ltd", "Globex Ltd") == 0.2
+
+
+# --- compute_edge_score (integration of all axes) -----------------------
+
+
+def test_edge_score_high_for_two_similar_salary_credits():
+    """Two near-identical salary credits — reference-numbers differ so the
+    Jaccard score is 5/7 ≈ 0.71 (5 shared tokens out of 7 unique), but
+    every other axis is at 1.0 → overall final stays well above 0.85.
+    """
+    a = _txn("a", "2024-01-31", "BACS CREDIT ACME LTD PAYROLL 1001", "2450.32")
+    b = _txn("b", "2024-02-29", "BACS CREDIT ACME LTD PAYROLL 1002", "2450.32")
+    edge = compute_edge_score(
+        a, b, _features("a", employer=("ACME",)), _features("b", employer=("ACME",))
+    )
+    assert edge.final >= 0.85
+    assert edge.description >= 0.7
+    assert edge.date == 1.0
+    assert edge.amount == 1.0
+    assert edge.channel == 1.0
+    assert edge.counterparty == 0.5
+
+
+def test_edge_score_low_for_distinct_credits():
+    a = _txn("a", "2024-01-31", "BACS ACME LTD PAYROLL", "2450.00")
+    b = _txn("b", "2024-04-15", "FPI XYZ SERVICES DIVIDEND", "120.00")
+    edge = compute_edge_score(
+        a, b, _features("a"), _features("b", channel="faster_payment", negative=("DIVIDEND",))
+    )
+    assert edge.final < 0.55
+
+
+def test_edge_score_negative_penalty_applied_when_one_side_is_negative_signal():
+    a = _txn("a", "2024-01-31", "BACS ACME LTD PAYROLL", "2450.00")
+    b = _txn("b", "2024-02-29", "BACS DWP UNIVERSAL CREDIT", "2450.00")
+    edge = compute_edge_score(a, b, _features("a"), _features("b", negative=("DWP",)))
+    assert edge.negative_penalty == 0.20
+    # final still positive but visibly lower than no-penalty equivalent.
+    assert edge.final < 0.85
+
+
+def test_edge_score_same_negative_signal_on_both_sides_no_penalty():
+    a = _txn("a", "2024-01-15", "BACS DWP UNIVERSAL CREDIT", "627.40")
+    b = _txn("b", "2024-02-15", "BACS DWP UNIVERSAL CREDIT", "627.40")
+    edge = compute_edge_score(
+        a,
+        b,
+        _features("a", negative=("DWP",)),
+        _features("b", negative=("DWP",)),
+    )
+    assert edge.negative_penalty == 0.0
