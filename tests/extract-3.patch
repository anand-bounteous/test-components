+"""
+Subprocess entry point for img2table table extraction with DocTR OCR.
+
+Reads JSON from stdin:  {"pages": [{"page_index", "image_path", "width", "height", "dpi"}], "params": {...}}
+Writes JSON to stdout:  {"pages": [{"page_index", "regions": [...], "tables": [...]}], "failures": [...]}
+"""
+from __future__ import annotations
+
+import json
+import sys
+import traceback
+import uuid
+
+
+def _table_confidence(t) -> float:
+    rows = t.content or {}
+    total = 0
+    filled = 0
+    for row in rows.values():
+        for cell in row:
+            total += 1
+            value = getattr(cell, "value", None) or ""
+            if str(value).strip():
+                filled += 1
+    if total == 0:
+        return 0.0
+    return max(0.4, min(1.0, filled / total))
+
+
+def _make_ocr(params: dict):
+    backend = (params.get("ocr_backend") or "doctr").lower()
+    if backend == "doctr":
+        from img2table.ocr import DocTR  # type: ignore
+        return DocTR(detect_language=False)
+    if backend == "tesseract":
+        from img2table.ocr import TesseractOCR  # type: ignore
+        return TesseractOCR(n_threads=1, lang=params.get("lang", "eng"))
+    raise ValueError(f"unknown ocr_backend: {backend!r}")
+
+
+def _run() -> None:
+    from img2table.document import Image as Img2TableImage  # type: ignore
+
+    payload = json.loads(sys.stdin.read())
+    params = payload.get("params") or {}
+    ocr = _make_ocr(params)
+    failures: list[dict] = []
+    output_pages = []
+
+    for p in payload["pages"]:
+        dpi: int = p["dpi"]
+        page_index: int = p["page_index"]
+        cs = f"image_px@{dpi}"
+        try:
+            img_doc = Img2TableImage(src=p["image_path"])
+            extracted = img_doc.extract_tables(
+                ocr=ocr,
+                implicit_rows=bool(params.get("implicit_rows", True)),
+                borderless_tables=bool(params.get("borderless_tables", True)),
+                min_confidence=int(params.get("min_confidence", 50)),
+            )
+        except Exception as exc:
+            traceback.print_exc(file=sys.stderr)
+            failures.append({"page_index": page_index, "error": f"{type(exc).__name__}: {exc}"})
+            output_pages.append({"page_index": page_index, "regions": [], "tables": []})
+            continue
+
+        regions = []
+        tables = []
+        for t in extracted:
+            try:
+                tbb = t.bbox
+                region_id = uuid.uuid4().hex[:10]
+                regions.append({
+                    "id": region_id,
+                    "type": "table",
+                    "bbox": {
+                        "x": float(tbb.x1), "y": float(tbb.y1),
+                        "w": float(tbb.x2 - tbb.x1), "h": float(tbb.y2 - tbb.y1),
+                        "page_index": page_index, "coord_space": cs,
+                    },
+                    "text": "",
+                    "confidence": float(_table_confidence(t)),
+                    "source_tool": "img2table",
+                    "attributes": {"title": getattr(t, "title", None) or ""},
+                    "pii_spans": [],
+                })
+                rows = t.content or {}
+                row_keys = sorted(rows.keys())
+                cells = []
+                max_cols = 0
+                for r_idx, r_key in enumerate(row_keys):
+                    row_cells = rows[r_key] or []
+                    max_cols = max(max_cols, len(row_cells))
+                    for c_idx, cell in enumerate(row_cells):
+                        cb = getattr(cell, "bbox", None)
+                        cell_value = getattr(cell, "value", None)
+                        text = (cell_value or "").strip() if isinstance(cell_value, str) else ""
+                        cell_bbox = None
+                        if cb is not None:
+                            cell_bbox = {
+                                "x": float(cb.x1), "y": float(cb.y1),
+                                "w": float(cb.x2 - cb.x1), "h": float(cb.y2 - cb.y1),
+                                "page_index": page_index, "coord_space": cs,
+                            }
+                        cells.append({
+                            "row": r_idx, "col": c_idx,
+                            "text": text, "bbox": cell_bbox,
+                            "multiline": "\n" in text,
+                        })
+                tables.append({
+                    "region_id": region_id,
+                    "n_rows": len(row_keys),
+                    "n_cols": max_cols,
+                    "border_mode": "mixed",
+                    "orientation": "horizontal",
+                    "cells": cells,
+                })
+            except Exception as exc:
+                traceback.print_exc(file=sys.stderr)
+                failures.append({"page_index": page_index, "error": f"table-walk {type(exc).__name__}: {exc}"})
+
+        output_pages.append({"page_index": page_index, "regions": regions, "tables": tables})
+
+    sys.stdout.write(json.dumps({"pages": output_pages, "failures": failures}))
+
+
+if __name__ == "__main__":
+    _run()
