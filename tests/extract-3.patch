+        assert any(r.confidence < 1.0 for r in doctr_regions)
+
+    def test_img2table_tables(self, benchmark_run: BenchmarkRunManifest):
+        result = _load_result(Path(benchmark_run.run_dir), "img2table_doctr")
+        page = result.pages[0]
+        table_regions = [r for r in page.regions if r.type.value == "table"]
+        assert len(page.tables) >= 1
+        assert len(table_regions) >= 1
+        assert any(cell.text for t in page.tables for cell in t.cells)
