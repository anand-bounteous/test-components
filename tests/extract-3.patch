+
+__all__ = [
+    "BankTransactionScoringTools",
+    "ScoringToolResult",
+    "run_score_candidate_pool",
+    "run_score_hint_groups",
+    "run_score_recurrence_pool",
+]
+
+RecurrenceProfile = Literal["salary", "rent"]
+HintAmountProfile = Literal["gift", "property_sale"]
+
+
+def _asdict_safe(obj) -> dict:
+    try:
+        from dataclasses import asdict
+
+        return asdict(obj)
+    except Exception:
+        return {}
+
+
+def _score_salary_pool_with_postprocess(
+    pool: Iterable[CandidateSet],
+    *,
+    normalised: Sequence[BankTransaction],
+    features_by_id: Mapping[str, TransactionFeatures],
+    calendar: WorkingDayCalendar,
+    config: AppConfig,
+    applied_hints: AppliedHints | None = None,
+    salary_hints: SalaryHints | None = None,
+    employer_hints=None,
+    transactions_range: TransactionsRange | None = None,
+    infer_regions: bool = True,
+) -> ScoringToolResult:
+    scored = score_recurrence_pool(
+        pool,
+        normalised=normalised,
+        features_by_id=features_by_id,
+        calendar=calendar,
+        config=config,
+        applied_hints=applied_hints,
+        salary_hints=salary_hints,
+        employer_hints=employer_hints,
+        transactions_range=transactions_range,
+    )
+    inferred_country_regions: tuple[str, ...] = ()
+    tool_warnings: list[ValidationWarning] = []
+
+    if infer_regions:
+        inferred_country_regions, scored, tool_warnings = infer_country_regions(
+            scored, normalised, calendar, tool_warnings
+        )
+
+    scored, gap_warnings = apply_gap_periods(scored, tool_warnings)
+    return ScoringToolResult(
+        scored=tuple(scored),
+        inferred_regions=inferred_country_regions,
+        warnings=tuple(gap_warnings),
+    )
+
+
+class BankTransactionScoringTools(BaseTool[ScoringToolResult]):
+    phase_name = "scoring"
+
+    @LogFn
+    def _execute(
+        self,
+        pool: Iterable[CandidateSet],
+        *,
+        normalised: Sequence[BankTransaction],
+        features_by_id: Mapping[str, TransactionFeatures],
+        calendar: WorkingDayCalendar,
+        config: AppConfig,
+        applied_hints: AppliedHints | None = None,
+        salary_hints: SalaryHints | None = None,
+        employer_hints=None,
+        transactions_range: TransactionsRange | None = None,
+        infer_regions: bool = True,
+    ) -> ScoringToolResult:
+        result = _score_salary_pool_with_postprocess(
+            pool,
+            normalised=normalised,
+            features_by_id=features_by_id,
+            calendar=calendar,
+            config=config,
+            applied_hints=applied_hints,
+            salary_hints=salary_hints,
+            employer_hints=employer_hints,
+            transactions_range=transactions_range,
+            infer_regions=infer_regions,
+        )
+        for scored_candidate in result.scored:
+            self._logger.debug(
+                "scoring.candidate  id=%s  type=%s  conf=%.4f  band=%s",
+                scored_candidate.candidate_set_id,
+                scored_candidate.candidate_type,
+                scored_candidate.confidence,
+                scored_candidate.confidence_band,
+            )
+            if self._logger.isEnabledFor(TRACE):
+                self._logger.trace(
+                    "scoring.detail  id=%s  reasoning=%s  risks=%s  score=%s",
+                    scored_candidate.candidate_set_id,
+                    list(scored_candidate.reasoning),
+                    list(scored_candidate.risks),
+                    {
+                        k: round(v, 4) if isinstance(v, float) else v
+                        for k, v in _asdict_safe(scored_candidate.score_breakdown).items()
+                    },
+                )
+        return result
+
+    def build_input_summary(
+        self,
+        pool: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(pool, (list, tuple)):
+            return {"pool": len(pool)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: ScoringToolResult,
+        pool: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        missing_period_warnings = sum(
+            1 for w in result.warnings if w.code == "missing_salary_periods"
+        )
+        return {
+            "scored": len(result.scored),
+            "inferred_regions": list(result.inferred_regions),
+            "missing_period_warnings": missing_period_warnings,
+        }
+
+
+_default_tool = BankTransactionScoringTools()
+
+
+@tool(
+    name="run_score_candidate_pool",
+    description="Run score candidate pool.",
+    category="banking.scoring",
+    tags=["banking", "scoring"],
+)
+def run_score_candidate_pool(
+    pool: Iterable[CandidateSet],
+    *,
+    normalised: Sequence[BankTransaction],
+    features_by_id: Mapping[str, TransactionFeatures],
+    calendar: WorkingDayCalendar,
+    config: AppConfig,
+    applied_hints: AppliedHints | None = None,
+    salary_hints: SalaryHints | None = None,
+    employer_hints=None,
+    transactions_range: TransactionsRange | None = None,
+    infer_regions: bool = True,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> ScoringToolResult:
+    """Score salary candidate sets and enrich them with confidence breakdowns."""
+    return _default_tool.run(
+        pool,
+        audit=audit,
+        warnings=warnings,
+        normalised=normalised,
+        features_by_id=features_by_id,
+        calendar=calendar,
+        config=config,
+        applied_hints=applied_hints,
+        salary_hints=salary_hints,
+        employer_hints=employer_hints,
+        transactions_range=transactions_range,
+        infer_regions=infer_regions,
+    )
+
+
+@tool(
+    name="run_score_recurrence_pool",
+    description="Score recurrence candidate pool with salary or rent profile.",
+    category="banking.scoring",
+    tags=["banking", "scoring"],
+)
+def run_score_recurrence_pool(
+    pool: Iterable[CandidateSet],
+    *,
+    profile: RecurrenceProfile,
+    normalised: Sequence[BankTransaction],
+    features_by_id: Mapping[str, TransactionFeatures],
+    calendar: WorkingDayCalendar,
+    config: AppConfig,
+    applied_hints: AppliedHints | None = None,
+    salary_hints: SalaryHints | None = None,
+    employer_hints=None,
+    rent_hints: RentHints | None = None,
+    transactions_range: TransactionsRange | None = None,
+    infer_regions: bool = True,
+    rent_weights: Mapping[str, float] | None = None,
+    rent_thresholds: Mapping[str, Any] | None = None,
+    rent_candidate_generation: Mapping[str, Any] | None = None,
+    rent_positive_keywords: Sequence[str] = (),
+    rent_negative_keywords: Sequence[str] = (),
+    rent_hint_matcher=None,
+    rent_hint_cfg: Mapping[str, Any] | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> ScoringToolResult:
+    """Score recurrence-based candidate pools for salary or rent detectors."""
+    if profile == "salary":
+        return _score_salary_pool_with_postprocess(
+            pool,
+            normalised=normalised,
+            features_by_id=features_by_id,
+            calendar=calendar,
+            config=config,
+            applied_hints=applied_hints,
+            salary_hints=salary_hints,
+            employer_hints=employer_hints,
+            transactions_range=transactions_range,
+            infer_regions=infer_regions,
+        )
+
+    assert rent_hints is not None
+    scored = score_rent_pool(
+        pool,
+        normalised=normalised,
+        features_by_id=features_by_id,
+        calendar=calendar,
+        config=config,
+        hint_inputs=rent_hints,
