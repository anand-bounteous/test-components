+import type { CSSProperties } from "react";
+import type { AccountDetails } from "../../types";
+
+export type AccountSummaryProps = {
+  account: AccountDetails;
+};
+
+function formatMoney(value: number | undefined, currency?: string): string {
+  if (value === undefined) return "—";
+  const formatted = value.toLocaleString(undefined, {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+  return currency ? `${currency} ${formatted}` : formatted;
+}
+
+export function AccountSummary({ account }: AccountSummaryProps) {
+  const fields: Array<{ label: string; value: string | undefined }> = [
+    { label: "Account holder", value: account.accountHolder },
+    { label: "Account number", value: account.accountNumber },
+    { label: "Sort code", value: account.sortCode },
+    { label: "Bank", value: account.bankName },
+    {
+      label: "Statement period",
+      value:
+        account.statementPeriod?.from && account.statementPeriod?.to
+          ? `${account.statementPeriod.from} – ${account.statementPeriod.to}`
+          : undefined,
+    },
+    {
+      label: "Opening balance",
+      value: formatMoney(account.openingBalance, account.currency),
+    },
+    {
+      label: "Closing balance",
+      value: formatMoney(account.closingBalance, account.currency),
+    },
+  ].filter((field) => field.value !== undefined && field.value !== "");
+
+  return (
+    <section style={styles.section} data-testid="account-summary">
+      <h2 style={styles.heading}>Account details</h2>
+      {fields.length === 0 ? (
+        <p style={styles.empty}>No account details available.</p>
+      ) : (
+        <dl style={styles.grid}>
+          {fields.map((field) => (
+            <div key={field.label} style={styles.row}>
+              <dt style={styles.label}>{field.label}</dt>
+              <dd style={styles.value}>{field.value}</dd>
+            </div>
+          ))}
+        </dl>
+      )}
+    </section>
+  );
+}
+
+const styles: Record<string, CSSProperties> = {
+  section: {
+    padding: "16px",
+    borderBottom: "1px solid #e5e7eb",
+  },
+  heading: {
+    margin: "0 0 12px",
+    fontSize: "16px",
+    fontWeight: 600,
+  },
+  empty: {
+    margin: 0,
+    color: "#6b7280",
+    fontSize: "14px",
+  },
+  grid: {
+    margin: 0,
+    display: "grid",
+    gridTemplateColumns: "140px 1fr",
+    gap: "8px 16px",
+  },
+  row: {
+    display: "contents",
+  },
+  label: {
+    margin: 0,
+    fontSize: "13px",
+    color: "#6b7280",
+  },
+  value: {
+    margin: 0,
+    fontSize: "14px",
+    fontWeight: 500,
+  },
+};
