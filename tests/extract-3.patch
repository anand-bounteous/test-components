+"""FastAPI helpers shared by tool route classes."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from fastapi.responses import JSONResponse
+from nw_aglib_toolkit.audit import AuditBuilder
+from nw_aglib_toolkit.channels.rest.ApiResponseModels import (
+    ToolErrorDetail,
+    ToolErrorResponse,
+)
+from nw_aglib_toolkit.channels.rest.RouteContext import RouteContext
+from nw_aglib_toolkit.channels.rest.ToolCallOptions import ToolCallOptions
+from nw_core.logging.LogFnAnnotation import linearize_for_log
+
+
+def to_api_json(value: Any) -> Any:
+    return linearize_for_log(value)
+
+
+def build_context(options: ToolCallOptions) -> RouteContext:
+    return RouteContext.from_request(
+        config_overrides=options.config_overrides,
+        source_bank=options.source_bank,
+        region=options.region,
+    )
+
+
+def build_audit(options: ToolCallOptions) -> AuditBuilder | None:
+    if not options.include_audit:
+        return None
+    return AuditBuilder(enabled=True)
+
+
+def success_response(result: Any) -> dict[str, Any]:
+    return {"ok": True, "result": to_api_json(result)}
+
+
+def error_response(exc: Exception, *, tool_name: str | None = None) -> JSONResponse:
+    if isinstance(exc, ValueError):
+        code = "VALIDATION_ERROR"
+        status_code = 422
+    else:
+        code = "INTERNAL_ERROR"
+        status_code = 500
+
+    body = ToolErrorResponse(
+        error=ToolErrorDetail(
+            code=code,
+            message=str(exc) or exc.__class__.__name__,
+            tool=tool_name,
+        )
+    )
+    return JSONResponse(status_code=status_code, content=body.model_dump())
