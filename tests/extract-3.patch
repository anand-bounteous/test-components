+
+__all__ = [
+    "BankTransactionValidationTools",
+    "ValidationError",
+    "ValidationResult",
+    "ValidationToolResult",
+    "input_schema",
+    "input_validator",
+    "load_payload",
+    "run_validate_bank_transaction_payload",
+    "validate_and_normalise_rows",
+    "validate_schema",
+]
+
+_default_tool = None
+
+
+def _tool() -> BankTransactionValidationTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = BankTransactionValidationTools()
+    return _default_tool
+
+
+class BankTransactionValidationTools(BaseTool[ValidationToolResult]):
+    """Validate and normalise a salary-extractor bank-transaction payload."""
+
+    phase_name = "validate"
+
+    @LogFn
+    def _execute(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        mode: str = "lenient",
+        transactions_absence: TransactionsAbsence | None = None,
+        service: BankTransactionValidationService | None = None,
+    ) -> ValidationToolResult:
+        """Validate payload rows and produce normalised credit transactions.
+
+        Args:
+            payload: Typed salary-extractor request to validate.
+            mode: ``strict`` fails on first error; ``lenient`` collects warnings.
+            transactions_absence: Test-only override for missing transaction lists.
+            service: Optional validation service override.
+
+        Returns:
+            Validated transactions, warnings, and optional early-exit flag.
+        """
+        svc = service or default_service()
+        result = svc.validate_payload(
+            payload,
+            mode=mode,
+            transactions_absence=transactions_absence,
+        )
+        return ValidationToolResult(
+            transactions=result.transactions,
+            warnings=result.warnings,
+            early_exit=result.early_exit,
+        )
+
+    def build_input_summary(self, payload: BankTransactionRequest, **kwargs: Any) -> dict[str, Any]:
+        return {
+            "row_count": len(payload.transactions),
+            "analysis_id": payload.analysis_id,
+        }
+
+    def build_output_summary(
+        self,
+        result: ValidationToolResult,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "credit_count": len(result.transactions),
+            "warnings": len(result.warnings),
+            "early_exit": result.early_exit,
+        }
+
+    def trace_output(self, result: ValidationToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for warning in result.warnings:
+            self._logger.trace(
+                "validate.warning  code=%s  txn_id=%s  detail=%s",
+                warning.code,
+                warning.transaction_id or "—",
+                warning.detail,
+            )
+
+
+@tool(
+    name="run_validate_bank_transaction_payload",
+    description="Run validate bank transaction payload.",
+    category="banking.validation",
+    tags=["banking", "validation"],
+)
+def run_validate_bank_transaction_payload(
+    payload: BankTransactionRequest,
+    *,
+    mode: str = "lenient",
+    transactions_absence: TransactionsAbsence | None = None,
+    service: BankTransactionValidationService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> ValidationToolResult:
+    """Validate a bank-transaction salary-extractor payload.
+
+    Args:
+        payload: Typed request containing raw bank transactions.
+        mode: ``strict`` fails on first error; ``lenient`` collects warnings.
+        transactions_absence: Test-only override for missing transaction lists.
+        service: Optional validation service override.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with validation warnings.
+
+    Returns:
+        ValidationToolResult with normalised credit rows and pipeline warnings.
+    """
+    return _tool().run(
+        payload,
+        audit=audit,
+        warnings=warnings,
+        mode=mode,
+        transactions_absence=transactions_absence,
+        service=service,
+    )
