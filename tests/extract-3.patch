+"""Amount-first timeline grouping for property sale proceeds."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from decimal import Decimal
+from itertools import combinations
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+from nw_agcore_bank_transactions.pipeline.hints.matchers import PropertySaleHintMatcher
+from nw_agcore_bank_transactions.pipeline.hints.matchers.AmountRangeMatcher import (
+    aggregate_in_range,
+    amount_in_range,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models import PropertySaleHints
+
+
+class PropertySaleGroupingStrategy:
+    def __init__(self, hint_matcher: PropertySaleHintMatcher | None = None) -> None:
+        self._hints = hint_matcher or PropertySaleHintMatcher()
+
+    def generate_candidates(
+        self,
+        transactions: Sequence[BankTransaction],
+        hint_inputs: PropertySaleHints,
+    ) -> list[HintGroupCandidate]:
+        self._hints.validate_amount_present(hint_inputs)
+        assert hint_inputs.amount is not None
+        tolerance = self._hints.effective_tolerance(hint_inputs)
+        hint_amount = hint_inputs.amount
+
+        reference = self._hints.resolve_reference_date(transactions, hint_inputs)
+        window_start, window_end = self._hints.resolve_window(reference, hint_inputs)
+
+        in_window = [t for t in transactions if window_start <= t.date <= window_end]
+        if not in_window:
+            return []
+
+        eligible = [t for t in in_window if self._hints.txn_soft_match(t, hint_inputs)]
+        if not eligible:
+            eligible = list(in_window)
+
+        best = self._best_subset(eligible, hint_amount, tolerance)
+        if best is None:
+            return []
+
+        total = sum((t.amount for t in best), Decimal("0"))
+        timeline = self._hints.effective_timeline_hint(hint_inputs)
+        reasoning = (
+            f"Grouped {len(best)} credit(s) within ±{timeline} of {reference.isoformat()}",
+            f"Aggregate {total} within ±{tolerance * 100:.0f}% of hint {hint_amount}",
+        )
+        return [
+            HintGroupCandidate(
+                candidate_set_id="property_sale_000",
+                transactions=tuple(sorted(best, key=lambda t: (t.date, t.id))),
+                reference_date=reference,
+                window_start=window_start,
+                window_end=window_end,
+                aggregate_sum=total,
+                reasoning=reasoning,
+            )
+        ]
+
+    def _best_subset(
+        self,
+        eligible: Sequence[BankTransaction],
+        hint_amount: Decimal,
+        tolerance: float,
+    ) -> list[BankTransaction] | None:
+        if not eligible:
+            return None
+
+        amount_matches = [t for t in eligible if amount_in_range(t.amount, hint_amount, tolerance)]
+        if amount_matches and aggregate_in_range(
+            sum((t.amount for t in amount_matches), Decimal("0")),
+            hint_amount,
+            tolerance,
+        ):
+            return self._minimal_covering_subset(amount_matches, hint_amount, tolerance)
+
+        sorted_eligible = sorted(eligible, key=lambda t: (t.date, t.id))
+        best: list[BankTransaction] | None = None
+        best_coverage = -1.0
+
+        max_subset = min(len(sorted_eligible), 8)
+        for size in range(1, max_subset + 1):
+            for combo in combinations(sorted_eligible, size):
+                total = sum((t.amount for t in combo), Decimal("0"))
+                if not aggregate_in_range(total, hint_amount, tolerance):
+                    continue
+                coverage = float(min(total, hint_amount) / hint_amount)
+                if coverage > best_coverage or (
+                    coverage == best_coverage and best is not None and len(combo) < len(best)
+                ):
+                    best_coverage = coverage
+                    best = list(combo)
+
+        if best is not None:
+            return best
+
+        if len(amount_matches) == 1:
+            return amount_matches
+
+        return None
+
+    def _minimal_covering_subset(
+        self,
+        txns: Sequence[BankTransaction],
+        hint_amount: Decimal,
+        tolerance: float,
+    ) -> list[BankTransaction]:
+        sorted_txns = sorted(txns, key=lambda t: (-t.amount, t.date, t.id))
+        chosen: list[BankTransaction] = []
+        total = Decimal("0")
+        for txn in sorted_txns:
+            if aggregate_in_range(total, hint_amount, tolerance):
+                break
+            chosen.append(txn)
+            total += txn.amount
+        if aggregate_in_range(total, hint_amount, tolerance):
+            return chosen
+        return list(txns)
