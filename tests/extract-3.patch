+"""Effective runtime parameters echoed on the detector result."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+
+@dataclass(frozen=True)
+class ResultMetadata:
+    config_versions: dict[str, Any] = field(default_factory=dict)
+    return_threshold: float = 0.40
+    max_candidates: int = 10
+    max_near_misses: int = 10
+    validation_mode: str = "lenient"
+    include_audit: bool = False
+    extra: dict[str, Any] = field(default_factory=dict)
+
+    def to_dict(self) -> dict[str, Any]:
+        payload = {
+            "config_versions": dict(self.config_versions),
+            "return_threshold": self.return_threshold,
+            "max_candidates": self.max_candidates,
+            "max_near_misses": self.max_near_misses,
+            "validation_mode": self.validation_mode,
+            "include_audit": self.include_audit,
+        }
+        if self.extra:
+            payload.update(self.extra)
+        return payload
