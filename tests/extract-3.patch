+"""Phase 4 — payslip anchor matching (FR-016 truth table)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    PayslipHint,
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.hints import (
+    ambiguous_anchor_ids,
+    anchor_txn_ids,
+    apply_hints,
+    apply_payslip_hints,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+
+
+def _txn(tid: str, date_str: str, amount: str) -> Tx:  # noqa: F821
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=date_str,
+            description="BACS ACME LTD PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+# --- Truth table for the two-condition rule ------------------------------
+
+
+def test_exact_match_attaches_anchor():
+    credits = [_txn("apr", "2024-04-30", "2453.67")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"), hint_id="h")]
+    result = apply_payslip_hints(credits, hints)
+    assert [a.transaction_id for a in result.anchors] == ["apr"]
+    assert result.unmatched_hint_ids == ()
+    assert result.anchors[0].ambiguous is False
+
+
+def test_integer_only_mismatch_does_not_anchor():
+    """abs differs (2543.67 ≠ 2453.67) AND int differs (2543 ≠ 2453)."""
+    credits = [_txn("apr", "2024-04-30", "2543.67")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    result = apply_payslip_hints(credits, hints)
+    assert result.anchors == ()
+    assert len(result.unmatched_hint_ids) == 1
+
+
+def test_decimal_only_mismatch_does_not_anchor():
+    """int matches (2453 == 2453) but abs differs (2453.07 ≠ 2453.67).
+
+    This is the critical case from Design §6.4 — both checks must hold,
+    so this hint must NOT anchor to ``2453.07``.
+    """
+    credits = [_txn("apr", "2024-04-30", "2453.07")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    result = apply_payslip_hints(credits, hints)
+    assert result.anchors == ()
+
+
+def test_both_decimal_and_int_match_required_path_swap():
+    """Symmetric variant: abs(amount) matches but int(amount) differs.
+
+    This shouldn't happen with normal numbers (if abs equals, int equals
+    too), but verifies the AND wiring isn't replaced by an OR through a
+    refactor.
+    """
+    # If both representations claim equality there's no way to construct a
+    # counter-example with Decimal arithmetic. Instead we assert that the
+    # function rejects when EITHER condition fails individually.
+    credits_int_mismatch = [_txn("apr", "2024-04-30", "2543.67")]  # int 2543
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]  # int 2453
+    assert apply_payslip_hints(credits_int_mismatch, hints).anchors == ()
+
+
+def test_amount_with_different_scale_still_matches():
+    """``2450.32`` and ``2450.320`` are equal under Decimal — both checks
+    pass; an anchor must attach."""
+    credits = [_txn("apr", "2024-04-30", "2450.320")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2450.32"))]
+    assert apply_payslip_hints(credits, hints).anchors
+
+
+def test_zero_credits_in_hint_month_records_unmatched():
+    credits = [_txn("jan", "2024-01-31", "2450.32")]
+    hints = [
+        PayslipHint(month="2024-04", amount=Decimal("2453.67"), hint_id="h_april"),
+    ]
+    result = apply_payslip_hints(credits, hints)
+    assert result.anchors == ()
+    assert "h_april" in result.unmatched_hint_ids
+
+
+def test_two_matches_in_one_month_both_flagged_ambiguous():
+    credits = [
+        _txn("apr1", "2024-04-15", "2453.67"),
+        _txn("apr2", "2024-04-30", "2453.67"),
+    ]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    result = apply_payslip_hints(credits, hints)
+    assert len(result.anchors) == 2
+    assert all(a.ambiguous for a in result.anchors)
+
+
+def test_multi_month_hints_only_matching_ones_attach():
+    credits = [
+        _txn("apr", "2024-04-30", "2453.67"),
+        _txn("may", "2024-05-31", "2453.67"),  # exists but no hint for May
+    ]
+    hints = [
+        PayslipHint(month="2024-04", amount=Decimal("2453.67"), hint_id="apr_hint"),
+        PayslipHint(month="2024-06", amount=Decimal("2453.67"), hint_id="jun_hint"),
+    ]
+    result = apply_payslip_hints(credits, hints)
+    matched = {a.hint_id for a in result.anchors}
+    assert matched == {"apr_hint"}
+    assert "jun_hint" in result.unmatched_hint_ids
+
+
+def test_match_only_inside_hint_month_not_neighbouring():
+    credits = [_txn("apr_eve", "2024-03-31", "2453.67")]  # March, hint is April
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    result = apply_payslip_hints(credits, hints)
+    assert result.anchors == ()
+
+
+def test_hint_with_no_decimal_part_still_matches():
+    credits = [_txn("apr", "2024-04-30", "2500.00")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2500"))]
+    assert apply_payslip_hints(credits, hints).anchors
+
+
+# --- Helpers exported for Phase 9 -----------------------------------------
+
+
+def test_anchor_txn_ids_returns_map():
+    credits = [_txn("apr", "2024-04-30", "2453.67")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"), hint_id="h_a")]
+    applied = apply_payslip_hints(credits, hints)
+    assert anchor_txn_ids(applied) == {"apr": "h_a"}
+
+
+def test_ambiguous_anchor_ids_only_returns_ambiguous():
+    credits = [
+        _txn("apr1", "2024-04-15", "2453.67"),
+        _txn("apr2", "2024-04-30", "2453.67"),
+    ]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    applied = apply_payslip_hints(credits, hints)
+    assert ambiguous_anchor_ids(applied) == {"apr1", "apr2"}
+
+
+def test_apply_hints_wraps_band_and_anchors():
+    """apply_hints() should expose both anchor list and band bounds."""
+    from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+        SalaryHints,
+    )
+
+    credits = [_txn("apr", "2024-04-30", "2453.67")]
+    hints = [PayslipHint(month="2024-04", amount=Decimal("2453.67"))]
+    sh = SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20)
+    result = apply_hints(credits, payslip_hints=hints, salary_hints=sh)
+    assert len(result.anchors) == 1
+    assert result.effective_monthly == Decimal("2500")
+    assert result.band_lower is not None and result.band_upper is not None
+
+
+def test_apply_hints_with_no_inputs_is_a_noop():
+    credits = [_txn("jan", "2024-01-31", "2450.32")]
+    result = apply_hints(credits)
+    assert result.anchors == ()
+    assert result.unmatched_hint_ids == ()
+    assert result.effective_monthly is None
