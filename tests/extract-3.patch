+"""Parse timeline hint strings into symmetric half-spans."""
+
+from __future__ import annotations
+
+import re
+from datetime import date, timedelta
+
+from dateutil.relativedelta import relativedelta
+
+_TIMELINE_RE = re.compile(r"^±?(\d+)([dwmy])$", re.IGNORECASE)
+
+
+class TimelineHintError(ValueError):
+    pass
+
+
+def parse_timeline_half_span(value: str) -> timedelta | relativedelta:
+    """Return half-span for symmetric ±window (e.g. ``15d`` → 15 days)."""
+    text = (value or "").strip()
+    match = _TIMELINE_RE.match(text)
+    if not match:
+        raise TimelineHintError(f"invalid timeline_hint: {value!r}")
+    amount = int(match.group(1))
+    unit = match.group(2).lower()
+    if amount <= 0:
+        raise TimelineHintError(f"timeline_hint amount must be positive: {value!r}")
+    if unit == "d":
+        return timedelta(days=amount)
+    if unit == "w":
+        return timedelta(weeks=amount)
+    if unit == "m":
+        return relativedelta(months=amount)
+    if unit == "y":
+        return relativedelta(years=amount)
+    raise TimelineHintError(f"unsupported timeline unit: {unit!r}")
+
+
+def subtract_half_span(reference: date, span: timedelta | relativedelta) -> date:
+    if isinstance(span, timedelta):
+        return reference - span
+    return reference - span
+
+
+def add_half_span(reference: date, span: timedelta | relativedelta) -> date:
+    if isinstance(span, timedelta):
+        return reference + span
+    return reference + span
+
+
+def symmetric_window(reference: date, timeline_hint: str) -> tuple[date, date]:
+    span = parse_timeline_half_span(timeline_hint)
+    return subtract_half_span(reference, span), add_half_span(reference, span)
