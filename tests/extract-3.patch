+"""Discover YAML scenario fixtures grouped by module across agent-local dirs."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+FEATURE_DIR = REPO_ROOT / "tests" / "feature"
+
+MODULE_SCENARIO_DIRS: dict[str, Path] = {
+    "employment": FEATURE_DIR / "scenarios" / "employment",
+    "rent": FEATURE_DIR / "scenarios" / "rent",
+    "gift": FEATURE_DIR / "scenarios" / "gift",
+    "property_sale": FEATURE_DIR / "scenarios" / "property_sale",
+    "combination": FEATURE_DIR / "scenarios" / "combination",
+}
+
+STRESS_DIR = FEATURE_DIR / "scenarios_stress"
+
+
+@dataclass(frozen=True)
+class ScenarioRef:
+    module: str
+    path: Path
+    stress: bool = False
+
+    @property
+    def scenario_id(self) -> str:
+        return self.path.stem
+
+    @property
+    def parametrize_id(self) -> str:
+        prefix = f"{self.module}_stress" if self.stress else self.module
+        return f"{prefix}/{self.scenario_id}"
+
+
+def list_modules() -> list[str]:
+    """Return sorted logical module names with at least one scenario directory."""
+    return sorted(
+        name
+        for name, path in MODULE_SCENARIO_DIRS.items()
+        if path.is_dir() and any(path.glob("*.yaml"))
+    )
+
+
+def discover_scenarios(*, modules: list[str] | None = None) -> list[ScenarioRef]:
+    """Discover YAML fixtures under each module's configured directory."""
+    refs: list[ScenarioRef] = []
+    available = list_modules()
+    selected = available if not modules else [m for m in modules if m in available]
+
+    for module in selected:
+        module_dir = MODULE_SCENARIO_DIRS[module]
+        if not module_dir.is_dir():
+            continue
+        for path in sorted(module_dir.glob("*.yaml")):
+            refs.append(ScenarioRef(module=module, path=path, stress=False))
+
+    if STRESS_DIR.is_dir():
+        for module in selected:
+            stress_module_dir = STRESS_DIR / module
+            if stress_module_dir.is_dir():
+                for path in sorted(stress_module_dir.glob("*.yaml")):
+                    refs.append(ScenarioRef(module=module, path=path, stress=True))
+
+        if "employment" in selected:
+            for path in sorted(STRESS_DIR.glob("*.yaml")):
+                if path.is_file():
+                    refs.append(ScenarioRef(module="employment", path=path, stress=True))
+
+    return refs
+
+
+def resolve_scenario_path(module: str, scenario_id: str) -> Path | None:
+    """Find a scenario YAML by module name and file stem."""
+    for ref in discover_scenarios(modules=[module]):
+        if ref.scenario_id == scenario_id:
+            return ref.path
+    return None
+
+
+__all__ = [
+    "FEATURE_DIR",
+    "MODULE_SCENARIO_DIRS",
+    "STRESS_DIR",
+    "ScenarioRef",
+    "discover_scenarios",
+    "list_modules",
+    "resolve_scenario_path",
+]
