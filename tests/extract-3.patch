+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from nw_core.channels.ChannelModules import ChannelRegistry, ChannelRuntime
+from nw_core.channels.rest.RestFactory import create_fastapi_app
+
+
+@dataclass
+class EmbeddedCoreChannels:
+    rest: str = "suppress"
+    grpc: str = "suppress"
+    mq: str = "suppress"
+
+
+@dataclass
+class EmbeddedCoreConfig:
+    use: str = "in_process"
+    channels: EmbeddedCoreChannels = field(default_factory=EmbeddedCoreChannels)
+
+
+@dataclass
+class DeploymentManifest:
+    unit: str
+    mode: str = "standalone"
+    channels: dict[str, dict[str, Any]] = field(default_factory=dict)
+    embedded_core: dict[str, EmbeddedCoreConfig] = field(default_factory=dict)
+
+    @classmethod
+    def load(cls, path: Path) -> DeploymentManifest:
+        data = yaml.safe_load(path.read_text()) or {}
+        embedded: dict[str, EmbeddedCoreConfig] = {}
+        for name, cfg in (data.get("embedded_core") or {}).items():
+            channels_raw = cfg.get("channels") or {}
+            embedded[name] = EmbeddedCoreConfig(
+                use=cfg.get("use", "in_process"),
+                channels=EmbeddedCoreChannels(
+                    rest=channels_raw.get("rest", "suppress"),
+                    grpc=channels_raw.get("grpc", "suppress"),
+                    mq=channels_raw.get("mq", "suppress"),
+                ),
+            )
+        return cls(
+            unit=data.get("unit", "unknown"),
+            mode=data.get("mode", "standalone"),
+            channels=data.get("channels") or {},
+            embedded_core=embedded,
+        )
+
+    def channel_enabled(self, name: str) -> bool:
+        return self.channels.get(name, {}).get("enabled", False)
+
+    def channel_prefix(self, name: str, default: str = "") -> str:
+        prefix = str(self.channels.get(name, {}).get("prefix", default))
+        if prefix == "/":
+            return ""
+        return prefix.rstrip("/")
+
+
+class ChannelBootstrap:
+    """Assemble runtime from manifest + registered channel modules."""
+
+    @staticmethod
+    def build(
+        manifest: DeploymentManifest,
+        registry: ChannelRegistry,
+        *,
+        title: str = "NW Agent",
+    ) -> ChannelRuntime:
+        runtime = ChannelRuntime()
+        runtime.metadata["rest_prefix"] = manifest.channel_prefix("rest", "")
+
+        needs_rest = any(m.is_enabled(manifest) and m.name == "rest" for m in registry.modules)
+        if needs_rest:
+            runtime.app = create_fastapi_app(title=title)
+
+        for module in registry.modules:
+            if module.is_enabled(manifest):
+                module.mount(runtime)
+
+        return runtime
+
+
+class EmbeddedCoreComposer:
+    """Apply embedded core suppress/passthrough rules for REST/gRPC/MQ channels."""
+
+    @staticmethod
+    def apply_passthrough(
+        manifest: DeploymentManifest,
+        parent_registry: ChannelRegistry,
+        core_name: str,
+        core_registry: ChannelRegistry,
+        *,
+        passthrough_prefix: str | None = None,
+    ) -> None:
+        cfg = manifest.embedded_core.get(core_name)
+        if cfg is None:
+            return
+        prefix = passthrough_prefix or f"/embedded/{core_name}"
+
+        if cfg.channels.rest == "passthrough":
+            for module in core_registry.modules:
+                if module.name == "rest" and hasattr(module, "default_prefix"):
+                    module.default_prefix = prefix  # type: ignore[attr-defined]
+                if module.name == "rest" and cfg.channels.rest == "passthrough":
+                    parent_registry.add(module)
+
+        # suppress — do nothing (default)
