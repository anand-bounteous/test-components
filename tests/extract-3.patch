+_FIXTURE_PDF = Path(__file__).parent / "data" / "f59832ee_104-P1-eStatement.pdf"
+_EVIDENCE_RUNS_DIR = (
+    Path(__file__).resolve().parents[5]
+    / ".plan"
+    / "reviews"
+    / "feature-outputs"
+    / "document-data-extractor"
+    / "runs"
+)
+
