+#!/usr/bin/env python3
+"""Unify OpenAPI schemas to CandidateSet + BankTransactionResult and strip route duplicates."""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+COMPONENTS = (
+    ROOT
+    / "agents/core/bank-transactions/src/nw_agcore_bank_transactions/channels/rest/routes/openapi/components.yaml"
+)
+
+REMOVE_SCHEMAS = {
+    "RentCandidateSet",
+    "BankTransactionResult",
+    "PropertySaleCandidateSet",
+    "BankTransactionResult",
+    "GiftCandidateSet",
+    "BankTransactionResult",
+}
+
+REF_REPLACEMENTS = {
+    "SalaryCandidateSet": "CandidateSet",
+    "BankTransactionResult": "BankTransactionResult",
+    "RentCandidateSet": "CandidateSet",
+    "BankTransactionResult": "BankTransactionResult",
+    "GiftCandidateSet": "CandidateSet",
+    "BankTransactionResult": "BankTransactionResult",
+    "PropertySaleCandidateSet": "CandidateSet",
+    "BankTransactionResult": "BankTransactionResult",
+}
+
+
+def _replace_refs(value: Any) -> Any:
+    if isinstance(value, dict):
+        out: dict[str, Any] = {}
+        for key, item in value.items():
+            if key == "$ref" and isinstance(item, str) and item.startswith("#/components/schemas/"):
+                name = item.rsplit("/", 1)[-1]
+                if name in REF_REPLACEMENTS:
+                    item = f"#/components/schemas/{REF_REPLACEMENTS[name]}"
+            out[key] = _replace_refs(item)
+        return out
+    if isinstance(value, list):
+        return [_replace_refs(item) for item in value]
+    return value
+
+
+def normalize_components() -> None:
+    document = yaml.safe_load(COMPONENTS.read_text(encoding="utf-8")) or {}
+    schemas: dict[str, Any] = document.setdefault("components", {}).setdefault("schemas", {})
+
+    if "SalaryCandidateSet" in schemas:
+        schemas["CandidateSet"] = schemas.pop("SalaryCandidateSet")
+    candidate = schemas.get("CandidateSet")
+    if isinstance(candidate, dict):
+        props = candidate.setdefault("properties", {})
+        props["score_breakdown"] = {"type": "object", "additionalProperties": True}
+        props["detected_pattern"] = {"type": "object", "additionalProperties": True}
+
+    if "BankTransactionResult" in schemas:
+        schemas["BankTransactionResult"] = schemas.pop("BankTransactionResult")
+    result = schemas.get("BankTransactionResult")
+    if isinstance(result, dict):
+        props = result.setdefault("properties", {})
+        props["applied_hints"] = {"type": "object", "additionalProperties": True}
+
+    for name in list(schemas):
+        if name in REMOVE_SCHEMAS:
+            del schemas[name]
+
+    document["components"]["schemas"] = _replace_refs(schemas)
+    COMPONENTS.write_text(
+        yaml.safe_dump(document, sort_keys=False, default_flow_style=False, allow_unicode=True),
+        encoding="utf-8",
+    )
+    print("normalized", COMPONENTS)
+
+
+def strip_route_openapi_schemas() -> None:
+    patterns = [
+        "agents/core/bank-transactions/src/**/openapi/*.openapi.yaml",
+        "agents/business/*/src/**/openapi/*.openapi.yaml",
+    ]
+    paths: list[Path] = []
+    for pattern in patterns:
+        paths.extend(ROOT.glob(pattern))
+    for path in sorted(set(paths)):
+        document = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+        if "paths" not in document:
+            continue
+        slim = {
+            "openapi": document.get("openapi", "3.0.3"),
+            "info": document.get("info", {"title": path.stem, "version": "1.0.0"}),
+            "paths": document["paths"],
+            "components": {"schemas": {}},
+        }
+        path.write_text(
+            yaml.safe_dump(slim, sort_keys=False, default_flow_style=False, allow_unicode=True),
+            encoding="utf-8",
+        )
+        print("stripped", path.relative_to(ROOT))
+
+
+def main() -> None:
+    normalize_components()
+    strip_route_openapi_schemas()
+
+
+if __name__ == "__main__":
+    main()
