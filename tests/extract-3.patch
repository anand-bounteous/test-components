+"""Phase 6 — last-working-day and first-working-day payday models."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline._services.recurrence import (
+    PaydayModel,
+    fit_best_recurrence_model,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_core.calendar import WorkingDayCalendar
+
+
+@pytest.fixture(scope="module")
+def cal():
+    return WorkingDayCalendar()
+
+
+def _txn(tid: str, d: date, amount: str = "2450.00") -> BankTransaction:
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=d.isoformat(),
+            description="BACS ACME LTD PAYROLL",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _all_last_working_days(cal, year: int, months: range) -> list[date]:
+    return [cal.last_working_day_of_month(year, m, "EnglandAndWales") for m in months]
+
+
+# --- Last working day ----------------------------------------------------
+
+
+def test_last_working_day_fit_score_perfect_for_clean_series(cal):
+    dates = _all_last_working_days(cal, 2024, range(1, 13))
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.LAST_WORKING_DAY
+    assert fit.fit_score == pytest.approx(1.0)
+    assert fit.matched_count == 12
+    assert fit.expected_count == 12
+    assert fit.mean_deviation_days == 0.0
+
+
+def test_last_working_day_handles_missing_months(cal):
+    dates = [
+        cal.last_working_day_of_month(2024, m, "EnglandAndWales") for m in range(1, 13) if m != 7
+    ]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.LAST_WORKING_DAY
+    assert fit.matched_count == 11
+    assert fit.expected_count == 12
+    assert fit.coverage == pytest.approx(11 / 12)
+    assert fit.fit_score < 1.0
+
+
+def test_last_working_day_beats_last_calendar_day_when_specific(cal):
+    """A series matching every LWD will fit BOTH models, but the
+    specificity tie-break favours LWD."""
+    dates = _all_last_working_days(cal, 2024, range(1, 13))
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.LAST_WORKING_DAY
+
+
+def test_last_working_day_2024_march_lands_on_thursday(cal):
+    """Good Friday 29 Mar 2024 → LWD = Thu 28 Mar (a regression guard
+    that ties the recurrence detector to the calendar service)."""
+    txn = _txn("t01", date(2024, 3, 28))
+    fit = fit_best_recurrence_model([txn, _txn("t02", date(2024, 4, 30))], calendar=cal)
+    # Either way the single-month verification matches: matched ≥ 1.
+    assert fit.matched_count >= 1
+
+
+def test_last_calendar_day_fits_when_credits_are_always_on_31st(cal):
+    """When dates land on the calendar's last day even on weekends, the
+    last_calendar_day model wins (LWD would predict a Friday)."""
+    txns = [
+        _txn(f"t{i}", date(2024, m, 31)) for i, m in enumerate([1, 3, 5, 7, 8, 10, 12], start=1)
+    ]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model in {PaydayModel.LAST_CALENDAR_DAY, PaydayModel.FIXED_DAY_N}
+
+
+# --- First working day ---------------------------------------------------
+
+
+def test_first_working_day_perfect_series(cal):
+    dates = [cal.first_working_day_of_month(2024, m, "EnglandAndWales") for m in range(1, 13)]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.FIRST_WORKING_DAY
+    assert fit.fit_score == pytest.approx(1.0)
+
+
+def test_first_working_day_jan_2024_lands_on_2nd(cal):
+    """1 Jan 2024 is a Tue but a BH; first working day = Tue 2 Jan."""
+    assert cal.first_working_day_of_month(2024, 1, "EnglandAndWales") == date(2024, 1, 2)
+
+
+def test_two_credits_is_minimum_for_a_fit(cal):
+    """A single-record series produces an irregular fallback."""
+    fit = fit_best_recurrence_model([_txn("t1", date(2024, 1, 31))], calendar=cal)
+    assert fit.model == PaydayModel.IRREGULAR_SALARY_LIKE
+    assert fit.fit_score == 0.0
