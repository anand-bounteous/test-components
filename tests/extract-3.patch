+"""Salary payslip anchor and band hint application."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from datetime import date
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+
+from ..models import AnchorMatch, AppliedHints, PayslipHint, SalaryBand, SalaryHints
+from ..models.HintConfig import load_hint_config
+
+
+def _month_key(d: date) -> str:
+    return f"{d.year:04d}-{d.month:02d}"
+
+
+def _decimal_equal(a: Decimal, b: Decimal) -> bool:
+    return a == b
+
+
+def _anchor_match(txn: BankTransaction, hint: PayslipHint) -> bool:
+    abs_match = _decimal_equal(abs(txn.amount), hint.amount)
+    int_match = int(abs(txn.amount)) == int(hint.amount)
+    return abs_match and int_match
+
+
+def compute_salary_band(hints: SalaryHints | None) -> SalaryBand | None:
+    if hints is None or hints.is_empty():
+        return None
+    effective = hints.effective_monthly
+    assert effective is not None
+    tol = Decimal(str(hints.tolerance_pct))
+    lower = effective * (Decimal("1") - tol)
+    upper = effective * (Decimal("1") + tol)
+    return SalaryBand(
+        effective_monthly=effective,
+        lower=lower,
+        upper=upper,
+        tolerance_pct=hints.tolerance_pct,
+    )
+
+
+def apply_payslip_hints(
+    credits: Iterable[BankTransaction],
+    hints: Iterable[PayslipHint],
+) -> AppliedHints:
+    credit_list = list(credits)
+    by_month: dict[str, list[BankTransaction]] = {}
+    for credit in credit_list:
+        by_month.setdefault(_month_key(credit.date), []).append(credit)
+
+    anchors: list[AnchorMatch] = []
+    unmatched: list[str] = []
+
+    for hint in hints:
+        candidates = by_month.get(hint.month, [])
+        matches = [c for c in candidates if _anchor_match(c, hint)]
+        if not matches:
+            unmatched.append(hint.hint_id)
+            continue
+        ambiguous = len(matches) > 1
+        for match in matches:
+            anchors.append(
+                AnchorMatch(
+                    hint_id=hint.hint_id,
+                    transaction_id=match.id,
+                    month=hint.month,
+                    amount=hint.amount,
+                    ambiguous=ambiguous,
+                )
+            )
+
+    return AppliedHints(
+        anchors=tuple(anchors),
+        unmatched_hint_ids=tuple(unmatched),
+    )
+
+
+def apply_salary_band(base: AppliedHints, hints: SalaryHints | None) -> AppliedHints:
+    band = compute_salary_band(hints)
+    if band is None:
+        return base
+    return AppliedHints(
+        anchors=base.anchors,
+        unmatched_hint_ids=base.unmatched_hint_ids,
+        effective_monthly=band.effective_monthly,
+        band_lower=band.lower,
+        band_upper=band.upper,
+        gift=base.gift,
+        rent=base.rent,
+        property_sale=base.property_sale,
+    )
+
+
+def band_modifier(
+    cluster_median: Decimal,
+    band: SalaryBand | None,
+    *,
+    floor: float | None = None,
+) -> float:
+    if floor is None:
+        floor = load_hint_config().band_modifier.floor
+    if band is None:
+        return 1.0
+    if band.contains(cluster_median):
+        return 1.0
+    if cluster_median < band.lower:
+        distance = band.lower - cluster_median
+    else:
+        distance = cluster_median - band.upper
+    relative = float(distance) / float(band.effective_monthly)
+    modifier = 1.0 - 0.5 * relative
+    return max(floor, min(1.0, modifier))
