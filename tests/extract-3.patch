+    hints = hint_inputs_from_mapping(payload)
+    assert hints.gift_hints is not None
+    assert hints.gift_hints.amount == Decimal("500")
+    assert hints.rent_hints is not None
+    assert hints.rent_hints.rentee_name == "TENANT"
+    assert hints.property_sale_hints is not None
+    assert hints.property_sale_hints.buyer_name == "BUYER"
