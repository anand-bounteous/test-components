+"""Public tool functions for bonus / expense candidate splitting."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, CandidateSet
+from nw_agcore_bank_transactions.pipeline.bonus_expense_split.BonusExpenseSplitService import (
+    BonusExpenseSplitService,
+    default_service,
+)
+from nw_agcore_bank_transactions.pipeline.bonus_expense_split.models import (
+    BonusExpenseSplitToolResult,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "BonusExpenseSplitTools",
+    "BonusExpenseSplitToolResult",
+    "run_bonus_expense_split",
+]
+
+_default_tool = None
+
+
+def _tool() -> BonusExpenseSplitTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = BonusExpenseSplitTools()
+    return _default_tool
+
+
+class BonusExpenseSplitTools(BaseTool[BonusExpenseSplitToolResult]):
+    phase_name = "bonus_expense_split"
+
+    @LogFn
+    def _execute(
+        self,
+        pool: Sequence[CandidateSet],
+        normalised: Iterable[BankTransaction],
+        *,
+        service: BonusExpenseSplitService | None = None,
+    ) -> BonusExpenseSplitToolResult:
+        svc = service or default_service()
+        candidates = svc.split_bonus_and_expense_credits(pool, normalised)
+        return BonusExpenseSplitToolResult(candidates=candidates)
+
+    def build_input_summary(
+        self,
+        pool: Sequence[CandidateSet],
+        normalised: Iterable[BankTransaction],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {"pool": len(pool)}
+
+    def build_output_summary(
+        self,
+        result: BonusExpenseSplitToolResult,
+        pool: Sequence[CandidateSet],
+        normalised: Iterable[BankTransaction],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "pool": len(result.candidates),
+            "splits": len(result.candidates) - len(pool),
+        }
+
+    def trace_output(self, result: BonusExpenseSplitToolResult) -> None:
