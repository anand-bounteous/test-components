+"""Public tool functions for bank-transaction hint application."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.AnchorFlags import attach_anchor_flags
+from nw_agcore_bank_transactions.pipeline.hints.BankTransactionHintService import (
+    BankTransactionHintService,
+    HintValidationError,
+    ambiguous_anchor_ids,
+    anchor_txn_ids,
+    default_service,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models import HintInputs
+from nw_agcore_bank_transactions.pipeline.hints.models.HintToolResult import HintToolResult
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "BankTransactionHintTools",
+    "HintToolResult",
+    "HintValidationError",
+    "apply_bank_transaction_hints",
+    "run_apply_bank_transaction_hints",
+]
+
+
+class BankTransactionHintTools(BaseTool[HintToolResult]):
+    phase_name = "hints"
+
+    @LogFn
+    def _execute(
+        self,
+        transactions: Iterable[BankTransaction],
+        *,
+        hint_inputs: HintInputs | None = None,
+        service: BankTransactionHintService | None = None,
+    ) -> HintToolResult:
+        materialised = list(transactions)
+        svc = service or default_service()
+        result = svc.apply_hints(materialised, hint_inputs)
+        resolved: tuple[BankTransaction, ...] = tuple(materialised)
+        if result.applied_hints.anchors:
+            resolved = attach_anchor_flags(
+                materialised,
+                anchor_txn_ids=anchor_txn_ids(result.applied_hints),
+                ambiguous_ids=ambiguous_anchor_ids(result.applied_hints),
+            )
+        return HintToolResult(
+            transactions=resolved,
+            applied_hints=result.applied_hints,
+            hint_inputs=result.hint_inputs,
+            warnings=result.warnings,
+        )
+
+    def build_input_summary(
+        self,
+        transactions: Iterable[BankTransaction],
+        *,
+        hint_inputs: HintInputs | None = None,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        summary: dict[str, Any] = {}
+        if isinstance(transactions, (list, tuple)):
+            summary["credits"] = len(transactions)
+        if hint_inputs is None:
+            summary["payslip_hints"] = 0
+            summary["salary_hints"] = "no"
+            summary["employer_hints"] = "no"
+        else:
+            summary["payslip_hints"] = len(hint_inputs.payslip_hints)
+            summary["salary_hints"] = "yes" if hint_inputs.salary_hints else "no"
+            summary["employer_hints"] = "yes" if hint_inputs.employer_hints else "no"
+        return summary
+
+    def build_output_summary(
+        self,
+        result: HintToolResult,
+        transactions: Iterable[BankTransaction],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        feature_anchors = sum(
+            1 for txn in result.transactions if txn.features is not None and txn.features.is_anchor
+        )
+        return {
+            "anchors": len(result.applied_hints.anchors),
+            "unmatched": len(result.applied_hints.unmatched_hint_ids),
+            "feature_anchors": feature_anchors,
+        }
+
+    def trace_output(self, result: HintToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for anchor in result.applied_hints.anchors:
+            self._logger.trace(
+                "hints.anchor  txn_id=%s  hint_id=%s  month=%s  amount=%s  ambiguous=%s",
+                anchor.transaction_id,
+                anchor.hint_id,
+                anchor.month,
+                anchor.amount,
+                anchor.ambiguous,
+            )
+
+
+_default_tool = BankTransactionHintTools()
+
+
+@tool(
+    name="run_apply_bank_transaction_hints",
+    description="Run hint application with standard tool logging and optional audit payload.",
+    category="banking.hints",
+    tags=["banking", "hints"],
+)
+def run_apply_bank_transaction_hints(
+    transactions: Iterable[BankTransaction],
+    *,
+    hint_inputs: HintInputs | None = None,
+    service: BankTransactionHintService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> HintToolResult:
+    """Apply optional salary and employer hints to normalised transactions.
+
+    Args:
+        transactions: Normalised credit transactions to annotate.
+        hint_inputs: Optional caller-supplied hint payloads.
+        service: Optional hint service override.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with hint warnings.
+
+    Returns:
+        HintToolResult with hint-adjusted transactions and applied hint metadata.
+    """
+    return _default_tool.run(
+        transactions,
+        audit=audit,
+        warnings=warnings,
+        hint_inputs=hint_inputs,
+        service=service,
+    )
+
+
+def apply_bank_transaction_hints(
+    transactions: Iterable[BankTransaction],
+    *,
+    hint_inputs: HintInputs | None = None,
+    service: BankTransactionHintService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> HintToolResult:
+    """Apply optional hints to normalised bank transactions."""
+    return run_apply_bank_transaction_hints(
+        transactions,
+        hint_inputs=hint_inputs,
+        service=service,
+        audit=audit,
+        warnings=warnings,
+    )
