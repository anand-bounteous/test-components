+"""Unit tests for hint amount grouping service."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+from nw_agcore_bank_transactions.pipeline.hint_grouping.HintAmountGroupingService import HintAmountGroupingService
+
+
+class _StubStrategy:
+    def generate_candidates(self, transactions, hint_inputs):
+        return [
+            HintGroupCandidate(
+                candidate_set_id="g1",
+                transactions=tuple(transactions),
+                window_start=date(2024, 1, 1),
+                window_end=date(2024, 1, 31),
+                aggregate_sum=Decimal("500"),
+            )
+        ]
+
+
+@pytest.mark.unit
+def test_hint_amount_grouping_delegates_to_strategy():
+    raw = RawBankTransaction(id="t1", date="2024-01-15", description="GIFT", credit_amount="500")
+    txn = BankTransaction(raw=raw, normalised_description="GIFT", description_tokens=("GIFT",), skeleton="GIFT")
+    service = HintAmountGroupingService(_StubStrategy())
+    groups = service.generate_candidates([txn], hint_inputs={})
+    assert len(groups) == 1
+    assert groups[0].candidate_set_id == "g1"
+    assert groups[0].transactions[0].id == "t1"
