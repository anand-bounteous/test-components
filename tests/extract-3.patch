+"""REST route for feature extraction."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import FeatureExtractionRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import bank_transactions_from_wire
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..BankTransactionFeatureExtractionTools import run_extract_bank_transaction_features
+
+
+class FeatureExtractionRoute(BaseToolRoute):
+    tool_name = "run_extract_bank_transaction_features"
+    path = "/features/extract"
+    tags = ("features",)
+    summary = "Extract salary-detection features from normalised transactions."
+    openapi_filename = "run_extract_bank_transaction_features.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def extract_features(body: FeatureExtractionRequest):
+            try:
+                ctx = build_context(body)
+                transactions = bank_transactions_from_wire(body.transactions)
+                audit = build_audit(body)
+                result = run_extract_bank_transaction_features(
+                    transactions,
+                    app_config=ctx.config,
+                    calendar=ctx.calendar,
+                    region=ctx.region,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
