+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+PROTO_ROOT="$ROOT/libs/common/core/src/nw_core/channels/grpc/proto"
+SHARED_OUT="$ROOT/libs/common/core/src/nw_core/channels/grpc/generated"
+VENV_PYTHON="${ROOT}/.venv/bin/python"
+
+if [[ ! -x "$VENV_PYTHON" ]]; then
+  echo "Missing .venv python at $VENV_PYTHON" >&2
+  exit 1
+fi
+
+touch_pkg() {
+  local dir="$1"
+  mkdir -p "$dir"
+  if [[ ! -f "$dir/__init__.py" ]]; then
+    echo '"""Generated gRPC package."""' > "$dir/__init__.py"
+  fi
+}
+
+generate_shared() {
+  touch_pkg "$SHARED_OUT/nw"
+  touch_pkg "$SHARED_OUT/nw/bank_transactions"
+  touch_pkg "$SHARED_OUT/nw/bank_transactions/v1"
+
+  "$VENV_PYTHON" -m grpc_tools.protoc \
+    -I "$PROTO_ROOT" \
+    --python_out="$SHARED_OUT" \
+    --grpc_python_out="$SHARED_OUT" \
+    "$PROTO_ROOT/nw/bank_transactions/v1/common.proto" \
+    "$PROTO_ROOT/nw/bank_transactions/v1/hints.proto" \
+    "$PROTO_ROOT/nw/bank_transactions/v1/results.proto"
+
+  fix_shared_imports
+}
+
+fix_shared_imports() {
+  while IFS= read -r -d '' file; do
+    "$VENV_PYTHON" - "$file" <<'PY'
+import sys
+from pathlib import Path
+
+path = Path(sys.argv[1])
+text = path.read_text(encoding="utf-8")
+text = text.replace(
+    "from nw.bank_transactions.v1 import",
+    "from nw_core.channels.grpc.generated.nw.bank_transactions.v1 import",
+)
+path.write_text(text, encoding="utf-8")
+PY
+  done < <(find "$SHARED_OUT/nw/bank_transactions/v1" -name '*_pb2*.py' -print0)
+}
+
+fix_agent_imports() {
+  local pkg="$1"
+  local generated_root="$ROOT/agents/business/$2/src/$pkg/channels/grpc/generated"
+  local module_prefix="$pkg.channels.grpc.generated"
+
+  while IFS= read -r -d '' file; do
+    "$VENV_PYTHON" - "$file" "$module_prefix" <<'PY'
+import re
+import sys
+from pathlib import Path
+
+path = Path(sys.argv[1])
+module_prefix = sys.argv[2]
+text = path.read_text(encoding="utf-8")
+text = text.replace(
+    "from nw.bank_transactions.v1 import",
+    "from nw_core.channels.grpc.generated.nw.bank_transactions.v1 import",
+)
+text = re.sub(
+    r"from nw\.([a-z_]+)\.v1 import",
+    lambda m: f"from {module_prefix}.nw.{m.group(1)}.v1 import",
+    text,
+)
+path.write_text(text, encoding="utf-8")
+PY
+  done < <(find "$generated_root" -name '*_pb2*.py' -print0)
+}
+
+generate_agent() {
+  local agent_dir="$1"
+  local pkg="$2"
+  local proto_rel="$3"
+  local proto_root="$ROOT/agents/business/$agent_dir/src/$pkg/channels/grpc/proto"
+  local out_dir="$ROOT/agents/business/$agent_dir/src/$pkg/channels/grpc/generated"
+  local proto_path="$proto_root/$proto_rel"
+
+  rm -rf "$out_dir"
+  touch_pkg "$out_dir/nw"
+  local parent="$out_dir/nw"
+  IFS='/' read -r -a parts <<< "$(dirname "$proto_rel")"
+  for part in "${parts[@]:1}"; do
+    parent="$parent/$part"
+    touch_pkg "$parent"
+  done
+  touch_pkg "$(dirname "$out_dir/$proto_rel")"
+
+  "$VENV_PYTHON" -m grpc_tools.protoc \
+    -I "$PROTO_ROOT" \
+    -I "$proto_root" \
+    --python_out="$out_dir" \
+    --grpc_python_out="$out_dir" \
+    "$proto_path"
+
+  fix_agent_imports "$pkg" "$agent_dir"
+}
+
+generate_shared
+
+generate_agent "gift-extractor" "nw_agbus_gift_extractor" "nw/gift/v1/gift_extractor.proto"
+generate_agent "salary-extractor" "nw_agbus_salary_extractor" "nw/salary/v1/salary_extractor.proto"
+generate_agent "rent-extractor" "nw_agbus_rent_extractor" "nw/rent/v1/rent_extractor.proto"
+generate_agent "property-sale-extractor" "nw_agbus_property_sale_extractor" "nw/property_sale/v1/property_sale_extractor.proto"
+
+echo "gRPC stubs generated under nw_core/channels/grpc/generated and business agent channels/grpc/generated"
