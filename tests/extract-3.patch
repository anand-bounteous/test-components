+    return amount == hint_amount
+
+
+def aggregate_meets_minimum(total: Decimal, hint_amount: Decimal) -> bool:
+    return total >= hint_amount
+
+
+def aggregate_exact(total: Decimal, hint_amount: Decimal) -> bool:
+    return total == hint_amount
+
+
+def overpayment_ratio(total: Decimal, hint_amount: Decimal) -> float:
