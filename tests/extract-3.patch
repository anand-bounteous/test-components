+"""Public tool functions for candidate ranking."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import CandidateSet
+from nw_agcore_bank_transactions.pipeline.ranking.models import RankingToolResult
+from nw_agcore_bank_transactions.pipeline.ranking.RankingService import (
+    rank_candidates,
+    resolve_ranking_config,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "RankingTools",
+    "RankingToolResult",
+    "run_rank_candidates",
+]
+
+
+class RankingTools(BaseTool[RankingToolResult]):
+    phase_name = "ranking"
+
+    @LogFn
+    def _execute(
+        self,
+        scored: Iterable[CandidateSet],
+        *,
+        config: AppConfig,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+    ) -> RankingToolResult:
+        ranking = resolve_ranking_config(
+            config,
+            return_threshold=return_threshold,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+        )
+        returned, near_misses, ranking = rank_candidates(list(scored), ranking)
+        if self._logger.isEnabledFor(TRACE):
+            for c in returned:
+                self._logger.trace(
+                    "ranking.returned    id=%s  type=%s  conf=%.4f  band=%s",
+                    c.candidate_set_id,
+                    c.candidate_type,
+                    c.confidence,
+                    c.confidence_band,
+                )
+            for c in near_misses:
+                self._logger.trace(
+                    "ranking.near_miss   id=%s  type=%s  conf=%.4f  reason=%s",
+                    c.candidate_set_id,
+                    c.candidate_type,
+                    c.confidence,
+                    c.metadata.get("near_miss_reason"),
+                )
+        return RankingToolResult(
+            returned=tuple(returned),
+            near_misses=tuple(near_misses),
+            return_threshold=ranking.return_threshold,
+            max_candidates=ranking.max_candidates,
+            max_near_misses=ranking.max_near_misses,
+        )
+
+    def build_input_summary(
+        self,
+        scored: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(scored, (list, tuple)):
+            return {"scored": len(scored)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: RankingToolResult,
+        scored: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        cap_overflow = sum(
+            1 for c in result.near_misses if c.metadata.get("near_miss_reason") == "cap_overflow"
+        )
+        below_threshold = sum(
+            1 for c in result.near_misses if c.metadata.get("near_miss_reason") == "below_threshold"
+        )
+        return {
+            "threshold": result.return_threshold,
+            "returned": len(result.returned),
+            "near_misses": len(result.near_misses),
+            "cap_overflow": cap_overflow,
+            "below_threshold": below_threshold,
+        }
+
+
+_default_tool = RankingTools()
+
+
+@tool(
+    name="run_rank_candidates",
+    description="Rank scored candidates and split into returned sets and near-misses.",
+    category="banking.ranking",
+    tags=["banking", "ranking"],
+)
+def run_rank_candidates(
+    scored: Sequence[CandidateSet],
+    config: AppConfig,
+    *,
+    max_candidates: int | None = None,
+    max_near_misses: int | None = None,
+    return_threshold: float | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> RankingToolResult:
+    """Rank scored candidates and split returned sets from near-misses.
+
+    Args:
+        scored: Scored candidate sets to rank.
+        config: Application configuration for ranking thresholds.
+        max_candidates: Optional cap on returned candidate sets.
+        max_near_misses: Optional cap on near-miss candidate sets.
+        return_threshold: Optional minimum confidence for returned sets.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with ranking warnings.
+
+    Returns:
+        RankingToolResult with returned sets and near-miss sets.
+    """
+    return _default_tool.run(
+        scored,
+        audit=audit,
+        warnings=warnings,
+        config=config,
+        max_candidates=max_candidates,
+        max_near_misses=max_near_misses,
+        return_threshold=return_threshold,
+    )
