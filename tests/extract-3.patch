+"""Unit tests for confidence accumulator audit + TRACE."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline.scoring.ConfidenceAccumulator import (
+    ConfidenceAccumulator,
+    confidence_log_prefix,
+)
+from nw_core.logging import TRACE
+
+
+def test_accumulator_tracks_running_total():
+    accum = ConfidenceAccumulator(candidate_id="cs_1")
+    accum.apply_delta(
+        stage="date_pattern",
+        amount=0.25,
+        max_value=0.30,
+        reasoning="test date",
