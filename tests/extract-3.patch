+"""Public tool entry point for salary-transaction detection."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+from nw_agbus_salary_extractor.services import (
+    BankTransactionRequest,
+    BankTransactionResult,
+)
+from nw_agbus_salary_extractor.services.SalaryTransactionExtractorService import (
+    SalaryTransactionExtractorService,
+)
+from nw_aglib_toolkit.channels.tools import tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.logging import AddCallContext, LogFn, setup_trace
+
+setup_trace()
+
+logger = logging.getLogger(__name__)
+
+_default_tool: SalaryTransactionExtractorTools | None = None
+
+
+def _tool() -> SalaryTransactionExtractorTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = SalaryTransactionExtractorTools()
+    return _default_tool
+
+
+class SalaryTransactionExtractorTools:
+    """Orchestrates the full salary-detection pipeline.
+
+    Wraps ``SalaryTransactionExtractorService`` with call-context logging for the
+    end-to-end ``run`` entry point. Prefer ``detect_salary_candidates`` for agent
+    and external callers.
+    """
+
+    phase_name = "salary_extractor"
+
+    def __init__(self, logger_: logging.Logger | None = None) -> None:
+        self._logger = logger_ or logger
+
+    @AddCallContext
+    @LogFn(logger=logger)
+    def run(
+        self,
+        payload: BankTransactionRequest,
+        *,
+        config: AppConfig | None = None,
+        calendar: WorkingDayCalendar | None = None,
+        mode: str | None = None,
+        max_candidates: int | None = None,
+        max_near_misses: int | None = None,
+        return_threshold: float | None = None,
+        include_audit: bool = False,
+    ) -> BankTransactionResult:
+        """Run the full detector pipeline and return the final result payload.
+
+        Args:
+            payload: Typed request containing bank transactions and analysis metadata.
+            config: Optional application config override.
+            calendar: Optional working-day calendar override.
+            mode: Validation mode override (``strict`` or ``lenient``).
+            max_candidates: Cap on returned candidate sets.
+            max_near_misses: Cap on near-miss candidate sets.
+            return_threshold: Minimum confidence for returned candidates.
+            include_audit: When ``True``, attach per-phase audit records to the result.
+
+        Returns:
+            Final detector result with ranked candidates, near-misses, and warnings.
+        """
+        service = SalaryTransactionExtractorService(config=config, calendar=calendar)
+        return service.detect(
+            payload,
+            mode=mode,
+            max_candidates=max_candidates,
+            max_near_misses=max_near_misses,
+            return_threshold=return_threshold,
+            include_audit=include_audit,
+        )
+
+    def build_input_summary(
+        self,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        """Summarise detector input for phase logging and optional audit."""
+        return {
+            "analysis_id": payload.analysis_id,
+            "row_count": len(payload.transactions),
+            "validation_mode": kwargs.get("mode") or payload.validation_mode,
+        }
+
+    def build_output_summary(
+        self,
+        result: BankTransactionResult,
+        payload: BankTransactionRequest,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        """Summarise detector output for phase logging and optional audit."""
+        return {
+            "candidates": len(result.candidate_sets),
+            "near_misses": len(result.rejected_or_near_miss_sets),
+            "warnings": len(result.warnings),
+        }
+
+
+@tool(
+    name="detect_salary_candidates",
+    description="Detect salary-like credit transactions from bank statement data.",
+    category="banking.salary",
+    tags=["banking", "salary", "transactions"],
+)
+def detect_salary_candidates(
+    payload: BankTransactionRequest,
+    *,
+    config: AppConfig | None = None,
+    calendar: WorkingDayCalendar | None = None,
+    mode: str | None = None,
+    max_candidates: int | None = None,
+    max_near_misses: int | None = None,
+    return_threshold: float | None = None,
+    include_audit: bool = False,
+) -> BankTransactionResult:
+    """Detect salary-like credit transactions from bank statement data.
+
+    Runs the full salary-detection pipeline and returns ranked candidate sets.
+
+    Args:
+        payload: Typed detector request with raw bank transactions and analysis metadata.
+        config: Optional application config override.
+        calendar: Optional working-day calendar override.
+        mode: Validation mode override (``strict`` or ``lenient``).
+        max_candidates: Cap on returned candidate sets.
+        max_near_misses: Cap on near-miss candidate sets.
+        return_threshold: Minimum confidence for returned candidates.
+        include_audit: When ``True``, attach per-phase audit records to the result.
+
+    Returns:
+        Final detector result with candidate sets, near-misses, and warnings.
+    """
+    return _tool().run(
+        payload,
+        config=config,
+        calendar=calendar,
+        mode=mode,
+        max_candidates=max_candidates,
+        max_near_misses=max_near_misses,
+        return_threshold=return_threshold,
+        include_audit=include_audit,
+    )
+
+
+__all__ = [
+    "SalaryTransactionExtractorTools",
+    "detect_salary_candidates",
+]
