+"""Public tool functions for amount + date-only fallback candidate generation."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, TransactionFeatures
+from nw_agcore_bank_transactions.pipeline.amount_date_fallback.AmountDateFallbackService import (
+    AmountDateFallbackService,
+)
+from nw_agcore_bank_transactions.pipeline.amount_date_fallback.models import (
+    AmountDateFallbackToolResult,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import AppliedHints
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "AmountDateFallbackTools",
+    "AmountDateFallbackToolResult",
+    "run_amount_date_fallback",
+]
+
+_default_tool = None
+
+
+def _tool() -> AmountDateFallbackTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = AmountDateFallbackTools()
+    return _default_tool
+
+
+class AmountDateFallbackTools(BaseTool[AmountDateFallbackToolResult]):
+    phase_name = "amount_date_fallback"
+
+    @LogFn
+    def _execute(
+        self,
+        unaccounted: Sequence[BankTransaction],
+        calendar: WorkingDayCalendar,
+        features_by_id: dict[str, TransactionFeatures],
+        *,
+        applied_hints: AppliedHints | None = None,
+        config: AppConfig,
+        region: str = "EnglandAndWales",
+    ) -> AmountDateFallbackToolResult:
+        detector = AmountDateFallbackService(config=config)
+        candidates = detector.emit_candidates(
+            unaccounted,
+            calendar,
+            features_by_id=features_by_id,
+            applied_hints=applied_hints,
+            region=region,
+        )
+        return AmountDateFallbackToolResult(candidates=candidates)
+
+    def build_input_summary(
+        self,
+        unaccounted: Sequence[BankTransaction],
+        calendar: WorkingDayCalendar,
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {"unaccounted": len(unaccounted)}
+
+    def build_output_summary(
+        self,
+        result: AmountDateFallbackToolResult,
+        unaccounted: Sequence[BankTransaction],
+        calendar: WorkingDayCalendar,
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "fallback_candidates": len(result.candidates),
+            "skipped": len(unaccounted) == 0,
+        }
+
+    def trace_output(self, result: AmountDateFallbackToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for c in result.candidates:
+            self._logger.trace(
+                "fallback.candidate  id=%s  txns=%d",
+                c.candidate_set_id,
+                len(c.transactions),
+            )
+
+
+@tool(
+    name="run_amount_date_fallback",
+    description="Run amount date fallback.",
+    category="banking.scoring",
+    tags=["banking", "scoring", "fallback"],
+)
+def run_amount_date_fallback(
+    unaccounted: Sequence[BankTransaction],
+    calendar: WorkingDayCalendar,
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    applied_hints: AppliedHints | None = None,
+    config: AppConfig,
+    region: str = "EnglandAndWales",
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> AmountDateFallbackToolResult:
+    """Generate fallback candidates from unaccounted credits using amount and date only.
+
+    Args:
+        unaccounted: Credit transactions not yet assigned to a candidate set.
+        calendar: Working-day calendar for payday inference.
+        features_by_id: Feature map keyed by transaction id.
+        applied_hints: Hints applied in earlier phases.
+        config: Application configuration for fallback rules.
+        region: UK region code for calendar handling.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with fallback warnings.
+
+    Returns:
+        AmountDateFallbackToolResult with fallback candidate sets.
+    """
+    return _tool().run(
+        unaccounted,
+        calendar,
+        features_by_id,
+        audit=audit,
+        warnings=warnings,
+        applied_hints=applied_hints,
+        config=config,
+        region=region,
+    )
