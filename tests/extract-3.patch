+"""REST route for bank-transaction normalisation."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import NormalizationRequest
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RequestParsing import raw_transaction_from_mapping
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..BankTransactionNormalizationTools import run_normalize_bank_transactions
+
+
+class NormalizationRoute(BaseToolRoute):
+    tool_name = "run_normalize_bank_transactions"
+    path = "/normalization/normalize"
+    tags = ("normalization",)
+    summary = "Normalise raw bank transactions into canonical credit rows."
+    openapi_filename = "run_normalize_bank_transactions.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def normalize_transactions(body: NormalizationRequest):
+            try:
+                build_context(body)
+                rows = tuple(raw_transaction_from_mapping(row) for row in body.transactions)
+                audit = build_audit(body)
+                result = run_normalize_bank_transactions(rows, audit=audit)
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
