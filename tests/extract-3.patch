+"""Unit tests for negative keyword hard rejection."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    CandidateSet,
+    CandidateTransaction,
+    DetectedPattern,
+    ScoreBreakdown,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.scoring.NegativeKeywordRejection import (
+    NEAR_MISS_REASON,
+    collect_matched_negative_keywords,
+    partition_by_negative_keywords,
+    tag_negative_keyword_rejection,
+)
+
+
+def _candidate(*txn_ids: str) -> CandidateSet:
+    return CandidateSet(
+        candidate_set_id="cs_test",
+        candidate_type="unknown_recurring_credit",
+        transactions=tuple(
+            CandidateTransaction(
+                date="2024-01-01",
+                description="desc",
+                amount=100.0,
+                transaction_id=tid,
+            )
+            for tid in txn_ids
+        ),
+        score_breakdown=ScoreBreakdown(),
+        detected_pattern=DetectedPattern(),
+        reasoning=("existing reason",),
+    )
+
+
+def test_collect_returns_empty_when_no_negative_tokens():
+    candidate = _candidate("t1")
+    features = {"t1": TransactionFeatures(transaction_id="t1")}
+    assert collect_matched_negative_keywords(candidate, features) == ()
+
+
+def test_collect_unions_negative_tokens_across_cluster():
+    candidate = _candidate("t1", "t2")
+    features = {
+        "t1": TransactionFeatures(transaction_id="t1", negative_tokens=("CASHBACK",)),
+        "t2": TransactionFeatures(transaction_id="t2", negative_tokens=("REFUND",)),
+    }
+    assert collect_matched_negative_keywords(candidate, features) == ("CASHBACK", "REFUND")
+
+
+def test_tag_negative_keyword_rejection_sets_metadata_and_reasoning():
+    candidate = _candidate("t1")
+    tagged = tag_negative_keyword_rejection(candidate, ("CASHBACK",))
+    assert tagged.metadata["near_miss_reason"] == NEAR_MISS_REASON
+    assert tagged.metadata["matched_negative_keywords"] == ["CASHBACK"]
+    assert tagged.reasoning[0] == "Skipped: negative keyword match (CASHBACK)."
+    assert tagged.reasoning[1:] == ("existing reason",)
+
+
+def test_partition_keeps_clean_candidates_and_rejects_negative_hits():
+    clean = _candidate("t1")
+    dirty = _candidate("t2")
+    features = {
+        "t1": TransactionFeatures(transaction_id="t1"),
+        "t2": TransactionFeatures(transaction_id="t2", negative_tokens=("CASHBACK",)),
+    }
+    kept, rejected = partition_by_negative_keywords([clean, dirty], features)
+    assert kept == [clean]
+    assert len(rejected) == 1
+    assert rejected[0].metadata["near_miss_reason"] == NEAR_MISS_REASON
+    assert rejected[0].metadata["matched_negative_keywords"] == ["CASHBACK"]
