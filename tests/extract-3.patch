+"""Phase 8 — reasoning builder (Design §13)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._services.recurrence import PaydayModel, RecurrenceFit
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+    ScoreBreakdown,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    AmountFit,
+    AmountModel,
+    AmountSegment,
+    ScoringInputs,
+    build_reasoning,
+    build_risks,
+)
+
+
+def _txn(tid, datestr, desc, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=datestr,
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _feature(tid, *, employer=(), hint=(), negative=(), channel="bacs_or_direct_credit"):
+    return TransactionFeatures(
+        transaction_id=tid,
+        payment_channel=channel,
+        possible_employer_tokens=employer,
+        salary_hint_tokens=hint,
+        negative_tokens=negative,
+    )
+
+
+def _stable_cluster_inputs(amount_model=AmountModel.STABLE, segments=()):
+    return ScoringInputs(
+        recurrence=RecurrenceFit(
+            model=PaydayModel.LAST_WORKING_DAY,
+            fit_score=1.0,
+            coverage=1.0,
+            mean_deviation_days=0.0,
+            matched_count=12,
+            expected_count=12,
+        ),
+        amount=AmountFit(
+            model=amount_model,
+            score=0.9,
+            median_amount=Decimal("2450"),
+            coefficient_of_variation=0.0,
+            segments=segments,
+        ),
+        band_modifier_value=1.0,
+        channel=0.95,
+        description=0.9,
+        context=0.05,
+        coverage=1.0,
+        negative_penalty=0.0,
+        anchor=0.0,
+    )
+
+
+def _stable_score(anchor=0.0, penalty=0.0, band_modifier=1.0):
+    return ScoreBreakdown(
+        date_pattern_score=1.0,
+        description_similarity_score=0.9,
+        amount_consistency_score=1.0,
+        payment_channel_score=0.95,
+        coverage_score=1.0,
+        context_bonus=0.05,
+        negative_signal_penalty=penalty,
+        anchor_bonus=anchor,
+        salary_band_modifier=band_modifier,
+        final_score=0.85,
+    )
+
+
+# --- Positive reasons ----------------------------------------------------
+
+
+def test_reasoning_mentions_payday_model_when_clean():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-28", "BACS ACME LTD PAYROLL", "2450") for i in range(6)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    reasons = build_reasoning(cluster, by_id, _stable_score(), _stable_cluster_inputs())
+    text = " ".join(reasons)
+    assert "last working day of month" in text
+    assert "ACME" in text
+    assert "PAYROLL" in text
+
+
+def test_reasoning_mentions_amount_step_change_when_present():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-28", "BACS ACME LTD PAYROLL", "2450") for i in range(6)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    inputs = _stable_cluster_inputs(
+        amount_model=AmountModel.STABLE_WITH_STEP_CHANGE,
+        segments=(
+            AmountSegment(start_index=0, end_index=2, median=Decimal("2400.00")),
+            AmountSegment(start_index=3, end_index=5, median=Decimal("2640.00")),
+        ),
+    )
+    reasons = build_reasoning(cluster, by_id, _stable_score(), inputs)
+    text = " ".join(reasons)
+    assert "step change" in text
+    assert "2400" in text
+    assert "2640" in text
+
+
+def test_reasoning_quotes_anchor_when_present():
+    cluster = [_txn("a", "2024-04-30", "BACS ACME LTD PAYROLL", "2453.67")]
+    by_id = {"a": _feature("a", employer=("ACME",), hint=("PAYROLL",))}
+    score = _stable_score(anchor=0.05)
+    reasons = build_reasoning(cluster, by_id, score, _stable_cluster_inputs())
+    text = " ".join(reasons)
+    assert "Payslip anchor confirmed" in text
+
+
+def test_reasoning_omits_payday_model_for_irregular_short_clusters():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-15", "BACS ACME LTD PAYROLL", "2450") for i in range(2)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",)) for t in cluster}
+    inputs = _stable_cluster_inputs()
+    irregular_inputs = ScoringInputs(
+        recurrence=RecurrenceFit(
+            model=PaydayModel.IRREGULAR_SALARY_LIKE,
+            fit_score=0.0,
+            coverage=0.0,
+            mean_deviation_days=999.0,
+            matched_count=0,
+            expected_count=0,
+        ),
+        amount=inputs.amount,
+        band_modifier_value=1.0,
+        channel=0.95,
+        description=0.5,
+        context=0.0,
+        coverage=0.0,
+        negative_penalty=0.0,
+        anchor=0.0,
+    )
+    reasons = build_reasoning(cluster, by_id, _stable_score(), irregular_inputs)
+    text = " ".join(reasons)
+    assert "last working day" not in text
+
+
+# --- Risks --------------------------------------------------------------
+
+
+def test_risks_lists_missing_months():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-28", "BACS ACME LTD PAYROLL", "2450") for i in range(11)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    inputs = _stable_cluster_inputs()
+    inputs_with_missing = ScoringInputs(
+        recurrence=RecurrenceFit(
+            model=PaydayModel.LAST_WORKING_DAY,
+            fit_score=0.92,
+            coverage=11 / 12,
+            mean_deviation_days=0.0,
+            matched_count=11,
+            expected_count=12,
+        ),
+        amount=inputs.amount,
+        band_modifier_value=1.0,
+        channel=0.95,
+        description=0.9,
+        context=0.05,
+        coverage=11 / 12,
+        negative_penalty=0.0,
+        anchor=0.0,
+    )
+    risks = build_risks(cluster, by_id, _stable_score(), inputs_with_missing)
+    text = " ".join(risks)
+    assert "1 expected payday period(s) were missing" in text
+
+
+def test_risks_quotes_negative_tokens():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-15", "BACS DWP UNIVERSAL CREDIT", "627.40")
+        for i in range(6)
+    ]
+    by_id = {t.id: _feature(t.id, negative=("DWP", "UNIVERSAL CREDIT")) for t in cluster}
+    risks = build_risks(cluster, by_id, _stable_score(penalty=-0.20), _stable_cluster_inputs())
+    text = " ".join(risks)
+    assert "DWP" in text
+    assert "UNIVERSAL CREDIT" in text
+
+
+def test_risks_emits_bacs_caveat_when_channel_is_bacs():
+    cluster = [_txn(f"t{i}", f"2024-{i + 1:02d}-28", "BACS ACME PAYROLL", "2450") for i in range(6)]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    risks = build_risks(cluster, by_id, _stable_score(), _stable_cluster_inputs())
+    text = " ".join(risks)
+    assert "Bacs/Direct Credit is also used" in text
+
+
+def test_risks_emits_band_modifier_note_when_below_one():
+    cluster = [_txn(f"t{i}", f"2024-{i + 1:02d}-28", "BACS ACME PAYROLL", "2450") for i in range(6)]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    risks = build_risks(cluster, by_id, _stable_score(band_modifier=0.65), _stable_cluster_inputs())
+    text = " ".join(risks)
+    assert "approx-salary band" in text
+
+
+def test_risks_emits_amount_variability_note():
+    cluster = [
+        _txn(f"t{i}", f"2024-{i + 1:02d}-15", "FPI ACME COMMISSION", "2450") for i in range(6)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), channel="faster_payment") for t in cluster}
+    inputs = _stable_cluster_inputs(amount_model=AmountModel.TOO_VARIABLE)
+    risks = build_risks(cluster, by_id, _stable_score(), inputs)
+    text = " ".join(risks)
+    assert "Amount varies significantly" in text
