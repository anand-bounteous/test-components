+"""REST route for employment transition handling."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import EmploymentTransitionRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import candidate_sets_from_wire
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..EmploymentTransitionTools import run_link_employment_transitions
+
+
+class EmploymentTransitionRoute(BaseToolRoute):
+    tool_name = "run_link_employment_transitions"
+    path = "/scoring/employment-transition"
+    tags = ("scoring",)
+    summary = "Link employment transitions across scored candidate sets."
+    openapi_filename = "run_link_employment_transitions.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def employment_transition(body: EmploymentTransitionRequest):
+            try:
+                ctx = build_context(body)
+                audit = build_audit(body)
+                result = run_link_employment_transitions(
+                    candidate_sets_from_wire(body.scored),
+                    ctx.config,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
