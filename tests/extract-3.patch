+"""Gift hint application audit."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+
+from ..matchers.AmountMinimumMatcher import aggregate_exact, aggregate_meets_minimum
+from ..matchers.DateProximityMatcher import cluster_min_date_delta
+from ..matchers.GiftMatcher import GiftHintMatcher
+from ..matchers.PartyPropertyMatcher import max_match_level
+from ..models import AppliedGiftHints, GiftHints
+
+
+def apply_gift_hints(
+    transactions: Sequence[BankTransaction],
+    hint_inputs: GiftHints,
+    matcher: GiftHintMatcher,
+    *,
+    expected_date: date | None = None,
+    aggregate_sum: Decimal | None = None,
+    cluster: Sequence[BankTransaction] | None = None,
+) -> AppliedGiftHints:
+    matcher.validate_amount_present(hint_inputs)
+    assert hint_inputs.amount is not None
+    rows = cluster if cluster is not None else transactions
+    total = (
+        aggregate_sum if aggregate_sum is not None else sum((t.amount for t in rows), Decimal("0"))
+    )
+
+    donor_level = "none"
+    for txn in rows:
+        donor_level = max_match_level(donor_level, matcher.donor_match_level(txn, hint_inputs))
+
+    meets_min = aggregate_meets_minimum(total, hint_inputs.amount) if rows else False
+    is_exact = aggregate_exact(total, hint_inputs.amount) if rows else False
+    if len(rows) == 1 and rows[0].amount == hint_inputs.amount:
+        is_exact = True
+
+    delta: int | None = None
+    expected_str = ""
+    if expected_date is not None:
+        expected_str = expected_date.isoformat()
+        if rows:
+            delta = cluster_min_date_delta(rows, expected_date)
+
+    unmatched: list[str] = []
+    if not meets_min:
+        unmatched.append("amount")
+    if hint_inputs.donor_name and donor_level == "none":
+        unmatched.append("donor_name")
+    if (
+        hint_inputs.expected_date
+        and delta is not None
+        and delta > matcher.effective_tolerance_days(hint_inputs)
+    ):
+        unmatched.append("expected_date")
+
+    return AppliedGiftHints(
+        amount_matched=meets_min,
+        aggregate_sum=total,
+        aggregate_meets_minimum=meets_min,
+        exact_amount_match=is_exact,
+        donor_match_level=donor_level,
+        expected_date=expected_str,
+        date_delta_days=delta,
+        unmatched_hint_fields=tuple(unmatched),
+    )
