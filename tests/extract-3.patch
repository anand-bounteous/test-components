+"""Property sale hint matching facade for grouping and scoring."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import (
+    overlap_match_level,
+    tokenise_employer_name,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+from nw_agcore_bank_transactions.pipeline.hints.models.PropertySaleHints import PropertySaleHints
+
+from .AmountRangeMatcher import amount_in_range
+from .KeywordsMatcher import sale_keyword_score
+from .PartyPropertyMatcher import property_match_level
+from .TimelineMatcher import symmetric_window
+
+
+def has_sale_keyword(description: str, positive: Sequence[str], negative: Sequence[str]) -> bool:
+    return sale_keyword_score(description, positive, negative) > 0.0
+
+
+class PropertySaleHintMatcher:
+    def __init__(
+        self,
+        *,
+        positive_keywords: Sequence[str] = (),
+        negative_keywords: Sequence[str] = (),
+        default_tolerance_pct: float = 0.10,
+        default_timeline_hint: str = "15d",
+    ) -> None:
+        self._positive = tuple(positive_keywords)
+        self._negative = tuple(negative_keywords)
+        self._default_tolerance_pct = default_tolerance_pct
+        self._default_timeline_hint = default_timeline_hint
+
+    @property
+    def positive_keywords(self) -> tuple[str, ...]:
+        return self._positive
+
+    @property
+    def negative_keywords(self) -> tuple[str, ...]:
+        return self._negative
+
+    def effective_tolerance(self, hint_inputs: PropertySaleHints) -> float:
+        if hint_inputs.tolerance_pct is not None:
+            return float(hint_inputs.tolerance_pct)
+        return self._default_tolerance_pct
+
+    def effective_timeline_hint(self, hint_inputs: PropertySaleHints) -> str:
+        if hint_inputs.timeline_hint:
+            return hint_inputs.timeline_hint
+        return self._default_timeline_hint
+
+    def validate_amount_present(self, hint_inputs: PropertySaleHints) -> None:
+        if hint_inputs.amount is None:
+            raise ValueError("sale_hints.amount is required")
+
+    def txn_matches_amount(self, txn: BankTransaction, hint_inputs: PropertySaleHints) -> bool:
+        if hint_inputs.amount is None:
+            return False
+        return amount_in_range(
+            txn.amount, hint_inputs.amount, self.effective_tolerance(hint_inputs)
+        )
+
+    def txn_soft_match(
+        self,
+        txn: BankTransaction,
+        hint_inputs: PropertySaleHints,
+    ) -> bool:
+        if self.txn_matches_amount(txn, hint_inputs):
+            return True
+        if has_sale_keyword(txn.normalised_description, self._positive, self._negative):
+            return True
+        tokens = frozenset(txn.description_tokens)
+        if hint_inputs.buyer_name:
+            if overlap_match_level(tokens, hint_inputs.buyer_name, load_hint_config()) != "none":
+                return True
+        if property_match_level(tokens, hint_inputs.property_ref, hint_inputs.location) != "none":
+            return True
+        if hint_inputs.postcode:
+            postcode_tokens = tokenise_employer_name(hint_inputs.postcode, load_hint_config())
+            if postcode_tokens & tokens:
+                return True
+        return False
+
+    def resolve_reference_date(
+        self,
+        transactions: Sequence[BankTransaction],
+        hint_inputs: PropertySaleHints,
+    ) -> date:
+        explicit = hint_inputs.reference_date or hint_inputs.sale_date
+        if explicit:
+            return date.fromisoformat(explicit)
+        sorted_txns = sorted(transactions, key=lambda t: (t.date, t.id))
+        for txn in sorted_txns:
+            if self.txn_soft_match(txn, hint_inputs):
+                return txn.date
+        if sorted_txns:
+            return sorted_txns[0].date
+        raise ValueError("no transactions available to resolve reference date")
+
+    def resolve_window(
+        self,
+        reference: date,
+        hint_inputs: PropertySaleHints,
+    ) -> tuple[date, date]:
+        return symmetric_window(reference, self.effective_timeline_hint(hint_inputs))
