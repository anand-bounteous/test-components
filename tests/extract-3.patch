+"""Phase 8 — candidate-type classifier (Design §12)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._services.recurrence import PaydayModel, RecurrenceFit
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    ScoreBreakdown,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    AmountFit,
+    AmountModel,
+    ScoringInputs,
+    classify_candidate_type,
+)
+
+
+def _features(*specs):
+    return [
+        TransactionFeatures(
+            transaction_id=f"t{i}",
+            payment_channel=spec.get("channel", "bacs_or_direct_credit"),
+            payment_channel_confidence=0.8,
+            possible_employer_tokens=spec.get("employer", ()),
+            salary_hint_tokens=spec.get("hint", ()),
+            negative_tokens=spec.get("negative", ()),
+        )
+        for i, spec in enumerate(specs)
+    ]
+
+
+def _amount_fit(model, segments=()):
+    return AmountFit(
+        model=model,
+        score=0.9,
+        median_amount=Decimal("2450"),
+        coefficient_of_variation=0.0,
+        outlier_ids=(),
+        segments=segments,
+    )
+
+
+def _recurrence_fit(model=PaydayModel.LAST_WORKING_DAY):
+    return RecurrenceFit(
+        model=model,
+        fit_score=1.0,
+        coverage=1.0,
+        mean_deviation_days=0.0,
+        matched_count=12,
+        expected_count=12,
+    )
+
+
+def _inputs(amount_model, *, recurrence=None, channel=0.95):
+    return ScoringInputs(
+        recurrence=recurrence or _recurrence_fit(),
+        amount=_amount_fit(amount_model),
+        band_modifier_value=1.0,
+        channel=channel,
+        description=0.9,
+        context=0.05,
+        coverage=1.0,
+        negative_penalty=0.0,
+        anchor=0.0,
+    )
+
+
+def _score(final, *, anchor_bonus=0.0, penalty=0.0):
+    return ScoreBreakdown(
+        date_pattern_score=1.0,
+        description_similarity_score=0.9,
+        amount_consistency_score=0.9,
+        payment_channel_score=0.95,
+        coverage_score=1.0,
+        context_bonus=0.05,
+        negative_signal_penalty=penalty,
+        anchor_bonus=anchor_bonus,
+        salary_band_modifier=1.0,
+        final_score=final,
+    )
+
+
+# --- Each Design §12 branch --------------------------------------------
+
+
+def test_probable_salary_for_high_score_no_negatives():
+    feats = _features({"employer": ("ACME",), "hint": ("PAYROLL",)})
+    result = classify_candidate_type(_score(0.90), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "probable_salary"
+    assert result.reason_key == "high_confidence_salary"
+
+
+def test_possible_salary_for_medium_score():
+    feats = _features({"employer": ("ACME",), "hint": ("PAY",)})
+    result = classify_candidate_type(
+        _score(0.60), _inputs(AmountModel.STABLE_WITH_MINOR_VARIATION), feats
+    )
+    assert result.candidate_type == "possible_salary"
+
+
+def test_unknown_recurring_credit_when_score_low():
+    feats = _features({"channel": "unknown_credit"})
+    result = classify_candidate_type(_score(0.30), _inputs(AmountModel.STABLE, channel=0.30), feats)
+    assert result.candidate_type == "unknown_recurring_credit"
+
+
+def test_recurring_income_when_majority_carry_pension_marker():
+    feats = _features(*[{"negative": ("PENSION",)} for _ in range(8)] + [{} for _ in range(2)])
+    result = classify_candidate_type(_score(0.80), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "recurring_income_not_salary_candidate"
+    assert result.reason_key == "non_salary_recurring_marker"
+
+
+def test_recurring_income_for_dwp_majority():
+    feats = _features(*[{"negative": ("DWP",)} for _ in range(6)])
+    result = classify_candidate_type(_score(0.75), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "recurring_income_not_salary_candidate"
+
+
+def test_recurring_income_for_own_account_majority():
+    feats = _features(*[{"negative": ("OWN ACCOUNT",)} for _ in range(6)])
+    result = classify_candidate_type(_score(0.75), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "recurring_income_not_salary_candidate"
+
+
+def test_recurring_income_overrides_high_score():
+    """Even a 0.95 final score doesn't beat a clear pension/DWP majority."""
+    feats = _features(*[{"negative": ("DWP",)} for _ in range(12)])
+    result = classify_candidate_type(_score(0.95), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "recurring_income_not_salary_candidate"
+
+
+def test_final_pay_candidate_when_amount_model_is_one_off_outlier():
+    feats = _features({"employer": ("ACME",), "hint": ("PAYROLL",)})
+    result = classify_candidate_type(
+        _score(0.80),
+        _inputs(AmountModel.ONE_OFF_FINAL_PAY_OUTLIER),
+        feats,
+    )
+    assert result.candidate_type == "final_pay_candidate"
+
+
+def test_bonus_candidate_when_amount_model_is_bonus_outlier():
+    feats = _features({"employer": ("ACME",)})
+    result = classify_candidate_type(
+        _score(0.80),
+        _inputs(AmountModel.BONUS_OR_EXTRA_PAY_OUTLIER),
+        feats,
+    )
+    assert result.candidate_type == "bonus_or_extra_pay_candidate"
+
+
+def test_expense_reimbursement_when_too_variable_low_channel_and_employer_present():
+    feats = _features(
+        {"employer": ("ACME",), "channel": "internal_transfer"},
+        {"employer": ("ACME",), "channel": "internal_transfer"},
+        {"employer": ("ACME",), "channel": "internal_transfer"},
+    )
+    result = classify_candidate_type(
+        _score(0.45),
+        _inputs(AmountModel.TOO_VARIABLE, channel=0.20),
+        feats,
+    )
+    assert result.candidate_type == "expense_reimbursement_candidate"
+
+
+def test_single_pension_token_doesnt_taint_majority_salary():
+    """A one-off pension lookup token in an otherwise-clean salary
+    cluster must not flip the classification."""
+    feats = _features(
+        *[{"employer": ("ACME",), "hint": ("PAYROLL",)} for _ in range(11)]
+        + [{"negative": ("PENSION",)}]
+    )
+    result = classify_candidate_type(_score(0.85), _inputs(AmountModel.STABLE), feats)
+    assert result.candidate_type == "probable_salary"
