+from pathlib import Path
+
+from nw_core.config.ComponentSettings import load_settings
+from nw_core.channels.ChannelDeployment import DeploymentManifest, ChannelBootstrap
+from nw_app_template_api.config.settings import AppSettings
+from nw_app_template_api.channels.registry import register_channels
+
+
+def build_runtime(component_root: Path):
+    settings = load_settings(component_root, AppSettings)
+    manifest = DeploymentManifest.load(component_root / "config" / "deployment.yaml")
+    registry = register_channels(settings)
+    runtime = ChannelBootstrap.build(manifest, registry, title="App Template API")
+    return runtime, settings, manifest
