+"""Phase 2 — config loader unit tests."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+from nw_aglib_toolkit.pipeline.config import (
+    AppConfig,
+    ConfigLoadError,
+    deep_merge,
+    load_config,
+)
+
+from tests.feature.support.ConfigSchema import config_schema_path, validate_merged_config
+
+HAS_CONFIG_SCHEMA = config_schema_path().is_file()
+
+# --- Defaults -------------------------------------------------------------
+
+
+def test_defaults_load_cleanly():
+    cfg = load_config()
+    if HAS_CONFIG_SCHEMA:
+        validate_merged_config(cfg.data)
+    assert isinstance(cfg, AppConfig)
+    # Sanity on a handful of expected values.
+    assert cfg.weight("date_pattern_score") == 0.30
+    assert cfg.weight("amount_consistency_score") == 0.20
+    assert cfg.threshold("high") == 0.85
+    assert cfg.default_region() == "EnglandAndWales"
+
+
+def test_defaults_expose_channels_and_negative_signals():
+    cfg = load_config()
+    channels = cfg.channels()
+    assert "bacs_or_direct_credit" in channels
+    assert "BACS" in channels["bacs_or_direct_credit"]["positive_tokens"]
+    negatives = cfg.negative_signals()
+    assert "DWP" in negatives["government_benefits"]
+    assert "PENSION" in negatives["pension"]
+
+
+def test_defaults_include_versions():
+    cfg = load_config()
+    versions = cfg.versions()
+    assert versions["scoring_version"]
+    assert versions["payment_mapping_version"]
+
+
+# --- Overrides ------------------------------------------------------------
+
+
+def test_caller_override_wins_over_defaults():
+    cfg = load_config(
+        overrides={
+            "weights": {
+                "date_pattern_score": 0.99,
+                "description_similarity_score": 0.0,
+                "amount_consistency_score": 0.0,
+                "payment_channel_score": 0.0,
+                "coverage_score": 0.0,
+                "context_bonus": 0.0,
+            }
+        }
+    )
+    assert cfg.weight("date_pattern_score") == 0.99
+
+
+def test_file_override_layer(tmp_path: Path):
+    override = tmp_path / "override.yaml"
+    override.write_text(
+        "thresholds:\n  high: 0.99\n  medium_high: 0.95\n  medium: 0.90\n  low: 0.80\n"
+    )
+    cfg = load_config(file_overrides=[override])
+    assert cfg.threshold("high") == 0.99
+    assert cfg.threshold("medium_high") == 0.95
+
+
+def test_file_override_then_caller_override_caller_wins(tmp_path: Path):
+    override = tmp_path / "override.yaml"
+    override.write_text(
+        "thresholds:\n  high: 0.99\n  medium_high: 0.95\n  medium: 0.90\n  low: 0.80\n"
+    )
+    cfg = load_config(
+        file_overrides=[override],
+        overrides={"thresholds": {"high": 0.88, "medium_high": 0.70, "medium": 0.55, "low": 0.40}},
+    )
+    assert cfg.threshold("high") == 0.88
+
+
+@pytest.mark.skipif(not HAS_CONFIG_SCHEMA, reason="config.schema.json not present")
+def test_invalid_caller_override_fails_schema_validation():
+    bad = {
+        "weights": {
+            "date_pattern_score": "not-a-number",
+            "description_similarity_score": 0.0,
+            "amount_consistency_score": 0.0,
+            "payment_channel_score": 0.0,
+            "coverage_score": 0.0,
+            "context_bonus": 0.0,
+        }
+    }
+    cfg = load_config(overrides=bad)
+    with pytest.raises(ConfigLoadError):
+        validate_merged_config(cfg.data)
+
+
+def test_file_override_invalid_yaml_raises(tmp_path: Path):
+    override = tmp_path / "bad.yaml"
+    override.write_text(":\n  - this is\n  not: valid: yaml: at all\n")
+    with pytest.raises(ConfigLoadError):
+        load_config(file_overrides=[override])
+
+
+def test_file_override_missing_path_raises(tmp_path: Path):
+    with pytest.raises(ConfigLoadError):
+        load_config(file_overrides=[tmp_path / "nope.yaml"])
+
+
+def test_top_level_list_yaml_rejected(tmp_path: Path):
+    override = tmp_path / "list.yaml"
+    override.write_text("- a\n- b\n")
+    with pytest.raises(ConfigLoadError):
+        load_config(file_overrides=[override])
+
+
+# --- Bank-specific overlays -----------------------------------------------
+
+
+def test_natwest_overlay_adds_chp_to_chaps():
+    cfg = load_config(source_bank="natwest")
+    chaps_tokens = cfg.channels()["chaps"]["positive_tokens"]
+    # Generic mapping already includes CHP, NatWest overlay leaves it in.
+    assert "CHP" in chaps_tokens
+
+
+def test_natwest_overlay_adds_bac_to_bacs_channel():
+    cfg = load_config(source_bank="natwest")
+    bacs_tokens = cfg.channels()["bacs_or_direct_credit"]["positive_tokens"]
+    assert "BAC" in bacs_tokens
+    assert "BGC" in bacs_tokens
+
+
+def test_natwest_overlay_extends_government_benefits_with_int():
+    cfg = load_config(source_bank="natwest")
+    benefits = cfg.negative_signals()["government_benefits"]
+    assert "DWP" in benefits
+    assert "INT" in benefits  # NatWest INT (interest) overlay
+
+
+def test_barclays_overlay_adds_cre_to_bacs_channel():
+    cfg = load_config(source_bank="barclays")
+    bacs_tokens = cfg.channels()["bacs_or_direct_credit"]["positive_tokens"]
+    assert "CRE" in bacs_tokens
+
+
+def test_barclays_overlay_records_source_bank():
+    cfg = load_config(source_bank="barclays")
+    assert cfg.get("source_bank") == "barclays"
+
+
+def test_unknown_source_bank_does_not_break_load():
+    cfg = load_config(source_bank="non_existent_bank")
+    # Falls back to generic mapping; load succeeds; source_bank not set.
+    assert "BACS" in cfg.channels()["bacs_or_direct_credit"]["positive_tokens"]
+    assert cfg.get("source_bank") is None
+
+
+# --- deep_merge ------------------------------------------------------------
+
+
+def test_deep_merge_recursive_dict():
+    base = {"a": {"b": 1, "c": 2}}
+    overlay = {"a": {"c": 99, "d": 3}}
+    merged = deep_merge(base, overlay)
+    assert merged == {"a": {"b": 1, "c": 99, "d": 3}}
+
+
+def test_deep_merge_list_appends_without_duplicates():
+    base = {"channels": {"x": {"positive_tokens": ["A", "B"]}}}
+    overlay = {"channels": {"x": {"positive_tokens": ["B", "C"]}}}
+    merged = deep_merge(base, overlay)
+    assert merged["channels"]["x"]["positive_tokens"] == ["A", "B", "C"]
+
+
+def test_deep_merge_rejects_non_dict_input():
+    with pytest.raises(TypeError):
+        deep_merge([1, 2], {"x": 1})
+
+
+def test_deep_merge_does_not_mutate_inputs():
+    base = {"a": {"b": 1}}
+    overlay = {"a": {"c": 2}}
+    deep_merge(base, overlay)
+    assert base == {"a": {"b": 1}}
+    assert overlay == {"a": {"c": 2}}
+
+
+# --- AppConfig accessors --------------------------------------------------
+
+
+def test_app_config_get_chain():
+    cfg = load_config()
+    assert cfg.get("calendar", "default_region") == "EnglandAndWales"
+    assert cfg.get("nonsense", "more", default=42) == 42
+
+
+def test_amount_config_exposed():
+    cfg = load_config()
+    amt = cfg.amount_config()
+    assert amt["stable_pct_tolerance"] == 0.02
+    assert amt["moderate_pct_tolerance"] == 0.10
+
+
+def test_bonuses_and_penalties_exposed():
+    cfg = load_config()
+    bon = cfg.bonuses()
+    pen = cfg.penalties()
+    assert bon["per_anchor"] == 0.05
+    assert bon["max_anchor_bonus"] == 0.15
+    assert pen["max_negative_signal_penalty"] == -0.20
+
+
+def test_salary_hints_keywords_loaded():
+    cfg = load_config()
+    hints = cfg.salary_hints_keywords()
+    assert "PAYROLL" in hints["strong"]
