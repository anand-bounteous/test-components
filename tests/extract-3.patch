+"""Calendar-day proximity scoring for gift date hints."""
+
+from __future__ import annotations
+
+from datetime import date
+
+
+def date_delta_days(txn_date: date, expected_date: date) -> int:
+    return abs((txn_date - expected_date).days)
+
+
+def date_proximity_score(delta_days: int, tolerance_days: int) -> float:
+    if tolerance_days <= 0:
+        return 1.0 if delta_days == 0 else 0.0
+    if delta_days <= tolerance_days:
+        return 1.0 - (delta_days / tolerance_days) * 0.3
+    return max(0.0, 0.7 - (delta_days - tolerance_days) / 30.0)
+
+
+def cluster_min_date_delta(transactions, expected_date: date) -> int:
+    if not transactions:
+        return 0
+    return min(date_delta_days(t.date, expected_date) for t in transactions)
+
+
+def neutral_date_score() -> float:
+    return 0.5
