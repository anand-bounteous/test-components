+from __future__ import annotations
+
+from pathlib import Path
+
+import fitz  # PyMuPDF
+
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import RasterPage
+
+
+class RasterizationService:
+    def rasterize(self, pdf_path: str, out_dir: str, *, dpi: int = 300) -> list[RasterPage]:
+        out = Path(out_dir)
+        out.mkdir(parents=True, exist_ok=True)
+        doc = fitz.open(pdf_path)
+        pages: list[RasterPage] = []
+        for i, page in enumerate(doc):
+            pix = page.get_pixmap(dpi=dpi)
+            png = out / f"page-{i:03d}.png"
+            pix.save(str(png))
+            pages.append(RasterPage(
+                page_index=i,
+                dpi=dpi,
+                width=pix.width,
+                height=pix.height,
+                png_path=str(png),
+            ))
+        doc.close()
+        return pages
