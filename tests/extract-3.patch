+
+
+@dataclass(frozen=True)
+class RouteContext:
+    """Immutable request-scoped context for tool calls."""
+
+    config: AppConfig
+    calendar: WorkingDayCalendar
+    region: str
+
+    @classmethod
+    def from_request(
+        cls,
+        *,
+        config_overrides: dict[str, Any] | None = None,
+        source_bank: str | None = None,
+        region: str | None = None,
+    ) -> RouteContext:
+        config = load_config(overrides=config_overrides, source_bank=source_bank)
