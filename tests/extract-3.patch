+from __future__ import annotations
+
+import uuid
+from pathlib import Path
+
+import pdfplumber
+
+from nw_agcore_document_data_extractor.pipeline._models.Region import BBox, Region, RegionType
+from nw_agcore_document_data_extractor.pipeline._models.TableModel import TableCell, TableModel
+from nw_agcore_document_data_extractor.pipeline._services.CoordinateConverter import coord_space_label
+
+_TABLE_STRATEGIES = [
+    ("lines", {"vertical_strategy": "lines", "horizontal_strategy": "lines"}),
+    ("text", {"vertical_strategy": "text", "horizontal_strategy": "text"}),
+    ("mixed", {"vertical_strategy": "lines", "horizontal_strategy": "text"}),
+]
+
+
+class PdfPlumberExtractor:
+    def extract_text(self, pdf_path: str, *, dpi: int = 300) -> dict[int, list[Region]]:
+        cs = coord_space_label(dpi)
+        scale = dpi / 72.0
+        results: dict[int, list[Region]] = {}
+        with pdfplumber.open(pdf_path) as pdf:
+            for page_idx, page in enumerate(pdf.pages):
+                regions: list[Region] = []
+                words = page.extract_words() or []
+                lines: list[list[dict]] = []
+                for word in sorted(words, key=lambda w: (round(w["top"] / 2), w["x0"])):
+                    placed = False
+                    for line in lines:
+                        if abs(line[-1]["top"] - word["top"]) <= 2:
+                            line.append(word)
+                            placed = True
+                            break
+                    if not placed:
+                        lines.append([word])
+                for line in lines:
+                    x0 = min(w["x0"] for w in line)
+                    y0 = min(w["top"] for w in line)
+                    x1 = max(w["x1"] for w in line)
+                    y1 = max(w["bottom"] for w in line)
+                    text = " ".join(w["text"] for w in line)
+                    bbox = BBox(
+                        x=x0 * scale,
+                        y=y0 * scale,
+                        w=(x1 - x0) * scale,
+                        h=(y1 - y0) * scale,
+                        page_index=page_idx,
+                        coord_space=cs,
+                    )
+                    regions.append(Region(
+                        type=RegionType.NORMAL_TEXT,
+                        bbox=bbox,
+                        text=text,
+                        confidence=1.0,
+                        source_tool="pdfplumber",
+                        attributes={"word_count": len(line)},
+                    ))
+                results[page_idx] = regions
+        return results
+
+    def extract_tables(self, pdf_path: str, *, dpi: int = 300) -> dict[int, list[TableModel]]:
+        return {idx: [t for _, t in pairs] for idx, pairs in self.extract_tables_with_regions(pdf_path, dpi=dpi).items()}
+
+    def extract_tables_with_regions(
+        self, pdf_path: str, *, dpi: int = 300
+    ) -> dict[int, list[tuple[Region, TableModel]]]:
+        cs = coord_space_label(dpi)
+        scale = dpi / 72.0
+        results: dict[int, list[tuple[Region, TableModel]]] = {}
+        with pdfplumber.open(pdf_path) as pdf:
+            for page_idx, page in enumerate(pdf.pages):
+                pairs: list[tuple[Region, TableModel]] = []
+                for strategy_name, settings in _TABLE_STRATEGIES:
+                    found = page.find_tables(table_settings=settings)
+                    if found:
+                        for tbl in found:
+                            data = tbl.extract()
+                            if not data:
+                                continue
+                            n_rows = len(data)
+                            n_cols = max(len(r) for r in data) if data else 0
+                            region_id = uuid.uuid4().hex[:10]
+                            bbox_pts = tbl.bbox
+                            table_bbox = BBox(
+                                x=bbox_pts[0] * scale,
+                                y=bbox_pts[1] * scale,
+                                w=(bbox_pts[2] - bbox_pts[0]) * scale,
+                                h=(bbox_pts[3] - bbox_pts[1]) * scale,
+                                page_index=page_idx,
+                                coord_space=cs,
+                            )
+                            region = Region(
+                                id=region_id,
+                                type=RegionType.TABLE,
+                                bbox=table_bbox,
+                                text="",
+                                confidence=1.0,
+                                source_tool="pdfplumber",
+                                attributes={"strategy": strategy_name},
+                            )
+                            cells: list[TableCell] = []
+                            flat_cells = tbl.cells
+                            for r_idx, row in enumerate(data):
+                                for c_idx, cell_text in enumerate(row):
+                                    flat_idx = r_idx * n_cols + c_idx
+                                    cell_bbox = None
+                                    if flat_cells and flat_idx < len(flat_cells):
+                                        cx0, cy0, cx1, cy1 = flat_cells[flat_idx]
+                                        if cx0 is not None:
+                                            cell_bbox = BBox(
+                                                x=cx0 * scale, y=cy0 * scale,
+                                                w=(cx1 - cx0) * scale, h=(cy1 - cy0) * scale,
+                                                page_index=page_idx, coord_space=cs,
+                                            )
+                                    text = (cell_text or "").strip()
+                                    cells.append(TableCell(
+                                        row=r_idx, col=c_idx, text=text,
+                                        bbox=cell_bbox, multiline="\n" in text,
+                                    ))
+                            border_mode = (
+                                "ruled" if strategy_name == "lines"
+                                else "whitespace" if strategy_name == "text"
+                                else "mixed"
+                            )
+                            pairs.append((region, TableModel(
+                                region_id=region_id,
+                                n_rows=n_rows,
+                                n_cols=n_cols,
+                                cells=cells,
+                                border_mode=border_mode,
+                            )))
+                        break
+                results[page_idx] = pairs
+        return results
