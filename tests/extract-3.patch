+"""Public tool functions for skeleton-grouping candidate generation."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, TransactionFeatures
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import AppliedHints
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping.models import SkeletonGroupingToolResult
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping.SkeletonGroupingService import (
+    SkeletonGroupingService,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "SkeletonGroupingTools",
+    "SkeletonGroupingToolResult",
+    "run_emit_skeleton_candidates",
+]
+
+_default_tool = None
+
+
+def _tool() -> SkeletonGroupingTools:
+    global _default_tool
+    if _default_tool is None:
+        _default_tool = SkeletonGroupingTools()
+    return _default_tool
+
+
+class SkeletonGroupingTools(BaseTool[SkeletonGroupingToolResult]):
+    phase_name = "skeleton_grouping"
+
+    @LogFn
+    def _execute(
+        self,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        *,
+        applied_hints: AppliedHints | None = None,
+        config: AppConfig,
+        threshold: float | None = None,
+    ) -> SkeletonGroupingToolResult:
+        materialised = list(normalised)
+        detector = SkeletonGroupingService(config=config)
+        candidates = detector.emit_plausible_sets(
+            materialised,
+            features_by_id,
+            applied_hints=applied_hints,
+            threshold=threshold,
+        )
+        return SkeletonGroupingToolResult(candidates=candidates)
+
+    def build_input_summary(
+        self,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(normalised, (list, tuple)):
+            return {"credits": len(normalised)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: SkeletonGroupingToolResult,
+        normalised: Iterable[BankTransaction],
+        features_by_id: dict[str, TransactionFeatures],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {"candidates": len(result.candidates)}
+
+    def trace_output(self, result: SkeletonGroupingToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for c in result.candidates:
+            self._logger.trace(
+                "skeleton.candidate  id=%s  txns=%d  txn_ids=%s",
+                c.candidate_set_id,
+                len(c.transactions),
+                [t.transaction_id for t in c.transactions],
+            )
+
+
+@tool(
+    name="run_emit_skeleton_candidates",
+    description="Run emit skeleton candidates.",
+    category="banking.skeleton",
+    tags=["banking", "skeleton"],
+)
+def run_emit_skeleton_candidates(
+    normalised: Iterable[BankTransaction],
+    features_by_id: dict[str, TransactionFeatures],
+    *,
+    applied_hints: AppliedHints | None = None,
+    config: AppConfig,
+    threshold: float | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> SkeletonGroupingToolResult:
+    """Generate skeleton salary candidate sets from normalised transactions.
+
+    Args:
+        normalised: Normalised credit transactions to group.
+        features_by_id: Feature map keyed by transaction id.
+        applied_hints: Hints applied in earlier phases.
+        config: Application configuration for skeleton thresholds.
+        threshold: Optional skeleton edge threshold override.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with skeleton warnings.
+
+    Returns:
+        SkeletonGroupingToolResult with skeleton candidate sets.
+    """
+    return _tool().run(
+        normalised,
+        features_by_id,
+        audit=audit,
+        warnings=warnings,
+        applied_hints=applied_hints,
+        config=config,
+        threshold=threshold,
+    )
