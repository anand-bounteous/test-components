+"""Amount-first gift grouping with multi-candidate emission."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from datetime import date
+from decimal import Decimal
+from itertools import combinations
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+from nw_agcore_bank_transactions.pipeline.hints.matchers import GiftHintMatcher, meets_minimum
+from nw_agcore_bank_transactions.pipeline.hints.matchers.AmountMinimumMatcher import (
+    aggregate_meets_minimum,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models import GiftHints
+
+
+class GiftGroupingStrategy:
+    def __init__(self, hint_matcher: GiftHintMatcher | None = None) -> None:
+        self._hints = hint_matcher or GiftHintMatcher()
+
+    def generate_candidates(
+        self,
+        transactions: Sequence[BankTransaction],
+        hint_inputs: GiftHints,
+    ) -> list[HintGroupCandidate]:
+        self._hints.validate_amount_present(hint_inputs)
+        assert hint_inputs.amount is not None
+        hint_amount = hint_inputs.amount
+
+        expected = self._hints.resolve_expected_date(transactions, hint_inputs)
+        window_start, window_end = self._hints.resolve_date_window(
+            expected, hint_inputs, transactions
+        )
+
+        in_window = [t for t in transactions if window_start <= t.date <= window_end]
+
+        eligible: list[BankTransaction] = []
+        for txn in transactions:
+            in_win = window_start <= txn.date <= window_end
+            soft = self._hints.txn_soft_match(txn, hint_inputs)
+            if in_win and soft:
+                eligible.append(txn)
+            elif (
+                expected is None
+                and not in_win
+                and soft
+                and meets_minimum(txn.amount, hint_amount)
+            ):
+                eligible.append(txn)
+
+        if not eligible:
+            if in_window:
+                eligible = list(in_window)
+            else:
+                return []
+
+        multi_eligible = [t for t in eligible if window_start <= t.date <= window_end]
+
+        raw_groups: list[HintGroupCandidate] = []
+
+        for txn in eligible:
+            if meets_minimum(txn.amount, hint_amount):
+                raw_groups.append(
+                    self._make_group(
+                        txn,
+                        (txn,),
+                        expected,
+                        window_start,
+                        window_end,
+                        f"Single credit {txn.amount} >= hint {hint_amount}",
+                    )
+                )
+
+        if hint_inputs.allow_multi_transaction:
+            islands = self._cluster_islands(multi_eligible)
+            island_lists = list(islands) + [list(multi_eligible)]
+            seen_combo: set[frozenset[str]] = set()
+            for island in island_lists:
+                subset = self._best_multi_subset(island, hint_amount)
+                if subset is None or len(subset) <= 1:
+                    continue
+                ids = frozenset(t.id for t in subset)
+                if ids in seen_combo:
+                    continue
+                seen_combo.add(ids)
+                anchor = subset[0]
+                raw_groups.append(
+                    self._make_group(
+                        anchor,
+                        tuple(sorted(subset, key=lambda t: (t.date, t.id))),
+                        expected,
+                        window_start,
+                        window_end,
+                        f"Aggregated {len(subset)} partial credit(s) to meet minimum {hint_amount}",
+                    )
+                )
+
+        deduped = self._deduplicate(raw_groups)
+        return [
+            HintGroupCandidate(
+                candidate_set_id=f"gift_{idx:03d}",
+                transactions=g.transactions,
+                expected_date=g.expected_date,
+                reference_date=None,
+                window_start=g.window_start,
+                window_end=g.window_end,
+                aggregate_sum=g.aggregate_sum,
+                cluster_key=g.cluster_key,
+                reasoning=g.reasoning,
+                metadata=g.metadata,
+            )
+            for idx, g in enumerate(deduped)
+        ]
+
+    def _make_group(
+        self,
+        anchor: BankTransaction,
+        txns: tuple[BankTransaction, ...],
+        expected: date | None,
+        window_start: date,
+        window_end: date,
+        reason: str,
+    ) -> HintGroupCandidate:
+        total = sum((t.amount for t in txns), Decimal("0"))
+        return HintGroupCandidate(
+            candidate_set_id="",
+            transactions=txns,
+            expected_date=expected,
+            window_start=window_start,
+            window_end=window_end,
+            aggregate_sum=total,
+            cluster_key=self._hints.cluster_key(anchor),
+            reasoning=(reason,),
+        )
+
+    def _cluster_islands(self, eligible: Sequence[BankTransaction]) -> list[list[BankTransaction]]:
+        buckets: dict[str, list[BankTransaction]] = {}
+        for txn in eligible:
+            key = self._hints.cluster_key(txn)
+            buckets.setdefault(key, []).append(txn)
+        return list(buckets.values())
+
+    def _best_multi_subset(
+        self,
+        island: Sequence[BankTransaction],
+        hint_amount: Decimal,
+    ) -> list[BankTransaction] | None:
+        sorted_island = sorted(island, key=lambda t: (t.date, t.id))
+        best: list[BankTransaction] | None = None
+        best_score = (-1, 999)
+
+        max_subset = min(len(sorted_island), 8)
+        for size in range(2, max_subset + 1):
+            for combo in combinations(sorted_island, size):
+                total = sum((t.amount for t in combo), Decimal("0"))
+                if not aggregate_meets_minimum(total, hint_amount):
+                    continue
+                exact = 1 if total == hint_amount else 0
+                score = (exact, -len(combo))
+                if score > best_score:
+                    best_score = score
+                    best = list(combo)
+        return best
+
+    def _deduplicate(self, groups: Sequence[HintGroupCandidate]) -> list[HintGroupCandidate]:
+        if not groups:
+            return []
+        ordered = sorted(
+            groups,
+            key=lambda g: (
+                -int(
+                    g.aggregate_sum == g.transactions[0].amount if len(g.transactions) == 1 else 0
+                ),
+                len(g.transactions),
+                -float(g.aggregate_sum),
+            ),
+        )
+        kept: list[HintGroupCandidate] = []
+        seen_ids: set[frozenset[str]] = set()
+        for group in ordered:
+            ids = frozenset(t.id for t in group.transactions)
+            if ids in seen_ids:
+                continue
+            dominated = False
+            for existing in kept:
+                existing_ids = frozenset(t.id for t in existing.transactions)
+                if ids.issubset(existing_ids) and len(ids) < len(existing_ids):
+                    dominated = True
+                    break
+            if dominated:
+                continue
+            kept = [
+                g
+                for g in kept
+                if not (
+                    frozenset(t.id for t in g.transactions).issubset(ids)
+                    and len(g.transactions) > len(group.transactions)
+                )
+            ]
+            seen_ids.add(ids)
+            kept.append(group)
+        return kept
