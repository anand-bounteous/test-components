+"""Unit tests for alternate transaction date formats in validation."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.validation.BankTransactionValidationService import (
+    ValidationError,
+    _parse_date,
+)
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("2024-07-10", date(2024, 7, 10)),
+        ("2024/07/10", date(2024, 7, 10)),
+        ("2024_07_10", date(2024, 7, 10)),
+        ("10 Jul 2024", date(2024, 7, 10)),
+        ("Jul 10 2024", date(2024, 7, 10)),
+        ("  2024-07-10  ", date(2024, 7, 10)),
+    ],
+)
+def test_parse_date_accepts_recognised_formats(raw: str, expected: date) -> None:
+    assert _parse_date(raw) == expected
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "10/07/2024",
+        "07-10-2024",
+        "2024.07.10",
+        "not-a-date",
+        "",
+    ],
+)
+def test_parse_date_rejects_ambiguous_or_invalid(raw: str) -> None:
+    with pytest.raises(ValidationError, match="not a recognised date"):
+        _parse_date(raw)
+
+
+@pytest.mark.unit
+def test_parse_date_rejects_non_string() -> None:
+    with pytest.raises(ValidationError, match="must be a string"):
+        _parse_date(20240710)
