+    "native_pymupdf",
+    "img2table_doctr",
+    "doctr_baseline",
+]
+
+
+def _detect_pdf_kind(pdf_path: Path) -> str:
+    doc = fitz.open(str(pdf_path))
+    try:
+        for page in doc:
+            text = page.get_text().strip()
+            if text:
+                return "vector"
+        return "scanned"
+    finally:
+        doc.close()
+
+
+def _raster_pages_for_run(pdf_path: Path, run_dir: Path, *, dpi: int) -> list[RasterPage]:
+    raster_dir = run_dir / "raster" / "pages"
+    pages = run_rasterize_pdf(str(pdf_path), str(raster_dir), dpi=dpi)
+    for page in pages:
+        rel = Path(page.png_path).relative_to(run_dir)
+        page.png_path = str(run_dir / rel)
+    return pages
+
+
+def run_native_pymupdf(
+    pdf_path: Path,
+    *,
+    run_dir: Path,
+    raster_pages: list[RasterPage],
+    pdf_kind: str = "vector",
+    dpi: int = 300,
+) -> ExtractorResult:
+    audit = AuditRecorder()
+    extractor = PyMuPdfExtractor()
+    with audit.time("pymupdf_native", "pymupdf", inputs=[str(pdf_path)]):
+        text_regions = extractor.extract(str(pdf_path), dpi=dpi)
+        table_pairs = extractor.extract_tables(str(pdf_path), dpi=dpi)
+    tables_by_page: dict[int, list] = {}
+    table_regions_by_page: dict[int, list] = {}
+    for idx, pairs in table_pairs.items():
+        tables_by_page[idx] = [t for _, t in pairs]
+        table_regions_by_page[idx] = [r for r, _ in pairs]
+    pages = build_document_pages(
+        raster_pages,
+        pdf_kind=pdf_kind,  # type: ignore[arg-type]
+        regions_by_page=text_regions,
+        tables_by_page=tables_by_page,
+        table_regions_by_page=table_regions_by_page,
+    )
+    result = ExtractorResult(
+        extractor_name="native_pymupdf",
+        status="ok",
+        pages=pages,
+        audit=list(audit.steps),
+    )
+    timings_from_audit(result)
+    result.overall_confidence = overall_confidence_from_pages(pages)
+    write_extractor_outputs(
+        run_dir=run_dir,
+        solution_name="native_pymupdf",
+        artifact_stage="pymupdf_native",
+        result=result,
+    )
+    return result
+
+
+def run_native_pdfplumber(
+    pdf_path: Path,
+    *,
+    run_dir: Path,
+    raster_pages: list[RasterPage],
+    pdf_kind: str = "vector",
+    dpi: int = 300,
+) -> ExtractorResult:
+    audit = AuditRecorder()
+    extractor = PdfPlumberExtractor()
+    with audit.time("pdfplumber_native", "pdfplumber", inputs=[str(pdf_path)]):
+        text_regions = extractor.extract_text(str(pdf_path), dpi=dpi)
+        table_pairs = extractor.extract_tables_with_regions(str(pdf_path), dpi=dpi)
+    tables_by_page: dict[int, list] = {}
+    table_regions_by_page: dict[int, list] = {}
+    for idx, pairs in table_pairs.items():
+        tables_by_page[idx] = [t for _, t in pairs]
+        table_regions_by_page[idx] = [r for r, _ in pairs]
+    pages = build_document_pages(
+        raster_pages,
+        pdf_kind=pdf_kind,  # type: ignore[arg-type]
+        regions_by_page=text_regions,
+        tables_by_page=tables_by_page,
+        table_regions_by_page=table_regions_by_page,
+    )
+    result = ExtractorResult(
+        extractor_name="native_pdfplumber",
+        status="ok",
+        pages=pages,
+        audit=list(audit.steps),
+    )
+    timings_from_audit(result)
+    result.overall_confidence = overall_confidence_from_pages(pages)
+    write_extractor_outputs(
+        run_dir=run_dir,
+        solution_name="native_pdfplumber",
+        artifact_stage="pdfplumber_native",
+        result=result,
