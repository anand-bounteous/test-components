+"""Phase 1 — text normalisation, tokenisation, skeleton key."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import (
+    default_service,
+    normalize_bank_transaction,
+)
+
+_norm = default_service()
+normalise_text = _norm.normalise_text
+tokenise = _norm.tokenise
+skeleton_of = _norm.skeleton_of
+normalise_transaction = normalize_bank_transaction
+
+# --- normalise_text -------------------------------------------------------
+
+
+def test_uppercases_and_collapses_whitespace():
+    assert normalise_text("  Bacs   Credit  Acme Ltd  Payroll  ") == "BACS CREDIT ACME LTD PAYROLL"
+
+
+def test_punctuation_becomes_space():
+    assert normalise_text("ACME-LTD/PAYROLL.123") == "ACME LTD PAYROLL 123"
+
+
+def test_collapses_legal_suffix_limited_to_ltd():
+    assert normalise_text("ACME LIMITED PAYROLL") == "ACME LTD PAYROLL"
+
+
+def test_collapses_legal_suffix_public_limited_company_to_plc():
+    assert normalise_text("ACME PUBLIC LIMITED COMPANY PAYROLL") == "ACME PLC PAYROLL"
+
+
+def test_handles_unicode_accents_via_nfkd():
+    assert normalise_text("Café Société Ltd") == "CAFE SOCIETE LTD"
+
+
+def test_empty_input_returns_empty_string():
+    assert normalise_text("") == ""
+    assert normalise_text("   ") == ""
+
+
+def test_long_description_is_not_truncated():
+    raw = "BACS CREDIT " + ("X" * 500)
+    out = normalise_text(raw)
+    # Body preserved; only whitespace/case normalised.
+    assert out.startswith("BACS CREDIT ")
+    assert len(out) >= 500
+
+
+# --- tokenise -------------------------------------------------------------
+
+
+def test_tokenise_preserves_order():
+    assert tokenise("BACS ACME LTD PAYROLL") == ("BACS", "ACME", "LTD", "PAYROLL")
+
+
+def test_tokenise_empty_returns_empty_tuple():
+    assert tokenise("") == ()
+
+
+# --- skeleton_of -----------------------------------------------------------
+
+
+def test_skeleton_strips_long_numeric_references():
+    a = skeleton_of("BACS CREDIT ACME LTD PAYROLL 123456")
+    b = skeleton_of("BACS CREDIT ACME LTD PAYROLL 789101")
+    assert a == b
+    assert "123456" not in a
+
+
+def test_skeleton_strips_trailing_numeric_suffixes():
+    a = skeleton_of("FPI ACME LTD SALARY #0042")
+    b = skeleton_of("FPI ACME LTD SALARY #1188")
+    assert a == b
+
+
+def test_skeleton_keeps_short_numerics():
+    # 3-digit numeric should not be dropped — used as a guard against the
+    # rule being too aggressive.
+    out = skeleton_of("WAGE 12")
+    assert "12" in out
+
+
+def test_skeleton_distinguishes_limited_vs_salary_payroll_token():
+    # Same employer skeleton, different action token. Acceptable per Design:
+    # Phase 7 will merge via similarity, Phase 5 keeps them separate.
+    a = skeleton_of("BACS CREDIT ACME LIMITED SALARY")
+    b = skeleton_of("BACS CREDIT ACME LTD PAYROLL")
+    assert a != b
+
+
+def test_skeleton_is_idempotent():
+    raw = "BACS CREDIT ACME LTD PAYROLL 123456"
+    once = skeleton_of(raw)
+    twice = skeleton_of(once)
+    assert once == twice
+
+
+def test_skeleton_empty_returns_placeholder():
+    assert skeleton_of("") == "__EMPTY__"
+    assert skeleton_of("    ") == "__EMPTY__"
+    assert skeleton_of(None) == "__EMPTY__"
+
+
+def test_skeleton_drops_generic_glue_words():
+    out = skeleton_of("CREDIT PAYMENT REF ACME LTD")
+    for stop in ("CREDIT", "PAYMENT", "REF"):
+        assert stop not in out.split()
+
+
+# --- normalise_transaction (end-to-end on a RawBankTransaction) ---------------
+
+
+def _raw(**kw) -> RawBankTransaction:
+    base = dict(
+        id="t01",
+        date="2024-01-31",
+        description="BACS CREDIT ACME LTD PAYROLL 123456",
+        debit_amount=Decimal("0"),
+        credit_amount=Decimal("2450.32"),
+    )
+    base.update(kw)
+    return RawBankTransaction(**base)
+
+
+def test_normalise_transaction_attaches_skeleton_and_tokens():
+    nt = normalise_transaction(_raw())
+    assert nt.skeleton == "BACS ACME LTD PAYROLL"
+    assert "ACME" in nt.description_tokens
+    assert nt.raw_description == "BACS CREDIT ACME LTD PAYROLL 123456"
+
+
+def test_normalise_transaction_parses_date():
+    nt = normalise_transaction(_raw())
+    assert nt.date.isoformat() == "2024-01-31"
