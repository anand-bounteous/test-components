+"""Load salary-detector configuration and description signals."""
+
+from __future__ import annotations
+
+from importlib import resources
+from pathlib import Path
+from typing import Any
+
+import yaml
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models.DescriptionSignalConfig import (
+    DescriptionSignalConfig,
+)
+
+_CONFIG_PACKAGE = "nw_agbus_salary_extractor.services.config"
+
+
+def _load_yaml_resource(filename: str) -> dict[str, Any]:
+    raw = resources.files(_CONFIG_PACKAGE).joinpath(filename).read_text(encoding="utf-8")
+    return yaml.safe_load(raw) or {}
+
+
+def load_salary_keywords(config_path: Path | None = None) -> dict[str, Any]:
+    if config_path is None:
+        return _load_yaml_resource("salary_keywords.yaml")
+    return yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
+
+
+def load_salary_negative_keywords(config_path: Path | None = None) -> dict[str, Any]:
+    if config_path is None:
+        return _load_yaml_resource("negative_keywords.yaml")
+    return yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
+
+
+def salary_description_signals() -> DescriptionSignalConfig:
+    pos = load_salary_keywords().get("salary_hints") or {}
+    neg = load_salary_negative_keywords().get("negative_salary_signals") or {}
+    return DescriptionSignalConfig.from_tiered_mapping(pos, neg)
+
+
+def salary_config_overrides_for_app_config() -> dict[str, Any]:
+    """Merge salary keyword YAML into AppConfig for legacy accessors."""
+    return {
+        **load_salary_keywords(),
+        **load_salary_negative_keywords(),
+    }
+
+
+__all__ = [
+    "load_salary_keywords",
+    "load_salary_negative_keywords",
+    "salary_config_overrides_for_app_config",
+    "salary_description_signals",
+]
