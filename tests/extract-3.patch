+    manifest = run_benchmark_suite(_FIXTURE_PDF, output_root=_EVIDENCE_RUNS_DIR)
+    print(f"\nBenchmark run output: {manifest.run_dir}")
+    return manifest
+
+
+def _load_result(run_dir: Path, solution: str) -> ExtractorResult:
+    payload = json.loads((run_dir / solution / "result.json").read_text(encoding="utf-8"))
+    return ExtractorResult.model_validate(payload)
+
+
+def _load_audit(run_dir: Path, solution: str) -> dict:
+    return json.loads((run_dir / solution / "audit.json").read_text(encoding="utf-8"))
+
+
+class TestBenchmarkRunOutput:
+    def test_benchmark_run_manifest(self, benchmark_run: BenchmarkRunManifest):
+        run_dir = Path(benchmark_run.run_dir)
+        assert (run_dir / "run.json").exists()
+        assert benchmark_run.status == "done"
+        assert set(benchmark_run.completed) == set(SOLUTION_NAMES)
+        assert (run_dir / "document" / _FIXTURE_PDF.name).exists()
+        assert (run_dir / "raster" / "pages" / "page-000.png").exists()
+
+    def test_per_extractor_result_json(self, benchmark_run: BenchmarkRunManifest):
+        run_dir = Path(benchmark_run.run_dir)
+        for solution in SOLUTION_NAMES:
+            result = _load_result(run_dir, solution)
+            assert result.pages, f"{solution}: expected pages"
+            page = result.pages[0]
+            assert page.page_image_ref
+            assert result.audit
+            assert result.timings.total_ms > 0
+
+    def test_per_extractor_audit_json(self, benchmark_run: BenchmarkRunManifest):
+        run_dir = Path(benchmark_run.run_dir)
+        for solution in SOLUTION_NAMES:
+            audit_doc = _load_audit(run_dir, solution)
+            assert audit_doc["audit"], f"{solution}: expected audit steps"
+            assert audit_doc["timings"]["total_ms"] > 0
+            for step in audit_doc["audit"]:
+                assert step["duration_ms"] >= 0
+
+    def test_artifact_files(self, benchmark_run: BenchmarkRunManifest):
+        run_dir = Path(benchmark_run.run_dir)
+        native_artifacts = {
+            "native_pymupdf": "pymupdf_native/page-000.json",
+            "native_pdfplumber": "pdfplumber_native/page-000.json",
+        }
+        for solution, rel in native_artifacts.items():
+            assert (run_dir / solution / "artifacts" / rel).exists()
+
+        for solution, stage in [
+            ("doctr_baseline", "ocr_doctr"),
+            ("img2table_doctr", "tables_img2table_doctr"),
+        ]:
+            base = run_dir / solution / "artifacts" / stage
+            assert (base / "request.json").exists()
+            assert (base / "result.json").exists()
+
