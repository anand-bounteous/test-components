+"""Public tool functions for bank-transaction feature extraction."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from typing import Any
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    BankTransactionFeatureExtractionService,
+    FeatureExtractionValidationError,
+    default_service,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models import (
+    FeatureExtractionToolResult,
+)
+from nw_aglib_toolkit.channels.tools import BaseTool, tool
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+from nw_core.logging import TRACE, LogFn
+from nw_core.validation import ValidationWarning
+
+__all__ = [
+    "BankTransactionFeatureExtractionTools",
+    "FeatureExtractionToolResult",
+    "FeatureExtractionValidationError",
+    "extract_bank_transaction_features",
+    "extract_bank_transactions_features",
+    "run_extract_bank_transaction_features",
+]
+
+
+class BankTransactionFeatureExtractionTools(BaseTool[FeatureExtractionToolResult]):
+    phase_name = "feature_extraction"
+
+    @LogFn
+    def _execute(
+        self,
+        transactions: Iterable[BankTransaction],
+        *,
+        app_config: AppConfig,
+        calendar: WorkingDayCalendar,
+        region: str = "EnglandAndWales",
+        service: BankTransactionFeatureExtractionService | None = None,
+    ) -> FeatureExtractionToolResult:
+        materialised = list(transactions)
+        svc = service or default_service(app_config, calendar, region=region)
+        batch = svc.extract_bank_transactions(materialised)
+        return FeatureExtractionToolResult(
+            transactions=batch.transactions,
+            warnings=batch.warnings,
+        )
+
+    def build_input_summary(
+        self,
+        transactions: Iterable[BankTransaction],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(transactions, (list, tuple)):
+            return {"transactions": len(transactions)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: FeatureExtractionToolResult,
+        transactions: Iterable[BankTransaction],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        feature_count = sum(1 for txn in result.transactions if txn.features is not None)
+        return {
+            "features": feature_count,
+            "warnings": len(result.warnings),
+        }
+
+    def trace_output(self, result: FeatureExtractionToolResult) -> None:
+        if not self._logger.isEnabledFor(TRACE):
+            return
+        for txn in result.transactions:
+            features = txn.features
+            if features is None:
+                continue
+            self._logger.trace(
+                "feature_extraction.record  id=%s  channel=%s  tokens=%s  day_of_month=%s",
+                features.transaction_id,
+                features.payment_channel,
+                list(features.salary_hint_tokens)[:6],
+                features.day_of_month,
+            )
+
+
+_default_tool = BankTransactionFeatureExtractionTools()
+
+
+@tool(
+    name="run_extract_bank_transaction_features",
+    description="Run extract bank transaction features.",
+    category="banking.features",
+    tags=["banking", "features"],
+)
+def run_extract_bank_transaction_features(
+    transactions: Iterable[BankTransaction],
+    *,
+    app_config: AppConfig,
+    calendar: WorkingDayCalendar,
+    region: str = "EnglandAndWales",
+    description_signals=None,
+    service: BankTransactionFeatureExtractionService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> FeatureExtractionToolResult:
+    """Extract salary-detection features from normalised bank transactions.
+
+    Args:
+        transactions: Normalised credit transactions to analyse.
+        app_config: Application configuration for feature extraction rules.
+        calendar: Working-day calendar used for payday inference.
+        region: UK region code for bank-holiday handling.
+        service: Optional feature-extraction service override.
+        audit: Optional audit builder for per-phase trace capture.
+        warnings: Optional list extended with extraction warnings.
+
+    Returns:
+        FeatureExtractionToolResult with enriched transactions and feature map.
+    """
+    return _default_tool.run(
+        transactions,
+        audit=audit,
+        warnings=warnings,
+        app_config=app_config,
+        calendar=calendar,
+        region=region,
+        service=service
+        or default_service(
+            app_config,
+            calendar,
+            region=region,
+            description_signals=description_signals,
+        ),
+    )
+
+
+def extract_bank_transactions_features(
+    transactions: Iterable[BankTransaction],
+    *,
+    app_config: AppConfig,
+    calendar: WorkingDayCalendar,
+    region: str = "EnglandAndWales",
+    service: BankTransactionFeatureExtractionService | None = None,
+    audit=None,
+    warnings: list[ValidationWarning] | None = None,
+) -> tuple[BankTransaction, ...]:
+    """Extract features for an iterable of bank transactions."""
+    return run_extract_bank_transaction_features(
+        transactions,
+        app_config=app_config,
+        calendar=calendar,
+        region=region,
+        service=service,
+        audit=audit,
+        warnings=warnings,
+    ).transactions
+
+
+def extract_bank_transaction_features(
+    transaction: BankTransaction,
+    *,
+    app_config: AppConfig,
+    calendar: WorkingDayCalendar,
+    region: str = "EnglandAndWales",
+    service: BankTransactionFeatureExtractionService | None = None,
+) -> BankTransaction:
+    """Extract features for a single bank transaction."""
+    svc = service or default_service(app_config, calendar, region=region)
+    return svc.extract_bank_transaction(transaction).transaction
