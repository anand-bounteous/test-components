+"""Run detect from a raw YAML/JSON fixture dict (handles test-only JSON edge cases)."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from nw_agbus_salary_extractor.services.SalaryTransactionExtractorService import (
+    SalaryTransactionExtractorService,
+)
+from nw_agcore_bank_transactions.pipeline._models.results import BankTransactionResult
+from nw_agcore_bank_transactions.pipeline.validation.BankTransactionValidationService import (
+    TransactionsAbsence,
+)
+
+from tests.feature.support.PayloadIo import parse_payload
+
+
+def transactions_absence_from_raw(raw: Mapping[str, Any]) -> TransactionsAbsence | None:
+    """Return how the raw fixture omitted ``transactions`` (missing key vs null)."""
+    if "transactions" not in raw:
+        return "missing"
+    if raw.get("transactions") is None:
+        return "null"
+    return None
+
+
+def detect_from_fixture(
+    raw: Mapping[str, Any],
+    *,
+    include_audit: bool = False,
+    **kwargs: Any,
+) -> BankTransactionResult:
+    """Parse a fixture dict and run the full detector pipeline."""
+    payload = parse_payload(raw)
+    return SalaryTransactionExtractorService().detect(
+        payload,
+        include_audit=include_audit,
+        transactions_absence=transactions_absence_from_raw(raw),
+        **kwargs,
+    )
+
+
+__all__ = ["detect_from_fixture", "transactions_absence_from_raw"]
