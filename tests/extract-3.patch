+    captured: list[str] = []
+
+    def fake_register_tools_from_package(package_name: str):
+        captured.append(package_name)
+
+        def register_tools(_registry: ChannelToolRegistry) -> None:
+            return None
+
+        return register_tools
+
+    monkeypatch.setattr(
+        registry_helpers,
+        "register_tools_from_package",
+        fake_register_tools_from_package,
+    )
+
+    registry = build_agent_channel_registry(
+        rest_router=router,
+        tools_package="example.package.tools",
+    )
+
+    assert [module.name for module in registry.modules] == ["rest", "tools"]
+    assert captured == ["example.package.tools"]
