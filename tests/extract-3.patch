+"""REST route for amount/date fallback."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from nw_agcore_bank_transactions.channels.rest.ApiModels import AmountDateFallbackRequest
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import (
+    bank_transactions_from_wire,
+    features_by_id_from_wire,
+)
+from nw_agcore_bank_transactions.channels.rest.BaseToolRoute import BaseToolRoute
+from nw_agcore_bank_transactions.channels.rest.RouteHelpers import (
+    build_audit,
+    build_context,
+    error_response,
+    success_response,
+)
+
+from ..AmountDateFallbackTools import run_amount_date_fallback
+
+
+class AmountDateFallbackRoute(BaseToolRoute):
+    tool_name = "run_amount_date_fallback"
+    path = "/scoring/amount-date-fallback"
+    tags = ("scoring",)
+    summary = "Generate fallback candidates from unaccounted credits."
+    openapi_filename = "run_amount_date_fallback.openapi.yaml"
+
+    def register(self, router: APIRouter) -> None:
+        @router.post(self.path, tags=list(self.tags), summary=self.summary)
+        def amount_date_fallback(body: AmountDateFallbackRequest):
+            try:
+                ctx = build_context(body)
+                audit = build_audit(body)
+                result = run_amount_date_fallback(
+                    bank_transactions_from_wire(body.unaccounted),
+                    ctx.calendar,
+                    features_by_id_from_wire(body.features_by_id),
+                    config=ctx.config,
+                    region=ctx.region,
+                    audit=audit,
+                )
+                return success_response(result)
+            except Exception as exc:
+                return error_response(exc, tool_name=self.tool_name)
