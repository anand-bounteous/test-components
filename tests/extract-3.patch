+
+## Quick start
+
+From the monorepo root:
+
+```bash
+uv sync --all-packages
+```
+
+Minimal usage:
+
+```python
+from pathlib import Path
+from nw_core.channels.ChannelDeployment import ChannelBootstrap, DeploymentManifest
+from nw_core.channels.ChannelModules import ChannelRegistry, RestChannelModule
+from nw_core.config.ComponentSettings import load_settings
+from nw_core.logging import setup_trace, get_logger
+
+setup_trace()
+logger = get_logger(__name__)
+
+manifest = DeploymentManifest.load(Path("config/deployment.yaml"))
+registry = ChannelRegistry()
+# registry.add(RestChannelModule(router))
+runtime = ChannelBootstrap.build(manifest, registry)
+
+settings = load_settings(Path("."))
+```
+
