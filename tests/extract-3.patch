+"""Scoring profile protocol and shared types."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any, Protocol
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    BankTransaction,
+    CandidateSet,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.hint_grouping.GroupCandidate import HintGroupCandidate
+
+
+class RecurrenceScoringProfile(Protocol):
+    def score_pool(
+        self,
+        pool: Sequence[CandidateSet],
+        *,
+        normalised: Sequence[BankTransaction],
+        features_by_id: Mapping[str, TransactionFeatures],
+        calendar: WorkingDayCalendar,
+        config: AppConfig,
+        hint_inputs: Any,
+        applied_hints: Any,
+        weights: Mapping[str, float],
+        thresholds: Mapping[str, Any],
+        candidate_generation: Mapping[str, Any],
+        positive_keywords: Sequence[str],
+        negative_keywords: Sequence[str],
+        hint_matcher: Any,
+    ) -> list[CandidateSet]: ...
+
+
+class HintAmountScoringProfile(Protocol):
+    def score_groups(
+        self,
+        groups: Sequence[HintGroupCandidate],
+        *,
+        hint_inputs: Any,
+        features_by_id: Mapping[str, TransactionFeatures],
+        applied_hints: Any | None = None,
+        weights: Mapping[str, float],
+        thresholds: Mapping[str, Any],
+        hint_cfg: Mapping[str, Any],
+        positive_keywords: Sequence[str],
+        negative_keywords: Sequence[str],
+        hint_matcher: Any,
+    ) -> list[CandidateSet]: ...
