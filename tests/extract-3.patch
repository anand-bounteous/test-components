+"""Centralised hint input parsing and legacy key normalisation."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from decimal import Decimal
+from typing import Any
+
+from .models import (
+    EmployerHints,
+    GiftHints,
+    HintInputs,
+    PayslipHint,
+    PropertySaleHints,
+    RentHints,
+    RentPropertyHint,
+    SalaryHints,
+)
+from .models.HintConfig import load_hint_config
+
+_LEGACY_HINT_KEYS = ("gift_hints", "sale_hints", "rent_hints")
+
+
+def normalize_hint_inputs_payload(body: Mapping[str, Any]) -> Mapping[str, Any]:
+    """Accept canonical ``hint_inputs`` wrapper or legacy root-level hint keys."""
+    if "hint_inputs" in body and isinstance(body["hint_inputs"], Mapping):
+        return body["hint_inputs"]
+
+    nested: dict[str, Any] = {}
+    for key in (
+        "payslip_hints",
+        "salary_hints",
+        "employer_hints",
+        "gift_hints",
+        "sale_hints",
+        "rent_hints",
+        "property_sale_hints",
+    ):
+        if key in body:
+            nested[key] = body[key]
+
+    if nested:
+        return nested
+
+    return body
+
+
+def _decimal_or_none(value: Any) -> Decimal | None:
+    if value is None:
+        return None
+    return Decimal(str(value))
+
+
+def _gift_hints_from_mapping(data: Mapping[str, Any] | None) -> GiftHints | None:
+    if not data:
+        return None
+    tolerance = data.get("tolerance_days")
+    return GiftHints(
+        amount=_decimal_or_none(data.get("amount")),
+        expected_date=data.get("expected_date"),
+        tolerance_days=int(tolerance) if tolerance is not None else None,
+        donor_name=data.get("donor_name"),
+        allow_multi_transaction=bool(data.get("allow_multi_transaction", True)),
+    )
+
+
+def _rent_property_from_mapping(data: Mapping[str, Any]) -> RentPropertyHint:
+    tolerance = data.get("tolerance_pct")
+    target_day = data.get("target_day_of_month")
+    tol_days = data.get("tolerance_days")
+    return RentPropertyHint(
+        property_id=str(data.get("property_id", "")),
+        amount=_decimal_or_none(data.get("amount")),
+        tolerance_pct=float(tolerance) if tolerance is not None else None,
+        rentee_name=data.get("rentee_name"),
+        property_ref=data.get("property_ref"),
+        location=data.get("location"),
+        postcode=data.get("postcode"),
+        target_day_of_month=int(target_day) if target_day is not None else None,
+        tolerance_days=int(tol_days) if tol_days is not None else None,
+    )
+
+
+def _rent_hints_from_mapping(data: Mapping[str, Any] | None) -> RentHints | None:
+    if not data:
+        return None
+    properties = tuple(
+        _rent_property_from_mapping(entry)
+        for entry in data.get("properties", [])
+        if isinstance(entry, Mapping)
+    )
+    return RentHints(
+        amount=_decimal_or_none(data.get("amount")),
+        tolerance_pct=float(data.get("tolerance_pct", 0.0)),
+        rentee_name=data.get("rentee_name"),
+        property_ref=data.get("property_ref"),
+        location=data.get("location"),
+        postcode=data.get("postcode"),
+        target_day_of_month=int(data.get("target_day_of_month", 1)),
+        tolerance_days=int(data.get("tolerance_days", 7)),
+        properties=properties,
+    )
+
+
+def _property_sale_hints_from_mapping(data: Mapping[str, Any] | None) -> PropertySaleHints | None:
+    if not data:
+        return None
+    tolerance = data.get("tolerance_pct")
+    return PropertySaleHints(
+        amount=_decimal_or_none(data.get("amount")),
+        tolerance_pct=float(tolerance) if tolerance is not None else None,
+        timeline_hint=data.get("timeline_hint"),
+        reference_date=data.get("reference_date"),
+        sale_date=data.get("sale_date"),
+        buyer_name=data.get("buyer_name"),
+        property_ref=data.get("property_ref"),
+        location=data.get("location"),
+        postcode=data.get("postcode"),
+    )
+
+
+def hint_inputs_from_mapping(payload: Mapping[str, Any] | None) -> HintInputs:
+    if not payload:
+        return HintInputs()
+    cfg = load_hint_config()
+    payslip_hints = tuple(
+        PayslipHint(
+            month=entry["month"],
+            amount=Decimal(str(entry["amount"])),
+            hint_id=str(entry.get("hint_id", "")),
+        )
+        for entry in payload.get("payslip_hints", [])
+    )
+    salary_dict = payload.get("salary_hints")
+    salary_hints = (
+        SalaryHints(
+            approx_monthly=Decimal(str(salary_dict["approx_monthly"]))
+            if salary_dict.get("approx_monthly") is not None
+            else None,
+            approx_yearly=Decimal(str(salary_dict["approx_yearly"]))
+            if salary_dict.get("approx_yearly") is not None
+            else None,
+            tolerance_pct=float(salary_dict.get("tolerance_pct", cfg.default_tolerance_pct)),
+        )
+        if salary_dict is not None
+        else None
+    )
+    employer_dict = payload.get("employer_hints")
+    employer_hints = (
+        EmployerHints(
+            current_employer=str(employer_dict["current_employer"]),
+            previous_employer=employer_dict.get("previous_employer"),
+        )
+        if employer_dict is not None and employer_dict.get("current_employer")
+        else None
+    )
+    gift_data = payload.get("gift_hints")
+    rent_data = payload.get("rent_hints")
+    sale_data = payload.get("property_sale_hints") or payload.get("sale_hints")
+    return HintInputs(
+        payslip_hints=payslip_hints,
+        salary_hints=salary_hints,
+        employer_hints=employer_hints,
+        gift_hints=_gift_hints_from_mapping(gift_data),
+        rent_hints=_rent_hints_from_mapping(rent_data),
+        property_sale_hints=_property_sale_hints_from_mapping(sale_data),
+    )
+
+
+__all__ = ["hint_inputs_from_mapping", "normalize_hint_inputs_payload"]
