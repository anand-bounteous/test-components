+        confidence_log_prefix("rent_keyword_score")
+        == "[confidence_calculation][rent_keyword_score]"
+    )
+
+
+def test_accumulator_emits_trace_prefix(caplog):
+    caplog.set_level(TRACE)
+    accum = ConfidenceAccumulator(candidate_id="rent_cs_0")
+    accum.apply_delta(
+        stage="rent_keyword_score",
+        amount=0.08,
+        max_value=0.10,
+        reasoning="Rent keyword match",
