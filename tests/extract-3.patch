+"""Phase 6 — periodic models (weekly / fortnightly / four-weekly)."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._services.recurrence import (
+    PaydayModel,
+    fit_best_recurrence_model,
+)
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_core.calendar import WorkingDayCalendar
+
+
+@pytest.fixture(scope="module")
+def cal():
+    return WorkingDayCalendar()
+
+
+def _txn(tid, d):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=d.isoformat(),
+            description="FPS WAGE ACME",
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal("615"),
+        )
+    )
+
+
+def _periodic(start: date, period: int, count: int):
+    return [_txn(f"t{i}", start + timedelta(days=period * i)) for i in range(count)]
+
+
+def test_weekly_perfect_friday_series(cal):
+    txns = _periodic(date(2024, 1, 5), 7, 26)  # 26 Fridays
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.WEEKLY_SAME_WEEKDAY
+    assert fit.fit_score >= 0.95
+    assert fit.period_days == 7
+    assert fit.weekday == 4  # Friday
+
+
+def test_fortnightly_series(cal):
+    txns = _periodic(date(2024, 1, 12), 14, 13)
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.FORTNIGHTLY_SAME_WEEKDAY
+    assert fit.period_days == 14
+
+
+def test_four_weekly_series(cal):
+    txns = _periodic(date(2024, 1, 5), 28, 8)
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model == PaydayModel.FOUR_WEEKLY
+    assert fit.period_days == 28
+
+
+def test_weekly_tolerates_one_holiday_shift(cal):
+    """Substitute one credit by ±2 days to simulate a holiday shift —
+    weekly_same_weekday should still win."""
+    base = _periodic(date(2024, 1, 5), 7, 26)
+    # Shift the 15th credit by 2 days.
+    base[15] = _txn("t15s", base[15].date + timedelta(days=2))
+    fit = fit_best_recurrence_model(base, calendar=cal)
+    assert fit.model == PaydayModel.WEEKLY_SAME_WEEKDAY
+
+
+def test_periodic_loses_to_monthly_when_gaps_are_monthly(cal):
+    """A monthly series should not be picked up as four-weekly — the
+    average gap (~30 days) is too far from 28 once cumulative drift adds
+    up over 12 months."""
+    dates = [cal.last_working_day_of_month(2024, m, "EnglandAndWales") for m in range(1, 13)]
+    txns = [_txn(f"t{i}", d) for i, d in enumerate(dates)]
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    assert fit.model not in {
+        PaydayModel.WEEKLY_SAME_WEEKDAY,
+        PaydayModel.FORTNIGHTLY_SAME_WEEKDAY,
+        PaydayModel.FOUR_WEEKLY,
+    }
+
+
+def test_two_credit_periodic_is_below_threshold_score(cal):
+    txns = _periodic(date(2024, 1, 5), 7, 2)
+    fit = fit_best_recurrence_model(txns, calendar=cal)
+    # Two credits give a gap that fits weekly perfectly, but the irregular
+    # fallback would never beat it. Just confirm score isn't absurdly low.
+    assert fit.fit_score >= 0.5
