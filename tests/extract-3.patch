+"""Shared helpers for business-agent Detect* gRPC handlers."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any, TypeVar
+
+from google.protobuf.message import Message
+from nw_agcore_bank_transactions.channels.rest.ApiSerialization import to_api_json
+from nw_aglib_toolkit.channels.rest.RouteContext import RouteContext
+from nw_core.grpc.ProtoJson import dict_to_message, message_to_dict
+
+RequestT = TypeVar("RequestT")
+ResultT = TypeVar("ResultT")
+ResponseT = TypeVar("ResponseT", bound=Message)
+ResultMessageT = TypeVar("ResultMessageT", bound=Message)
+
+
+def detect_request_dict(request: Message) -> dict[str, Any]:
+    return message_to_dict(request)
+
+
+def detect_kwargs_from_request(data: dict[str, Any]) -> dict[str, Any]:
+    ctx = RouteContext.from_request(
+        config_overrides=data.get("config_overrides"),
+        source_bank=data.get("source_bank"),
+        region=data.get("region"),
+    )
+    return {
+        "config": ctx.config,
+        "calendar": ctx.calendar,
+        "mode": data.get("validation_mode"),
+        "max_candidates": data.get("max_candidates"),
+        "max_near_misses": data.get("max_near_misses"),
+        "return_threshold": data.get("return_threshold"),
+        "include_audit": bool(data.get("include_audit", False)),
+    }
+
+
+def build_tool_error_response[ResponseT: Message](
+    response: ResponseT,
+    *,
+    exc: Exception,
+    tool_name: str,
+) -> ResponseT:
+    response.ok = False
+    error = response.error
+    error.ok = False
+    error.error.code = "VALIDATION_ERROR" if isinstance(exc, ValueError) else "INTERNAL_ERROR"
+    error.error.message = str(exc) or exc.__class__.__name__
+    error.error.tool = tool_name
+    return response
+
+
+def build_tool_success_response[ResponseT: Message, ResultMessageT: Message](
+    response: ResponseT,
+    result: Any,
+    *,
+    result_message: ResultMessageT,
+) -> ResponseT:
+    response.ok = True
+    dict_to_message(to_api_json(result), result_message)
+    response.result.CopyFrom(result_message)
+    return response
+
+
+def run_detect_handler[RequestT, ResultT, ResponseT: Message, ResultMessageT: Message](
+    request: Message,
+    *,
+    tool_name: str,
+    parse_request: Callable[[dict[str, Any]], RequestT],
+    detect: Callable[..., ResultT],
+    response_factory: Callable[[], ResponseT],
+    result_message_factory: Callable[[], ResultMessageT],
+) -> Message:
+    response = response_factory()
+    data = detect_request_dict(request)
+    try:
+        payload = parse_request(data)
+        result = detect(payload, **detect_kwargs_from_request(data))
+        return build_tool_success_response(
+            response,
+            result,
+            result_message=result_message_factory(),
+        )
+    except Exception as exc:
+        return build_tool_error_response(response, exc=exc, tool_name=tool_name)
