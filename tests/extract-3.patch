+import pytest
+from nw_agbus_gift_extractor.channels.grpc.Converters import gift_request_from_proto
+from nw_agbus_gift_extractor.channels.grpc.generated.nw.gift.v1 import gift_extractor_pb2
+from nw_agbus_gift_extractor.channels.tools.GiftTransactionExtractorTools import (
+    detect_gift_candidates,
+)
+from nw_aglib_toolkit.channels.grpc.DetectRpc import detect_request_dict, run_detect_handler
+from nw_core.channels.grpc.generated.nw.bank_transactions.v1 import hints_pb2, results_pb2
+
+
+@pytest.mark.unit
+def test_gift_request_from_proto_parses_transactions():
+    request = gift_extractor_pb2.DetectGiftCandidatesRequest(
+        analysis_id="grpc_unit",
+        jurisdiction="GB",
+        validation_mode="lenient",
+        hint_inputs=hints_pb2.HintInputs(
+            gift_hints=hints_pb2.GiftHintInputs(amount="500"),
+        ),
+    )
+    request.transactions.add(
+        id="t1",
+        date="2024-01-01",
+        description="GIFT FROM MUM",
+        credit_amount="500",
+    )
+    payload = gift_request_from_proto(detect_request_dict(request))
+    assert payload.analysis_id == "grpc_unit"
+    assert len(payload.transactions) == 1
+    assert payload.hint_inputs.gift_hints is not None
+    assert payload.hint_inputs.gift_hints.amount is not None
+
+
+@pytest.mark.unit
+def test_run_detect_handler_empty_transactions():
+    request = gift_extractor_pb2.DetectGiftCandidatesRequest(
+        analysis_id="grpc_unit",
+        jurisdiction="GB",
+        validation_mode="lenient",
+        hint_inputs=hints_pb2.HintInputs(
+            gift_hints=hints_pb2.GiftHintInputs(amount="100"),
+        ),
+    )
+    response = run_detect_handler(
+        request,
+        tool_name="detect_gift_candidates",
+        parse_request=gift_request_from_proto,
+        detect=detect_gift_candidates,
+        response_factory=gift_extractor_pb2.DetectGiftCandidatesResponse,
+        result_message_factory=results_pb2.BankTransactionResult,
+    )
