+"""pytest plugin for the feature scenario test module."""
+
+from __future__ import annotations
+
+import fnmatch
+from pathlib import Path
+
+import pytest
+import yaml
+
+from tests.feature.support.ScenarioDiscovery import (
+    ScenarioRef,
+    discover_scenarios,
+    list_modules,
+    resolve_scenario_path,
+)
+
+_HELP_TEXT = """\
+Feature scenario test module (tests/feature/)
+=============================================
+One YAML file per module directory = one independent test case.
+Evidence JSON is written to .plan/reviews/feature-outputs/{module}/{stem}.json.
+
+Modules (default: all)
+----------------------
+  {modules}
+
+Flags
+-----
+  --module=NAME               Run only scenarios for module (repeat for OR)
+  --rw-fixture=GLOB           Run fixtures whose stem matches GLOB (repeat = OR)
+  --rw-tag=TAG                Run fixtures carrying TAG in scenario_tags (repeat = AND)
+  --rw-list                   List all discovered fixtures, then exit
+
+Standalone runner
+-----------------
+  python -m tests.feature.Runner --help
+  python -m tests.feature.Runner --module employment
+  python -m tests.feature.Runner --module rent Rent_001_*
+"""
+
+
+def pytest_addoption(parser):
+    group = parser.getgroup("feature", "Feature scenario tests")
+    group.addoption(
+        "--rw-help",
+        action="store_true",
+        default=False,
+        help="Show feature scenario test help and exit.",
+    )
+    group.addoption(
+        "--module",
+        action="append",
+        default=[],
+        metavar="NAME",
+        help=(
+            "Run only scenarios for module "
+            "(e.g. employment, rent, gift, property_sale). Repeat for OR."
+        ),
+    )
+    group.addoption(
+        "--rw-fixture",
+        action="append",
+        default=[],
+        metavar="GLOB",
+        help="Run only fixtures whose stem matches GLOB (repeat = OR).",
+    )
+    group.addoption(
+        "--rw-tag",
+        action="append",
+        default=[],
+        metavar="TAG",
+        help="Run only fixtures that carry TAG in scenario_tags (repeat = AND).",
+    )
+    group.addoption(
+        "--rw-list",
+        action="store_true",
+        default=False,
+        help="List all discovered feature scenario fixtures, then exit.",
+    )
+
+
+def pytest_configure(config):
+    config.addinivalue_line(
+        "markers",
+        "feature: end-to-end scenario fixture test (one YAML file = one test)",
+    )
+    config.addinivalue_line(
+        "markers",
+        "realworld: deprecated alias for feature (employment salary scenarios)",
+    )
+    if config.getoption("--rw-help", default=False):
+        modules = ", ".join(list_modules()) or "(none found)"
+        print(_HELP_TEXT.format(modules=modules))
+        pytest.exit("", returncode=0)
+    if config.getoption("--rw-list", default=False):
+        refs = _filtered_scenarios(config)
+        if not refs:
+            print("\nNo feature scenario fixtures found.")
+        else:
+            print(f"\nFeature scenario fixtures ({len(refs)} total):")
+            for ref in refs:
+                try:
+                    data = yaml.safe_load(ref.path.read_text(encoding="utf-8")) or {}
+                    desc = data.get("scenario_description", "(no description)")
+                    tags = data.get("scenario_tags", [])
+                except Exception:
+                    desc = "(unreadable)"
+                    tags = []
+                print(f"  {ref.parametrize_id:50s}  {', '.join(tags) or '(no tags)':30s}  {desc}")
+        pytest.exit("", returncode=0)
+
+
+def _load_scenario(path: Path) -> dict:
+    return yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+
+
+def _filtered_scenarios(config) -> list[ScenarioRef]:
+    modules: list[str] | None = config.getoption("--module", default=[]) or None
+    refs = discover_scenarios(modules=modules)
+
+    fixture_globs: list[str] = config.getoption("--rw-fixture", default=[])
+    required_tags: list[str] = config.getoption("--rw-tag", default=[])
+
+    result: list[ScenarioRef] = []
+    for ref in refs:
+        if fixture_globs and not any(fnmatch.fnmatch(ref.scenario_id, g) for g in fixture_globs):
+            continue
+        if required_tags:
+            try:
+                tags = set(_load_scenario(ref.path).get("scenario_tags", []))
+            except Exception:
+                tags = set()
+            if not all(t in tags for t in required_tags):
+                continue
+        result.append(ref)
+    return result
+
+
+def pytest_generate_tests(metafunc):
+    if "scenario_ref" in metafunc.fixturenames:
+        refs = _filtered_scenarios(metafunc.config)
+        metafunc.parametrize(
+            "scenario_ref",
+            refs,
+            ids=[ref.parametrize_id for ref in refs],
+        )
+
+
+_FEATURE_MODULE = "ScenariosTest"
+
+
+def _scenario_description(nodeid: str) -> str:
+    bracket = nodeid.find("[")
+    if bracket == -1:
+        return nodeid
+    return nodeid[bracket + 1 : nodeid.rfind("]")]
+
+
+def pytest_terminal_summary(terminalreporter, exitstatus, config):  # noqa: ARG001
+    stats = terminalreporter.stats
+
+    passed_reports = [r for r in stats.get("passed", []) if _FEATURE_MODULE in r.nodeid]
+    failed_reports = [r for r in stats.get("failed", []) if _FEATURE_MODULE in r.nodeid]
+    error_reports = [r for r in stats.get("error", []) if _FEATURE_MODULE in r.nodeid]
+
+    total = len(passed_reports) + len(failed_reports) + len(error_reports)
+    if total == 0:
+        return
+
+    sep = "─" * 70
+    thick = "═" * 70
+    tw = terminalreporter
+
+    tw.write_sep("=", "feature scenario summary", bold=True)
+
+    def _lookup_desc(param_id: str) -> str:
+        module, _, stem = param_id.partition("/")
+        module = module.removesuffix("_stress")
+        try:
+            path = resolve_scenario_path(module, stem)
+            if path is None:
+                return ""
+            data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+            return str(data.get("scenario_description", ""))[:60]
+        except Exception:
+            return ""
+
+    tw.write_line(
+        f"\n── PASSED ({len(passed_reports)}) {sep[: max(0, 52 - len(str(len(passed_reports))))]}"
+    )
+    for r in passed_reports:
+        param_id = _scenario_description(r.nodeid)
+        tw.write_line(f"  {param_id:<50s}  {_lookup_desc(param_id)}")
+
+    tw.write_line(
+        f"\n── FAILED ({len(failed_reports)}) {sep[: max(0, 52 - len(str(len(failed_reports))))]}"
+    )
+    for r in failed_reports:
+        param_id = _scenario_description(r.nodeid)
+        tw.write_line(f"  {param_id:<50s}  {_lookup_desc(param_id)}", red=True)
+        detail = ""
+        if r.longrepr:
+            for line in str(r.longrepr).splitlines():
+                line = line.strip()
+                if line and not line.startswith("E   AssertionError"):
+                    detail = line.lstrip("E").strip()
+                    break
+            if not detail:
+                detail = str(r.longrepr).splitlines()[-1].strip()
+        if detail:
+            tw.write_line(f"  {' ' * 52}↳ {detail[:80]}", red=True)
+
+    if error_reports:
+        tw.write_line(
+            f"\n── ERRORS ({len(error_reports)}) {sep[: max(0, 51 - len(str(len(error_reports))))]}"
+        )
+        for r in error_reports:
+            tw.write_line(f"  {_scenario_description(r.nodeid)}", yellow=True)
+
+    tw.write_line(f"\n{thick}")
+    parts = [f"{len(passed_reports)} passed"]
+    if failed_reports:
+        parts.append(f"{len(failed_reports)} failed")
+    if error_reports:
+        parts.append(f"{len(error_reports)} error{'s' if len(error_reports) != 1 else ''}")
+    parts.append(f"{total} total")
+    tw.write_line("  " + ",  ".join(parts))
+    tw.write_line(thick + "\n")
