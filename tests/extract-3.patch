+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import yaml
+from nw_aglib_toolkit.channels.AgentChannelRuntime import AgentChannelRuntime
+from nw_core.channels.ChannelModules import ChannelRegistry
+from nw_core.channels.ChannelDeployment import (
+    DeploymentManifest,
+    EmbeddedCoreChannels,
+    EmbeddedCoreComposer,
+)
+from nw_core.channels.rest.RestFactory import create_fastapi_app
+
+
+@dataclass
+class AgentEmbeddedCoreChannels(EmbeddedCoreChannels):
+    tools: str = "merge"
+
+
+@dataclass
+class AgentEmbeddedCoreConfig:
+    use: str = "in_process"
+    channels: AgentEmbeddedCoreChannels = field(default_factory=AgentEmbeddedCoreChannels)
+
+
+@dataclass
+class AgentDeploymentManifest(DeploymentManifest):
+    embedded_core: dict[str, AgentEmbeddedCoreConfig] = field(default_factory=dict)
+
+    @classmethod
+    def load(cls, path: Path) -> AgentDeploymentManifest:
+        data = yaml.safe_load(path.read_text()) or {}
+        embedded: dict[str, AgentEmbeddedCoreConfig] = {}
+        for name, cfg in (data.get("embedded_core") or {}).items():
+            channels_raw = cfg.get("channels") or {}
+            embedded[name] = AgentEmbeddedCoreConfig(
+                use=cfg.get("use", "in_process"),
+                channels=AgentEmbeddedCoreChannels(
+                    rest=channels_raw.get("rest", "suppress"),
+                    grpc=channels_raw.get("grpc", "suppress"),
+                    mq=channels_raw.get("mq", "suppress"),
+                    tools=channels_raw.get("tools", "merge"),
+                ),
+            )
+        return cls(
+            unit=data.get("unit", "unknown"),
+            mode=data.get("mode", "standalone"),
+            channels=data.get("channels") or {},
+            embedded_core=embedded,
+        )
+
+
+class AgentChannelBootstrap:
+    """Assemble agent runtime with tool registry support."""
+
+    @staticmethod
+    def build(
+        manifest: DeploymentManifest,
+        registry: ChannelRegistry,
+        *,
+        title: str = "NW Agent",
+    ) -> AgentChannelRuntime:
+        runtime = AgentChannelRuntime()
+        runtime.metadata["rest_prefix"] = manifest.channel_prefix("rest", "")
+
+        needs_rest = any(m.is_enabled(manifest) and m.name == "rest" for m in registry.modules)
+        if needs_rest:
+            runtime.app = create_fastapi_app(title=title)
+
+        for module in registry.modules:
+            if module.is_enabled(manifest):
+                module.mount(runtime)
+
+        return runtime
+
+
+class AgentEmbeddedCoreComposer:
+    """Apply embedded core suppress/passthrough/merge rules for business agents."""
+
+    @staticmethod
+    def apply_passthrough(
+        manifest: AgentDeploymentManifest,
+        parent_registry: ChannelRegistry,
+        core_name: str,
+        core_registry: ChannelRegistry,
+        *,
+        passthrough_prefix: str | None = None,
+    ) -> None:
+        EmbeddedCoreComposer.apply_passthrough(
+            manifest,
+            parent_registry,
+            core_name,
+            core_registry,
+            passthrough_prefix=passthrough_prefix,
+        )
+        cfg = manifest.embedded_core.get(core_name)
+        if cfg is None:
+            return
+        if cfg.channels.tools == "merge":
+            for module in core_registry.modules:
+                if module.name == "tools":
+                    parent_registry.add(module)
