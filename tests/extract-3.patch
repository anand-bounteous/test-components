+class EmploymentTransitionTools(BaseTool[EmploymentTransitionToolResult]):
+    phase_name = "employment_transition"
+
+    @LogFn
+    def _execute(
+        self,
+        scored: Iterable[CandidateSet],
+        *,
+        config: AppConfig,
+    ) -> EmploymentTransitionToolResult:
+        materialised = list(scored)
+        linked, transition_warnings = link_employment_transitions(materialised, config)
+        linked = override_split_subcandidate_types(linked)
+        if self._logger.isEnabledFor(TRACE):
+            for w in transition_warnings:
+                self._logger.trace("employment_transition.warning  %s", w.detail)
+        return EmploymentTransitionToolResult(
+            scored=tuple(linked),
+            warnings=tuple(transition_warnings),
+        )
+
+    def build_input_summary(
+        self,
+        scored: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        if isinstance(scored, (list, tuple)):
+            return {"candidates": len(scored)}
+        return {}
+
+    def build_output_summary(
+        self,
+        result: EmploymentTransitionToolResult,
+        scored: Iterable[CandidateSet],
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        return {
+            "scored": len(result.scored),
+            "transitions": len(result.warnings),
+        }
+
+
+_default_tool = EmploymentTransitionTools()
+
+
