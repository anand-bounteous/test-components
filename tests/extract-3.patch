+"""Pydantic request models for bank-transaction REST endpoints."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from nw_aglib_toolkit.channels.rest.ToolCallOptions import ToolCallOptions
+from pydantic import Field
+
+
+class ValidationRequest(ToolCallOptions):
+    payload: dict[str, Any]
+    mode: str = "lenient"
+
+
+class NormalizationRequest(ToolCallOptions):
+    transactions: list[dict[str, Any]] = Field(default_factory=list)
+
+
+class FeatureExtractionRequest(ToolCallOptions):
+    transactions: list[dict[str, Any]] = Field(default_factory=list)
+
+
+class HintsRequest(ToolCallOptions):
+    transactions: list[dict[str, Any]] = Field(default_factory=list)
+    hint_inputs: dict[str, Any] | None = None
+
+
+class ScoringRequest(ToolCallOptions):
+    pool: list[dict[str, Any]] = Field(default_factory=list)
+    normalised: list[dict[str, Any]] = Field(default_factory=list)
+    features_by_id: dict[str, dict[str, Any]] = Field(default_factory=dict)
+    infer_regions: bool = True
+    hint_inputs: dict[str, Any] | None = None
+
+
+class SkeletonGroupingRequest(ToolCallOptions):
+    normalised: list[dict[str, Any]] = Field(default_factory=list)
+    features_by_id: dict[str, dict[str, Any]] = Field(default_factory=dict)
+    threshold: float | None = None
+
+
+class GraphClusteringRequest(ToolCallOptions):
+    normalised: list[dict[str, Any]] = Field(default_factory=list)
+    features_by_id: dict[str, dict[str, Any]] = Field(default_factory=dict)
+
+
+class DedupCandidatePoolRequest(ToolCallOptions):
+    skeleton_candidates: list[dict[str, Any]] = Field(default_factory=list)
+    graph_candidates: list[dict[str, Any]] = Field(default_factory=list)
+    overlap_threshold: float = 0.90
+
+
+class BonusExpenseSplitRequest(ToolCallOptions):
+    pool: list[dict[str, Any]] = Field(default_factory=list)
+    normalised: list[dict[str, Any]] = Field(default_factory=list)
+
+
+class AmountDateFallbackRequest(ToolCallOptions):
+    unaccounted: list[dict[str, Any]] = Field(default_factory=list)
+    features_by_id: dict[str, dict[str, Any]] = Field(default_factory=dict)
+
+
+class EmploymentTransitionRequest(ToolCallOptions):
+    scored: list[dict[str, Any]] = Field(default_factory=list)
+
+
+class RankingRequest(ToolCallOptions):
+    scored: list[dict[str, Any]] = Field(default_factory=list)
+    max_candidates: int | None = None
+    max_near_misses: int | None = None
+    return_threshold: float | None = None
