+"""Framework-neutral callable signature schema helpers."""
+
+from __future__ import annotations
+
+import inspect
+from collections.abc import Callable
+from typing import Any, get_type_hints
+
+from nw_aglib_toolkit.channels.tools.ToolMetadata import ToolParameterMetadata
+
+
+def build_python_signature_schema(func: Callable) -> dict[str, Any]:
+    """Build a framework-neutral schema from a Python callable."""
+    signature = inspect.signature(func)
+    type_hints = _safe_type_hints(func)
+
+    parameters: dict[str, Any] = {}
+
+    for parameter_name, parameter in signature.parameters.items():
+        if parameter_name in {"self", "cls"}:
+            continue
+
+        if parameter_name in type_hints:
+            annotation = type_hints[parameter_name]
+        elif parameter.annotation is not inspect.Parameter.empty:
+            annotation = parameter.annotation
+        else:
+            annotation = Any
+
+        parameters[parameter_name] = {
+            "name": parameter_name,
+            "annotation": stringify_annotation(annotation),
+            "required": parameter.default is inspect.Parameter.empty,
+            "default": None if parameter.default is inspect.Parameter.empty else parameter.default,
+            "kind": str(parameter.kind),
+        }
+
+    return_type = type_hints.get("return")
+    if return_type is None:
+        if signature.return_annotation is not inspect.Signature.empty:
+            return_type = signature.return_annotation
+        else:
+            return_type = Any
+
+    return {
+        "parameters": parameters,
+        "return_type": stringify_annotation(return_type),
+    }
+
+
+def _safe_type_hints(func: Callable) -> dict[str, Any]:
+    try:
+        return get_type_hints(func, globalns=getattr(func, "__globals__", {}))
+    except NameError:
+        return {}
+
+
+def build_tool_parameter_metadata(
+    func: Callable,
+) -> tuple[tuple[ToolParameterMetadata, ...], str | None]:
+    """Extract parameter and return-type metadata from a callable signature."""
+    schema = build_python_signature_schema(func)
+    parameters = tuple(
+        ToolParameterMetadata(
+            name=item["name"],
+            annotation=item["annotation"],
+            required=item["required"],
+            default=item["default"],
+            kind=item["kind"],
+        )
+        for item in schema["parameters"].values()
+    )
+    return parameters, schema["return_type"]
+
+
+def stringify_annotation(annotation: Any) -> str:
+    if annotation is Any:
+        return "Any"
+
+    if isinstance(annotation, str):
+        return annotation
+
+    if hasattr(annotation, "__name__"):
+        return annotation.__name__
+
+    rendered = str(annotation)
+    if rendered.startswith("typing."):
+        return rendered.removeprefix("typing.")
+    return rendered
