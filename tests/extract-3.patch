+"""Typed gRPC servicer for salary detection."""
+
+from __future__ import annotations
+
+from nw_agbus_salary_extractor.channels.grpc.Converters import (
+    empty_salary_result_message,
+    salary_request_from_proto,
+)
+from nw_agbus_salary_extractor.channels.grpc.generated.nw.salary.v1 import (
+    salary_extractor_pb2,
+    salary_extractor_pb2_grpc,
+)
+from nw_agbus_salary_extractor.channels.tools.SalaryTransactionExtractorTools import (
+    detect_salary_candidates,
+)
+from nw_aglib_toolkit.channels.grpc.DetectRpc import run_detect_handler
+
+
+class SalaryExtractorServicer(salary_extractor_pb2_grpc.SalaryExtractorServicer):
+    async def DetectSalaryCandidates(self, request, context):  # noqa: N802
+        return run_detect_handler(
+            request,
+            tool_name="detect_salary_candidates",
+            parse_request=salary_request_from_proto,
+            detect=detect_salary_candidates,
+            response_factory=salary_extractor_pb2.DetectSalaryCandidatesResponse,
+            result_message_factory=empty_salary_result_message,
+        )
