+"""
+Subprocess entry point for Doctr OCR.
+
+Reads JSON from stdin:  {"pages": [{"page_index", "image_path", "width", "height", "dpi"}]}
+Writes JSON to stdout:  {"pages": [{"page_index", "regions": [...]}]}
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+
+def _run() -> None:
+    os.environ.setdefault("DOCTR_MULTIPROCESSING_DISABLE", "TRUE")
+
+    import numpy as np
+    from doctr.models import ocr_predictor  # type: ignore
+    from PIL import Image as PILImage
+
+    predictor = ocr_predictor(pretrained=True, assume_straight_pages=True)
+    payload = json.loads(sys.stdin.read())
+    output_pages = []
+
+    for p in payload["pages"]:
+        img = np.array(PILImage.open(p["image_path"]).convert("RGB"))
+        result = predictor([img])
+        w_px: int = p["width"]
+        h_px: int = p["height"]
+        dpi: int = p["dpi"]
+        cs = f"image_px@{dpi}"
+        regions = []
+
+        for page_res in result.pages:
+            for block in page_res.blocks:
+                for line in block.lines:
+                    if not line.words:
+                        continue
+                    xs = (
+                        [w.geometry[0][0] * w_px for w in line.words]
+                        + [w.geometry[1][0] * w_px for w in line.words]
+                    )
+                    ys = (
+                        [w.geometry[0][1] * h_px for w in line.words]
+                        + [w.geometry[1][1] * h_px for w in line.words]
+                    )
+                    x, y = min(xs), min(ys)
+                    bbox_w = max(xs) - x
+                    bbox_h = max(ys) - y
+                    text = " ".join(w.value for w in line.words)
+                    conf = float(sum(w.confidence for w in line.words) / len(line.words))
+                    regions.append({
+                        "type": "normal_text",
+                        "bbox": {
+                            "x": x, "y": y, "w": bbox_w, "h": bbox_h,
+                            "page_index": p["page_index"],
+                            "coord_space": cs,
+                        },
+                        "text": text,
+                        "confidence": conf,
+                        "source_tool": "doctr",
+                        "attributes": {},
+                    })
+
+        output_pages.append({"page_index": p["page_index"], "regions": regions})
+
+    sys.stdout.write(json.dumps({"pages": output_pages}))
+
+
+if __name__ == "__main__":
+    _run()
