+"""Shared party and property token overlap helpers."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import overlap_match_level
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+
+
+def max_match_level(current: str, new: str) -> str:
+    order = {"none": 0, "partial": 1, "exact": 2}
+    return new if order.get(new, 0) > order.get(current, 0) else current
+
+
+def property_match_level(description_tokens: frozenset[str], *hint_texts: str | None) -> str:
+    levels = [
+        overlap_match_level(description_tokens, text, load_hint_config())
+        for text in hint_texts
+        if text
+    ]
+    if "exact" in levels:
+        return "exact"
+    if "partial" in levels:
+        return "partial"
+    return "none"
