+"""Load rent-detector YAML configuration."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from importlib import resources
+from pathlib import Path
+from typing import Any
+
+import yaml
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models.DescriptionSignalConfig import (
+    DescriptionSignalConfig,
+)
+
+_CONFIG_PACKAGE = "nw_agbus_rent_extractor.services.config"
+
+
+@dataclass(frozen=True)
+class RentConfig:
+    data: dict[str, Any] = field(default_factory=dict)
+
+    def weights(self) -> dict[str, float]:
+        return {k: float(v) for k, v in self.data.get("weights", {}).items()}
+
+    def thresholds(self) -> dict[str, Any]:
+        return dict(self.data.get("thresholds", {}))
+
+    def candidate_generation(self) -> dict[str, Any]:
+        return dict(self.data.get("candidate_generation", {}))
+
+    def rent_hints(self) -> dict[str, Any]:
+        return dict(self.data.get("rent_hints", {}))
+
+    def amount(self) -> dict[str, Any]:
+        return dict(self.data.get("amount", {}))
+
+    def config_overrides_for_core(self) -> dict[str, Any]:
+        """Merge rent tuning into AppConfig overrides for skeleton/graph phases."""
+        cg = self.candidate_generation()
+        return {
+            "candidate_generation": {
+                "min_skeleton_group_size": cg.get("min_skeleton_group_size", 2),
+                "skeleton_plausibility_threshold": cg.get("skeleton_plausibility_threshold", 0.45),
+                "graph_edge_threshold": cg.get("graph_edge_threshold", 0.50),
+                "dedup_txn_id_overlap_pct": cg.get("dedup_txn_id_overlap_pct", 0.90),
+                "max_candidates_to_return": cg.get("max_candidates_to_return", 10),
+                "max_near_misses": cg.get("max_near_misses", 10),
+            },
+            "weights": self.weights(),
+            "thresholds": self.thresholds(),
+        }
+
+    def description_signals(self) -> DescriptionSignalConfig:
+        return rent_description_signals()
+
+
+def load_rent_keywords(config_path: Path | None = None) -> dict[str, tuple[str, ...]]:
+    if config_path is None:
+        raw = (
+            resources.files(_CONFIG_PACKAGE)
+            .joinpath("rent_keywords.yaml")
+            .read_text(encoding="utf-8")
+        )
+    else:
+        raw = config_path.read_text(encoding="utf-8")
+    data = yaml.safe_load(raw) or {}
+    return {
+        "positive": tuple(data.get("positive_keywords") or ()),
+        "negative": tuple(data.get("negative_keywords") or ()),
+    }
+
+
+def rent_description_signals() -> DescriptionSignalConfig:
+    keywords = load_rent_keywords()
+    return DescriptionSignalConfig.from_flat_keywords(
+        keywords["positive"],
+        keywords["negative"],
+    )
+
+
+def load_rent_config(config_path: Path | None = None) -> RentConfig:
+    if config_path is None:
+        raw = (
+            resources.files(_CONFIG_PACKAGE)
+            .joinpath("rent_detector.yaml")
+            .read_text(encoding="utf-8")
+        )
+    else:
+        raw = config_path.read_text(encoding="utf-8")
+    return RentConfig(data=yaml.safe_load(raw) or {})
