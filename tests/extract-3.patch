+# Bank transaction text normalisation — Design §6.1, §8.1, §10.5.
+#
+# Payment-route / banking glue words dropped from both the normalised
+# description and the skeleton. Order in legal_suffix_map matters: longest
+# phrase first so shorter rules do not partially consume longer ones.
+
+generic_stop_tokens:
+  - REF
+  - REFERENCE
+  - PAYMENT
+  - CREDIT
+  - ONLINE
+  - TRANSFER
+  - TFR
+
+legal_suffix_map:
+  - long: PUBLIC LIMITED COMPANY
+    short: PLC
+  - long: LIMITED
+    short: LTD
+
+empty_skeleton_placeholder: "__EMPTY__"
+default_currency: GBP
+default_direction: credit
+
+schema_validation:
+  enabled: true
+  strict: true
+
+text_patterns:
+  punct: '[^A-Z0-9 ]+'
+  whitespace: '\s+'
+  long_digit_token: '^\d{4,}$'
+  trailing_digits: '(?<=[A-Z])\d{2,}$'
