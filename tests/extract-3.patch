+openapi: 3.0.3
+info:
+  title: Extract features
+  version: 1.0.0
+paths:
+  /api/v1/features/extract:
+    post:
+      tags:
+      - features
+      summary: Extract salary-detection features from normalised transactions.
+      operationId: run_extract_bank_transaction_features
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/FeatureExtractionRequest'
+      responses:
+        '200':
+          description: Successful tool execution.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/FeatureExtractionSuccessResponse'
+        '422':
+          description: Validation or business-rule failure (structured ToolErrorResponse).
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ToolErrorResponse'
+        '500':
+          description: Unexpected server error (structured ToolErrorResponse).
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ToolErrorResponse'
+components:
+  schemas:
+    ToolCallOptions:
+      type: object
+      description: Shared optional fields for every tool REST request.
+      properties:
+        config_overrides:
+          type: object
+          additionalProperties: true
+          nullable: true
+        source_bank:
+          type: string
+          nullable: true
+        region:
+          type: string
+          nullable: true
+        include_audit:
+          type: boolean
+          default: false
+    ToolErrorDetail:
+      type: object
+      required:
+      - code
+      - message
+      properties:
+        code:
+          type: string
+          enum:
+          - VALIDATION_ERROR
+          - INTERNAL_ERROR
+          example: VALIDATION_ERROR
+        message:
+          type: string
+          example: transactions must not be empty
