+"""Base class for pipeline tools with standard logging and audit hooks."""
+
+from __future__ import annotations
+
+import logging
+import time
+from abc import ABC, abstractmethod
+from dataclasses import replace
+from typing import TYPE_CHECKING, Any, ClassVar, TypeVar
+
+from nw_aglib_toolkit.channels.tools.models.BaseToolModel import BaseToolModel
+from nw_aglib_toolkit.channels.tools.models.ToolAuditData import ToolAuditData
+from nw_core.logging import get_logger
+from nw_core.logging.LogFnAnnotation import log_at
+from nw_core.validation import ValidationWarning
+
+if TYPE_CHECKING:
+    from nw_aglib_toolkit.audit import AuditBuilder
+
+R = TypeVar("R", bound=BaseToolModel)
+
+
+class BaseTool[R: BaseToolModel](ABC):
+    """Wrap tool execution with phase logging and optional audit payload generation."""
+
+    phase_name: ClassVar[str]
+
+    def __init__(self, logger: logging.Logger | None = None) -> None:
+        self._logger = logger or get_logger(self.__class__.__module__)
+
+    def run(
+        self,
+        *args: Any,
+        audit: AuditBuilder | None = None,
+        warnings: list[ValidationWarning] | None = None,
+        **kwargs: Any,
+    ) -> R:
+        input_summary = self.build_input_summary(*args, **kwargs)
+        self._log_phase_start(input_summary)
+        started = time.perf_counter()
+
+        try:
+            result = self._execute(*args, **kwargs)
+        except Exception as exc:
+            self._log_phase_error(exc)
+            raise
+
+        duration_ms = round((time.perf_counter() - started) * 1000.0, 3)
+        output_summary = self.build_output_summary(result, *args, **kwargs)
+        self.trace_output(result)
+        self._log_phase_done(output_summary)
+
+        if audit is not None and audit.enabled:
+            result = replace(
+                result,
+                audit=ToolAuditData(
+                    phase_name=self.phase_name,
+                    input_summary=input_summary,
+                    output_summary=output_summary,
+                    duration_ms=duration_ms,
+                ),
+            )
+
+        self._merge_pipeline_outcome(audit, warnings, result)
+        return result
+
+    @staticmethod
+    def _merge_pipeline_outcome(
+        audit: AuditBuilder | None,
+        warnings: list[ValidationWarning] | None,
+        result: BaseToolModel,
+    ) -> None:
+        if warnings is not None and result.warnings:
+            warnings.extend(result.warnings)
+        if audit is not None and result.audit is not None:
+            audit.apply_tool_audit(result.audit)
+
+    @abstractmethod
+    def _execute(self, *args: Any, **kwargs: Any) -> R:
+        """Tool-specific work. Subclasses should decorate with ``@LogFn``."""
+
+    def build_input_summary(self, *args: Any, **kwargs: Any) -> dict[str, Any]:
+        return {}
+
+    def build_output_summary(self, result: R, *args: Any, **kwargs: Any) -> dict[str, Any]:
+        return {}
+
+    def trace_output(self, result: R) -> None:
+        """Optional TRACE-level detail — override in subclasses."""
+
+    def _log_phase_start(self, input_summary: dict[str, Any]) -> None:
+        if not input_summary:
+            log_at(
+                self._logger,
+                logging.DEBUG,
+                self.run,
+                "phase.start  phase=%s",
+                self.phase_name,
+            )
+            return
+        summary = " ".join(f"{key}={value}" for key, value in input_summary.items())
+        log_at(
+            self._logger,
+            logging.INFO,
+            self.run,
+            "phase.start  phase=%s  %s",
+            self.phase_name,
+            summary,
+        )
+
+    def _log_phase_done(self, output_summary: dict[str, Any]) -> None:
+        if not output_summary:
+            log_at(
+                self._logger,
+                logging.INFO,
+                self.run,
+                "phase.done   phase=%s",
+                self.phase_name,
+            )
+            return
+        summary = " ".join(f"{key}={value}" for key, value in output_summary.items())
+        log_at(
+            self._logger,
+            logging.DEBUG,
+            self.run,
+            "phase.done   phase=%s  %s",
+            self.phase_name,
+            summary,
+        )
+
+    def _log_phase_error(self, exc: Exception) -> None:
+        log_at(
+            self._logger,
+            logging.ERROR,
+            self.run,
+            "phase.error  phase=%s  error=%s",
+            self.phase_name,
+            exc,
+        )
