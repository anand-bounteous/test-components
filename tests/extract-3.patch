+"""Phase 11 benchmark runner.
+
+Iterates over every fixture in ``tests/fixtures/scenarios/``, runs the
+detector, and produces a Markdown report at
+``.plan/reviews/phase11-benchmark.md`` summarising:
+
+- recall (true salary class present among returned candidates),
+- top-1 accuracy (highest-confidence candidate's type matches expectation),
+- precision (probable_salary candidates that actually were salary),
+- per-category false-positive rate for pension / DWP / HMRC / own
+  transfer / rent / insurance,
+- robustness signals (missing-month, description-change scenarios).
+
+Run from the repository root:
+
+    .venv/bin/python -m tests.benchmark.run_benchmark
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from collections.abc import Iterable
+from dataclasses import dataclass
+from pathlib import Path
+
+from nw_agbus_salary_extractor.channels.tools.SalaryTransactionExtractorTools import (
+    detect_salary_candidates,
+)
+
+AGENT_ROOT = Path(__file__).resolve().parents[2]
+REPO_ROOT = AGENT_ROOT.parents[2]
+
+
+def _load_scenario(path: Path):
+    if str(REPO_ROOT) not in sys.path:
+        sys.path.insert(0, str(REPO_ROOT))
+    from tests.feature.support.Payload import load_scenario
+
+    return load_scenario(path)
+
+
+SCENARIO_DIR = AGENT_ROOT / "tests" / "fixtures" / "scenarios" / "ideal"
+REPORT_PATH = REPO_ROOT / ".plan" / "reviews" / "phase11-benchmark.md"
+
+
+_FALSE_POSITIVE_TAGS = {
+    "pension": "pension",
+    "dwp": "dwp",
+    "hmrc": "hmrc",
+    "own_transfer": "own_transfer",
+    "rent": "rent",
+    "insurance": "insurance",
+}
+
+
+@dataclass(frozen=True)
+class ScenarioResult:
+    scenario: str
+    tags: tuple[str, ...]
+    expected_top_type: str | None
+    expected_band: str | None
+    must_not_be_probable_salary: bool
+    actual_candidate_count: int
+    actual_top_type: str | None
+    actual_top_band: str | None
+    actual_top_confidence: float
+    elapsed_seconds: float
+    correct_top_type: bool | None
+    contains_probable_salary: bool
+    must_not_top_is_probable_salary: bool | None  # only meaningful for must_not_ scenarios
+
+
+def run(scenario_dir: Path = SCENARIO_DIR) -> tuple[list[ScenarioResult], dict]:
+    results: list[ScenarioResult] = []
+    for path in sorted(scenario_dir.glob("*.yaml")):
+        raw, payload = _load_scenario(path)
+        expected = raw.get("expected", {})
+        start = time.perf_counter()
+        out = detect_salary_candidates(payload)
+        elapsed = time.perf_counter() - start
+
+        candidates = list(out.candidate_sets)
+        near_misses = list(out.rejected_or_near_miss_sets)
+        every = candidates + near_misses
+
+        must_not = expected.get("must_not_classify_as_probable_salary", False)
+        top = candidates[0] if candidates else None
+        results.append(
+            ScenarioResult(
+                scenario=path.stem,
+                tags=tuple(raw.get("scenario_tags", [])),
+                expected_top_type=expected.get("top_candidate_type"),
+                expected_band=expected.get("top_confidence_band"),
+                must_not_be_probable_salary=must_not,
+                actual_candidate_count=len(candidates),
+                actual_top_type=top.candidate_type if top else None,
+                actual_top_band=top.confidence_band if top else None,
+                actual_top_confidence=float(top.confidence) if top else 0.0,
+                elapsed_seconds=elapsed,
+                correct_top_type=(
+                    None
+                    if expected.get("top_candidate_type") is None
+                    else top is not None and top.candidate_type == expected["top_candidate_type"]
+                ),
+                contains_probable_salary=any(c.candidate_type == "probable_salary" for c in every),
+                must_not_top_is_probable_salary=(
+                    None
+                    if not must_not
+                    else top is not None and top.candidate_type == "probable_salary"
+                ),
+            )
+        )
+
+    metrics = _compute_metrics(results)
+    return results, metrics
+
+
+def _compute_metrics(results: Iterable[ScenarioResult]) -> dict:
+    results = list(results)
+    labelled = [r for r in results if r.expected_top_type is not None]
+    correct = [r for r in labelled if r.correct_top_type]
+    top1_accuracy = (len(correct) / len(labelled)) if labelled else 0.0
+
+    # Recall: for fixtures we expect probable_salary, did the detector
+    # return at least one probable_salary candidate?
+    salary_expected = [r for r in labelled if r.expected_top_type == "probable_salary"]
+    salary_recall = sum(1 for r in salary_expected if r.contains_probable_salary) / max(
+        1, len(salary_expected)
+    )
+
+    # Precision: among fixtures that produced a probable_salary candidate,
+    # how many were expected to be probable_salary?
+    produced_salary = [r for r in results if r.contains_probable_salary]
+    correct_salary = [r for r in produced_salary if r.expected_top_type == "probable_salary"]
+    precision = len(correct_salary) / max(1, len(produced_salary))
+
+    # Per-category false-positive rates — only counted on fixtures
+    # that explicitly forbid probable_salary (``must_not_classify_as_
+    # probable_salary``). Mixed-stream fixtures (HMRC + salary, insurance
+    # + salary) are intentionally excluded; they validate that the
+    # detector *can* extract salary from a noisy stream, not that the
+    # category is a false-positive trigger.
+    fp = {}
+    for label, tag in _FALSE_POSITIVE_TAGS.items():
+        tagged = [
+            r for r in results if tag in " ".join(r.tags).lower() and r.must_not_be_probable_salary
+        ]
+        if not tagged:
+            fp[label] = None
+            continue
+        false_positives = sum(1 for r in tagged if r.must_not_top_is_probable_salary)
+        fp[label] = false_positives / len(tagged)
+
+    # Robustness signals.
+    robustness = {
+        "missing_month": any(
+            r.scenario == "08_missing_month" and r.correct_top_type for r in results
+        ),
+        "payroll_provider_change": any(
+            r.scenario == "15_payroll_provider_change" and r.actual_candidate_count == 1
+            for r in results
+        ),
+    }
+
+    elapsed_total = sum(r.elapsed_seconds for r in results)
+    return {
+        "total_scenarios": len(results),
+        "labelled_scenarios": len(labelled),
+        "top1_accuracy": top1_accuracy,
+        "salary_recall": salary_recall,
+        "salary_precision": precision,
+        "false_positive_rates": fp,
+        "robustness": robustness,
+        "total_seconds": elapsed_total,
+        "average_seconds_per_scenario": elapsed_total / max(1, len(results)),
+    }
+
+
+def render_report(results: list[ScenarioResult], metrics: dict) -> str:
+    lines: list[str] = []
+    lines.append("# Salary Detector Benchmark Report")
+    lines.append("")
+    lines.append("## Dataset Summary")
+    lines.append(f"- Total scenarios: {metrics['total_scenarios']}")
+    lines.append(
+        f"- Labelled (have `expected.top_candidate_type`): {metrics['labelled_scenarios']}"
+    )
+    lines.append(f"- Total elapsed: {metrics['total_seconds']:.3f}s")
+    lines.append(f"- Avg per scenario: {metrics['average_seconds_per_scenario'] * 1000:.1f}ms")
+    lines.append("")
+    lines.append("## Headline Metrics")
+    lines.append("")
+    lines.append("| Metric | Value | Gate |")
+    lines.append("|---|---:|---:|")
+    lines.append(f"| Top-1 accuracy | {metrics['top1_accuracy']:.2%} | ≥ 80.00 % |")
+    lines.append(f"| Salary recall | {metrics['salary_recall']:.2%} | ≥ 90.00 % |")
+    lines.append(f"| Salary precision | {metrics['salary_precision']:.2%} | — |")
+    lines.append("")
+    lines.append("## False-Positive Rates (per category)")
+    lines.append("")
+    lines.append("| Category | Rate | Gate |")
+    lines.append("|---|---:|---:|")
+    for label, rate in metrics["false_positive_rates"].items():
+        if rate is None:
+            value = "n/a"
+        else:
+            value = f"{rate:.2%}"
+        lines.append(f"| {label.replace('_', ' ').title()} | {value} | ≤ 10.00 % |")
+    lines.append("")
+    lines.append("## Robustness")
+    lines.append("")
+    for k, v in metrics["robustness"].items():
+        lines.append(f"- **{k.replace('_', ' ').title()}**: {'✓ pass' if v else '✗ fail'}")
+    lines.append("")
+    lines.append("## Per-Scenario Detail")
+    lines.append("")
+    lines.append(
+        "| Scenario | Expected type | Actual type | Actual band | Conf | Time (ms) | Correct |"
+    )
+    lines.append("|---|---|---|---|---:|---:|:---:|")
+    for r in results:
+        correctness = "—" if r.correct_top_type is None else ("✓" if r.correct_top_type else "✗")
+        lines.append(
+            f"| {r.scenario} | {r.expected_top_type or '—'} | "
+            f"{r.actual_top_type or '—'} | {r.actual_top_band or '—'} | "
+            f"{r.actual_top_confidence:.2f} | {r.elapsed_seconds * 1000:.1f} | {correctness} |"
+        )
+    lines.append("")
+    lines.append("## Calibration Notes")
+    lines.append("")
+    lines.append(
+        "- The two cut-off-boundary cases (`07_salary_increase` final 0.847 vs. high "
+        "0.85 cut-off, `10_fortnightly` 0.845) round down to `medium_high`. Phase 11 "
+        "calibration could nudge the high-band threshold to 0.84 if a higher "
+        "high-band rate is required."
+    )
+    lines.append(
+        "- `25_contractor_multi_client` collapses three streams into one due to shared "
+        "generic tokens (CLIENT, CONTRACTOR, INVOICE). A future amount-bucket "
+        "pre-grouping rule would split them."
+    )
+    return "\n".join(lines) + "\n"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        prog="python -m tests.benchmark.run_benchmark",
+        description=(
+            "Run the salary-detector benchmark over all ideal-scenario fixtures\n"
+            "and produce a Markdown report with headline metrics and per-scenario detail.\n\n"
+            "Fixture source : tests/fixtures/scenarios/ideal/  (30 scenarios)\n"
+            "Report output  : .plan/reviews/phase11-benchmark.md\n\n"
+            "Headline metrics gated:\n"
+            "  top-1 accuracy  >= 80 %\n"
+            "  salary recall   >= 90 %\n"
+            "  false-positive  <= 10 % per category (pension, DWP, HMRC, own-transfer, rent, insurance)\n\n"
+            "Run via pytest (for coverage + CI integration):\n"
+            "  pytest tests/benchmark -v"
+        ),
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    parser.add_argument(
+        "--scenario-dir",
+        default=str(SCENARIO_DIR),
+        metavar="DIR",
+        help=f"Directory of ideal-scenario JSON fixtures (default: {SCENARIO_DIR})",
+    )
+    parser.add_argument(
+        "--report",
+        default=str(REPORT_PATH),
+        metavar="FILE",
+        help=f"Path to write the Markdown report (default: {REPORT_PATH})",
+    )
+    args = parser.parse_args()
+
+    scenario_dir = Path(args.scenario_dir)
+    report_path = Path(args.report)
+
+    results, metrics = run(scenario_dir)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text(render_report(results, metrics))
+    print(report_path.read_text())
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
