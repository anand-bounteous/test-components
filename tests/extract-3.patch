+"""Running confidence total with audit steps and TRACE logging."""
+
+from __future__ import annotations
+
+import json
+import logging
+from dataclasses import dataclass, field
+from typing import Any
+
+from nw_core.logging import TRACE
+
+from .._models import ConfidenceDetail
+
+logger = logging.getLogger(__name__)
+
+
+def confidence_log_prefix(stage: str) -> str:
+    return f"[confidence_calculation][{stage}]"
+
+
+def trace_confidence_step(
+    *,
+    stage: str,
+    candidate_id: str,
+    amount: float,
+    confidence: float,
+    reasoning: str,
+    data: dict[str, Any] | None = None,
+    log: logging.Logger | None = None,
+) -> None:
+    log = log or logger
+    if not log.isEnabledFor(TRACE):
+        return
+    payload = dict(data or {})
+    data_text = json.dumps(payload, default=str, sort_keys=True) if payload else "{}"
+    log.log(
+        TRACE,
+        "%s  candidate=%s  amount=%+.6f  confidence=%.6f  reasoning=%s  data=%s",
+        confidence_log_prefix(stage),
+        candidate_id,
+        amount,
+        confidence,
+        reasoning,
+        data_text,
+    )
+
+
+@dataclass
+class ConfidenceAccumulator:
+    """Accumulates signed confidence deltas with step-level audit + TRACE."""
+
+    candidate_id: str = ""
+    running: float = 0.0
+    clamp_min: float = 0.0
+    clamp_max: float = 1.0
+    steps: list[ConfidenceDetail] = field(default_factory=list)
+    _logger: logging.Logger = field(default=logger, repr=False)
+
+    def apply_delta(
+        self,
+        *,
+        stage: str,
+        amount: float,
+        max_value: float,
+        reasoning: str,
+        data: dict[str, Any] | None = None,
+    ) -> float:
+        payload = dict(data or {})
+        self.running = round(
+            min(self.clamp_max, max(self.clamp_min, self.running + amount)),
+            6,
+        )
+        step = ConfidenceDetail(
+            step=stage,
+            confidence_step=round(amount, 6),
+            confidence_step_max_value=round(max_value, 6),
+            reasoning=reasoning,
+            data=payload,
+        )
+        self.steps.append(step)
+        if self._logger.isEnabledFor(TRACE):
+            data_text = json.dumps(payload, default=str, sort_keys=True) if payload else "{}"
+            self._logger.log(
+                TRACE,
+                "%s  candidate=%s  amount=%+.6f  confidence=%.6f  reasoning=%s  data=%s",
+                confidence_log_prefix(stage),
+                self.candidate_id,
+                amount,
+                self.running,
+                reasoning,
+                data_text,
+            )
+        return self.running
+
+    def set_running(
+        self,
+        *,
+        stage: str,
+        target: float,
+        max_value: float,
+        reasoning: str,
+        data: dict[str, Any] | None = None,
+    ) -> float:
+        delta = round(target - self.running, 6)
+        if delta == 0.0:
+            return self.running
+        return self.apply_delta(
+            stage=stage,
+            amount=delta,
+            max_value=max_value,
+            reasoning=reasoning,
+            data=data,
+        )
+
+    def multiply(
+        self,
+        *,
+        stage: str,
+        factor: float,
+        reasoning: str,
+        data: dict[str, Any] | None = None,
+    ) -> float:
+        before = self.running
+        target = round(min(self.clamp_max, max(self.clamp_min, before * factor)), 6)
+        payload = dict(data or {})
+        payload["before"] = before
+        payload["factor"] = factor
+        return self.set_running(
+            stage=stage,
+            target=target,
+            max_value=self.clamp_max,
+            reasoning=reasoning,
+            data=payload,
+        )
+
+    def as_tuple(self) -> tuple[ConfidenceDetail, ...]:
+        return tuple(self.steps)
+
+
+__all__ = ["ConfidenceAccumulator", "confidence_log_prefix", "trace_confidence_step"]
