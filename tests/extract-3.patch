+"""Generic ranking works with any CandidateSet-like scored type."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.ranking.RankingService import (
+    RankingConfig,
+    rank_candidates,
+    tag_near_miss,
+)
+
+
+@dataclass(frozen=True)
+class _StubScored:
+    candidate_set_id: str
+    confidence: float
+    metadata: dict[str, Any] = field(default_factory=dict)
+
+
+@pytest.mark.unit
+def test_rank_candidates_accepts_non_salary_candidate_shape():
+    scored = [
+        _StubScored("b", 0.9),
+        _StubScored("a", 0.5),
+        _StubScored("c", 0.2),
+    ]
+    ranking = RankingConfig(return_threshold=0.4, max_candidates=1, max_near_misses=2)
+    returned, near_misses, _ = rank_candidates(scored, ranking)
+    assert [c.candidate_set_id for c in returned] == ["b"]
+    assert len(near_misses) == 2
+    assert near_misses[0].metadata.get("near_miss_reason") == "cap_overflow"
+
+
+@pytest.mark.unit
+def test_tag_near_miss_preserves_metadata():
+    candidate = _StubScored("x", 0.5, metadata={"source": "test"})
+    tagged = tag_near_miss(candidate, "below_threshold")
+    assert tagged.metadata["near_miss_reason"] == "below_threshold"
+    assert tagged.metadata["source"] == "test"
