+"""Unit tests for agent invocation clients."""
+
+from __future__ import annotations
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import httpx
+import pytest
+from nw_aglib_toolkit.agent import InProcessAgentClient, RestAgentClient
+
+
+@pytest.mark.unit
+async def test_in_process_client_delegates_to_agent():
+    agent = AsyncMock()
+    agent.invoke.return_value = {"ok": True}
+    client = InProcessAgentClient(agent)
+
+    result = await client.invoke({"x": 1})
+
+    agent.invoke.assert_awaited_once_with({"x": 1})
+    assert result == {"ok": True}
+
+
+@pytest.mark.unit
+async def test_rest_client_posts_to_invoke_endpoint():
+    mock_response = MagicMock()
+    mock_response.json.return_value = {"result": "ok"}
+    mock_response.raise_for_status = MagicMock()
+
+    mock_http_client = AsyncMock()
+    mock_http_client.post.return_value = mock_response
+    mock_http_client.__aenter__.return_value = mock_http_client
+    mock_http_client.__aexit__.return_value = None
+
+    with patch("nw_aglib_toolkit.agent.AgentClient.httpx.AsyncClient", return_value=mock_http_client):
+        client = RestAgentClient("http://agent.example.com/")
+        result = await client.invoke({"payload": 1})
+
+    mock_http_client.post.assert_awaited_once_with(
+        "http://agent.example.com/invoke",
+        json={"payload": 1},
+    )
+    assert result == {"result": "ok"}
+
+
+@pytest.mark.unit
+async def test_rest_client_strips_trailing_slash_from_base_url():
+    mock_response = MagicMock()
+    mock_response.json.return_value = {}
+    mock_response.raise_for_status = MagicMock()
+
+    mock_http_client = AsyncMock()
+    mock_http_client.post.return_value = mock_response
+    mock_http_client.__aenter__.return_value = mock_http_client
+    mock_http_client.__aexit__.return_value = None
+
+    with patch("nw_aglib_toolkit.agent.AgentClient.httpx.AsyncClient", return_value=mock_http_client):
+        client = RestAgentClient("http://agent.example.com/api/")
+        await client.invoke({})
+
+    mock_http_client.post.assert_awaited_once_with(
+        "http://agent.example.com/api/invoke",
+        json={},
+    )
+
+
+@pytest.mark.unit
+async def test_rest_client_raises_on_http_error():
+    mock_response = MagicMock()
+    mock_response.raise_for_status.side_effect = httpx.HTTPStatusError(
+        "error",
+        request=MagicMock(),
+        response=MagicMock(status_code=500),
+    )
+
+    mock_http_client = AsyncMock()
+    mock_http_client.post.return_value = mock_response
+    mock_http_client.__aenter__.return_value = mock_http_client
+    mock_http_client.__aexit__.return_value = None
+
+    with patch("nw_aglib_toolkit.agent.AgentClient.httpx.AsyncClient", return_value=mock_http_client):
+        client = RestAgentClient("http://agent.example.com")
+        with pytest.raises(httpx.HTTPStatusError):
+            await client.invoke({})
