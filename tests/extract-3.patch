+"""Phase 8 — scoring (sub-scores + composite blend + clamping)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    AnchorMatch,
+    AppliedHints,
+    RawBankTransaction,
+    SalaryHints,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import normalize_bank_transaction
+from nw_agcore_bank_transactions.pipeline.scoring import (
+    anchor_bonus,
+    channel_score,
+    compute_score,
+    confidence_band,
+    context_bonus,
+    description_score,
+    negative_signal_penalty,
+)
+from nw_aglib_toolkit.pipeline.config import load_config
+from nw_core.calendar import WorkingDayCalendar
+
+
+def _txn(tid, datestr, desc, amount):
+    return normalize_bank_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=datestr,
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+def _feature(
+    tid, *, channel="bacs_or_direct_credit", employer=(), hint=(), negative=(), is_anchor=False
+):
+    return TransactionFeatures(
+        transaction_id=tid,
+        payment_channel=channel,
+        payment_channel_confidence=0.8,
+        possible_employer_tokens=employer,
+        salary_hint_tokens=hint,
+        negative_tokens=negative,
+        is_anchor=is_anchor,
+    )
+
+
+# --- Sub-score functions -------------------------------------------------
+
+
+def test_description_score_zero_for_short_clusters():
+    cluster = [_txn("a", "2024-01-31", "ACME LTD PAYROLL", "2450")]
+    assert description_score(cluster, {}) == 0.0
+
+
+def test_description_score_high_for_aligned_employer_tokens():
+    cluster = [
+        _txn(t, f"2024-{m:02d}-28", "BACS ACME LTD PAYROLL REF", "2450")
+        for m, t in enumerate(["a", "b", "c", "d"], 1)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    score = description_score(cluster, by_id)
+    assert score >= 0.9
+
+
+def test_channel_score_bacs_with_payroll_hint_is_high():
+    feats = [_feature("a", channel="bacs_or_direct_credit", hint=("PAYROLL",))]
+    assert channel_score(feats) == 0.95
+
+
+def test_channel_score_bacs_without_hint_is_medium():
+    feats = [_feature("a", channel="bacs_or_direct_credit")]
+    assert channel_score(feats) == 0.65
+
+
+def test_channel_score_internal_transfer_is_low():
+    feats = [_feature("a", channel="internal_transfer")]
+    assert channel_score(feats) == 0.20
+
+
+def test_channel_score_empty_returns_baseline():
+    assert channel_score([]) == 0.30
+
+
+def test_context_bonus_caps_at_005():
+    feats = [_feature(f"t{i}", employer=("ACME",), hint=("PAYROLL",)) for i in range(6)]
+    assert context_bonus(feats) <= 0.05
+
+
+def test_context_bonus_zero_when_no_employer_or_hint():
+    feats = [_feature(f"t{i}") for i in range(5)]
+    assert context_bonus(feats) == 0.0
+
+
+# --- Negative-signal penalty --------------------------------------------
+
+
+def test_negative_signal_penalty_clamps_at_max():
+    feats = [_feature(f"t{i}", negative=("DWP",)) for i in range(5)]
+    penalty = negative_signal_penalty(feats, max_penalty=-0.20)
+    assert penalty == -0.20
+
+
+def test_negative_signal_penalty_proportional_to_share():
+    feats = [_feature(f"t{i}", negative=("DWP",)) for i in range(2)] + [
+        _feature(f"u{i}") for i in range(8)
+    ]
+    penalty = negative_signal_penalty(feats, max_penalty=-0.20)
+    # 2 of 10 flagged → -0.20 * 0.2 = -0.04
+    assert penalty == pytest.approx(-0.04, rel=1e-3)
+
+
+def test_negative_signal_penalty_zero_when_no_signal():
+    feats = [_feature(f"t{i}") for i in range(5)]
+    assert negative_signal_penalty(feats, max_penalty=-0.20) == 0.0
+
+
+# --- Anchor bonus -------------------------------------------------------
+
+
+def test_anchor_bonus_zero_without_hints():
+    cfg = load_config()
+    assert anchor_bonus(None, {"a", "b"}, {}, config=cfg, per_anchor=0.05, max_bonus=0.15) == 0.0
+
+
+def test_anchor_bonus_zero_when_no_anchor_in_cluster():
+    applied = AppliedHints(
+        anchors=(
+            AnchorMatch(
+                hint_id="h", transaction_id="t99", month="2024-04", amount=Decimal("2453.67")
+            ),
+        )
+    )
+    cfg = load_config()
+    by_id = {"a": _feature("a"), "b": _feature("b")}
+    assert (
+        anchor_bonus(applied, {"a", "b"}, by_id, config=cfg, per_anchor=0.05, max_bonus=0.15) == 0.0
+    )
+
+
+def test_anchor_bonus_one_anchor_from_enriched_features():
+    applied = AppliedHints(
+        anchors=(
+            AnchorMatch(
+                hint_id="h", transaction_id="a", month="2024-04", amount=Decimal("2453.67")
+            ),
+        )
+    )
+    cfg = load_config()
+    by_id = {"a": _feature("a", is_anchor=True)}
+    assert anchor_bonus(applied, {"a"}, by_id, config=cfg, per_anchor=0.05, max_bonus=0.15) == 0.05
+
+
+def test_anchor_bonus_one_anchor_from_applied_hints_when_toggle_off():
+    applied = AppliedHints(
+        anchors=(
+            AnchorMatch(
+                hint_id="h", transaction_id="a", month="2024-04", amount=Decimal("2453.67")
+            ),
+        )
+    )
+    cfg = load_config(overrides={"processing": {"use_anchor_enriched_features": False}})
+    by_id = {"a": _feature("a")}
+    assert anchor_bonus(applied, {"a"}, by_id, config=cfg, per_anchor=0.05, max_bonus=0.15) == 0.05
+
+
+def test_anchor_bonus_capped_at_max():
+    anchors = tuple(
+        AnchorMatch(
+            hint_id=f"h{i}",
+            transaction_id=f"t{i}",
+            month=f"2024-{i + 1:02d}",
+            amount=Decimal("2453.67"),
+        )
+        for i in range(5)
+    )
+    applied = AppliedHints(anchors=anchors)
+    cfg = load_config()
+    by_id = {f"t{i}": _feature(f"t{i}", is_anchor=True) for i in range(5)}
+    assert (
+        anchor_bonus(
+            applied, {f"t{i}" for i in range(5)}, by_id, config=cfg, per_anchor=0.05, max_bonus=0.15
+        )
+        == 0.15
+    )
+
+
+# --- Confidence bands ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "score,expected",
+    [
+        (1.0, "very_high"),
+        (0.92, "very_high"),
+        (0.91, "high"),
+        (0.85, "high"),
+        (0.84, "medium_high"),
+        (0.70, "medium_high"),
+        (0.55, "medium"),
+        (0.40, "low"),
+        (0.39, "very_low"),
+        (0.0, "very_low"),
+    ],
+)
+def test_confidence_band_cut_offs(score, expected):
+    assert confidence_band(score) == expected
+
+
+# --- Composite compute_score --------------------------------------------
+
+
+def test_compute_score_for_stable_bacs_cluster():
+    cluster = [
+        _txn(
+            f"t{m}",
+            f"2024-{m:02d}-{[31, 29, 28, 30, 31, 28, 31, 30, 30, 31, 29, 31][m - 1]:02d}",
+            "BACS ACME LTD PAYROLL",
+            "2450",
+        )
+        for m in range(1, 13)
+    ]
+    by_id = {
+        t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",), channel="bacs_or_direct_credit")
+        for t in cluster
+    }
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    breakdown, inputs, _ = compute_score(cluster, by_id, calendar=cal, config=cfg)
+    assert breakdown.final_score >= 0.80
+    assert breakdown.date_pattern_score >= 0.8
+    assert breakdown.amount_consistency_score == 1.0
+    assert breakdown.payment_channel_score == 0.95
+    assert breakdown.negative_signal_penalty == 0.0
+
+
+def test_compute_score_applies_negative_penalty():
+    cluster = [
+        _txn(f"t{m}", f"2024-{m:02d}-15", "BACS DWP UNIVERSAL CREDIT", "627.40")
+        for m in range(1, 13)
+    ]
+    by_id = {
+        t.id: _feature(t.id, negative=("DWP",), channel="bacs_or_direct_credit") for t in cluster
+    }
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    breakdown, _, _ = compute_score(cluster, by_id, calendar=cal, config=cfg)
+    assert breakdown.negative_signal_penalty == -0.20
+    # final ≤ raw + anchor (= raw) since penalty caps at -0.20
+    assert breakdown.final_score <= breakdown.date_pattern_score
+
+
+def test_compute_score_anchor_bonus_added_when_anchor_in_cluster():
+    cluster = [_txn("a", "2024-04-30", "BACS ACME LTD PAYROLL", "2453.67")]
+    cluster += [
+        _txn(f"t{m}", f"2024-{m:02d}-28", "BACS ACME LTD PAYROLL", "2450") for m in [1, 2, 3, 5, 6]
+    ]
+    by_id = {
+        t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",), is_anchor=(t.id == "a"))
+        for t in cluster
+    }
+    applied = AppliedHints(
+        anchors=(
+            AnchorMatch(
+                hint_id="h", transaction_id="a", month="2024-04", amount=Decimal("2453.67")
+            ),
+        )
+    )
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    breakdown, _, _ = compute_score(cluster, by_id, calendar=cal, config=cfg, applied_hints=applied)
+    assert breakdown.anchor_bonus == 0.05
+
+
+def test_compute_score_band_modifier_below_one_outside_band():
+    cluster = [
+        _txn(f"t{m}", f"2024-{m:02d}-28", "BACS ACME LTD PAYROLL", "500") for m in range(1, 7)
+    ]
+    by_id = {t.id: _feature(t.id, employer=("ACME",), hint=("PAYROLL",)) for t in cluster}
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    salary_hints = SalaryHints(approx_monthly=Decimal("2500"), tolerance_pct=0.20)
+    breakdown, _, _ = compute_score(
+        cluster, by_id, calendar=cal, config=cfg, salary_hints=salary_hints
+    )
+    assert breakdown.salary_band_modifier < 1.0
+    # amount_consistency_score = amount_fit.score * mod (< 1.0)
+    assert breakdown.amount_consistency_score < 1.0
+
+
+def test_compute_score_final_clamped_into_unit_interval():
+    """Even with extreme penalties / bonuses, the final score stays in [0, 1]."""
+    cluster = [_txn("a", "2024-01-31", "BACS ACME LTD PAYROLL", "2450")]
+    by_id = {"a": _feature("a")}
+    cfg = load_config()
+    cal = WorkingDayCalendar()
+    breakdown, _, _ = compute_score(cluster, by_id, calendar=cal, config=cfg)
+    assert 0.0 <= breakdown.final_score <= 1.0
