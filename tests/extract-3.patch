+"""Bank-transaction rent-extractor business tool."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline._models import CandidateSet, RentCandidateSet
+from nw_agcore_bank_transactions.pipeline._models.requests import BankTransactionRequest
+from nw_agcore_bank_transactions.pipeline._models.results import (
+    BankTransactionResult,
+    InputSummary,
+    ResultMetadata,
+    ValidationWarning,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models import (
+    AppliedRentHints,
+    RentHintInputs,
+    RentHints,
+    RentPropertyHint,
+)
+
+_LAZY_EXPORTS = {
+    "RentTransactionExtractorService": (
+        ".RentTransactionExtractorService",
+        "RentTransactionExtractorService",
+    ),
+    "RentTransactionExtractorTools": (
+        "nw_agbus_rent_extractor.channels.tools.RentTransactionExtractorTools",
+        "RentTransactionExtractorTools",
+    ),
+    "detect_rent_candidates": (
+        "nw_agbus_rent_extractor.channels.tools.RentTransactionExtractorTools",
+        "detect_rent_candidates",
+    ),
+}
+
+__all__ = [
+    "AppliedRentHints",
+    "BankTransactionRequest",
+    "BankTransactionResult",
+    "CandidateSet",
+    "RentCandidateSet",
+    "RentHintInputs",
+    "RentHints",
+    "RentPropertyHint",
+    "RentTransactionExtractorService",
+    "RentTransactionExtractorTools",
+    "InputSummary",
+    "ResultMetadata",
+    "ValidationWarning",
+    "detect_rent_candidates",
+]
+
+
+def __getattr__(name: str):
+    if name not in _LAZY_EXPORTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    module_path, attr = _LAZY_EXPORTS[name]
+    import importlib
+
+    module = importlib.import_module(module_path, __name__)
+    value = getattr(module, attr)
+    globals()[name] = value
