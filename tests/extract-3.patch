+"""Phase 5 — skeleton grouping (group_by_skeleton + skeleton-of regression)."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction
+from nw_agcore_bank_transactions.pipeline.applications.salary_extractor.models import (
+    RawBankTransaction,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import (
+    default_service,
+    normalize_bank_transaction,
+)
+from nw_agcore_bank_transactions.pipeline.skeleton_grouping import SkeletonGroupingService
+from nw_aglib_toolkit.pipeline.config import load_config
+
+_norm = default_service()
+normalise_transaction = normalize_bank_transaction
+skeleton_of = _norm.skeleton_of
+
+
+def _txn(tid: str, date_str: str, desc: str, amount: str = "2450.00") -> BankTransaction:
+    return normalise_transaction(
+        RawBankTransaction(
+            id=tid,
+            date=date_str,
+            description=desc,
+            debit_amount=Decimal("0"),
+            credit_amount=Decimal(amount),
+        )
+    )
+
+
+# --- Regression checks on skeleton_of called out by the Phase 5 plan -----
+
+
+def test_reference_number_variations_collapse_to_same_skeleton():
+    a = skeleton_of("BACS CREDIT ACME LTD PAYROLL 123456")
+    b = skeleton_of("BACS CREDIT ACME LTD PAYROLL 789101")
+    assert a == b == "BACS ACME LTD PAYROLL"
+
+
+def test_limited_salary_vs_ltd_payroll_produce_different_skeletons():
+    """Same employer, different action words → DIFFERENT skeleton (Phase 7
+    will merge via similarity)."""
+    a = skeleton_of("BACS CREDIT ACME LIMITED SALARY")
+    b = skeleton_of("BACS CREDIT ACME LTD PAYROLL")
+    assert a != b
+    assert "SALARY" in a
+    assert "PAYROLL" in b
+
+
+def test_punctuation_normalisation_is_idempotent():
+    raw = "BACS-CREDIT ACME LTD / PAYROLL .#0042"
+    once = skeleton_of(raw)
+    twice = skeleton_of(once)
+    assert once == twice
+
+
+def test_empty_and_null_descriptions_collapse_to_placeholder():
+    assert skeleton_of("") == "__EMPTY__"
+    assert skeleton_of("   ") == "__EMPTY__"
+    assert skeleton_of(None) == "__EMPTY__"
+
+
+def test_skeleton_drops_residual_glue_after_digit_strip():
+    """REF1234 should normalise to nothing useful (REF is a stop word)."""
+    out = skeleton_of("BACS REF1234 ACME LTD")
+    assert "REF" not in out.split()
+    assert "ACME" in out.split()
+
+
+def test_with_or_without_reference_number_same_skeleton():
+    a = skeleton_of("BACS CREDIT ACME LTD PAYROLL")
+    b = skeleton_of("BACS CREDIT ACME LTD PAYROLL REF1001")
+    assert a == b
+
+
+# --- group_by_skeleton ---------------------------------------------------
+
+
+def test_group_by_skeleton_buckets_by_key():
+    txns = [
+        _txn("a", "2024-01-31", "BACS ACME LTD PAYROLL 1001"),
+        _txn("b", "2024-02-29", "BACS ACME LTD PAYROLL 2002"),
+        _txn("c", "2024-03-28", "FPS XYZ SERVICES WAGES"),
+    ]
+    detector = SkeletonGroupingService(config=load_config())
+    groups = detector.group_by_skeleton(txns)
+    skeletons = list(groups.keys())
+    assert len(groups) == 2
+    assert any("ACME" in s for s in skeletons)
+    assert any("XYZ" in s for s in skeletons)
+    assert len(groups[next(s for s in skeletons if "ACME" in s)]) == 2
+
+
+def test_group_by_skeleton_empty_input_returns_empty_dict():
+    detector = SkeletonGroupingService(config=load_config())
+    assert detector.group_by_skeleton([]) == {}
+
+
+def test_group_by_skeleton_preserves_insertion_order_within_group():
+    txns = [
+        _txn("a", "2024-03-28", "BACS ACME LTD PAYROLL"),
+        _txn("b", "2024-01-31", "BACS ACME LTD PAYROLL"),
+        _txn("c", "2024-02-29", "BACS ACME LTD PAYROLL"),
+    ]
+    detector = SkeletonGroupingService(config=load_config())
+    groups = detector.group_by_skeleton(txns)
+    [members] = groups.values()
+    assert [t.id for t in members] == ["a", "b", "c"]
