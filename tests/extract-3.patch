+#!/usr/bin/env python3
+"""Remap reference project imports to monorepo package namespaces."""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+REPLACEMENTS: list[tuple[str, str]] = [
+    (r"\bfrom src\.toolkit\.tools\b", "from nw_aglib_toolkit.channels.tools"),
+    (r"\bimport src\.toolkit\.tools\b", "import nw_aglib_toolkit.channels.tools"),
+    (r"\bfrom src\.toolkit\.config\b", "from nw_aglib_toolkit.pipeline.config"),
+    (r"\bimport src\.toolkit\.config\b", "import nw_aglib_toolkit.pipeline.config"),
+    (r"\bfrom src\.toolkit\.", "from nw_aglib_toolkit."),
+    (r"\bimport src\.toolkit\.", "import nw_aglib_toolkit."),
+    (r"\bfrom src\.tools\.bank_transactions\.core\.", "from nw_agcore_bank_transactions.pipeline."),
+    (r"\bfrom src\.tools\.bank_transactions\.routes\.", "from nw_agcore_bank_transactions.channels.rest."),
+    (
+        r"\bfrom src\.tools\.bank_transactions\.applications\.salary_extractor\.",
+        "from nw_agbus_salary_extractor.",
+    ),
+    (
+        r"\bfrom src\.tools\.bank_transactions\.applications\.rent_extractor\.",
+        "from nw_agbus_rent_extractor.",
+    ),
+    (
+        r"\bfrom src\.tools\.bank_transactions\.applications\.gift_extractor\.",
+        "from nw_agbus_gift_extractor.",
+    ),
+    (
+        r"\bfrom src\.tools\.bank_transactions\.applications\.property_sale_extractor\.",
+        "from nw_agbus_property_sale_extractor.",
+    ),
+    (r"\bfrom src\.tools\.bank_transactions\.", "from nw_agcore_bank_transactions."),
+]
+
+
+def remap_file(path: Path, dry_run: bool = False) -> bool:
+    original = path.read_text(encoding="utf-8")
+    updated = original
+    for pattern, replacement in REPLACEMENTS:
+        updated = re.sub(pattern, replacement, updated)
+    if updated != original:
+        if not dry_run:
+            path.write_text(updated, encoding="utf-8")
+        return True
+    return False
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("paths", nargs="+", help="Files or directories to rewrite")
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+
+    changed = 0
+    for raw in args.paths:
+        path = Path(raw)
+        if path.is_dir():
+            files = sorted(path.rglob("*.py"))
+        else:
+            files = [path]
+        for file_path in files:
+            if remap_file(file_path, dry_run=args.dry_run):
+                changed += 1
+                print(file_path)
+    print(f"Updated {changed} file(s)")
+
+
+if __name__ == "__main__":
+    main()
