+    return result
+
+
+def run_doctr_baseline(
+    pdf_path: Path,
+    *,
+    run_dir: Path,
+    raster_pages: list[RasterPage],
+    pdf_kind: str = "unknown",
+    dpi: int = 300,
+) -> ExtractorResult:
+    audit = AuditRecorder()
+    ocr_service = OcrService()
+    with audit.time("ocr_doctr", "doctr", inputs=[p.png_path for p in raster_pages]):
+        doctr_output = ocr_service.run_doctr(raster_pages)
+    pages = build_document_pages(
+        raster_pages,
+        pdf_kind=pdf_kind,  # type: ignore[arg-type]
+        regions_by_page=doctr_output.regions_by_page,
+    )
+    result = ExtractorResult(
