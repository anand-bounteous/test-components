+"""Phase 14 — TRACE level registration + emission."""
+
+from __future__ import annotations
+
+import logging
+
+from nw_core.logging import (
+    LOG_FORMAT,
+    PYTEST_LOG_FORMAT,
+    TRACE,
+    AddCallContext,
+    LogContextFilter,
+    LogFn,
+    configure_logging,
+    get_logger,
+    set_log_analysis_id,
+    setup_trace,
+)
+
+
+def test_trace_level_value_is_5() -> None:
+    assert TRACE == 5
+
+
+def test_setup_trace_is_idempotent() -> None:
+    setup_trace()
+    setup_trace()
+    setup_trace()
+    assert logging.getLevelName(TRACE) == "TRACE"
+
+
+def test_logger_has_trace_method() -> None:
+    setup_trace()
+    logger = get_logger("test_logger_trace_method")
+    assert hasattr(logger, "trace")
+
+
+def test_trace_emits_record_when_enabled(caplog) -> None:
+    setup_trace()
+    logger = get_logger("test_trace_emit")
+    logger.setLevel(TRACE)
+    with caplog.at_level(TRACE, logger="test_trace_emit"):
+        logger.trace("trace event %s", "value")
+    assert any("trace event value" in r.message for r in caplog.records)
+
+
+def test_trace_suppressed_at_debug_level(caplog) -> None:
+    setup_trace()
+    logger = get_logger("test_trace_suppressed")
+    logger.setLevel(logging.DEBUG)
+    with caplog.at_level(logging.DEBUG, logger="test_trace_suppressed"):
+        logger.trace("should not appear")
+        logger.debug("should appear")
+    msgs = [r.message for r in caplog.records]
+    assert "should appear" in msgs
+    assert "should not appear" not in msgs
+
+
+def test_get_logger_returns_same_instance() -> None:
+    a = get_logger("test_same_instance")
+    b = get_logger("test_same_instance")
+    assert a is b
+
+
+def test_log_formats_include_thread_name() -> None:
+    assert "%(threadName)s" in LOG_FORMAT
+    assert "%(threadName)s" in PYTEST_LOG_FORMAT
+
+
+def test_log_formats_include_call_and_analysis_context() -> None:
+    assert "%(unique_id)s" in LOG_FORMAT
+    assert "%(analysis_id)s" in LOG_FORMAT
+    assert "%(unique_id)s" in PYTEST_LOG_FORMAT
+    assert "%(analysis_id)s" in PYTEST_LOG_FORMAT
+
+
+def test_log_context_filter_injects_defaults() -> None:
+    record = logging.LogRecord(
+        name="test",
+        level=logging.INFO,
+        pathname=__file__,
+        lineno=1,
+        msg="probe",
+        args=(),
+        exc_info=None,
+    )
+    assert LogContextFilter().filter(record) is True
+    assert record.unique_id == "-"
+    assert record.analysis_id == "-"
+
+
+def test_add_call_context_sets_unique_id_and_analysis_id(caplog) -> None:
+    seen: list[tuple[str, str]] = []
+
+    @AddCallContext
+    def _probe() -> None:
+        set_log_analysis_id("scenario_001")
+        logger = get_logger("test_add_call_context")
+        with caplog.at_level(logging.INFO, logger="test_add_call_context"):
+            logger.info("inside probe")
+        for record in caplog.records:
+            if record.name == "test_add_call_context":
+                seen.append((record.unique_id, record.analysis_id))
+
+    caplog.clear()
+    _probe()
+    assert len(seen) == 1
+    unique_id, analysis_id = seen[0]
+    assert unique_id != "-"
+    assert len(unique_id) == 12
+    assert analysis_id == "scenario_001"
+
+
+def test_add_call_context_resets_after_call() -> None:
+    @AddCallContext
+    def _probe() -> None:
+        set_log_analysis_id("scenario_001")
+
+    _probe()
+    record = logging.LogRecord(
+        name="test",
+        level=logging.INFO,
+        pathname=__file__,
+        lineno=1,
+        msg="probe",
+        args=(),
+        exc_info=None,
+    )
+    LogContextFilter().filter(record)
+    assert record.unique_id == "-"
+    assert record.analysis_id == "-"
+
+
+def test_add_call_context_and_log_fn_stack(caplog) -> None:
+    log = get_logger("test_stacked_annotations")
+
+    @AddCallContext
+    @LogFn(logger=log)
+    def _probe(value: str) -> str:
+        set_log_analysis_id("scenario_001")
+        return value.upper()
+
+    with caplog.at_level(logging.INFO, logger="test_stacked_annotations"):
+        assert _probe("abc") == "ABC"
+
+    records = [r for r in caplog.records if r.name == "test_stacked_annotations"]
+    assert len(records) == 2
+    assert records[0].message.startswith("call  _probe")
+    assert records[0].unique_id != "-"
+    assert records[0].analysis_id == "-"
+    assert records[1].message.startswith("return _probe -> str")
+    assert records[1].unique_id != "-"
+    assert records[1].analysis_id == "scenario_001"
+    assert records[0].unique_id == records[1].unique_id
+
+
+def test_configure_logging_formats_thread_name() -> None:
+    configure_logging(level=logging.INFO, force=True)
+    handler = logging.getLogger().handlers[0]
+    assert handler.formatter is not None
+    record = logging.LogRecord(
+        name="test",
+        level=logging.INFO,
+        pathname=__file__,
+        lineno=1,
+        msg="probe",
+        args=(),
+        exc_info=None,
+    )
+    LogContextFilter().filter(record)
+    formatted = handler.formatter.format(record)
+    assert f"[{record.threadName}]" in formatted
+    assert "[call=-]" in formatted
+    assert "[analysis=-]" in formatted
