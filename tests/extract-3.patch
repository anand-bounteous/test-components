+"""Phase 3 — payment-channel detector."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline.feature_extraction import (
+    PaymentChannelDetector,
+    load_feature_extraction_config,
+)
+from nw_agcore_bank_transactions.pipeline.normalization import default_service
+from nw_aglib_toolkit.pipeline.config import load_config
+
+tokenise = default_service().tokenise
+
+
+def _detect(description: str, *, source_bank: str | None = None):
+    cfg = load_config(source_bank=source_bank)
+    return PaymentChannelDetector(
+        app_config=cfg,
+        feature_config=load_feature_extraction_config(),
+    ).detect(tokenise(description.upper()))
+
+
+# --- Generic mapping ----------------------------------------------------
+
+
+def test_bacs_token_detected_as_bacs_or_direct_credit():
+    m = _detect("BACS CREDIT ACME LTD PAYROLL")
+    assert m.channel == "bacs_or_direct_credit"
+    assert "BACS" in m.matched_tokens
+
+
+def test_faster_payment_multi_word_token_detected():
+    m = _detect("FASTER PAYMENT FROM ACME")
+    assert m.channel == "faster_payment"
+    assert "FASTER PAYMENT" in m.matched_tokens
+
+
+def test_faster_payment_abbreviation_fps():
+    m = _detect("FPS ACME WAGES")
+    assert m.channel == "faster_payment"
+
+
+def test_chaps_full_word():
+    m = _detect("CHAPS RECEIPT ACME")
+    assert m.channel == "chaps"
+
+
+def test_cheque_chq_abbreviation():
+    m = _detect("CHQ FROM ACME")
+    assert m.channel == "cheque"
+
+
+def test_cash_counter_credit():
+    m = _detect("CASH COUNTER CREDIT")
+    assert m.channel == "cash_or_counter_credit"
+
+
+def test_internal_transfer_tfr():
+    m = _detect("TFR FROM OWN ACCOUNT")
+    assert m.channel == "internal_transfer"
+
+
+def test_international_credit_swift():
+    m = _detect("INTERNATIONAL SWIFT ACME INC")
+    assert m.channel == "international_credit"
+
+
+def test_unknown_returns_unknown_credit_with_low_confidence():
+    m = _detect("THIS DESCRIPTION HAS NO CHANNEL KEYWORD")
+    assert m.channel == "unknown_credit"
+    assert m.confidence < 0.5
+
+
+def test_empty_token_list_returns_unknown_credit():
+    cfg = load_config()
+    m = PaymentChannelDetector(
+        app_config=cfg,
+        feature_config=load_feature_extraction_config(),
+    ).detect(())
+    assert m.channel == "unknown_credit"
+    assert m.confidence == 0.0
+
+
+# --- Specificity ranking -------------------------------------------------
+
+
+def test_multi_word_token_outranks_single_word_match():
+    """A longer matched phrase wins over a competing single token."""
+    m = _detect("FASTER PAYMENT BACS")
+    # BACS is single-word; FASTER PAYMENT is multi-word — winner.
+    assert m.channel == "faster_payment"
+    assert "bacs_or_direct_credit" in m.alternative_channels
+
+
+def test_multi_word_match_higher_confidence_than_single_word():
+    multi = _detect("FASTER PAYMENT FROM ACME")
+    single = _detect("BACS ACME WAGES")
+    assert multi.confidence > single.confidence
+
+
+# --- Bank-specific overlays ---------------------------------------------
+
+
+def test_natwest_chp_recognised_as_chaps():
+    m = _detect("CHP ACME", source_bank="natwest")
+    assert m.channel == "chaps"
+    assert "CHP" in m.matched_tokens
+
+
+def test_natwest_bac_recognised_as_bacs():
+    m = _detect("BAC ACME LTD PAYROLL", source_bank="natwest")
+    assert m.channel == "bacs_or_direct_credit"
+
+
+def test_natwest_bgc_recognised_as_bacs():
+    m = _detect("BGC ACME LTD PAYROLL", source_bank="natwest")
+    assert m.channel == "bacs_or_direct_credit"
+
+
+def test_barclays_cre_recognised_as_bacs():
+    m = _detect("CRE ACME LTD PAYROLL", source_bank="barclays")
+    assert m.channel == "bacs_or_direct_credit"
+
+
+def test_barclays_rem_recognised_as_cheque():
+    m = _detect("REM CHQ ACME", source_bank="barclays")
+    assert m.channel == "cheque"
+
+
+def test_lloyds_bacs_token_still_works():
+    m = _detect("BACS ACME LTD PAYROLL", source_bank="lloyds")
+    assert m.channel == "bacs_or_direct_credit"
+
+
+def test_bank_overlay_bumps_confidence():
+    generic = _detect("BACS ACME")
+    with_bank = _detect("BACS ACME", source_bank="natwest")
+    assert with_bank.confidence > generic.confidence
+
+
+def test_unknown_bank_falls_back_silently():
+    m = _detect("BACS ACME", source_bank="not_a_real_bank")
+    assert m.channel == "bacs_or_direct_credit"
+
+
+# --- Word-boundary safety -----------------------------------------------
+
+
+def test_bac_does_not_match_inside_bacs():
+    """Tokens are matched at word boundaries, not as substrings.
+
+    'BAC' is a NatWest abbreviation but should not match against 'BACS' on
+    a generic mapping — both tokens land in their own canonical channel."""
+    m = _detect("BACS CREDIT ACME")  # generic config, no NatWest overlay
+    # Only BACS should match; BAC is not in generic config.
+    assert m.channel == "bacs_or_direct_credit"
+    assert "BAC" not in m.matched_tokens or "BACS" in m.matched_tokens
+
+
+# --- Ambiguity -----------------------------------------------------------
+
+
+def test_alternatives_listed_when_multiple_channels_match():
+    m = _detect("BACS CHAPS ACME LTD")
+    # Both single-word matches; arbitrary winner but alternatives populated.
+    assert m.channel in {"bacs_or_direct_credit", "chaps"}
+    assert len(m.alternative_channels) >= 1
