+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import RasterPage
+from nw_agcore_document_data_extractor.pipeline._models.Region import BBox, Region, RegionType
+
+_WORKER = Path(__file__).with_name("DoctrWorker.py")
+
+
+@dataclass
+class DoctrOutput:
+    regions_by_page: dict[int, list[Region]]
+    raw_result: dict
+    request_payload: dict
+
+
+class OcrService:
+    def run_doctr(self, pages: list[RasterPage]) -> DoctrOutput:
+        payload = {
+            "pages": [
+                {
+                    "page_index": p.page_index,
+                    "image_path": p.png_path,
+                    "width": p.width,
+                    "height": p.height,
+                    "dpi": p.dpi,
+                }
+                for p in pages
+            ]
+        }
+        proc = subprocess.run(
+            [sys.executable, str(_WORKER)],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        result = json.loads(proc.stdout)
+        regions_by_page: dict[int, list[Region]] = {}
+        for page_data in result["pages"]:
+            idx = page_data["page_index"]
+            regions: list[Region] = []
+            for r in page_data["regions"]:
+                b = r["bbox"]
+                regions.append(Region(
+                    type=RegionType(r["type"]),
+                    bbox=BBox(**b),
+                    text=r["text"],
+                    confidence=r["confidence"],
+                    source_tool=r["source_tool"],
+                    attributes=r.get("attributes", {}),
+                ))
+            regions_by_page[idx] = regions
+        return DoctrOutput(
+            regions_by_page=regions_by_page,
+            raw_result=result,
+            request_payload=payload,
+        )
