+"""Tests for TRACE request logging in the @tool wrapper."""
+
+from __future__ import annotations
+
+import json
+
+from nw_aglib_toolkit.channels.tools import get_tool_metadata, tool
+from nw_core.logging import TRACE, setup_trace
+
+
+def test_tool_wrapper_logs_linearized_request_at_trace(caplog) -> None:
+    setup_trace()
+
+    @tool(name="trace_sample", description="Trace sample tool.")
+    def trace_sample(payload: dict) -> dict:
+        return payload
+
+    logger_name = trace_sample.__module__
+    metadata = get_tool_metadata(trace_sample)
+    assert metadata is not None
+    assert metadata.return_type == "dict"
+
+    with caplog.at_level(TRACE, logger=logger_name):
+        trace_sample({"analysis_id": "x1", "value": 1})
+
+    trace_records = [record for record in caplog.records if record.levelno == TRACE]
+    assert trace_records
+    message = trace_records[-1].message
+    assert message.startswith("tool.request ")
+    payload = json.loads(message.removeprefix("tool.request "))
+    assert payload["tool"] == "trace_sample"
+    assert payload["kwargs"] == {}
+    assert payload["args"][0]["analysis_id"] == "x1"
