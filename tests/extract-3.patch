+from __future__ import annotations
+
+import uuid
+
+import fitz
+
+from nw_agcore_document_data_extractor.pipeline._models.Region import BBox, Region, RegionType
+from nw_agcore_document_data_extractor.pipeline._models.TableModel import TableCell, TableModel
+from nw_agcore_document_data_extractor.pipeline._services.CoordinateConverter import coord_space_label
+
+
+def _color_to_hex(color_int: int) -> str:
+    r = (color_int >> 16) & 0xFF
+    g = (color_int >> 8) & 0xFF
+    b = color_int & 0xFF
+    return f"#{r:02x}{g:02x}{b:02x}"
+
+
+class PyMuPdfExtractor:
+    def extract(self, pdf_path: str, *, dpi: int = 300) -> dict[int, list[Region]]:
+        doc = fitz.open(pdf_path)
+        results: dict[int, list[Region]] = {}
+        scale = dpi / 72.0
+        cs = coord_space_label(dpi)
+        try:
+            for page_idx, page in enumerate(doc):
+                regions: list[Region] = []
+                blocks = page.get_text("dict", flags=fitz.TEXT_PRESERVE_WHITESPACE)["blocks"]
+                for block in blocks:
+                    block_type = block.get("type", 0)
+                    if block_type == 1:
+                        x0, y0, x1, y1 = block["bbox"]
+                        regions.append(Region(
+                            type=RegionType.IMAGE,
+                            bbox=BBox(
+                                x=x0 * scale, y=y0 * scale,
+                                w=(x1 - x0) * scale, h=(y1 - y0) * scale,
+                                page_index=page_idx, coord_space=cs,
+                            ),
+                            text="",
+                            confidence=1.0,
+                            source_tool="pymupdf",
+                            attributes={"block_type": "image"},
+                        ))
+                        continue
+                    if block_type != 0:
+                        continue
+                    for line in block.get("lines", []):
+                        line_texts: list[str] = []
+                        line_bbox: list[float] | None = None
+                        attrs: dict = {}
+                        span_count = 0
+                        for span in line.get("spans", []):
+                            span_count += 1
+                            line_texts.append(span["text"])
+                            sb = span["bbox"]
+                            if line_bbox is None:
+                                line_bbox = list(sb)
+                            else:
+                                line_bbox[0] = min(line_bbox[0], sb[0])
+                                line_bbox[1] = min(line_bbox[1], sb[1])
+                                line_bbox[2] = max(line_bbox[2], sb[2])
+                                line_bbox[3] = max(line_bbox[3], sb[3])
+                            flags = span.get("flags", 0)
+                            attrs = {
+                                "span_count": span_count,
+                                "font": span.get("font", ""),
+                                "font_size": round(span.get("size", 0), 2),
+                                "font_color": _color_to_hex(span.get("color", 0)),
+                                "bold": bool(flags & 16),
+                                "italic": bool(flags & 2),
+                            }
+                        if not line_texts or line_bbox is None:
+                            continue
+                        x0, y0, x1, y1 = line_bbox
+                        regions.append(Region(
+                            type=RegionType.NORMAL_TEXT,
+                            bbox=BBox(
+                                x=x0 * scale, y=y0 * scale,
+                                w=(x1 - x0) * scale, h=(y1 - y0) * scale,
+                                page_index=page_idx, coord_space=cs,
+                            ),
+                            text=" ".join(line_texts).strip(),
+                            confidence=1.0,
+                            source_tool="pymupdf",
+                            attributes=attrs,
+                        ))
+                results[page_idx] = regions
+        finally:
+            doc.close()
+        return results
+
+    def extract_tables(self, pdf_path: str, *, dpi: int = 300) -> dict[int, list[tuple[Region, TableModel]]]:
+        doc = fitz.open(pdf_path)
+        results: dict[int, list[tuple[Region, TableModel]]] = {}
+        scale = dpi / 72.0
+        cs = coord_space_label(dpi)
+        try:
+            for page_idx, page in enumerate(doc):
+                pairs: list[tuple[Region, TableModel]] = []
+                try:
+                    finder = page.find_tables()
+                except Exception:
+                    results[page_idx] = pairs
+                    continue
+                for tbl in getattr(finder, "tables", None) or []:
+                    try:
+                        bbox_pts = tbl.bbox
+                        extracted = tbl.extract() or []
+                    except Exception:
+                        continue
+                    if not bbox_pts or len(bbox_pts) != 4:
+                        continue
+                    x1, y1, x2, y2 = (float(v) for v in bbox_pts)
+                    region_id = uuid.uuid4().hex[:10]
+                    table_bbox = BBox(
+                        x=x1 * scale, y=y1 * scale,
+                        w=(x2 - x1) * scale, h=(y2 - y1) * scale,
+                        page_index=page_idx, coord_space=cs,
+                    )
+                    region = Region(
+                        id=region_id,
+                        type=RegionType.TABLE,
+                        bbox=table_bbox,
+                        text="",
+                        confidence=1.0,
+                        source_tool="pymupdf",
+                        attributes={"detector": "pymupdf.find_tables"},
+                    )
+                    n_rows = len(extracted)
+                    n_cols = max((len(r) for r in extracted), default=0)
+                    cells: list[TableCell] = []
+                    rows_attr = getattr(tbl, "rows", None) or []
+                    for r_idx, row in enumerate(extracted):
+                        row_cell_rects = []
+                        if r_idx < len(rows_attr):
+                            row_cell_rects = getattr(rows_attr[r_idx], "cells", None) or []
+                        for c_idx, raw_text in enumerate(row):
+                            text = "" if raw_text is None else str(raw_text)
+                            cell_bbox = None
+                            if c_idx < len(row_cell_rects):
+                                rect = row_cell_rects[c_idx]
+                                if rect is not None and len(rect) == 4:
+                                    cx1, cy1, cx2, cy2 = (float(v) for v in rect)
+                                    cell_bbox = BBox(
+                                        x=cx1 * scale, y=cy1 * scale,
+                                        w=(cx2 - cx1) * scale, h=(cy2 - cy1) * scale,
+                                        page_index=page_idx, coord_space=cs,
+                                    )
+                            cells.append(TableCell(
+                                row=r_idx, col=c_idx, text=text,
+                                bbox=cell_bbox, multiline="\n" in text,
+                            ))
+                    pairs.append((region, TableModel(
+                        region_id=region_id,
+                        n_rows=n_rows, n_cols=n_cols,
+                        cells=cells, border_mode="mixed",
+                    )))
+                results[page_idx] = pairs
+        finally:
+            doc.close()
+        return results
