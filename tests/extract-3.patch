+"use client";
+
+import { useCallback, useMemo, useState } from "react";
+import type { CSSProperties } from "react";
+import type {
+  AnnotationKind,
+  BankStatementDocument,
+  PageAnnotation,
+} from "../../types";
+import { AnnotatedPageViewer } from "../AnnotatedPageViewer";
+import { AnnotationToolbar } from "../AnnotationToolbar";
+import { PageNavigator } from "../PageNavigator";
+import { AccountSummary } from "../AccountSummary";
+import { TransactionTable } from "../TransactionTable";
+
+export type BankStatementRendererProps = {
+  document: BankStatementDocument;
+  annotations?: PageAnnotation[];
+  onAnnotationsChange?: (annotations: PageAnnotation[]) => void;
+  onTransactionSelect?: (id: string) => void;
+  onAnnotationSelect?: (id: string) => void;
+  className?: string;
+};
+
+export function BankStatementRenderer({
+  document,
+  annotations: controlledAnnotations,
+  onAnnotationsChange,
+  onTransactionSelect,
+  onAnnotationSelect,
+  className,
+}: BankStatementRendererProps) {
+  const [currentPageIndex, setCurrentPageIndex] = useState(0);
+  const [internalAnnotations, setInternalAnnotations] = useState(
+    document.annotations,
+  );
+  const [hiddenKinds, setHiddenKinds] = useState<Set<AnnotationKind>>(
+    () => new Set(),
+  );
+  const [selectedAnnotationId, setSelectedAnnotationId] = useState<
+    string | null
+  >(null);
+  const [selectedTransactionId, setSelectedTransactionId] = useState<
+    string | null
+  >(null);
+
+  const annotations = controlledAnnotations ?? internalAnnotations;
+
+  const setAnnotations = useCallback(
+    (next: PageAnnotation[]) => {
+      if (controlledAnnotations === undefined) {
+        setInternalAnnotations(next);
+      }
+      onAnnotationsChange?.(next);
+    },
+    [controlledAnnotations, onAnnotationsChange],
+  );
+
+  const sortedPages = useMemo(
+    () => [...document.pages].sort((a, b) => a.pageIndex - b.pageIndex),
+    [document.pages],
+  );
+
+  const currentPage =
+    sortedPages[currentPageIndex] ?? sortedPages[0] ?? null;
+
+  const pageAnnotations = useMemo(
+    () =>
+      annotations.filter(
+        (annotation) => annotation.pageIndex === currentPage?.pageIndex,
+      ),
+    [annotations, currentPage?.pageIndex],
+  );
+
+  const handleAnnotationSelect = useCallback(
+    (annotationId: string) => {
+      setSelectedAnnotationId(annotationId);
+      onAnnotationSelect?.(annotationId);
+
+      const linkedTransaction = document.transactions.find(
+        (transaction) => transaction.annotationId === annotationId,
+      );
+      if (linkedTransaction) {
+        setSelectedTransactionId(linkedTransaction.id);
+        onTransactionSelect?.(linkedTransaction.id);
+      }
+    },
+    [document.transactions, onAnnotationSelect, onTransactionSelect],
+  );
+
+  const handleTransactionSelect = useCallback(
+    (transactionId: string) => {
+      setSelectedTransactionId(transactionId);
+      onTransactionSelect?.(transactionId);
+
+      const transaction = document.transactions.find(
+        (item) => item.id === transactionId,
+      );
+      if (!transaction) return;
+
+      if (transaction.annotationId) {
+        setSelectedAnnotationId(transaction.annotationId);
+        onAnnotationSelect?.(transaction.annotationId);
+      }
+
+      if (transaction.page !== undefined) {
+        const pageIdx = sortedPages.findIndex(
+          (page) => page.pageIndex === transaction.page! - 1,
+        );
+        if (pageIdx >= 0) {
+          setCurrentPageIndex(pageIdx);
+        } else if (transaction.page >= 1 && transaction.page <= sortedPages.length) {
+          setCurrentPageIndex(transaction.page - 1);
+        }
+      }
+    },
+    [
+      document.transactions,
+      onAnnotationSelect,
+      onTransactionSelect,
+      sortedPages,
+    ],
+  );
+
+  return (
+    <div
+      className={className}
+      style={styles.root}
+      data-testid="bank-statement-renderer"
+    >
+      <div style={styles.leftPanel}>
+        <PageNavigator
+          currentPageIndex={currentPageIndex}
+          totalPages={sortedPages.length}
+          onPageChange={setCurrentPageIndex}
+        />
+        <AnnotationToolbar
+          annotations={annotations}
+          hiddenKinds={hiddenKinds}
+          onHiddenKindsChange={setHiddenKinds}
+          onAnnotationsChange={setAnnotations}
+          selectedAnnotationId={selectedAnnotationId}
+        />
+        {currentPage ? (
+          <AnnotatedPageViewer
+            page={currentPage}
+            annotations={pageAnnotations}
+            hiddenKinds={hiddenKinds}
+            selectedAnnotationId={selectedAnnotationId}
+            onAnnotationSelect={handleAnnotationSelect}
+          />
+        ) : (
+          <div style={styles.emptyPage}>No page images available.</div>
+        )}
+      </div>
+      <div style={styles.rightPanel}>
+        <AccountSummary account={document.account} />
+        <TransactionTable
+          transactions={document.transactions}
+          selectedTransactionId={selectedTransactionId}
+          currency={document.account.currency}
+          onTransactionSelect={handleTransactionSelect}
+        />
+      </div>
+    </div>
+  );
+}
+
+const styles: Record<string, CSSProperties> = {
+  root: {
+    display: "grid",
+    gridTemplateColumns: "55fr 45fr",
+    height: "100vh",
+    minHeight: "480px",
+    fontFamily: "system-ui, -apple-system, sans-serif",
+    color: "#111827",
+    backgroundColor: "#ffffff",
+  },
+  leftPanel: {
+    display: "flex",
+    flexDirection: "column",
+    borderRight: "1px solid #e5e7eb",
+    minHeight: 0,
+    minWidth: 0,
+  },
+  rightPanel: {
+    display: "flex",
+    flexDirection: "column",
+    overflow: "auto",
+    minHeight: 0,
+    minWidth: 0,
+  },
+  emptyPage: {
+    flex: 1,
+    display: "flex",
+    alignItems: "center",
+    justifyContent: "center",
+    color: "#6b7280",
+    fontSize: "14px",
+  },
+};
