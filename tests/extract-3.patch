+"""Unit tests for anchor resolution helpers."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+from nw_agcore_bank_transactions.pipeline._models import BankTransaction, RawBankTransaction, TransactionFeatures
+from nw_agcore_bank_transactions.pipeline.hints.AnchorResolution import (
+    anchor_transaction_ids,
+    group_has_anchor,
+    use_anchor_enriched_features,
+)
+from nw_agcore_bank_transactions.pipeline.hints.models import AnchorMatch, AppliedHints
+
+
+def _txn(tid: str) -> BankTransaction:
+    raw = RawBankTransaction(id=tid, date="2024-01-15", description="ACME", credit_amount="2500")
+    return BankTransaction(raw=raw, normalised_description="ACME", description_tokens=("ACME",), skeleton="ACME")
+
+
+@pytest.mark.unit
+def test_use_anchor_enriched_features_defaults_true():
+    class _Cfg:
+        data = {"processing": {}}
+
+    assert use_anchor_enriched_features(_Cfg()) is True
+
+
+@pytest.mark.unit
+def test_anchor_transaction_ids_from_features():
+    features = {
+        "t1": TransactionFeatures(transaction_id="t1", payment_channel="bacs", payment_channel_confidence=0.5, is_anchor=True),
+        "t2": TransactionFeatures(transaction_id="t2", payment_channel="bacs", payment_channel_confidence=0.5, is_anchor=False),
+    }
+    ids = anchor_transaction_ids(None, features, use_feature_flags=True)
+    assert ids == frozenset({"t1"})
+
+
+@pytest.mark.unit
+def test_anchor_transaction_ids_from_applied_hints():
+    hints = AppliedHints(
+        anchors=(
+            AnchorMatch(
+                hint_id="h1",
+                transaction_id="t9",
+                month="2024-01",
+                amount=Decimal("2500"),
+            ),
+        )
+    )
+    ids = anchor_transaction_ids(hints, {}, use_feature_flags=False)
+    assert ids == frozenset({"t9"})
+
+
+@pytest.mark.unit
+def test_group_has_anchor_true_when_overlap():
+    features = {
+        "t1": TransactionFeatures(transaction_id="t1", payment_channel="bacs", payment_channel_confidence=0.5, is_anchor=True),
+    }
+    assert group_has_anchor([_txn("t1")], None, features, use_feature_flags=True) is True
+    assert group_has_anchor([_txn("t2")], None, features, use_feature_flags=True) is False
