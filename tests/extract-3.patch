@@ -0,0 +1,277 @@
+"""Function-call logging decorator with accurate source locations.
+
+``LogFn`` emits INFO/TRACE before execution and INFO/TRACE/ERROR after.
+Log records are anchored to the wrapped function's source file and
+definition line, not the wrapper defined in this module.
+"""
+
+from __future__ import annotations
+
+import functools
+import inspect
+import json
+import logging
+import sys
+import time
+import types
+from collections.abc import Callable, Mapping
+from dataclasses import fields, is_dataclass
+from datetime import date, datetime
+from decimal import Decimal
+from enum import Enum
+from typing import Any, ParamSpec, TypeVar
+
+from .Logging import TRACE
+
+P = ParamSpec("P")
+R = TypeVar("R")
+
+_MAX_LINEARIZE_ITEMS = 25
+_MAX_LINEARIZE_DEPTH = 8
+
+
+def _code_for(obj: types.CodeType | Callable[..., Any]) -> types.CodeType:
+    if isinstance(obj, types.CodeType):
+        return obj
+    code = getattr(obj, "__code__", None)
+    if code is None:
+        raise TypeError("expected a function or code object")
+    return code
+
+
+def log_at(
+    logger: logging.Logger,
+    level: int,
+    code: types.CodeType | Callable[..., Any],
+    msg: str,
+    *args: Any,
+    exc_info: Any = None,
+) -> None:
+    """Emit a log record at *code*'s file/line instead of the caller's."""
+    if not logger.isEnabledFor(level):
+        return
+    code_obj = _code_for(code)
+    if exc_info is True:
+        exc_info = sys.exc_info()
+    record = logger.makeRecord(
+        logger.name,
+        level,
+        code_obj.co_filename,
+        code_obj.co_firstlineno,
+        msg,
+        args,
+        exc_info,
+    )
+    logger.handle(record)
+
+
+def _function_label(code: types.CodeType) -> str:
+    # return f"{code.co_name} ({code.co_filename}:{code.co_firstlineno})"
+    return f"{code.co_name}"
+
+
+def linearize_for_log(
+    value: Any,
+    *,
+    depth: int = 0,
+    max_depth: int = _MAX_LINEARIZE_DEPTH,
+    max_items: int = _MAX_LINEARIZE_ITEMS,
+) -> Any:
+    """Convert arbitrary call/return values into JSON-serialisable structures."""
+    if depth >= max_depth:
+        return {"_truncated": type(value).__qualname__}
+
+    if value is None or isinstance(value, (bool, int, float)):
+        return value
+
+    if isinstance(value, str):
+        return value
+
+    if isinstance(value, bytes):
+        return value.decode("utf-8", errors="replace")
+
+    if isinstance(value, Decimal):
+        return str(value)
+
+    if isinstance(value, (datetime, date)):
+        return value.isoformat()
+
+    if isinstance(value, Enum):
+        return value.value
+
+    if is_dataclass(value):
+        return {
+            field.name: linearize_for_log(
+                getattr(value, field.name),
+                depth=depth + 1,
+                max_depth=max_depth,
+                max_items=max_items,
+            )
+            for field in fields(value)
+        }
+
+    if isinstance(value, Mapping):
+        return {
+            str(key): linearize_for_log(
+                item,
+                depth=depth + 1,
+                max_depth=max_depth,
+                max_items=max_items,
+            )
+            for key, item in value.items()
+        }
+
+    if isinstance(value, (list, tuple)):
+        return _linearize_sequence(value, depth=depth, max_depth=max_depth, max_items=max_items)
+
+    if isinstance(value, (set, frozenset)):
+        return _linearize_sequence(
+            sorted(value, key=lambda item: repr(item)),
+            depth=depth,
+            max_depth=max_depth,
+            max_items=max_items,
+        )
+
+    if inspect.isgenerator(value):
+        return {"_type": type(value).__qualname__, "_note": "generator (not materialised)"}
+
+    if hasattr(value, "__iter__") and not isinstance(value, (str, bytes, Mapping)):
+        try:
+            materialised = list(value)
+        except Exception:
+            return {"_type": type(value).__name__}
+        return _linearize_sequence(
+            materialised,
+            depth=depth,
+            max_depth=max_depth,
+            max_items=max_items,
+        )
+
+    return {"_type": type(value).__name__}
+
+
+def _linearize_sequence(
+    values: Any,
+    *,
+    depth: int,
+    max_depth: int,
+    max_items: int,
+) -> list[Any]:
+    out: list[Any] = []
+    total = len(values)
+    for index, item in enumerate(values):
+        if index >= max_items:
+            out.append(f"... {total - max_items} more")
+            break
+        out.append(
+            linearize_for_log(
+                item,
+                depth=depth + 1,
+                max_depth=max_depth,
+                max_items=max_items,
+            )
+        )
+    return out
+
+
+def _json_payload(value: Any) -> str:
+    linearized = linearize_for_log(value)
+    try:
+        return json.dumps(linearized, ensure_ascii=True, separators=(",", ":"))
+    except Exception as exc:  # pragma: no cover - defensive
+        return json.dumps({"serialization_error": str(exc)}, ensure_ascii=True)
+
+
+def _call_log_payload(
+    wrapped: Callable[..., Any],
+    args: tuple[Any, ...],
+    kwargs: dict[str, Any],
+) -> dict[str, Any]:
+    log_args = args
+    try:
+        params = list(inspect.signature(wrapped).parameters.values())
+    except (TypeError, ValueError):
+        params = []
+    if params and params[0].name == "self" and args:
+        log_args = args[1:]
+
+    return {
+        "args": linearize_for_log(log_args),
+        "kwargs": linearize_for_log(kwargs),
+    }
+
+
+def LogFn[**P, R](
+    func: Callable[P, R] | None = None,
+    *,
+    logger: logging.Logger | None = None,
+) -> Callable[[Callable[P, R]], Callable[P, R]] | Callable[P, R]:
+    """Decorator — structured call/return logging with execution timing."""
+
+    def decorator(wrapped: Callable[P, R]) -> Callable[P, R]:
+        log = logger or logging.getLogger(wrapped.__module__)
+        code = wrapped.__code__
+        label = _function_label(code)
+
+        @functools.wraps(wrapped)
+        def wrapper(*args: P.args, **kwargs: P.kwargs) -> R:
+            if log.isEnabledFor(TRACE):
+                payload = _call_log_payload(wrapped, args, kwargs)
+                log_at(
+                    log,
+                    TRACE,
+                    code,
+                    "call  %s  args=%s  kwargs=%s",
+                    label,
+                    _json_payload(payload["args"]),
+                    _json_payload(payload["kwargs"]),
+                )
+            elif log.isEnabledFor(logging.INFO):
+                log_at(log, logging.INFO, code, "call  %s", label)
+
+            started = time.perf_counter()
+            try:
+                result = wrapped(*args, **kwargs)
+            except Exception:
+                elapsed_ms = round((time.perf_counter() - started) * 1000.0, 3)
+                log_at(
+                    log,
+                    logging.ERROR,
+                    code,
+                    "error %s  elapsed_ms=%.3f",
+                    label,
+                    elapsed_ms,
+                    exc_info=True,
+                )
+                raise
+
+            elapsed_ms = round((time.perf_counter() - started) * 1000.0, 3)
+            result_type = type(result).__name__
+            if log.isEnabledFor(TRACE):
+                log_at(
+                    log,
+                    TRACE,
+                    code,
+                    "return %s -> %s  elapsed_ms=%.3f  result=%s",
+                    code.co_name,
+                    result_type,
+                    elapsed_ms,
+                    _json_payload(result),
+                )
+            elif log.isEnabledFor(logging.INFO):
+                log_at(
+                    log,
+                    logging.INFO,
+                    code,
+                    "return %s -> %s  elapsed_ms=%.3f",
+                    code.co_name,
+                    result_type,
+                    elapsed_ms,
+                )
+            return result
+
+        return wrapper
+
+    if func is not None:
+        return decorator(func)
+    return decorator
