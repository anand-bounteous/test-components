+"""Unit tests for application-specific description signals."""
+
+from __future__ import annotations
+
+from nw_agcore_bank_transactions.pipeline.feature_extraction.DescriptionFeatureExtractor import (
+    DescriptionFeatureExtractor,
+)
+from nw_agcore_bank_transactions.pipeline.feature_extraction.models import (
+    DescriptionSignalConfig,
+    load_feature_extraction_config,
+)
+from nw_aglib_toolkit.pipeline.config import load_config
+
+
+def test_rent_signals_mark_rental_positive_not_negative():
+    signals = DescriptionSignalConfig.from_flat_keywords(
+        ("RENT", "RENTAL", "RENTAL INCOME", "LANDLORD"),
+        ("DEPOSIT REFUND", "CASHBACK"),
+    )
+    extractor = DescriptionFeatureExtractor(
+        app_config=load_config(),
+        feature_config=load_feature_extraction_config(),
+        description_signals=signals,
+    )
+    result = extractor.extract(("RENTAL", "INCOME", "14", "HIGH", "ST"))
+    assert "RENTAL INCOME" in result.salary_hint_tokens or "RENTAL" in result.salary_hint_tokens
+    assert "RENTAL" not in result.negative_tokens
+    assert "RENTAL INCOME" not in result.negative_tokens
+
+
+def test_salary_signals_mark_rental_as_negative():
+    signals = DescriptionSignalConfig.from_tiered_mapping(
+        {"strong": ("PAYROLL", "SALARY")},
+        {"property_income": ("RENT", "RENTAL", "RENTAL INCOME")},
+    )
+    extractor = DescriptionFeatureExtractor(
+        app_config=load_config(),
+        feature_config=load_feature_extraction_config(),
+        description_signals=signals,
+    )
+    result = extractor.extract(("RENTAL", "INCOME", "14", "HIGH", "ST"))
+    assert "RENTAL INCOME" in result.negative_tokens or "RENTAL" in result.negative_tokens
