+
+
+def run_img2table_doctr(
+    pdf_path: Path,
+    *,
+    run_dir: Path,
+    raster_pages: list[RasterPage],
+    pdf_kind: str = "unknown",
+    dpi: int = 300,
+) -> ExtractorResult:
+    audit = AuditRecorder()
+    table_service = TableExtractionService()
+    with audit.time("tables_img2table_doctr", "img2table", inputs=[p.png_path for p in raster_pages]):
+        img_output = table_service.extract(raster_pages, ocr_backend="doctr")
+    pages = build_document_pages(
+        raster_pages,
+        pdf_kind=pdf_kind,  # type: ignore[arg-type]
+        tables_by_page=img_output.tables_by_page,
+        table_regions_by_page=img_output.regions_by_page,
+    )
+    for page in pages:
+        page.full_text = ""
+    result = ExtractorResult(
+        extractor_name="img2table_doctr",
+        status="ok",
+        pages=pages,
+        audit=list(audit.steps),
