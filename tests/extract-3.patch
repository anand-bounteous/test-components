+"""Caller-supplied bank transaction record — Design §4.1."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
+
+Amount = int | float | Decimal | str
+
+
+def _amount_as_decimal(value: Amount) -> Decimal | None:
+    if isinstance(value, Decimal):
+        return value
+    try:
+        return Decimal(str(value))
+    except (InvalidOperation, ValueError, TypeError):
+        return None
+
+
+@dataclass(frozen=True)
+class RawBankTransaction:
+    """Raw transaction as received from the caller payload.
+
+    Amounts are split into independent debit and credit columns (statement
+    layout). Salary detection consumes credit rows only; debit rows and balance
+    marker rows (brought-forward / final balance) are filtered at validation.
+
+    Amount fields accept loose caller values; validation normalises them to
+    ``Decimal``.
+    """
+
+    id: str
+    date: str
+    description: str = ""
+    debit_amount: Amount = 0
+    credit_amount: Amount = 0
+    balance: Amount | None = None
+    reference: str | None = None
+    page: int | None = None
+    line: int | None = None
+    is_brought_forward: bool = False
+    is_final_balance: bool = False
+
+    @property
+    def is_credit(self) -> bool:
+        credit = _amount_as_decimal(self.credit_amount)
+        debit = _amount_as_decimal(self.debit_amount)
+        if credit is None or debit is None:
+            return False
+        return credit > 0 and debit == 0
+
+    @property
+    def is_debit(self) -> bool:
+        credit = _amount_as_decimal(self.credit_amount)
+        debit = _amount_as_decimal(self.debit_amount)
+        if credit is None or debit is None:
+            return False
+        return debit > 0 and credit == 0
+
+    @property
+    def is_balance_marker(self) -> bool:
+        return self.is_brought_forward or self.is_final_balance
