+from __future__ import annotations
+
+import tempfile
+
+from nw_agcore_document_data_extractor.pipeline._models.DocumentPage import DocumentPage
+from nw_agcore_document_data_extractor.pipeline._models.requests.DocumentExtractionRequest import DocumentExtractionRequest
+from nw_agcore_document_data_extractor.pipeline._models.results.DocumentExtractionResult import DocumentExtractionResult
+from nw_agcore_document_data_extractor.pipeline.ocr import run_ocr_pages
+from nw_agcore_document_data_extractor.pipeline.rasterization import run_rasterize_pdf
+from nw_agcore_document_data_extractor.pipeline.table_extraction import run_extract_tables
+from nw_agcore_document_data_extractor.pipeline.text_extraction import run_extract_native_tables, run_extract_text
+
+
+def run_extract_document(request: DocumentExtractionRequest) -> DocumentExtractionResult:
+    stages = set(request.stages)
+    artifacts_dir = request.artifacts_dir or tempfile.mkdtemp(prefix="doc_extract_")
+    warnings: list[str] = []
+
+    # Stage 1: Rasterize — always required; provides PNG pages for downstream stages
+    raster_pages = run_rasterize_pdf(request.pdf_path, artifacts_dir, dpi=request.dpi)
+    page_map: dict[int, DocumentPage] = {
+        p.page_index: DocumentPage(
+            page_index=p.page_index,
+            width=p.width,
+            height=p.height,
+            dpi=p.dpi,
+            pdf_kind=request.pdf_kind,
+            page_image_ref=p.png_path,
+        )
+        for p in raster_pages
+    }
+
+    # Stage 2: Native text extraction (PyMuPDF) + PDFPlumber table detection
+    if "text" in stages:
+        text_regions = run_extract_text(request.pdf_path, dpi=request.dpi)
+        native_tables = run_extract_native_tables(request.pdf_path, dpi=request.dpi)
+        for idx, regions in text_regions.items():
+            page_map[idx].regions.extend(regions)
+            page_map[idx].full_text = "\n".join(r.text for r in regions if r.text)
+        for idx, tables in native_tables.items():
+            page_map[idx].tables.extend(tables)
+
+    # Stage 3: Doctr OCR — run for scanned/mixed/unknown PDFs
+    if "ocr" in stages and request.pdf_kind in ("scanned", "mixed", "unknown"):
+        try:
+            ocr_regions = run_ocr_pages(raster_pages)
+            for idx, regions in ocr_regions.items():
+                page_map[idx].regions.extend(regions)
+        except Exception as exc:
+            warnings.append(f"OCR stage failed: {exc}")
+
+    # Stage 4: img2table vision-based table extraction
+    if "tables" in stages:
+        try:
+            img_tables = run_extract_tables(raster_pages)
+            for idx, tables in img_tables.items():
+                page_map[idx].tables.extend(tables)
+        except Exception as exc:
+            warnings.append(f"Table extraction stage failed: {exc}")
+
+    return DocumentExtractionResult(pages=list(page_map.values()), warnings=warnings)
