+        positive_keywords=rent_positive_keywords,
+        negative_keywords=rent_negative_keywords,
+        hint_matcher=rent_hint_matcher,
+        rent_hint_cfg=rent_hint_cfg or {},
+    )
+    return ScoringToolResult(scored=tuple(scored), inferred_regions=(), warnings=())
+
+
