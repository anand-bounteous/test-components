+    accum.apply_delta(
+        stage="negative_signal_penalty",
+        amount=-0.05,
+        max_value=-0.20,
+        reasoning="test penalty",
+    )
+    assert accum.running == 0.2
+    assert len(accum.steps) == 2
+    assert accum.steps[1].step == "negative_signal_penalty"
