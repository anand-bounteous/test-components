+import type {
+  AnnotationKind,
+  AnnotationSource,
+  ExtractionPageResult,
+  ExtractionRegion,
+  NormalizedBBox,
+  PageAnnotation,
+  StatementPage,
+} from "../types";
+
+function regionKind(type: string): AnnotationKind {
+  switch (type) {
+    case "table":
+      return "table";
+    case "image":
+      return "image";
+    case "logo":
+      return "logo";
+    case "handwriting_signature":
+      return "signature";
+    case "normal_text":
+      return "text";
+    default:
+      return "layout";
+  }
+}
+
+function sourceFromTool(tool: string): AnnotationSource | undefined {
+  if (tool === "pymupdf") return "pymupdf";
+  if (tool === "pdfplumber") return "pdfplumber";
+  if (tool === "doctr") return "doctr";
+  if (tool === "img2table") return "img2table";
+  return undefined;
+}
+
+export function pixelBBoxToNormalized(
+  bbox: { x: number; y: number; w: number; h: number },
+  width: number,
+  height: number,
+): NormalizedBBox {
+  return {
+    x1: bbox.x / width,
+    y1: bbox.y / height,
+    x2: (bbox.x + bbox.w) / width,
+    y2: (bbox.y + bbox.h) / height,
+  };
+}
+
+export function regionToAnnotation(
+  region: ExtractionRegion,
+  page: ExtractionPageResult,
+): PageAnnotation {
+  return {
+    id: region.id,
+    pageIndex: page.pageIndex,
+    kind: regionKind(region.type),
+    label: region.type,
+    bbox: pixelBBoxToNormalized(region.bbox, page.width, page.height),
+    confidence: region.confidence,
+    source: sourceFromTool(region.source_tool),
+    metadata: region.attributes,
+  };
+}
+
+export function extractionPageToViewer(
+  page: ExtractionPageResult,
+): { statementPage: StatementPage; annotations: PageAnnotation[] } {
+  const statementPage: StatementPage = {
+    pageIndex: page.pageIndex,
+    imageUrl: page.pageImageUrl,
+    width: page.width,
+    height: page.height,
+  };
+  const annotations = page.regions.map((region) => regionToAnnotation(region, page));
+  return { statementPage, annotations };
+}
