+"""Rent recurrence scoring profile."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from nw_aglib_toolkit.pipeline.config import AppConfig
+from nw_core.calendar import WorkingDayCalendar
+
+from nw_agcore_bank_transactions.pipeline._models import (
+    BankTransaction,
+    CandidateSet,
+    CandidateTransaction,
+    TransactionFeatures,
+)
+from nw_agcore_bank_transactions.pipeline.hints.EmployerHintMatcher import employer_hint_bonus
+from nw_agcore_bank_transactions.pipeline.hints.matchers import RentHintMatcher
+from nw_agcore_bank_transactions.pipeline.hints.matchers.KeywordsMatcher import rent_keyword_score
+from nw_agcore_bank_transactions.pipeline.hints.matchers.RentMatcher import amount_matches
+from nw_agcore_bank_transactions.pipeline.hints.models import AppliedHints, EmployerHints, RentHints
+from nw_agcore_bank_transactions.pipeline.hints.models.HintConfig import load_hint_config
+from nw_agcore_bank_transactions.pipeline.scoring.ConfidenceAccumulator import ConfidenceAccumulator
+from nw_agcore_bank_transactions.pipeline.scoring.ScoringService import (
+    compute_score,
+    confidence_band,
+    description_score,
+)
+
+
+def _cluster_for_candidate(
+    candidate: CandidateSet,
+    normalised_by_id: dict[str, BankTransaction],
+) -> list[BankTransaction]:
+    cluster: list[BankTransaction] = []
+    for txn in candidate.transactions:
+        row = normalised_by_id.get(txn.transaction_id)
+        if row is not None:
+            cluster.append(row)
+    return cluster
+
+
+def _rent_date_score(
+    cluster: Sequence[BankTransaction],
+    *,
+    target_day: int,
+    tolerance_days: int,
+    gap_min: int,
+    gap_max: int,
+) -> float:
+    if len(cluster) < 2:
+        return 0.0
+    in_window = sum(1 for t in cluster if abs(t.date.day - target_day) <= tolerance_days)
+    window_score = in_window / len(cluster)
+    sorted_dates = sorted(t.date for t in cluster)
+    gaps = [(sorted_dates[i + 1] - sorted_dates[i]).days for i in range(len(sorted_dates) - 1)]
+    if not gaps:
+        return window_score * 0.5
+    good_gaps = sum(1 for g in gaps if gap_min <= g <= gap_max)
+    gap_score = good_gaps / len(gaps)
+    return round(min(1.0, 0.6 * window_score + 0.4 * gap_score), 6)
+
+
+def _classify_rent_type(confidence: float, *, monthly: bool, thresholds: Mapping[str, Any]) -> str:
+    probable = float(thresholds.get("probable_rent", 0.55))
+    possible = float(thresholds.get("possible_rent", 0.40))
+    if confidence >= probable and monthly:
+        return "probable_rent"
+    if confidence >= possible:
+        return "possible_rent"
+    return "recurring_income_not_rent"
+
+
+def _rent_amount_modifier(cluster: Sequence[BankTransaction], hint_inputs: RentHints) -> float:
+    if hint_inputs.amount is None:
+        return 1.0
+    tolerance = hint_inputs.tolerance_pct
+    if any(amount_matches(t.amount, hint_inputs.amount, tolerance) for t in cluster):
+        return 1.0
+    return 0.75
+
+
+def _to_rent_transactions(
+    candidate: CandidateSet,
+    *,
+    confidence: float,
+    band: str,
+    confidence_details: tuple,
+) -> tuple[CandidateTransaction, ...]:
+    return tuple(
+        CandidateTransaction(
+            date=t.date,
+            description=t.description,
+            amount=t.amount,
+            transaction_id=t.transaction_id,
+            confidence=confidence,
+            confidence_band=band,
+            reasoning=t.reasoning,
+            confidence_details=confidence_details,
+        )
+        for t in candidate.transactions
+    )
+
+
+def score_rent_pool(
+    pool: Sequence[CandidateSet],
+    *,
+    normalised: Sequence[BankTransaction],
+    features_by_id: Mapping[str, TransactionFeatures],
+    calendar: WorkingDayCalendar,
+    config: AppConfig,
+    hint_inputs: RentHints,
+    applied_hints: AppliedHints,
+    weights: Mapping[str, float],
+    thresholds: Mapping[str, Any],
+    candidate_generation: Mapping[str, Any],
+    positive_keywords: Sequence[str],
+    negative_keywords: Sequence[str],
+    hint_matcher: RentHintMatcher,
+    rent_hint_cfg: Mapping[str, Any],
+) -> list[CandidateSet]:
+    rent_applied = applied_hints.rent
+    normalised_by_id = {t.id: t for t in normalised}
+    hint_cfg = load_hint_config()
+    target_day = hint_inputs.target_day_of_month
+    tolerance_days = hint_inputs.tolerance_days
+    gap_min = int(candidate_generation.get("monthly_gap_days_min", 21))
+    gap_max = int(candidate_generation.get("monthly_gap_days_max", 35))
+
+    scored: list[CandidateSet] = []
+    for candidate in pool:
+        cluster = _cluster_for_candidate(candidate, normalised_by_id)
+        if len(cluster) < 2:
+            continue
+
+        breakdown, inputs, _details = compute_score(
+            cluster,
+            features_by_id,
+            calendar=calendar,
+            config=config,
+        )
+        date_score = _rent_date_score(
+            cluster,
+            target_day=target_day,
+            tolerance_days=tolerance_days,
+            gap_min=gap_min,
+            gap_max=gap_max,
+        )
+        desc_score = description_score(cluster, features_by_id)
+        keyword_score = max(
+            rent_keyword_score(t.normalised_description, positive_keywords, negative_keywords)
+            for t in cluster
+        )
+        rentee_bonus = 0.0
+        if hint_inputs.rentee_name:
+            employer = EmployerHints(current_employer=hint_inputs.rentee_name)
+            tokens = frozenset(tok for t in cluster for tok in t.description_tokens)
+            rentee_bonus = employer_hint_bonus(tokens, employer, hint_cfg)
+
+        amount_modifier = _rent_amount_modifier(cluster, hint_inputs)
+        w_date = weights.get("date_pattern_score", 0.35)
+        w_desc = weights.get("description_similarity_score", 0.15)
+        w_amount = weights.get("amount_consistency_score", 0.35)
+        w_channel = weights.get("payment_channel_score", 0.05)
+        w_cov = weights.get("coverage_score", 0.10)
+        w_keyword = 0.10
+
+        accum = ConfidenceAccumulator(candidate_id=candidate.candidate_set_id)
+        accum.apply_delta(
+            stage="rent_date_pattern",
+            amount=round(w_date * date_score, 6),
+            max_value=round(w_date, 6),
+            reasoning="Rent calendar-day window and monthly gap fit",
+            data={"weight": w_date, "sub_score": date_score, "target_day": target_day},
+        )
+        accum.apply_delta(
+            stage="description_similarity",
+            amount=round(w_desc * desc_score, 6),
+            max_value=round(w_desc, 6),
+            reasoning="Description token similarity across rent cluster",
+            data={"weight": w_desc, "sub_score": desc_score},
+        )
+        accum.apply_delta(
+            stage="amount_consistency",
+            amount=round(w_amount * breakdown.amount_consistency_score, 6),
+            max_value=round(w_amount, 6),
+            reasoning="Amount consistency across rent cluster",
+            data={"weight": w_amount, "sub_score": breakdown.amount_consistency_score},
+        )
+        accum.apply_delta(
+            stage="payment_channel",
+            amount=round(w_channel * breakdown.payment_channel_score, 6),
+            max_value=round(w_channel, 6),
+            reasoning="Payment channel signal",
+            data={"weight": w_channel, "sub_score": breakdown.payment_channel_score},
+        )
+        accum.apply_delta(
+            stage="coverage",
+            amount=round(w_cov * breakdown.coverage_score, 6),
+            max_value=round(w_cov, 6),
+            reasoning="Period coverage ratio",
+            data={"weight": w_cov, "sub_score": breakdown.coverage_score},
+        )
+        accum.apply_delta(
+            stage="rent_keyword_score",
+            amount=round(w_keyword * keyword_score, 6),
+            max_value=round(w_keyword, 6),
+            reasoning="Rent keyword match in cluster descriptions",
+            data={"weight": w_keyword, "sub_score": keyword_score},
+        )
+        if rentee_bonus:
+            accum.apply_delta(
+                stage="rentee_hint_bonus",
+                amount=round(rentee_bonus, 6),
+                max_value=round(rentee_bonus, 6),
+                reasoning="Rentee name hint overlap",
+                data={"rentee_name": hint_inputs.rentee_name},
+            )
+        if breakdown.negative_signal_penalty:
+            accum.apply_delta(
+                stage="negative_signal_penalty",
+                amount=round(breakdown.negative_signal_penalty, 6),
+                max_value=round(breakdown.negative_signal_penalty, 6),
+                reasoning="Application negative description signals",
+                data={"penalty": breakdown.negative_signal_penalty},
+            )
+        if amount_modifier != 1.0:
+            accum.multiply(
+                stage="rent_amount_modifier",
+                factor=amount_modifier,
+                reasoning="Rent hint amount mismatch modifier",
+                data={"modifier": amount_modifier},
+            )
+        final_score = accum.running
+
+        if rent_applied is not None:
+            if rent_applied.rentee_match_level == "exact" and final_score >= float(
+                rent_hint_cfg.get("rentee_match_min_base_score", 0.45)
+            ):
+                floor = float(rent_hint_cfg.get("rentee_exact_match_floor", 0.92))
+                accum.set_running(
+                    stage="rentee_exact_match_floor",
+                    target=max(final_score, floor),
+                    max_value=floor,
+                    reasoning="Rentee exact match confidence floor",
+                    data={"match_level": "exact", "floor": floor},
+                )
+                final_score = accum.running
+            elif rent_applied.rentee_match_level == "partial" and final_score >= float(
+                rent_hint_cfg.get("rentee_match_min_base_score", 0.45)
+            ):
+                floor = float(rent_hint_cfg.get("rentee_partial_match_floor", 0.85))
+                accum.set_running(
+                    stage="rentee_partial_match_floor",
+                    target=max(final_score, floor),
+                    max_value=floor,
+                    reasoning="Rentee partial match confidence floor",
+                    data={"match_level": "partial", "floor": floor},
+                )
+                final_score = accum.running
+
+        confidence_details = accum.as_tuple()
+
+        monthly = inputs.recurrence.model.value.startswith("monthly") or date_score >= 0.5
+        candidate_type = _classify_rent_type(final_score, monthly=monthly, thresholds=thresholds)
+        band = confidence_band(final_score)
+
+        property_match_level = (
+            rent_applied.property_match_level if rent_applied is not None else "none"
+        )
+        rentee_match_level = rent_applied.rentee_match_level if rent_applied is not None else "none"
+        score_breakdown = {
+            "date_pattern_score": date_score,
+            "description_similarity_score": desc_score,
+            "amount_consistency_score": breakdown.amount_consistency_score,
+            "payment_channel_score": breakdown.payment_channel_score,
+            "coverage_score": breakdown.coverage_score,
+            "rent_keyword_score": keyword_score,
+            "rentee_hint_bonus": rentee_bonus,
+            "property_hint_bonus": 0.10 if property_match_level != "none" else 0.0,
+            "negative_signal_penalty": breakdown.negative_signal_penalty,
+            "rent_amount_modifier": amount_modifier,
+            "final_score": final_score,
+        }
+        detected_pattern = {
+            "frequency": "monthly" if monthly else "unknown",
+            "payday_model": "calendar_day_window",
+            "target_day_of_month": target_day,
+            "tolerance_days": tolerance_days,
+            "amount_model": inputs.amount.model.value,
+            "possible_tenant_tokens": tuple(
+                sorted({tok for t in cluster for tok in t.description_tokens})[:5]
+            ),
+            "coverage": inputs.recurrence.coverage
+            if hasattr(inputs.recurrence, "coverage")
+            else "",
+        }
+        scored.append(
+            CandidateSet(
+                candidate_set_id=candidate.candidate_set_id,
+                candidate_type=candidate_type,
+                transactions=_to_rent_transactions(
+                    candidate,
+                    confidence=final_score,
+                    band=band,
+                    confidence_details=confidence_details,
+                ),
+                score_breakdown=score_breakdown,
+                detected_pattern=detected_pattern,
+                reasoning=candidate.reasoning,
+                risks=candidate.risks,
+                confidence=final_score,
+                confidence_band=band,
+                confidence_details=confidence_details,
+                metadata={
+                    **candidate.metadata,
+                    "rentee_match_level": rentee_match_level,
+                    "property_match_level": property_match_level,
+                },
+            )
+        )
+    return scored
