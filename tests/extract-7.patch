@@ -0,0 +1,255 @@
+"""Result objects returned by the engine."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+# Operators that only look at the left operand; the right side is ignored.
+# These also handle a missing left value themselves, so the engine must not
+# short-circuit them when the operand could not be resolved — for the presence
+# operators, "could not be resolved" *is* the answer.
+UNARY_OPERATORS = {"not_empty", "is_empty", "is_present", "not_present"}
+
+
+# Flat operand sources, mapped to the prefix used when naming them in a report
+# (e.g. APPLICATION + "currency" -> "application.currency").
+FLAT_SOURCE_PREFIXES = {
+    "APPLICATION": "application",
+    "USER_STATEMENT": "user_statement",
+    "CALCULATED_RESULTS": "calculated_results",
+}
+
+
+def describe_operand(operand: Optional[Dict[str, Any]]) -> Optional[str]:
+    """Human-readable location of an operand, e.g. ``INVOICE.counterparty_name``
+    for a document field, ``INVOICE`` for a whole document, or
+    ``application.currency`` for an application field."""
+    if not operand:
+        return None
+    source = operand.get("source")
+    if source == "DOCUMENT":
+        field = operand.get("field")
+        document_type = operand.get("document_type")
+        # No field -> the operand is the document itself.
+        return f"{document_type}.{field}" if field else str(document_type)
+    if source in FLAT_SOURCE_PREFIXES:
+        return f"{FLAT_SOURCE_PREFIXES[source]}.{operand.get('field')}"
+    if source == "STATIC":
+        return f"static({operand.get('value')!r})"
+    return str(source)
+
+
+@dataclass
+class RuleResult:
+    """The outcome of evaluating a single rule node (leaf or group)."""
+
+    rule_id: str
+    description: str
+    passed: bool
+    is_group: bool
+    logical_operator: Optional[str] = None       # for groups: AND / OR
+    operator: Optional[str] = None                # for leaves
+    severity: Optional[str] = None                # for leaves
+    failure_reason: Optional[str] = None
+    left_value: Any = None                        # resolved value (leaves)
+    right_value: Any = None                       # resolved value (leaves)
+    left_operand: Optional[Dict[str, Any]] = None  # raw operand descriptor
+    right_operand: Optional[Dict[str, Any]] = None
+    left_missing: Optional[str] = None            # why the left value was missing
+    right_missing: Optional[str] = None           # why the right value was missing
+    children: List["RuleResult"] = field(default_factory=list)
+    error: Optional[str] = None                   # set if evaluation errored
+    # A group may gate its nested rules behind its own condition (operator +
+    # operands declared alongside logical_operator). This holds the result of
+    # that condition; None for leaves and for ungated groups.
+    condition: Optional["RuleResult"] = None
+    # True on the RuleResult of a group's gating condition itself.
+    is_condition: bool = False
+    # True when the node never ran because a gating condition on it, or on one
+    # of its ancestors, was not met.
+    skipped: bool = False
+    skip_reason: Optional[str] = None
+
+    def detail(self) -> Optional[str]:
+        """A failure message that names the operand(s) involved and their
+        actual values, e.g.:
+
+            "Invoice currency does not match application currency
+             (INVOICE.currency='GBP' vs application.currency='USD')"
+        """
+        if self.error is not None:
+            return self.error
+        if self.skipped:
+            return self.skip_reason
+        # A gated group that did not open explains itself through its gate.
+        if self.condition is not None and not self.condition.passed:
+            return self.condition.detail()
+        if self.is_group:
+            return None      # a group's reasons live on its children
+        base = self.failure_reason or "Condition not met"
+        left = describe_operand(self.left_operand)
+        if left is None:
+            return base
+        # If a value was missing, say precisely what (missing doc type / field)
+        # instead of just showing "=None".
+        left_piece = self.left_missing or f"{left}={self.left_value!r}"
+        detail = left_piece
+        if self.operator not in UNARY_OPERATORS and self.right_operand is not None:
+            right = describe_operand(self.right_operand)
+            right_piece = self.right_missing or f"{right}={self.right_value!r}"
+            detail += f" vs {right_piece}"
+        return f"{base} ({detail})"
+
+    def iter_leaves(self) -> List["RuleResult"]:
+        """Return every leaf result in evaluation order (depth-first).
+
+        A group's gating condition is itself a condition that ran, so it is
+        emitted just before the children it gates.
+        """
+        out: List[RuleResult] = []
+        if self.condition is not None:
+            out.append(self.condition)
+        if self.is_group:
+            for child in self.children:
+                out.extend(child.iter_leaves())
+        else:
+            out.append(self)
+        return out
+
+    def failed_leaves(self, severity: Optional[str] = None) -> List["RuleResult"]:
+        """Flatten the tree and return failing leaf results.
+
+        Skipped nodes never ran, so they are not failures — and neither is the
+        gate of a skipped group: an unmet SKIP-policy condition is a statement
+        about applicability, not a breach. If ``severity`` is given, only leaves
+        of that severity are returned.
+        """
+        out: List[RuleResult] = []
+        if self.skipped:
+            return out
+        if self.condition is not None and not self.condition.passed:
+            if severity is None or self.condition.severity == severity:
+                out.append(self.condition)
+        if self.is_group:
+            for child in self.children:
+                out.extend(child.failed_leaves(severity))
+        elif not self.passed and not self.skipped:
+            if severity is None or self.severity == severity:
+                out.append(self)
+        return out
+
+    def to_dict(self) -> Dict[str, Any]:
+        d: Dict[str, Any] = {
+            "rule_id": self.rule_id,
+            "description": self.description,
+            "passed": self.passed,
+        }
+        if self.skipped:
+            d["skipped"] = True
+            d["skip_reason"] = self.skip_reason
+        if self.is_group:
+            d["logical_operator"] = self.logical_operator
+            # A gated group's condition is flattened onto the group: the
+            # operator/operand keys describe the gate, and condition_met says
+            # whether it held (which is what decides if the children ran).
+            if self.condition is not None:
+                gate = self.condition
+                d["operator"] = gate.operator
+                d["severity"] = gate.severity
+                d["left_value"] = gate.left_value
+                d["right_value"] = gate.right_value
+                d["condition_met"] = gate.passed
+                if not gate.passed:
+                    d["failure_reason"] = gate.failure_reason
+            d["children"] = [c.to_dict() for c in self.children]
+        else:
+            d["operator"] = self.operator
+            d["severity"] = self.severity
+            d["left_value"] = self.left_value
+            d["right_value"] = self.right_value
+            if not self.passed:
+                d["failure_reason"] = self.failure_reason
+        if self.error:
+            d["error"] = self.error
+        return d
+
+
+@dataclass
+class EvaluationReport:
+    """Top-level report for a whole rule set."""
+
+    rule_set_id: str
+    exception_code: str
+    evaluation_mode: str
+    logical_passed: bool          # pure boolean evaluation of the tree
+    decision: bool                # final decision after applying evaluation_mode
+    root: RuleResult
+    # Leaves that actually caused the decision to FAIL (context-aware:
+    # respects AND/OR/NOT). Empty when the decision passed.
+    blocking_failures: List[RuleResult] = field(default_factory=list)
+
+    @property
+    def all_failures(self) -> List[RuleResult]:
+        """Every leaf that evaluated False (informational; may include
+        conditions that did not block the decision, e.g. an OR branch)."""
+        return self.root.failed_leaves()
+
+    @property
+    def executed_rules(self) -> List[Dict[str, Any]]:
+        """Flat, ordered list of every condition in the rule set, with its
+        outcome — the audit trail of the run.
+
+        Includes group gating conditions (marked ``is_group_condition``) and
+        conditions that never ran because a gate closed above them (outcome
+        ``SKIPPED``), so a reviewer can see what was *not* checked and why.
+        """
+        blocking_ids = {id(f) for f in self.blocking_failures}
+        rows: List[Dict[str, Any]] = []
+        for leaf in self.root.iter_leaves():
+            if leaf.skipped:
+                outcome = "SKIPPED"    # gated out; never evaluated
+            elif leaf.error is not None:
+                outcome = "ERROR"
+            elif leaf.passed:
+                outcome = "PASS"
+            elif id(leaf) in blocking_ids:
+                outcome = "FAIL"       # failed and blocked the decision
+            else:
+                outcome = "WARN"       # failed but did not block
+            rows.append({
+                "rule_id": leaf.rule_id,
+                "description": leaf.description,
+                "operator": leaf.operator,
+                "severity": leaf.severity,
+                "left": describe_operand(leaf.left_operand),
+                "left_value": leaf.left_value,
+                "right": describe_operand(leaf.right_operand),
+                "right_value": leaf.right_value,
+                "passed": leaf.passed,
+                "outcome": outcome,
+                "reason": leaf.detail() if not leaf.passed else None,
+                "is_group_condition": leaf.is_condition,
+            })
+        return rows
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "rule_set_id": self.rule_set_id,
+            "exception_code": self.exception_code,
+            "evaluation_mode": self.evaluation_mode,
+            "logical_passed": self.logical_passed,
+            "decision": self.decision,
+            "blocking_failures": [
+                {"rule_id": f.rule_id, "severity": f.severity,
+                 "reason": f.detail()}
+                for f in self.blocking_failures
+            ],
+            "executed_rules": self.executed_rules,
+            "all_failures": [
+                {"rule_id": f.rule_id, "severity": f.severity,
+                 "reason": f.failure_reason}
+                for f in self.all_failures
+            ],
+            "result_tree": self.root.to_dict(),
+        }
