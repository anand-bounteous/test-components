+"""Thin shim so `python3 main.py ...` keeps working without install.
+
+Prefer the installed console command `rule-engine-single` after `pip install -e .`.
+"""
+
+import sys
+from pathlib import Path
+
+# Allow running from a source checkout without installing.
+sys.path.insert(0, str(Path(__file__).parent / "src"))
+
+from rule_engine.cli import single_main  # noqa: E402
+
+if __name__ == "__main__":
+    sys.exit(single_main())
