+"""Rule set repository: loads rule set definitions and indexes them by
+``exception_code`` so the service can look them up at evaluation time.
+
+Typical use::
+
+    repo = RuleRepository.from_directory("rules")
+    rule_set = repo.get("SOF002")
+"""
+
+from __future__ import annotations
+
+import glob
+import json
+import os
+from typing import Dict, List, Optional
+
+
+class UnknownExceptionCode(KeyError):
+    """Raised when no rule set is registered for a given exception code."""
+
+
+class RuleRepository:
+    def __init__(self, rule_sets: Optional[Dict[str, dict]] = None):
+        # exception_code -> rule_set dict
+        self._by_code: Dict[str, dict] = dict(rule_sets or {})
+
+    # -- construction ------------------------------------------------------
+    @classmethod
+    def from_directory(cls, directory: str) -> "RuleRepository":
+        """Load every ``*.json`` rule set in ``directory`` (recursively)."""
+        repo = cls()
+        pattern = os.path.join(directory, "**", "*.json")
+        for path in sorted(glob.glob(pattern, recursive=True)):
+            with open(path, "r", encoding="utf-8") as fh:
+                rule_set = json.load(fh)
+            repo.register(rule_set, source=path)
+        return repo
+
+    def register(self, rule_set: dict, source: str = "<inline>") -> None:
+        code = rule_set.get("exception_code")
+        if not code:
+            raise ValueError(f"Rule set in {source} has no 'exception_code'")
+        if code in self._by_code:
+            raise ValueError(
+                f"Duplicate exception_code '{code}' (from {source}); "
+                f"already registered."
+            )
+        self._by_code[code] = rule_set
+
+    # -- lookup ------------------------------------------------------------
+    def has(self, exception_code: str) -> bool:
+        return exception_code in self._by_code
+
+    def get(self, exception_code: str) -> dict:
+        try:
+            return self._by_code[exception_code]
+        except KeyError:
+            raise UnknownExceptionCode(
+                f"No rule set registered for exception code '{exception_code}'. "
+                f"Known codes: {', '.join(sorted(self._by_code)) or '(none)'}"
+            )
+
+    def codes(self) -> List[str]:
+        return sorted(self._by_code)
