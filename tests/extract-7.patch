+.re-root .re-banner-icon { width:40px; height:40px; border-radius:999px; display:grid; place-items:center; font-size:22px; font-weight:700; background:rgba(255,255,255,0.6); }
+.re-root .re-banner-title { font-size:18px; font-weight:700; }
+.re-root .re-banner-sub { font-size:13px; opacity:0.8; margin-top:2px; }
+
+/* card */
+.re-root .re-card { background:#fff; border:1px solid #e5e7eb; border-radius:14px; box-shadow:0 1px 2px rgba(16,24,40,0.04); padding:20px; display:flex; flex-direction:column; gap:16px; }
+.re-root .re-card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
+.re-root .re-code { font-size:18px; font-weight:700; }
+.re-root .re-setid { font-size:13px; color:#6b7280; margin-top:2px; }
+.re-root .re-meta { display:flex; gap:20px; font-size:13px; color:#6b7280; }
+.re-root .re-meta code { background:#f3f4f6; padding:1px 6px; border-radius:6px; font-size:12px; }
+.re-root .re-kpis { display:grid; grid-template-columns:repeat(6, 1fr); gap:10px; }
+.re-root .re-blockers { background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:12px 14px; }
+.re-root .re-blockers-title { font-weight:700; color:#991b1b; font-size:13px; margin-bottom:8px; }
+.re-root .re-blockers ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px; }
+.re-root .re-blockers li { display:flex; align-items:center; gap:8px; font-size:13px; flex-wrap:wrap; }
+.re-root .re-blocker-id { font-weight:600; font-family:${MONO}; }
+.re-root .re-blocker-reason { color:#7f1d1d; }
+
+/* tools / view switch */
+.re-root .re-table-tools { display:flex; align-items:center; justify-content:space-between; gap:12px; }
+.re-root .re-table-caption { font-size:13px; font-weight:600; color:#374151; }
+.re-root .re-viewswitch { display:inline-flex; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden; }
+.re-root .re-viewswitch button { border:none; background:#fff; padding:6px 14px; font-size:13px; font-weight:600; color:#6b7280; cursor:pointer; }
+.re-root .re-viewswitch button.active { background:#4f46e5; color:#fff; }
+.re-root .re-toggle { font-size:13px; color:#4b5563; display:flex; align-items:center; gap:6px; cursor:pointer; }
+
+/* table */
+.re-root .re-table-wrap { overflow-x:auto; border:1px solid #eef0f3; border-radius:10px; }
+.re-root .re-table { width:100%; border-collapse:collapse; font-size:13px; }
+.re-root .re-table th { text-align:left; background:#f9fafb; color:#6b7280; font-weight:600; padding:10px 12px; border-bottom:1px solid #eef0f3; white-space:nowrap; }
+.re-root .re-table tbody tr { border-bottom:1px solid #f1f2f4; }
+.re-root .re-table tbody tr:last-child { border-bottom:none; }
+.re-root .re-table tbody tr.issue { background:#fffdf7; }
+.re-root .re-table tbody tr.skipped { background:#fcfcfd; }
+.re-root .re-table tbody tr.skipped .rdesc, .re-root .re-table tbody tr.skipped .rcheck { color:#9ca3af; }
+.re-root .re-table td { padding:10px 12px; vertical-align:top; }
+.re-root .re-empty { padding:18px; text-align:center; color:#9ca3af; }
+.re-root .rid { font-weight:600; font-family:${MONO}; font-size:12px; }
+.re-root .rdesc { color:#4b5563; margin-top:2px; }
+.re-root .rcheck { font-family:${MONO}; font-size:12px; color:#374151; white-space:nowrap; }
+.re-root .rdetail { min-width:220px; }
+.re-root .reason { color:#92400e; }
+.re-root .ok { color:#6b7280; }
+
+/* status pill */
+.re-root .pill { display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; border:1px solid transparent; white-space:nowrap; }
+.re-root .pill.lg { font-size:14px; padding:6px 14px; }
+.re-root .pill.pass { background:#ecfdf5; color:#047857; border-color:#a7f3d0; }
+.re-root .pill.fail { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
+.re-root .pill.warn { background:#fffbeb; color:#b45309; border-color:#fde68a; }
+.re-root .pill.error { background:#f5f3ff; color:#6d28d9; border-color:#ddd6fe; }
+.re-root .pill.skip { background:#f9fafb; color:#6b7280; border-color:#e5e7eb; }
+
+/* gate marker: a group's own gating condition */
+.re-root .gate { font-size:10px; font-weight:700; letter-spacing:0.04em; padding:1px 5px; margin-left:6px; border-radius:4px; color:#3730a3; background:#eef2ff; border:1px solid #c7d2fe; }
+
+/* severity tag */
+.re-root .sev { font-size:11px; font-weight:700; letter-spacing:0.02em; padding:2px 8px; border-radius:6px; border:1px solid; }
+.re-root .sev.critical { color:#b91c1c; background:#fef2f2; border-color:#fecaca; }
+.re-root .sev.high { color:#c2410c; background:#fff7ed; border-color:#fed7aa; }
+.re-root .sev.medium { color:#1d4ed8; background:#eff6ff; border-color:#bfdbfe; }
+.re-root .sev.low { color:#4b5563; background:#f3f4f6; border-color:#e5e7eb; }
+.re-root .dash { color:#9ca3af; }
+
+/* kpi */
+.re-root .kpi { border:1px solid #eef0f3; border-radius:10px; padding:10px 12px; text-align:center; background:#fff; }
+.re-root .kpi .v { font-size:22px; font-weight:700; line-height:1; }
+.re-root .kpi .l { font-size:11px; color:#6b7280; margin-top:4px; text-transform:uppercase; letter-spacing:0.03em; }
+.re-root .kpi.pass .v { color:#047857; }
+.re-root .kpi.fail .v { color:#b91c1c; }
+.re-root .kpi.warn .v { color:#b45309; }
+.re-root .kpi.error .v { color:#6d28d9; }
+.re-root .kpi.skip .v { color:#6b7280; }
+
+/* tree */
+.re-root .re-tree { border:1px solid #eef0f3; border-radius:10px; padding:8px; }
+.re-root .tnode { display:flex; align-items:center; gap:8px; padding:6px 8px; font-size:13px; width:100%; text-align:left; }
+.re-root .tnode.group { background:none; border:none; cursor:pointer; border-radius:6px; }
+.re-root .tnode.group:hover { background:#f9fafb; }
+.re-root .tnode.leaf { border-radius:6px; }
+.re-root .tnode.leaf:hover { background:#fafafa; }
+.re-root .caret { display:inline-block; transition:transform 0.12s ease; color:#9ca3af; width:12px; }
+.re-root .caret.o { transform:rotate(90deg); }
+.re-root .tspacer { width:12px; display:inline-block; }
+.re-root .logic { font-size:11px; font-weight:700; padding:1px 7px; border-radius:5px; border:1px solid #e5e7eb; color:#374151; background:#f3f4f6; }
+.re-root .logic.or { color:#1d4ed8; background:#eff6ff; border-color:#bfdbfe; }
+.re-root .logic.not { color:#6d28d9; background:#f5f3ff; border-color:#ddd6fe; }
+.re-root .tid { font-family:${MONO}; font-size:11px; font-weight:600; color:#374151; }
+.re-root .tid.dim { color:#9ca3af; font-weight:500; }
+.re-root .tdesc { color:#4b5563; }
+.re-root .tcheck { font-family:${MONO}; font-size:11px; color:#6b7280; }
+.re-root .treason { color:#92400e; font-size:12px; }
+.re-root .tchildren { border-left:1px dashed #e5e7eb; margin-left:16px; }
+
+/* gating condition line + gated-out nodes */
+.re-root .tnode.cond { border-radius:6px; background:#f8f9ff; }
+.re-root .tnode.cond .gate { margin-left:0; }
+.re-root .tnode.cond.shut { background:#fffbf5; }
+.re-root .tnode.skipped .tdesc, .re-root .tnode.skipped .tid, .re-root .tnode.skipped .tcheck { color:#9ca3af; }
+.re-root .tnode.group.skipped .logic { color:#9ca3af; background:#f9fafb; border-color:#eef0f3; }
+`;
