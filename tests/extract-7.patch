+"""Evaluation context: resolves operand values from the input data.
+
+An operand declares a ``source`` and the engine asks the context to resolve
+it into a concrete value:
+
+    STATIC          -> operand["value"]
+    DOCUMENT        -> documents[document_type][field]
+                       (omit "field" to resolve the whole document, for
+                        document-level checks like is_present)
+    APPLICATION        -> application[field]
+    USER_STATEMENT     -> user_statement[field]
+    CALCULATED_RESULTS -> calculated_results[field]
+
+Missing values resolve to ``None`` (which presence operators treat as empty)
+rather than raising, so a missing field simply fails a ``not_empty`` check.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Tuple, Union
+
+
+class OperandResolutionError(Exception):
+    """Raised when an operand is malformed (not merely missing data)."""
+
+
+# A field path may be flat ("counterparty_name"), dotted for nested objects
+# ("id.name"), or indexed for lists ("items[0].name", "a[1][2]").
+_PATH_TOKEN = re.compile(r"[^.\[\]]+|\[(\d+)\]")
+
+
+def _parse_path(path: str) -> List[Union[str, int]]:
+    """Split a field path into keys (str) and list indices (int)."""
+    tokens: List[Union[str, int]] = []
+    for match in _PATH_TOKEN.finditer(path):
+        index = match.group(1)
+        tokens.append(int(index) if index is not None else match.group(0))
+    return tokens
+
+
+def _resolve_path(root: Any, path: str, container: str) -> Tuple[Any, Union[str, None]]:
+    """Walk ``path`` (dotted / indexed) from ``root``.
+
+    Returns ``(value, missing_note)`` — missing_note is None on success, or a
+    message describing where the path could not be followed.
+    """
+    current = root
+    for token in _parse_path(path):
+        if isinstance(token, int):
+            if not isinstance(current, (list, tuple)):
+                return None, (
+                    f"field '{path}' not present in {container} "
+                    f"(expected a list before index [{token}])"
+                )
+            if not -len(current) <= token < len(current):
+                return None, (
+                    f"field '{path}' not present in {container} "
+                    f"(index [{token}] out of range)"
+                )
+            current = current[token]
+        else:
+            if not isinstance(current, dict) or token not in current:
+                return None, f"field '{path}' not present in {container}"
+            current = current[token]
+    return current, None
+
+
+@dataclass
+class EvaluationContext:
+    """Holds the input data the rules are evaluated against.
+
+    documents:      {document_type: {field: value}}
+                    e.g. {"INVOICE": {"counterparty_name": "Acme Ltd"}}
+    application:    {field: value}
+                    flat bag of application-level fields.
+    user_statement: {field: value}
+                    flat bag of what the customer told us, shaped exactly like
+                    ``application`` but kept separate so a rule can compare the
+                    two (declared vs. evidenced).
+    calculated_results: {field: value}
+                    flat bag of values derived upstream (totals, ratios,
+                    scores), so a rule can test a computed figure without the
+                    engine having to compute it.
+    """
+
+    documents: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+    application: Dict[str, Any] = field(default_factory=dict)
+    user_statement: Dict[str, Any] = field(default_factory=dict)
+    calculated_results: Dict[str, Any] = field(default_factory=dict)
+
+    def resolve(self, operand: Dict[str, Any]) -> Any:
+        """Return just the resolved value (None if missing)."""
+        return self.resolve_with_status(operand)[0]
+
+    def resolve_with_status(self, operand: Dict[str, Any]):
+        """Resolve an operand to ``(value, missing_note)``.
+
+        ``missing_note`` is None when the value was found, or a human-readable
+        explanation of what was missing (document type absent, or field absent
+        in the document / application data).
+        """
+        source = operand.get("source")
+
+        if source == "STATIC":
+            return operand.get("value"), None
+
+        if source == "DOCUMENT":
+            doc_type = operand.get("document_type")
+            field_name = operand.get("field")
+            if not doc_type:
+                raise OperandResolutionError(
+                    f"DOCUMENT operand needs 'document_type': {operand!r}"
+                )
+            if doc_type not in self.documents:
+                return None, f"document type '{doc_type}' not present in data"
+            document = self.documents[doc_type]
+            # No 'field' -> the operand IS the whole document, which is what
+            # document-level checks such as is_present look at.
+            if not field_name:
+                return document, None
+            return _resolve_path(document, field_name, f"document '{doc_type}'")
+
+        # The flat sources differ only in which bag they read from.
+        flat = self._flat_sources()
+        if source in flat:
+            container, label = flat[source]
+            field_name = operand.get("field")
+            if not field_name:
+                raise OperandResolutionError(
+                    f"{source} operand needs 'field': {operand!r}"
+                )
+            return _resolve_path(container, field_name, label)
+
+        known = ["STATIC", "DOCUMENT", *sorted(flat)]
+        raise OperandResolutionError(
+            f"Unknown operand source {source!r}. Expected "
+            f"{', '.join(known[:-1])} or {known[-1]}."
+        )
+
+    def _flat_sources(self) -> Dict[str, Tuple[Dict[str, Any], str]]:
+        """Sources that are a flat ``{field: value}`` bag, mapped to
+        (data, label-used-in-missing-value-messages)."""
+        return {
+            "APPLICATION": (self.application, "application data"),
+            "USER_STATEMENT": (self.user_statement, "user statement data"),
+            "CALCULATED_RESULTS": (self.calculated_results,
+                                   "calculated results data"),
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "EvaluationContext":
+        return cls(
+            documents=data.get("documents", {}),
+            application=data.get("application", {}),
+            user_statement=data.get("user_statement", {}),
+            calculated_results=data.get("calculated_results", {}),
+        )
