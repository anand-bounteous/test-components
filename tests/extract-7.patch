@@ -0,0 +1,377 @@
+"""The rule engine: recursively evaluates a rule tree against a context."""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from .context import EvaluationContext
+from .operators import get_operator, has_operator
+from .result import RuleResult, EvaluationReport, UNARY_OPERATORS
+
+
+# What happens to a group whose own gating condition is NOT met. Set per group
+# with "on_condition_fail". In both cases the nested rules are skipped.
+#   SKIP (default) -> the branch is "not applicable": it stays neutral in the
+#                     enclosing AND / OR / NOT and cannot block the decision.
+#   FAIL           -> the unmet condition is itself a failure: the group fails
+#                     and the condition is reported as the blocking failure.
+ON_CONDITION_FAIL_SKIP = "SKIP"
+ON_CONDITION_FAIL_FAIL = "FAIL"
+ON_CONDITION_FAIL_POLICIES = (ON_CONDITION_FAIL_SKIP, ON_CONDITION_FAIL_FAIL)
+DEFAULT_ON_CONDITION_FAIL = ON_CONDITION_FAIL_SKIP
+
+# Deriving the decision needs three states, not two: a gated-out branch neither
+# satisfies nor blocks anything, so it must not be folded into pass/fail.
+_PASS, _FAIL, _SKIP = "PASS", "FAIL", "SKIP"
+
+
+# Evaluation modes decide the FINAL pass/fail from the result tree.
+# Each takes the root RuleResult and returns (decision, blocking_failures),
+# where blocking_failures are the leaves actually responsible for a FAIL.
+#
+# The evaluation is CONTEXT-AWARE: a leaf that evaluates False is only
+# "blocking" if its position in the AND/OR/NOT tree actually causes a
+# failure. A False leaf that a sibling OR branch or an enclosing NOT
+# rescues does not block.
+def _decision_all_critical(node: RuleResult) -> Tuple[str, List[RuleResult]]:
+    """Block only when a CRITICAL condition is required-but-not-met.
+
+    Non-CRITICAL leaves are masked to 'pass' for the purposes of the
+    decision (they become warnings, not blockers). Returns
+    (state: _PASS/_FAIL/_SKIP, blocking_leaves: list).
+    """
+    # A gated-out node never ran, so it can neither satisfy nor block anything.
+    if node.skipped:
+        return _SKIP, []
+
+    if node.is_group:
+        # A group that could not be evaluated (unknown logical operator, bad
+        # on_condition_fail) blocks.
+        if node.error is not None:
+            return _FAIL, []
+        # A gate that did not open under the FAIL policy: the unmet condition
+        # is what blocks, judged on severity exactly like any other leaf.
+        if node.condition is not None and not node.condition.passed:
+            return _decision_all_critical(node.condition)
+
+        child_results = [_decision_all_critical(c) for c in node.children]
+        # Skipped children are invisible to the combinator: an inapplicable
+        # branch must not satisfy an OR nor drag down an AND.
+        active = [(state, bl) for state, bl in child_results if state != _SKIP]
+        # Every child gated out -> nothing here was actually checked, so this
+        # group is inapplicable too and the skip propagates upward.
+        if node.children and not active:
+            return _SKIP, []
+        op = node.logical_operator
+
+        if op == "OR":
+            satisfied = any(state == _PASS for state, _ in active)
+            # If satisfied by some branch, nothing blocks. Otherwise every
+            # branch failed, so surface all their blockers.
+            blockers = [] if satisfied else [b for _, bl in active for b in bl]
+            return (_PASS if satisfied else _FAIL), blockers
+
+        if op == "NOT":
+            state = active[0][0] if active else _PASS
+            # NOT passes when the child is NOT satisfied; there is no
+            # single leaf to blame when it fails, so report none.
+            return (_FAIL if state == _PASS else _PASS), []
+
+        # AND (default): all children must be satisfied; collect every blocker.
+        satisfied = all(state == _PASS for state, _ in active)
+        blockers = [b for _, bl in active for b in bl]
+        return (_PASS if satisfied else _FAIL), blockers
+
+    # A leaf that could not be evaluated (unknown operator, bad data) always
+    # blocks — you can't pass a check that never ran, regardless of severity.
+    if node.error is not None:
+        return _FAIL, [node]
+    # Otherwise only CRITICAL leaves can block; others are masked to pass.
+    if node.severity == "CRITICAL":
+        return (_PASS if node.passed else _FAIL), ([] if node.passed else [node])
+    return _PASS, []
+
+
+def _mode_all_critical_must_pass(root: RuleResult):
+    state, blockers = _decision_all_critical(root)
+    # _SKIP means nothing applied, which is not a failure.
+    return state != _FAIL, blockers
+
+
+def _mode_strict(root: RuleResult):
+    """The whole boolean tree must evaluate to True; any False leaf blocks."""
+    # A rule set gated out at the root had nothing to violate.
+    if root.skipped:
+        return True, []
+    return root.passed, root.failed_leaves()
+
+
+EVALUATION_MODES: Dict[str, Callable[[RuleResult], object]] = {
+    "ALL_CRITICAL_MUST_PASS": _mode_all_critical_must_pass,
+    "STRICT": _mode_strict,
+}
+
+
+def _is_group(node: Dict[str, Any]) -> bool:
+    """A node is a GROUP if it carries a logical_operator + nested rules,
+    otherwise it is a LEAF with an operator + operands. A group may *also*
+    carry an operator — that is its gating condition, not a leaf check."""
+    return "logical_operator" in node and "rules" in node
+
+
+def _reportable(operand: Optional[Dict[str, Any]], value: Any) -> Any:
+    """What to record in the report for a resolved operand value.
+
+    A whole-document operand (DOCUMENT with no ``field``, used by is_present)
+    resolves to the entire document. Summarise it instead of inlining it: the
+    report is an audit trail, not a second copy of the input.
+    """
+    operand = operand or {}
+    if (operand.get("source") == "DOCUMENT" and not operand.get("field")
+            and isinstance(value, dict)):
+        return (f"<{operand.get('document_type')} document: "
+                f"{len(value)} field(s)>")
+    return value
+
+
+def _skip_subtree(node: Dict[str, Any], note: str) -> RuleResult:
+    """Build unevaluated (skipped) results for a node and its whole subtree.
+
+    The rules are kept in the report rather than dropped, so a reviewer can see
+    exactly which checks did not run and why.
+    """
+    is_group = _is_group(node)
+    result = RuleResult(
+        rule_id=node.get("rule_id", ""),
+        description=node.get("description", ""),
+        passed=False,
+        is_group=is_group,
+        skipped=True,
+        skip_reason=note,
+    )
+    if is_group:
+        result.logical_operator = node.get("logical_operator", "AND").upper()
+        result.children = [_skip_subtree(child, note)
+                           for child in node.get("rules", [])]
+    else:
+        result.operator = node.get("operator")
+        result.severity = node.get("severity")
+        result.failure_reason = node.get("failure_reason")
+        result.left_operand = node.get("left_operand")
+        result.right_operand = node.get("right_operand")
+    return result
+
+
+class RuleEngine:
+    def __init__(self, rule_set: Dict[str, Any]):
+        self.rule_set = rule_set
+        self.rule_set_id = rule_set.get("rule_set_id", "")
+        self.exception_code = rule_set.get("exception_code", "")
+        self.evaluation_mode = rule_set.get("evaluation_mode", "STRICT")
+
+        rules = rule_set.get("rules", [])
+        if len(rules) != 1:
+            raise ValueError(
+                "Expected exactly one root rule under 'rules'; "
+                f"got {len(rules)}."
+            )
+        self.root_node = rules[0]
+
+    # -- public API --------------------------------------------------------
+    def evaluate(self, context: EvaluationContext) -> EvaluationReport:
+        root_result = self._evaluate_node(self.root_node, context)
+
+        mode_fn = EVALUATION_MODES.get(self.evaluation_mode)
+        if mode_fn is None:
+            raise ValueError(
+                f"Unknown evaluation_mode '{self.evaluation_mode}'. "
+                f"Known: {', '.join(sorted(EVALUATION_MODES))}"
+            )
+
+        decision, blocking_failures = mode_fn(root_result)
+
+        return EvaluationReport(
+            rule_set_id=self.rule_set_id,
+            exception_code=self.exception_code,
+            evaluation_mode=self.evaluation_mode,
+            # A tree gated out at the root is not logically false — nothing in
+            # it was asserted.
+            logical_passed=True if root_result.skipped else root_result.passed,
+            decision=decision,
+            # blocking_failures=blocking_failures,
+            root=root_result,
+        )
+
+    # -- internals ---------------------------------------------------------
+    def _evaluate_node(
+        self, node: Dict[str, Any], context: EvaluationContext
+    ) -> RuleResult:
+        if _is_group(node):
+            return self._evaluate_group(node, context)
+        return self._evaluate_leaf(node, context)
+
+    def _evaluate_group(
+        self, node: Dict[str, Any], context: EvaluationContext
+    ) -> RuleResult:
+        logical_operator = node.get("logical_operator", "AND").upper()
+        rule_id = node.get("rule_id", "")
+        description = node.get("description", "")
+
+        # A group may gate its nested rules behind a condition of its own,
+        # declared with operator / left_operand / right_operand sitting next to
+        # logical_operator. No operator on the group -> the nested rules always
+        # run, exactly as before.
+        condition = self._evaluate_condition(node, context)
+        policy, policy_error = self._condition_policy(node)
+        if condition is not None and policy == ON_CONDITION_FAIL_FAIL \
+                and condition.severity is None:
+            # A condition declared as failing is meant to block, so it needs a
+            # severity that blocks under ALL_CRITICAL_MUST_PASS.
+            condition.severity = "CRITICAL"
+
+        if condition is not None and not condition.passed:
+            # The gate is shut: the nested rules do not run at all.
+            # An unevaluable gate (unknown operator, malformed operand) must
+            # never silently swallow a branch — it always blocks.
+            blocks = (policy == ON_CONDITION_FAIL_FAIL
+                      or condition.error is not None)
+            note = (f"not evaluated — condition on '{rule_id}' was not met: "
+                    f"{condition.detail()}")
+            return RuleResult(
+                rule_id=rule_id,
+                description=description,
+                passed=False,
+                is_group=True,
+                logical_operator=logical_operator,
+                condition=condition,
+                children=[_skip_subtree(child, note)
+                          for child in node.get("rules", [])],
+                skipped=not blocks,
+                skip_reason=None if blocks else note,
+                error=policy_error,
+            )
+
+        children = [self._evaluate_node(child, context)
+                    for child in node.get("rules", [])]
+        # Skipped children are invisible to the combinator: an inapplicable
+        # branch must not satisfy an OR nor drag down an AND.
+        active = [c for c in children if not c.skipped]
+
+        error = policy_error
+        if logical_operator == "AND":
+            passed = all(c.passed for c in active)
+        elif logical_operator == "OR":
+            passed = any(c.passed for c in active)
+        elif logical_operator == "NOT":
+            # NOT negates its (single) child.
+            passed = not active[0].passed if active else True
+        else:
+            passed = False
+            error = (
+                f"Unknown logical_operator '{logical_operator}' — group could "
+                f"not be evaluated. Expected AND, OR or NOT."
+            )
+
+        if error is not None:
+            passed = False
+        # Every child gated out -> nothing here was actually checked, so this
+        # group is inapplicable too and the skip propagates upward.
+        all_skipped = bool(children) and not active and error is None
+
+        return RuleResult(
+            rule_id=rule_id,
+            description=description,
+            passed=passed,
+            is_group=True,
+            logical_operator=logical_operator,
+            condition=condition,
+            children=children,
+            skipped=all_skipped,
+            skip_reason=("not evaluated — every nested rule was gated out"
+                         if all_skipped else None),
+            error=error,
+        )
+
+    def _evaluate_condition(
+        self, node: Dict[str, Any], context: EvaluationContext
+    ) -> Optional[RuleResult]:
+        """Evaluate a group's gating condition, or None if it has none."""
+        if "operator" not in node:
+            return None
+        return self._evaluate_leaf(node, context, as_condition=True)
+
+    @staticmethod
+    def _condition_policy(node: Dict[str, Any]) -> Tuple[str, Optional[str]]:
+        """Resolve ``on_condition_fail`` to (policy, error). An unrecognised
+        value falls back to the blocking policy and reports an error rather
+        than quietly picking a behaviour the author did not ask for."""
+        raw = node.get("on_condition_fail", DEFAULT_ON_CONDITION_FAIL)
+        policy = str(raw).upper()
+        if policy in ON_CONDITION_FAIL_POLICIES:
+            return policy, None
+        return ON_CONDITION_FAIL_FAIL, (
+            f"Unknown on_condition_fail '{raw}' — expected "
+            f"{' or '.join(ON_CONDITION_FAIL_POLICIES)}."
+        )
+
+    def _evaluate_leaf(
+        self,
+        node: Dict[str, Any],
+        context: EvaluationContext,
+        as_condition: bool = False,
+    ) -> RuleResult:
+        """Evaluate a single condition. ``as_condition`` marks the result as a
+        group's gate rather than a rule in its own right; either way the
+        operator / operand handling is identical."""
+        operator_name = node["operator"]
+        result = RuleResult(
+            rule_id=node.get("rule_id", ""),
+            description=node.get("description", ""),
+            passed=False,
+            is_group=False,
+            is_condition=as_condition,
+            operator=operator_name,
+            severity=node.get("severity"),
+            failure_reason=node.get("failure_reason") or (
+                "Group condition not met" if as_condition else None),
+            left_operand=node.get("left_operand"),
+            right_operand=node.get("right_operand"),
+        )
+
+        # Unknown operator = a rule authoring error. Fail loudly with a clear
+        # reason; the decision logic treats any errored leaf as blocking.
+        if not has_operator(operator_name):
+            result.passed = False
+            result.error = (
+                f"Unknown operator '{operator_name}' — rule could not be "
+                f"evaluated."
+            )
+            return result
+
+        try:
+            left, left_missing = context.resolve_with_status(node["left_operand"])
+            # right_operand is optional for unary operators.
+            if "right_operand" in node:
+                right, right_missing = context.resolve_with_status(
+                    node["right_operand"])
+            else:
+                right, right_missing = None, None
+            result.left_value = _reportable(node.get("left_operand"), left)
+            result.right_value = _reportable(node.get("right_operand"), right)
+            result.left_missing = left_missing
+            result.right_missing = right_missing
+
+            # For comparison operators, a missing operand can't be compared and
+            # must not silently pass (e.g. equals(None, None) -> True). Unary
+            # presence operators (is_empty/not_empty) handle None themselves.
+            if operator_name not in UNARY_OPERATORS and (left_missing or right_missing):
+                result.passed = False
+                return result
+
+            op_fn = get_operator(operator_name)
+            result.passed = op_fn(left, right)
+        except Exception as exc:  # noqa: BLE001 - record, don't crash the run
+            result.passed = False
+            result.error = f"{type(exc).__name__}: {exc}"
+
+        return result
