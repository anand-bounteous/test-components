+++ rule-engine/ui/components/RuleReview/types.ts	2026-08-05 14:47:11
@@ -0,0 +1,85 @@
+// TypeScript mirror of the rule-engine /evaluate API response.
+// This is the single input shape the RuleReview component consumes.
+
+export type Outcome = "PASS" | "FAIL" | "WARN" | "ERROR" | "SKIPPED";
+export type Severity = "CRITICAL" | "HIGH" | "MEDIUM" | "LOW";
+
+export interface ExecutedRule {
+  rule_id: string;
+  description: string;
+  operator: string | null;
+  severity: Severity | null;
+  left: string | null;
+  left_value: unknown;
+  right: string | null;
+  right_value: unknown;
+  passed: boolean;
+  outcome: Outcome;
+  reason: string | null;
+  /** True when this row is a group's gating condition, not a rule of its own. */
+  is_group_condition?: boolean;
+}
+
+export interface Failure {
+  rule_id: string;
+  severity: Severity | null;
+  reason: string | null;
+}
+
+export interface Summary {
+  total: number;
+  passed: number;
+  failed: number; // blocking failures
+  warnings: number; // non-blocking failures
+  errors: number;
+  skipped: number; // gated out by a group condition, never evaluated
+}
+
+/**
+ * A node in the rule tree. The condition fields (`operator`, `left`, `right`,
+ * `severity`) describe the node's own check: for a leaf that is the rule
+ * itself, for a group it is the gating condition deciding whether the children
+ * run, and they are null on an ungated group.
+ */
+export interface RuleNode {
+  rule_id: string;
+  description: string;
+  passed: boolean;
+  is_group: boolean;
+  outcome: Outcome;
+  logical_operator?: string | null;
+  operator?: string | null;
+  severity?: Severity | null;
+  left?: string | null;
+  left_value?: unknown;
+  right?: string | null;
+  right_value?: unknown;
+  reason?: string | null;
+  /** Never ran — a gating condition on it or on an ancestor was not met. */
+  skipped?: boolean;
+  /**
+   * For a gated group: whether its gating condition held. `false` means the
+   * children were skipped, which is otherwise indistinguishable from the
+   * children having failed. Null when the node has no gating condition.
+   */
+  condition_met?: boolean | null;
+  children: RuleNode[];
+}
+
+export interface RuleSetResult {
+  exception_code: string;
+  rule_set_id: string;
+  evaluation_mode: string;
+  logical_passed: boolean;
+  decision: boolean;
+  summary: Summary;
+  blocking_failures: Failure[];
+  executed_rules: ExecutedRule[];
+  result_tree: RuleNode;
+}
+
+export interface EvaluationResponse {
+  decision: boolean;
+  unknown_codes: string[];
+  results: RuleSetResult[];
+}
