+"""Operator registry.
+
+Each operator is a function ``(left, right) -> bool``. Unary operators
+(``is_empty`` / ``not_empty``) simply ignore the ``right`` argument.
+
+Register new operators with the ``@operator`` decorator so the engine can
+look them up by name.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, date
+from typing import Any, Callable, Dict
+
+
+OperatorFn = Callable[[Any, Any], bool]
+
+_REGISTRY: Dict[str, OperatorFn] = {}
+
+
+def operator(name: str) -> Callable[[OperatorFn], OperatorFn]:
+    """Decorator that registers an operator function under ``name``."""
+
+    def _register(fn: OperatorFn) -> OperatorFn:
+        _REGISTRY[name] = fn
+        return fn
+
+    return _register
+
+
+def has_operator(name: str) -> bool:
+    return name in _REGISTRY
+
+
+def get_operator(name: str) -> OperatorFn:
+    try:
+        return _REGISTRY[name]
+    except KeyError:
+        raise ValueError(
+            f"Unknown operator '{name}'. Known operators: "
+            f"{', '.join(sorted(_REGISTRY))}"
+        )
+
+
+# --------------------------------------------------------------------------
+# Helpers
+# --------------------------------------------------------------------------
+def _norm(value: Any) -> Any:
+    """Normalise a value for string comparison: strings are trimmed and
+    case-folded; non-string values are returned unchanged (so numbers,
+    booleans and dates keep their exact semantics)."""
+    if isinstance(value, str):
+        return value.strip().casefold()
+    return value
+
+
+def _is_empty(value: Any) -> bool:
+    """Treat None, empty string (after strip) and empty collections as empty."""
+    if value is None:
+        return True
+    if isinstance(value, str):
+        return value.strip() == ""
+    if isinstance(value, (list, tuple, dict, set)):
+        return len(value) == 0
+    return False
+
+
+def _to_number(value: Any) -> float:
+    return float(value)
+
+
+# Accepted date/datetime string formats, tried in order. Slash/dot/dash
+# numeric dates are read DAY-FIRST (UK convention): 03/04/2024 -> 3 April 2024.
+_DATE_FORMATS = (
+    "%d/%m/%Y", "%d-%m-%Y", "%d.%m.%Y",   # 10/05/2024, 10-05-2024, 10.05.2024
+    "%Y/%m/%d",                            # 2024/05/10
+    "%d %b %Y", "%d %B %Y",                # 10 May 2024, 10 May 2024
+    "%b %d, %Y", "%B %d, %Y",              # May 10, 2024
+    "%d/%m/%y", "%d-%m-%y",                # 10/05/24
+)
+
+
+def _to_datetime(value: Any) -> datetime:
+    """Coerce a date/datetime or a string in a wide range of common formats
+    into a datetime for comparison. Strings are trimmed first."""
+    if isinstance(value, datetime):
+        return value
+    if isinstance(value, date):
+        return datetime(value.year, value.month, value.day)
+    if not isinstance(value, str):
+        raise ValueError(f"Cannot interpret {value!r} as a date/datetime")
+
+    text = value.strip()
+    # 1) ISO 8601 first (handles date, datetime, and trailing 'Z' for UTC).
+    try:
+        return datetime.fromisoformat(text.replace("Z", "+00:00"))
+    except ValueError:
+        pass
+    # 2) Fall back to the common explicit formats.
+    for fmt in _DATE_FORMATS:
+        try:
+            return datetime.strptime(text, fmt)
+        except ValueError:
+            continue
+    raise ValueError(f"Cannot interpret {value!r} as a date/datetime")
+
+
+# --------------------------------------------------------------------------
+# Presence
+# --------------------------------------------------------------------------
+@operator("not_empty")
+def not_empty(left: Any, right: Any) -> bool:  # right ignored (unary)
+    return not _is_empty(left)
+
+
+@operator("is_empty")
+def is_empty(left: Any, right: Any) -> bool:  # right ignored (unary)
+    return _is_empty(left)
+
+
+# Presence is about whether the operand resolved to anything at all, which is a
+# different question from emptiness: a document that was supplied but carries no
+# fields is *present* and *empty*. Point the left operand at a document with no
+# "field" to ask whether that document was supplied at all.
+@operator("is_present")
+def is_present(left: Any, right: Any) -> bool:  # right ignored (unary)
+    return left is not None
+
+
+@operator("not_present")
+def not_present(left: Any, right: Any) -> bool:  # right ignored (unary)
+    return left is None
+
+
+# --------------------------------------------------------------------------
+# Equality
+# --------------------------------------------------------------------------
+@operator("equals")
+def equals(left: Any, right: Any) -> bool:
+    return _norm(left) == _norm(right)
+
+
+@operator("not_equals")
+def not_equals(left: Any, right: Any) -> bool:
+    return _norm(left) != _norm(right)
+
+
+# --------------------------------------------------------------------------
+# String / collection membership
+# --------------------------------------------------------------------------
+@operator("contains")
+def contains(left: Any, right: Any) -> bool:
+    if left is None:
+        return False
+    if isinstance(left, str):
+        return _norm(right) in _norm(left)
+    return right in left  # collection membership: exact
+
+
+@operator("not_contains")
+def not_contains(left: Any, right: Any) -> bool:
+    return not contains(left, right)
+
+
+@operator("starts_with")
+def starts_with(left: Any, right: Any) -> bool:
+    return _norm(str(left)).startswith(_norm(str(right)))
+
+
+@operator("ends_with")
+def ends_with(left: Any, right: Any) -> bool:
+    return _norm(str(left)).endswith(_norm(str(right)))
+
+
+# --------------------------------------------------------------------------
+# Numeric comparison
+#
+# If either side is missing (None) or not numeric, the comparison simply
+# returns False (the rule fails) rather than raising — a missing/garbage value
+# can't satisfy an ordering check. The failure reason still shows the raw value
+# (e.g. =None) so the cause is visible.
+# --------------------------------------------------------------------------
+def _numbers(left: Any, right: Any):
+    try:
+        return _to_number(left), _to_number(right)
+    except (TypeError, ValueError):
+        return None
+
+
+@operator("greater_than")
+def greater_than(left: Any, right: Any) -> bool:
+    pair = _numbers(left, right)
+    return pair is not None and pair[0] > pair[1]
+
+
+@operator("less_than")
+def less_than(left: Any, right: Any) -> bool:
+    pair = _numbers(left, right)
+    return pair is not None and pair[0] < pair[1]
+
+
+@operator("greater_than_or_equal")
+def greater_than_or_equal(left: Any, right: Any) -> bool:
+    pair = _numbers(left, right)
+    return pair is not None and pair[0] >= pair[1]
+
+
+@operator("less_than_or_equal")
+def less_than_or_equal(left: Any, right: Any) -> bool:
+    pair = _numbers(left, right)
+    return pair is not None and pair[0] <= pair[1]
+
+
+# --------------------------------------------------------------------------
+# Date comparison
+#
+# Same policy as numeric: a missing (None) or unparseable date makes the
+# comparison return False instead of raising.
+# --------------------------------------------------------------------------
+def _dates(left: Any, right: Any):
+    try:
+        return _to_datetime(left), _to_datetime(right)
+    except (TypeError, ValueError):
+        return None
+
+
+@operator("before")
+def before(left: Any, right: Any) -> bool:
+    pair = _dates(left, right)
+    return pair is not None and pair[0] < pair[1]
+
+
+@operator("after")
+def after(left: Any, right: Any) -> bool:
+    pair = _dates(left, right)
+    return pair is not None and pair[0] > pair[1]
