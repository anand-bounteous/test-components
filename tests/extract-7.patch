+"""The library facade the host application talks to.
+
+The application supplies:
+  * one or more exception codes,
+  * the extracted document fields,
+  * the application data fields,
+  * optionally, the user statement fields,
+  * optionally, values calculated upstream,
+
+and gets back a BatchResult: one EvaluationReport per exception code, plus
+an overall decision and the list of any codes that had no rule set.
+
+Example
+-------
+    from rule_engine import RuleEngineService, RuleRepository
+
+    service = RuleEngineService(RuleRepository.from_directory("rules"))
+    result = service.evaluate(
+        exception_codes=["SOF002", "DEMO001"],
+        documents={"INVOICE": {"counterparty_name": "Acme", ...}},
+        application={"currency": "GBP", ...},
+        user_statement={"declared_source": "gift", ...},
+        calculated_results={"total_line_items": 15000, ...},
+    )
+
+    result.decision          # overall pass/fail (all codes must pass)
+    result.reports["SOF002"] # per-code EvaluationReport
+    result.to_dict()         # fully serialisable audit payload
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List
+
+from .context import EvaluationContext
+from .engine import RuleEngine
+from .repository import RuleRepository
+from .result import EvaluationReport
+
+
+@dataclass
+class BatchResult:
+    """Aggregate result across all requested exception codes."""
+
+    decision: bool                              # True only if every code passed
+    reports: Dict[str, EvaluationReport] = field(default_factory=dict)
+    unknown_codes: List[str] = field(default_factory=list)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "decision": self.decision,
+            "unknown_codes": self.unknown_codes,
+            "results": {
+                code: report.to_dict() for code, report in self.reports.items()
+            },
+        }
+
+
+class RuleEngineService:
+    def __init__(self, repository: RuleRepository):
+        self.repository = repository
+
+    @classmethod
+    def from_directory(cls, directory: str) -> "RuleEngineService":
+        return cls(RuleRepository.from_directory(directory))
+
+    def evaluate(
+        self,
+        exception_codes: List[str],
+        documents: Dict[str, Dict[str, Any]] | None = None,
+        application: Dict[str, Any] | None = None,
+        user_statement: Dict[str, Any] | None = None,
+        calculated_results: Dict[str, Any] | None = None,
+    ) -> BatchResult:
+        context = EvaluationContext(
+            documents=documents or {},
+            application=application or {},
+            user_statement=user_statement or {},
+            calculated_results=calculated_results or {},
+        )
+
+        reports: Dict[str, EvaluationReport] = {}
+        unknown: List[str] = []
+
+        for code in exception_codes:
+            if not self.repository.has(code):
+                unknown.append(code)
+                continue
+            rule_set = self.repository.get(code)
+            reports[code] = RuleEngine(rule_set).evaluate(context)
+
+        # Overall passes only if there are no unknown codes AND every
+        # evaluated rule set passed its decision.
+        decision = (
+            len(unknown) == 0
+            and all(r.decision for r in reports.values())
+            and len(reports) > 0
+        )
+
+        return BatchResult(
+            decision=decision,
+            reports=reports,
+            unknown_codes=unknown,
+        )
