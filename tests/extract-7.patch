--- components-empty-1/src/rule_engine/api/builders.py	1970-01-01 05:30:00
+++ rule-engine/src/rule_engine/api/builders.py	2026-08-10 18:35:17
@@ -0,0 +1,151 @@
+"""Convert engine domain objects into the API response models."""
+
+from __future__ import annotations
+
+from typing import Set
+
+from ..result import EvaluationReport, RuleResult, describe_operand
+from ..service import BatchResult
+from .models import (
+    EvaluationResponse,
+    ExecutedRule,
+    Failure,
+    RuleNode,
+    RuleSetResult,
+    Summary,
+)
+
+
+def _leaf_outcome(node: RuleResult, blocking_ids: Set[int]) -> str:
+    if node.error is not None:
+        return "ERROR"
+    if node.passed:
+        return "PASS"
+    return "FAIL" if id(node) in blocking_ids else "WARN"
+
+
+def _group_outcome(node: RuleResult, children: list) -> str:
+    """Outcome of a group, derived from the children *as rendered in the tree*.
+
+    The engine treats a group whose gate shut as "not applicable" and drops it
+    from its parent's AND/OR. The tree does not: such a node is reported FAIL,
+    so here it counts as unsatisfied in its parent exactly like a failed rule,
+    and the failure travels up through the logical operator. Only nodes that
+    never ran (an *ancestor* gate shut) stay neutral.
+    """
+    active = [c for c in children if c.outcome != "SKIPPED"]
+    if not active:
+        # Nothing below this node ran; fall back to the engine's own boolean.
+        return "PASS" if node.passed else "FAIL"
+    satisfied = [c.outcome == "PASS" for c in active]
+    operator = (node.logical_operator or "AND").upper()
+    if operator == "OR":
+        return "PASS" if any(satisfied) else "FAIL"
+    if operator == "NOT":
+        return "PASS" if not satisfied[0] else "FAIL"
+    return "PASS" if all(satisfied) else "FAIL"
+
+
+def _build_node(
+    node: RuleResult, blocking_ids: Set[int], gated_out: bool = False
+) -> RuleNode:
+    """Build the tree view of a result.
+
+    ``gated_out`` means an *ancestor's* gate shut, so nothing here ran and the
+    whole subtree reports SKIPPED. A node's own shut gate does not skip the node
+    itself — it fails it, and skips its children.
+    """
+    if not node.is_group:
+        outcome = "SKIPPED" if gated_out else _leaf_outcome(node, blocking_ids)
+        return RuleNode(
+            rule_id=node.rule_id,
+            description=node.description,
+            passed=outcome == "PASS",
+            is_group=False,
+            outcome=outcome,
+            operator=node.operator,
+            severity=node.severity,
+            left=describe_operand(node.left_operand),
+            left_value=node.left_value,
+            right=describe_operand(node.right_operand),
+            right_value=node.right_value,
+            reason=node.skip_reason if gated_out else (
+                None if node.passed else node.detail()),
+            skipped=gated_out,
+        )
+
+    # A gated group's condition is flattened onto the group itself: the
+    # operand/operator fields describe the gate, and condition_met says
+    # whether it held.
+    gate = node.condition
+    gate_shut = gate is not None and not gate.passed
+    # The children did not run if this gate shut, or if one above it did.
+    children = [_build_node(c, blocking_ids, gated_out or gate_shut)
+                for c in node.children]
+
+    if gated_out:
+        outcome, reason = "SKIPPED", node.skip_reason
+    elif node.error is not None:
+        outcome, reason = "ERROR", node.error
+    elif gate_shut:
+        # This node's own gate is the failure; the subtree below is skipped.
+        outcome, reason = "FAIL", gate.detail()
+    else:
+        outcome, reason = _group_outcome(node, children), None
+
+    return RuleNode(
+        rule_id=node.rule_id,
+        description=node.description,
+        passed=outcome == "PASS",
+        is_group=True,
+        outcome=outcome,
+        logical_operator=node.logical_operator,
+        operator=gate.operator if gate else None,
+        severity=gate.severity if gate else None,
+        left=describe_operand(gate.left_operand) if gate else None,
+        left_value=gate.left_value if gate else None,
+        right=describe_operand(gate.right_operand) if gate else None,
+        right_value=gate.right_value if gate else None,
+        reason=reason,
+        skipped=outcome == "SKIPPED",
+        condition_met=gate.passed if gate else None,
+        children=children,
+    )
+
+
+def build_rule_set_result(code: str, report: EvaluationReport) -> RuleSetResult:
+    executed = [ExecutedRule(**row) for row in report.executed_rules]
+    summary = Summary(
+        total=len(executed),
+        passed=sum(1 for r in executed if r.outcome == "PASS"),
+        failed=sum(1 for r in executed if r.outcome == "FAIL"),
+        warnings=sum(1 for r in executed if r.outcome == "WARN"),
+        errors=sum(1 for r in executed if r.outcome == "ERROR"),
+        skipped=sum(1 for r in executed if r.outcome == "SKIPPED"),
+    )
+    blocking_ids = {id(f) for f in report.blocking_failures}
+    return RuleSetResult(
+        exception_code=code,
+        rule_set_id=report.rule_set_id,
+        evaluation_mode=report.evaluation_mode,
+        logical_passed=report.logical_passed,
+        decision=report.decision,
+        summary=summary,
+        blocking_failures=[
+            Failure(rule_id=f.rule_id, severity=f.severity, reason=f.detail())
+            for f in report.blocking_failures
+        ],
+        executed_rules=executed,
+        result_tree=_build_node(report.root, blocking_ids),
+    )
+
+
+def build_response(batch: BatchResult) -> EvaluationResponse:
+    return EvaluationResponse(
+        decision=batch.decision,
+        unknown_codes=batch.unknown_codes,
+        results=[
+            build_rule_set_result(code, report)
+            for code, report in batch.reports.items()
+        ],
+    )
