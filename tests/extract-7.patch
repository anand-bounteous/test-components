+"""Command-line entry points for the rule engine.
+
+Installed as console scripts (see pyproject.toml):
+    rule-engine         -> service_main   (payload + rules dir)
+    rule-engine-single  -> single_main    (one rule set + one input file)
+"""
+
+import argparse
+import json
+import sys
+
+from .service import RuleEngineService
+from .engine import RuleEngine
+from .context import EvaluationContext
+
+
+def _load(path: str) -> dict:
+    with open(path, "r", encoding="utf-8") as fh:
+        return json.load(fh)
+
+
+# ---------------------------------------------------------------------------
+# rule-engine : run a request payload against a directory of rule sets
+# ---------------------------------------------------------------------------
+def service_main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description="Run the rule engine service.")
+    parser.add_argument("payload", help="Request payload JSON file.")
+    parser.add_argument("--rules-dir", default="rules",
+                        help="Directory of rule set JSON files (default: rules).")
+    parser.add_argument("--json", action="store_true",
+                        help="Print the full result as JSON.")
+    args = parser.parse_args(argv)
+
+    payload = _load(args.payload)
+    service = RuleEngineService.from_directory(args.rules_dir)
+    result = service.evaluate(
+        exception_codes=payload.get("exception_codes", []),
+        documents=payload.get("documents", {}),
+        application=payload.get("application", {}),
+        user_statement=payload.get("user_statement", {}),
+        calculated_results=payload.get("calculated_results", {}),
+    )
+
+    if args.json:
+        print(json.dumps(result.to_dict(), indent=2, default=str))
+        return 0 if result.decision else 1
+
+    print(f"OVERALL DECISION: {'PASS' if result.decision else 'FAIL'}")
+    if result.unknown_codes:
+        print(f"Unknown exception codes (no rule set): {result.unknown_codes}")
+
+    for code, report in result.reports.items():
+        print(f"\n=== {code}  ({report.rule_set_id}) ===")
+        print(f"  Mode     : {report.evaluation_mode}")
+        print(f"  Logical  : {'PASS' if report.logical_passed else 'FAIL'}")
+        print(f"  Decision : {'PASS' if report.decision else 'FAIL'}")
+        print("  Rules executed:")
+        for r in report.executed_rules:
+            mark = {"PASS": "✓", "FAIL": "✗", "WARN": "!", "ERROR": "E",
+                    "SKIPPED": "·"}[r["outcome"]]
+            gate = " [IF]" if r.get("is_group_condition") else ""
+            print(f"    {mark} [{r['outcome']:<7}] {r['rule_id']}{gate} "
+                  f"({r['severity']}) — {r['description']}")
+            if r["reason"]:
+                print(f"          reason: {r['reason']}")
+
+    return 0 if result.decision else 1
+
+
+# ---------------------------------------------------------------------------
+# rule-engine-single : run one rule set file against one input file
+# ---------------------------------------------------------------------------
+def single_main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description="Evaluate a single rule set.")
+    parser.add_argument("rules", help="Path to the rule set JSON file.")
+    parser.add_argument("input", help="Path to the input data JSON file.")
+    parser.add_argument("--json", action="store_true",
+                        help="Print the full report as JSON.")
+    args = parser.parse_args(argv)
+
+    engine = RuleEngine(_load(args.rules))
+    context = EvaluationContext.from_dict(_load(args.input))
+    report = engine.evaluate(context)
+
+    if args.json:
+        print(json.dumps(report.to_dict(), indent=2, default=str))
+        return 0 if report.decision else 1
+
+    print(f"Rule set : {report.rule_set_id} ({report.exception_code})")
+    print(f"Mode     : {report.evaluation_mode}")
+    print(f"Logical  : {'PASS' if report.logical_passed else 'FAIL'}")
+    print(f"Decision : {'PASS' if report.decision else 'FAIL'}")
+
+    if report.blocking_failures:
+        print("\nBlocking failures (caused the decision to FAIL):")
+        for f in report.blocking_failures:
+            print(f"  [✗ {f.severity}] {f.rule_id} {f.description}: {f.detail()}")
+
+    warnings = [f for f in report.all_failures if f not in report.blocking_failures]
+    if warnings:
+        print("\nWarnings (conditions not met, did not block):")
+        for f in warnings:
+            print(f"  [· {f.severity}] {f.rule_id} {f.description}: {f.detail()}")
+
+    if not report.all_failures:
+        print("\nNo failures.")
+
+    return 0 if report.decision else 1
+
+
+if __name__ == "__main__":
+    sys.exit(service_main())
