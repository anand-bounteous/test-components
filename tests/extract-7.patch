@@ -0,0 +1,418 @@
+"use client";
+
+/**
+ * RuleReview — a portable, dependency-free (React-only) component that renders
+ * a rule-engine `/evaluate` response for an analyst to review.
+ *
+ * Usage (any React app — Next.js, Vite, CRA):
+ *
+ *   import { RuleReview } from "@/components/RuleReview";
+ *   <RuleReview data={apiResponse} />
+ *
+ * The only input is the API response. Styling is injected once as a scoped
+ * stylesheet (all classes namespaced under `.re-root`).
+ */
+
+import { useEffect, useMemo, useState } from "react";
+import type {
+  EvaluationResponse,
+  ExecutedRule,
+  Outcome,
+  RuleNode,
+  RuleSetResult,
+  Severity,
+} from "./types";
+import { RULE_REVIEW_CSS } from "./styles";
+
+const STYLE_ID = "rule-review-styles";
+
+/** Inject the stylesheet once per document, on the client. */
+function useInjectStyles() {
+  useEffect(() => {
+    if (typeof document === "undefined") return;
+    if (document.getElementById(STYLE_ID)) return;
+    const el = document.createElement("style");
+    el.id = STYLE_ID;
+    el.textContent = RULE_REVIEW_CSS;
+    document.head.appendChild(el);
+  }, []);
+}
+
+export interface RuleReviewProps {
+  data: EvaluationResponse;
+  /** Initial view for each rule set. Default "table". */
+  defaultView?: "table" | "tree";
+}
+
+export default function RuleReview({ data, defaultView = "table" }: RuleReviewProps) {
+  useInjectStyles();
+  return (
+    <div className="re-root">
+      <OverallBanner data={data} />
+
+      {data.unknown_codes.length > 0 && (
+        <div className="re-unknown" role="alert">
+          <strong>No rules found</strong> for exception code
+          {data.unknown_codes.length > 1 ? "s" : ""}: {data.unknown_codes.join(", ")}
+        </div>
+      )}
+
+      {data.results.map((rs) => (
+        <RuleSetCard key={rs.exception_code} result={rs} defaultView={defaultView} />
+      ))}
+    </div>
+  );
+}
+
+/* ---------------------------------------------------------------- Banner */
+function OverallBanner({ data }: { data: EvaluationResponse }) {
+  const pass = data.decision;
+  const codes = data.results.map((r) => r.exception_code).join(", ");
+  return (
+    <div className={`re-banner ${pass ? "pass" : "fail"}`}>
+      <div className="re-banner-icon" aria-hidden>
+        {pass ? "✓" : "✗"}
+      </div>
+      <div>
+        <div className="re-banner-title">
+          Overall decision: {pass ? "PASS" : "FAIL"}
+        </div>
+        <div className="re-banner-sub">
+          {data.results.length} rule set{data.results.length === 1 ? "" : "s"}
+          {codes ? ` · ${codes}` : ""}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------- Rule set */
+function RuleSetCard({
+  result,
+  defaultView,
+}: {
+  result: RuleSetResult;
+  defaultView: "table" | "tree";
+}) {
+  const [onlyIssues, setOnlyIssues] = useState(false);
+  const [view, setView] = useState<"table" | "tree">(defaultView);
+
+  const rows = useMemo(
+    () =>
+      onlyIssues
+        ? result.executed_rules.filter(
+            (r) => r.outcome !== "PASS" && r.outcome !== "SKIPPED"
+          )
+        : result.executed_rules,
+    [onlyIssues, result.executed_rules]
+  );
+
+  const s = result.summary;
+
+  return (
+    <section className="re-card">
+      <header className="re-card-head">
+        <div>
+          <div className="re-code">{result.exception_code}</div>
+          <div className="re-setid">{result.rule_set_id}</div>
+        </div>
+        <StatusPill outcome={result.decision ? "PASS" : "FAIL"} large />
+      </header>
+
+      <div className="re-meta">
+        <span>
+          Mode: <code>{result.evaluation_mode}</code>
+        </span>
+        <span>Logical: {result.logical_passed ? "PASS" : "FAIL"}</span>
+      </div>
+
+      <div className="re-kpis">
+        <Kpi label="Total" value={s.total} tone="neutral" />
+        <Kpi label="Passed" value={s.passed} tone="pass" />
+        <Kpi label="Blocking" value={s.failed} tone="fail" />
+        <Kpi label="Warnings" value={s.warnings} tone="warn" />
+        <Kpi label="Errors" value={s.errors} tone="error" />
+        <Kpi label="Skipped" value={s.skipped ?? 0} tone="skip" />
+      </div>
+
+      {result.blocking_failures.length > 0 && (
+        <div className="re-blockers">
+          <div className="re-blockers-title">Blocking failures</div>
+          <ul>
+            {result.blocking_failures.map((f) => (
+              <li key={f.rule_id}>
+                <SeverityTag severity={f.severity} />
+                <span className="re-blocker-id">{f.rule_id}</span>
+                <span className="re-blocker-reason">{f.reason}</span>
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      <div className="re-table-tools">
+        <div className="re-viewswitch" role="tablist">
+          <button
+            role="tab"
+            aria-selected={view === "table"}
+            className={view === "table" ? "active" : ""}
+            onClick={() => setView("table")}
+          >
+            Table
+          </button>
+          <button
+            role="tab"
+            aria-selected={view === "tree"}
+            className={view === "tree" ? "active" : ""}
+            onClick={() => setView("tree")}
+          >
+            Hierarchy
+          </button>
+        </div>
+        {view === "table" ? (
+          <label className="re-toggle">
+            <input
+              type="checkbox"
+              checked={onlyIssues}
+              onChange={(e) => setOnlyIssues(e.target.checked)}
+            />
+            Show failures &amp; warnings only
+          </label>
+        ) : (
+          <span className="re-table-caption">Expand from root ↓</span>
+        )}
+      </div>
+
+      {view === "table" ? (
+        <div className="re-table-wrap">
+          <table className="re-table">
+            <thead>
+              <tr>
+                <th>Status</th>
+                <th>Rule</th>
+                <th>Severity</th>
+                <th>Check</th>
+                <th>Detail</th>
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((r) => (
+                <RuleRow key={r.rule_id} rule={r} />
+              ))}
+              {rows.length === 0 && (
+                <tr>
+                  <td colSpan={5} className="re-empty">
+                    Nothing to show.
+                  </td>
+                </tr>
+              )}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <div className="re-tree">
+          <TreeNode node={result.result_tree} depth={0} />
+        </div>
+      )}
+    </section>
+  );
+}
+
+/* --------------------------------------------------------------- Row */
+function RuleRow({ rule }: { rule: ExecutedRule }) {
+  const check = checkOf(rule);
+  const cls =
+    rule.outcome === "SKIPPED"
+      ? "skipped"
+      : rule.outcome !== "PASS"
+      ? "issue"
+      : "";
+
+  return (
+    <tr className={cls}>
+      <td>
+        <StatusPill outcome={rule.outcome} />
+      </td>
+      <td>
+        <div className="rid">
+          {rule.rule_id}
+          {rule.is_group_condition && <span className="gate">IF</span>}
+        </div>
+        <div className="rdesc">{rule.description}</div>
+      </td>
+      <td>
+        <SeverityTag severity={rule.severity} />
+      </td>
+      <td className="rcheck">{check.trim()}</td>
+      <td className="rdetail">
+        {rule.reason ? (
+          <span className="reason">{rule.reason}</span>
+        ) : (
+          <span className="ok">
+            {fmt(rule.left_value)}
+            {rule.right != null ? ` → ${fmt(rule.right_value)}` : ""}
+          </span>
+        )}
+      </td>
+    </tr>
+  );
+}
+
+/* ---------------------------------------------------------------- Tree */
+// A skipped branch is informational, not an issue: it never ran, so it should
+// not pull attention away from what actually failed.
+function subtreeHasIssue(node: RuleNode): boolean {
+  if (node.outcome === "SKIPPED") return false;
+  if (node.outcome === "FAIL" || node.outcome === "ERROR") return true;
+  if (!node.is_group) return node.outcome !== "PASS";
+  return node.children.some(subtreeHasIssue);
+}
+
+/** Count the conditions in a subtree that never ran. */
+function countSkipped(node: RuleNode): number {
+  if (!node.is_group) return node.outcome === "SKIPPED" ? 1 : 0;
+  return node.children.reduce((n, c) => n + countSkipped(c), 0);
+}
+
+/**
+ * Status of a group's gating condition. `condition_met` is what disambiguates a
+ * shut gate from failed contents — both leave the group with `outcome: "FAIL"`
+ * under the FAIL policy. A shut gate that merely skipped the branch is a
+ * statement about applicability (WARN); one that failed the group blocks (FAIL).
+ */
+function gateOutcome(node: RuleNode): Outcome {
+  if (node.condition_met) return "PASS";
+  return node.skipped ? "WARN" : "FAIL";
+}
+
+function TreeNode({ node, depth }: { node: RuleNode; depth: number }) {
+  // Open the root and any branch that contains a failure/warning; collapse
+  // fully-passing and gated-out branches so attention goes to what matters.
+  const [open, setOpen] = useState(depth === 0 || subtreeHasIssue(node));
+  const indent = { paddingLeft: depth * 18 };
+
+  if (!node.is_group) {
+    return (
+      <div className={`tnode leaf ${node.skipped ? "skipped" : ""}`} style={indent}>
+        <span className="tspacer" aria-hidden />
+        <StatusPill outcome={node.outcome} />
+        <span className="tid">{node.rule_id}</span>
+        <span className="tdesc">{node.description}</span>
+        <SeverityTag severity={node.severity} />
+        <span className="tcheck">{checkOf(node)}</span>
+        {node.reason && <span className="treason">{node.reason}</span>}
+      </div>
+    );
+  }
+
+  // A gate that did not open tells the reviewer why the branch was not
+  // checked, so it stays visible even while the branch is collapsed.
+  const gated = node.condition_met != null;
+  const gateShut = node.condition_met === false;
+  const hidden = gateShut ? countSkipped(node) : 0;
+
+  return (
+    <div className="tgroup">
+      <button
+        className={`tnode group ${node.skipped ? "skipped" : ""}`}
+        style={indent}
+        onClick={() => setOpen((o) => !o)}
+        aria-expanded={open}
+      >
+        <span className={`caret ${open ? "o" : ""}`} aria-hidden>
+          ▸
+        </span>
+        <StatusPill outcome={node.outcome} />
+        <span className={`logic ${(node.logical_operator ?? "").toLowerCase()}`}>
+          {node.logical_operator}
+        </span>
+        <span className="tdesc">{node.description}</span>
+        <span className="tid dim">{node.rule_id}</span>
+      </button>
+
+      {gated && (
+        <div
+          className={`tnode cond ${gateShut ? "shut" : ""}`}
+          style={{ paddingLeft: (depth + 1) * 18 }}
+        >
+          <span className="tspacer" aria-hidden />
+          <span className="gate">IF</span>
+          <StatusPill outcome={gateOutcome(node)} />
+          <span className="tcheck">{checkOf(node)}</span>
+          {gateShut && (
+            <span className="treason">
+              {node.reason} — {hidden} nested rule
+              {hidden === 1 ? "" : "s"} skipped
+            </span>
+          )}
+        </div>
+      )}
+
+      {open && (
+        <div className="tchildren">
+          {node.children.map((c) => (
+            <TreeNode key={c.rule_id} node={c} depth={depth + 1} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------ Primitives */
+function StatusPill({ outcome, large = false }: { outcome: Outcome; large?: boolean }) {
+  const map: Record<Outcome, { icon: string; label: string; cls: string }> = {
+    PASS: { icon: "✓", label: "Pass", cls: "pass" },
+    FAIL: { icon: "✗", label: "Fail", cls: "fail" },
+    WARN: { icon: "!", label: "Warn", cls: "warn" },
+    ERROR: { icon: "⚠", label: "Error", cls: "error" },
+    SKIPPED: { icon: "⊘", label: "Skipped", cls: "skip" },
+  };
+  const m = map[outcome];
+  return (
+    <span className={`pill ${m.cls} ${large ? "lg" : ""}`}>
+      <span aria-hidden>{m.icon}</span>
+      {m.label}
+    </span>
+  );
+}
+
+function SeverityTag({ severity }: { severity: Severity | null | undefined }) {
+  if (!severity) return <span className="dash">—</span>;
+  return <span className={`sev ${severity.toLowerCase()}`}>{severity}</span>;
+}
+
+function Kpi({
+  label,
+  value,
+  tone,
+}: {
+  label: string;
+  value: number;
+  tone: "neutral" | "pass" | "fail" | "warn" | "error" | "skip";
+}) {
+  return (
+    <div className={`kpi ${tone}`}>
+      <div className="v">{value}</div>
+      <div className="l">{label}</div>
+    </div>
+  );
+}
+
+/** Render a condition as `left operator right` (right is absent for unary ops). */
+function checkOf(c: {
+  left?: string | null;
+  right?: string | null;
+  operator?: string | null;
+}): string {
+  const parts = c.right ? [c.left, c.operator, c.right] : [c.left, c.operator];
+  return parts.filter(Boolean).join(" ");
+}
+
+/* Format a resolved operand value for display. */
+function fmt(v: unknown): string {
+  if (v === null || v === undefined) return "None";
+  if (typeof v === "string") return `"${v}"`;
+  if (typeof v === "object") return JSON.stringify(v);
+  return String(v);
+}
