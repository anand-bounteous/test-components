+"""Pydantic request/response models — the typed contract for the UI.
+
+These mirror the engine's domain objects but are shaped for consumption by a
+front-end: a flat ``executed_rules`` list for tables, a ``summary`` for badges,
+and an optional ``result_tree`` for rendering the rule hierarchy.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Literal, Optional
+
+from pydantic import BaseModel, Field
+
+
+Outcome = Literal["PASS", "FAIL", "WARN", "ERROR", "SKIPPED"]
+Severity = Literal["CRITICAL", "HIGH", "MEDIUM", "LOW"]
+
+
+# ---------------------------------------------------------------------------
+# Request
+# ---------------------------------------------------------------------------
+class EvaluationRequest(BaseModel):
+    exception_codes: List[str] = Field(
+        ..., description="Exception codes to evaluate; selects the rule sets.",
+        examples=[["SOF002", "SOF005"]],
+    )
+    documents: Dict[str, Dict[str, Any]] = Field(
+        default_factory=dict,
+        description="Extracted document fields, keyed by document type.",
+        examples=[{"INVOICE": {"counterparty_name": "Acme Trading Ltd"}}],
+    )
+    application: Dict[str, Any] = Field(
+        default_factory=dict,
+        description="Application data fields (flat key/value bag).",
+        examples=[{"currency": "GBP", "requested_amount": 15000}],
+    )
+    user_statement: Dict[str, Any] = Field(
+        default_factory=dict,
+        description="User statement fields (flat key/value bag, same shape as "
+                    "application). Addressed by rules as "
+                    '{"source": "USER_STATEMENT", "field": "..."}.',
+        examples=[{"declared_source": "gift", "declared_amount": 15000}],
+    )
+    calculated_results: Dict[str, Any] = Field(
+        default_factory=dict,
+        description="Values derived upstream — totals, ratios, scores (flat "
+                    "key/value bag). Addressed by rules as "
+                    '{"source": "CALCULATED_RESULTS", "field": "..."}.',
+        examples=[{"total_line_items": 15000, "shortfall_ratio": 0.2}],
+    )
+
+    model_config = {
+        "json_schema_extra": {
+            "examples": [{
+                "exception_codes": ["SOF002"],
+                "documents": {
+                    "INVOICE": {"counterparty_name": "Acme Trading Ltd",
+                                "counterparty_address": "1 High Street"},
+                    "CONTRACT": {"contract_name": "MSA",
+                                 "contract_address": "1 High Street"},
+                },
+                "application": {"currency": "GBP", "requested_amount": 15000},
+                "user_statement": {"declared_source": "gift",
+                                   "declared_amount": 15000},
+                "calculated_results": {"total_line_items": 15000,
+                                       "shortfall_ratio": 0.2},
+            }]
+        }
+    }
+
+
+# ---------------------------------------------------------------------------
+# Response
+# ---------------------------------------------------------------------------
+class ExecutedRule(BaseModel):
+    """One evaluated leaf condition — the row a UI table would render."""
+    rule_id: str
+    description: str
+    operator: Optional[str] = None
+    severity: Optional[Severity] = None
+    left: Optional[str] = Field(None, description="Left operand location, e.g. INVOICE.currency")
+    left_value: Any = Field(None, description="Resolved left value from the input")
+    right: Optional[str] = Field(None, description="Right operand location or static(...)")
+    right_value: Any = Field(None, description="Resolved right value")
+    passed: bool
+    outcome: Outcome = Field(
+        ...,
+        description="PASS | FAIL (blocking) | WARN (non-blocking) | ERROR | "
+                    "SKIPPED (a group condition above it was not met)",
+    )
+    reason: Optional[str] = Field(None, description="Failure detail with operand values")
+    is_group_condition: bool = Field(
+        False,
+        description="True when this row is a group's gating condition rather "
+                    "than a rule of its own.",
+    )
+
+
+class Failure(BaseModel):
+    rule_id: str
+    severity: Optional[Severity] = None
+    reason: Optional[str] = None
+
+
+class Summary(BaseModel):
+    """Counts for UI badges / progress bars."""
+    total: int
+    passed: int
+    failed: int = Field(..., description="Blocking failures")
+    warnings: int = Field(..., description="Non-blocking failures")
+    errors: int
+    skipped: int = Field(0, description="Not evaluated — gated out by a group condition")
+
+
+class RuleNode(BaseModel):
+    """A node in the rule tree — group (has children) or leaf. For UIs that
+    want to render the AND/OR hierarchy rather than a flat list.
+
+    The condition fields (``operator`` / ``left`` / ``right`` / ``severity``)
+    describe the node's own check: for a leaf that is the rule itself, and for a
+    group it is the gating condition that decides whether the children run.
+    They are null on an ungated group.
+    """
+    rule_id: str
+    description: str
+    passed: bool
+    is_group: bool
+    outcome: Outcome
+    logical_operator: Optional[str] = None
+    operator: Optional[str] = None
+    severity: Optional[Severity] = None
+    left: Optional[str] = None
+    left_value: Any = None
+    right: Optional[str] = None
+    right_value: Any = None
+    reason: Optional[str] = None
+    skipped: bool = Field(
+        False, description="Node never ran — a group condition above it was not met."
+    )
+    condition_met: Optional[bool] = Field(
+        None,
+        description="For a gated group: whether its gating condition held. "
+                    "False means the children were skipped, which is otherwise "
+                    "indistinguishable from the children having failed. Null "
+                    "when the node has no gating condition.",
+    )
+    children: List["RuleNode"] = Field(default_factory=list)
+
+
+class RuleSetResult(BaseModel):
+    """Result for a single exception code / rule set."""
+    exception_code: str
+    rule_set_id: str
+    evaluation_mode: str
+    logical_passed: bool = Field(..., description="Raw boolean of the whole tree")
+    decision: bool = Field(..., description="Final verdict after applying evaluation_mode")
+    summary: Summary
+    blocking_failures: List[Failure]
+    executed_rules: List[ExecutedRule]
+    result_tree: RuleNode
+
+
+class EvaluationResponse(BaseModel):
+    """Top-level response for a batch of exception codes."""
+    decision: bool = Field(..., description="Overall PASS only if every code passed")
+    unknown_codes: List[str] = Field(
+        default_factory=list,
+        description="Requested codes with no matching rule set.",
+    )
+    results: List[RuleSetResult]
+
+
+class RuleSetInfo(BaseModel):
+    exception_code: str
+    rule_set_id: str
+    evaluation_mode: str
+    rule_count: int
+
+
+class RuleSetsResponse(BaseModel):
+    rule_sets: List[RuleSetInfo]
