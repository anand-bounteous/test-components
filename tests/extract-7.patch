--- components-empty-1/src/rule_engine/api/app.py	1970-01-01 05:30:00
+++ rule-engine/src/rule_engine/api/app.py	2026-08-13 18:34:00
@@ -0,0 +1,124 @@
+"""FastAPI application exposing the rule engine as a REST service.
+
+Run:
+    export RULE_ENGINE_RULES_DIR=rules      # optional, defaults to "rules"
+    rule-engine-api                          # console script
+    # or
+    uvicorn rule_engine.api.app:app --reload
+
+Endpoints:
+    GET  /health           liveness probe
+    GET  /rule-sets        list available exception codes / rule sets
+    POST /evaluate         evaluate a request payload
+Interactive docs at /docs (Swagger) and /redoc.
+"""
+
+from __future__ import annotations
+
+import os
+
+from fastapi import FastAPI, HTTPException
+from fastapi.middleware.cors import CORSMiddleware
+
+from ..service import RuleEngineService
+from .builders import build_response
+from .models import (
+    EvaluationRequest,
+    EvaluationResponse,
+    RuleSetInfo,
+    RuleSetsResponse,
+)
+
+
+def _count_rules(rule_set: dict) -> int:
+    n = 0
+    def walk(node):
+        nonlocal n
+        if "rules" in node:
+            # A group carrying an operator has a gating condition of its own,
+            # which is a condition that gets evaluated like any other.
+            if "operator" in node:
+                n += 1
+            for c in node["rules"]:
+                walk(c)
+        else:
+            n += 1
+    for r in rule_set.get("rules", []):
+        walk(r)
+    return n
+
+
+def create_app(rules_dir: str | None = None) -> FastAPI:
+    rules_dir = rules_dir or os.environ.get("RULE_ENGINE_RULES_DIR", "rules")
+    service = RuleEngineService.from_directory(rules_dir)
+
+    app = FastAPI(
+        title="Rule Engine API",
+        version="0.1.0",
+        description="Evaluate SOF exception rule sets against document and "
+                    "application data.",
+    )
+    # Keep a handle so tests / other code can reach the service.
+    app.state.service = service
+
+    # CORS so a browser UI (e.g. Next.js on :3000) can call the API.
+    # Set RULE_ENGINE_CORS_ORIGINS="https://app.example.com,https://..." to lock
+    # down in production; defaults to "*" for local development.
+    origins = os.environ.get("RULE_ENGINE_CORS_ORIGINS", "*")
+    app.add_middleware(
+        CORSMiddleware,
+        allow_origins=["*"] if origins == "*" else
+        [o.strip() for o in origins.split(",") if o.strip()],
+        allow_methods=["*"],
+        allow_headers=["*"],
+    )
+
+    @app.get("/health")
+    def health() -> dict:
+        return {"status": "ok", "rule_sets": service.repository.codes()}
+
+    @app.get("/rule-sets", response_model=RuleSetsResponse)
+    def rule_sets() -> RuleSetsResponse:
+        infos = []
+        for code in service.repository.codes():
+            rs = service.repository.get(code)
+            infos.append(RuleSetInfo(
+                exception_code=code,
+                rule_set_id=rs.get("rule_set_id", ""),
+                evaluation_mode=rs.get("evaluation_mode", ""),
+                rule_count=_count_rules(rs),
+            ))
+        return RuleSetsResponse(rule_sets=infos)
+
+    @app.post("/evaluate", response_model=EvaluationResponse)
+    def evaluate(request: EvaluationRequest) -> EvaluationResponse:
+        if not request.exception_codes:
+            raise HTTPException(status_code=422,
+                                detail="exception_codes must not be empty")
+        batch = service.evaluate(
+            exception_codes=request.exception_codes,
+            documents=request.documents,
+            application=request.application,
+            user_statement=request.user_statement,
+            calculated_results=request.calculated_results,
+        )
+        return build_response(batch)
+
+    return app
+
+
+# Module-level app for `uvicorn rule_engine.api.app:app`
+app = create_app()
+
+
+def main() -> None:
+    """Console entry point: `rule-engine-api`."""
+    import uvicorn
+
+    host = os.environ.get("RULE_ENGINE_HOST", "127.0.0.1")
+    port = int(os.environ.get("RULE_ENGINE_PORT", "8000"))
+    uvicorn.run("rule_engine.api.app:app", host=host, port=port, reload=False)
+
+
+if __name__ == "__main__":
+    main()
