+"use client";
+
+// Example App Router page (app/review/page.tsx) that calls the API and shows
+// the review component. Set NEXT_PUBLIC_RULE_ENGINE_URL to your API base.
+
+import { useState } from "react";
+import { RuleReview } from "../components/RuleReview";
+import type { EvaluationResponse } from "../components/RuleReview";
+
+const API_BASE =
+  process.env.NEXT_PUBLIC_RULE_ENGINE_URL ?? "http://127.0.0.1:8000";
+
+const SAMPLE_REQUEST = {
+  exception_codes: ["SOF002"],
+  documents: {
+    INVOICE: {
+      counterparty_name: "Acme Trading Ltd",
+      counterparty_address: "1 High Street, London",
+    },
+    CONTRACT: {
+      contract_name: "Master Services Agreement",
+      contract_address: "1 High Street, London",
+    },
+  },
+  application: { currency: "GBP", requested_amount: 15000 },
+  user_statement: { declared_source: "gift", declared_amount: 15000 },
+  calculated_results: { total_line_items: 15000, shortfall_ratio: 0.2 },
+};
+
+export default function ReviewPage() {
+  const [payload, setPayload] = useState(
+    JSON.stringify(SAMPLE_REQUEST, null, 2)
+  );
+  const [data, setData] = useState<EvaluationResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  async function run() {
+    setLoading(true);
+    setError(null);
+    try {
+      const res = await fetch(`${API_BASE}/evaluate`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: payload,
+      });
+      if (!res.ok) throw new Error(`HTTP ${res.status}: ${await res.text()}`);
+      setData((await res.json()) as EvaluationResponse);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  return (
+    <main style={{ background: "#f6f7f9", minHeight: "100vh" }}>
+      <div style={{ maxWidth: 1040, margin: "0 auto", padding: "24px 16px 0" }}>
+        <h1 style={{ fontSize: 20, margin: "0 0 12px" }}>
+          SOF Exception — Rule Review
+        </h1>
+        <textarea
+          value={payload}
+          onChange={(e) => setPayload(e.target.value)}
+          rows={10}
+          spellCheck={false}
+          style={{
+            width: "100%",
+            fontFamily: "ui-monospace, Menlo, monospace",
+            fontSize: 12,
+            padding: 12,
+            borderRadius: 10,
+            border: "1px solid #e5e7eb",
+            boxSizing: "border-box",
+          }}
+        />
+        <button
+          onClick={run}
+          disabled={loading}
+          style={{
+            marginTop: 10,
+            padding: "8px 18px",
+            borderRadius: 8,
+            border: "none",
+            background: "#4f46e5",
+            color: "#fff",
+            fontWeight: 600,
+            cursor: "pointer",
+          }}
+        >
+          {loading ? "Evaluating…" : "Evaluate"}
+        </button>
+        {error && (
+          <div style={{ color: "#b91c1c", marginTop: 10, fontSize: 13 }}>
+            {error}
+          </div>
+        )}
+      </div>
+
+      {data && <RuleReview data={data} />}
+    </main>
+  );
+}
