--- components-empty-1/mock-server/src/store.ts	1970-01-01 05:30:00
+++ rule-engine-ui/mock-server/src/store.ts	2026-08-12 13:12:52
@@ -0,0 +1,169 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const dataDir = path.join(__dirname, 'data');
+
+export interface RuleConfiguration {
+  rule_config_id: number;
+  rule_key: string;
+  version: number;
+  status: 'draft' | 'active' | 'inactive' | 'decommissioned';
+  active_from: string | null;
+  active_to: string | null;
+  based_on_version: number | null;
+  /** Overrides the slug-derived filename when a rule set's file is named differently. */
+  rule_file?: string;
+}
+
+function readJson<T>(relPath: string): T {
+  return JSON.parse(fs.readFileSync(path.join(dataDir, relPath), 'utf-8'));
+}
+
+function writeJson(relPath: string, data: unknown) {
+  const target = path.join(dataDir, relPath);
+  // The rule key reaches us from the URL path, so confirm the resolved target
+  // is still inside the data directory before writing anything.
+  if (!path.resolve(target).startsWith(path.resolve(dataDir) + path.sep)) {
+    throw new Error('Refusing to write outside the data directory');
+  }
+  fs.writeFileSync(target, JSON.stringify(data, null, 2) + '\n');
+}
+
+let configs: RuleConfiguration[] = readJson('ruleConfigurations.json');
+let nextConfigId = Math.max(...configs.map((c) => c.rule_config_id)) + 1;
+
+export const metadata = readJson('metadata.json');
+export const executions = readJson('executions.json');
+
+const ruleTrees = new Map<string, any>();
+function ruleTreeKey(ruleKey: string, version: number) {
+  return `${ruleKey}::${version}`;
+}
+function slugify(ruleKey: string) {
+  // Strip everything that is not safe in a filename — the slug is used to build
+  // a path, and the rule key is caller-supplied.
+  return ruleKey
+    .toLowerCase()
+    .replace(/\s+/g, '')
+    .replace(/[^a-z0-9._-]/g, '');
+}
+
+for (const cfg of configs) {
+  const key = ruleTreeKey(cfg.rule_key, cfg.version);
+  if (ruleTrees.has(key)) continue;
+  const filename = `${slugify(cfg.rule_key)}-v${cfg.version}.json`;
+  const draftFilename = `${slugify(cfg.rule_key)}-v${cfg.version}-draft.json`;
+  const filePath =
+    cfg.rule_file ??
+    (fs.existsSync(path.join(dataDir, 'rules', filename)) ? filename : draftFilename);
+  ruleTrees.set(key, readJson(path.join('rules', filePath)));
+}
+
+const executionTrees = new Map<string, any>();
+for (const exec of executions as any[]) {
+  executionTrees.set(exec.execution_id, readJson(path.join('rules', 'executions', `${exec.execution_id}.json`)));
+}
+
+function isActiveNow(cfg: RuleConfiguration): boolean {
+  if (!cfg.active_from || !cfg.active_to) return false;
+  const now = new Date().toISOString();
+  return cfg.active_from <= now && now < cfg.active_to;
+}
+
+export function listConfigurations() {
+  return configs.map((c) => ({ ...c, is_active: isActiveNow(c) }));
+}
+
+export function listConfigurationsForKey(ruleKey: string) {
+  return listConfigurations()
+    .filter((c) => c.rule_key === ruleKey)
+    .sort((a, b) => (b.active_from ?? '9999').localeCompare(a.active_from ?? '9999'));
+}
+
+export function getRuleTree(ruleKey: string, version: number) {
+  return ruleTrees.get(ruleTreeKey(ruleKey, version));
+}
+
+export function getExecution(executionId: string) {
+  const record = (executions as any[]).find((e) => e.execution_id === executionId);
+  if (!record) return null;
+  return { record, tree: executionTrees.get(executionId) };
+}
+
+export function saveDraft(ruleKey: string, basedOnVersion: number, editedRuleSet: any) {
+  // Read-modify-write against the file rather than dumping our in-memory view:
+  // the file is the record of what exists, and it may have been edited since we
+  // booted. Writing `configs` wholesale would clobber those edits and resurrect
+  // rows that were deleted from disk.
+  const onDisk = readJson<RuleConfiguration[]>('ruleConfigurations.json');
+
+  // A draft is always a new version of a rule key that already exists, so an
+  // unknown key is a client error — not licence to create a rule set (and a
+  // file) named after arbitrary input.
+  const existing = onDisk.filter((c) => c.rule_key === ruleKey);
+  if (existing.length === 0) throw new Error(`Unknown rule_key "${ruleKey}"`);
+
+  const slug = slugify(ruleKey);
+  if (!slug) throw new Error('Rule key does not produce a usable file name');
+
+  const newVersion = Math.max(...existing.map((c) => c.version), 0) + 1;
+  const ruleFile = `${slug}-v${newVersion}.json`;
+  const newConfig: RuleConfiguration = {
+    rule_config_id: Math.max(...onDisk.map((c) => c.rule_config_id), 0) + 1,
+    rule_key: ruleKey,
+    version: newVersion,
+    status: 'draft',
+    active_from: null,
+    active_to: null,
+    based_on_version: basedOnVersion,
+    rule_file: ruleFile,
+  };
+
+  // Write the rule set first: a draft in memory but not on disk would silently
+  // vanish on restart, and a half-written pair is worse than neither. The
+  // envelope's own `version` is its schema version ("2.0"), not the
+  // configuration's numeric version, so it is stored exactly as submitted.
+  writeJson(path.join('rules', ruleFile), editedRuleSet);
+  try {
+    writeJson('ruleConfigurations.json', [...onDisk, newConfig]);
+  } catch (error) {
+    // Roll back the orphaned rule file so the seed data stays consistent.
+    fs.rmSync(path.join(dataDir, 'rules', ruleFile), { force: true });
+    throw error;
+  }
+
+  // Re-sync memory from what we just wrote, dropping any rows that no longer
+  // exist on disk, so the served list matches the files.
+  configs = [...onDisk, newConfig];
+  nextConfigId = newConfig.rule_config_id + 1;
+  ruleTrees.set(ruleTreeKey(ruleKey, newVersion), editedRuleSet);
+  return newConfig;
+}
+
+export function activateConfig(ruleConfigId: number, activeFrom: string) {
+  const target = configs.find((c) => c.rule_config_id === ruleConfigId);
+  if (!target) throw new Error('rule_config_id not found');
+
+  const currentlyActive = configs.find(
+    (c) => c.rule_key === target.rule_key && c.status === 'active',
+  );
+  if (currentlyActive && currentlyActive.rule_config_id !== target.rule_config_id) {
+    currentlyActive.active_to = activeFrom;
+    currentlyActive.status = 'inactive';
+  }
+
+  target.active_from = activeFrom;
+  target.active_to = '9999-12-31T23:59:59+05:30';
+  target.status = 'active';
+  return target;
+}
+
+export function decommission(ruleKey: string) {
+  const active = configs.find((c) => c.rule_key === ruleKey && c.status === 'active');
+  if (!active) throw new Error('No active version to decommission');
+  active.active_to = new Date().toISOString();
+  active.status = 'decommissioned';
+  return active;
+}
