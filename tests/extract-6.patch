+import React, { useEffect, useMemo, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { RuleViewer, DiffView } from 'rule-tree-viewer';
+import { api } from '../api/client';
+
+interface RuleConfig {
+  rule_config_id: number;
+  rule_key: string;
+  version: number;
+  status: string;
+  is_active: boolean;
+  active_from: string | null;
+  active_to: string | null;
+  based_on_version: number | null;
+}
+
+export default function Dashboard() {
+  const [configs, setConfigs] = useState<RuleConfig[]>([]);
+  const [selectedKey, setSelectedKey] = useState<string | null>(null);
+  const [selectedVersion, setSelectedVersion] = useState<number | null>(null);
+  const [compareVersion, setCompareVersion] = useState<number | null>(null);
+  const [tree, setTree] = useState<any>(null);
+  const [compareTree, setCompareTree] = useState<any>(null);
+  const [metadata, setMetadata] = useState<any>(null);
+
+  useEffect(() => {
+    api.listConfigurations().then((d) => setConfigs(d.rule_configuration.configs));
+    api.getMetadata().then(setMetadata);
+  }, []);
+
+  const ruleKeys = useMemo(() => Array.from(new Set(configs.map((c) => c.rule_key))), [configs]);
+
+  const historyForKey = useMemo(
+    () =>
+      configs
+        .filter((c) => c.rule_key === selectedKey)
+        .sort((a, b) => (b.active_from ?? '9999').localeCompare(a.active_from ?? '9999')),
+    [configs, selectedKey],
+  );
+
+  function selectRuleKey(key: string) {
+    setSelectedKey(key);
+    const history = configs
+      .filter((c) => c.rule_key === key)
+      .sort((a, b) => (b.active_from ?? '9999').localeCompare(a.active_from ?? '9999'));
+    const active = history.find((c) => c.is_active) ?? history[0];
+    setSelectedVersion(active?.version ?? null);
+    setCompareVersion(null);
+  }
+
+  useEffect(() => {
+    if (selectedKey && selectedVersion != null) {
+      api.getRuleTree(selectedKey, selectedVersion).then((t) => setTree(t));
+    } else {
+      setTree(null);
+    }
+  }, [selectedKey, selectedVersion]);
+
+  useEffect(() => {
+    if (selectedKey && compareVersion != null) {
+      api.getRuleTree(selectedKey, compareVersion).then((t) => setCompareTree(t));
+    } else {
+      setCompareTree(null);
+    }
+  }, [selectedKey, compareVersion]);
+
+  return (
+    <div className="space-y-6">
+      <h1 className="text-xl font-bold">Rules Dashboard</h1>
+
+      <table className="w-full border-collapse text-sm">
+        <thead>
+          <tr className="text-left border-b border-gray-200">
+            <th className="py-2">Rule Key</th>
+            <th>Active Version</th>
+            <th>Last Modified</th>
+          </tr>
+        </thead>
+        <tbody>
+          {ruleKeys.map((key) => {
+            const rows = configs.filter((c) => c.rule_key === key);
+            const active = rows.find((c) => c.is_active);
+            return (
+              <tr
+                key={key}
+                className={`border-b border-gray-100 cursor-pointer ${
+                  selectedKey === key ? 'bg-blue-50' : 'hover:bg-gray-50'
+                }`}
+                onClick={() => selectRuleKey(key)}
+              >
+                <td className="py-2">{key}</td>
+                <td>
+                  {active ? (
+                    <span className="text-green-700">v{active.version} ● active</span>
+                  ) : (
+                    <span className="text-gray-500">no active version</span>
+                  )}
+                </td>
+                <td>{rows.sort((a, b) => b.version - a.version)[0]?.active_from ?? '—'}</td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+
+      {selectedKey && (
+        <div className="space-y-4 border-t border-gray-200 pt-4">
+          <div className="flex items-center gap-2 flex-wrap">
+            <span className="font-semibold">{selectedKey}</span>
+            {historyForKey.map((c) => (
+              <button
+                key={c.rule_config_id}
+                onClick={() => setSelectedVersion(c.version)}
+                className={`px-2 py-1 rounded text-xs border ${
+                  selectedVersion === c.version ? 'bg-blue-600 text-white' : 'bg-white'
+                }`}
+              >
+                v{c.version} {c.status}
+              </button>
+            ))}
+            <Link
+              to={`/settings/rules/${encodeURIComponent(selectedKey)}/${selectedVersion}`}
+              className="ml-4 text-blue-600 underline text-sm"
+            >
+              Open in Settings
+            </Link>
+            <select
+              className="ml-4 border rounded text-xs px-1 py-1"
+              value={compareVersion ?? ''}
+              onChange={(e) => setCompareVersion(e.target.value ? Number(e.target.value) : null)}
+            >
+              <option value="">Compare against…</option>
+              {historyForKey
+                .filter((c) => c.version !== selectedVersion)
+                .map((c) => (
+                  <option key={c.rule_config_id} value={c.version}>
+                    v{c.version}
+                  </option>
+                ))}
+            </select>
+          </div>
+
+          {tree && !compareTree && <RuleViewer rule={tree} metadata={metadata} />}
+
+          {tree && compareTree && (
+            <DiffView current={tree.rules} original={compareTree.rules} metadata={metadata} />
+          )}
+
+          <div>
+            <h2 className="font-semibold mb-2">Historical Configuration</h2>
+            <table className="w-full border-collapse text-sm">
+              <thead>
+                <tr className="text-left border-b border-gray-200">
+                  <th className="py-1">Version</th>
+                  <th>Status</th>
+                  <th>Active From</th>
+                  <th>Active To</th>
+                  <th>Based On</th>
+                </tr>
+              </thead>
+              <tbody>
+                {historyForKey.map((c) => (
+                  <tr key={c.rule_config_id} className="border-b border-gray-100">
+                    <td className="py-1">v{c.version}</td>
+                    <td>{c.status}</td>
+                    <td>{c.active_from ?? '—'}</td>
+                    <td>{c.active_to ?? '—'}</td>
+                    <td>{c.based_on_version ? `v${c.based_on_version}` : '—'}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
