+const BASE_URL = import.meta.env.VITE_API_BASE_URL ?? 'http://localhost:4000/api';
+
+async function request(path: string, init?: RequestInit) {
+  const res = await fetch(`${BASE_URL}${path}`, {
+    headers: { 'Content-Type': 'application/json' },
+    ...init,
+  });
+  if (!res.ok) throw new Error(`Request failed: ${res.status} ${await res.text()}`);
+  return res.json();
+}
+
+export const api = {
+  listConfigurations: () => request('/rule-configurations'),
+  listConfigurationsForKey: (ruleKey: string) =>
+    request(`/rule-configurations/${encodeURIComponent(ruleKey)}`),
+  getRuleTree: (ruleKey: string, version: number) =>
+    request(`/rules/${encodeURIComponent(ruleKey)}/${version}`),
+  getMetadata: () => request('/metadata'),
+  /** Saves a whole rule set envelope ({ rule_set_id, version, evaluation_mode, rules[] }) as a new draft. */
+  saveDraft: (ruleKey: string, basedOnVersion: number, ruleSet: unknown) =>
+    request(`/rules/${encodeURIComponent(ruleKey)}`, {
+      method: 'PUT',
+      body: JSON.stringify({ based_on_version: basedOnVersion, rule_set: ruleSet }),
+    }),
+  activate: (ruleConfigId: number, activeFrom?: string) =>
+    request(`/rule-configurations/${ruleConfigId}/activate`, {
+      method: 'POST',
+      body: JSON.stringify({ active_from: activeFrom }),
+    }),
+  decommission: (ruleKey: string) =>
+    request(`/rule-configurations/${encodeURIComponent(ruleKey)}/decommission`, {
+      method: 'POST',
+    }),
+  listExecutions: (params?: { ruleKey?: string; result?: boolean }) => {
+    const qs = new URLSearchParams();
+    if (params?.ruleKey) qs.set('ruleKey', params.ruleKey);
+    if (params?.result !== undefined) qs.set('result', String(params.result));
+    const query = qs.toString();
+    return request(`/executions${query ? `?${query}` : ''}`);
+  },
+  getExecution: (executionId: string) => request(`/executions/${executionId}`),
+};
