+import {
+  DEFAULT_UNARY_OPERATORS,
+} from '../editing/validation';
+import type { FieldType, RuleMetadata, RuleNode, RuleSet, SourceType } from '../types';
+
+/**
+ * Anything a caller might reasonably hand us as "the rule JSON":
+ * a full rule set envelope, a bare array of root nodes, or a single node.
+ */
+export type RuleInput = RuleSet | RuleNode[] | RuleNode;
+
+export interface NormalizedRule {
+  /** The envelope fields, when the input carried them. */
+  ruleSet?: Omit<RuleSet, 'rules'>;
+  /** Always an array — the format's root is a list of nodes. */
+  roots: RuleNode[];
+  /** How the input was shaped, so output can be given back the same way. */
+  shape: 'ruleSet' | 'array' | 'node';
+}
+
+function isRuleSet(input: RuleInput): input is RuleSet {
+  if (Array.isArray(input)) return false;
+  // A node always carries `rule_id`; an envelope never does. Testing only for a
+  // `rules` array would misread a condition group as an envelope and silently
+  // discard its gate, promoting its children to roots.
+  if (typeof (input as RuleNode).rule_id === 'string') return false;
+  return Array.isArray((input as RuleSet).rules);
+}
+
+/** Accepts any supported input shape and returns the roots plus the envelope. */
+export function normalizeRule(input: RuleInput): NormalizedRule {
+  if (Array.isArray(input)) {
+    return { roots: input, shape: 'array' };
+  }
+  if (isRuleSet(input)) {
+    const { rules, ...ruleSet } = input;
+    return { ruleSet, roots: rules, shape: 'ruleSet' };
+  }
+  // A single node: `rules` here (if present) is its children, not the root list.
+  return { roots: [input as RuleNode], shape: 'node' };
+}
+
+/**
+ * Rebuilds the caller's original shape around edited roots, so what comes out of
+ * `onChange` can be saved straight back wherever the input came from.
+ */
+export function denormalizeRule(normalized: NormalizedRule, roots: RuleNode[]): RuleInput {
+  switch (normalized.shape) {
+    case 'ruleSet':
+      return { ...(normalized.ruleSet as Omit<RuleSet, 'rules'>), rules: roots } as RuleSet;
+    case 'node':
+      return roots[0];
+    default:
+      return roots;
+  }
+}
+
+const DEFAULT_OPERATORS = [
+  'equals',
+  'not_equals',
+  'greater_than',
+  'less_than',
+  'greater_than_or_equals',
+  'less_than_or_equals',
+  'contains',
+  'starts_with',
+  'ends_with',
+  ...DEFAULT_UNARY_OPERATORS,
+];
+
+const FIELD_TYPES: FieldType[] = ['string', 'number', 'date', 'datetime', 'currency'];
+
+function walk(nodes: RuleNode[], visit: (node: RuleNode) => void) {
+  nodes.forEach((node) => {
+    visit(node);
+    if (node.rules) walk(node.rules, visit);
+  });
+}
+
+/**
+ * Builds usable metadata from the rule JSON itself, for callers that have no
+ * `/metadata` endpoint to hand. Document types and their fields come from what
+ * the rules actually reference, so the editor's dropdowns are populated with
+ * real options rather than being empty; the operator vocabulary falls back to
+ * the built-in list.
+ *
+ * Supplying real metadata is still better — it can offer documents and fields
+ * that no rule uses yet. This only ensures the component is never unusable.
+ */
+export function deriveMetadata(roots: RuleNode[]): RuleMetadata {
+  const documentTypes = new Set<string>();
+  const documentFields = new Map<string, Set<string>>();
+  const currencies = new Set<string>();
+  const operators = new Set<string>(DEFAULT_OPERATORS);
+
+  walk(roots, (node) => {
+    if (node.operator) operators.add(node.operator);
+    for (const operand of [node.left_operand, node.right_operand]) {
+      if (!operand) continue;
+      if (operand.metadata?.currency) currencies.add(operand.metadata.currency);
+      if (!operand.document_type) continue;
+      documentTypes.add(operand.document_type);
+      if (operand.field) {
+        const fields = documentFields.get(operand.document_type) ?? new Set<string>();
+        fields.add(operand.field);
+        documentFields.set(operand.document_type, fields);
+      }
+    }
+  });
+
+  const operatorList = [...operators];
+  const supported = Object.fromEntries([
+    ['any', operatorList],
+    ...FIELD_TYPES.map((type) => [type, operatorList] as const),
+  ]) as RuleMetadata['supported_operators'];
+
+  return {
+    source_type: ['DOCUMENT', 'APPLICATION', 'STATIC'] as SourceType[],
+    document_type: [...documentTypes],
+    document_fields: Object.fromEntries(
+      [...documentFields].map(([doc, fields]) => [doc, [...fields]]),
+    ),
+    supported_operators: supported,
+    unary_operators: DEFAULT_UNARY_OPERATORS,
+    currency: currencies.size > 0 ? [...currencies] : ['GBP', 'USD', 'EUR'],
+  };
+}
