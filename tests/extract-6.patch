+import type { RuleNode } from '../types';
+
+interface AddDeleteToolbarProps {
+  node: RuleNode;
+  onAddChild: () => void;
+  onAddSibling: () => void;
+  onDelete: () => void;
+}
+
+/**
+ * Structural actions for one row: add a child, add a sibling, delete. Every node
+ * offers all three — a leaf that gains a child becomes a condition group, which
+ * is the one shape change the editor performs, and only on explicit request.
+ */
+export function AddDeleteToolbar({
+  node,
+  onAddChild,
+  onAddSibling,
+  onDelete,
+}: AddDeleteToolbarProps) {
+  return (
+    <span className="rt-toolbar" onClick={(e) => e.stopPropagation()}>
+      <button type="button" onClick={onAddChild}>
+        + Add child
+      </button>
+      <button type="button" onClick={onAddSibling}>
+        + Add sibling
+      </button>
+      <button
+        type="button"
+        onClick={() => {
+          const count = countDescendants(node);
+          if (count === 0 || window.confirm(`Delete this and ${count} descendant rule(s)?`)) {
+            onDelete();
+          }
+        }}
+      >
+        Delete
+      </button>
+    </span>
+  );
+}
+
+function countDescendants(node: RuleNode): number {
+  if (!node.rules) return 0;
+  return node.rules.reduce((sum, child) => sum + 1 + countDescendants(child), 0);
+}
