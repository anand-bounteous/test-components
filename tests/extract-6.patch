+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import type { RuleMetadata, RuleNode } from './types';
+import { RuleTreeViewer } from './RuleTreeViewer';
+import { validateTree, type ValidationIssue } from './editing/validation';
+import {
+  denormalizeRule,
+  deriveMetadata,
+  normalizeRule,
+  type RuleInput,
+} from './api/normalize';
+
+export interface RuleEditorProps {
+  /** The rule JSON: a rule set envelope, an array of root nodes, or a single node. */
+  rule: RuleInput;
+  /**
+   * Called on every edit with the updated rule JSON, in the **same shape** as
+   * `rule` was given — pass an envelope, get an envelope back, ready to save.
+   */
+  onChange?: (updated: RuleInput) => void;
+  /** Called whenever validity changes, so a Save button can be enabled/disabled. */
+  onValidate?: (issues: ValidationIssue[]) => void;
+  /** Optional. Derived from the rule JSON when omitted. */
+  metadata?: RuleMetadata;
+  /** Hides the envelope header even when the input carries one. */
+  hideHeader?: boolean;
+  /** Hides the tree/JSON toggle and the Copy/Download buttons. */
+  hideToolbar?: boolean;
+  defaultExpanded?: boolean;
+  fileName?: string;
+  className?: string;
+}
+
+/**
+ * Editable rule tree. Holds its own working copy, so it can be dropped in with
+ * only the rule JSON and a change handler:
+ *
+ * ```tsx
+ * import { RuleEditor } from 'rule-tree-viewer';
+ * import 'rule-tree-viewer/theme.css';
+ *
+ * const [issues, setIssues] = useState([]);
+ * <RuleEditor rule={ruleJson} onChange={setDraft} onValidate={setIssues} />
+ * <button disabled={issues.length > 0} onClick={save}>Save</button>
+ * ```
+ *
+ * Passing a new `rule` reference reseeds the editor, so it works as a
+ * controlled component too.
+ */
+export function RuleEditor({
+  rule,
+  onChange,
+  onValidate,
+  metadata,
+  hideHeader = false,
+  hideToolbar = false,
+  defaultExpanded = true,
+  fileName,
+  className,
+}: RuleEditorProps) {
+  const normalized = useMemo(() => normalizeRule(rule), [rule]);
+  const [roots, setRoots] = useState<RuleNode[]>(normalized.roots);
+
+  // Reseed when the caller supplies a different rule. Keyed on the incoming
+  // reference rather than deep equality, so in-place edits are not clobbered by
+  // the parent re-rendering with the same object.
+  const seededFrom = useRef(rule);
+  useEffect(() => {
+    if (seededFrom.current !== rule) {
+      seededFrom.current = rule;
+      setRoots(normalized.roots);
+    }
+  }, [rule, normalized.roots]);
+
+  const derived = useMemo(() => metadata ?? deriveMetadata(roots), [metadata, roots]);
+  const issues = useMemo(() => validateTree(roots, derived), [roots, derived]);
+
+  // Report validity as it changes. Depending on the array identity would fire on
+  // every keystroke, so compare the rendered issue list instead.
+  const issueKey = issues.map((i) => `${i.rule_id}:${i.message}`).join('|');
+  const onValidateRef = useRef(onValidate);
+  onValidateRef.current = onValidate;
+  useEffect(() => {
+    onValidateRef.current?.(issues);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [issueKey]);
+
+  const handleChange = useCallback(
+    (updatedRoots: RuleNode[]) => {
+      setRoots(updatedRoots);
+      onChange?.(denormalizeRule(normalized, updatedRoots));
+    },
+    [normalized, onChange],
+  );
+
+  return (
+    <div className={className}>
+      <RuleTreeViewer
+        mode="edit"
+        rule={roots}
+        originalRule={normalized.roots}
+        ruleSet={hideHeader ? undefined : normalized.ruleSet}
+        metadata={derived}
+        onChange={handleChange}
+        defaultExpanded={defaultExpanded}
+        hideToolbar={hideToolbar}
+        fileName={fileName}
+      />
+    </div>
+  );
+}
