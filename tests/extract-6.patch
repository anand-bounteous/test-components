+import React from 'react';
+import { NavLink, Route, Routes } from 'react-router-dom';
+import Dashboard from './pages/Dashboard';
+import SettingsRuleView from './pages/SettingsRuleView';
+import SettingsRuleEdit from './pages/SettingsRuleEdit';
+import ExecutionsList from './pages/ExecutionsList';
+import ExecutionDetail from './pages/ExecutionDetail';
+
+const navClass = ({ isActive }: { isActive: boolean }) =>
+  `block px-3 py-2 rounded ${isActive ? 'bg-blue-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`;
+
+export default function App() {
+  return (
+    <div className="flex min-h-screen">
+      <aside className="w-56 border-r border-gray-200 p-4 space-y-1">
+        <div className="font-bold mb-4">Rule Engine UI</div>
+        <NavLink to="/" end className={navClass}>
+          Dashboard
+        </NavLink>
+        <NavLink to="/executions" className={navClass}>
+          Executions
+        </NavLink>
+      </aside>
+      <main className="flex-1 p-6">
+        <Routes>
+          <Route path="/" element={<Dashboard />} />
+          <Route path="/settings/rules/:ruleKey/:version" element={<SettingsRuleView />} />
+          <Route path="/settings/rules/:ruleKey/:version/edit" element={<SettingsRuleEdit />} />
+          <Route path="/executions" element={<ExecutionsList />} />
+          <Route path="/executions/:executionId" element={<ExecutionDetail />} />
+        </Routes>
+      </main>
+    </div>
+  );
+}
