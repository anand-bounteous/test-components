@@ -0,0 +1,134 @@
+import { useCallback, useState } from 'react';
+import type { RuleMetadata, RuleNode, RuleSet } from './types';
+import { RuleNodeView, makeEmptyLeaf, randomRuleId } from './nodes/RuleNodeView';
+import { toRootArray, validateTree } from './editing/validation';
+import type { ViewerMode } from './nodes/RuleStatement';
+import { ViewToolbar, type DisplayFormat } from './toolbar/ViewToolbar';
+import { RuleSetHeader } from './nodes/RuleSetHeader';
+
+export interface RuleTreeViewerProps {
+  mode: ViewerMode;
+  /** The rule set's root nodes. A single node is accepted and treated as a one-root set. */
+  rule: RuleNode | RuleNode[];
+  metadata?: RuleMetadata;
+  /** Emits the full root array, matching the format's `rules` field. */
+  onChange?: (updatedRules: RuleNode[]) => void;
+  originalRule?: RuleNode | RuleNode[];
+  /** Envelope fields (rule_set_id, exception_code, version, evaluation_mode) rendered as a header. */
+  ruleSet?: Omit<RuleSet, 'rules'>;
+  defaultExpanded?: boolean;
+  /** File name used by the Download action; defaults to "<rule_set_id>.json". */
+  fileName?: string;
+  /** Hides the tree/JSON toggle + Copy/Download toolbar. Default false. */
+  hideToolbar?: boolean;
+}
+
+export function RuleTreeViewer({
+  mode,
+  rule,
+  metadata,
+  onChange,
+  originalRule,
+  ruleSet,
+  defaultExpanded = true,
+  fileName,
+  hideToolbar = false,
+}: RuleTreeViewerProps) {
+  const [format, setFormat] = useState<DisplayFormat>('tree');
+  const roots = toRootArray(rule);
+
+  // Rule ids must be unique across the whole set, so generation happens here —
+  // the only place that can see every existing id — and retries on collision.
+  const generateRuleId = useCallback(() => {
+    const used = new Set<string>();
+    const collect = (nodes: RuleNode[]) =>
+      nodes.forEach((n) => {
+        used.add(n.rule_id);
+        if (n.rules) collect(n.rules);
+      });
+    collect(roots);
+    for (let attempt = 0; attempt < 200; attempt++) {
+      const candidate = randomRuleId();
+      if (!used.has(candidate)) return candidate;
+    }
+    // Exhausted the 4-digit space for this set; fall back to a wider id rather
+    // than returning a duplicate, which would break React keys and diffing.
+    return `R${Date.now().toString().slice(-6)}`;
+  }, [roots]);
+  const originalRoots = toRootArray(originalRule);
+  const issues = mode === 'edit' ? validateTree(roots, metadata) : [];
+  // One entry per rule, in tree order — a node can raise several issues.
+  const incompleteIds = [...new Set(issues.map((i) => i.rule_id))];
+
+  // Raw JSON and Copy/Download show the whole rule set when its envelope is
+  // known, so what you copy is a valid document rather than a bare fragment.
+  const payload = ruleSet ? { ...ruleSet, rules: roots } : roots;
+  const defaultFileName = `${ruleSet?.rule_set_id ?? roots[0]?.rule_id ?? 'rule'}.json`;
+
+  return (
+    <div className="rt-root">
+      {!hideToolbar && (
+        <ViewToolbar
+          format={format}
+          onFormatChange={setFormat}
+          data={payload}
+          fileName={fileName ?? defaultFileName}
+        />
+      )}
+
+      {format === 'json' ? (
+        <pre className="rt-json-view">
+          <code>{JSON.stringify(payload, null, 2)}</code>
+        </pre>
+      ) : (
+        <>
+          {ruleSet && <RuleSetHeader ruleSet={ruleSet} />}
+          {mode === 'edit' && issues.length > 0 && (
+            <div className="rt-banner">
+              {incompleteIds.length} rule(s) incomplete — resolve before saving:{' '}
+              {incompleteIds.map((id, i) => (
+                <span key={id}>
+                  {i > 0 && ', '}
+                  <a
+                    className="rt-banner-link"
+                    href={`#rt-node-${id}`}
+                    onClick={(e) => {
+                      e.preventDefault();
+                      document
+                        .getElementById(`rt-node-${id}`)
+                        ?.scrollIntoView({ block: 'center', behavior: 'smooth' });
+                    }}
+                  >
+                    {id}
+                  </a>
+                </span>
+              ))}
+            </div>
+          )}
+          {roots.map((root, index) => (
+            <RuleNodeView
+              key={root.rule_id}
+              node={root}
+              originalNode={originalRoots[index]}
+              mode={mode}
+              metadata={metadata}
+              defaultExpanded={defaultExpanded}
+              generateRuleId={generateRuleId}
+              onNodeChange={(updated) => {
+                const next = [...roots];
+                next[index] = updated;
+                onChange?.(next);
+              }}
+              onDeleteSelf={() => onChange?.(roots.filter((_, i) => i !== index))}
+              onAddSiblingAfterSelf={() => {
+                const next = [...roots];
+                next.splice(index + 1, 0, makeEmptyLeaf(generateRuleId));
+                onChange?.(next);
+              }}
+            />
+          ))}
+        </>
+      )}
+    </div>
+  );
+}
