+import { useMemo } from 'react';
+import type { RuleMetadata } from './types';
+import { RuleTreeViewer } from './RuleTreeViewer';
+import { deriveMetadata, normalizeRule, type RuleInput } from './api/normalize';
+
+export interface RuleViewerProps {
+  /** The rule JSON: a rule set envelope, an array of root nodes, or a single node. */
+  rule: RuleInput;
+  /**
+   * `view` for an authored rule set, `runtime` for an execution tree — which
+   * additionally renders input values, pass/fail marks and skipped branches.
+   * Defaults to `runtime` when the data carries execution results.
+   */
+  mode?: 'view' | 'runtime';
+  /** Optional. Derived from the rule JSON when omitted. */
+  metadata?: RuleMetadata;
+  /** Hides the envelope header even when the input carries one. */
+  hideHeader?: boolean;
+  /** Hides the tree/JSON toggle and the Copy/Download buttons. */
+  hideToolbar?: boolean;
+  defaultExpanded?: boolean;
+  /** File name for the Download action; defaults to "<rule_set_id>.json". */
+  fileName?: string;
+  className?: string;
+}
+
+/**
+ * Read-only rule tree. Drop it in with nothing but the rule JSON:
+ *
+ * ```tsx
+ * import { RuleViewer } from 'rule-tree-viewer';
+ * import 'rule-tree-viewer/theme.css';
+ *
+ * <RuleViewer rule={ruleJson} />
+ * ```
+ */
+export function RuleViewer({
+  rule,
+  mode,
+  metadata,
+  hideHeader = false,
+  hideToolbar = false,
+  defaultExpanded = true,
+  fileName,
+  className,
+}: RuleViewerProps) {
+  const normalized = useMemo(() => normalizeRule(rule), [rule]);
+  const derived = useMemo(
+    () => metadata ?? deriveMetadata(normalized.roots),
+    [metadata, normalized.roots],
+  );
+
+  // Execution trees carry `result` / `execution_status`; spotting them means a
+  // caller can pass an execution tree without also remembering to set the mode.
+  const resolvedMode = useMemo(() => {
+    if (mode) return mode;
+    const hasRuntimeData = normalized.roots.some(
+      (node) => node.result !== undefined || node.execution_status !== undefined,
+    );
+    return hasRuntimeData ? 'runtime' : 'view';
+  }, [mode, normalized.roots]);
+
+  return (
+    <div className={className}>
+      <RuleTreeViewer
+        mode={resolvedMode}
+        rule={normalized.roots}
+        ruleSet={hideHeader ? undefined : normalized.ruleSet}
+        metadata={derived}
+        defaultExpanded={defaultExpanded}
+        hideToolbar={hideToolbar}
+        fileName={fileName}
+      />
+    </div>
+  );
+}
