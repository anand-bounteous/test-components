+import { useState } from 'react';
+import type { FieldType, RuleMetadata, SourceType } from '../types';
+
+interface BaseProps {
+  value: string;
+  onCommit: (value: string) => void;
+  changed?: boolean;
+  /** Marks this token as one validation is waiting on, so the gap is findable. */
+  missing?: boolean;
+  /** Shown in place of the value when it is empty. Defaults to an em dash. */
+  placeholder?: string;
+}
+
+interface DropdownProps extends BaseProps {
+  kind: 'dropdown';
+  options: string[];
+}
+
+interface FreeInputProps extends BaseProps {
+  kind: 'text' | 'number' | 'date' | 'datetime';
+}
+
+interface TextareaProps extends BaseProps {
+  kind: 'textarea';
+  rows?: number;
+}
+
+type InlineTokenEditorProps = DropdownProps | FreeInputProps | TextareaProps;
+
+/**
+ * A single click-to-edit token rendered inline within the rule sentence.
+ * Displays as plain text; on click swaps to the appropriate control, then
+ * reverts to text on blur/select — never a stacked label+input form row.
+ */
+export function InlineTokenEditor(props: InlineTokenEditorProps) {
+  const [editing, setEditing] = useState(false);
+  const className = `rt-token rt-token--editable${props.changed ? ' rt-token--changed' : ''}${
+    props.kind === 'textarea' ? ' rt-token--multiline' : ''
+  }${props.missing ? ' rt-token--missing' : ''}`;
+
+  if (!editing) {
+    return (
+      <span
+        className={className}
+        title={props.missing ? 'Required — click to fill in' : undefined}
+        onClick={(e) => {
+          e.stopPropagation();
+          setEditing(true);
+        }}
+      >
+        {props.value || props.placeholder || '—'}
+      </span>
+    );
+  }
+
+  if (props.kind === 'dropdown') {
+    // A value that is not in the option list would otherwise be silently
+    // replaced by the first option on blur, so it is always offered.
+    const options = props.options.includes(props.value)
+      ? props.options
+      : [props.value, ...props.options].filter((o, i) => o !== '' || i === 0);
+    return (
+      <select
+        autoFocus
+        defaultValue={props.value}
+        onClick={(e) => e.stopPropagation()}
+        onBlur={(e) => {
+          props.onCommit(e.target.value);
+          setEditing(false);
+        }}
+        onChange={(e) => {
+          props.onCommit(e.target.value);
+          setEditing(false);
+        }}
+        onKeyDown={(e) => {
+          // Escape abandons the edit, matching the textarea and text inputs.
+          if (e.key === 'Escape') {
+            e.stopPropagation();
+            setEditing(false);
+          }
+        }}
+      >
+        {options.map((opt) => (
+          <option key={opt} value={opt}>
+            {opt || '—'}
+          </option>
+        ))}
+      </select>
+    );
+  }
+
+  if (props.kind === 'textarea') {
+    return (
+      <textarea
+        autoFocus
+        className="rt-textarea"
+        rows={props.rows ?? 2}
+        defaultValue={props.value}
+        placeholder={props.placeholder}
+        onClick={(e) => e.stopPropagation()}
+        onBlur={(e) => {
+          props.onCommit(e.target.value);
+          setEditing(false);
+        }}
+        onKeyDown={(e) => {
+          // Enter commits; Shift+Enter inserts a newline. Escape abandons.
+          if (e.key === 'Enter' && !e.shiftKey) {
+            e.preventDefault();
+            props.onCommit((e.target as HTMLTextAreaElement).value);
+            setEditing(false);
+          }
+          if (e.key === 'Escape') setEditing(false);
+        }}
+      />
+    );
+  }
+
+  const inputType = props.kind === 'datetime' ? 'datetime-local' : props.kind;
+  return (
+    <input
+      autoFocus
+      type={inputType}
+      defaultValue={props.value}
+      placeholder={props.placeholder}
+      onClick={(e) => e.stopPropagation()}
+      onBlur={(e) => {
+        props.onCommit(e.target.value);
+        setEditing(false);
+      }}
+      onKeyDown={(e) => {
+        if (e.key === 'Enter') {
+          props.onCommit((e.target as HTMLInputElement).value);
+          setEditing(false);
+        }
+        if (e.key === 'Escape') setEditing(false);
+      }}
+      size={Math.max(3, props.value.length)}
+    />
+  );
+}
+
+/** Operands carry no `type` in the current schema; treat an absent type as free text. */
+export function editorKindForType(type?: FieldType): 'text' | 'number' | 'date' | 'datetime' {
+  switch (type) {
+    case 'number':
+    case 'currency':
+      return 'number';
+    case 'date':
+      return 'date';
+    case 'datetime':
+      return 'datetime';
+    default:
+      return 'text';
+  }
+}
+
+export function sourceOptions(metadata?: RuleMetadata): SourceType[] {
+  return metadata?.source_type ?? ['DOCUMENT', 'APPLICATION', 'STATIC'];
+}
+
+export function documentTypeOptions(metadata?: RuleMetadata): string[] {
+  return metadata?.document_type ?? [];
+}
+
+/**
+ * Field names available on a document.
+ *
+ * With no document chosen yet, offers every known field rather than nothing —
+ * an empty list makes the caller fall back to free text, which is a worse
+ * experience than picking from a superset and letting the document narrow it
+ * later. Only a document type absent from the catalogue yields an empty list.
+ */
+export function documentFieldOptions(metadata: RuleMetadata | undefined, documentType?: string) {
+  const catalogue = metadata?.document_fields;
+  if (!catalogue) return [];
+  if (documentType) return catalogue[documentType] ?? [];
+  return [...new Set(Object.values(catalogue).flat())].sort();
+}
+
+/**
+ * Operators offered for an operand. Without a `type` hint we cannot narrow by
+ * data type, so fall back to the metadata's `any` list — the full vocabulary.
+ */
+export function operatorOptions(metadata: RuleMetadata | undefined, type?: FieldType): string[] {
+  const supported = metadata?.supported_operators;
+  if (!supported) return [];
+  return (type ? supported[type] : undefined) ?? supported.any ?? [];
+}
