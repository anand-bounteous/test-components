+import { Router } from 'express';
+import * as store from '../store.js';
+
+export const executionsRouter = Router();
+
+executionsRouter.get('/executions', (req, res) => {
+  let list = store.executions as any[];
+  const { ruleKey, result } = req.query;
+  if (ruleKey) list = list.filter((e) => e.rule_key === ruleKey);
+  if (result !== undefined) list = list.filter((e) => String(e.result) === result);
+  res.json(list);
+});
+
+executionsRouter.get('/executions/:executionId', (req, res) => {
+  const found = store.getExecution(req.params.executionId);
+  if (!found) return res.status(404).json({ error: 'Not found' });
+  res.json(found);
+});
