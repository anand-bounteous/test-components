+import type { RuleMetadata, RuleNode } from '../types';
+
+export interface ValidationIssue {
+  rule_id: string;
+  message: string;
+}
+
+/** Operators that take no `right_operand`, used when metadata is unavailable. */
+export const DEFAULT_UNARY_OPERATORS = ['is_present', 'not_present', 'is_blank', 'is_not_blank'];
+
+export function isUnaryOperator(operator: string | undefined, metadata?: RuleMetadata): boolean {
+  if (!operator) return false;
+  return (metadata?.unary_operators ?? DEFAULT_UNARY_OPERATORS).includes(operator);
+}
+
+/**
+ * A node is a "group" if it either already has an operator (AND/OR) or has been
+ * converted-but-not-yet-configured (logical_operator: null with a `rules` array present).
+ * A leaf rule has neither `logical_operator` nor a `rules` field at all.
+ */
+export function isGroupNode(node: RuleNode): boolean {
+  return Boolean(node.logical_operator) || node.rules !== undefined;
+}
+
+/**
+ * True when the node carries a check of its own — a group without one is a pure
+ * grouping node that only combines its children.
+ */
+export function hasOwnCondition(node: RuleNode): boolean {
+  return Boolean(node.operator) || node.left_operand !== undefined;
+}
+
+/** Normalises the viewer's `rule` prop: the format's root is an array of nodes. */
+export function toRootArray(rule: RuleNode | RuleNode[] | undefined): RuleNode[] {
+  if (!rule) return [];
+  return Array.isArray(rule) ? rule : [rule];
+}
+
+/** Collects the issues on one node only, without descending into its children. */
+function collectNodeIssues(
+  node: RuleNode,
+  metadata: RuleMetadata | undefined,
+  issues: ValidationIssue[],
+): void {
+  const group = isGroupNode(node);
+
+  // A condition group may legitimately have no children — an empty `rules` array
+  // is a valid shape, so it is not reported. AND/OR is only required once there
+  // is something for it to combine; with no children it decides nothing.
+  if (group && (node.rules?.length ?? 0) > 0 && !node.logical_operator) {
+    issues.push({ rule_id: node.rule_id, message: 'Select AND/OR for this condition group.' });
+  }
+
+  // A leaf exists only to perform a check, so it must have one. A group may
+  // legitimately have no gate condition of its own.
+  if (!group && !hasOwnCondition(node)) {
+    issues.push({ rule_id: node.rule_id, message: 'Choose a field and operator for this rule.' });
+  }
+
+  if (hasOwnCondition(node)) {
+    if (!node.operator) {
+      issues.push({ rule_id: node.rule_id, message: 'Select an operator for this check.' });
+    }
+    if (!node.left_operand?.field && !node.left_operand?.document_type) {
+      issues.push({ rule_id: node.rule_id, message: 'Select a field for the left operand.' });
+    }
+    if (!isUnaryOperator(node.operator, metadata)) {
+      const right = node.right_operand;
+      if (!right) {
+        issues.push({
+          rule_id: node.rule_id,
+          message: `Operator "${node.operator}" needs a value to compare against.`,
+        });
+      } else if (right.source === 'STATIC' && (right.value === undefined || right.value === '')) {
+        issues.push({ rule_id: node.rule_id, message: 'Enter a value to compare against.' });
+      }
+    }
+  }
+}
+
+function validateNode(
+  node: RuleNode,
+  metadata: RuleMetadata | undefined,
+  issues: ValidationIssue[],
+): void {
+  collectNodeIssues(node, metadata, issues);
+  node.rules?.forEach((child) => validateNode(child, metadata, issues));
+}
+
+/** Walks the tree (or forest) and collects every node that is incomplete. */
+export function validateTree(
+  rule: RuleNode | RuleNode[],
+  metadata?: RuleMetadata,
+  issues: ValidationIssue[] = [],
+): ValidationIssue[] {
+  toRootArray(rule).forEach((node) => validateNode(node, metadata, issues));
+  return issues;
+}
+
+/** The issues on this node alone — what to show beside the row that owns them. */
+export function getNodeIssues(node: RuleNode, metadata?: RuleMetadata): ValidationIssue[] {
+  const issues: ValidationIssue[] = [];
+  collectNodeIssues(node, metadata, issues);
+  return issues;
+}
+
+export function isNodeInvalid(node: RuleNode, metadata?: RuleMetadata): boolean {
+  return getNodeIssues(node, metadata).length > 0;
+}
+
+/**
+ * Which of a node's own fields validation is waiting on. Mirrors the checks in
+ * `collectNodeIssues` so the editor can mark the exact token that is missing,
+ * rather than only colouring the whole row.
+ */
+export function missingFields(node: RuleNode, metadata?: RuleMetadata) {
+  const needsCondition = hasOwnCondition(node) || !isGroupNode(node);
+  if (!needsCondition) return { left: false, operator: false, right: false };
+
+  const unary = isUnaryOperator(node.operator, metadata);
+  const right = node.right_operand;
+  return {
+    left: !node.left_operand?.field && !node.left_operand?.document_type,
+    operator: !node.operator,
+    right:
+      !unary &&
+      (!right || (right.source === 'STATIC' && (right.value === undefined || right.value === ''))),
+  };
+}
