+import type { RuleNode } from '../types';
+import { toRootArray } from '../editing/validation';
+
+export type DiffKind = 'added' | 'removed' | 'changed' | 'unchanged';
+
+export interface DiffEntry {
+  rule_id: string;
+  kind: DiffKind;
+  path: string[];
+}
+
+function fieldsEqual(a: RuleNode, b: RuleNode): boolean {
+  return (
+    a.description === b.description &&
+    a.operator === b.operator &&
+    a.logical_operator === b.logical_operator &&
+    a.severity === b.severity &&
+    a.failure_reason === b.failure_reason &&
+    JSON.stringify(a.left_operand) === JSON.stringify(b.left_operand) &&
+    JSON.stringify(a.right_operand) === JSON.stringify(b.right_operand)
+  );
+}
+
+/**
+ * Structural, field-level diff between two rule sets, matched by rule_id.
+ * Returns a flat list of every node's diff kind — used to decide highlighting
+ * and, in "changed only" scope mode, which nodes to keep visible.
+ */
+export function computeDiff(
+  current: RuleNode | RuleNode[] | undefined,
+  original: RuleNode | RuleNode[] | undefined,
+  path: string[] = [],
+  out: DiffEntry[] = [],
+): DiffEntry[] {
+  if (Array.isArray(current) || Array.isArray(original)) {
+    const currentRoots = toRootArray(current);
+    const originalRoots = toRootArray(original);
+    const rootCount = Math.max(currentRoots.length, originalRoots.length);
+    for (let i = 0; i < rootCount; i++) {
+      diffNode(currentRoots[i], originalRoots[i], path, out);
+    }
+    return out;
+  }
+  return diffNode(current, original, path, out);
+}
+
+function diffNode(
+  current: RuleNode | undefined,
+  original: RuleNode | undefined,
+  path: string[],
+  out: DiffEntry[],
+): DiffEntry[] {
+  if (current && !original) {
+    out.push({ rule_id: current.rule_id, kind: 'added', path });
+    current.rules?.forEach((c) => diffNode(c, undefined, [...path, current.rule_id], out));
+    return out;
+  }
+  if (!current && original) {
+    out.push({ rule_id: original.rule_id, kind: 'removed', path });
+    original.rules?.forEach((c) => diffNode(undefined, c, [...path, original.rule_id], out));
+    return out;
+  }
+  if (!current || !original) return out;
+
+  out.push({
+    rule_id: current.rule_id,
+    kind: fieldsEqual(current, original) ? 'unchanged' : 'changed',
+    path,
+  });
+
+  const currentChildren = current.rules ?? [];
+  const originalChildren = original.rules ?? [];
+  const maxLen = Math.max(currentChildren.length, originalChildren.length);
+  for (let i = 0; i < maxLen; i++) {
+    diffNode(currentChildren[i], originalChildren[i], [...path, current.rule_id], out);
+  }
+  return out;
+}
