+import { useState } from 'react';
+import { copyJson, downloadJson } from './downloadJson';
+
+export type DisplayFormat = 'tree' | 'json';
+
+interface ViewToolbarProps {
+  format: DisplayFormat;
+  onFormatChange: (format: DisplayFormat) => void;
+  /** Whatever Copy/Download should emit — the full rule set when its envelope is known. */
+  data: unknown;
+  fileName: string;
+}
+
+export function ViewToolbar({ format, onFormatChange, data, fileName }: ViewToolbarProps) {
+  const [copied, setCopied] = useState(false);
+
+  return (
+    <div className="rt-toggle-row" style={{ justifyContent: 'space-between' }}>
+      <span>
+        <label>
+          <input
+            type="radio"
+            checked={format === 'tree'}
+            onChange={() => onFormatChange('tree')}
+          />{' '}
+          Tree view
+        </label>
+        <label style={{ marginLeft: 12 }}>
+          <input
+            type="radio"
+            checked={format === 'json'}
+            onChange={() => onFormatChange('json')}
+          />{' '}
+          Raw JSON
+        </label>
+      </span>
+      <span>
+        <button
+          type="button"
+          className="rt-toolbar-action"
+          onClick={async () => {
+            const ok = await copyJson(data);
+            setCopied(ok);
+            setTimeout(() => setCopied(false), 1500);
+          }}
+        >
+          {copied ? 'Copied ✓' : 'Copy'}
+        </button>
+        <button
+          type="button"
+          className="rt-toolbar-action"
+          style={{ marginLeft: 6 }}
+          onClick={() => downloadJson(data, fileName)}
+        >
+          Download
+        </button>
+      </span>
+    </div>
+  );
+}
