+++ rule-engine-ui/apps/web/src/pages/SettingsRuleView.tsx	2026-08-12 13:00:08
@@ -0,0 +1,61 @@
+import React, { useEffect, useState } from 'react';
+import { Link, useParams } from 'react-router-dom';
+import { RuleViewer } from 'rule-tree-viewer';
+import { api } from '../api/client';
+
+export default function SettingsRuleView() {
+  const { ruleKey = '', version = '' } = useParams();
+  const [tree, setTree] = useState<any>(null);
+  const [metadata, setMetadata] = useState<any>(null);
+  const [config, setConfig] = useState<any>(null);
+
+  useEffect(() => {
+    api.getRuleTree(ruleKey, Number(version)).then(setTree);
+    api.getMetadata().then(setMetadata);
+    api.listConfigurationsForKey(ruleKey).then((d) => {
+      const found = d.rule_configuration.configs.find((c: any) => c.version === Number(version));
+      setConfig(found);
+    });
+  }, [ruleKey, version]);
+
+  async function handleActivate() {
+    if (!config) return;
+    const activeFrom = window.prompt('Active from (ISO datetime)', new Date().toISOString());
+    if (!activeFrom) return;
+    await api.activate(config.rule_config_id, activeFrom);
+    window.location.reload();
+  }
+
+  async function handleDecommission() {
+    if (!window.confirm(`Decommission ${ruleKey}? No version will remain active.`)) return;
+    await api.decommission(ruleKey);
+    window.location.reload();
+  }
+
+  if (!tree) return <div>Loading…</div>;
+
+  return (
+    <div className="space-y-4">
+      <div className="flex items-center gap-3">
+        <h1 className="text-xl font-bold">
+          {ruleKey} — v{version} ({config?.status})
+        </h1>
+        <Link to={`/settings/rules/${ruleKey}/${version}/edit`} className="text-blue-600 underline text-sm">
+          Edit
+        </Link>
+        {config?.status !== 'active' && (
+          <button onClick={handleActivate} className="text-sm px-2 py-1 border rounded bg-green-50">
+            Activate
+          </button>
+        )}
+        {config?.status === 'active' && (
+          <button onClick={handleDecommission} className="text-sm px-2 py-1 border rounded bg-red-50">
+            Decommission
+          </button>
+        )}
+      </div>
+      {/* The whole rule set envelope goes straight in; metadata is optional. */}
+      <RuleViewer rule={tree} metadata={metadata} />
+    </div>
+  );
+}
