+++ rule-engine-ui/apps/web/src/pages/SettingsRuleEdit.tsx	2026-08-12 13:00:08
@@ -0,0 +1,53 @@
+import React, { useEffect, useState } from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+import { RuleEditor, type RuleInput, type ValidationIssue } from 'rule-tree-viewer';
+import { api } from '../api/client';
+
+export default function SettingsRuleEdit() {
+  const { ruleKey = '', version = '' } = useParams();
+  const navigate = useNavigate();
+  const [loaded, setLoaded] = useState<RuleInput | null>(null);
+  const [draft, setDraft] = useState<RuleInput | null>(null);
+  const [issues, setIssues] = useState<ValidationIssue[]>([]);
+  const [metadata, setMetadata] = useState<any>(null);
+
+  useEffect(() => {
+    api.getRuleTree(ruleKey, Number(version)).then((ruleSet) => {
+      setLoaded(ruleSet);
+      setDraft(ruleSet);
+    });
+    api.getMetadata().then(setMetadata);
+  }, [ruleKey, version]);
+
+  async function handleSave() {
+    if (!draft) return;
+    if (issues.length > 0) {
+      alert(`Resolve ${issues.length} incomplete rule(s) before saving.`);
+      return;
+    }
+    // `draft` comes back in the same shape it went in — the full envelope.
+    const saved = await api.saveDraft(ruleKey, Number(version), draft);
+    alert(`Saved as draft v${saved.version}`);
+    navigate(`/settings/rules/${ruleKey}/${saved.version}`);
+  }
+
+  if (!loaded) return <div>Loading…</div>;
+
+  return (
+    <div className="space-y-4">
+      <div className="flex items-center gap-3">
+        <h1 className="text-xl font-bold">
+          Editing {ruleKey} — based on v{version}
+        </h1>
+        <button
+          onClick={handleSave}
+          disabled={issues.length > 0}
+          className="text-sm px-3 py-1 border rounded bg-blue-600 text-white disabled:opacity-50"
+        >
+          Save as draft
+        </button>
+      </div>
+      <RuleEditor rule={loaded} metadata={metadata} onChange={setDraft} onValidate={setIssues} />
+    </div>
+  );
+}
