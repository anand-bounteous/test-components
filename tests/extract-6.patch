+import { Router } from 'express';
+import * as store from '../store.js';
+
+export const configurationsRouter = Router();
+
+configurationsRouter.get('/rule-configurations', (_req, res) => {
+  res.json({ rule_configuration: { configs: store.listConfigurations() } });
+});
+
+configurationsRouter.get('/rule-configurations/:ruleKey', (req, res) => {
+  res.json({ rule_configuration: { configs: store.listConfigurationsForKey(req.params.ruleKey) } });
+});
+
+configurationsRouter.post('/rule-configurations/:id/activate', (req, res) => {
+  try {
+    const activeFrom = req.body.active_from ?? new Date().toISOString();
+    const updated = store.activateConfig(Number(req.params.id), activeFrom);
+    res.json(updated);
+  } catch (e: any) {
+    res.status(400).json({ error: e.message });
+  }
+});
+
+configurationsRouter.post('/rule-configurations/:ruleKey/decommission', (req, res) => {
+  try {
+    const updated = store.decommission(req.params.ruleKey);
+    res.json(updated);
+  } catch (e: any) {
+    res.status(400).json({ error: e.message });
+  }
+});
