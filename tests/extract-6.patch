+import React, { useEffect, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { api } from '../api/client';
+
+export default function ExecutionsList() {
+  const [executions, setExecutions] = useState<any[]>([]);
+  const [ruleKeyFilter, setRuleKeyFilter] = useState('');
+
+  useEffect(() => {
+    api.listExecutions(ruleKeyFilter ? { ruleKey: ruleKeyFilter } : undefined).then(setExecutions);
+  }, [ruleKeyFilter]);
+
+  const ruleKeys = Array.from(new Set(executions.map((e) => e.rule_key)));
+
+  return (
+    <div className="space-y-4">
+      <h1 className="text-xl font-bold">Executions</h1>
+      <select
+        className="border rounded px-2 py-1 text-sm"
+        value={ruleKeyFilter}
+        onChange={(e) => setRuleKeyFilter(e.target.value)}
+      >
+        <option value="">All rule keys</option>
+        {ruleKeys.map((k) => (
+          <option key={k} value={k}>
+            {k}
+          </option>
+        ))}
+      </select>
+      <table className="w-full border-collapse text-sm">
+        <thead>
