+import React, { useEffect, useState } from 'react';
+import { useParams } from 'react-router-dom';
+import { RuleViewer } from 'rule-tree-viewer';
+import { api } from '../api/client';
+
+export default function ExecutionDetail() {
+  const { executionId = '' } = useParams();
+  const [data, setData] = useState<any>(null);
+  const [metadata, setMetadata] = useState<any>(null);
+
+  useEffect(() => {
+    api.getExecution(executionId).then(setData);
+    api.getMetadata().then(setMetadata);
+  }, [executionId]);
+
+  if (!data) return <div>Loading…</div>;
+
+  const { record, tree } = data;
+
+  return (
+    <div className="space-y-4">
+      <h1 className="text-xl font-bold">
+        {record.rule_key} — v{record.version} — {executionId}
+      </h1>
+      <div className="text-sm text-gray-600">
+        Executed at {record.executed_at} by {record.triggered_by} — Result:{' '}
+        {record.result ? <span className="text-green-700">✔ true</span> : <span className="text-red-700">✘ false</span>}
+      </div>
+      <pre className="bg-gray-50 border rounded p-2 text-xs">
+        {JSON.stringify(record.context_summary, null, 2)}
+      </pre>
+      {/* An execution tree carries results, so RuleViewer renders it in runtime mode. */}
+      <RuleViewer rule={tree} metadata={metadata} />
+    </div>
+  );
+}
