+++ rule-engine-ui/mock-server/src/routes/rules.ts	2026-08-12 12:23:34
@@ -0,0 +1,25 @@
+import { Router } from 'express';
+import * as store from '../store.js';
+
+export const rulesRouter = Router();
+
+rulesRouter.get('/rules/:ruleKey/:version', (req, res) => {
+  const tree = store.getRuleTree(req.params.ruleKey, Number(req.params.version));
+  if (!tree) return res.status(404).json({ error: 'Not found' });
+  res.json(tree);
+});
+
+rulesRouter.put('/rules/:ruleKey', (req, res) => {
+  const { based_on_version, rule_set } = req.body;
+  if (!rule_set || !Array.isArray(rule_set.rules)) {
+    return res.status(400).json({ error: 'rule_set.rules must be an array of root nodes' });
+  }
+  try {
+    // Writes the draft to disk, so a failure here means nothing was saved —
+    // report it rather than returning a config the client would trust.
+    const config = store.saveDraft(req.params.ruleKey, based_on_version, rule_set);
+    res.json(config);
+  } catch (e: any) {
+    res.status(500).json({ error: `Could not save draft: ${e.message}` });
+  }
+});
