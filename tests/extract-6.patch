@@ -0,0 +1,115 @@
+export type SourceType = 'DOCUMENT' | 'APPLICATION' | 'STATIC';
+export type FieldType = 'string' | 'number' | 'date' | 'datetime' | 'currency';
+export type LogicalOperator = 'AND' | 'OR';
+export type ExecutionStatus = 'executed' | 'skipped';
+export type Severity = 'CRITICAL' | 'HIGH' | 'MEDIUM' | 'LOW';
+
+/**
+ * Severity is carried in the data but never rendered. New rules authored in the
+ * UI get this value so the field is always populated.
+ */
+export const DEFAULT_SEVERITY: Severity = 'CRITICAL';
+export type EvaluationMode = 'ALL_CRITICAL_MUST_PASS' | 'ALL_MUST_PASS' | 'ANY_MUST_PASS';
+
+export interface OperandMetadata {
+  currency?: string;
+  timezone?: string;
+  format?: string;
+}
+
+export interface Operand {
+  source: SourceType;
+  /** Names the document an operand reads from. Present on its own (no `field`) for a whole-document operand. */
+  document_type?: string;
+  /** Absent for whole-document operands, e.g. the target of `is_present`. */
+  field?: string;
+  /** Required when source === 'STATIC'; meaningless otherwise. */
+  value?: string | number;
+  /**
+   * Optional authoring hint used to pick the inline editor widget and to look up
+   * `metadata.supported_operators`. Absent operands fall back to the `any` operator
+   * list and a plain text input.
+   */
+  type?: FieldType;
+  metadata?: OperandMetadata;
+  /** Present only in runtime (2b) data, when source !== 'STATIC' */
+  input_value?: string | number;
+}
+
+export interface RuleNode {
+  rule_id: string;
+  description: string;
+  /**
+   * The comparator for this node's own check. Absent on a pure grouping node —
+   * one that only combines its children via `logical_operator` and has no gate
+   * condition of its own.
+   */
+  operator?: string;
+  left_operand?: Operand;
+  /** Absent for unary operators (`is_present`, `not_present`, `is_blank`, `is_not_blank`). */
+  right_operand?: Operand;
+  logical_operator?: LogicalOperator | null;
+  rules?: RuleNode[];
+  severity?: Severity;
+  /** Business-facing explanation shown when this node's own check fails. */
+  failure_reason?: string;
+
+  /** runtime-only (2b) fields */
+  condition_result?: boolean;
+  result?: boolean;
+  execution_status?: ExecutionStatus;
+}
+
+/**
+ * The top-level envelope of an authored (2a) or executed (2b) rule set.
+ * `rules` is an array — a rule set may have more than one root node.
+ */
+export interface RuleSet {
+  rule_set_id: string;
+  exception_code?: string;
+  /** Schema/rule-set version string (e.g. "2.0"), distinct from a configuration's numeric version. */
+  version: string;
+  evaluation_mode?: EvaluationMode;
+  rules: RuleNode[];
+  /** runtime-only (2b): the rule set's overall outcome */
+  result?: boolean;
+}
+
+export type ConfigStatus = 'draft' | 'active' | 'inactive' | 'decommissioned';
+
+export interface RuleConfiguration {
+  rule_config_id: number;
+  rule_key: string;
+  version: number;
+  status: ConfigStatus;
+  is_active: boolean;
+  active_from: string | null;
+  active_to: string | null;
+  based_on_version?: number | null;
+}
+
+export interface RuleMetadata {
+  source_type: SourceType[];
+  document_type: string[];
+  /** Operators keyed by operand `type`, plus an `any` list used when `type` is absent. */
+  supported_operators: Record<FieldType | 'any', string[]>;
+  /** Selectable field names per document type, used by the DOCUMENT operand editor. */
+  document_fields?: Record<string, string[]>;
+  /** Operators that take no `right_operand`. */
+  unary_operators: string[];
