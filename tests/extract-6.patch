+import type { Operand, RuleMetadata, RuleNode } from '../types';
+import {
+  InlineTokenEditor,
+  documentFieldOptions,
+  documentTypeOptions,
+  editorKindForType,
+  operatorOptions,
+  sourceOptions,
+} from '../editing/InlineTokenEditor';
+import { hasOwnCondition, isGroupNode, isUnaryOperator, missingFields } from '../editing/validation';
+
+export type ViewerMode = 'view' | 'edit' | 'runtime';
+
+interface RuleStatementProps {
+  node: RuleNode;
+  originalNode?: RuleNode;
+  mode: ViewerMode;
+  metadata?: RuleMetadata;
+  onOperandChange?: (side: 'left_operand' | 'right_operand', patch: Partial<Operand>) => void;
+  onOperatorChange?: (value: string) => void;
+}
+
+function operandValueText(operand: Operand, mode: ViewerMode): string {
+  if (mode === 'runtime' && operand.source !== 'STATIC') {
+    return operand.input_value !== undefined ? String(operand.input_value) : '(from context)';
+  }
+  if (operand.source === 'STATIC') {
+    if (operand.type === 'currency') {
+      const currency = operand.metadata?.currency ?? '';
+      return `${operand.value ?? ''} ${currency}`.trim();
+    }
+    return String(operand.value ?? '');
+  }
+  return '';
+}
+
+function changedField(
+  original: Operand | undefined,
+  operand: Operand,
+  field: keyof Operand,
+): boolean {
+  if (!original) return false;
+  return original[field] !== operand[field];
+}
+
+/** Renders one "RULE — ..." / "CONDITION — ..." sentence line, editable inline when mode === 'edit'. */
+export function RuleStatement({
+  node,
+  originalNode,
+  mode,
+  metadata,
+  onOperandChange,
+  onOperatorChange,
+}: RuleStatementProps) {
+  const left = node.left_operand;
+  const right = node.right_operand;
+  const isEdit = mode === 'edit';
+
+  const isGroup = isGroupNode(node);
+  const isSkipped = node.execution_status === 'skipped';
+  const isRuntime = mode === 'runtime';
+  const hasCondition = hasOwnCondition(node);
+  // Unary operators (is_present, is_blank, …) carry no right_operand at all.
+  const isUnary = isUnaryOperator(node.operator, metadata);
+  // This node's own left/right/operator comparison failed — highlights the
+  // mismatched values so a business user can see at a glance why.
+  const ownCheckFailed =
+    isRuntime && !isSkipped && (isGroup ? node.condition_result === false : node.result === false);
+  // Exactly the fields validation is waiting on, so the missing one is marked
+  // rather than leaving the author to hunt along the row.
+  const missing = isEdit ? missingFields(node, metadata) : { left: false, operator: false, right: false };
+
+  const renderOperand = (
+    side: 'left_operand' | 'right_operand',
+    operand: Operand,
+    original?: Operand,
+  ) => {
+    if (!isEdit) {
+      const sourceText =
+        operand.source === 'STATIC'
+          ? ''
+          : `${operand.source}${operand.document_type ? ` [${operand.document_type}]` : ''} `;
+      const fieldChanged =
+        changedField(original, operand, 'field') || changedField(original, operand, 'source');
+      const valueChanged = changedField(original, operand, 'value');
+      const mismatchClass = ownCheckFailed ? ' rt-value--mismatch' : '';
+      return (
+        <>
+          <span>{sourceText}</span>
+          {/* A whole-document operand has no field — the document itself is the subject. */}
+          {operand.field && (
+            <span className={`rt-token${fieldChanged ? ' rt-token--changed' : ''}`}>
+              {operand.field}
+            </span>
+          )}
+          {mode === 'runtime' && operand.source !== 'STATIC' && (
+            <span className={`rt-token-input${mismatchClass}`}>
+              {' '}
+              (input: {operandValueText(operand, mode)})
+            </span>
+          )}
+          {operand.source === 'STATIC' && (
+            <span className={`${valueChanged ? 'rt-token--changed' : ''}${mismatchClass}`}>
+              {/* The colon separates a field from its value; with no field on
+                  this side it would dangle after the operator. */}
+              {operand.field ? `: ${operandValueText(operand, mode)}` : operandValueText(operand, mode)}
+            </span>
+          )}
+        </>
+      );
+    }
+
+    const fieldOptions = documentFieldOptions(metadata, operand.document_type);
+
+    return (
+      <>
+        <InlineTokenEditor
+          kind="dropdown"
+          options={sourceOptions(metadata)}
+          value={operand.source}
+          changed={changedField(original, operand, 'source')}
+          onCommit={(v) => onOperandChange?.(side, { source: v as Operand['source'] })}
+        />
+        {/* A DOCUMENT operand is picked from the known documents and their
+            fields; APPLICATION has no such catalogue, so it stays free text. */}
+        {operand.source === 'DOCUMENT' && (
+          <>
+            <InlineTokenEditor
+              kind="dropdown"
+              options={documentTypeOptions(metadata)}
+              value={operand.document_type ?? ''}
+              placeholder="document"
+              changed={changedField(original, operand, 'document_type')}
+              onCommit={(v) =>
+                // Changing document changes which fields exist, so a field that
+                // the new document does not have is cleared rather than left
+                // pointing at nothing.
+                onOperandChange?.(side, {
+                  document_type: v,
+                  ...(operand.field && !documentFieldOptions(metadata, v).includes(operand.field)
+                    ? { field: '' }
+                    : {}),
+                })
+              }
+            />
+            {fieldOptions.length > 0 ? (
+              <InlineTokenEditor
+                kind="dropdown"
+                options={fieldOptions}
+                value={operand.field ?? ''}
+                placeholder="field"
+                missing={side === 'left_operand' && missing.left}
+                changed={changedField(original, operand, 'field')}
+                onCommit={(v) => onOperandChange?.(side, { field: v })}
+              />
+            ) : (
+              // No catalogue for this document (or none selected yet) — never
+              // leave the author with an empty dropdown and no way forward.
+              <InlineTokenEditor
+                kind="text"
+                value={operand.field ?? ''}
+                placeholder="field"
+                missing={side === 'left_operand' && missing.left}
+                changed={changedField(original, operand, 'field')}
+                onCommit={(v) => onOperandChange?.(side, { field: v })}
+              />
+            )}
+          </>
+        )}
+        {/* APPLICATION — and any source not in the metadata vocabulary — has no
+            field catalogue, so it takes free text. Falling through to this
+            branch rather than testing for APPLICATION exactly means an
+            unrecognised source never renders without a field editor. */}
+        {operand.source !== 'DOCUMENT' && operand.source !== 'STATIC' && (
+          <InlineTokenEditor
+            kind="text"
+            value={operand.field ?? ''}
+            placeholder="field"
+            missing={side === 'left_operand' && missing.left}
+            changed={changedField(original, operand, 'field')}
+            onCommit={(v) => onOperandChange?.(side, { field: v })}
+          />
+        )}
+        {operand.source === 'STATIC' && (
+          <>
+            <InlineTokenEditor
+              kind={editorKindForType(operand.type)}
+              value={String(operand.value ?? '')}
+              placeholder="value"
+              missing={side === 'right_operand' && missing.right}
+              changed={changedField(original, operand, 'value')}
+              onCommit={(v) => onOperandChange?.(side, { value: v })}
+            />
+            {operand.type === 'currency' && (
+              <InlineTokenEditor
+                kind="dropdown"
+                options={metadata?.currency ?? []}
+                value={operand.metadata?.currency ?? ''}
+                changed={original?.metadata?.currency !== operand.metadata?.currency}
+                onCommit={(v) =>
+                  onOperandChange?.(side, { metadata: { ...operand.metadata, currency: v } })
+                }
+              />
+            )}
+          </>
+        )}
+      </>
+    );
+  };
+
+  const label = isGroup ? 'CONDITION' : 'RULE';
+  const labelClass = isGroup ? 'rt-label--condition' : 'rt-label--rule';
+
+  const statusIcon = (value: boolean | undefined, kind: 'prefix' | 'suffix') => {
+    if (!isRuntime || isSkipped || value === undefined) return null;
+    return (
+      <span
+        className={`rt-status-icon rt-status-icon--${value ? 'success' : 'fail'} rt-status-icon--${kind}`}
+        title={
+          kind === 'prefix'
+            ? `Overall result: ${value ? 'passed' : 'failed'}`
+            : `${isGroup ? 'Condition' : 'Rule'} own result: ${value ? 'passed' : 'failed'}`
+        }
+      >
+        {kind === 'prefix' ? (value ? '✔' : '✘') : '●'}
+      </span>
+    );
+  };
+
+  // Prefix: for a group, its final/aggregate outcome (AND/OR of its children) —
+  // e.g. a condition that itself evaluated true but whose inner rules failed
+  // still shows a failing prefix mark here. A leaf rule has no separate
+  // "group" concept, so its prefix simply mirrors its own result (shown both
+  // sides for quick scanning).
+  const prefixIcon = statusIcon(node.result, 'prefix');
+  // Suffix: this node's own check — the group's gate condition, or the leaf's
+  // own pass/fail — rendered as a dot so it reads as visually distinct from
+  // the prefix's checkmark/cross. A pure grouping node has no own check.
+  const suffixIcon = hasCondition
+    ? statusIcon(isGroup ? node.condition_result : node.result, 'suffix')
+    : null;
+
+  const operatorChanged = originalNode ? originalNode.operator !== node.operator : false;
+
+  return (
+    <>
+      {prefixIcon}
+      <span
+        className={`rt-statement${isGroup ? ' rt-statement--condition' : ''}`}
+        title={node.description}
+      >
+        {hasCondition ? (
+          <>
+            {left && renderOperand('left_operand', left, originalNode?.left_operand)}
+            {isEdit ? (
+              <InlineTokenEditor
+                kind="dropdown"
+                options={operatorOptions(metadata, left?.type)}
+                value={node.operator ?? ''}
+                placeholder="operator"
+                missing={missing.operator}
+                changed={operatorChanged}
+                onCommit={(v) => onOperatorChange?.(v)}
+              />
+            ) : (
+              <span className={`rt-token${operatorChanged ? ' rt-token--changed' : ''}`}>
+                {(node.operator ?? '').replace(/_/g, ' ')}
+              </span>
+            )}
+            {/* Unary operators compare against nothing, so no right-hand side is rendered. */}
+            {!isUnary && right && renderOperand('right_operand', right, originalNode?.right_operand)}
+          </>
+        ) : (
+          // A pure grouping node has no check of its own; show what it groups.
+          // In edit mode the editable description line below the row covers it.
+          !isEdit && <span className="rt-group-description">{node.description}</span>
+        )}
+        {suffixIcon}
+        <span>—</span>
+        <span className={`rt-label ${labelClass}`}>{label}</span>
+        {/* `severity` is carried in the data but deliberately not rendered. */}
+        <span className="rt-rule-id">{node.rule_id}</span>
+      </span>
+      {/* The authored reason this check matters, surfaced only where it applies. */}
+      {isRuntime && ownCheckFailed && node.failure_reason && (
+        <span className="rt-failure-reason" title="Failure reason">
+          {node.failure_reason}
+        </span>
+      )}
+    </>
+  );
+}
