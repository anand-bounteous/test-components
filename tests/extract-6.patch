@@ -0,0 +1,305 @@
+import { useState } from 'react';
+import type { LogicalOperator, Operand, RuleMetadata, RuleNode } from '../types';
+import { DEFAULT_SEVERITY } from '../types';
+import { RuleStatement, type ViewerMode } from './RuleStatement';
+import { AddDeleteToolbar } from '../editing/AddDeleteToolbar';
+import { InlineTokenEditor } from '../editing/InlineTokenEditor';
+import {
+  getNodeIssues,
+  hasOwnCondition,
+  isGroupNode,
+  isUnaryOperator,
+} from '../editing/validation';
+
+export interface RuleNodeViewProps {
+  node: RuleNode;
+  originalNode?: RuleNode;
+  mode: ViewerMode;
+  metadata?: RuleMetadata;
+  defaultExpanded?: boolean;
+  parentSkipped?: boolean;
+  /** Supplies a tree-unique rule id for newly created nodes. */
+  generateRuleId?: () => string;
+  onNodeChange?: (updatedNode: RuleNode) => void;
+  onDeleteSelf?: () => void;
+  onAddSiblingAfterSelf?: () => void;
+}
+
+/**
+ * Rule ids read as "R" plus four digits, matching the authored data. Uniqueness
+ * is the caller's concern — pass `generateRuleId` from the viewer, which knows
+ * every id already in the tree.
+ */
+export function randomRuleId(): string {
+  return `R${Math.floor(1000 + Math.random() * 9000)}`;
+}
+
+export function makeEmptyLeaf(generateRuleId: () => string = randomRuleId): RuleNode {
+  return {
+    rule_id: generateRuleId(),
+    description: '',
+    operator: 'equals',
+    left_operand: { source: 'DOCUMENT', document_type: '', field: '' },
+    right_operand: { source: 'STATIC', value: '' },
+    severity: DEFAULT_SEVERITY,
+  };
+}
+
+export function RuleNodeView({
+  node,
+  originalNode,
+  mode,
+  metadata,
+  defaultExpanded = true,
+  parentSkipped = false,
+  generateRuleId = randomRuleId,
+  onNodeChange,
+  onDeleteSelf,
+  onAddSiblingAfterSelf,
+}: RuleNodeViewProps) {
+  const [expanded, setExpanded] = useState(defaultExpanded);
+  const isGroup = isGroupNode(node);
+  const skipped = mode === 'runtime' && (parentSkipped || node.execution_status === 'skipped');
+  const issues = mode === 'edit' ? getNodeIssues(node, metadata) : [];
+  const invalid = issues.length > 0;
+
+  const emitChange = (patch: Partial<RuleNode>) => {
+    onNodeChange?.({ ...node, ...patch });
+  };
+
+  const handleOperandChange = (side: 'left_operand' | 'right_operand', patch: Partial<Operand>) => {
+    const base = node[side] ?? { source: side === 'right_operand' ? 'STATIC' : 'DOCUMENT' };
+    emitChange({ [side]: { ...base, ...patch } } as Partial<RuleNode>);
+  };
+
+  /**
+   * Switching between a binary and a unary operator changes the node's shape:
+   * unary operators carry no `right_operand` at all, so it is dropped on the way
+   * in and re-created on the way back out.
+   */
+  const handleOperatorChange = (operator: string) => {
+    const nowUnary = isUnaryOperator(operator, metadata);
+    const wasUnary = isUnaryOperator(node.operator, metadata);
+    if (nowUnary) {
+      emitChange({ operator, right_operand: undefined });
+    } else if (wasUnary || !node.right_operand) {
+      emitChange({ operator, right_operand: { source: 'STATIC', value: '' } });
+    } else {
+      emitChange({ operator });
+    }
+  };
+
+  const handleAddChild = () => {
+    const child = makeEmptyLeaf(generateRuleId);
+    if (isGroup) {
+      emitChange({ rules: [...(node.rules ?? []), child] });
+      setExpanded(true);
+      return;
+    }
+    // A leaf gaining a child becomes a *gated* condition group: this node's own
+    // check turns into the gate deciding whether the children run, and the
+    // children are combined with AND unless the author changes it. Defaulting
+    // to AND rather than leaving it null keeps the tree immediately valid.
+    emitChange({ logical_operator: node.logical_operator ?? 'AND', rules: [child] });
+    setExpanded(true);
+  };
+
+  // True when this node's own gate condition evaluated to false, meaning its
+  // immediate children were skipped even though this node itself executed —
+  // the AND/OR linking those children never meaningfully applied.
+  const childrenSkipped = mode === 'runtime' && !skipped && node.condition_result === false;
+
+  const operatorClass = (() => {
+    if (skipped || childrenSkipped) return 'rt-operator rt-operator--skip';
+    if (mode === 'runtime' && node.result !== undefined) {
+      return `rt-operator rt-operator--${node.result ? 'success' : 'fail'}`;
+    }
+    return 'rt-operator';
+  })();
+
+  const childCount = node.rules?.length ?? 0;
+
+  /**
+   * The node's free-prose fields, each on its own row beneath the statement.
+   * Edit mode always offers the editor so an empty one can be filled in; view
+   * mode shows it read-only only when there is something to show.
+   */
+  const proseFields = [
+    {
+      key: 'description' as const,
+      label: 'description',
+      placeholder: '+ add a description',
+      // A pure grouping node already renders its description as its statement,
+      // so repeating it here would show it twice.
+      showInView: Boolean(node.description) && hasOwnCondition(node),
+      // `description` is a required field, so it is cleared to '' not removed.
+      optional: false,
+    },
+    {
+      key: 'failure_reason' as const,
+      label: 'failure reason',
+      placeholder: '+ add a failure reason',
+      showInView: Boolean(node.failure_reason),
+      optional: true,
+    },
+  ];
+
+  return (
+    <div
+      id={`rt-node-${node.rule_id}`}
+      className={`rt-node${invalid ? ' rt-node--invalid' : ''}${skipped ? ' rt-skipped' : ''}`}
+    >
+      <div
+        className={`rt-node-line${isGroup ? ' rt-node-line--toggle' : ''}`}
+        onClick={isGroup ? () => setExpanded((e) => !e) : undefined}
+        role={isGroup ? 'button' : undefined}
+        tabIndex={isGroup ? 0 : undefined}
+        title={isGroup ? (expanded ? 'Collapse' : 'Expand') : undefined}
+      >
+        {skipped && mode === 'runtime' && <span>skipped</span>}
+        <RuleStatement
+          node={node}
+          originalNode={originalNode}
+          mode={mode}
+          metadata={metadata}
+          onOperandChange={handleOperandChange}
+          onOperatorChange={handleOperatorChange}
+        />
+        {mode === 'edit' && (
+          <AddDeleteToolbar
+            node={node}
+            onAddChild={handleAddChild}
+            onAddSibling={() => onAddSiblingAfterSelf?.()}
+            onDelete={() => onDeleteSelf?.()}
+          />
+        )}
+      </div>
+
+      {/* Prose fields sit on their own lines: they would not fit the
+          sentence-shaped row above. The same row is used in both modes, so the
+          layout does not shift when you switch between viewing and editing. */}
+      {proseFields.map((field) => {
+        if (mode !== 'edit' && !(mode === 'view' && field.showInView)) return null;
+        const value = node[field.key] ?? '';
+        const originalValue = originalNode?.[field.key] ?? '';
+        return (
+          <div
+            key={field.key}
+            className={`rt-meta-row rt-meta-row--${field.key.replace(/_/g, '-')}`}
+          >
+            <span className="rt-meta-label">{field.label}</span>
+            {mode === 'edit' ? (
+              <InlineTokenEditor
+                kind="textarea"
+                value={value}
+                placeholder={field.placeholder}
+                changed={Boolean(originalNode) && originalValue !== value}
+                onCommit={(v) =>
+                  // Clearing an optional field removes it rather than leaving an
+                  // empty string behind in the saved JSON.
+                  emitChange({
+                    [field.key]: field.optional ? v || undefined : v,
+                  } as Partial<RuleNode>)
+                }
+              />
+            ) : (
+              <span className="rt-meta-text">{value}</span>
+            )}
+          </div>
+        );
+      })}
+
+      {/* The issues belonging to *this* node, next to the row that owns them —
+          the summary banner at the top only says how many there are. */}
+      {invalid && (
+        <div className="rt-banner rt-banner--node">
+          {issues.map((issue, i) => (
+            <div key={i}>{issue.message}</div>
+          ))}
+        </div>
+      )}
+
+      {isGroup && (
+        <div>
+          {/* In edit mode the row renders even with no operator chosen yet, so
+              authored data carrying `logical_operator: null` can be corrected
+              rather than showing an unsatisfiable "Select AND/OR" banner. */}
+          {(node.logical_operator || mode === 'edit') && (
+            <div
+              className={operatorClass}
+              onClick={() => setExpanded((e) => !e)}
+              role="button"
+              tabIndex={0}
+              title={expanded ? 'Collapse' : 'Expand'}
+            >
+              {mode === 'edit' ? (
+                <InlineTokenEditor
+                  kind="dropdown"
+                  options={['AND', 'OR']}
+                  value={node.logical_operator ?? ''}
+                  placeholder="AND/OR"
+                  changed={
+                    originalNode ? originalNode.logical_operator !== node.logical_operator : false
+                  }
+                  onCommit={(v) =>
+                    // An empty pick clears the operator rather than storing "",
+                    // keeping the node's incomplete state honest.
+                    emitChange({ logical_operator: (v || null) as LogicalOperator | null })
+                  }
+                />
+              ) : (
+                node.logical_operator
+              )}
+              <span className="rt-operator-hint">
+                {' '}
+                {node.logical_operator
+                  ? `(${
+                      node.logical_operator === 'AND'
+                        ? 'all of the below must pass'
+                        : 'any one below must pass'
+                    })`
+                  : '(choose how these rules combine)'}
+              </span>
+              {!expanded && childCount > 0 && (
+                <span className="rt-operator-collapsed-hint">
+                  {' '}
+                  ▸ ({childCount} rule{childCount === 1 ? '' : 's'})
+                </span>
+              )}
+            </div>
+          )}
+          {expanded && (
+            <div className="rt-children">
+              {(node.rules ?? []).map((child, index) => (
+                <RuleNodeView
+                  key={child.rule_id}
+                  node={child}
+                  originalNode={originalNode?.rules?.[index]}
+                  mode={mode}
+                  metadata={metadata}
+                  defaultExpanded={defaultExpanded}
+                  parentSkipped={skipped || childrenSkipped}
+                  generateRuleId={generateRuleId}
+                  onNodeChange={(updated) => {
+                    const rules = [...(node.rules ?? [])];
+                    rules[index] = updated;
+                    emitChange({ rules });
+                  }}
+                  onDeleteSelf={() => {
+                    const rules = (node.rules ?? []).filter((_, i) => i !== index);
+                    emitChange({ rules });
+                  }}
+                  onAddSiblingAfterSelf={() => {
+                    const rules = [...(node.rules ?? [])];
+                    rules.splice(index + 1, 0, makeEmptyLeaf(generateRuleId));
+                    emitChange({ rules });
+                  }}
+                />
+              ))}
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
