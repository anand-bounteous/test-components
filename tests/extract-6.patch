+import type { RuleSet } from '../types';
+
+const EVALUATION_MODE_HINT: Record<string, string> = {
+  ALL_CRITICAL_MUST_PASS: 'every CRITICAL rule must pass; lower severities are advisory',
+  ALL_MUST_PASS: 'every rule must pass regardless of severity',
+  ANY_MUST_PASS: 'the set passes as soon as one rule passes',
+};
+
+/** The rule set envelope — identity, schema version and how results are combined. */
+export function RuleSetHeader({ ruleSet }: { ruleSet: Omit<RuleSet, 'rules'> }) {
+  const hint = ruleSet.evaluation_mode ? EVALUATION_MODE_HINT[ruleSet.evaluation_mode] : undefined;
+
+  return (
+    <div className="rt-ruleset-header">
+      <span className="rt-ruleset-id">{ruleSet.rule_set_id}</span>
+      {ruleSet.exception_code && (
+        <span className="rt-ruleset-field" title="Exception code">
+          {ruleSet.exception_code}
+        </span>
+      )}
+      <span className="rt-ruleset-field" title="Rule set schema version">
+        v{ruleSet.version}
+      </span>
+      {ruleSet.evaluation_mode && (
+        <span className="rt-ruleset-mode" title={hint}>
+          {ruleSet.evaluation_mode.replace(/_/g, ' ').toLowerCase()}
+          {hint && <span className="rt-ruleset-hint"> — {hint}</span>}
+        </span>
+      )}
+    </div>
+  );
+}
