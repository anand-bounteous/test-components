+import { useMemo, useState } from 'react';
+import type { RuleMetadata, RuleNode } from '../types';
+import { RuleNodeView } from '../nodes/RuleNodeView';
+import { RuleStatement } from '../nodes/RuleStatement';
+import { toRootArray } from '../editing/validation';
+import { computeDiff } from './computeDiff';
+
+export type DiffLayout = 'side-by-side' | 'inline';
+export type DiffScope = 'full' | 'changed-only';
+
+interface DiffViewProps {
+  current: RuleNode | RuleNode[];
+  original: RuleNode | RuleNode[];
+  metadata?: RuleMetadata;
+  defaultLayout?: DiffLayout;
+  defaultScope?: DiffScope;
+}
+
+function collectByRuleId(rule: RuleNode | RuleNode[] | undefined, map: Map<string, RuleNode>) {
+  toRootArray(rule).forEach((node) => {
+    map.set(node.rule_id, node);
+    node.rules?.forEach((c) => collectByRuleId(c, map));
+  });
+}
+
+export function DiffView({
+  current,
+  original,
+  metadata,
+  defaultLayout = 'side-by-side',
+  defaultScope = 'full',
+}: DiffViewProps) {
+  const [layout, setLayout] = useState<DiffLayout>(defaultLayout);
+  const [scope, setScope] = useState<DiffScope>(defaultScope);
+
+  const currentRoots = useMemo(() => toRootArray(current), [current]);
+  const originalRoots = useMemo(() => toRootArray(original), [original]);
+
+  const diffEntries = useMemo(() => computeDiff(current, original), [current, original]);
+  const changed = useMemo(
+    () => diffEntries.filter((e) => e.kind === 'changed' || e.kind === 'added'),
+    [diffEntries],
+  );
+
+  const originalById = useMemo(() => {
+    const map = new Map<string, RuleNode>();
+    collectByRuleId(original, map);
+    return map;
+  }, [original]);
+
+  const currentById = useMemo(() => {
+    const map = new Map<string, RuleNode>();
+    collectByRuleId(current, map);
+    return map;
+  }, [current]);
+
+  return (
+    <div className="rt-root">
+      <div className="rt-toggle-row">
+        <label>
+          <input
+            type="radio"
+            checked={layout === 'side-by-side'}
+            onChange={() => setLayout('side-by-side')}
+          />{' '}
+          Side-by-side
+        </label>
+        <label>
+          <input type="radio" checked={layout === 'inline'} onChange={() => setLayout('inline')} />{' '}
+          Inline unified
+        </label>
+        <span style={{ marginLeft: 16 }} />
+        <label>
+          <input type="radio" checked={scope === 'full'} onChange={() => setScope('full')} /> Full
+          tree
+        </label>
+        <label>
+          <input
+            type="radio"
+            checked={scope === 'changed-only'}
+            onChange={() => setScope('changed-only')}
+          />{' '}
+          Changed only
+        </label>
+      </div>
+
+      {scope === 'changed-only' ? (
+        <div>
+          {changed.length === 0 && <div>No differences.</div>}
+          {changed.map((entry) => {
+            const node = currentById.get(entry.rule_id);
+            const originalNode = originalById.get(entry.rule_id);
+            if (!node) return null;
+            return (
+              <div key={entry.rule_id} style={{ marginBottom: 8 }}>
+                <RuleStatement node={node} originalNode={originalNode} mode="view" metadata={metadata} />
+              </div>
+            );
+          })}
+        </div>
+      ) : layout === 'side-by-side' ? (
+        <div className="rt-compare-panes">
+          <div className="rt-compare-pane">
+            <div style={{ fontWeight: 700, marginBottom: 4 }}>Base version</div>
+            {originalRoots.map((root) => (
+              <RuleNodeView key={root.rule_id} node={root} mode="view" metadata={metadata} />
+            ))}
+          </div>
+          <div className="rt-compare-pane">
+            <div style={{ fontWeight: 700, marginBottom: 4 }}>Current version</div>
+            {currentRoots.map((root, index) => (
+              <RuleNodeView
+                key={root.rule_id}
+                node={root}
+                originalNode={originalRoots[index]}
+                mode="view"
+                metadata={metadata}
+              />
+            ))}
+          </div>
+        </div>
+      ) : (
+        currentRoots.map((root, index) => (
+          <RuleNodeView
+            key={root.rule_id}
+            node={root}
+            originalNode={originalRoots[index]}
+            mode="view"
+            metadata={metadata}
+          />
+        ))
+      )}
+    </div>
+  );
+}
